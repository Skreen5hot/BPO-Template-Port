@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bpot:  <https://fandaws.com/ontology/bpot#> .

# Cases built to break skos_shapes.ttl, with a positive control scheme
# beside them. Each concept has a prefLabel, so the wellformedness shapes
# stay quiet and each case trips the constraint it is named for.

# -- positive control: a well-formed scheme ---------------------------

bpot:SkosGoodScheme a skos:ConceptScheme ;
    skos:prefLabel "good scheme" ;
    skos:hasTopConcept bpot:SkosGoodTop .

bpot:SkosGoodTop a skos:Concept ;
    skos:prefLabel "good top" ;
    skos:inScheme bpot:SkosGoodScheme ;
    skos:topConceptOf bpot:SkosGoodScheme .

bpot:SkosGoodChild a skos:Concept ;
    skos:prefLabel "good child" ;
    skos:altLabel "a different name" ;
    skos:inScheme bpot:SkosGoodScheme ;
    skos:broader bpot:SkosGoodTop .

# -- K1 in no declared scheme -----------------------------------------

bpot:SkosOrphan a skos:Concept ;
    skos:prefLabel "orphan" ;
    skos:inScheme bpot:NotADeclaredScheme .

# -- K2 a cycle of broader --------------------------------------------

bpot:SkosCycleA a skos:Concept ;
    skos:prefLabel "cycle a" ;
    skos:inScheme bpot:SkosGoodScheme ;
    skos:broader bpot:SkosCycleB .

bpot:SkosCycleB a skos:Concept ;
    skos:prefLabel "cycle b" ;
    skos:inScheme bpot:SkosGoodScheme ;
    skos:broader bpot:SkosCycleA .

# -- K3 broader across schemes ------------------------------------------

bpot:SkosOtherScheme a skos:ConceptScheme ;
    skos:prefLabel "other scheme" ;
    skos:hasTopConcept bpot:SkosOtherTop .

bpot:SkosOtherTop a skos:Concept ;
    skos:prefLabel "other top" ;
    skos:inScheme bpot:SkosOtherScheme .

bpot:SkosAcrossSchemes a skos:Concept ;
    skos:prefLabel "across schemes" ;
    skos:inScheme bpot:SkosGoodScheme ;
    skos:broader bpot:SkosOtherTop .

# -- K4 an altLabel that repeats the prefLabel --------------------------

bpot:SkosRepeatedLabel a skos:Concept ;
    skos:prefLabel "repeated" ;
    skos:altLabel "repeated" ;
    skos:inScheme bpot:SkosGoodScheme .

# -- K5 a concept that is also a class ----------------------------------

bpot:SkosAlsoClass a skos:Concept , owl:Class ;
    skos:prefLabel "also a class" ;
    skos:inScheme bpot:SkosGoodScheme .

# -- K6 a scheme with no top concept -----------------------------------

bpot:SkosTopless a skos:ConceptScheme ;
    skos:prefLabel "topless scheme" .
