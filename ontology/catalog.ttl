        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21582 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Restore site" ;
    bpot:apqcSourceText "Performing remediation or restoration activities." ;
    bpot:hierarchyID "10.4.10.2" ;
    bpot:pcfID "13132" .

bpot:PCF_13133 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21582 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare handover to new operator or landowner" ;
    bpot:apqcSourceText "Supporting handover to new operator or landowner. Include proper documentation on asset history and current state to enable orderly transition." ;
    bpot:hierarchyID "10.4.10.4" ;
    bpot:pcfID "13133" .

bpot:PCF_13169 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct pricing analysis" ;
    bpot:apqcSourceText "Analyzing marketing objectives, consumer demand, product attributes, competitors' pricing, and economic trends to determine optimum prices for the set of products and services that the company offers or intends to offer by delivering maximum ROI." ;
    bpot:hierarchyID "3.2.2.1" ;
    bpot:pcfID "13169" .

bpot:PCF_13289 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify implications for key operating model business elements that require change" ;
    bpot:apqcSourceText "Determine impacts of elements such as staffing, skills, training, new markets, technology, or policies within operating model which needs change. " ;
    bpot:hierarchyID "1.2.2.2.1" ;
    bpot:pcfID "13289" .

bpot:PCF_13290 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify implications for key technology aspects" ;
    bpot:apqcSourceText "Determining key factors for technology ROI, benefits, architecture, etc." ;
    bpot:hierarchyID "1.2.2.2.2" ;
    bpot:pcfID "13290" .

bpot:PCF_13482 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10388 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze problems, requests, and inquiries" ;
    bpot:apqcSourceText "Analyzing various requests and inquiries from customers regarding products/services. Provide answers and offerings to satisfy the customer's needs. " ;
    bpot:hierarchyID "6.2.2.2" ;
    bpot:pcfID "13482" .

bpot:PCF_14007 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10745 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform recovery workout" ;
    bpot:apqcSourceText "Renegotiating the terms of a loan agreement in order to recoup money from a default account. " ;
    bpot:hierarchyID "9.2.4.6" ;
    bpot:pcfID "14007" .

bpot:PCF_14008 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10745 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage default accounts" ;
    bpot:apqcSourceText "Managing accounts that have not met the requirements agreed upon to pay off outstanding debts." ;
    bpot:hierarchyID "9.2.4.7" ;
    bpot:pcfID "14008" .

bpot:PCF_14057 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10739 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform profit center accounting" ;
    bpot:apqcSourceText "Determining the revenue, profits, and losses incurred by each unit within the organization that produces profit. " ;
    bpot:hierarchyID "9.1.2.2" ;
    bpot:pcfID "14057" .

bpot:PCF_14074 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform legal and management consolidation" ;
    bpot:apqcSourceText "Carrying out activities associated with legal and management consolidation. Legal consolidation can include currency conversion, balance carry forward, and consolidation of journal entries. Management consolidation can include reporting on financials on a reporting cycle basis to gauge the performance of the organization." ;
    bpot:hierarchyID "9.3.4.8" ;
    bpot:pcfID "14074" .

bpot:PCF_14075 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10755 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop tax plan" ;
    bpot:apqcSourceText "Devising a method to minimize payroll tax liability by means of allowances, deductions, exclusions or exemptions." ;
    bpot:hierarchyID "9.5.3.1" ;
    bpot:pcfID "14075" .

bpot:PCF_14076 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10755 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage tax plan" ;
    bpot:apqcSourceText "Overseeing maintaining the reduction of payroll taxes [14075]." ;
    bpot:hierarchyID "9.5.3.2" ;
    bpot:pcfID "14076" .

bpot:PCF_14079 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10761 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish investment policy" ;
    bpot:apqcSourceText "Developing and instituting principles that the organization ill use in making investments. " ;
    bpot:hierarchyID "9.7.4.1" ;
    bpot:pcfID "14079" .

bpot:PCF_14090 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Screen sanctioned party list" ;
    bpot:apqcSourceText "Evaluating the approved list of parties for engaging in international trade in order to ensure the safety of the organization's business transactions. Examine agents that have been granted legal rights to engage in global trade and their credentials." ;
    bpot:hierarchyID "9.11.1" ;
    bpot:pcfID "14090" .

bpot:PCF_14091 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Control exports and imports" ;
    bpot:apqcSourceText "Overseeing and directing the flow of trade to/from the organization in order to ensure financial gains. " ;
    bpot:hierarchyID "9.11.2" ;
    bpot:pcfID "14091" .

bpot:PCF_14092 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Classify products" ;
    bpot:apqcSourceText "Systematically categorizing products/services for their suitability to international trade. Create classes and categories for demarcating the types of products suitable for international trade. Study requisite national and international standards and the adherence of the organization's portfolio of offerings to these." ;
    bpot:hierarchyID "9.11.3" ;
    bpot:pcfID "14092" .

bpot:PCF_14093 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate duty" ;
    bpot:apqcSourceText "Computing the excise duty to be paid during international trade." ;
    bpot:hierarchyID "9.11.5" ;
    bpot:pcfID "14093" .

bpot:PCF_14094 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate with customs" ;
    bpot:apqcSourceText "Communicating with the customs department to ensure fluid compliance. Share pertinent information mandated by law with the government agency that controls and collects the duties levied for the international exchange of products/services." ;
    bpot:hierarchyID "9.11.6" ;
    bpot:pcfID "14094" .

bpot:PCF_14095 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Document trade" ;
    bpot:apqcSourceText "Documenting and recording the trade processes while making transactions, noting the description, quality, number, transportation medium, indemnity, and inspection." ;
    bpot:hierarchyID "9.11.7" ;
    bpot:pcfID "14095" .

bpot:PCF_14096 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process trade preferences" ;
    bpot:apqcSourceText "Preparing global trade under preference, which allows the organization to import/export products at a lower or nil rate of customs duty and/or levy charge." ;
    bpot:hierarchyID "9.11.8" ;
    bpot:pcfID "14096" .

bpot:PCF_14097 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Handle restitution" ;
    bpot:apqcSourceText "Administering and overseeing all restitution activities the organization may be subjected to. Manage compliance with apposite legal frameworks. Make any restitution that may be required by law; comply with authorities over any fines or non-financial measures imposed." ;
    bpot:hierarchyID "9.11.9" ;
    bpot:pcfID "14097" .

bpot:PCF_14098 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare letter of credit" ;
    bpot:apqcSourceText "Creating a document assuring that a seller will receive payment when certain delivery conditions are met. (If the buyer is unable to make payment on the purchase, a bank covers the outstanding amount.)" ;
    bpot:hierarchyID "9.11.10" ;
    bpot:pcfID "14098" .

bpot:PCF_14133 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17468 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage internal audits" ;
    bpot:apqcSourceText "Managing accounts and prepare regular reports on financial performance." ;
    bpot:hierarchyID "11.2.1.3" ;
    bpot:pcfID "14133" .

bpot:PCF_14137 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17468 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain controls-related technologies and tools" ;
    bpot:apqcSourceText "Managing technologies and tools related to the confidentiality, integrity, and availability of data in order to ensure the security of the organization's information." ;
    bpot:hierarchyID "11.2.1.4" ;
    bpot:pcfID "14137" .

bpot:PCF_14187 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10742 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze credit scoring history" ;
    bpot:apqcSourceText "Reviewing past credit scores to determine the if a line of credit will be extended to potential customers. This could also include extending additional credit to existing accounts." ;
    bpot:hierarchyID "9.2.1.3" ;
    bpot:pcfID "14187" .

bpot:PCF_14188 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10742 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Forecast credit scoring requirement" ;
    bpot:apqcSourceText "Planning credit score requirements based on established credit policies. " ;
    bpot:hierarchyID "9.2.1.4" ;
    bpot:pcfID "14188" .

bpot:PCF_14189 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10039 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop sustainability strategy" ;
    bpot:apqcSourceText "Formulating strategic options that create opportunities for the sustenance and prosperity of the business in the long run. Go beyond business longevity to consider alternate strategies that allow the organizations preservation of vitality over time. Earmark resources and target processes, the former of which are dedicated to the absorption of sustainable practices in the latter." ;
    bpot:hierarchyID "1.2.3.2" ;
    bpot:pcfID "14189" .

bpot:PCF_14193 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define production process" ;
    bpot:apqcSourceText "Outlining the scheme of processing inventory into finished products/services. This includes the use of raw materials, machinery, skill sets, and knowledge to create new offerings." ;
    bpot:hierarchyID "4.1.1.7" ;
    bpot:pcfID "14193" .

bpot:PCF_14194 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define production workplace layout and infrastructure" ;
    bpot:apqcSourceText "Determining the floor plans for the processing facility that is meant for delivering finished products/services. Identify the totality of infrastructure needed for using this space in the manufacturing process, including machinery, factory floors, offices, and furniture." ;
    bpot:hierarchyID "4.1.1.9" ;
    bpot:pcfID "14194" .

bpot:PCF_14196 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10223 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define production balance and control" ;
    bpot:apqcSourceText "Defining an equitable volume for the production of products/services that adheres to an equilibrium value, and creating a scheme of control for processing items. Create schematics for systematically planning, coordinating, and directing the manufacturing activities in line with the production balance determined." ;
    bpot:hierarchyID "4.1.3.6" ;
    bpot:pcfID "14196" .

bpot:PCF_14197 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10039 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop lean/continuous improvement strategy" ;
    bpot:apqcSourceText "Developing strategies for the optimization of processes and the improvement of functional areas in order to improve the bottom line. Create a road map of decision choices that would allow the organization to continuously enhance process efficiencies and advance performance standards." ;
    bpot:hierarchyID "1.2.3.7" ;
    bpot:pcfID "14197" .

bpot:PCF_14209 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10187 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage sales partner/alliance master data" ;
    bpot:apqcSourceText "Managing the repository of data relating to the organization's partners/alliances over time. Store, maintain, access, revise, and use all data on partners/alliances. Manage data. Ensure its security. Determine legitimate use cases that are beneficial to the organization." ;
    bpot:hierarchyID "3.5.5.4" ;
    bpot:pcfID "14209" .

bpot:PCF_14210 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10761 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process and oversee interest rate transactions" ;
    bpot:apqcSourceText "Supervising the interest paid or received by the organization. Arrange and supervise interest rate swap transactions to manage exposure to fluctuations in interest rates. Or attain a marginally lower rate of interest than could be gained through a swap. " ;
    bpot:hierarchyID "9.7.4.8" ;
    bpot:pcfID "14210" .

bpot:PCF_16380 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and manage governance approach" ;
    bpot:apqcSourceText "Outlining and managing the methodology for administering business process management (BPM). Define the method for setting standards and priorities for BPM efforts. Identify BPM governance leaders. Define BPM project participants' roles." ;
    bpot:hierarchyID "13.1.1.1" ;
    bpot:pcfID "16380" .

bpot:PCF_16381 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish and maintain process tools and templates" ;
    bpot:apqcSourceText "Instituting, organizing, and maintaining the upkeep of the techniques used for business process management (BPM). Create and maintain templates of BPM tools that can be readily implemented, including process engine, business analytics, content management, and collaboration tools." ;
    bpot:hierarchyID "13.1.1.2" ;
    bpot:pcfID "16381" .

bpot:PCF_16382 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assign and support process ownership" ;
    bpot:apqcSourceText "Assigning resources (employees) ownership of tasks. These include the responsibility of identifying, analyzing, and improving business processes in order to meet the goals and objectives such as increasing profits and performance, reducing costs, and accelerating schedules." ;
    bpot:hierarchyID "13.1.1.3" ;
    bpot:pcfID "16382" .

bpot:PCF_16383 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform process governance activities" ;
    bpot:apqcSourceText "Implementing and executing activities for governing business processes. Execute activities that encourage participation, accountability, transparency, responsiveness, equity and inclusiveness, etc. within the business processes." ;
    bpot:hierarchyID "13.1.1.4" ;
    bpot:pcfID "16383" .

bpot:PCF_16385 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16384 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish and maintain process framework" ;
    bpot:apqcSourceText "Defining and managing the framework that outlines the required business processes of the organization, key elements, and how they should interact. Institute strategy infrastructure and product, operations, and enterprise management." ;
    bpot:hierarchyID "13.1.2.1" ;
    bpot:pcfID "16385" .

bpot:PCF_16386 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16384 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify cross-functional processes" ;
    bpot:apqcSourceText "Recognizing the different functional areas working on the same project or goal. " ;
    bpot:hierarchyID "13.1.2.2" ;
    bpot:pcfID "16386" .

bpot:PCF_16388 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Scope processes" ;
    bpot:apqcSourceText "Defining the extent and limits of business processes. Define the range and diversity of all the set of activities and tasks that, once completed, will accomplish an organizational goal." ;
    bpot:hierarchyID "13.1.3.1" ;
    bpot:pcfID "16388" .

bpot:PCF_16390 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Model and document processes" ;
    bpot:apqcSourceText "Defining what a business entity does, who is responsible, to what standard a business process should be completed, and how the success of a business process can be determined. Identify processes, gather information gathering, interview participants, map processes, and perform analysis." ;
    bpot:hierarchyID "13.1.3.4" ;
    bpot:pcfID "16390" .

bpot:PCF_16391 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Publish processes" ;
    bpot:apqcSourceText "Disclosing the information available on business processes. Ensure the availability of the information regarding the business processes to all process team members, business stakeholders, and process owners. Use BPM software, as well as business process diagrams and documents that help depict the required information." ;
    bpot:hierarchyID "13.1.3.5" ;
    bpot:pcfID "16391" .

bpot:PCF_16393 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16392 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide process training" ;
    bpot:apqcSourceText "Providing training for the employees and process owners that administer the business processes. Design internal training programs or source third party agencies to provide the skills and training necessary." ;
    bpot:hierarchyID "13.1.4.1" ;
    bpot:pcfID "16393" .

bpot:PCF_16394 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16392 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Support process execution" ;
    bpot:apqcSourceText "Assisting and executing the business processes. Use business process execution language (BEPL), which is a standard, executable language for specifying actions within the business processes with the use of web services." ;
    bpot:hierarchyID "13.1.4.2" ;
    bpot:pcfID "16394" .

bpot:PCF_16397 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21453 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and select improvement opportunities" ;
    bpot:apqcSourceText "Helping a process owner to identify, analyze, and improve existing business processes within an organization to meet new goals and objectives." ;
    bpot:hierarchyID "13.1.5.1" ;
    bpot:pcfID "16397" .

bpot:PCF_16398 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21453 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage improvement projects" ;
    bpot:apqcSourceText "Developing and implementing a systematic approach to help the organization optimize its underlying processes in order to achieve more efficient results. Systematically gather information to clarify issues or problems. Intervene for improvements. Restructure training programs as appropriate to increase effectiveness. " ;
    bpot:hierarchyID "13.1.5.3" ;
    bpot:pcfID "16398" .

bpot:PCF_16399 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21453 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform continuous improvement activities" ;
    bpot:apqcSourceText "Persistently implementing activities for improving business processes. " ;
    bpot:hierarchyID "13.1.5.4" ;
    bpot:pcfID "16399" .

bpot:PCF_16402 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16401 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish portfolio strategy" ;
    bpot:apqcSourceText "Instituting the strategy for managing business portfolio. Create a systematic plan that defines the strategy for managing investments, holdings, products, businesses, and brands." ;
    bpot:hierarchyID "13.2.1.1" ;
    bpot:pcfID "16402" .

bpot:PCF_16403 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16401 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define portfolio governance" ;
    bpot:apqcSourceText "Outlining the administration of business portfolio of the organization. Create and manage the rules and regulations regarding the business processes in order to identify, select, prioritize, and monitor portfolio components. Include a set of metrics to indicate the health and progress of the portfolio in the most vital area." ;
    bpot:hierarchyID "13.2.1.2" ;
    bpot:pcfID "16403" .

bpot:PCF_16404 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16401 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and control portfolio" ;
    bpot:apqcSourceText "Overseeing and administering the business portfolio of the organization. Monitor all activities related to investments, holdings, products, businesses, and brands by effectively monitoring and supervising these activities." ;
    bpot:hierarchyID "13.2.1.3" ;
    bpot:pcfID "16404" .

bpot:PCF_16406 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16405 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish program structure and approach" ;
    bpot:apqcSourceText "Constructing and instituting the framework and approach to manage business programs. Monitor key factors such as governance, alignment with the overall business vision, assurance, and management." ;
    bpot:hierarchyID "13.2.2.1" ;
    bpot:pcfID "16406" .

bpot:PCF_16407 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16405 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage program stakeholders and partners" ;
    bpot:apqcSourceText "Managing relationships with stakeholders and partners of the business programs. " ;
    bpot:hierarchyID "13.2.2.2" ;
    bpot:pcfID "16407" .

bpot:PCF_16408 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16405 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage program execution" ;
    bpot:apqcSourceText "Administering and implementing business programs. Implement and execute programs with the intention of improving an organization's performance. Execute all the individual projects of the program to ensure the desired success." ;
    bpot:hierarchyID "13.2.2.3" ;
    bpot:pcfID "16408" .

bpot:PCF_16409 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16405 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review and report program performance" ;
    bpot:apqcSourceText "Evaluating and documenting the performance of business programs. Evaluate the performance of the programs. Create reports on the basis of the analysis. Use performance indicators and metrics such as desired/achieved goals, completion dates, issues and defects, and cost effectiveness." ;
    bpot:hierarchyID "13.2.2.4" ;
    bpot:pcfID "16409" .

bpot:PCF_16412 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16411 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify project resource requirements" ;
    bpot:apqcSourceText "Identifying the prerequisites of business projects. Identify the people with appropriate and applicable skills and competencies. Locate resources such as capital, facilities, equipment, material, and information required to accomplish the objectives of a specific project." ;
    bpot:hierarchyID "13.2.3.1.2" ;
    bpot:pcfID "16412" .

bpot:PCF_16415 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16414 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report the status of project" ;
    bpot:apqcSourceText "Recording and documenting the current status and position of the project. Record and report items such as completed tasks, incomplete tasks, planned tasks, and problems faced." ;
    bpot:hierarchyID "13.2.3.4.2" ;
    bpot:pcfID "16415" .

bpot:PCF_16416 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16414 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage project scope" ;
    bpot:apqcSourceText "Determining and documenting a list of specific project goals, deliverables, tasks, costs, and deadlines. Use the scope statement to explain the boundaries of the project. Assign responsibilities for team members. Set up procedures for verifying and approving the completed tasks." ;
    bpot:hierarchyID "13.2.3.4.3" ;
    bpot:pcfID "16416" .

bpot:PCF_16417 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review and report project performance" ;
    bpot:apqcSourceText "Measuring the performance of a business project against key performance indicators including the project scope, schedule, quality, cost, and risk criteria. Identify any deviations from the plan. Assess the impact of these deviations on the project, as well as on the overall program. Report results to key stakeholders." ;
    bpot:hierarchyID "13.2.3.5" ;
    bpot:pcfID "16417" .

bpot:PCF_16418 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Close projects" ;
    bpot:apqcSourceText "Settling each contract. Close each contract applicable to the project or project phase. Finalize all activities across all of the process groups in order to formally close the project or a project phase." ;
    bpot:hierarchyID "13.2.3.6" ;
    bpot:pcfID "16418" .

bpot:PCF_16440 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine risk tolerance for organization" ;
    bpot:apqcSourceText "Recognizing the organization's tolerance for risk, given risk-return trade-offs for one or more anticipated and predictable consequences." ;
    bpot:hierarchyID "11.1.1.1" ;
    bpot:pcfID "16440" .

bpot:PCF_16441 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and maintain enterprise risk policies and procedures" ;
    bpot:apqcSourceText "Establishing and maintaining the policies and procedures for managing risk. Create rules and regulations for enterprise risk dealing with hazardous, financial, operational, and strategic risks." ;
    bpot:hierarchyID "11.1.1.2" ;
    bpot:pcfID "16441" .

bpot:PCF_16442 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and implement enterprise risk management tools" ;
    bpot:apqcSourceText "Recognizing and implementing tools for managing risk. Identify and apply enterprise risk management tools. Leverage methods and processes to manage risks and opportunities associated with business objectives." ;
    bpot:hierarchyID "11.1.1.3" ;
    bpot:pcfID "16442" .

bpot:PCF_16443 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Coordinate the sharing of risk knowledge across the organization" ;
    bpot:apqcSourceText "Communicating the knowledge about risk within the organization. Identify operational risks. Share risk information within the organization." ;
    bpot:hierarchyID "11.1.1.4" ;
    bpot:pcfID "16443" .

bpot:PCF_16444 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare and report enterprise risk to executive management and board" ;
    bpot:apqcSourceText "Preparing and presenting reports about enterprise risk to the management of the organization. Create reports for management on hazard risks (e.g., property damage and liability torts), financial risks (e.g., currency and liquidity risks), and operational risks (e.g., product failure, customer satisfaction, social trends, and competition)." ;
    bpot:hierarchyID "11.1.1.5" ;
    bpot:pcfID "16444" .

bpot:PCF_16446 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify enterprise level risks" ;
    bpot:apqcSourceText "Determining risks that could thwart objectives. Document and communicate the concern." ;
    bpot:hierarchyID "11.1.2.1" ;
    bpot:pcfID "16446" .

bpot:PCF_16447 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess risks to determine which to mitigate" ;
    bpot:apqcSourceText "Identifying options/actions to enhance opportunities and reduce threats. Recognize the root reasons of the identified risks." ;
    bpot:hierarchyID "11.1.2.2" ;
    bpot:pcfID "16447" .

bpot:PCF_16448 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop risk mitigation and management strategy and integrate with existing performance management processes" ;
    bpot:apqcSourceText "Developing activities to improve opportunities and lessen threats. Specify the organization's objectives. Evolve strategies and policies to attain these objectives. Assign resources to project objectives. " ;
    bpot:hierarchyID "11.1.2.3" ;
    bpot:pcfID "16448" .

bpot:PCF_16449 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Verify business unit and functional risk mitigation plans are implemented" ;
    bpot:apqcSourceText "Checking that the blueprint created for managing risk in individual business units and divisions is correctly effectuated. Validate the implementation of all activities geared to mitigate risks." ;
    bpot:hierarchyID "11.1.2.4" ;
    bpot:pcfID "16449" .

bpot:PCF_16450 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Ensure risks and risk mitigation actions are monitored" ;
    bpot:apqcSourceText "Ensuring risk monitoring and mitigation activities. Monitor actions to enhance opportunities and reduce threats to project objectives." ;
    bpot:hierarchyID "11.1.2.5" ;
    bpot:pcfID "16450" .

bpot:PCF_16451 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report on enterprise risk activities" ;
    bpot:apqcSourceText "Creating a report of activities to address hazard risks, liability torts, financial risks, operational risks, social trends, competition, etc." ;
    bpot:hierarchyID "11.1.2.6" ;
    bpot:pcfID "16451" .

bpot:PCF_16452 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Coordinate business unit and functional risk management activities" ;
    bpot:apqcSourceText "Coordinating risk management activities to improve opportunities and lessen threats. Specify the organization's objectives. Assign resources to project objectives. " ;
    bpot:hierarchyID "11.1.2.7" ;
    bpot:pcfID "16452" .

bpot:PCF_16453 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Ensure that each business unit/function follows the enterprise risk management process" ;
    bpot:apqcSourceText "Checking each business unit's/function's options and activities to improve opportunities and lessen threats." ;
    bpot:hierarchyID "11.1.2.8" ;
    bpot:pcfID "16453" .

bpot:PCF_16454 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16445 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Ensure that each business unit/function follows the enterprise risk reporting process" ;
    bpot:apqcSourceText "Checking the reporting process of each business unit's/function's options and activities to improve opportunities and lessen threats." ;
    bpot:hierarchyID "11.1.2.9" ;
    bpot:pcfID "16454" .

bpot:PCF_16456 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17462 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify risks" ;
    bpot:apqcSourceText "Developing a timely and continuous process to identify activities that might hinder a project's goals." ;
    bpot:hierarchyID "11.1.3.1" ;
    bpot:pcfID "16456" .

bpot:PCF_16457 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17462 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess risks using enterprise risk framework policies and procedures" ;
    bpot:apqcSourceText "Determining the possibility that a specified undesirable event will occur using established tools, implements, and frameworks. Use risk assessments to determine, for example, whether to undertake a particular venture, what rate of return a particular investment requires, and how to mitigate an activity's potential losses." ;
    bpot:hierarchyID "11.1.3.2" ;
    bpot:pcfID "16457" .

bpot:PCF_16459 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17462 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement mitigation plans for risks" ;
    bpot:apqcSourceText "Executing mitigation plans to improve opportunities and reduce deviations to project objectives. " ;
    bpot:hierarchyID "11.1.3.4" ;
    bpot:pcfID "16459" .

bpot:PCF_16460 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17462 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor risks" ;
    bpot:apqcSourceText "Identifying, examining, and recognizing/justifying any improbability in investment decision making." ;
    bpot:hierarchyID "11.1.3.5" ;
    bpot:pcfID "16460" .

bpot:PCF_16461 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17462 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze risk activities and update plans" ;
    bpot:apqcSourceText "Examining the impact of risk activities in order to update the existing scheme of risk management. Analyze and substantiate the potential for adverse consequences to occur. Consider the risks associated with the activity and the methods available to manage those risks." ;
    bpot:hierarchyID "11.1.3.6" ;
    bpot:pcfID "16461" .

bpot:PCF_16462 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17462 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report on risk activities" ;
    bpot:apqcSourceText "Creating reports on risk activities, and communicating them to management. Prepare reports on the potential for adverse safety consequences." ;
    bpot:hierarchyID "11.1.3.7" ;
    bpot:pcfID "16462" .

bpot:PCF_16464 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop regulatory compliance procedures" ;
    bpot:apqcSourceText "Developing procedures and methodologies to comply with relevant laws and regulations of an organization's obedience to laws, guidelines, strategies and stipulations related to business." ;
    bpot:hierarchyID "11.2.2.1" ;
    bpot:pcfID "16464" .

bpot:PCF_16465 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify applicable regulatory requirements" ;
    bpot:apqcSourceText "Determining the regulatory requirements that are most appropriate for the organization. Identify goals in order to follow the appropriate rules and regulations, guidelines, and strategies." ;
    bpot:hierarchyID "11.2.2.2" ;
    bpot:pcfID "16465" .

bpot:PCF_16466 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor the regulatory environment for changing or emerging regulations" ;
    bpot:apqcSourceText "Analyzing and overseeing the regulatory environment in order to spot any changing or emerging regulations. This process element calls upon the organization to monitor the regulatory environment for any new statutes, policies, and enactments issued by the respective government authorities or those which have been updated." ;
    bpot:hierarchyID "11.2.2.3" ;
    bpot:pcfID "16466" .

bpot:PCF_16467 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess current compliance position and identify weaknesses or shortfalls therein" ;
    bpot:apqcSourceText "Evaluating current regulatory policies and regulations. Assess their performance. Make necessary changes." ;
    bpot:hierarchyID "11.2.2.4" ;
    bpot:pcfID "16467" .

bpot:PCF_16468 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement missing or stronger regulatory compliance controls and policies" ;
    bpot:apqcSourceText "Assessing the current policies and policies. Implement missing and necessary changes environmental changes, political changes, technological changes, etc." ;
    bpot:hierarchyID "11.2.2.5" ;
    bpot:pcfID "16468" .

bpot:PCF_16469 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and test regulatory compliance position and existing controls" ;
    bpot:apqcSourceText "Monitoring, appraising, and evaluating the compliance position of the organization in order to fine-tune for effective remediation. Track efforts for handling regulatory and compliance requirements necessitated by law. Test the robustness of internal frameworks, procedures, and approaches for dealing with these requirements, in order to clearly identify any necessary changes." ;
    bpot:hierarchyID "11.2.2.6" ;
    bpot:pcfID "16469" .

bpot:PCF_16470 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain relationships with regulators as appropriate" ;
    bpot:apqcSourceText "Developing and preserving relationships with the regulators, without compromising the legal basis of the relationship." ;
    bpot:hierarchyID "11.2.2.9" ;
    bpot:pcfID "16470" .

bpot:PCF_16471 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Share knowledge of specific risks across other parts of the organization" ;
    bpot:apqcSourceText "Sharing information about risks and resilience strategies of business operations across the organization so that prospective risks can be avoided. " ;
    bpot:hierarchyID "11.4.5" ;
    bpot:pcfID "16471" .

bpot:PCF_16500 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20006 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze channel performance" ;
    bpot:apqcSourceText "Conducting an analysis to review channel performance with respect to chosen metrics, benchmarks and performance targets [16573]. Compare to past performance and forecasts for the channel." ;
    bpot:hierarchyID "3.2.4.4" ;
    bpot:pcfID "16500" .

bpot:PCF_16501 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20006 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop plan for channel improvements" ;
    bpot:apqcSourceText "Devising a course of action to be taken to improve under-performing channels and to promote or expand channels that surpass expectations." ;
    bpot:hierarchyID "3.2.4.5" ;
    bpot:pcfID "16501" .

bpot:PCF_16573 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20006 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish channel-specific measures and targets" ;
    bpot:apqcSourceText "Determining measurable parameters to be used for comparing the performance of different marketing channels. Decide on benchmarks and values for optimum or desired performance. " ;
    bpot:hierarchyID "3.2.4.1" ;
    bpot:pcfID "16573" .

bpot:PCF_16574 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20006 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and report performance" ;
    bpot:apqcSourceText "Tracking trends and changes in performance inside individual marketing channels and in channels collectively. Summarize and document results. Alert relevant parties about significant or unexpected deviations from expected behaviors." ;
    bpot:hierarchyID "3.2.4.2" ;
    bpot:pcfID "16574" .

bpot:PCF_16575 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20006 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and report events influencing factors" ;
    bpot:apqcSourceText "Analyzing the factors and circumstances that influence desired outcomes. Communicate core findings to relevant parties." ;
    bpot:hierarchyID "3.2.4.3" ;
    bpot:pcfID "16575" .

bpot:PCF_16590 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define omni-channel strategy" ;
    bpot:apqcSourceText "Devising a strategy to market company's products or services seamlessly through all or most channels that are in widespread use among the target market. This may mean cross-channel access to customer preferences and purchasing history to accept returned merchandise, provide refunds, resolve payment issues or to provide technical support. " ;
    bpot:hierarchyID "3.2.3.7.1" ;
    bpot:pcfID "16590" .

bpot:PCF_16591 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define omni-channel requirements" ;
    bpot:apqcSourceText "Identifying necessary preconditions that a channel should fulfill in order to be included as one of the adopted channels, such as required throughput capacities, service capabilities, competitive pricing, and alignment with organizational marketing strategies. " ;
    bpot:hierarchyID "3.2.3.7.2" ;
    bpot:pcfID "16591" .

bpot:PCF_16592 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop omni-channel policies and procedures" ;
    bpot:apqcSourceText "Determining the detailed policies and procedures that each of the channels needs to follow in order to conform to the organizational marketing strategy and to provide seamless customer service experience." ;
    bpot:hierarchyID "3.2.3.7.3" ;
    bpot:pcfID "16592" .

bpot:PCF_16598 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_14208 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collect and merge internal and third-party customer information" ;
    bpot:apqcSourceText "Gathering the data about customers. Combine the information available locally with the data obtained from external sources. " ;
    bpot:hierarchyID "3.5.2.5.1" ;
    bpot:pcfID "16598" .

bpot:PCF_16599 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_14208 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "De-duplicate customer data" ;
    bpot:apqcSourceText "Eliminating redundant information in customer data. " ;
    bpot:hierarchyID "3.5.2.5.2" ;
    bpot:pcfID "16599" .

bpot:PCF_16612 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19964 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and manage personas" ;
    bpot:apqcSourceText "Identifying a set of characteristics that define the demographic and behavioral patterns of the customer. Further, use persona scoring to design your marketing strategies around personas, and measure and optimize your interactions with the contacts classified by a certain persona." ;
    bpot:hierarchyID "1.2.8.2.1" ;
    bpot:pcfID "16612" .

bpot:PCF_16614 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16613 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer website activity" ;
    bpot:apqcSourceText "Examining user activity on company, vendor or reseller websites to improve traffic on and to the website, improve user experience on the website to simplify purchasing process and encourage repeat purchases, and to increase the site's visibility in search engine results. Various metrics can be used to measure user activity, such as number of users who are new, returning or unique, time spent on page, session duration, bounce rate, click through rate, conversion rate, and others." ;
    bpot:hierarchyID "3.3.6.2" ;
    bpot:pcfID "16614" .

bpot:PCF_16615 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16613 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer purchase patterns" ;
    bpot:apqcSourceText "Conducting analyses to uncover customer purchasing habits. Detect patterns and categorize users based on similar characteristics and behaviors, demographic information, geographic location, search history, etc." ;
    bpot:hierarchyID "3.3.6.3" ;
    bpot:pcfID "16615" .

bpot:PCF_16616 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16613 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop business rules to provide personalized offers" ;
    bpot:apqcSourceText "Creating formulas for personalized offers, purchasing recommendations and targeted advertisements for customers on the basis of previously detected purchase patterns [16615]." ;
    bpot:hierarchyID "3.3.6.4" ;
    bpot:pcfID "16616" .

bpot:PCF_16617 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16613 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor effectiveness of personalized offers and adjust offers accordingly" ;
    bpot:apqcSourceText "Analyzing how well the targeted offers perform to see whether they result in an increased conversion rate. Reanalyze the purchase patterns or modify those business rules that are produce effective recommendations." ;
    bpot:hierarchyID "3.3.6.5" ;
    bpot:pcfID "16617" .

bpot:PCF_16627 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16613 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and respond to social media activity" ;
    bpot:apqcSourceText "Following postings on social media to promote offerings, raise brand awareness, interact with customers, increase customer engagement and brand loyalty, respond to queries, gauge sentiment regarding company's products or services, and to derive customer insight." ;
    bpot:hierarchyID "3.3.6.1" ;
    bpot:pcfID "16627" .

bpot:PCF_16630 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16629 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product images" ;
    bpot:apqcSourceText "Producing or overseeing the creation or acquisition of photos, images and graphics for a product description, advertisement or a website. Like the copy [18131], product images are chosen and edited to enhance the product description and to convince consumers to purchase the product." ;
    bpot:hierarchyID "3.3.9.1" ;
    bpot:pcfID "16630" .

bpot:PCF_16633 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_18924 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor customer loyalty program benefits to the enterprise and the customer" ;
    bpot:apqcSourceText "Surveying and tracking the benefits of customer loyalty programs both for the company and for customers. Compare with comparable loyalty programs instituted in competitor companies. Propose changes as needed to keep up with market trends. " ;
    bpot:hierarchyID "3.2.6.4" ;
    bpot:pcfID "16633" .

bpot:PCF_16790 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate intellectual property" ;
    bpot:apqcSourceText "Establishing measures and procedures for identifying various intellectual property threats and concerns." ;
    bpot:hierarchyID "1.1.1.10" ;
    bpot:pcfID "16790" .

bpot:PCF_16793 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16792 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify restructuring opportunities" ;
    bpot:apqcSourceText "Identifying opportunities for restructuring the organization, through an analysis of internal viability and external contingency. Conduct a broad-based survey of the market landscape, taking the large-scale trends and movements into account, to determine the necessity and possibility of restructuring the organization. Review the organization's internal capacities, the readiness of its process frameworks, the robustness of its financials, the capableness of its systems, the resourcefulness of its personnel, etc. for assimilating an extensive overhaul." ;
    bpot:hierarchyID "1.1.5.1" ;
    bpot:pcfID "16793" .

bpot:PCF_16794 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16792 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform due-diligence" ;
    bpot:apqcSourceText "Auditing the status quo of the probabilities, before formalizing any restructuring of the organization with another entity. Systematically investigate all entities discerned to be of interest in Identify restructuring opportunities [16793], to verify all tangible and substantial facts. Consider engaging specialist professional services including legal, accounting, and consulting help." ;
    bpot:hierarchyID "1.1.5.2" ;
    bpot:pcfID "16794" .

bpot:PCF_16796 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16795 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate acquisition options" ;
    bpot:apqcSourceText "Appraising entities identified as being suitable for acquisition, taking into account the restructuring opportunities in the internal and external context. Verify the appropriateness and viability of the short-listed options. Ensure these entities pertain to the state-of-affairs in the market, as well as fit with the resources and capabilities of the organization." ;
    bpot:hierarchyID "1.1.5.3.1" ;
    bpot:pcfID "16796" .

bpot:PCF_16797 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16795 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate merger options" ;
    bpot:apqcSourceText "Appraising entities identified as being suitable for a merger, taking stock of the restructuring opportunities within the firm and the market. Verify the appropriateness and viability of such options. Assess these entities to ensure their pertinence to the contextual state-of-affairs in the market, as well as a fit with the resources and capabilities of the organization itself. (This process can be carried out, in its entirety, by qualified in-house personnel or may be designated to specialist professional services providers.)" ;
    bpot:hierarchyID "1.1.5.3.2" ;
    bpot:pcfID "16797" .

bpot:PCF_16798 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16795 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate de-merger options" ;
    bpot:apqcSourceText "Evaluating departments and subsidiaries within the organization, and/or previously merged entities, to assess the appropriateness of a de-merger, taking account of the fit between these entities as well as any relevant externalities. Examine the pertinence and soundness of a formalized dissociation." ;
    bpot:hierarchyID "1.1.5.3.3" ;
    bpot:pcfID "16798" .

bpot:PCF_16799 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16795 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate divesture options" ;
    bpot:apqcSourceText "Evaluating departments and/or subsidiaries within the organization to assess the appropriateness of a divestment, taking account of all market externalities. Examine any internal entities that have been identified to be suitable for dismemberment from the organization. Ensure the pertinence and soundness of such a move." ;
    bpot:hierarchyID "1.1.5.3.4" ;
    bpot:pcfID "16799" .

bpot:PCF_16803 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10039 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop partner/alliance strategy" ;
    bpot:apqcSourceText "Defining direction and plan objectives for partnering with other companies to deliver product/services. Focus on creating a vision and strategic objectives and culminate in creating measures for the strategic alliance or partnership." ;
    bpot:hierarchyID "1.2.3.1" ;
    bpot:pcfID "16803" .

bpot:PCF_16805 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10039 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop merger/demerger/acquisition/exit strategy" ;
    bpot:apqcSourceText "Defining a strategy for corporate development. Include providing a framework for evaluating merger and acquisition candidates; and planning for a value creation through merging/demerging with a company, acquiring a company, or exiting from an already merged/acquired company." ;
    bpot:hierarchyID "1.2.3.3" ;
    bpot:pcfID "16805" .

bpot:PCF_16808 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Derive interoperability requirements for products and services" ;
    bpot:apqcSourceText "Determining the ability of products and services to work together, exchange and use information in a multi-vendor, multi-network, and multi-service environment." ;
    bpot:hierarchyID "2.2.3.1.2" ;
    bpot:pcfID "16808" .

bpot:PCF_16809 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Derive safety requirements for products and services" ;
    bpot:apqcSourceText "Developing safety requirements in line with environmental safety, occupational health and safety, and community health and safety guidelines." ;
    bpot:hierarchyID "2.2.3.1.3" ;
    bpot:pcfID "16809" .

bpot:PCF_16810 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Derive security requirements for products and services" ;
    bpot:apqcSourceText "Implementing security requirements through authentication and encryption of CE device data stream.  Utilize security measures such as cryptographic protocols and hardware security (smart cards)." ;
    bpot:hierarchyID "2.2.3.1.4" ;
    bpot:pcfID "16810" .

bpot:PCF_16811 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Derive regulatory compliance requirements" ;
    bpot:apqcSourceText "Meeting regulatory requirements set forth by such directives as RoHS, WEEE, ELV, and REACH. " ;
    bpot:hierarchyID "2.2.3.1.5" ;
    bpot:pcfID "16811" .

bpot:PCF_16812 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Derive requirements from industry standards" ;
    bpot:apqcSourceText "Complying with consumer electronic industry standards developed by the Consumer Technology Association (CTA)." ;
    bpot:hierarchyID "2.2.3.1.6" ;
    bpot:pcfID "16812" .

bpot:PCF_16813 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop user experience design specifications" ;
    bpot:apqcSourceText "Determining the usability and user experience of products and the business impact it creates." ;
    bpot:hierarchyID "2.3.1.4" ;
    bpot:pcfID "16813" .

bpot:PCF_16814 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Derive ‘services-as-a-product’ offering" ;
    bpot:apqcSourceText "Productizing the service by defining the scope of the service/cost.  Target market for the service and make the service more tangible." ;
    bpot:hierarchyID "2.2.3.1.8" ;
    bpot:pcfID "16814" .

bpot:PCF_16815 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19990 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define post launch support model" ;
    bpot:apqcSourceText "Defining SLAs (Service Level Agreement) and service level KPIs (Key Performance Indicator). " ;
    bpot:hierarchyID "2.2.3.2" ;
    bpot:pcfID "16815" .

bpot:PCF_16817 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide warranty-related recommendations" ;
    bpot:apqcSourceText "Providing warranty plan and pricing specifications for recommendation." ;
    bpot:hierarchyID "2.3.1.5" ;
    bpot:pcfID "16817" .

bpot:PCF_16818 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19995 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and manage product data, design, and bill of materials" ;
    bpot:apqcSourceText "Designing the BOM-Bill of material, manufacturing BOM and Service BOMA bill of materials list for all the raw materials and components/parts used in the producing end product." ;
    bpot:hierarchyID "2.3.1.8.5" ;
    bpot:pcfID "16818" .

bpot:PCF_16819 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19995 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design for manufacturing" ;
    bpot:apqcSourceText "Carrying out the steps necessary to appropriately manufacture correct parts.  This includes designing application, product hardware, mold, casting, mechanical, and electrical aspects of the product." ;
    bpot:hierarchyID "2.3.1.8.1" ;
    bpot:pcfID "16819" .

bpot:PCF_16820 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19995 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design for product servicing" ;
    bpot:apqcSourceText "Creating product application service view to allow for product servicing and refurbishing." ;
    bpot:hierarchyID "2.3.1.8.2" ;
    bpot:pcfID "16820" .

bpot:PCF_16821 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19995 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design for re-manufacturing" ;
    bpot:apqcSourceText "Replacing core components and republishing. " ;
    bpot:hierarchyID "2.3.1.8.3" ;
    bpot:pcfID "16821" .

bpot:PCF_16822 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19995 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review product troubleshooting methodology" ;
    bpot:apqcSourceText "Reviewing the design and approach for troubleshooting the product." ;
    bpot:hierarchyID "2.3.1.8.4" ;
    bpot:pcfID "16822" .

bpot:PCF_16823 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19995 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design for product upgrades" ;
    bpot:apqcSourceText "Designing hardware and software upgrade techniques." ;
    bpot:hierarchyID "2.3.1.8.6" ;
    bpot:pcfID "16823" .

bpot:PCF_16824 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10067 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop plan for new product/service development and introduction/launch" ;
    bpot:apqcSourceText "Developing a program and managing a perspective for new product/service introduction and launch." ;
    bpot:hierarchyID "2.1.2.1" ;
    bpot:pcfID "16824" .

bpot:PCF_16826 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19985 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review infringement of patents and copyrights" ;
    bpot:apqcSourceText "Reviewing activities in regards to patentability and infringement. The usage of Open Source in commercial product development will be reviewed in regard to licensing, community development, etc." ;
    bpot:hierarchyID "2.1.3.2" ;
    bpot:pcfID "16826" .

bpot:PCF_16827 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19985 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine patent and copyright needs" ;
    bpot:apqcSourceText "Determining the business need for patents and copyrights. The patents and copyrights are managed by Manage copyrights and patents [11062]." ;
    bpot:hierarchyID "2.1.3.3" ;
    bpot:pcfID "16827" .

bpot:PCF_16849 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop customer communication calendar" ;
    bpot:apqcSourceText "Timing and scheduling the delivery of marketing messages to maximize their impact on customer purchasing behavior. Integrate individual messages to larger marketing campaigns and to seasonal purchasing patterns." ;
    bpot:hierarchyID "3.2.5.1" ;
    bpot:pcfID "16849" .

bpot:PCF_16850 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define public relations (PR) strategy" ;
    bpot:apqcSourceText "Deciding how to promote and maintain a favorable public image of the company in the eyes of its employees, customers, investors, suppliers, politicians or the general public. This may involve various means but is frequently conducted through publicity, education, corporate social responsibility, charitable causes or civic engagements." ;
    bpot:hierarchyID "3.2.5.2" ;
    bpot:pcfID "16850" .

bpot:PCF_16851 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define direct marketing strategy" ;
    bpot:apqcSourceText "Devising a master plan how to select potential customers or qualified clients for customized offers, and contact them on one-to-one basis through chat, phone, email or regular mail. The strategy would need to take into account that personalizing offers and contacting customers individually is an effective but resource-intensive marketing technique, and that ill-targeted offers risk at angering and alienating the contactees." ;
    bpot:hierarchyID "3.2.5.3" ;
    bpot:pcfID "16851" .

bpot:PCF_16852 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define internal marketing communication strategy" ;
    bpot:apqcSourceText "Developing a program to promote the objectives, values, products and services of the company to its employees by treating them as potential customers, in order to extend company client base, increase employee engagement or to foster brand advocacy." ;
    bpot:hierarchyID "3.2.5.4" ;
    bpot:pcfID "16852" .

bpot:PCF_16853 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify new media for marketing communication" ;
    bpot:apqcSourceText "Finding emerging media based on digital or other technologies that would enable the company to increase the speed and volume of marketing communications, to make communications more interactive and to customize promotional messages more easily to the target audience, thus rendering them more effective." ;
    bpot:hierarchyID "3.2.5.5" ;
    bpot:pcfID "16853" .

bpot:PCF_16854 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define new media communication strategy" ;
    bpot:apqcSourceText "Developing a marketing strategy that is maximally effective in a new or emerging media channel by capitalizing on its novel attributes and capabilities." ;
    bpot:hierarchyID "3.2.5.6" ;
    bpot:pcfID "16854" .

bpot:PCF_16855 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define point of sale (POS) communication strategy" ;
    bpot:apqcSourceText "Establishing a framework for coordinated marketing to increase the profitability and increase brand awareness at the point of sale. This may include promotional posters on product shelves or island displays, advertisements in shopping carts, stickers on the floor that lead consumers to the promoted product, multi-buy promotions, coupons on sales receipts, etc. " ;
    bpot:hierarchyID "3.2.5.7" ;
    bpot:pcfID "16855" .

bpot:PCF_16890 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20089 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create and manage warranty rules/claim codes for products" ;
    bpot:apqcSourceText "Establishing and maintaining claims processing and routing rules. Establish and maintain claims processing and routing rules for product warranties, coverage lists, repair, fault, trouble codes, repair time setup, and warranty policy registration. This also includes rolling out the codes and rules, and the improvements/updates to these rules and codes via systematic updates." ;
    bpot:hierarchyID "6.1.6.2" ;
    bpot:pcfID "16890" .

bpot:PCF_16893 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20089 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine and document warranty policies" ;
    bpot:apqcSourceText "Establishing warranty policies to assure customers that the company will guarantee its warranties that it issues. " ;
    bpot:hierarchyID "6.1.6.1" ;
    bpot:pcfID "16893" .

bpot:PCF_16905 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10338 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define reverse logistics strategy" ;
    bpot:apqcSourceText "Establish a strategy that includes rules and regulations for the physical handling, information processing, and disposition of product and packaging returned by the buyer to the seller or an intermediary. Include return approval, transportation coordination, advance communication, product tracking, receipt, disposition of the return, and processing warranty claims in the strategy." ;
    bpot:hierarchyID "4.4.1.7" ;
    bpot:pcfID "16905" .

bpot:PCF_16928 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10388 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and capture upsell/cross-sell opportunities" ;
    bpot:apqcSourceText "Utilizing customer inquiries as opportunities to either provide a comparable service to the one in question, offer additional complimentary service, or suggest a service that is better than what was initially offered." ;
    bpot:hierarchyID "6.2.2.5" ;
    bpot:pcfID "16928" .

bpot:PCF_16937 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10388 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver opportunity to sales team" ;
    bpot:apqcSourceText "Providing possible sales leads to the sales team in an effort to garner more business opportunities." ;
    bpot:hierarchyID "6.2.2.6" ;
    bpot:pcfID "16937" .

bpot:PCF_16938 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop high performers/leadership programs" ;
    bpot:apqcSourceText "Creating a program that incorporates incentives and compensation put forth by the organization to recognize high performing workers and excellence in leadership." ;
    bpot:hierarchyID "7.1.2.5" ;
    bpot:pcfID "16938" .

bpot:PCF_16940 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10473 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define employee competencies and skills" ;
    bpot:apqcSourceText "Defining the skills, knowledge, abilities, and attributes needed to carry out a specific job." ;
    bpot:hierarchyID "7.3.4.2" ;
    bpot:pcfID "16940" .

bpot:PCF_16944 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21451 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct employee engagement surveys" ;
    bpot:apqcSourceText "Questioning employees to ascertain overall workplace satisfaction. " ;
    bpot:hierarchyID "7.8.2" ;
    bpot:pcfID "16944" .

bpot:PCF_16958 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10734 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage financial fraud/dispute cases" ;
    bpot:apqcSourceText "Handling cases that involve financial fraud. Resolve disputes." ;
    bpot:hierarchyID "9.7.6" ;
    bpot:pcfID "16958" .

bpot:PCF_17041 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10224 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain master production schedule" ;
    bpot:apqcSourceText "Supervising and overseeing the plan for internal activities such as production, inventory, and staffing. Set the quantity of items to produce each week of a short-range planning horizon." ;
    bpot:hierarchyID "4.1.4.3" ;
    bpot:pcfID "17041" .

bpot:PCF_17046 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17043 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop competency management models" ;
    bpot:apqcSourceText "Creating and implementing the tools for managing the competency levels of HR. Design a model for integrating HR planning with business planning. Assess current HR capacity based on the competencies against the capacity needed to achieve the vision, mission, and business goals of the organization. Consider factors such as employee development, career path, compensation policies, and performance management." ;
    bpot:hierarchyID "7.1.4" ;
    bpot:pcfID "17046" .

bpot:PCF_17047 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10440 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee referral programs" ;
    bpot:apqcSourceText "Creating and managing a recruiting strategy where current employees are rewarded for referring qualified candidates for employment. " ;
    bpot:hierarchyID "7.2.2.4" ;
    bpot:pcfID "17047" .

bpot:PCF_17048 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10440 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage recruitment channels" ;
    bpot:apqcSourceText "Establishing and maintaining channels for recruiting. Extract the best out of every recruitment channel. Manage all the processes related to all the sourcing channels." ;
    bpot:hierarchyID "7.2.2.5" ;
    bpot:pcfID "17048" .

bpot:PCF_17050 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10469 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute onboarding program" ;
    bpot:apqcSourceText "Bringing the employee on-boarding program into effect. Implement Create/Maintain employee on-boarding program [10474]. Conduct training sessions and employee engagement programs." ;
    bpot:hierarchyID "7.3.1.3" ;
    bpot:pcfID "17050" .

bpot:PCF_17051 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee skill and competency development" ;
    bpot:apqcSourceText "Administering the development of employee skills. Conduct training, coaching and mentoring, job-rotation and cross training, lateral moves, etc." ;
    bpot:hierarchyID "7.3.3.3" ;
    bpot:pcfID "17051" .

bpot:PCF_17389 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19990 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify product/service bundling opportunities" ;
    bpot:apqcSourceText "Establishing areas of growth and further development of product/service mix, customization, market based changes, etc., to further demonstrate value to the customer in the competition." ;
    bpot:hierarchyID "2.2.3.3" ;
    bpot:pcfID "17389" .

bpot:PCF_17469 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17468 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop enterprise compliance policies and procedures" ;
    bpot:apqcSourceText "Creating a standardized approach to ethics and compliance. Have a programmatic approach for compliance that focuses on the definite risks the organization faces." ;
    bpot:hierarchyID "11.2.1.1" ;
    bpot:pcfID "17469" .

bpot:PCF_17470 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17468 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement enterprise compliance activities" ;
    bpot:apqcSourceText "Implementing standardized for ethics and compliance. Have a programmatic approach, built from the top down, to enterprise compliance that focuses on the definite risks the organization faces." ;
    bpot:hierarchyID "11.2.1.2" ;
    bpot:pcfID "17470" .

bpot:PCF_17473 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define critical-to-quality characteristics" ;
    bpot:apqcSourceText "Outlining characteristics crucial for managing enterprise quality. Translate broad customer needs into specific, actionable, measurable performance requirements. Define the key measurable characteristics of key products and processes." ;
    bpot:hierarchyID "13.3.1.1" ;
    bpot:pcfID "17473" .

bpot:PCF_17474 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define preventive quality activities" ;
    bpot:apqcSourceText "Identifying gaps in customer requirements and determining whether the gap will be mitigated through preventive Quality activities or deemed as acceptable risk. The goal of any preventive quality activities is to create provisions to prevent, control, or reduce the risk of not meeting the CtQCs. In addition, any standard methodology that will be used to design or conduct preventive Quality activities are defined and documented." ;
    bpot:hierarchyID "13.3.1.2" ;
    bpot:pcfID "17474" .

bpot:PCF_17476 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17475 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define process steps for controls (or integration points)" ;
    bpot:apqcSourceText "Establishing the steps for developing quality controls. Conduct Alpha testing. Have the product team conduct rework. Send the product/service for Beta testing, and carry on rework as needed." ;
    bpot:hierarchyID "13.3.1.3.1" ;
    bpot:pcfID "17476" .

bpot:PCF_17477 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17475 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define sampling plan" ;
    bpot:apqcSourceText "Establishing a detailed summary including measures, on which material, in what manner, and by whom. Identify the parameters to be measured, the range of possible values, and the required resolution. Provide a sampling scheme that details how and when samples will be taken. Select sample sizes. Assign roles and responsibilities." ;
    bpot:hierarchyID "13.3.1.3.2" ;
    bpot:pcfID "17477" .

bpot:PCF_17478 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17475 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify measurement methods" ;
    bpot:apqcSourceText "Using tools to measure quality. Use tools such as quality improvement oversight system tool, performance measurement tools, consumer information models/guides, and validation tools to effectively determine the quality levels." ;
    bpot:hierarchyID "13.3.1.3.3" ;
    bpot:pcfID "17478" .

bpot:PCF_17479 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17475 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define required competencies" ;
    bpot:apqcSourceText "Defining the competencies required for developing quality controls. Define the required competencies including compliance management, audit management, and document control and document management." ;
    bpot:hierarchyID "13.3.1.3.4" ;
    bpot:pcfID "17479" .

bpot:PCF_17480 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prove capability to assess compliance with requirements" ;
    bpot:apqcSourceText "Demonstrating the ability and capability to confirm and fulfill the quality requirements in front of customers, managers, employees, board members, associations, regulatory bodies, and creditors. Leverage tools and techniques such as process behavior or control charts, statistical process control, measurement system analysis, gage calibration management, and process capability analysis." ;
    bpot:hierarchyID "13.3.1.4" ;
    bpot:pcfID "17480" .

bpot:PCF_17481 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Finalize quality plan" ;
    bpot:apqcSourceText "Establishing how the critical-to-quality characteristics will be achieved, controlled, ensured, and managed throughout the lifecycle of a product/service. Address quality requirements and critical-to-quality characteristics. Conduct a preventive quality assessment. Describe how to verify the product/service, verification criteria, and response to nonconformance. Keep records to demonstrate conformity." ;
    bpot:hierarchyID "13.3.1.5" ;
    bpot:pcfID "17481" .

bpot:PCF_17484 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17483 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct test and collect data" ;
    bpot:apqcSourceText "Evaluating quality performance through periodic or episodic testing against the established standards for quality characteristics. For periodic testing, design a schedule with sufficient time to make any required adjustments to the process or system to maintain the desired level of quality. For episodic testing, conduct a test whenever a known non-conformance or fault occurs, which results in outputs or outcomes known to be unsatisfactory to performance requirements." ;
    bpot:hierarchyID "13.3.2.1.1" ;
    bpot:pcfID "17484" .

bpot:PCF_17485 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17483 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record result(s)" ;
    bpot:apqcSourceText "Maintaining and recording the results of Test against the quality plan [17483] electronically and in standard formats. Assign ownership to a designated function or role. " ;
    bpot:hierarchyID "13.3.2.1.2" ;
    bpot:pcfID "17485" .

bpot:PCF_17486 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17483 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine disposition of result(s)" ;
    bpot:apqcSourceText "Deciding whether to take any additional actions based on the results of quality tests. Initiate a quarantine disposition and relocated inventory, scrap workflow item and scrap transaction, rework operation, net-able and nonnet-able items, and the activity list." ;
    bpot:hierarchyID "13.3.2.1.3" ;
    bpot:pcfID "17486" .

bpot:PCF_17488 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17487 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess sample significance" ;
    bpot:apqcSourceText "Assessing the significance of the sample chosen for the test in order to determine whether or not the sample is representative of the larger output or outcome. Determine if the sample meets or does not meet the requirements. Identify the conditions for acceptance, rejection, remediation, and prevention." ;
    bpot:hierarchyID "13.3.2.2.1" ;
    bpot:pcfID "17488" .

bpot:PCF_17489 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17487 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Summarize result(s)" ;
    bpot:apqcSourceText "Outlining the major facts and figures of the quality test results in order to provide insights and information. Use charts, tables, statistical test results, and written findings and conclusions in a summary of results." ;
    bpot:hierarchyID "13.3.2.2.2" ;
    bpot:pcfID "17489" .

bpot:PCF_17490 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17487 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Recommend actions" ;
    bpot:apqcSourceText "Recommending measures for improvement. Assess the summarized results to identify areas which can be improved. Suggest actions to management for improving the quality plan basis on the results of the tests." ;
    bpot:hierarchyID "13.3.2.2.3" ;
    bpot:pcfID "17490" .

bpot:PCF_17491 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17487 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Decide next steps" ;
    bpot:apqcSourceText "Selecting the subsequent actions that the organization can adopt for improving the enterprise quality. Select measures and recommended actions for managing the enterprise quality." ;
    bpot:hierarchyID "13.3.2.2.4" ;
    bpot:pcfID "17491" .

bpot:PCF_17493 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17492 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess potential impact" ;
    bpot:apqcSourceText "Analyzing any nonconformance events. Determine the need for corrective and/or preventative action(s). Leverage root-cause analysis, risk exposure, and other evaluations to properly review and approve/reject subsequent actions." ;
    bpot:hierarchyID "13.3.3.1" ;
    bpot:pcfID "17493" .

bpot:PCF_17494 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17492 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine immediate action(s)" ;
    bpot:apqcSourceText "Initiating immediate corrective, preventative, or no action based upon the impact and likelihood of reoccurrence. Consider cost/benefit, risk exposure, timing, the assignment of responsibility, and other pertinent factors ." ;
    bpot:hierarchyID "13.3.3.2" ;
    bpot:pcfID "17494" .

bpot:PCF_17495 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17492 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify root cause(s)" ;
    bpot:apqcSourceText "Recognizing the reasons that have triggered the nonconformance events or activities. Perform a root-cause analysis through documentary evidence and interviews. Involve the appropriate individuals. Leverage cause analysis and risk assessment." ;
    bpot:hierarchyID "13.3.3.3" ;
    bpot:pcfID "17495" .

bpot:PCF_17496 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17492 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Take corrective or preventative action" ;
    bpot:apqcSourceText "Pursuing corrective and preventative activities to eliminate the cause of a detected nonconformity. Define the nonconformity. Communicate and assign responsibility. Identify the appropriate corrective and preventive action. Implement and monitor for reoccurrence. " ;
    bpot:hierarchyID "13.3.3.4" ;
    bpot:pcfID "17496" .

bpot:PCF_17497 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17492 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Close non-conformance" ;
    bpot:apqcSourceText "Closing nonconformance. Perform all the final processes related to the nonconformance, including documenting root causes. Document corrective and preventive actions." ;
    bpot:hierarchyID "13.3.3.5" ;
    bpot:pcfID "17497" .

bpot:PCF_17499 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17498 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define the quality strategy" ;
    bpot:apqcSourceText "Outlining the strategy for managing enterprise quality. Define and formalize quality techniques and standards. Assign responsibilities for achieving the required quality levels. Standardize the quality maintenance procedure, tools and techniques, recording and reporting, the timing of quality maintenance activities, and the roles and responsibilities for the quality management team." ;
    bpot:hierarchyID "13.3.4.1" ;
    bpot:pcfID "17499" .

bpot:PCF_17500 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17498 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and deploy the EQMS scope, targets, and goals" ;
    bpot:apqcSourceText "Establishing and effectively deploying the scope, targets, and goals of EQMS. Define the role of EQMS through nonconformance/corrective and preventive action, compliance/audit management, risk management, failure mode and effects analysis, and statistical process control. Implement EQMS into operational activities. Define the goals and objectives that are to be achieved by the EQMS." ;
    bpot:hierarchyID "13.3.4.2" ;
    bpot:pcfID "17500" .

bpot:PCF_17501 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17498 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify core EQMS processes, controls, and metrics" ;
    bpot:apqcSourceText "Recognizing and implementing the processes, controls, and metrics for maintenance of EQMS. Define the role of EQMS in failure mode and effects analysis, complaint handling, and advanced product quality planning. Establish the role of EQMS in evaluating metrics such as cost of quality, overall equipment effectiveness, on-time and complete shipments, percentage of products in compliance, and new product introductions." ;
    bpot:hierarchyID "13.3.4.3" ;
    bpot:pcfID "17501" .

bpot:PCF_17502 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17498 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and document EQMS policies, procedures, standards, and measures" ;
    bpot:apqcSourceText "Setting the process limits. Gather required information. Align with other documents and processes. Define the document structure." ;
    bpot:hierarchyID "13.3.4.4" ;
    bpot:pcfID "17502" .

bpot:PCF_17503 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17498 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess the EQMS performance" ;
    bpot:apqcSourceText "Benchmarking current performance in quality metrics that span across the value chain. Identify gaps in performance as compared to industry peers. Identify and implement complementary EQMS capabilities. Enable a continuous improvement environment." ;
    bpot:hierarchyID "13.3.4.5" ;
    bpot:pcfID "17503" .

bpot:PCF_17505 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17504 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reward quality excellence" ;
    bpot:apqcSourceText "Provisioning rewards for achieving quality excellence. Provide monetary and nonmonetary rewards such as compensation, vacations, gift cards, and reimbursements to employees in in recognition of their services, efforts, and achievements in quality excellence." ;
    bpot:hierarchyID "13.3.4.6.1" ;
    bpot:pcfID "17505" .

bpot:PCF_17506 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17504 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create and maintain quality partnerships" ;
    bpot:apqcSourceText "Establishing and maintaining partnerships with third-party sources to achieve quality excellence. Source and evaluate third-party sources both public and private to ensure that the most effective and efficient partnerships are formed." ;
    bpot:hierarchyID "13.3.4.6.2" ;
    bpot:pcfID "17506" .

bpot:PCF_17507 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17504 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain talent capabilities and competencies" ;
    bpot:apqcSourceText "Maintaining a common denominator for the competency level within the organization's talent circle. Conduct training sessions, skill development activities, and quality excellence activities to ensure that the resources of the organization are competent enough and have the capabilities to achieve the required level of quality." ;
    bpot:hierarchyID "13.3.4.6.3" ;
    bpot:pcfID "17507" .

bpot:PCF_17508 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17504 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Incorporate EQMS messaging into communication channels" ;
    bpot:apqcSourceText "Assimilating all the communication related to the EQMS into the organization's already established communication channels. " ;
    bpot:hierarchyID "13.3.4.6.4" ;
    bpot:pcfID "17508" .

bpot:PCF_17509 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17504 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assure independent EQMS management access to appropriate authority in the organization" ;
    bpot:apqcSourceText "Ensuring EQMS access to the person in charge of the quality management process. Establish who has the authority to manage the EQMS. Ensure access of EQMS to only the person(s) in authority. " ;
    bpot:hierarchyID "13.3.4.6.5" ;
    bpot:pcfID "17509" .

bpot:PCF_17510 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_17504 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Transfer proven EQMS methods" ;
    bpot:apqcSourceText "Recording and transferring the best practices and proven methods associated with enterprise quality management systems (EQMS) that can be leveraged in improving the organization's framework. Record proven methodologies and approaches with the objective of communicating them for upgrading, refining, and enhancing the organization's systems." ;
    bpot:hierarchyID "13.3.4.6.6" ;
    bpot:pcfID "17510" .

bpot:PCF_17682 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10131 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate product market share" ;
    bpot:apqcSourceText "Determining the percentage of total sales volume in the market for a particular product." ;
    bpot:hierarchyID "3.4.3.1" ;
    bpot:pcfID "17682" .

bpot:PCF_17683 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10149 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine projected ROI for marketing investment" ;
    bpot:apqcSourceText "Estimating how much profit the company would generate for its expenses on marketing . Forecasted return on investment, used as a metric to gauge the efficiency of marketing, is beneficial in revising marketing budgets and adjusting costs to improve the overall yield. " ;
    bpot:hierarchyID "3.3.2.4" ;
    bpot:pcfID "17683" .

bpot:PCF_17684 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Achieve regulatory approval for pricing" ;
    bpot:apqcSourceText "Obtaining internal price approvals and governmental approvals that are required for licensed products and for products that can be reimbursed by the government." ;
    bpot:hierarchyID "3.3.3.10" ;
    bpot:pcfID "17684" .

bpot:PCF_18083 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10047 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select partnerships and relationships to support the extended enterprise" ;
    bpot:apqcSourceText "Supporting the design, manufacture and distribution of product and services through the extended enterprise model.  This is concerned with the strategic decisions on make vs buy, in house or out sourced.  Senior Executives map out how they want to run their business.  Make strategic choices as to whether to buy in components / sub-assemblies, run their own distribution fleet or contract out, own their dealerships or franchise out, etc.  Strategize with partnerships. Collaborate design consideration at strategy level for automotive and procurement act within the Target Operating Model set at strategy level." ;
    bpot:hierarchyID "1.2.2.1.1" ;
    bpot:pcfID "18083" .

bpot:PCF_18115 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Validate and qualify leads/opportunities" ;
    bpot:apqcSourceText "Reviewing the set of potential customers and sales opportunities. Approve the leads that meet company requirements on new businesses." ;
    bpot:hierarchyID "3.5.1.3" ;
    bpot:pcfID "18115" .

bpot:PCF_18116 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop opportunity win plans" ;
    bpot:apqcSourceText "Creating plans about how to close leads and win sales opportunities. " ;
    bpot:hierarchyID "3.5.1.5" ;
    bpot:pcfID "18116" .

bpot:PCF_18126 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10401 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide customer feedback to product management on customer service experience" ;
    bpot:apqcSourceText "Handing over data to management to analyze common issues in regards to customer service." ;
    bpot:hierarchyID "6.5.1.3" ;
    bpot:pcfID "18126" .

bpot:PCF_18129 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16458 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess adequacy of insurance coverage" ;
    bpot:apqcSourceText "Evaluating the changing needs for insurance coverage. Research available insurance providers and offerings. " ;
    bpot:hierarchyID "11.1.3.3.1" ;
    bpot:pcfID "18129" .

bpot:PCF_18130 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16629 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product copy" ;
    bpot:apqcSourceText "Authoring or overseeing the creation of the textual portion of a product description, advertisement, or web page, including the headline, body, product attributes, and brand or advertiser information. A copy is designed to provide information about the product and to catch and hold the interest of prospective buyers long enough to persuade them to make a purchase. The copy of a website is called its content. " ;
    bpot:hierarchyID "3.3.9.2" ;
    bpot:pcfID "18130" .

bpot:PCF_18592 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10952 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor useful life of assets" ;
    bpot:apqcSourceText "Monitoring assets against their planned useful life. Each asset may have specific criteria that indicate their usability. This may include time-based, maintenance history, capacity planning, etc." ;
    bpot:hierarchyID "10.4.1.1" ;
    bpot:pcfID "18592" .

bpot:PCF_18627 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16848 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define communication guidelines and mechanisms" ;
    bpot:apqcSourceText "Establishing standardized procedures for effective communication that maximizes ROI, promotes brand awareness and respects customers. In its simplest form, it includes a message (what is to be said), a target (to whom the message is reaching) and a medium or a channel (where the message is to be said)." ;
    bpot:hierarchyID "3.2.5.8" ;
    bpot:pcfID "18627" .

bpot:PCF_18629 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish partner and alliance agreements" ;
    bpot:apqcSourceText "Setting up strategic alliances with key trade partners and ratifying partnership agreements." ;
    bpot:hierarchyID "3.4.2.9" ;
    bpot:pcfID "18629" .

bpot:PCF_18641 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10187 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide marketing materials to sales partners/alliances" ;
    bpot:apqcSourceText "Distributing marketing materials and sales brochures to entities that the company partners with." ;
    bpot:hierarchyID "3.5.5.2" ;
    bpot:pcfID "18641" .

bpot:PCF_18916 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate strategies internally and externally" ;
    bpot:apqcSourceText "Conveying planned procedures and methods to both internal departments and external stakeholders like customers, suppliers, etc., in an effective manner based on organizational objective." ;
    bpot:hierarchyID "1.2.9" ;
    bpot:pcfID "18916" .

bpot:PCF_18925 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_18924 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Acquire members to customer loyalty program" ;
    bpot:apqcSourceText "Convincing customers to register their personal information with the company and be assigned a unique identifier that they use when making purchases. The identifier makes it easier for the company to track customer purchases. Customers are rewarded by various incentives that encourage repeat business [20007]. " ;
    bpot:hierarchyID "3.2.6.2" ;
    bpot:pcfID "18925" .

bpot:PCF_18926 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_18924 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Build engagement and relationship with members" ;
    bpot:apqcSourceText "Building deeper relationships between a customer and a brand in order to promote customer loyalty and derive repeat business. Besides making frequent purchases, highly engaged customers refer family, friends and colleagues to make purchases as well, consume and re-broadcast promotional materials, provide feedback to the purchases they make and do not support competing brands." ;
    bpot:hierarchyID "3.2.6.3" ;
    bpot:pcfID "18926" .

bpot:PCF_18927 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_18924 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Optimize loyalty program value to both the enterprise and the customer" ;
    bpot:apqcSourceText "Enhancing the customer loyalty program so that it will yield maximum value both for the company and for the patrons enrolled in the program, increasing customer retention and continued engagement." ;
    bpot:hierarchyID "3.2.6.5" ;
    bpot:pcfID "18927" .

bpot:PCF_18941 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10117 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify under-served and saturated market segments" ;
    bpot:apqcSourceText "Determining which groups of potential customers do not yet, or already do have access to the product or a service that the company produces or markets. Use those findings to create specialized product offerings and differentiated marketing campaigns." ;
    bpot:hierarchyID "3.1.2.2.1" ;
    bpot:pcfID "18941" .

bpot:PCF_18948 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine corporate incentives" ;
    bpot:apqcSourceText "Introducing financial inducements, such as discounts, to distributors, resellers or vendors as a motivation to prioritize selling company's products or services over those of its competitors." ;
    bpot:hierarchyID "3.3.3.2" ;
    bpot:pcfID "18948" .

bpot:PCF_19072 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10389 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer complaints and response/redressal" ;
    bpot:apqcSourceText "Analyzing complaint logs to provide input for continuous service improvement and customer profiling." ;
    bpot:hierarchyID "6.2.3.5" ;
    bpot:pcfID "19072" .

bpot:PCF_19210 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19209 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define capital investment plan" ;
    bpot:apqcSourceText "Establishing what funds will be invested in the construction of productive assets for the advancement of established business objectives. " ;
    bpot:hierarchyID "10.2.1.1" ;
    bpot:pcfID "19210" .

bpot:PCF_19211 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19209 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor capital program" ;
    bpot:apqcSourceText "Monitoring plans on capital projects. Capital projects can be purchasing buildings, lands, etc. " ;
    bpot:hierarchyID "10.2.1.2" ;
    bpot:pcfID "19211" .

bpot:PCF_19212 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19209 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Secure construction financing" ;
    bpot:apqcSourceText "Acquiring the loans needed to construct necessary assets." ;
    bpot:hierarchyID "10.2.1.3" ;
    bpot:pcfID "19212" .

bpot:PCF_19220 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20139 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop construction strategy" ;
    bpot:apqcSourceText "Developing a strategy to perform asset construction. Assure that timelines, regulations, and resources are on task and on budget." ;
    bpot:hierarchyID "10.2.2.1" ;
    bpot:pcfID "19220" .

bpot:PCF_19221 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20139 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Obtain construction permissions" ;
    bpot:apqcSourceText "Gathering the required permits for construction from the proper jurisdiction. This may include inspections during and after construction to verify that the new asset meets all national, regional, and local codes." ;
    bpot:hierarchyID "10.2.2.3" ;
    bpot:pcfID "19221" .

bpot:PCF_19222 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20139 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design assets" ;
    bpot:apqcSourceText "Designing assets to meet organizational needs as well as ensuring that the asset adheres to all national, regional, and local construction codes. " ;
    bpot:hierarchyID "10.2.2.4" ;
    bpot:pcfID "19222" .

bpot:PCF_19223 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20139 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan construction resources" ;
    bpot:apqcSourceText "Determining what resources will need to be acquired in order to carry out construction. Plan when, where, and how resources will be used. Determine the length of time resources will be utilized." ;
    bpot:hierarchyID "10.2.2.5" ;
    bpot:pcfID "19223" .

bpot:PCF_19225 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19224 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor work performance" ;
    bpot:apqcSourceText "Monitoring construction to insure that all regulatory laws are being adhered to, that all work is being performed in a timely manner, and that quality assurance is met at all steps of the construction process." ;
    bpot:hierarchyID "10.2.4.1" ;
    bpot:pcfID "19225" .

bpot:PCF_19226 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19224 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Undertake construction quality control" ;
    bpot:apqcSourceText "Implementing a checks and balances system to verify that the construction was performed correctly. Rework when errors are found. " ;
    bpot:hierarchyID "10.2.4.2" ;
    bpot:pcfID "19226" .

bpot:PCF_19227 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19224 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create work and asset records" ;
    bpot:apqcSourceText "Implementing records to include all construction work that has been performed. Include all new or modified construction, and any construction or regulatory issues that might have occurred." ;
    bpot:hierarchyID "10.2.4.3" ;
    bpot:pcfID "19227" .

bpot:PCF_19228 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19224 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage safety, security, and access to sites" ;
    bpot:apqcSourceText "Ensuring that safety, security, and access is maintained. Provide a workplace that meets and exceeds all local, state, and federal guidelines. Provide security and access to the building site as set forth by safety and organizational guidelines." ;
    bpot:hierarchyID "10.2.4.4" ;
    bpot:pcfID "19228" .

bpot:PCF_19230 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19229 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Schedule construction work" ;
    bpot:apqcSourceText "Defining a timetable for which to execute the construction of the asset." ;
    bpot:hierarchyID "10.2.3.1" ;
    bpot:pcfID "19230" .

bpot:PCF_19231 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19229 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Obtain resources" ;
    bpot:apqcSourceText "Gathering resources needed to complete all construction work. Verify that all resources have the proper training and skills to perform the work." ;
    bpot:hierarchyID "10.2.3.2" ;
    bpot:pcfID "19231" .

bpot:PCF_19232 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19229 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Construct new assets" ;
    bpot:apqcSourceText "Building new assets necessary for the organization. Be aware of any construction codes and permits that need to be addressed." ;
    bpot:hierarchyID "10.2.3.3" ;
    bpot:pcfID "19232" .

bpot:PCF_19233 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19229 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Augment existing assets" ;
    bpot:apqcSourceText "Modifying existing assets to align with the changing needs of the organization. Be aware of any construction codes and permits that need to be addressed." ;
    bpot:hierarchyID "10.2.3.4" ;
    bpot:pcfID "19233" .

bpot:PCF_19234 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19229 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Renew/Replace assets" ;
    bpot:apqcSourceText "Determining the need to replace existing assets. Be aware of any construction codes and permits that need to be addressed." ;
    bpot:hierarchyID "10.2.3.5" ;
    bpot:pcfID "19234" .

bpot:PCF_19240 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19239 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop maintenance strategies" ;
    bpot:apqcSourceText "Creating goals and agendas to better realize the success of the maintenance policies that have been put into place." ;
    bpot:hierarchyID "10.3.1.1" ;
    bpot:pcfID "19240" .

bpot:PCF_19241 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19239 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Specify maintenance policies" ;
    bpot:apqcSourceText "Communicating policies in regards to asset maintenance. Provide a clear set of procedures and policies that outline what will be involved in the maintenance process. " ;
    bpot:hierarchyID "10.3.1.3" ;
    bpot:pcfID "19241" .

bpot:PCF_19242 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19239 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify work management tasks & priorities" ;
    bpot:apqcSourceText "Identifying the steps needed for asset maintenance. List out the those tasks that are involved in completing this process. Prioritize the tasks that are created." ;
    bpot:hierarchyID "10.3.1.5" ;
    bpot:pcfID "19242" .

bpot:PCF_19243 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19239 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct resource planning" ;
    bpot:apqcSourceText "Analyzing workload needs in relation to asset maintenance and plan resources around those needs." ;
    bpot:hierarchyID "10.3.1.6" ;
    bpot:pcfID "19243" .

bpot:PCF_19244 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19239 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create work plans" ;
    bpot:apqcSourceText "Creating procedures on how to maintain productive assets. " ;
    bpot:hierarchyID "10.3.1.7" ;
    bpot:pcfID "19244" .

bpot:PCF_19246 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19245 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Schedule maintenance work" ;
    bpot:apqcSourceText "Defining a timetable for which to execute the maintenance of the asset. " ;
    bpot:hierarchyID "10.3.2.1" ;
    bpot:pcfID "19246" .

bpot:PCF_19247 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19245 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Obtain required resources" ;
    bpot:apqcSourceText "Gathering resources needed to complete all maintenance work. Verify that all resources have the proper training and skills to perform the work." ;
    bpot:hierarchyID "10.3.2.2" ;
    bpot:pcfID "19247" .

bpot:PCF_19248 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19245 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Undertake quality control" ;
    bpot:apqcSourceText "Implementing a checks and balances system to verify that the maintenance was performed correctly. Rework when errors are found. " ;
    bpot:hierarchyID "10.3.2.3" ;
    bpot:pcfID "19248" .

bpot:PCF_19249 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19245 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Update work and asset records" ;
    bpot:apqcSourceText "Modifying existing maintenance records to include all new work that has been performed, what assets were serviced, and any issues that might have arisen. " ;
    bpot:hierarchyID "10.3.2.4" ;
    bpot:pcfID "19249" .

bpot:PCF_19250 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19245 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage maintenance work safety" ;
    bpot:apqcSourceText "Assuring that all safety laws and regulations are being implemented and followed. Align practices with regulatory bureaus such as OSHA , EHS, and ISO. " ;
    bpot:hierarchyID "10.3.2.5" ;
    bpot:pcfID "19250" .

bpot:PCF_19251 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19245 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define maintenance performance targets" ;
    bpot:apqcSourceText "Outlining what should be achieved through predictive indicators with regard to performing maintenance. This could include the length of time it takes to perform routine maintenance or how often unplanned maintenance feasibly occur." ;
    bpot:hierarchyID "10.3.2.6" ;
    bpot:pcfID "19251" .

bpot:PCF_19252 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19245 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor maintenance performance against targets/contracts" ;
    bpot:apqcSourceText "Following set performance targets, monitor and gage the success of the organization in meeting those targets." ;
    bpot:hierarchyID "10.3.2.7" ;
    bpot:pcfID "19252" .

bpot:PCF_19254 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19253 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform routine asset maintenance" ;
    bpot:apqcSourceText "Carrying out required maintenance to continue upkeep of equipment or assets. " ;
    bpot:hierarchyID "10.3.3.2" ;
    bpot:pcfID "19254" .

bpot:PCF_19255 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19253 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform corrective asset maintenance and repairs" ;
    bpot:apqcSourceText "Repairing or correcting faults that occur with an asset. This could be a break or other repairable damage. " ;
    bpot:hierarchyID "10.3.3.3" ;
    bpot:pcfID "19255" .

bpot:PCF_19256 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19253 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify unplanned maintenance requirements" ;
    bpot:apqcSourceText "Realizing potential or current problems with assets that would require unplanned maintenance. Unplanned maintenance is a repair or change that needs to be made that is not preventative or routine." ;
    bpot:hierarchyID "10.3.3.4" ;
    bpot:pcfID "19256" .

bpot:PCF_19257 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19253 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform unplanned maintenance and repairs" ;
    bpot:apqcSourceText "Performing repairs that occur outside of normal routine or preventative maintenance. " ;
    bpot:hierarchyID "10.3.3.5" ;
    bpot:pcfID "19257" .

bpot:PCF_19258 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21576 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Decommission productive assets" ;
    bpot:apqcSourceText "Retiring assets that are no longer viable to the business. Decommission assets that are no longer in working order, are out of date, or whose maintenance exceeds the cost of replacement." ;
    bpot:hierarchyID "10.4.2" ;
    bpot:pcfID "19258" .

bpot:PCF_19465 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21582 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor site for duration of time required by regulators" ;
    bpot:apqcSourceText "Managing and reporting site status. Align efforts to all legal, regulatory and social/environmental responsibilities." ;
    bpot:hierarchyID "10.4.10.3" ;
    bpot:pcfID "19465" .

bpot:PCF_19507 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10016 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute strategic initiatives" ;
    bpot:apqcSourceText "Successfully implement strategic initiatives. Execution of strategy is also defined as the process of implementing logical set of connected activities by an organization to make a strategy work." ;
    bpot:hierarchyID "1.3.5" ;
    bpot:pcfID "19507" .

bpot:PCF_19551 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define standard operating procedures" ;
    bpot:apqcSourceText "Establishing or prescribing methods to be followed routinely for the performance of designated operations or in designated situations. This may include step-by-step instructions to help workers carry out complex routine operations. The goal is to improve efficiency, quality, and uniformity of performance, while reducing miscommunication, failure, or rework." ;
    bpot:hierarchyID "4.1.1.8" ;
    bpot:pcfID "19551" .

bpot:PCF_19555 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine product storage facility requirements" ;
    bpot:apqcSourceText "Evaluate constraints, needs, parameters, and conditions for physical storage and retrieval of components or products for future use or shipment in a storage facility within a certain timeframe." ;
    bpot:hierarchyID "4.1.5.3" ;
    bpot:pcfID "19555" .

bpot:PCF_19558 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10226 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish storage management constraints" ;
    bpot:apqcSourceText "Determining potential constraints for physical storage and retrieval of components or products in a storage facility within a certain timeframe. Consider factors such as the building shape, height, capacity, door locations, lift equipment, automation, etc." ;
    bpot:hierarchyID "4.1.6.4" ;
    bpot:pcfID "19558" .

bpot:PCF_19563 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10303 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Model and simulate plant" ;
    bpot:apqcSourceText "Creating a representation of plant facilities to optimize material flow, resource utilization, and logistics for all levels of plant planning from global production facilities, through local plants, to specific lines and enabling the comparison of production�alternatives,." ;
    bpot:hierarchyID "4.3.1.1" ;
    bpot:pcfID "19563" .

bpot:PCF_19567 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19566 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Automate and control plant" ;
    bpot:apqcSourceText "Creating and applying technology to monitor and control the production and delivery of products and services. Automation involves a broad range of technologies." ;
    bpot:hierarchyID "4.3.2.5.1" ;
    bpot:pcfID "19567" .

bpot:PCF_19568 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19566 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform advanced process control" ;
    bpot:apqcSourceText "Including a broad range of techniques and technologies implemented within industrial process control systems that are routinely reviewed, audited, and improved, advanced process controls typically address particular performance or economic improvement opportunities. An advanced set of process control measures can be used to reduce variation and identify primary improvement options. Results of analysis are fed back into process design for incorporation into production. " ;
    bpot:hierarchyID "4.3.2.5.2" ;
    bpot:pcfID "19568" .

bpot:PCF_19569 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19566 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform real-time optimization" ;
    bpot:apqcSourceText "Helping organizations increase performance and efficiency, real-time optimization is a category of closed-loop process control that aims at optimizing process performance in real time for systems. It is normally built upon model-based optimization systems and is usually large scale. Real-time optimization automatically detects errors, and can modify and eliminate both random and non-random errors, as well as analyze and monitor all systems involved." ;
    bpot:hierarchyID "4.3.2.5.3" ;
    bpot:pcfID "19569" .

bpot:PCF_19570 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19566 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage plant alarms and alerts" ;
    bpot:apqcSourceText "Applying human factors and instrumentation engineering and systems thinking to manage the design of an alarm or alert system to increase its usability. Typical challenges include having too many alarms in a plant, poorly designed alarms/alerts, improperly set alarm/alert points, unclear alarm/alert messages, etc. Poor alarm management is one of the leading causes of unplanned downtime." ;
    bpot:hierarchyID "4.3.2.5.4" ;
    bpot:pcfID "19570" .

bpot:PCF_19575 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11209 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage interest rate market data" ;
    bpot:apqcSourceText "Collecting and storing data that pertains to interest rate markets. " ;
    bpot:hierarchyID "9.7.5.2.1" ;
    bpot:pcfID "19575" .

bpot:PCF_19576 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11209 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine interest rate exposure for all markets" ;
    bpot:apqcSourceText "Identifying potential interest rate risks for all markets." ;
    bpot:hierarchyID "9.7.5.2.2" ;
    bpot:pcfID "19576" .

bpot:PCF_19577 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11209 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine interest rate hedge requirements in accordance with risk policy" ;
    bpot:apqcSourceText "Deciding the requirements on interest rate investments that are made by trading in futures or options market, on the basis of the accepted risk policy." ;
    bpot:hierarchyID "9.7.5.2.3" ;
    bpot:pcfID "19577" .

bpot:PCF_19578 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11209 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute interest rate trades" ;
    bpot:apqcSourceText "Performing trading on interest rates." ;
    bpot:hierarchyID "9.7.5.2.4" ;
    bpot:pcfID "19578" .

bpot:PCF_19579 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11210 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage foreign exchange market data" ;
    bpot:apqcSourceText "Handling and processing information about changes in foreign exchange rates." ;
    bpot:hierarchyID "9.7.5.3.1" ;
    bpot:pcfID "19579" .

bpot:PCF_19580 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11210 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine foreign exchange exposure for all currencies" ;
    bpot:apqcSourceText "Establishing potential foreign exchange risks for all currencies. " ;
    bpot:hierarchyID "9.7.5.3.2" ;
    bpot:pcfID "19580" .

bpot:PCF_19581 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11210 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine foreign exchange hedge requirements in accordance with risk policy" ;
    bpot:apqcSourceText "Deciding the requirements on investments in foreign exchange made by trading in futures or options market, on the basis of current risk policy." ;
    bpot:hierarchyID "9.7.5.3.3" ;
    bpot:pcfID "19581" .

bpot:PCF_19582 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11210 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute foreign exchange trades" ;
    bpot:apqcSourceText "Executing all aspects for foreign exchange trade within foreign exchange market. This includes buying, selling, and exchanging currencies at the current or expressed price point." ;
    bpot:hierarchyID "9.7.5.3.4" ;
    bpot:pcfID "19582" .

bpot:PCF_19583 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11210 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage foreign exchange balance sheet risk" ;
    bpot:apqcSourceText "Overseeing the foreign exchange balance sheet with an eye towards potential risk. Risks include changes in conversion rates between the time the transaction occurred and when it is completed, or when transactions are made in a denomination other than that of the organization's base currency." ;
    bpot:hierarchyID "9.7.5.3.5" ;
    bpot:pcfID "19583" .

bpot:PCF_19584 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11211 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine current customer exposures and limit exceptions" ;
    bpot:apqcSourceText "Establishing ongoing risks that the customers face, and the exceptions to exceeded limits." ;
    bpot:hierarchyID "9.7.5.4.1" ;
    bpot:pcfID "19584" .

bpot:PCF_19585 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11211 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Resolve customer exposure limit violations" ;
    bpot:apqcSourceText "Settling cases that involve violations of customer exposure limit." ;
    bpot:hierarchyID "9.7.5.4.2" ;
    bpot:pcfID "19585" .

bpot:PCF_19586 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11211 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customer collateral" ;
    bpot:apqcSourceText "Handling customer securities to recover loans that are not paid back. " ;
    bpot:hierarchyID "9.7.5.4.3" ;
    bpot:pcfID "19586" .

bpot:PCF_19587 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11211 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform annual customer credit reviews" ;
    bpot:apqcSourceText "Conducting reviews to assess customer credit on a yearly basis. Introduce changes or make recommendations, if needed. " ;
    bpot:hierarchyID "9.7.5.4.4" ;
    bpot:pcfID "19587" .

bpot:PCF_19588 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure physical positions" ;
    bpot:apqcSourceText "Evaluating investments made in some market to offset the risks of investing in a contrary or opposing market." ;
    bpot:hierarchyID "9.7.5.5.1" ;
    bpot:pcfID "19588" .

bpot:PCF_19589 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish hedges" ;
    bpot:apqcSourceText "Determining which hedge options to execute. " ;
    bpot:hierarchyID "9.7.5.5.2" ;
    bpot:pcfID "19589" .

bpot:PCF_19590 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Unwind hedges" ;
    bpot:apqcSourceText "Closing out a position or cashing in derivatives early. " ;
    bpot:hierarchyID "9.7.5.5.3" ;
    bpot:pcfID "19590" .

bpot:PCF_19593 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform currency conversion" ;
    bpot:apqcSourceText "Identifying current exchange rates between two currencies and converting the foreign currency to that of the local monetary unit. I.E., yen to US dollar. " ;
    bpot:hierarchyID "9.11.4" ;
    bpot:pcfID "19593" .

bpot:PCF_19595 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Compile and communicate compliance scorecard(s)" ;
    bpot:apqcSourceText "Creating a graphical representation of metrics in order to communicate the general health of the organization in relation to risk and compliancy." ;
    bpot:hierarchyID "11.2.2.7" ;
    bpot:pcfID "19595" .

bpot:PCF_19596 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16463 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Compile and communicate internal and regulatory compliance reports" ;
    bpot:apqcSourceText "Submitting compliance reports to regulatory agencies. These reports can be made to environmental, securities, or human resources agencies as stipulated by the local governing body." ;
    bpot:hierarchyID "11.2.2.8" ;
    bpot:pcfID "19596" .

bpot:PCF_19646 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11423 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Carry out post launch analytics to test the acceptability in the market" ;
    bpot:apqcSourceText "Measuring the performance of marketing once the product/services are launched. This broadly covers measuring user engagement and product's/service's performance in the market." ;
    bpot:hierarchyID "2.1.2.5.1" ;
    bpot:pcfID "19646" .

bpot:PCF_19647 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11423 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Apply data and analytics to review supply chain methodologies" ;
    bpot:apqcSourceText "Collecting and examining raw data with the purpose of drawing conclusions about that information and correlate gaps and efficiencies to the existing supply chain channels. Apply the information to make better business decisions to the related supply chain methodologies to meet efficiency." ;
    bpot:hierarchyID "2.1.2.5.4" ;
    bpot:pcfID "19647" .

bpot:PCF_19697 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19985 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define product technical documentation management requirements" ;
    bpot:apqcSourceText "Defining sourcing and procurement requirements for new product technical documentation management. Make sourcing-based decisions that identify the capabilities that will be required in order to launch the new product. This documentation will be used to support the product following entry into service. It is compiled and managed in Manage product and process related data [12082], but the capability to manage and maintain this documentation must be defined and established." ;
    bpot:hierarchyID "2.1.3.4" ;
    bpot:pcfID "19697" .

bpot:PCF_19941 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19985 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct mandatory and elective reviews" ;
    bpot:apqcSourceText "Conducting necessary performance reviews on enforcement of processes and steps to ensure protection. Determine policies and reviews for Manage patents, copyrights, and regulatory requirements [19985]." ;
    bpot:hierarchyID "2.1.3.1" ;
    bpot:pcfID "19941" .

bpot:PCF_19945 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify competitors" ;
    bpot:apqcSourceText "Identifying your competitors, their service and/or product. Evaluating competitors strategies to determine their strengths and weaknesses relative to those of your own product or service." ;
    bpot:hierarchyID "1.1.1.1" ;
    bpot:pcfID "19945" .

bpot:PCF_19946 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10018 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Capture customer needs and wants" ;
    bpot:apqcSourceText "Identifying and collecting customers' wants and needs of a product and/or services from a marketing perspective. Identify which consumer needs are important and whether needs are being met by current products/services. " ;
    bpot:hierarchyID "1.1.2.2" ;
    bpot:pcfID "19946" .

bpot:PCF_19947 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10018 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess customer needs and wants" ;
    bpot:apqcSourceText "Creating customer profiles to get a picture of customers and their needs. Identify particular groups of people/organizations that benefit from your product/services and then selling to them." ;
    bpot:hierarchyID "1.1.2.3" ;
    bpot:pcfID "19947" .

bpot:PCF_19948 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10019 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze internal operations" ;
    bpot:apqcSourceText "Identify key elements of operations and measure effectiveness of these elements within internal operations." ;
    bpot:hierarchyID "1.1.3.2" ;
    bpot:pcfID "19948" .

bpot:PCF_19949 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10020 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define the strategic vision" ;
    bpot:apqcSourceText "Developing goals to define organizations vision. Define and document ideas, direction, and activities which enable the organization to reach these goals." ;
    bpot:hierarchyID "1.1.4.1" ;
    bpot:pcfID "19949" .

bpot:PCF_19950 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10039 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop global support strategy" ;
    bpot:apqcSourceText "Developing a plan to deploy support services and support functions throughout the organization globally. Arrange the organizations functional support areas to create efficiencies of scale in the delivery of support services, globally." ;
    bpot:hierarchyID "1.2.3.5" ;
    bpot:pcfID "19950" .

bpot:PCF_19951 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10039 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop shared services strategy" ;
    bpot:apqcSourceText "Charting a plan to leverage internal services and support functions throughout the organization. Delineate a framework of parameters and criteria to selectively filter service areas for inclusion among the organizations common resources. Arrange the organizations functional areas to create efficiencies of scale in the delivery of internal services." ;
    bpot:hierarchyID "1.2.3.6" ;
    bpot:pcfID "19951" .

bpot:PCF_19952 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10039 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop innovation strategy" ;
    bpot:apqcSourceText "Developing a plan and vision to encourage advancements in technology or product/services. Create a roadmap for changing or innovating the business model to make business operations more competitive. Set up new R&D services for changing or bringing new value propositions, services, production processes, and invention of technology not previously used by competitors etc." ;
    bpot:hierarchyID "1.2.3.4" ;
    bpot:pcfID "19952" .

bpot:PCF_19953 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify organizational objectives" ;
    bpot:apqcSourceText "Creating and developing strategic objectives that establishes a process to outline expected outcomes and guide employees' efforts." ;
    bpot:hierarchyID "1.2.6.1" ;
    bpot:pcfID "19953" .

bpot:PCF_19954 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish baseline metrics" ;
    bpot:apqcSourceText "Establishing baselines that provide standards for assessing performance. Create metrics and KPI's for various functions/processes/activities based on organizational goals." ;
    bpot:hierarchyID "1.2.6.2" ;
    bpot:pcfID "19954" .

bpot:PCF_19955 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor performance against objective" ;
    bpot:apqcSourceText "Defining methodology and frequency of assessment for measuring and monitoring performance of various functions/processes/activities against standard set goals." ;
    bpot:hierarchyID "1.2.6.3" ;
    bpot:pcfID "19955" .

bpot:PCF_19956 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10043 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze business unit strategies" ;
    bpot:apqcSourceText "Assessing the performance of a business unit against set organizational goals which are based on pre-defined metrics collected through various business unit operations." ;
    bpot:hierarchyID "1.2.7.1" ;
    bpot:pcfID "19956" .

bpot:PCF_19957 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10043 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify core competency for each business unit" ;
    bpot:apqcSourceText "Determining the resources and skills of each business unit based on knowledge and technical capacity. Enable business units to meet customer needs and grow in a competitive marketplace." ;
    bpot:hierarchyID "1.2.7.2" ;
    bpot:pcfID "19957" .

bpot:PCF_19958 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10043 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Refine business unit strategies in support of organizational strategy" ;
    bpot:apqcSourceText "Evaluating existing business unit strategy based on the company's strategy and eliminate unwanted/unnecessary resources/elements and re-consider necessary resources to meet the overall company's strategy." ;
    bpot:hierarchyID "1.2.7.3" ;
    bpot:pcfID "19958" .

bpot:PCF_19961 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19960 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and review customer touchpoints" ;
    bpot:apqcSourceText "Creating methods to gauge customer experiences, expectations, and suggestions. Review both liked and disliked areas of product/services to be delivered. Evaluate touchpoints based on the nature of product/service in the market e.g., billboards, web sites, direct mail, service calls, etc." ;
    bpot:hierarchyID "1.2.8.1.1" ;
    bpot:pcfID "19961" .

bpot:PCF_19962 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19960 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess customer experience across touchpoints" ;
    bpot:apqcSourceText "Evaluating customer experiences, expectations, and suggestions in both liked and disliked areas of the product or services. Analyze all modes of communication, human and physical interactions, or customers experience during the relationship lifecycle with your organization. Evaluate the gaps/further development/alterations to the existing product/service to attain better customer response." ;
    bpot:hierarchyID "1.2.8.1.2" ;
    bpot:pcfID "19962" .

bpot:PCF_19963 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19960 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform root cause analysis of problematic customer experiences" ;
    bpot:apqcSourceText "Analyzing the core reason for the customer experience/feedback/response about the product/service to take considerable action for better customer experience." ;
    bpot:hierarchyID "1.2.8.1.3" ;
    bpot:pcfID "19963" .

bpot:PCF_19965 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19964 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create customer journey maps" ;
    bpot:apqcSourceText "Creating a story of the customer's experience: from initial contact, through the process of engagement and into a long-term relationship. The goal is to teach organization about the customer." ;
    bpot:hierarchyID "1.2.8.2.2" ;
    bpot:pcfID "19965" .

bpot:PCF_19966 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19964 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define single view of the customer for the organization" ;
    bpot:apqcSourceText "Defining parameters to show aggregated, consistent, and holistic representation of known data about customers. Define key parameters which enable the tracking of customers and communications across every channel." ;
    bpot:hierarchyID "1.2.8.2.3" ;
    bpot:pcfID "19966" .

bpot:PCF_19967 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19964 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define a vision for the customer experience" ;
    bpot:apqcSourceText "Establishing a direction and vision on how the organization behaves towards customers in a consistent, effective way. The key attributes for customer experience vision consists of emotional connection, commitments and expectations, compelling value proposition, and ease of understanding the organization's behavior." ;
    bpot:hierarchyID "1.2.8.2.4" ;
    bpot:pcfID "19967" .

bpot:PCF_19968 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19964 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Validate with customers" ;
    bpot:apqcSourceText "Creating a process to validate the sales process and the assumptions that underpin the business model. Understand if the products/services have a repeatable, scalable business model around that product." ;
    bpot:hierarchyID "1.2.8.2.5" ;
    bpot:pcfID "19968" .

bpot:PCF_19969 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19964 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Align experience with brand values and business strategies" ;
    bpot:apqcSourceText "Aligning and defining a relevant, differentiated, and credible value proposition for the brand. Align experience to ensure that the product and service quality is consistent with brand promise and business strategies." ;
    bpot:hierarchyID "1.2.8.2.6" ;
    bpot:pcfID "19969" .

bpot:PCF_19970 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19964 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop content strategy" ;
    bpot:apqcSourceText "Planning, development, and management of content-written or in other media. Getting the right content to the right user at the right time through strategic planning of content creation, delivery, and governance." ;
    bpot:hierarchyID "1.2.8.2.7" ;
    bpot:pcfID "19970" .

bpot:PCF_19972 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19971 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify required capabilities" ;
    bpot:apqcSourceText "Determining the necessary skills and competencies required to efficiently collect customer experiences through the support structure." ;
    bpot:hierarchyID "1.2.8.3.1" ;
    bpot:pcfID "19972" .

bpot:PCF_19973 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_19971 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify impact on functional processes" ;
    bpot:apqcSourceText "Identifying the affect of customer experience through customer experience support structure on other functions of customer services related to customer." ;
    bpot:hierarchyID "1.2.8.3.2" ;
    bpot:pcfID "19973" .

bpot:PCF_19974 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop customer experience roadmap to develop and implement defined capabilities" ;
    bpot:apqcSourceText "Defining a standard guideline to create and execute the capacities of registering customer experiences in a timely manner. Create a common understanding of what behaviors are required to implement the strategy. Define what talent/skills your organization needs to reach customer experience goals." ;
    bpot:hierarchyID "1.2.8.4" ;
    bpot:pcfID "19974" .

bpot:PCF_19975 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10057 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify strategic priorities" ;
    bpot:apqcSourceText "Creating a statement of the organization's direction to guide decision making around the allocation of resources. Provide a focus on the organization's overarching goals to ensure coherent and considered action. Strategic objectives are ranked by their importance in achieving the strategic goals. All subsequent operational or tactical planning and resource allocation is based on strategic priorities" ;
    bpot:hierarchyID "1.3.1.1" ;
    bpot:pcfID "19975" .

bpot:PCF_19976 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10057 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop strategic initiatives based on business/customer value" ;
    bpot:apqcSourceText "Creating a statement of the organization's direction based on what is considered \"value\" to the customer or business." ;
    bpot:hierarchyID "1.3.1.2" ;
    bpot:pcfID "19976" .

bpot:PCF_19977 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10057 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review with stakeholders" ;
    bpot:apqcSourceText "Developing a process for stakeholder dialog that is integrated into the assessment of business strategies. Report on the evaluation of the business objectives, strategies, subject, or past events." ;
    bpot:hierarchyID "1.3.1.3" ;
    bpot:pcfID "19977" .

bpot:PCF_19978 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine business value for each strategic priority" ;
    bpot:apqcSourceText "Establishing a standard measure of value to determine the business worth for each of the Identify strategic priorities [19975]. List the effectiveness and utility for every important strategic element based on the benefit it adds to the business." ;
    bpot:hierarchyID "1.3.2.1" ;
    bpot:pcfID "19978" .

bpot:PCF_19979 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine the customer value for each strategic priority" ;
    bpot:apqcSourceText "Analyzing the value preposition; the value the customer gets from a product/services for each of your Identify strategic priorities [19975]. Customer value is the satisfaction a consumer feels after making a purchase for goods or services relative to what he/she must give up to receive them." ;
    bpot:hierarchyID "1.3.2.2" ;
    bpot:pcfID "19979" .

bpot:PCF_19980 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prioritize strategic initiatives" ;
    bpot:apqcSourceText "Listing the most effective procedures in the order of most important to the least. Create measures or filter for determining which of many \"strategic initiatives\" is most important to the least important." ;
    bpot:hierarchyID "1.3.3.1" ;
    bpot:pcfID "19980" .

bpot:PCF_19981 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate strategic initiatives to business units and stakeholders" ;
    bpot:apqcSourceText "Establishing procedures for communications within the organization which creates the road map for successful understanding of strategic initiatives for both business units and stakeholders (internal and external)." ;
    bpot:hierarchyID "1.3.3.2" ;
    bpot:pcfID "19981" .

bpot:PCF_19982 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10060 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify business value drivers" ;
    bpot:apqcSourceText "Determining key indicators or factors responsible for driving business value. Key business value drivers comprise of operational, financial, and sustainability drivers. " ;
    bpot:hierarchyID "1.3.4.1" ;
    bpot:pcfID "19982" .

bpot:PCF_19983 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10060 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish baselines for business value drivers" ;
    bpot:apqcSourceText "Establishing baseline measures that provide standards for assessing performance of Identify business value drivers [19982]." ;
    bpot:hierarchyID "1.3.4.2" ;
    bpot:pcfID "19983" .

bpot:PCF_19984 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10060 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor performance against baselines" ;
    bpot:apqcSourceText "Overseeing the progress of activities to ensure they are on-course and on-schedule in meeting the objectives and performance targets against Establish baselines for business value drivers [19983]." ;
    bpot:hierarchyID "1.3.4.3" ;
    bpot:pcfID "19984" .

bpot:PCF_19986 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19669 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Gather new product/service ideas and requirements" ;
    bpot:apqcSourceText "Collecting necessary items, documents, regulatory requirements, etc., based on Generate and define new product/service ideas [19698]" ;
    bpot:hierarchyID "2.2.2.1" ;
    bpot:pcfID "19986" .

bpot:PCF_19987 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19669 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze new product/service ideas and requirements" ;
    bpot:apqcSourceText "Assessing and reviewing the concepts and requirements of Generate and define new product/service ideas [19698]" ;
    bpot:hierarchyID "2.2.2.2" ;
    bpot:pcfID "19987" .

bpot:PCF_19988 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19669 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate new product/service inputs and requirements" ;
    bpot:apqcSourceText "Assessing and reviewing the required inputs and necessary elements such as automation, technology, hardware installation, regulatory requirements, certifications, etc., for new products/services through defined process and analysis." ;
    bpot:hierarchyID "2.2.2.3" ;
    bpot:pcfID "19988" .

bpot:PCF_19989 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19669 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Formulate new product/service concepts" ;
    bpot:apqcSourceText "Devising ideas and elements necessary for thoughts on new product/service development." ;
    bpot:hierarchyID "2.2.2.4" ;
    bpot:pcfID "19989" .

bpot:PCF_19991 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define basic functional requirements" ;
    bpot:apqcSourceText "Determining the operations of functions related to the product/service in the marketing environment." ;
    bpot:hierarchyID "2.2.3.1.1" ;
    bpot:pcfID "19991" .

bpot:PCF_19992 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11331 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop user experience requirements" ;
    bpot:apqcSourceText "Identifying and creating steps and tools to develop the user experience. " ;
    bpot:hierarchyID "2.2.3.1.7" ;
    bpot:pcfID "19992" .

bpot:PCF_19994 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10083 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify requirements for product/service design/development partners" ;
    bpot:apqcSourceText "Determining essential elements for collaborators involved in blueprint/development of product/service." ;
    bpot:hierarchyID "2.3.1.1.1" ;
    bpot:pcfID "19994" .

bpot:PCF_19998 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19997 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Validate launch procedures" ;
    bpot:apqcSourceText "Verifying the measures/processes/techniques through systems and tools involved in the introduction of products and services." ;
    bpot:hierarchyID "2.3.3.5" ;
    bpot:pcfID "19998" .

bpot:PCF_19999 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish pricing targets" ;
    bpot:apqcSourceText "Determining optimum prices for individual products or services on the basis of the cost of producing, distributing and marketing the offerings, pricing analysis and general pricing strategy." ;
    bpot:hierarchyID "3.2.2.3" ;
    bpot:pcfID "19999" .

bpot:PCF_20001 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine channels to be supported" ;
    bpot:apqcSourceText "Deciding which distributors, wholesalers and retailers the company will use to promote its offerings and to distribute its products and services to the target market. Narrowing down which intermediaries the company will use will affect retail prices of individual products, and should therefore be included in the pricing analysis." ;
    bpot:hierarchyID "3.2.3.1" ;
    bpot:pcfID "20001" .

bpot:PCF_20002 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish channel objectives" ;
    bpot:apqcSourceText "Identifying the role that each chosen marketing channels plays in the larger distribution network with respect to the organizational marketing strategy. Determine intermediary costs for shipping, handling, transporting, warehousing, insurance and marketing that incur and accumulate in the distribution channel." ;
    bpot:hierarchyID "3.2.3.2" ;
    bpot:pcfID "20002" .

bpot:PCF_20003 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify required channel capabilities" ;
    bpot:apqcSourceText "Determining the maximum output rate required from a distribution channel to optimally market and deliver the products and services the company offers or would like to offer. Ideally, a channel should be able to adapt to a certain degree of variability in the demand for the offerings, and able scale up if needed." ;
    bpot:hierarchyID "3.2.3.5" ;
    bpot:pcfID "20003" .

bpot:PCF_20005 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage execution roadmap" ;
    bpot:apqcSourceText "Determining the actions that need to be taken for successful multichannel marketing, the ordering, timing and dependencies of the steps, and the governance mechanism for reviewing and changing the protocol, if needed." ;
    bpot:hierarchyID "3.2.3.8" ;
    bpot:pcfID "20005" .

bpot:PCF_20007 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_18924 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define customer loyalty program" ;
    bpot:apqcSourceText "Devising procedures and mechanisms to retain existing customers, promote repeat business and increase the likelihood that previous customers to continue to buy products or services from the company. This may be achieved by rewarding customers for repeat business by means of gifts, discounts, redeemable \"points\", or prioritized access to new products, events or services. " ;
    bpot:hierarchyID "3.2.6.1" ;
    bpot:pcfID "20007" .

bpot:PCF_20009 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Understand resource requirements for each product/service and delivery channel/method" ;
    bpot:apqcSourceText "Determining the production and distribution costs for each product or service, and each channel or method as factors in determining overall pricing." ;
    bpot:hierarchyID "3.3.3.1" ;
    bpot:pcfID "20009" .

bpot:PCF_20011 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage opportunity pipeline" ;
    bpot:apqcSourceText "Overseeing and planning the acquisition of new customers." ;
    bpot:hierarchyID "3.5.1.6" ;
    bpot:pcfID "20011" .

bpot:PCF_20012 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10184 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customer meetings/workshops" ;
    bpot:apqcSourceText "Arranging and leading meetings, seminars, workshops and training events with customers to educate them about current offerings, best practices and technological advances to provide more value to customers and to increase their attrition and loyalty." ;
    bpot:hierarchyID "3.5.1.8.3" ;
    bpot:pcfID "20012" .

bpot:PCF_20013 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10183 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select key customers/accounts" ;
    bpot:apqcSourceText "Choosing principal clients that are vital for the company." ;
    bpot:hierarchyID "3.5.2.1" ;
    bpot:pcfID "20013" .

bpot:PCF_20014 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10183 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage sales/key account plan" ;
    bpot:apqcSourceText "Handling the accounts of important clients." ;
    bpot:hierarchyID "3.5.2.3" ;
    bpot:pcfID "20014" .

bpot:PCF_20015 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop solution and delivery approach" ;
    bpot:apqcSourceText "Creating a plan with detailed steps about how produce and deliver the goods or services." ;
    bpot:hierarchyID "3.5.3.7" ;
    bpot:pcfID "20015" .

bpot:PCF_20016 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage internal reviews" ;
    bpot:apqcSourceText "Overseeing the internal review process." ;
    bpot:hierarchyID "3.5.3.11" ;
    bpot:pcfID "20016" .

bpot:PCF_20017 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage internal approvals" ;
    bpot:apqcSourceText "Obtaining required company-internal authorizations." ;
    bpot:hierarchyID "3.5.3.12" ;
    bpot:pcfID "20017" .

bpot:PCF_20018 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Revise bid/proposal/quote" ;
    bpot:apqcSourceText "Amending bids, proposals or quotes with more accurate time, cost or delivery estimates. " ;
    bpot:hierarchyID "3.5.3.14" ;
    bpot:pcfID "20018" .

bpot:PCF_20019 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10211 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide certification enablement training" ;
    bpot:apqcSourceText "Provide training and certification to develop strategies for marketing-driven sales." ;
    bpot:hierarchyID "3.5.5.1.1" ;
    bpot:pcfID "20019" .

bpot:PCF_20020 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10211 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage certifications and skills" ;
    bpot:apqcSourceText "Reviewing, processing and issuing certifications and accrediting skills and competencies." ;
    bpot:hierarchyID "3.5.5.1.2" ;
    bpot:pcfID "20020" .

bpot:PCF_20021 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10211 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide support to partners/alliances" ;
    bpot:apqcSourceText "Backing sales partners and strategic alliances." ;
    bpot:hierarchyID "3.5.5.1.3" ;
    bpot:pcfID "20021" .

bpot:PCF_20023 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10224 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Model production network to enable simulation and optimization" ;
    bpot:apqcSourceText "Create representative logical system that provides the framework to attain strategic objectives based on resources, product volumes, and processes. Provides the general sequential flow and capacity requirement relationships among raw materials, parts, resources, finished products, and product families. " ;
    bpot:hierarchyID "4.1.4.1" ;
    bpot:pcfID "20023" .

bpot:PCF_20024 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10224 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create master production schedule" ;
    bpot:apqcSourceText "Creating  the plan for internal activities such as production, inventory, and staffing. Include forecasted quantity of items to produce based on inputs from sales planning, demand planning/forecasting, and supply chain partners." ;
    bpot:hierarchyID "4.1.4.2" ;
    bpot:pcfID "20024" .

bpot:PCF_20028 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20027 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Set up and maintain service delivery governance and management system" ;
    bpot:apqcSourceText "Providing a system for which to manage customer needs and a structure for which to facilitate service delivery to fulfill those needs." ;
    bpot:hierarchyID "5.1.1.1" ;
    bpot:pcfID "20028" .

bpot:PCF_20029 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20027 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage service delivery performance" ;
    bpot:apqcSourceText "Conducting and implementing performance measures to ensure successful delivery of service to the customer." ;
    bpot:hierarchyID "5.1.1.2" ;
    bpot:pcfID "20029" .

bpot:PCF_20030 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20027 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage service delivery development and direction" ;
    bpot:apqcSourceText "Providing guidance of resources to ensure that the development and direction of service delivery is in line with customer needs." ;
    bpot:hierarchyID "5.1.1.3" ;
    bpot:pcfID "20030" .

bpot:PCF_20031 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20027 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Solicit feedback from customer on service delivery satisfaction" ;
    bpot:apqcSourceText "Engaging the customer post delivery to gauge the effectiveness of services rendered in order to improve on key delivery functions going forward." ;
    bpot:hierarchyID "5.1.1.4" ;
    bpot:pcfID "20031" .

bpot:PCF_20033 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20032 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define service delivery goals" ;
    bpot:apqcSourceText "Aligning organization practices to meet the needs of the customer by creating service delivery goals." ;
    bpot:hierarchyID "5.1.2.1" ;
    bpot:pcfID "20033" .

bpot:PCF_20034 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20032 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define labor policies" ;
    bpot:apqcSourceText "Outlining labor policies for resources and ensuring that those policies meet the needs of the organization, the customer, and government regulations." ;
    bpot:hierarchyID "5.1.2.2" ;
    bpot:pcfID "20034" .

bpot:PCF_20035 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20032 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate resource availability" ;
    bpot:apqcSourceText "Understanding the needs of the customer and providing the necessary resources to meet those requirements. " ;
    bpot:hierarchyID "5.1.2.3" ;
    bpot:pcfID "20035" .

bpot:PCF_20036 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20032 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define service delivery network and supply constraints" ;
    bpot:apqcSourceText "Identifying and understanding the limitations imposed upon service delivery network and supply." ;
    bpot:hierarchyID "5.1.2.4" ;
    bpot:pcfID "20036" .

bpot:PCF_20037 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20032 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define service delivery process" ;
    bpot:apqcSourceText "Defanging policies and procedures that focus on meeting the needs and expectations of the customer within the working parameters of the organization." ;
    bpot:hierarchyID "5.1.2.5" ;
    bpot:pcfID "20037" .

bpot:PCF_20038 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20032 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review and validate service delivery procedures" ;
    bpot:apqcSourceText "Revisioning service delivery procedures that fall short of performance parameters. Realign procedures with specified expectations in order to provide successful service delivery. " ;
    bpot:hierarchyID "5.1.2.6" ;
    bpot:pcfID "20038" .

bpot:PCF_20039 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20032 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define service delivery workplace layout and infrastructure" ;
    bpot:apqcSourceText "Creating a workplace that best serves the needs of the organization and customer through strategic layout and infrastructure. " ;
    bpot:hierarchyID "5.1.2.7" ;
    bpot:pcfID "20039" .

bpot:PCF_20042 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor pipeline" ;
    bpot:apqcSourceText "Tracking potential opportunities as they move through the various stages of the pipeline. " ;
    bpot:hierarchyID "5.2.1.1" ;
    bpot:pcfID "20042" .

bpot:PCF_20043 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop baseline forecasts" ;
    bpot:apqcSourceText "Identifying the demand anticipated for the organization's services. Estimate future demand for services using historical data, analysis of the market environment, and external data." ;
    bpot:hierarchyID "5.2.1.2" ;
    bpot:pcfID "20043" .

bpot:PCF_20044 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collaborate with customers" ;
    bpot:apqcSourceText "Providing a collaborative meeting in which to engage the customer to understand the scope of their needs and constructing solutions based on need and constraints." ;
    bpot:hierarchyID "5.2.1.3" ;
    bpot:pcfID "20044" .

bpot:PCF_20045 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop consensus forecast" ;
    bpot:apqcSourceText "Arriving at a consensus over the forecasted levels of demand for services by analyzing baseline forecasts and customer input. " ;
    bpot:hierarchyID "5.2.1.4" ;
    bpot:pcfID "20045" .

bpot:PCF_20046 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine availability of skills to deliver on current and forecast customer orders" ;
    bpot:apqcSourceText "Identifying what skillset is necessary for the delivery of opportunities. Determine the forecast of customer orders based upon those skillsets and the resources available." ;
    bpot:hierarchyID "5.2.1.5" ;
    bpot:pcfID "20046" .

bpot:PCF_20047 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor activity against forecast and revise forecast" ;
    bpot:apqcSourceText "Overseeing all activities necessary to deliver services to customer. Revise forecast to account for any issues that may arise. This could be changes in market trend, resource changes, etc. " ;
    bpot:hierarchyID "5.2.1.6" ;
    bpot:pcfID "20047" .

bpot:PCF_20048 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate and revise forecasting approach" ;
    bpot:apqcSourceText "Recognizing potential problems in the current forecast and making the necessary changes to align the forecast meet demand." ;
    bpot:hierarchyID "5.2.1.7" ;
    bpot:pcfID "20048" .

bpot:PCF_20049 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure forecast accuracy" ;
    bpot:apqcSourceText "Analyzing forecasting against actuals to determine accuracy. Modify forecasting to align with actual need. " ;
    bpot:hierarchyID "5.2.1.8" ;
    bpot:pcfID "20049" .

bpot:PCF_20051 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20050 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and manage skills taxonomy" ;
    bpot:apqcSourceText "Analyzing the skills needed to perform services to be delivered. Classify and organize these skills requirements." ;
    bpot:hierarchyID "5.2.2.1" ;
    bpot:pcfID "20051" .

bpot:PCF_20052 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20050 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create resource plan" ;
    bpot:apqcSourceText "Creating a plan to ensure that all resources are available to carry out services required for the customer. This can include physical resources and personnel." ;
    bpot:hierarchyID "5.2.2.2" ;
    bpot:pcfID "20052" .

bpot:PCF_20053 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20050 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Match resource demand with capacity, skills, and capabilities" ;
    bpot:apqcSourceText "Matching demand with skills and capability. Enlisting suppliers and partners to help with demand when needed." ;
    bpot:hierarchyID "5.2.2.3" ;
    bpot:pcfID "20053" .

bpot:PCF_20054 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20050 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collaborate with suppliers and partners to supplement skills and capabilities" ;
    bpot:apqcSourceText "Understanding organizational need to enlist suppliers to provide resources for gaps in skills and capabilities. Identify where additional skills are needed and collaborate with third parties to fill those demands." ;
    bpot:hierarchyID "5.2.2.4" ;
    bpot:pcfID "20054" .

bpot:PCF_20055 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20050 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify critical resources and supplier capacity" ;
    bpot:apqcSourceText "Realizing critical resources required to perform and carry out customer needs. Engage with suppliers to fulfill those needs, if necessary. Identify supplier threshold for performing those needs." ;
    bpot:hierarchyID "5.2.2.5" ;
    bpot:pcfID "20055" .

bpot:PCF_20056 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20050 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and manage resource capacity and availability" ;
    bpot:apqcSourceText "Directing and managing workforce needs. Ensure that resources are at full capacity. Monitor that all resources are able to skilled in their respective rolls. Make sure that necessary resources are available to provide the needed services." ;
    bpot:hierarchyID "5.2.2.6" ;
    bpot:pcfID "20056" .

bpot:PCF_20057 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_12127 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform skill and capability testing" ;
    bpot:apqcSourceText "Verifying that training provided to the person was successful through the administration testing and the application of skills for practical use." ;
    bpot:hierarchyID "5.2.3.6" ;
    bpot:pcfID "20057" .

bpot:PCF_20060 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review contract and agreed terms" ;
    bpot:apqcSourceText "Meeting with the customer, partner, and/or supplier to review the terms of the solutions contract and agree on the terms set forth." ;
    bpot:hierarchyID "5.3.1.1" ;
    bpot:pcfID "20060" .

bpot:PCF_20061 a owl:NamedIndividual,
