@prefix bpot: <https://fandaws.com/ontology/bpot#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bpot:PCF_10021 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze and evaluate competition" ;
    bpot:apqcSourceText "Assessing the competitive forces in the marketplace that could potentially affect the organization. Analyze various aspects of business competition including competing firms. Aggregate competitive intelligence, create benchmarks to juxtapose processes and performance metrics, and inject crucial information about the competition into management models to synthesize insights." ;
    bpot:hierarchyID "1.1.1.2" ;
    bpot:pcfID "10021" .

bpot:PCF_10022 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify economic trends" ;
    bpot:apqcSourceText "Determining large-scale macroeconomic shifts and trends, with medium to long-term relevance for the organization. Vet the immediate and the larger economic ecosystem to identify broad-based movements that affect the organization. In the immediate vicinity, for example, examine the stock price of key vendors/suppliers in the organizational value-chain. In the larger economic ecosystem, analyze according to geographical distribution where factors such as interest rates, taxation structures, oil prices, and unemployment rates are explored." ;
    bpot:hierarchyID "1.1.1.4" ;
    bpot:pcfID "10022" .

bpot:PCF_10023 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify political and regulatory factors" ;
    bpot:apqcSourceText "Identifying areas of concern pertaining to public policy and regulation, established by sovereign or multinational authorities. Examine various regions and geopolitical formations to identify those political and regulatory issues-present or developing-that can potentially affect the organization. Plan for an iterative process, partitioned across regional and geopolitical entities that have a direct bearing on the organization's activities. Assess changes in environmental compliance, product standards, trade barriers, etc." ;
    bpot:hierarchyID "1.1.1.5" ;
    bpot:pcfID "10023" .

bpot:PCF_10024 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess new technologies" ;
    bpot:apqcSourceText "Assessing developments in technologies presently being used by the business, new technologies that have a potential for the business, and any disruptive innovations. Conduct a survey of advancement in technologies that are already deployed with inputs from the personnel closely working with them, tracking utility and feasibility for deployment. Arrange for mid- to senior-level management personnel who explore contingent uses to assess new and disruptive technologies. Follow up with desk research, involving physical scoping and viability assessment." ;
    bpot:hierarchyID "1.1.1.8" ;
    bpot:pcfID "10024" .

bpot:PCF_10025 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze demographics" ;
    bpot:apqcSourceText "Analyzing statistical data relating to the size, distribution, and composition of relevant populations, as well as their characteristics. Perform quantitative analysis over raw data-sets gathered from well-founded sources such as government census or large, private databases. Consider employing primary research in collecting required statistics. Use comprehensive studies (reports, briefs, and articles) to assist with the analysis, in place of raw data." ;
    bpot:hierarchyID "1.1.1.9" ;
    bpot:pcfID "10025" .

bpot:PCF_10026 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify social and cultural changes" ;
    bpot:apqcSourceText "Distinguishing changes in societal makeup, as well as the cultural composite. Isolate shifts in the societal composition and distribution, as well as the value systems and attributes that bind the organization together. Analyze well-regarded publications--and gather the perspective of public intellectuals and opinion leaders--on relevant issues." ;
    bpot:hierarchyID "1.1.1.7" ;
    bpot:pcfID "10026" .

bpot:PCF_10027 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify environmental factors" ;
    bpot:apqcSourceText "Identifying changes in ecological ecosystems that can be directly or indirectly detrimental to the organization. Analyze ecological factors within the immediate ecosystem for near to middle-term impact. Analyze the ecology, at large, to get a sense of long-term shifts and concerns. Gather analyses from research publications. Speak to subject matter experts. Engage with advocacy groups, lawyers, journalists, and the active populations." ;
    bpot:hierarchyID "1.1.1.6" ;
    bpot:pcfID "10027" .

bpot:PCF_10028 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10018 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct qualitative/quantitative research and assessments" ;
    bpot:apqcSourceText "Investigating key market features and customer characteristics, using qualitative and quantitative measures to capture relevant aspects. Distill key ingredients that allow the organization to Capture customer needs and wants [19946], and Assess customer needs and wants [19947]. Conduct standardized appraisals by defining selection parameters and setting quotas." ;
    bpot:hierarchyID "1.1.2.1" ;
    bpot:pcfID "10028" .

bpot:PCF_10030 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10019 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze organizational characteristics" ;
    bpot:apqcSourceText "Identifying and examining key attributes that differentiate the organization in the market and those that underscore the core of its operations. Consider how the organization functions. Reflect over tangible and intangible aspects in order to spot critical correlations and the interplay between these attributes. Have senior executives conduct the analysis, with input from management and operational personnel." ;
    bpot:hierarchyID "1.1.3.1" ;
    bpot:pcfID "10030" .

bpot:PCF_10031 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10019 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create baselines for current processes" ;
    bpot:apqcSourceText "Establishing baselines that provide standards for assessing performance levels and allow for a relational benchmarking of current processes. Undertake a survey of archival performance records, conducted in conjunction by the management and the operations personnel. Take into account the organization's internal objectives, particularly for process improvement and enhancement. Understand industry best practices." ;
    bpot:hierarchyID "1.1.3.3" ;
    bpot:pcfID "10031" .

bpot:PCF_10032 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10019 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze systems and technology" ;
    bpot:apqcSourceText "Analyzing the capabilities of technology and process automation systems deployed within the organization in order to direct future associated processes. Conduct a broad-based survey to examine various aspects associated with such systems and technologies, with the objective of identifying key facets that are of interest. Investigate the intended purpose, purpose served, utility, longevity, remaining service-life, repair or service requirements, etc." ;
    bpot:hierarchyID "1.1.3.4" ;
    bpot:pcfID "10032" .

bpot:PCF_10033 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10019 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze financial health" ;
    bpot:apqcSourceText "Appraising the financial state of the organization so that management can create resource allocation strategies. Scrutinize the organization's financials--including balance sheets, statements of income, cash-flows, equity holdings, and liquidity--with the objective of understanding the organization's financial health and capacities. (This analysis directly feeds into Conduct organizational restructuring opportunities [16792] and Define a business concept and long-term vision [17040].)" ;
    bpot:hierarchyID "1.1.3.5" ;
    bpot:pcfID "10033" .

bpot:PCF_10034 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10019 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify core competencies" ;
    bpot:apqcSourceText "Determining a strategically significant aggregate of competence and capacities that differentiates the organization in the market. Identify distinguishing attributes including unique skills and resources and its brand and services in the marketplace. Have senior executives and management personnel assess competencies in order to further develop these capabilities into distinct commercial value propositions." ;
    bpot:hierarchyID "1.1.3.6" ;
    bpot:pcfID "10034" .

bpot:PCF_10035 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10020 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Align stakeholders around strategic vision" ;
    bpot:apqcSourceText "Orienting those entities, associated with the organization that have a direct bearing on its operations and output, in a way that advances its strategic vision. Map all stakeholders in strategic configurations, within the architectural layout of the marketplace, and position the organization relative to them. (This exercise is undertaken by senior strategy personnel, drawing upon the process Define a business concept and long-term vision [17040].)" ;
    bpot:hierarchyID "1.1.4.2" ;
    bpot:pcfID "10035" .

bpot:PCF_10036 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10020 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate strategic vision to stakeholders" ;
    bpot:apqcSourceText "Developing and executing communication strategies to convey an alignment plan of all organizational stakeholders, which helps the organization realize its vision. Create custom communication strategies and delivery channels with the objective of orienting stakeholders according to the configuration maps created in the process Align stakeholders around a strategic vision [10035]. Have senior strategy personnel closely collaborate with the communications/marketing team." ;
    bpot:hierarchyID "1.1.4.3" ;
    bpot:pcfID "10036" .

bpot:PCF_10040 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Coordinate and align cross-functional and process strategies" ;
    bpot:apqcSourceText "Aligning the approach and method of individual units, departments, systems, and operations within the organization, in accordance with the larger strategic course adopted. Employ the organization's strategic path to guide the functions, divisions, and operations. Calibrate the plan and method of each functional area, as well as the processes therein, to Select the long-term business strategy [10039]." ;
    bpot:hierarchyID "1.2.4" ;
    bpot:pcfID "10040" .

bpot:PCF_10044 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10037 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define current business" ;
    bpot:apqcSourceText "Defining the status quo relating to the de facto core of what the business is. Reflect over the fundamental essence of what the business accomplishes and the manner in which it operates. Look beyond the obvious solution capabilities to delineate capacities that form the basis of the business engine. Involve senior executives and management personnel and possibly professional services providers." ;
    bpot:hierarchyID "1.2.1.1" ;
    bpot:pcfID "10044" .

bpot:PCF_10045 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10037 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Formulate mission" ;
    bpot:apqcSourceText "Outlining actionable objectives that effectively set a course to fulfill the organization's vision. In this fundamental activity, articulate certain goals or targets in broad but practicable terms to reach long-term objectives." ;
    bpot:hierarchyID "1.2.1.2" ;
    bpot:pcfID "10045" .

bpot:PCF_10046 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10037 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate mission" ;
    bpot:apqcSourceText "Developing and executing a communication strategy to convey the mission statement. Create a universal communication strategy and appropriate delivery channels, with the objective of leveraging the latter to execute the former. Convey the inherent message of the mission to all stakeholders, including employees, customers, and the public. Ensure collaboration between senior strategy personnel and the communications/marketing team." ;
    bpot:hierarchyID "1.2.1.3" ;
    bpot:pcfID "10046" .

bpot:PCF_10049 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate breadth and depth of organizational structure" ;
    bpot:apqcSourceText "Evaluating the structural makeup of the organization, including pertinent features of and associated synergies among constituent elements. Examine the organization's architectural framework, paying close attention to the individual elements, the relations among them, and the conjoint and co-acting forces therein. Analyze functions and processes, as well as work-related positions. Scrutinize various relevant characteristics associated with each of them, depending upon the scale, scope, and type of organization." ;
    bpot:hierarchyID "1.2.5.1" ;
    bpot:pcfID "10049" .

bpot:PCF_10050 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform job-specific roles mapping and value-added analyses" ;
    bpot:apqcSourceText "Appraising job-specific roles within the organizational chart and their hierarchical architecture. Analyze a map of work-related roles within the organizational structure. Examine the value added by the positions associated with jobs to be performed and how they stack up within the organization's operations." ;
    bpot:hierarchyID "1.2.5.2" ;
    bpot:pcfID "10050" .

bpot:PCF_10051 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop role activity diagrams to assess hand-off activity" ;
    bpot:apqcSourceText "Examining the constituent exercises and undertakings within a work-related position for the purpose of effective delegation. Deconstruct job-specific roles into activities and visualize the relations among them, with the objective of assigning responsibilities to the appropriate personnel." ;
    bpot:hierarchyID "1.2.5.3" ;
    bpot:pcfID "10051" .

bpot:PCF_10052 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform organization redesign workshops" ;
    bpot:apqcSourceText "Organizing workshop sessions to adopt organizational redesign. Communicate the organizational structure and mapping of responsibilities against job roles in order to facilitate an effective understanding among personnel. Use a collaborative process that may include participative workshop sessions." ;
    bpot:hierarchyID "1.2.5.4" ;
    bpot:pcfID "10052" .

bpot:PCF_10053 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design the relationships between organizational units" ;
    bpot:apqcSourceText "Fleshing out the connections and dependencies among the various units of the organization. Delineate the relationship among business units or process frameworks within the organization, in terms of activities, synergies, and shared resources and responsibilities. Formalize relationships among business units so that any mutual coherence is clearly understood and can be attended to." ;
    bpot:hierarchyID "1.2.5.5" ;
    bpot:pcfID "10053" .

bpot:PCF_10054 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop role analysis and activity diagrams for key processes" ;
    bpot:apqcSourceText "Creating an understanding of the fit between job roles and organizational processes in order to properly place personnel. Deconstruct key processes into constituent activities, and examine job-related roles. Take cues from Develop role activity diagrams to assess hand-off activity [10051]. Map appropriate positions against these important processes, which in turn expedite the deployment of staff members." ;
    bpot:hierarchyID "1.2.5.6" ;
    bpot:pcfID "10054" .

bpot:PCF_10055 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess organizational implication of feasible alternatives" ;
    bpot:apqcSourceText "Probing the repercussions of all practicable organizational design options. Analyze the significance and impact of workable organizational structure options. Closely examine the long-term impact of these frameworks over the functioning of the organization." ;
    bpot:hierarchyID "1.2.5.7" ;
    bpot:pcfID "10055" .

bpot:PCF_10056 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10041 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Migrate to new organization" ;
    bpot:apqcSourceText "Embracing and ratifying a new organizational structure. (Assume the new framework to be the best fit through Assess the organizational implications of feasible alternatives [10055].)" ;
    bpot:hierarchyID "1.2.5.8" ;
    bpot:pcfID "10056" .

bpot:PCF_10063 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10061 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate performance of existing products/services against market opportunities" ;
    bpot:apqcSourceText "Assessing the capabilities and performance of existing products/services, in light of market opportunities. Examine performance of the existing line of products/services, including measures of profitability, penetration, and value delivered. Identify gaps between existing solutions' portfolio or their performance levels, on the one hand, and the current market demand, available technologies, and/or customer expectations, on the other. Consider opportunities in the present market environment and any relation with the performance. Consider input from professional services providers." ;
    bpot:hierarchyID "2.1.1.1" ;
    bpot:pcfID "10063" .

bpot:PCF_10066 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10061 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Confirm alignment of product/service concepts with business strategy" ;
    bpot:apqcSourceText "Checking the alignment of product/service portfolio, and its individual offerings, with the organization's overall strategy and planning for the development of new or revised solutions. Conduct reality checks on new product/service concepts prior to committing significant investment to ensure that the revamped solutions' portfolio is in line with the overall business strategy, aligns organizational processes for their development, and creates a plan for assimilating these changes in the organization's offerings. Enlist senior management executives." ;
    bpot:hierarchyID "2.1.1.2" ;
    bpot:pcfID "10066" .

bpot:PCF_10068 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19669 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify potential improvements to existing products and services" ;
    bpot:apqcSourceText "Defining potential enhancements to current products/services in order to take advantage of a shift in market expectations. Identify how the existing line of products/services may be revised--through enhancements to individual solutions or across-the-board renovations--in order to capitalize on present opportunities in the market." ;
    bpot:hierarchyID "2.2.2.5" ;
    bpot:pcfID "10068" .

bpot:PCF_10070 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10065 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify new technologies" ;
    bpot:apqcSourceText "Determining new technologies to revise the portfolio of solution offerings. Identify recently developed technological advances that can be leveraged in the development or advancement of the organization's product/service portfolio. Enlist senior management in conjunction with personnel responsible for the design, processing, and delivery of products/services. Have the organization's research division(s) carry out the process." ;
    bpot:hierarchyID "2.2.1.1" ;
    bpot:pcfID "10070" .

bpot:PCF_10071 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10065 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop new technologies" ;
    bpot:apqcSourceText "Developing new technologies from scratch to integrate into a revised portfolio of solutions. Develop new technological processes, models, and/or implements in-house, with the objective of improving existing solutions or creating new ones. Consider market realities, as well as the portfolio of products/services. Assess the results in conjunction with senior executives and personnel responsible for the design, processing, and delivery of these solutions. Engage the R&D function, and consider external sources such as offshore providers, specialized research agencies, and crowdsourcing communities." ;
    bpot:hierarchyID "2.2.1.2" ;
    bpot:pcfID "10071" .

bpot:PCF_10072 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10065 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess feasibility of integrating new leading technologies into product/service concepts" ;
    bpot:apqcSourceText "Appraising the feasibility of integrating new technologies, whether developed as a custom solution or adopted from an external source, into revised portfolio of solution offerings. Examine recently developed technological advances for suitability to incorporate them into the concept of revised and/or new solution offerings. Enlist senior management, in consultation with in-house personnel responsible for the design, processing, and delivery of these solutions, as well as key supply-chain stakeholders." ;
    bpot:hierarchyID "2.2.1.3" ;
    bpot:pcfID "10072" .

bpot:PCF_10073 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10061 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and develop cost and quality targets" ;
    bpot:apqcSourceText "Setting prerequisites for the cost of development and quality standards for the new solutions' portfolio and/or its individual offerings. Set targets for the budget and quality standards for the revamped portfolio of solution offerings. Prepare a plan for the outlay required for revising and adding new product/services. Identify intended levels of quality for these, bearing in mind the existing standards of solutions offered by the organization and its competitors. Enlist senior management executives, particularly those responsible for finance and budgeting, product/service design, manufacturing/processing, delivery, and quality control." ;
    bpot:hierarchyID "2.1.1.4" ;
    bpot:pcfID "10073" .

bpot:PCF_10074 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10061 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prioritize and select new product/service concepts" ;
    bpot:apqcSourceText "Selecting from among the potential new/revised solutions and capitalizing on market opportunities so that they meet the cost and quality prerequisites. Create an index of product/service concepts, and arrange them in order of preference. Base prioritization on adherence to Plan and develop cost and quality targets [10073], and choose options that would comprise the revised solution portfolio." ;
    bpot:hierarchyID "2.1.1.3" ;
    bpot:pcfID "10074" .

bpot:PCF_10075 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10061 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Specify development timing targets" ;
    bpot:apqcSourceText "Determining the individual and collective timeframe for realizing new/revised solutions. Create a schedule that clearly demarcates the timeframes designated for the development of every new solution and/or revising each of the existing ones. Create a timetable by setting deadlines for each step in overhauling the product/service portfolio." ;
    bpot:hierarchyID "2.1.1.5" ;
    bpot:pcfID "10075" .

bpot:PCF_10076 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10061 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan for product/service offering modifications" ;
    bpot:apqcSourceText "Developing a programmatic procedure for changing products/services while paying heed to all stakeholders involved and the prerequisites identified. Create a plan for changing the existing portfolio of solution offerings. Develop a systematic program for the design, processing, and delivery of the new product/service concepts. Construct project-flow diagrams. Identify the stakeholders involved and personnel responsible for each stage, as well as the necessary decisions. Earmark the budgetary outlay, and conduct any strategic planning required." ;
    bpot:hierarchyID "2.1.1.6" ;
    bpot:pcfID "10076" .

bpot:PCF_10077 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10067 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Introduce new products/services" ;
    bpot:apqcSourceText "Launching revamped product/service portfolio in to the market. Introduction in to the marketplace is done by deploying effective channels for marketing, sales, delivery, and after-sales servicing. Introduce new/revised solution offerings in a concerted effort. Coordinate a cross-functional effort." ;
    bpot:hierarchyID "2.1.2.2" ;
    bpot:pcfID "10077" .

bpot:PCF_10078 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10067 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Retire outdated products/services" ;
    bpot:apqcSourceText "Removing nonconforming products and services. Withdraw those products/services that do not conform to market realities and are not positioned to take advantage of prevailing opportunities. Coordinate with processing/delivery teams within the organization and key stakeholders in the supply chain. Create mechanisms for continued after-sales servicing, as well as deploy effective public relations efforts in order to preserve the image and goodwill of the organization through the process." ;
    bpot:hierarchyID "2.1.2.3" ;
    bpot:pcfID "10078" .

bpot:PCF_10079 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10067 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and refine performance indicators" ;
    bpot:apqcSourceText "Attuning the performance measures of products/services to better reflect the revamped portfolio of solution offerings. Revise the parameters used to measure performance, apropos the organization's product/service offerings. (Modify these standards in consideration of the changes made to the portfolio by Introduce new products/services [10077] and Retire outdated products/services [10078].)" ;
    bpot:hierarchyID "2.1.2.4" ;
    bpot:pcfID "10079" .

bpot:PCF_10084 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare high-level business case and technical assessment" ;
    bpot:apqcSourceText "Preparing a business-level business case and a technical feasibility assessment in order to move the product/service projects forward. Weigh the costs and benefits of designing, developing, and evaluating the shortlisted product/service concepts. Prepare a business case to justify the product/service projects. Conduct a technical appraisal to ensure that the organization has the technical know-how and resources to further develop these concepts." ;
    bpot:hierarchyID "2.3.1.2" ;
    bpot:pcfID "10084" .

bpot:PCF_10085 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop product/service design specifications" ;
    bpot:apqcSourceText "Creating design specifications. Create specifications for the design of new or revised product/service concepts as a measure to meet during development. Have the senior functional-level solutioning or design staff create a framework of compliance standards for these products/services." ;
    bpot:hierarchyID "2.3.1.3" ;
    bpot:pcfID "10085" .

bpot:PCF_10086 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Document design specifications" ;
    bpot:apqcSourceText "Documenting requirements to meet in the design of new or revised products/services. Specify technical, quality, and costing requirements, as well as ergonomic, safety, and servicing requirements for such products/services. Ensure the information presented can be understood by the personnel executing the design and includes examples, anecdotal references, and illustrations." ;
    bpot:hierarchyID "2.3.1.6" ;
    bpot:pcfID "10086" .

bpot:PCF_10087 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct mandatory and elective external reviews" ;
    bpot:apqcSourceText "Conducting any mandatory and elective appraisals of the product/service design specifications in order to ensure compliance with external standards. Carry out external reviews of specifications created for the development of new product/service designs. Conduct mandatory appraisals such as legal and regulatory, as well as any optional assessments that, for instance, pitch the specifications against industrial benchmarks." ;
    bpot:hierarchyID "2.3.1.7" ;
    bpot:pcfID "10087" .

bpot:PCF_10088 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Build prototypes/proof of concepts" ;
    bpot:apqcSourceText "Building prototypes for shortlisted product/service concepts. Develop prototypes for those product/service concepts that have been identified for further development. Provide proof-of-concepts, and test any processes involved. Build prototypes in line with the design specifications already outlined. Enlist the solutioning and/or design staff." ;
    bpot:hierarchyID "2.3.1.9" ;
    bpot:pcfID "10088" .

bpot:PCF_10089 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Eliminate quality and reliability problems" ;
    bpot:apqcSourceText "Eliminating any problems relating to utility of the product/service over the course of its expected lifetime. Tweak the prototype in order to comply with the required quality and reliability standards. Further refine the prototype, so it may be subjected to testing." ;
    bpot:hierarchyID "2.3.1.11" ;
    bpot:pcfID "10089" .

bpot:PCF_10090 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct in-house product/service testing and evaluate feasibility" ;
    bpot:apqcSourceText "Carrying out an in-house appraisal of the prototypes in order to validate design and feasibility. Test the product/service prototypes to confirm their compliance with design and usability standards. Corroborate the viability of the design, and validate the feasibility of their production. Identify any areas for improvement." ;
    bpot:hierarchyID "2.3.1.12" ;
    bpot:pcfID "10090" .

bpot:PCF_10091 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify design/development performance indicators" ;
    bpot:apqcSourceText "Identifying performance parameters. Determine the parameters to measure performance of the design and development of the product/service concepts into prototypes. " ;
    bpot:hierarchyID "2.3.1.13" ;
    bpot:pcfID "10091" .

bpot:PCF_10092 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collaborate on design with suppliers and external partners" ;
    bpot:apqcSourceText "Interacting with suppliers and manufactures to determine design decisions. Collaborate with vendors, suppliers, contractors, and subcontractors to verify feasibility of co-producing the prototype's design. Ensure that efforts can be coordinated with other stakeholders in the organization's supply chain ecosystem at the time of manufacturing, producing, or packaging the finished product/service." ;
    bpot:hierarchyID "2.3.1.14" ;
    bpot:pcfID "10092" .

bpot:PCF_10093 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19996 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare detailed market study" ;
    bpot:apqcSourceText "Composing a detailed study of the market ecosystem in light of new products/services. Conduct a detailed analysis of the targeted market(s) in order to Introduce new products/services [10077]. Examine the competition, market size and growth rate, market trends, customer segments and their characteristics, market influencers, distribution channels, and profitability. Enlist in-house marketing and/or solutioning teams, or outsource to specialized professional services agencies." ;
    bpot:hierarchyID "2.3.2.1" ;
    bpot:pcfID "10093" .

bpot:PCF_10094 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19996 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct customer tests and interviews" ;
    bpot:apqcSourceText "Conducting both qualitative and quantitative studies to determine the fit between the newly developed products/services and the customers. Conduct external tests of the new product/service, and then refine them to maximize the customer uptake. Gather feedback from prospective customers and targeted populations by conducting surveys, focus groups, interviews, and detailed studies. Enlist professional services such as public relations or market research organizations." ;
    bpot:hierarchyID "2.3.2.2" ;
    bpot:pcfID "10094" .

bpot:PCF_10095 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19996 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Finalize product/service characteristics and business cases" ;
    bpot:apqcSourceText "Finalizing the characteristics of new products/services by appropriately weighing feedback from prospective customers against a cost-benefit analysis in order to produce a profitable business proposition. Refine the attributes of the newly developed products/services, in light of the feedback and insights collected during Conduct customer tests and interviews [10094]. Revisit the high-level business case to justify the resources assigned to the product/service project against the anticipated benefits." ;
    bpot:hierarchyID "2.3.2.3" ;
    bpot:pcfID "10095" .

bpot:PCF_10096 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19996 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Finalize technical requirements" ;
    bpot:apqcSourceText "Reassessing the technical requirements in light of the final product/service attributes. Revisit the technical assessment to revalidate the organization's capacity for progressing with new product/service projects, in light of the revised product/service characteristics." ;
    bpot:hierarchyID "2.3.2.4" ;
    bpot:pcfID "10096" .

bpot:PCF_10097 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19997 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify requirements for changes to manufacturing/delivery processes" ;
    bpot:apqcSourceText "Identifying any changes that need to be effectuated in the organization's internal processes for manufacturing, and delivering the newly developed products/services. Determine if any changes need to be made to the production and distribution processes, in light of the new products/services. Begin production process planning. Prepare for factory layout planning. Generate shop-floor instructions and changes to the supply chain." ;
    bpot:hierarchyID "2.3.3.2" ;
    bpot:pcfID "10097" .

bpot:PCF_10098 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and test prototype production and/or service delivery process" ;
    bpot:apqcSourceText "Creating the new manufacturing/delivery processes for the new products/services, and testing them to ensure proper functioning. Create the production/delivery process for the prototypes that have been built for the new products/services. Conduct trial-runs to test these processes and their integration with the organization's other processes." ;
    bpot:hierarchyID "2.3.1.10" ;
    bpot:pcfID "10098" .

bpot:PCF_10099 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19997 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and obtain necessary capabilities/materials and equipment" ;
    bpot:apqcSourceText "Developing and/or sourcing the essential machinery needed for creating purpose-built processes, as well as the raw materials, to produce the new products/services. Either design the equipment and materials needed internally, or source from external vendors. Obtain the feedstock or raw materials needed to prepare the finished products, as well as the machinery - hardware and software - needed to arrange production lines, factory operations, assemblies, and manufacturing processes. Revisit the technologies that underpin the new or revised products/services in order to source the right equipment and materials." ;
    bpot:hierarchyID "2.3.3.1" ;
    bpot:pcfID "10099" .

bpot:PCF_10110 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10106 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze market and industry trends" ;
    bpot:apqcSourceText "Examining large-scale shifts and trends, with relevance to the organization's products/services. Vet the industrial and larger market landscape to identify broad-based movements that could have a direct or tangential impact on the uptake of the organization's products/services. Examine, among other things, the market capitalization of similar products, the profitability of organizations offering competing products/services, the stock price of key vendors/suppliers in the organizational value-chain, the rate and scale of innovation activity in the organization's product/service category, the price and availability of raw materials, and the shelf-life of similar products/services. Conduct primary and secondary research, and consider enlisting professional services." ;
    bpot:hierarchyID "3.1.1.3" ;
    bpot:pcfID "10110" .

bpot:PCF_10111 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10106 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze competing organizations, competitive/substitute products/services" ;
    bpot:apqcSourceText "Examining the strengths and weaknesses of competing organizations. Assess competing organizations for offerings, product strategy, marketing and delivery channels, etc. Analyze the usability experience, durability, USP, and other key attributes of competing and substitute products. Gather competitive intelligence, and consider enlisting professional services." ;
    bpot:hierarchyID "3.1.1.4" ;
    bpot:pcfID "10111" .

bpot:PCF_10112 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10106 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate existing products/services" ;
    bpot:apqcSourceText "Examining the brands owned and products offered in the market. Determine the relative position of the existing products/brands in the marketplace." ;
    bpot:hierarchyID "3.1.1.5" ;
    bpot:pcfID "10112" .

bpot:PCF_10113 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10106 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess internal and external business environment" ;
    bpot:apqcSourceText "Understanding the culture and environment in which you're operating. Analyze how internal decision-making, thought processes, financial circumstances, and more affect the ability to bring new products to market. Survey or analyze the market into which the products would be introduced." ;
    bpot:hierarchyID "3.1.1.6" ;
    bpot:pcfID "10113" .

bpot:PCF_10114 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10108 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Understand consumer needs and historical behaviors" ;
    bpot:apqcSourceText "Identifying the factors that drive the targeted market segment. Model customer purchasing patterns, and forecast their future purchasing behavior. " ;
    bpot:hierarchyID "3.1.1.1.1" ;
    bpot:pcfID "10114" .

bpot:PCF_10115 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10109 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine market share gain/loss" ;
    bpot:apqcSourceText "Determining the increase or decrease of the company's sales volume in the targeted markets. Conduct an analysis to determine the factors and underlying causes that affect the changes in the demand for products or services offered. Consider changes in offerings or in the business strategy to regain or increase the market share." ;
    bpot:hierarchyID "3.1.1.2.1" ;
    bpot:pcfID "10115" .

bpot:PCF_10116 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10107 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Quantify market opportunities" ;
    bpot:apqcSourceText "Attaching quantifiable indicators to opportunities that have been identified in the market. Compute estimated figures of the approximate value that can be captured with the provision of existing products/services (i.e., the extent of financial benefits that can be reaped in the market)." ;
    bpot:hierarchyID "3.1.2.1" ;
    bpot:pcfID "10116" .

bpot:PCF_10118 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10107 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prioritize opportunities consistent with capabilities and overall business strategy" ;
    bpot:apqcSourceText "Creating an index of market opportunities, and arrange them in order of preference. Prioritize based on the opportunities' adherence to the overall business strategy. Correlate with the competencies and capacities that the organization, as a whole, processes." ;
    bpot:hierarchyID "3.1.2.3" ;
    bpot:pcfID "10118" .

bpot:PCF_10120 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10119 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Test with customers/consumers" ;
    bpot:apqcSourceText "Validating identified market opportunities by testing company's offerings on limited-size samples of the consumer population that are hypothesized to be representative of the target market at large and to have similar purchasing behavior. The feedback gained through consumer testing can be used to modify or reject product offerings before their full scale launch, saving the company valuable resources, should the initial offering not be successful." ;
    bpot:hierarchyID "3.1.2.4.1" ;
    bpot:pcfID "10120" .

bpot:PCF_10121 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10119 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Confirm internal capabilities" ;
    bpot:apqcSourceText "Verifying that the company has sufficient infrastructure and resources to deliver their offerings in a timely and cost-effective manner, and that it is able to scale up from the small-scale market samples, used for consumer testing, to the entire identified market segment." ;
    bpot:hierarchyID "3.1.2.4.2" ;
    bpot:pcfID "10121" .

bpot:PCF_10124 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish guidelines for applying pricing and discounting of products/services" ;
    bpot:apqcSourceText "Creating a framework that allows for a uniform methodology while determining the price of individual offerings. Devise a blueprint for establishing the pricing of specific products/services. Create guidelines that factor in the cost of production/servicing, price sensitivity, product lifecycle, and the price of competing/substitute products." ;
    bpot:hierarchyID "3.2.2.2" ;
    bpot:pcfID "10124" .

bpot:PCF_10125 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Approve pricing strategies/policies and targets" ;
    bpot:apqcSourceText "Confirming the strategy and specifications developed for pricing the organization's products/services. Approve pricing guidelines by vetting the soundness of the methodology and the guidelines' alignment with the value proposition." ;
    bpot:hierarchyID "3.2.2.4" ;
    bpot:pcfID "10125" .

bpot:PCF_10126 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate channel attributes and potential partners" ;
    bpot:apqcSourceText "Assessing the attributes of all marketing channels, and evaluating the key partners in those channels. Closely examine the various characteristics of all available marketing channels such as the cost of using them, durability of impact, applicability to the organization's products/services, turn-around time, involvement of middlemen, and conversion rate. Analyze key partners in the marketing channels including those who have been associated with the organization; evaluate their capabilities, the scale and scope of their operations, quality of support provided, etc." ;
    bpot:hierarchyID "3.2.3.6" ;
    bpot:pcfID "10126" .

bpot:PCF_10127 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine channel role and fit with target segments" ;
    bpot:apqcSourceText "Analyze the various channels for their relevance to the targeted segments. Identify the channel that can effectively market to the targeted customers in regard to the drives, desires, and characteristics of these populations, their uptake, extent of engagement, frequency of use, and effectiveness in communicating." ;
    bpot:hierarchyID "3.2.3.3" ;
    bpot:pcfID "10127" .

bpot:PCF_10128 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select channels for target segments" ;
    bpot:apqcSourceText "Choose the most pertinent marketing channel for the targeted segments (based on Determine channel fit with target segments [10127])." ;
    bpot:hierarchyID "3.2.3.4" ;
    bpot:pcfID "10128" .

bpot:PCF_10132 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10103 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish sales goals and measures" ;
    bpot:apqcSourceText "Establishing specific quantitative and qualitative measures of realizing sales targets. Create sales targets by analyzing historical sales data and comparing the forecasts to results, in light of customer and market intelligence. Examine the performance of sales personnel in light of market opportunities. Based on this review, establish sales targets along with metrics to quantify these goals, corresponding with the overall business strategy." ;
    bpot:hierarchyID "3.4.4" ;
    bpot:pcfID "10132" .

bpot:PCF_10133 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10103 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish customer management measures" ;
    bpot:apqcSourceText "Identifying the appropriate measures that can represent key attributes of the customer management function. Select measures to track customer activity, feedback, satisfaction, organizational responsiveness to customer needs, and general data on how the organization is managing customer accounts, leads, and contacts. Build on customer and market intelligence to identify metrics gauging aspects related to customer management. Select measures based on the nature of the business, the type and size of customer base, strategic goals, and the model used to structure sales and customer relationships." ;
    bpot:hierarchyID "3.4.5" ;
    bpot:pcfID "10133" .

bpot:PCF_10134 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10129 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Gather current and historic order information" ;
    bpot:apqcSourceText "Gathering all information about sales orders into an index. Create a directory of all sales orders, whether open or those which have been fulfilled. Track what product/service was ordered, the quantity ordered, who ordered it, the delivery date, the shipping method, the unit price and line total, payment terms, and any discount applied." ;
    bpot:hierarchyID "3.4.1.1" ;
    bpot:pcfID "10134" .

bpot:PCF_10135 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10129 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze sales trends and patterns" ;
    bpot:apqcSourceText "Analyzing sales order data to identify patterns in order to capitalize on emerging trends in the industry or the economy. Closely examine the directory of sales orders. Discern any patterns from this index, which is representative of the demand for the organization's offerings. Identify trends among the various segments of the organization's customer base to create forecasts. Glean patterns from this analysis, including the triangulation of segments that are showing the most growth in demand or those that represent the highest decline revenue, industry-wide trends such as decline/boost in overall demand, and any unusual trends that lie outside of the organization's expectations." ;
    bpot:hierarchyID "3.4.1.2" ;
    bpot:pcfID "10135" .

bpot:PCF_10136 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10129 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate sales forecast" ;
    bpot:apqcSourceText "Calculating the future demand for the organization's products/services. Use the trends and patterns identified in the sales data to estimate future demand. Use forecast to prepare for future customer demand and to recalibrate the strategic course of functions and business units." ;
    bpot:hierarchyID "3.4.1.3" ;
    bpot:pcfID "10136" .

bpot:PCF_10137 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10129 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze historical and planned promotions and events" ;
    bpot:apqcSourceText "Reviewing promotional activities' effect on the sales orders. Analyze all promotional events and campaigns that the organization has already employed or is planning to deploy. " ;
    bpot:hierarchyID "3.4.1.4" ;
    bpot:pcfID "10137" .

bpot:PCF_10138 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify alliance opportunities" ;
    bpot:apqcSourceText "Identifying collaboration opportunities for selling, marketing, and distributing the organization's products/services. Determine any scope for partnering with other economic agents, with synergies for the marketing, sales, and/or distribution of the organization's products/services. Identify alliance opportunities that target customer segments who would be interested." ;
    bpot:hierarchyID "3.4.2.1" ;
    bpot:pcfID "10138" .

bpot:PCF_10139 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design alliance programs and methods for selecting and managing relationships" ;
    bpot:apqcSourceText "Creating the frameworks needed to select alliance partners, and maintaining relationships with them. Create a framework for structured programs that can receive and support multiple alliances. Clearly outline the responsibilities and benefits of the alliance partners. Create frameworks for selecting the right alliance partners, and maintain a relationship with them. Create or repurpose teams of relationship managers and outline a methodology for selecting alliance partners." ;
    bpot:hierarchyID "3.4.2.2" ;
    bpot:pcfID "10139" .

bpot:PCF_10140 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select alliances" ;
    bpot:apqcSourceText "Choosing alliance partners using the selected programs and methodology. Select the most feasible and profitable alliance partners, based on Design alliance programs and methods for selecting and managing relationships [10139] and through a careful scrutiny of the potential alliance." ;
    bpot:hierarchyID "3.4.2.3" ;
    bpot:pcfID "10140" .

bpot:PCF_10141 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop partner and alliance management strategies" ;
    bpot:apqcSourceText "Designing strategies for effectively managing, identifying, and countering any possible issues from the alliance partnerships formed. Create a strategic road map for managing the partnerships forged through Design alliance programs and methods for selecting and managing relationships [10139]. Determine where the alliance partnerships are headed, possible problems or pushback from the partners, how these issues might be countered, how these alliance partnerships would evolve in the future, any other business cases where these partnerships might be deployed, etc." ;
    bpot:hierarchyID "3.4.2.7" ;
    bpot:pcfID "10141" .

bpot:PCF_10142 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish partner and alliance management goals" ;
    bpot:apqcSourceText "Setting targets for organizational achievement. This includes what the organization aims to achieve from and how it wishes to manage both the individual partners and the alliance as a whole. Set immediate through long-term goals including revenue targets, market penetration, footfall numbers, and geographical coverage." ;
    bpot:hierarchyID "3.4.2.8" ;
    bpot:pcfID "10142" .

bpot:PCF_10143 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10131 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate product revenue" ;
    bpot:apqcSourceText "Estimating revenue from the sale of products/services. Approximate the anticipated sale of products/services and multiply it by the selling price of the respective offering. (This represents the total amount of money that the organization receives from the sale of its portfolio of offerings.)" ;
    bpot:hierarchyID "3.4.3.2" ;
    bpot:pcfID "10143" .

bpot:PCF_10144 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10131 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine variable costs" ;
    bpot:apqcSourceText "Calculating the variable costs of production. Approximate those costs that depend on the volume of products/services produced by the organization." ;
    bpot:hierarchyID "3.4.3.3" ;
    bpot:pcfID "10144" .

bpot:PCF_10145 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10131 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine overhead and fixed costs" ;
    bpot:apqcSourceText "Calculating the overhead costs associated with selling the organization's products/services. Determine fixed costs that are not directly related to the volume of products/services processed or the sale of these offerings (e.g., expense over machinery and equipment)." ;
    bpot:hierarchyID "3.4.3.4" ;
    bpot:pcfID "10145" .

bpot:PCF_10146 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10131 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate net profit" ;
    bpot:apqcSourceText "Calculating the net income. Calculate the organization's profitability by accounting for Determine overhead and fixed costs [10145] and Determine variable costs [10144]." ;
    bpot:hierarchyID "3.4.3.5" ;
    bpot:pcfID "10146" .

bpot:PCF_10147 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10131 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create budget" ;
    bpot:apqcSourceText "Creating a plan in measurable terms for the financial outlay that best captures resource allocation for the sales forecast. Consider the outlay of capital, HR, raw materials, and provisions needed to reach sales targets." ;
    bpot:hierarchyID "3.4.3.6" ;
    bpot:pcfID "10147" .

bpot:PCF_10148 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish goals, objectives, and measures for products/services by channel/segment" ;
    bpot:apqcSourceText "Determining what to achieve by marketing. Create qualitative and quantitative targets. Establish metrics to track performance (for individual Market segments [10109] and Channels for target segments [10129]). Enlist the head of marketing to determine marketing priorities and the related measures. (The decision in establishing these goals, objectives, and metrics is founded in Develop marketing strategy [10102] and takes cues from current priorities and organizational strategy.)" ;
    bpot:hierarchyID "3.3.1" ;
    bpot:pcfID "10148" .

bpot:PCF_10155 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10149 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Confirm marketing alignment to business strategy" ;
    bpot:apqcSourceText "Ensuring corroboration of the marketing strategy and the organizational strategy. Ensure the organization's marketing strategy/plan aligns with the overall business strategy. Fine-tune the marketing plan according to the organizational strategy." ;
    bpot:hierarchyID "3.3.2.1" ;
    bpot:pcfID "10155" .

bpot:PCF_10156 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10149 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine costs of marketing" ;
    bpot:apqcSourceText "Calculating the total cost of marketing the organization's portfolio of products/services. Calculate the total outlay needed for promoting, selling, and delivering the organization's products/services to customers. Account for all costs to acquire customers and sustain a relationship with them. Include the expenses needed for promotional actives, warehousing, transactional costs, and distribution of the organization's offering." ;
    bpot:hierarchyID "3.3.2.2" ;
    bpot:pcfID "10156" .

bpot:PCF_10157 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10149 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create marketing budget" ;
    bpot:apqcSourceText "Estimating the outlay required for promoting, selling, and distributing the products/services of the organization. Add up the expenses of all activities necessitated in marketing, such as promotional campaigns, advertising, marketing communications, PR campaigns, employing skilled personnel, and office space." ;
    bpot:hierarchyID "3.3.2.3" ;
    bpot:pcfID "10157" .

bpot:PCF_10159 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop marketing messages" ;
    bpot:apqcSourceText "Developing the central messages for a segment of its customers. Craft concise statements that position the value proposition of individual products/services around the pressing concerns in the market, thereby showing how the organization's offerings are the right fit for the customers." ;
    bpot:hierarchyID "3.3.4.2" ;
    bpot:pcfID "10159" .

bpot:PCF_10160 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define target audience" ;
    bpot:apqcSourceText "Determining the appropriate audience to direct marketing efforts at. Identify the particular group of customers to target. Discover the appropriate customer groups at a micro-level. Use techniques such as segmentation analysis, whereby the entire population is sliced according to certain demographic or behavioral attributes." ;
    bpot:hierarchyID "3.3.4.3" ;
    bpot:pcfID "10160" .

bpot:PCF_10163 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine pricing based on volume/unit forecast" ;
    bpot:apqcSourceText "Establishing a dynamic pricing mechanism for the organization's offerings that is supported by the number of units in production. Outline a system for determining the optimum price point for each product/service. Based this model on an estimation of the volume of anticipated sales for each offering and variable costs." ;
    bpot:hierarchyID "3.3.3.3" ;
    bpot:pcfID "10163" .

bpot:PCF_10164 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute pricing plan" ;
    bpot:apqcSourceText "Implementing the pricing mechanism to determine prices for all individual offerings in the organizational portfolio. Calculate the prices of all offerings based on the established methodology and/or formulaic structure." ;
    bpot:hierarchyID "3.3.3.4" ;
    bpot:pcfID "10164" .

bpot:PCF_10165 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate pricing performance" ;
    bpot:apqcSourceText "Examining the efficiency of pricing with the objective of identifying any divergence from the equilibrium prices and avoiding any deadweight loss. Gauge the performance of the pricing plan by tracking growth in the revenue and/or customer uptake, secured as a result of new prices. Measure the performance of pricing by periodically checking the profits generated from the sale of each of the organization's offerings against the backdrop of any events that may have influenced the uptake of a certain good/service by the customer base." ;
    bpot:hierarchyID "3.3.3.5" ;
    bpot:pcfID "10165" .

bpot:PCF_10166 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Refine pricing as needed" ;
    bpot:apqcSourceText "Refining the pricing mechanism to create equitable prices for all products/services with the objective of maximizing the profits and/or customer uptake of these offerings. Reconcile the pricing mechanism in order to achieve equilibrium pricing. Adjust the prices for all of the organization's offerings, using the insights gleaned from examining how much profit or customer uptake is generated by the present pricing strategy." ;
    bpot:hierarchyID "3.3.3.6" ;
    bpot:pcfID "10166" .

bpot:PCF_10167 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define promotional concepts and objectives" ;
    bpot:apqcSourceText "Outlining a conceptual framework for all promotional activity in order to create an overarching aspiration and ensure consistency. Create a plan for running promotional programs and designing the associated activities in order to increase visibility or sales. Determine how the organization quantifies what it wishes to achieve from these activities, what sort of messages the organization comfortable publicizing, what channels the organization wishes to employ, etc." ;
    bpot:hierarchyID "3.3.4.1" ;
    bpot:pcfID "10167" .

bpot:PCF_10168 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and test promotional activities" ;
    bpot:apqcSourceText "Developing a scheme for executing the promotional programs and campaigns, and testing these on sample audiences. Create a program plan, and carry out trials for promotional activities. Develop a scheme for how, when, where, and by whom the promotional schemes and campaigns will be deployed. Design incentives that convince or tempt the consumer to take up the organization's offerings. Conduct focus groups and pilot programs that reach out to a smaller number of people from among the target audiences to validate effectiveness." ;
    bpot:hierarchyID "3.3.4.4" ;
    bpot:pcfID "10168" .

bpot:PCF_10169 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute promotional activities" ;
    bpot:apqcSourceText "Executing promotional programs in the market for reaching out to the desired customer segments. Implement the promotional schemes and campaigns. Create collaterals for the dissemination of information about the product, product line, brand, or company to the target audiences in an effective manner. Leverage relationships with distributors, vendors, and retailers. Consider enlisting professional services such as design, PR, and advertising firms." ;
    bpot:hierarchyID "3.3.4.5" ;
    bpot:pcfID "10169" .

bpot:PCF_10170 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate promotional performance metrics" ;
    bpot:apqcSourceText "Evaluating the success of promotional programs through metrics that track the impact of these activities. Examine the performance of promotional activities. Measure the success of these programs through metrics representative of customer uptake, market penetration, sustenance of impact created, revenue growth through offerings marketed, etc. Measure through primary data collection. Analyze through various statistical techniques to generate insights." ;
    bpot:hierarchyID "3.3.4.6" ;
    bpot:pcfID "10170" .

bpot:PCF_10171 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Refine promotional performance metrics" ;
    bpot:apqcSourceText "Fine-tuning promotional activities by employing the insights gleaned from the quantitative, as well as any qualitative, performance evaluations. Change certain attributes of the schemes, campaigns, and programs deployed in order to increase the impact generated, in terms of measures already agreed upon such as customer uptake, market penetration, sustenance of impact created, and revenue growth through offerings marketed." ;
    bpot:hierarchyID "3.3.4.7" ;
    bpot:pcfID "10171" .

bpot:PCF_10172 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Incorporate learning into future/planned consumer promotions" ;
    bpot:apqcSourceText "Incorporating the understanding developed by studying promotional activities as well as refining them. Include the best practices and value-enhancing attributes identified in Refine promotional activities [10171] into similarly planned schemes, programs, and campaigns. Adjust promotional activities to further increase the effectiveness of the overall promotional efforts." ;
    bpot:hierarchyID "3.3.4.8" ;
    bpot:pcfID "10172" .

bpot:PCF_10173 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10153 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine customer lifetime value" ;
    bpot:apqcSourceText "Estimating customer loyalty and the average contribution made by them to revenues, over their lifespan. Use metrics to quantify the commitment of customers to the offerings of the organization, such as measures of tendency to switch brands/providers, number/proportion of return customers, and the number of customers using multiple substitutable offerings." ;
    bpot:hierarchyID "3.3.5.1" ;
    bpot:pcfID "10173" .

bpot:PCF_10174 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10153 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer revenue trend" ;
    bpot:apqcSourceText "Analyzing the revenue stream generated by the sale of the organization's products/services in order to identify trends therein. Examine data relating to the inflow of revenue from individual/groups of customers in order to identify patterns in the generation and sustenance of receivables. Conduct statistical analysis over the stream of revenue collected and the point of origin associated with each unit of sale through metrics such as the accounting rate of return, the GAAP revenue over a given period, and customer lifetime revenue." ;
    bpot:hierarchyID "3.3.5.2" ;
    bpot:pcfID "10174" .

bpot:PCF_10175 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10153 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer attrition and retention rates" ;
    bpot:apqcSourceText "Calculating measures that capture the proportion of customers the organization is able to retain to those it is losing. Compute metrics such as the tendency to switch brands/providers and the proportion of return customers to comprehend the trends within the customer attrition and retention rates." ;
    bpot:hierarchyID "3.3.5.3" ;
    bpot:pcfID "10175" .

bpot:PCF_10176 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10153 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer metrics" ;
    bpot:apqcSourceText "Studying all measures of the customer's behavior and conduct toward the organization's offerings in order to glean insight and identify patterns into their decision making. Closely examine all categories of data sets over a customer base. Analyze data points related to customer loyalty, retention, value, conversion, level of satisfaction, attrition, etc. Flesh out measures for an all-encompassing analysis that provides a macro-level picture of the customer's behavior and mindset related to the organization's products/services." ;
    bpot:hierarchyID "3.3.5.4" ;
    bpot:pcfID "10176" .

bpot:PCF_10177 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10153 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Revise customer strategies, objectives, and plans based on metrics" ;
    bpot:apqcSourceText "Reviewing and reappraising the strategies, objectives, and plans for all customer-centered processes. Revisit all customer-focused processes and activities--which relate to their acquisition, conversion, and retention--with the objective of revising them in light of customer analysis. Revise accordingly." ;
    bpot:hierarchyID "3.3.5.5" ;
    bpot:pcfID "10177" .

bpot:PCF_10178 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10154 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan packaging strategy" ;
    bpot:apqcSourceText "Creating a strategic road map for how to package products/services into desirable solutions while increasing profitability. Create a scheme for how the organization will bundle and wrap its products/services into a presentable and sellable offering. Consider what aspects or components of an offering the organization can extract the maximum revenue from, and reduce the less profitable constituents while maintaining a high perceptible value for the customers. Balance maximizing profit with benefits to the customer." ;
    bpot:hierarchyID "3.3.7.1" ;
    bpot:pcfID "10178" .

bpot:PCF_10179 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10154 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Test packaging options" ;
    bpot:apqcSourceText "Piloting the packaged products/services in the market with a test audience. Create trial runs using techniques such as focus groups of the final product, wrapped and bundled." ;
    bpot:hierarchyID "3.3.7.2" ;
    bpot:pcfID "10179" .

bpot:PCF_10180 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10154 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute packaging strategy" ;
    bpot:apqcSourceText "Implementing the final packaging. Put into action the packaging strategy in light of the insights accumulated from testing various options." ;
    bpot:hierarchyID "3.3.7.3" ;
    bpot:pcfID "10180" .

bpot:PCF_10181 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10154 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Refine packaging" ;
    bpot:apqcSourceText "Fine-tuning the packaging that has been developed and tested using insights gleaned from feedback. " ;
    bpot:hierarchyID "3.3.7.4" ;
    bpot:pcfID "10181" .

bpot:PCF_10188 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify potential customers" ;
    bpot:apqcSourceText "Identifying people who can be converted into customers. Leverage personal and professional networks, business research over databases and directories, and secondary research." ;
    bpot:hierarchyID "3.5.1.1" ;
    bpot:pcfID "10188" .

bpot:PCF_10189 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify/receive leads/opportunities" ;
    bpot:apqcSourceText "Qualifying the prospective customers into credible leads by gauging their behavior against the organization's offering. Triangulate leads to increase the efficiency of sales and marketing efforts. Build a detailed profile of the prospects. Determine what products/services they already use, if they have decision-making authority, their views on the products/services they already use, how prone they are to switch, if the organization's solution better in some attributes than those prospects currently use, etc." ;
    bpot:hierarchyID "3.5.1.2" ;
    bpot:pcfID "10189" .

bpot:PCF_10190 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10184 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform sales calls" ;
    bpot:apqcSourceText "Communicating with customers and prospects with the intent of creating sales opportunities. Reach out to existing and prospective customers through alternate media and networking channels, apart from cold calling/emailing." ;
    bpot:hierarchyID "3.5.1.8.1" ;
    bpot:pcfID "10190" .

bpot:PCF_10191 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10184 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform pre-sales activities" ;
    bpot:apqcSourceText "Capitalizing on sales calls by pitching on bids and closing deals. Outline the nature and scope of the work, draft agreement terms, prepare proposals and agreements, and propose timelines and prices." ;
    bpot:hierarchyID "3.5.1.8.2" ;
    bpot:pcfID "10191" .

bpot:PCF_10192 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10184 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Close the sale" ;
    bpot:apqcSourceText "Formalizing a sale by reaching an agreement on terms of the deal. Negotiate on the price, and reach a consensus on the terms and conditions." ;
    bpot:hierarchyID "3.5.1.8.4" ;
    bpot:pcfID "10192" .

bpot:PCF_10193 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10184 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record outcome of sales process" ;
    bpot:apqcSourceText "Completing all the paper-work associated with the sale of its products/services. Exchange any pertinent legal/financial information required for completing the sale, signing of a contract/work-order, and issuing copies of bills/invoices." ;
    bpot:hierarchyID "3.5.1.8.5" ;
    bpot:pcfID "10193" .

bpot:PCF_10194 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Accept and validate sales orders" ;
    bpot:apqcSourceText "Receiving and confirming orders from customers. Verify that no extra expenses have to be disbursed on part of the organization for labor or inventory when processing the order. " ;
    bpot:hierarchyID "3.5.4.1" ;
    bpot:pcfID "10194" .

bpot:PCF_10196 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine availability" ;
    bpot:apqcSourceText "Ascertaining the volume or scale of products/services to provide to customers to fulfill sales orders. Check the finished products stored in warehouses, the production capacity, and (in the case of services) the processing speed, as well as work force availability." ;
    bpot:hierarchyID "3.5.4.3" ;
    bpot:pcfID "10196" .

bpot:PCF_10197 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine fulfillment process" ;
    bpot:apqcSourceText "Devising a blueprint for order fulfillment. Create a schematic flow encompassing all activities to deliver orders to the customers. Outline a procedure for satisfying these orders by answering questions about what needs to happen in sequence to realize an order." ;
    bpot:hierarchyID "3.5.4.4" ;
    bpot:pcfID "10197" .

bpot:PCF_10199 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process back orders and updates" ;
    bpot:apqcSourceText "Processing any unfulfilled orders, and updating the status of any orders that have been accepted and are being attended to. Deliver on any purchase orders that remain unserviced due to temporary unavailability of the product/service. Manage any updates to the sales orders. Revise their status in the order system." ;
    bpot:hierarchyID "3.5.4.5" ;
    bpot:pcfID "10199" .

bpot:PCF_10200 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Handle sales order inquiries including post-order fulfillment transactions" ;
    bpot:apqcSourceText "Attending to any queries received from the customers, even after a sales order has been serviced. Deploy ad hoc personnel for managing these enquiries." ;
    bpot:hierarchyID "3.5.4.6" ;
    bpot:pcfID "10200" .

bpot:PCF_10201 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Administer key account details" ;
    bpot:apqcSourceText "Managing essential information of customer accounts." ;
    bpot:hierarchyID "3.5.4.2.1" ;
    bpot:pcfID "10201" .

bpot:PCF_10202 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Retrieve full customer details" ;
    bpot:apqcSourceText "Obtaining detailed information about customers." ;
    bpot:hierarchyID "3.5.4.2.2" ;
    bpot:pcfID "10202" .

bpot:PCF_10203 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Modify involved party details" ;
    bpot:apqcSourceText "Altering information about involved parties." ;
    bpot:hierarchyID "3.5.4.2.3" ;
    bpot:pcfID "10203" .

bpot:PCF_10204 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record address details" ;
    bpot:apqcSourceText "Documenting address information." ;
    bpot:hierarchyID "3.5.4.2.4" ;
    bpot:pcfID "10204" .

bpot:PCF_10205 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record contact details" ;
    bpot:apqcSourceText "Documenting contact information." ;
    bpot:hierarchyID "3.5.4.2.5" ;
    bpot:pcfID "10205" .

bpot:PCF_10206 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record key customer communication profile details" ;
    bpot:apqcSourceText "Providing information about important business rules regarding communicating with customers." ;
    bpot:hierarchyID "3.5.4.2.6" ;
    bpot:pcfID "10206" .

bpot:PCF_10207 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review involved party information" ;
    bpot:apqcSourceText "Revising information about involved parties." ;
    bpot:hierarchyID "3.5.4.2.7" ;
    bpot:pcfID "10207" .

bpot:PCF_10208 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10195 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Terminate involved party information" ;
    bpot:apqcSourceText "Dismissing information about involved parties." ;
    bpot:hierarchyID "3.5.4.2.8" ;
    bpot:pcfID "10208" .

bpot:PCF_10209 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine sales resource allocation" ;
    bpot:apqcSourceText "Planning the distribution of personnel across various sales functions. Match the capabilities of individual employees with the skill sets needed for specific roles. Seek assistance from HR." ;
    bpot:hierarchyID "3.5.1.7" ;
    bpot:pcfID "10209" .

bpot:PCF_10210 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10425 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish incentive strategy" ;
    bpot:apqcSourceText "Creating a scheme of awards and recognition for sales employees to promote a results-based culture. Create specific incentives to reach desired outcomes, such as landing key clients, growing the customer base, providing exceptional servicing, and increasing profit margins." ;
    bpot:hierarchyID "7.1.2.3.1" ;
    bpot:pcfID "10210" .

bpot:PCF_10214 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10187 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate partner/alliance results" ;
    bpot:apqcSourceText "Examining the performance of its partners/alliances in selling its products/services. Use metrics such as growth in revenue generated, conversion rate, and total outreach to customers for assessing the performance results." ;
    bpot:hierarchyID "3.5.5.3" ;
    bpot:pcfID "10214" .

bpot:PCF_10229 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define manufacturing goals" ;
    bpot:apqcSourceText "Creating quantifiable strategic objectives for each manufacturing segment in conjunction with sales projections." ;
    bpot:hierarchyID "4.1.1.1" ;
    bpot:pcfID "10229" .

bpot:PCF_10230 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define labor and materials policies" ;
    bpot:apqcSourceText "Setting up internal rules and regulations regarding the employees and the materials." ;
    bpot:hierarchyID "4.1.1.2" ;
    bpot:pcfID "10230" .

bpot:PCF_10231 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define outsourcing policies" ;
    bpot:apqcSourceText "Creating rules and regulations regarding contracting out of a business process to another party in order to reduce costs." ;
    bpot:hierarchyID "4.1.1.3" ;
    bpot:pcfID "10231" .

bpot:PCF_10232 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define capital expense policies" ;
    bpot:apqcSourceText "Designing rules and regulations pertaining to the expenditure incurred in acquiring or upgrading the existing stock of manufacturing capital. " ;
    bpot:hierarchyID "4.1.1.4" ;
    bpot:pcfID "10232" .

bpot:PCF_10233 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define capacities" ;
    bpot:apqcSourceText "Outlining the manufacturing and processing capacities of the organization. Delineate the capabilities required for optimizing output with available resources. Analyze capabilities possessed by the organization concerning the raw materials required and the process necessitated for producing finished products. " ;
    bpot:hierarchyID "4.1.1.5" ;
    bpot:pcfID "10233" .

bpot:PCF_10234 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10221 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define production network and supply constraints" ;
    bpot:apqcSourceText "Defining limitations in the ability of the organization's supply chain to deliver a new stock, and creating a network of production stakeholders. Frame and manage relationships within the flow of manufacturing and processing operations. Identify probable supply issues." ;
    bpot:hierarchyID "4.1.1.6" ;
    bpot:pcfID "10234" .

bpot:PCF_10235 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10222 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop baseline demand forecasts" ;
    bpot:apqcSourceText "Identify the bedrock levels of market demand anticipated for the organization's products/services. Estimate future demand for product and services using historical data, analysis of the market environment and any externalities, etc. to create ex ante approximations." ;
    bpot:hierarchyID "4.1.2.1" ;
    bpot:pcfID "10235" .

bpot:PCF_10236 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10222 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collaborate demand with customers" ;
    bpot:apqcSourceText "Working closely with the organization's customers to understand their drives and behavior, with the objective of estimating future demand. Reach out to customers through various means to understand their behavior patterns, usage elasticity, and degree of variability--and ultimately determine demand for each offering." ;
    bpot:hierarchyID "4.1.2.2" ;
    bpot:pcfID "10236" .

bpot:PCF_10237 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10222 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop demand consensus forecast" ;
    bpot:apqcSourceText "Arriving at a consensus over the forecasted levels of demand for products/services. Consensus is achieved by juxtaposing decisions developed in the baseline forecast with those reached at by collaborating with customers. Enlist senior-level decision makers of the sales and marketing functions." ;
    bpot:hierarchyID "4.1.2.3" ;
    bpot:pcfID "10237" .

bpot:PCF_10238 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10222 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine available to promise" ;
    bpot:apqcSourceText "Identify the volume of products/services that may be committed for delivery to fulfill sales. Figure out the amount of stock available. Forecast its volumes." ;
    bpot:hierarchyID "4.1.2.4" ;
    bpot:pcfID "10238" .

bpot:PCF_10239 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10222 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor activity against demand forecast and revise forecast" ;
    bpot:apqcSourceText "Picking out any activity that deviates from the forecast, and adjusting it. Closely track and study the levels of demand as they emerge. Refine the consensus forecast as needed." ;
    bpot:hierarchyID "4.1.2.5" ;
    bpot:pcfID "10239" .

bpot:PCF_10240 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10222 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate and revise demand forecasting approach" ;
    bpot:apqcSourceText "Examining the methodology used to estimate future demand. Refine it in light of current market realities and demand." ;
    bpot:hierarchyID "4.1.2.6" ;
    bpot:pcfID "10240" .

bpot:PCF_10241 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10222 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure demand forecast accuracy" ;
    bpot:apqcSourceText "Calculating and inspecting the accuracy of demand forecasts. Use metrics to check the reliability of the forecasts created. " ;
    bpot:hierarchyID "4.1.2.7" ;
    bpot:pcfID "10241" .

bpot:PCF_10242 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10223 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create unconstrained plan" ;
    bpot:apqcSourceText "Developing a plan for raw materials and other inventory items in order to meet market demand. Ensure the availability of all inventory items such as raw materials and spares. Create a blueprint in line with Define labor and materials policies [10230]. " ;
    bpot:hierarchyID "4.1.3.1" ;
    bpot:pcfID "10242" .

bpot:PCF_10243 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10223 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collaborate with supplier and contract manufacturers" ;
    bpot:apqcSourceText "Collaborating with vendors and contractual manufacturers with the objective of ensuring a continual supply of raw materials and spares. Leverage long-term connections/relationships with various suppliers, and cultivate new ones. Track the activities of all vendors. Receive regular updates to prepare for any fluctuations in supply." ;
    bpot:hierarchyID "4.1.3.2" ;
    bpot:pcfID "10243" .

bpot:PCF_10244 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10223 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify critical materials and supplier capacity" ;
    bpot:apqcSourceText "Identifying principal materials needed for the manufacturing process and the levels of supply that may be ensured for them. Determine the essential and crucial inventory items required for the smooth functioning of all manufacturing processes. Estimate the average, peak, and baseline capacities of various vendors and suppliers. Establish the capability of individual suppliers from the market and the vendors." ;
    bpot:hierarchyID "4.1.3.3" ;
    bpot:pcfID "10244" .

bpot:PCF_10245 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10223 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor material specifications" ;
    bpot:apqcSourceText "Observing and surveying all inventory items in order to check for the veracity of their specifications. Monitor various attributes and characteristics for respective inventory items such as density, volume, and size, as well as contextualized specifications particular to the respective materials." ;
    bpot:hierarchyID "4.1.3.4" ;
    bpot:pcfID "10245" .

bpot:PCF_10246 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10223 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate constrained plan" ;
    bpot:apqcSourceText "Generating a bounded plan that takes stock of the actual supply chain scenario. Take stock of all information collected while creating an inventory supply plan. " ;
    bpot:hierarchyID "4.1.3.5" ;
    bpot:pcfID "10246" .

bpot:PCF_10252 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain master data" ;
    bpot:apqcSourceText "Maintaining and preserving the master data plan for distribution requirements. Create a systematic collection of facts and figures regarding the distribution of the inventories. Maintain policies, processes, and tools covering the distribution function." ;
    bpot:hierarchyID "4.1.5.1" ;
    bpot:pcfID "10252" .

bpot:PCF_10253 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine finished goods inventory requirements at destination" ;
    bpot:apqcSourceText "Interact with the concerned person at the destination to validate the requirements and to avoid any miscommunication of information." ;
    bpot:hierarchyID "4.1.5.2" ;
    bpot:pcfID "10253" .

bpot:PCF_10254 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate requirements at destination" ;
    bpot:apqcSourceText "Interact with the concerned authority at the destination to reach a specific figure that correctly represents requirements." ;
    bpot:hierarchyID "4.1.5.4" ;
    bpot:pcfID "10254" .

bpot:PCF_10255 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate consolidation at source" ;
    bpot:apqcSourceText "Determining the aggregate volume of products/services consolidated at the source. Calculate the number of finished products that are ready to be delivered to the customers, particularly at one date." ;
    bpot:hierarchyID "4.1.5.5" ;
    bpot:pcfID "10255" .

bpot:PCF_10256 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage collaborative replenishment planning" ;
    bpot:apqcSourceText "Administering the plan for collaborative replenishment of goods. Replenish inventory by creating a plan in case of faulty production." ;
    bpot:hierarchyID "4.1.5.6" ;
    bpot:pcfID "10256" .

bpot:PCF_10258 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate and optimize destination dispatch plan" ;
    bpot:apqcSourceText "Estimating the timing and duration of the delivery of the inventory from the source to the destination. Plan the logistic details of all the distribution routes and activities." ;
    bpot:hierarchyID "4.1.5.7" ;
    bpot:pcfID "10258" .

bpot:PCF_10259 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage dispatch plan attainment" ;
    bpot:apqcSourceText "Accomplishing the dispatch plan. Strictly follow the schedule, and adjust for deviations. Coordinate with the concerned authorities at various destinations." ;
    bpot:hierarchyID "4.1.5.8" ;
    bpot:pcfID "10259" .

bpot:PCF_10260 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate and optimize destination load plans" ;
    bpot:apqcSourceText "Evaluating the plans for delivering loads to destinations. Create a systematic plan that specifies the load plans for every single destination." ;
    bpot:hierarchyID "4.1.5.9" ;
    bpot:pcfID "10260" .

bpot:PCF_10261 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage partner load plan" ;
    bpot:apqcSourceText "Administering the load plan for partners. Manage the delivery, and dispatch from the source to the partners." ;
    bpot:hierarchyID "4.1.5.10" ;
    bpot:pcfID "10261" .

bpot:PCF_10262 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage cost of supply" ;
    bpot:apqcSourceText "Managing all expenses to provide products/services in the market. Estimate the overall cost of supplying of products/inventory, including the cost distributing it through various partners and channels. Consider the cost of all the logistical processes that occur from the moment a product is ready to be dispatched to the time it reaches the destination." ;
    bpot:hierarchyID "4.1.5.11" ;
    bpot:pcfID "10262" .

bpot:PCF_10263 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17042 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage capacity utilization" ;
    bpot:apqcSourceText "Determining the capacity utilization of the organization's production process. Realize the extent to which an enterprise uses its installed productive capacity (i.e., the relationship between output and the potential output if capacity was fully used)." ;
    bpot:hierarchyID "4.1.5.12" ;
    bpot:pcfID "10263" .

bpot:PCF_10264 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10227 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review distribution network" ;
    bpot:apqcSourceText "Evaluating the system that defines how the products/inventory would reach from the source (i.e., manufacturer) to the destination (i.e., retailer/distributer)." ;
    bpot:hierarchyID "4.1.7.1" ;
    bpot:pcfID "10264" .

bpot:PCF_10265 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10227 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish sourcing relationships" ;
    bpot:apqcSourceText "Establishing relationships with transportation/distribution sources in order to ensure an effective distribution network and strategy. Screen and evaluate various sources available to pick out the best among them." ;
    bpot:hierarchyID "4.1.7.2" ;
    bpot:pcfID "10265" .

bpot:PCF_10266 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10227 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish dynamic deployment policies" ;
    bpot:apqcSourceText "Creating strategic guidelines on the availability of the products at all the distribution centers. Create a dynamic network to ensure availability at all times, even in cases of defaults." ;
    bpot:hierarchyID "4.1.7.3" ;
    bpot:pcfID "10266" .

bpot:PCF_10267 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10226 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish distribution center layout constraints" ;
    bpot:apqcSourceText "Instituting the constraints for creating a layout for distribution center. Consider factors such as the number of customers, demand forecasting, product groups, condition of product conservation, warehousing, and transportation management." ;
    bpot:hierarchyID "4.1.6.1" ;
    bpot:pcfID "10267" .

bpot:PCF_10268 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10226 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish inventory management constraints" ;
    bpot:apqcSourceText "Determining any problems that might be faced while managing inventory. Identify problems and possible issues in managing the warehousing of the raw materials, spares, and other items of inventory. Take stock of inventory needs, and determine the exact quantity of the inventory needed in the near future." ;
    bpot:hierarchyID "4.1.6.2" ;
    bpot:pcfID "10268" .

bpot:PCF_10269 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10226 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish transportation management constraints" ;
    bpot:apqcSourceText "Identifying any potential constraints while deciding on the dispatch and delivery plan from the source to the various distribution centers. Decide how the inventory will be transported , which and how many transportation means to use, what route to take, etc." ;
    bpot:hierarchyID "4.1.6.3" ;
    bpot:pcfID "10269" .

bpot:PCF_10270 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20147 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish performance indicators (measures)" ;
    bpot:apqcSourceText "Designing key measures that analyze and interpret how effectively the business is achieving its objectives." ;
    bpot:hierarchyID "13.6.3.1" ;
    bpot:pcfID "10270" .

bpot:PCF_10271 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20147 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish monitoring frequency" ;
    bpot:apqcSourceText "Deciding on the appropriate amount of supervisions that are needed to effectively assess the performance of business plans." ;
    bpot:hierarchyID "13.6.3.2" ;
    bpot:pcfID "10271" .

bpot:PCF_10272 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20147 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate performance measures" ;
    bpot:apqcSourceText "Measuring the performance of process planning. Quantify the performance, record results of the performance tests, and report them to the appropriate authority." ;
    bpot:hierarchyID "13.6.3.4" ;
    bpot:pcfID "10272" .

bpot:PCF_10273 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20147 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify performance trends" ;
    bpot:apqcSourceText "Recognizing the trends in performance. Carefully and strategically assess the results in order to effectively spot the trends." ;
    bpot:hierarchyID "13.6.3.5" ;
    bpot:pcfID "10273" .

bpot:PCF_10274 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20147 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze performance" ;
    bpot:apqcSourceText "Evaluating the gaps between achieved and benchmarked performance. Analyze how performance differs from the optimal or expected performance. " ;
    bpot:hierarchyID "13.6.3.6" ;
    bpot:pcfID "10274" .

bpot:PCF_10275 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20147 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare performance reports" ;
    bpot:apqcSourceText "Creating reports that systematically record and represent the performance planning. Construct a detailed report specifying the performance, and include indicators such as the performance gaps, performance trends, and analysis." ;
    bpot:hierarchyID "13.6.3.7" ;
    bpot:pcfID "10275" .

bpot:PCF_10276 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20147 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop performance improvement plan" ;
    bpot:apqcSourceText "Using performance indicators to report, analyze, and create a detailed performance improvement plan to bridge the performance gaps." ;
    bpot:hierarchyID "13.6.3.8" ;
    bpot:pcfID "10276" .

bpot:PCF_10281 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10277 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop procurement plan" ;
    bpot:apqcSourceText "Creating a plan for procuring materials and services. Plan what to buy, when, and from what sources. Include project requirements, the procurement team, the justification for the procurement, a timeline of events, and an explanation of the supplier selection process. Outline specific actions to start and complete purchases in order to adhere to best practices." ;
    bpot:hierarchyID "4.2.1.1" ;
    bpot:pcfID "10281" .

bpot:PCF_10282 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10277 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Clarify purchasing requirements" ;
    bpot:apqcSourceText "Defining the purchasing requirements for materials and services. Specify the exact inventory required for the production process. Create a specific quotation for all the sources in order to avoid any duplication or overlap." ;
    bpot:hierarchyID "4.2.1.2" ;
    bpot:pcfID "10282" .

bpot:PCF_10283 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10277 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish materials management contingency plans" ;
    bpot:apqcSourceText "Developing a strategy to deal with issues projected to arise during implementation of the inventory plan. Identify how to react to issues that arise and require changes to the inventory plan, such as a vendor failing to deliver materials on time. Collaborate with production and suppliers to prepare solutions to projected problems." ;
    bpot:hierarchyID "4.2.1.3" ;
    bpot:pcfID "10283" .

bpot:PCF_10284 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10277 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Match needs to supply capabilities" ;
    bpot:apqcSourceText "Synchronizing the requirements of materials and services and the capacity of suppliers for providing these materials and services. Revamp the procurement needs of the company in consideration of the capabilities of the suppliers. " ;
    bpot:hierarchyID "4.2.1.4" ;
    bpot:pcfID "10284" .

bpot:PCF_10285 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10277 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze organization’s spend profile" ;
    bpot:apqcSourceText "Evaluating the spend profile of the organization. Collect, cleanse, classify, and analyze the procurement data with the purpose of reducing procurement costs, improving efficiency, and monitoring compliance." ;
    bpot:hierarchyID "4.2.1.5" ;
    bpot:pcfID "10285" .

bpot:PCF_10286 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10277 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Seek opportunities to improve efficiency and value" ;
    bpot:apqcSourceText "Seeking the most efficient sourcing and procurement opportunities." ;
    bpot:hierarchyID "4.2.1.6" ;
    bpot:pcfID "10286" .

bpot:PCF_10287 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10277 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collaborate with suppliers to identify sourcing opportunities" ;
    bpot:apqcSourceText "Collaborating with the suppliers of materials and services in order to determine new opportunities for sourcing. " ;
    bpot:hierarchyID "4.2.1.7" ;
    bpot:pcfID "10287" .

bpot:PCF_10288 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10278 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select suppliers" ;
    bpot:apqcSourceText "Evaluating the pros and cons of various suppliers. Choose the most appropriate and cost-effective suppliers on the basis of their material quality, delivery schedules, and costs." ;
    bpot:hierarchyID "4.2.2.1" ;
    bpot:pcfID "10288" .

bpot:PCF_10289 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10278 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Certify and validate suppliers" ;
    bpot:apqcSourceText "Validating the supply sources, and provide certification as an official supplier." ;
    bpot:hierarchyID "4.2.2.2" ;
    bpot:pcfID "10289" .

bpot:PCF_10290 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10278 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Negotiate and establish contracts" ;
    bpot:apqcSourceText "Legally binding suppliers with the company. Negotiate contracts individually with all the suppliers that include the promised material delivery, the delivery dates and duration, etc." ;
    bpot:hierarchyID "4.2.2.3" ;
    bpot:pcfID "10290" .

bpot:PCF_10291 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10278 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage contracts" ;
    bpot:apqcSourceText "Keeping contracts up-to-date with routine evaluation. Maintain order and discipline with the contracts in order to avoid any loss of information and mishaps." ;
    bpot:hierarchyID "4.2.2.4" ;
    bpot:pcfID "10291" .

bpot:PCF_10292 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10279 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process/Review requisitions" ;
    bpot:apqcSourceText "Handling operations related to processing/reviewing the requisitions. Establish and maintain procedures for the initiation, authorization, and processing of purchase requirements to procure products/services." ;
    bpot:hierarchyID "4.2.3.1" ;
    bpot:pcfID "10292" .

bpot:PCF_10293 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10279 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Approve requisitions" ;
    bpot:apqcSourceText "Approving requisitions for materials and services. Examine distributor-specific requests, and validate them individually." ;
    bpot:hierarchyID "4.2.3.2" ;
    bpot:pcfID "10293" .

bpot:PCF_10294 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10279 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Solicit supplier quotes" ;
    bpot:apqcSourceText "Requesting quotes from suppliers. Use a request for quotation (RFQ) to invite suppliers into a bidding process for specific products/services." ;
    bpot:hierarchyID "4.2.3.3" ;
    bpot:pcfID "10294" .

bpot:PCF_10295 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10279 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create/Distribute purchase orders" ;
    bpot:apqcSourceText "Creating and placing the orders for purchasing materials and services from suppliers. Analyze vendor quotes. Choose the most cost-effective vendors. Create vendor-specific orders. Distribute them in order to initiate the purchasing process." ;
    bpot:hierarchyID "4.2.3.4" ;
    bpot:pcfID "10295" .

bpot:PCF_10296 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10279 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Expedite orders and satisfy inquiries" ;
    bpot:apqcSourceText "Accelerating the purchase orders in order to fulfill the internal needs (for raw materials) depicted through inquiries. " ;
    bpot:hierarchyID "4.2.3.5" ;
    bpot:pcfID "10296" .

bpot:PCF_10297 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10279 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reconcile purchase orders" ;
    bpot:apqcSourceText "Verify that purchase orders are filled as expected: verify that items and quantities are delivered as expected, based on purchase order details and goods receipts." ;
    bpot:hierarchyID "4.2.3.6" ;
    bpot:pcfID "10297" .

bpot:PCF_10298 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10279 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Research/Resolve order exceptions" ;
    bpot:apqcSourceText "Identifying and resolving any exceptions. Address the internal needs/inquiries for materials that cannot be procured immediately. Research inquiries that require the need of exceptional materials." ;
    bpot:hierarchyID "4.2.3.7" ;
    bpot:pcfID "10298" .

bpot:PCF_10299 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10280 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor/Manage supplier information" ;
    bpot:apqcSourceText "Examining procurement and vendor performance. Report delivery timing and the quality of the materials procured through different vendors." ;
    bpot:hierarchyID "4.2.4.1" ;
    bpot:pcfID "10299" .

bpot:PCF_10300 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10280 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare/Analyze procurement and supplier performance" ;
    bpot:apqcSourceText "Assisting the production and inventory processes through the information and reports created. Use the information and metrics of the procurement and vendor performance to enhance or improve the production process." ;
    bpot:hierarchyID "4.2.4.2" ;
    bpot:pcfID "10300" .

bpot:PCF_10301 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10280 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Support inventory and production processes" ;
    bpot:apqcSourceText "Support inventory and production processes by analyzing impact of procurement decisions and collaborating to constantly improve. (For example, perhaps minimum order requirements could be negotiated to be lower, to reduce excessive inventory and make production more flexible.)" ;
    bpot:hierarchyID "4.2.4.3" ;
    bpot:pcfID "10301" .

bpot:PCF_10302 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10280 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor quality of product delivered" ;
    bpot:apqcSourceText "Track the performance of the suppliers on product quality. Use this information to further improve sourcing and supplier performance. " ;
    bpot:hierarchyID "4.2.4.4" ;
    bpot:pcfID "10302" .

bpot:PCF_10306 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10303 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate line level plan" ;
    bpot:apqcSourceText "Initiating the line-level plan for production. Break down the production schedule into specific lines, specifying the various objectives the production schedule." ;
    bpot:hierarchyID "4.3.1.2" ;
    bpot:pcfID "10306" .

bpot:PCF_10307 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10303 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate detailed schedule" ;
    bpot:apqcSourceText "Broadening the line-level plan. Specify all the individual production processes, along with the timing and the duration to come up with a working schedule that tracks the whole process and any deviations that might occur." ;
    bpot:hierarchyID "4.3.1.3" ;
    bpot:pcfID "10307" .

bpot:PCF_10308 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10303 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Schedule production orders and create lots" ;
    bpot:apqcSourceText "Creating a schedule to commence production of orders received, and creating lots to consolidate the processing. Plan when the production orders are to be initiated by commencing the operations for processing products/services. Specify which materials to produce, where to produce them, which operations will facilitate this, and on which date production is to start. Define the size of production lots, demarcating the durations of batch production." ;
    bpot:hierarchyID "4.3.1.4" ;
    bpot:pcfID "10308" .

bpot:PCF_10309 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10303 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Release production orders and create lots" ;
    bpot:apqcSourceText "Initiating the delivery of production orders, and creating lots. Communicate the order that specifies which material to produce, where to produce it, which operations to require, and on which date production takes place. Define how to settle the order costs. Create production lots, which is a particular production unit of an assembly that is planned and manufactured." ;
    bpot:hierarchyID "4.3.1.7" ;
    bpot:pcfID "10309" .

bpot:PCF_10310 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10304 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage raw material inventory" ;
    bpot:apqcSourceText "Administering the inventory of raw materials. Manage the total cost of all component parts in stock but not yet used. Manage the cost of the direct materials (i.e., materials incorporated into the final product) and indirect materials (i.e., materials not incorporated into the final product but consumed during the production process)." ;
    bpot:hierarchyID "4.3.2.1" ;
    bpot:pcfID "10310" .

bpot:PCF_10311 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10304 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute detailed line schedule" ;
    bpot:apqcSourceText "Creating and implementing the detailed line production schedule on the ground level. " ;
    bpot:hierarchyID "4.3.2.2" ;
    bpot:pcfID "10311" .

bpot:PCF_10313 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10304 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Rerun defective items" ;
    bpot:apqcSourceText "Reproducing the items produced defectively. Assess the produced items by conducting quality and standardization tests in order to diagnose any discrepancies. Reproduce defective items." ;
    bpot:hierarchyID "4.3.2.4" ;
    bpot:pcfID "10313" .

bpot:PCF_10314 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10304 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess production performance" ;
    bpot:apqcSourceText "Analyzing and benchmarking the production process to judge its effectiveness and efficiency. Create production metrics to numerically calculate the performance of the production process." ;
    bpot:hierarchyID "4.3.2.6" ;
    bpot:pcfID "10314" .

bpot:PCF_10315 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10303 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan for preventive maintenance" ;
    bpot:apqcSourceText "Scheduling planned maintenance of the production equipment." ;
    bpot:hierarchyID "4.3.1.5" ;
    bpot:pcfID "10315" .

bpot:PCF_10316 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10303 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Request unplanned maintenance" ;
    bpot:apqcSourceText "Scheduling requested maintenance in order to address breakdowns where repairs or corrective remedies are needed immediately. Create a scheme for undertaking unplanned maintenance work on equipment/machinery that has come to be in urgent need for it. Express turnaround to redress using specialized personnel." ;
    bpot:hierarchyID "4.3.1.6" ;
    bpot:pcfID "10316" .

bpot:PCF_10318 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10369 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calibrate test equipment" ;
    bpot:apqcSourceText "Regulating the equipment used for performing quality tests. Assess correspondence between the quality testing equipment and the desired quality standards. Ensure the calibration standard is more accurate than the instrument being tested." ;
    bpot:hierarchyID "4.3.3.1" ;
    bpot:pcfID "10318" .

bpot:PCF_10319 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10304 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report maintenance issues" ;
    bpot:apqcSourceText "Recording and reporting any deviations or issues in the maintenance schedule, in the performance to the production management team, and for unplanned maintenance." ;
    bpot:hierarchyID "4.3.2.3" ;
    bpot:pcfID "10319" .

bpot:PCF_10324 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10320 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process customer request" ;
    bpot:apqcSourceText "Soliciting or acquiring information using various sources such as databases, customer interactions, and customer request forms. Hand them further up the hierarchy to deal with them. Categorize the user's request, determining if the request is supportable and prioritizing the request." ;
    bpot:hierarchyID "6.3.4.1.1" ;
    bpot:pcfID "10324" .

bpot:PCF_10325 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10320 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create customer profile" ;
    bpot:apqcSourceText "Documenting the individual customer service requirements solicited, along with personal information of the customers, in order to generate customized profiles that hasten the delivery process." ;
    bpot:hierarchyID "6.3.4.1.2" ;
    bpot:pcfID "10325" .

bpot:PCF_10326 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10320 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate service order" ;
    bpot:apqcSourceText "Designing a short-term agreement between the service provider and customer. One-time services are ordered by the service recipient and resource-related billing is performed upon completion. Use the service order to document service and customer service work." ;
    bpot:hierarchyID "6.3.4.1.3" ;
    bpot:pcfID "10326" .

bpot:PCF_10327 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10321 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create resourcing plan and schedule" ;
    bpot:apqcSourceText "Developing a plan for sourcing and deploying the resources required to fulfill customer service needs. Document a detailed summary of all types of resources (equipment, finance, personnel, time, etc.) required to complete customer service requests and procure these resources. Identify and assess various sources in order to effectively create a resourcing plan." ;
    bpot:hierarchyID "6.3.4.2.1" ;
    bpot:pcfID "10327" .

bpot:PCF_10328 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10321 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create service order fulfillment schedule" ;
    bpot:apqcSourceText "Designing a detailed summary of customer service order requirements, along with information concerning the timing and duration for these services. Categorize the customer needs. Monitor the services delivered." ;
    bpot:hierarchyID "6.3.4.2.2" ;
    bpot:pcfID "10328" .

bpot:PCF_10330 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10322 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Organize daily service order fulfillment schedule" ;
    bpot:apqcSourceText "Laying out a daily plan of specific service orders that need to be fulfilled. Document and systematically order these activities to ensure high effectiveness and efficiency." ;
    bpot:hierarchyID "6.3.4.3.1" ;
    bpot:pcfID "10330" .

bpot:PCF_10331 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10322 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute product repair" ;
    bpot:apqcSourceText "Dispatching and delivering the resources needed for the specific service requirements from the source/warehouse. Manage the dispatch, transportation, and delivery of the services." ;
    bpot:hierarchyID "6.3.4.3.2" ;
    bpot:pcfID "10331" .

bpot:PCF_10332 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10322 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage service order fulfillment" ;
    bpot:apqcSourceText "Handling and managing orders fulfilled, along with the orders are not or partially fulfilled to track the order fulfillment progress. Use electronic devices such as trackers and GPS in order track and ensure delivery of the orders." ;
    bpot:hierarchyID "6.3.4.3.3" ;
    bpot:pcfID "10332" .

bpot:PCF_10334 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10323 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify completed service orders for feedback" ;
    bpot:apqcSourceText "Determining the service orders that have been successfully delivered. Identify the service orders completed and delivered to the customer. Leverage communication systems to ensure coordination with the customers in order to avoid mishaps." ;
    bpot:hierarchyID "6.3.4.4.1" ;
    bpot:pcfID "10334" .

bpot:PCF_10335 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10323 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify incomplete service orders and service failures" ;
    bpot:apqcSourceText "Determining orders which have not been completed or delivered. Identify the service orders that are partially or entirely incomplete, as well as the orders that have not been delivered to the customer. Use techniques such as project trackers to recognize the progress of the service orders." ;
    bpot:hierarchyID "6.3.4.4.2" ;
    bpot:pcfID "10335" .

bpot:PCF_10336 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10323 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Solicit customer feedback on services delivered" ;
    bpot:apqcSourceText "Obtaining and procuring customer reviews or feedback on the services delivered. Design a customer feedback form, or communicate with the customer through the phone or online." ;
    bpot:hierarchyID "6.3.4.4.3" ;
    bpot:pcfID "10336" .

bpot:PCF_10337 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10323 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process customer feedback on services delivered" ;
    bpot:apqcSourceText "Assessing and incorporating customer reviews/feedback into the service plan to ensure high quality of service. " ;
    bpot:hierarchyID "6.3.4.4.4" ;
    bpot:pcfID "10337" .

bpot:PCF_10343 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10338 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Translate customer service requirements into logistics requirements" ;
    bpot:apqcSourceText "Determining the requirements for managing the flow of things between the point of origin and the point of consumption by assessing the service requirements of the customers." ;
    bpot:hierarchyID "4.4.1.1" ;
    bpot:pcfID "10343" .

bpot:PCF_10344 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10338 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design logistics network" ;
    bpot:apqcSourceText "Developing a network for logistical activities. Create a network of entities through which materials and information flow, encompassing all related activities associated with the flow of transformation of products." ;
    bpot:hierarchyID "4.4.1.2" ;
    bpot:pcfID "10344" .

bpot:PCF_10345 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10338 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate outsourcing needs" ;
    bpot:apqcSourceText "Conveying outsourcing needs within the organization, with the objective of sourcing the assistance required. Define the portion of logistical activities that can be transferred to outside suppliers. Assess third-party agencies to carefully select the most appropriate agencies for outsourcing. Convey these needs to management or the appropriate authority." ;
    bpot:hierarchyID "4.4.1.3" ;
    bpot:pcfID "10345" .

bpot:PCF_10346 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10338 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and maintain delivery service policy" ;
    bpot:apqcSourceText "Establishing rules and regulations, as well as the terms and conditions regarding the delivery of service by the company. Develop a delivery plan that specifies what, how, when, and in which way to deliver services to the customer." ;
    bpot:hierarchyID "4.4.1.4" ;
    bpot:pcfID "10346" .

bpot:PCF_10347 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10338 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Optimize transportation schedules and costs" ;
    bpot:apqcSourceText "Optimizing the schedule and costs of transportation services. Design a logistics strategy by strategically creating delivery routes and systems, which optimizes the overall transportation schedules and costs. Evaluate different transportation sources in order to select the most appropriate and cost-effective sources." ;
    bpot:hierarchyID "4.4.1.5" ;
    bpot:pcfID "10347" .

bpot:PCF_10348 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10338 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define key performance measures" ;
    bpot:apqcSourceText "Establishing measures for evaluating the performance of the logistics strategy of the organization. Establish key performance indicators, including the logistics performance index, delivery in full, and delivery on time." ;
    bpot:hierarchyID "4.4.1.6" ;
    bpot:pcfID "10348" .

bpot:PCF_10349 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20936 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan inbound material receipts" ;
    bpot:apqcSourceText "Managing the receipts of inbound materials. Create a plan accounting for the materials procured from the source of supply and the materials delivered to the distribution center or the warehouse." ;
    bpot:hierarchyID "4.4.2.1" ;
    bpot:pcfID "10349" .

bpot:PCF_10350 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20936 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage inbound material flow" ;
    bpot:apqcSourceText "Managing all the internal activities related to the flow/transfer of materials. Manage materials being delivered to distribution center or warehouse. Gauge the time taken for delivery and if the delivery process is on time. " ;
    bpot:hierarchyID "4.4.2.2" ;
    bpot:pcfID "10350" .

bpot:PCF_10351 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20936 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor inbound delivery performance" ;
    bpot:apqcSourceText "Overseeing the performance of an inbound delivery system. Check the present delivery system's efficiency, cost effectiveness, and adherence to a delivery schedule." ;
    bpot:hierarchyID "4.4.2.3" ;
    bpot:pcfID "10351" .

bpot:PCF_10352 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20936 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage flow of returned products" ;
    bpot:apqcSourceText "Tracking and taking care of the products that have been internally returned either because of their deficiency or in cases of incorrect delivery. " ;
    bpot:hierarchyID "4.4.2.4" ;
    bpot:pcfID "10352" .

bpot:PCF_10353 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage and track inventory deployment" ;
    bpot:apqcSourceText "Tracking the logistical act of delivering or releasing an inventory item or entity to targeted end users. Track how much inventory has been deployed at all the distribution centers, individually." ;
    bpot:hierarchyID "4.4.3.1" ;
    bpot:pcfID "10353" .

bpot:PCF_10354 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Receive, inspect, and store inbound deliveries" ;
    bpot:apqcSourceText "Coordinating the incoming inbound materials/products. Accept the delivery of these materials and the subsequent storage. Track them at the warehouse/distribution center. " ;
    bpot:hierarchyID "4.4.3.2" ;
    bpot:pcfID "10354" .

bpot:PCF_10355 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track product availability" ;
    bpot:apqcSourceText "Keeping track of the availability of different materials/products at the warehouse and distribution centers. " ;
    bpot:hierarchyID "4.4.3.3" ;
    bpot:pcfID "10355" .

bpot:PCF_10356 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Pick, pack, and ship product for delivery" ;
    bpot:apqcSourceText "Packing and shipping the product to deliver to the customer. Take care of the internal and external packaging of the products in order to ensure safe transportation of the products from the warehouse to delivery locations. Notify the ERP system and/or Accounts Receivable Dept." ;
    bpot:hierarchyID "4.4.3.4" ;
    bpot:pcfID "10356" .

bpot:PCF_10357 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track inventory accuracy" ;
    bpot:apqcSourceText "Monitoring any discrepancies between electronic records that represent the inventory and the physical state of the inventory. Look for discrepancies such as phantom inventory, which includes products that an inventory accounting system considers to be available at the storage location but are not actually available." ;
    bpot:hierarchyID "4.4.3.5" ;
    bpot:pcfID "10357" .

bpot:PCF_10358 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track third-party logistics storage and shipping performance" ;
    bpot:apqcSourceText "Keeping a track on the storage and shipping performance of third-party agencies. Monitor logistics storage and shipping performance for third-party agencies. Use measures such as a logistics scoreboard, activity-based costing, economic value analysis, and balanced scorecards." ;
    bpot:hierarchyID "4.4.3.6" ;
    bpot:pcfID "10358" .

bpot:PCF_10359 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage physical finished goods inventory" ;
    bpot:apqcSourceText "Administering the movement of the finished products that are processed by the organization through its warehouses. Track goods through the use of systems such as barcodes in order to monitor the volumes available, quantity of out-flowing goods, remaining shelf life of the product, etc.--ultimately, to best manage the warehouse capacity." ;
    bpot:hierarchyID "4.4.3.7" ;
    bpot:pcfID "10359" .

bpot:PCF_10360 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10341 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan, transport, and deliver outbound product" ;
    bpot:apqcSourceText "Organizing the transportation and delivery of outbound products. Plan and organize the transportation, shipping, and delivery of the end products. Create a plan that specifies dispatch and delivery of the product to its destination, as well the transportation." ;
    bpot:hierarchyID "4.4.4.1" ;
    bpot:pcfID "10360" .

bpot:PCF_10361 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10341 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track carrier delivery performance" ;
    bpot:apqcSourceText "Monitoring delivery performance when carrying products from the warehouse/distribution centers to the retailers or end consumers. Create a performance metrics based on the key performance indicators." ;
    bpot:hierarchyID "4.4.4.2" ;
    bpot:pcfID "10361" .

bpot:PCF_10362 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10341 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage transportation fleet" ;
    bpot:apqcSourceText "Taking care of a range of functions related to the means of transport used for delivering the end products. Manage vehicle financing, vehicle maintenance, vehicle telematics (tracking and diagnostics), driver management, speed management, fuel management, and health and safety management." ;
    bpot:hierarchyID "4.4.4.3" ;
    bpot:pcfID "10362" .

bpot:PCF_10363 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10341 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process and audit carrier invoices and documents" ;
    bpot:apqcSourceText "Organizing and inspecting all account statements and any other documentation for the carriers used in delivery. Create, manage, and inspect all documents related to the financial, regulatory, and administrative accounts of all the carriers/freights. Generate receipts for all freight transactions." ;
    bpot:hierarchyID "4.4.4.4" ;
    bpot:pcfID "10363" .

bpot:PCF_10364 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20094 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Authorize return" ;
    bpot:apqcSourceText "Approving and carrying forward the requests by the customers to return the product. This is part of the process of returning a product in order to receive a refund, replacement, or repair during the product's warranty period." ;
    bpot:hierarchyID "6.2.4.1" ;
    bpot:pcfID "10364" .

bpot:PCF_10366 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20109 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform salvage activities" ;
    bpot:apqcSourceText "Executing activities for reinstating the returned products. Present the customer with additional incentives of compensation in case of any defective products delivery or any discrepancy in the product specifications in order to save the order from being permanently returned." ;
    bpot:hierarchyID "4.4.2.5.2" ;
    bpot:pcfID "10366" .

bpot:PCF_10371 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10368 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish quality targets" ;
    bpot:apqcSourceText "Defining specific qualitative and quantitative target figures." ;
    bpot:hierarchyID "4.1.8.1" ;
    bpot:pcfID "10371" .

bpot:PCF_10372 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10368 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop standard testing procedures" ;
    bpot:apqcSourceText "Creating standard procedures for testing the quality of products/services. Describe the steps of key processes to help ensure consistent and quality output. Define the routine instructions for performing the quality testing activity." ;
    bpot:hierarchyID "4.1.8.2" ;
    bpot:pcfID "10372" .

bpot:PCF_10373 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10368 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate quality specifications" ;
    bpot:apqcSourceText "Communicating the desired quality specifications to the manufacturing units, as well as the distribution centers, to avoid any misunderstanding or misinterpretation." ;
    bpot:hierarchyID "4.1.8.3" ;
    bpot:pcfID "10373" .

bpot:PCF_10374 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10369 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform testing using the standard testing procedure" ;
    bpot:apqcSourceText "Performing testing using calibrated equipment and in consent with the standard testing procedure, including testing time." ;
    bpot:hierarchyID "4.3.3.2" ;
    bpot:pcfID "10374" .

bpot:PCF_10375 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10369 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record test results" ;
    bpot:apqcSourceText "Documenting the results and outcomes of the quality tests. Track the performance of the production process. Record/Document it to evaluate the qualitative efficiency of the production process. Use electronic devices and software in order to ensure effectiveness in recording the results and outcomes of the test." ;
    bpot:hierarchyID "4.3.3.4" ;
    bpot:pcfID "10375" .

bpot:PCF_10376 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10370 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine lot numbering system" ;
    bpot:apqcSourceText "Allotting an identification number to a particular quantity or lot of material manufactured. Assign lot numbers on the basis of specific production units, material similarity, etc. Place lot numbers on the outside of packaging." ;
    bpot:hierarchyID "4.3.4.1" ;
    bpot:pcfID "10376" .

bpot:PCF_10377 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10370 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine lot use" ;
    bpot:apqcSourceText "Identifying the use of production lots. Define where, how, and when to use a specific production lot." ;
    bpot:hierarchyID "4.3.4.2" ;
    bpot:pcfID "10377" .

bpot:PCF_10382 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define customer service policies and procedures" ;
    bpot:apqcSourceText "Outlining the framework of policies and methods for developing customer service strategy. Establish the rules and regulations that serve as a guideline for the customer service strategy. Take into account customer needs and behavior." ;
    bpot:hierarchyID "6.1.4" ;
    bpot:pcfID "10382" .

bpot:PCF_10383 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish target service level for each customer segment" ;
    bpot:apqcSourceText "Determining and implementing levels for customer services. Benchmark certain customer service practices, and base customer level services on those benchmarks. Create a service level agreement, which is a negotiated agreement designed to create a common understanding about services, priorities, and responsibilities." ;
    bpot:hierarchyID "6.1.5" ;
    bpot:pcfID "10383" .

bpot:PCF_10390 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Forecast volume of customer service contacts" ;
    bpot:apqcSourceText "Projecting the total work force required to service customer service inquiries in order to effectively predict the volume of vendor contracts required. Estimate the number of the customer service contracts in an agreed-upon time frame in order to strategically maintain the work force necessitated for customer inquires. Analyze historical data around customer service contracts, the universe of customer inquiries, frequency of inquiries, servicing capability (per head) of the employees, etc." ;
    bpot:hierarchyID "6.2.1.1" ;
    bpot:pcfID "10390" .

bpot:PCF_10391 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Schedule customer service work force" ;
    bpot:apqcSourceText "Deploying the work force to manage customer service contracts. Create a systematic summary of the operations and service required, as well as the specific amount of work force that is to be deployed to the customer service operations. Ensure work force is directly proportional to the estimated forecast of customer service contracts." ;
    bpot:hierarchyID "6.2.1.2" ;
    bpot:pcfID "10391" .

bpot:PCF_10392 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track work force utilization" ;
    bpot:apqcSourceText "Tracking the utilization of work force deployed for managing customer service operations. Monitor the utility of the work force deployed for managing customer service operations in order to evaluate its efficiency and cost effectiveness. Calculate the overall labor effectiveness, which measures the utility, performance, and quality of the work force." ;
    bpot:hierarchyID "6.2.1.3" ;
    bpot:pcfID "10392" .

bpot:PCF_10393 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and evaluate quality of customer interactions with customer service representatives" ;
    bpot:apqcSourceText "Tracking and determining the quality of interactions between the customer and customer representatives. Use electronic devices to record and effectively assess customer representatives' interactions. " ;
    bpot:hierarchyID "6.2.1.4" ;
    bpot:pcfID "10393" .

bpot:PCF_10394 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10388 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Receive customer problems, requests, and inquiries" ;
    bpot:apqcSourceText "Receiving requests for information from customers over multiple channels. Receive various requests and inquiries from customers regarding products/services. Accept these inquiries through channels such as email, telephone, online forms, text messages, social media, and in person. Supply dedicated equipment, systems, and personnel." ;
    bpot:hierarchyID "6.2.2.1" ;
    bpot:pcfID "10394" .

bpot:PCF_10395 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10388 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Resolve customer problems, requests, and inquiries" ;
    bpot:apqcSourceText "Routing customer inquiries in order to service them with the most apposite response. Direct customer inquires to the best suited personnel or system. Have a system or procedure capable of efficiently channeling these requests." ;
    bpot:hierarchyID "6.2.2.3" ;
    bpot:pcfID "10395" .

bpot:PCF_10396 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10388 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Respond to customer problems, requests, and inquiries" ;
    bpot:apqcSourceText "Responding to customer requests by email, conversation, interactive voice response, mail, etc. with the most appropriate reply. Instill a robust process to locate the right information for a solution to a customer's problem." ;
    bpot:hierarchyID "6.2.2.4" ;
    bpot:pcfID "10396" .

bpot:PCF_10397 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10389 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Receive customer complaints" ;
    bpot:apqcSourceText "Receiving any complaints or grievances from customers for the organization's products/services. Receive objections, complaints, and criticism from customers regarding products/services through email, telephone, online forms, text messages, social media, in person, etc. Dedicate equipment, systems, and personnel." ;
    bpot:hierarchyID "6.2.3.1" ;
    bpot:pcfID "10397" .

bpot:PCF_10398 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10389 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Route customer complaints" ;
    bpot:apqcSourceText "Routing any complaints or grievances received from customers in order to address them in the most appropriate manner. Direct complaints to the best suited personnel or system. Implement a system or procedure capable of efficiently channeling the various objections, complaints, and criticism from customers over the offerings provided by the organization." ;
    bpot:hierarchyID "6.2.3.2" ;
    bpot:pcfID "10398" .

bpot:PCF_10399 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10389 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Resolve customer complaints" ;
    bpot:apqcSourceText "Resolving any customer complaints that are deemed to be sound and reasonable. Redress any objections, grievances, and complaints received from customers regarding the offerings provided by the organization. Identify the legitimate complaints, where the situation needs to be appropriately corrected. Deploy personnel who can rectify the issue within a stipulated time frame." ;
    bpot:hierarchyID "6.2.3.3" ;
    bpot:pcfID "10399" .

bpot:PCF_10400 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10389 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Respond to customer complaints" ;
    bpot:apqcSourceText "Responding to customer complaints including all activities necessitated to service any objections, complaints, or grievances with the most appropriate reply. Source the right information to formulate a response that eases the discomfort being experienced by the customer. (Closely coordinate with Resolve customer complaints [10399].)" ;
    bpot:hierarchyID "6.2.3.4" ;
    bpot:pcfID "10400" .

bpot:PCF_10418 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify strategic HR needs" ;
    bpot:apqcSourceText "Strategically defining the current and future needs for developing an efficient HR strategy. " ;
    bpot:hierarchyID "7.1.1.1" ;
    bpot:pcfID "10418" .

bpot:PCF_10419 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define HR and business function roles and accountability" ;
    bpot:apqcSourceText "Outlining the charge and duty of the HR function by defining its responsibility areas, as well as ensuring its accountability. Establish the HR function by laying out the roles and responsibilities for this function and the rules and regulations guiding HR. Define the goals and objectives of the HR, as well as a mission and vision for this function. Create a mechanism involving a set of policies, code of conduct, and institutional procedure to ensure HR accountability." ;
    bpot:hierarchyID "7.1.1.2" ;
    bpot:pcfID "10419" .

bpot:PCF_10420 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine HR costs" ;
    bpot:apqcSourceText "Ascertaining the costs and expenses of the HR function. Identify and report HR investments using, for example, a cost approach or a present value of future earnings approach." ;
    bpot:hierarchyID "7.1.1.5" ;
    bpot:pcfID "10420" .

bpot:PCF_10421 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish HR measures" ;
    bpot:apqcSourceText "Evaluating the performance of HR function. Lay out the course of HR procedures that would formulate a plan of action needed to fulfill strategic HR needs. Deploy measures such as hiring policies, leave management, internal code of conducts, and compensation structure." ;
    bpot:hierarchyID "7.1.1.6" ;
    bpot:pcfID "10421" .

bpot:PCF_10422 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate HR strategies" ;
    bpot:apqcSourceText "Conveying the strategies of HR function to employees and management. Effectively explain the vision, plans, and anticipated benefits of the HR strategy employees, as well as the public. Develop statements and messages that are easy to read, informative, and relevant to the audience." ;
    bpot:hierarchyID "7.1.1.7" ;
    bpot:pcfID "10422" .

bpot:PCF_10423 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform workforce planning" ;
    bpot:apqcSourceText "Evaluating the current and future skill requirements of the organization with regard to the overall corporate strategy of the organization and market conditions. Identify and establish the minimum skills needed for the requisite HR needs." ;
    bpot:hierarchyID "7.1.2.1" ;
    bpot:pcfID "10423" .

bpot:PCF_10424 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform operational workforce planning" ;
    bpot:apqcSourceText "Determining the requirements for employees and the need for employee resourcing for each every unit/function. Lay out a plan detailing employee resourcing requirements of individual functions and the organization as a whole." ;
    bpot:hierarchyID "7.1.2.2" ;
    bpot:pcfID "10424" .

bpot:PCF_10426 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop succession plan" ;
    bpot:apqcSourceText "Creating and implementing the plan for continuation of key positions within the organization. Identify internal people with the potential to fill key business leadership positions. Provide critical development experiences to employees who can move into important roles. Engage leaders to support the development of high-potential leaders." ;
    bpot:hierarchyID "7.1.2.4" ;
    bpot:pcfID "10426" .

bpot:PCF_10427 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop diversity, equity, and inclusion plan" ;
    bpot:apqcSourceText "Creating and implementing the plan for ensuring a diverse work force. Develop and hire employees with varying characteristics including, but not limited to, religious and political beliefs, gender, ethnicity, education, socioeconomic background, sexual orientation, and geographic location." ;
    bpot:hierarchyID "7.1.2.6" ;
    bpot:pcfID "10427" .

bpot:PCF_10428 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop other HR programs" ;
    bpot:apqcSourceText "Creating HR programs and services such as employee engagements programs to promote positive employee behavior. Create a variety of programs and services to support employees' professional and personal needs at work and at home." ;
    bpot:hierarchyID "7.1.2.10" ;
    bpot:pcfID "10428" .

bpot:PCF_10429 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop HR policies" ;
    bpot:apqcSourceText "Creating rules and regulations that govern the HR function. Develop a policy plan that serves as a guideline for setting rules and regulations that help in achieving the HR goals and objectives." ;
    bpot:hierarchyID "7.1.2.11" ;
    bpot:pcfID "10429" .

bpot:PCF_10430 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Administer HR policies" ;
    bpot:apqcSourceText "Ensuring rules and regulations are followed and are flexible enough to accommodate indispensable deviations." ;
    bpot:hierarchyID "7.1.2.12" ;
    bpot:pcfID "10430" .

bpot:PCF_10431 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan employee benefits" ;
    bpot:apqcSourceText "Planning benefits in kind (also called fringe benefits, perquisites, or perks). Include various types of non-wage compensations provided to employees in addition to normal wages or salaries." ;
    bpot:hierarchyID "7.1.2.13" ;
    bpot:pcfID "10431" .

bpot:PCF_10432 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop strategy for HR systems/technologies/tools" ;
    bpot:apqcSourceText "Creating a strategy for the use of systems/technologies/tools in operating the HR function. Create a strategy concerning the use and utility of HR support tools and technologies. Decide what specific tools to use and in what quantity. Determine the levels of technology required for the HR management." ;
    bpot:hierarchyID "7.1.1.8" ;
    bpot:pcfID "10432" .

bpot:PCF_10433 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop workforce strategy models" ;
    bpot:apqcSourceText "Creating and implementing models for effectively strategizing the work force of the organization. Develop a model that specifies the organization's overall approach for maximizing the performance of its work force by defining the goals, objectives, and expectations of the work force. Manage all aspects of performance required for the work force to function, including recruitment, selection, retention, and professional development." ;
    bpot:hierarchyID "7.1.2.14" ;
    bpot:pcfID "10433" .

bpot:PCF_10434 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10417 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure realization of objectives" ;
    bpot:apqcSourceText "Determining the accomplishment of HR goals and objectives. Evaluate the effectiveness of the HR function by estimating the present rate of achievement of the established objectives. Use metrics to determine if the objectives are being realized. Leverage measures such as turnover, training, return on human capital, costs of labor, and expenses per employee." ;
    bpot:hierarchyID "7.1.3.1" ;
    bpot:pcfID "10434" .

bpot:PCF_10435 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10417 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure contribution to business strategy" ;
    bpot:apqcSourceText "Determining the role of HR function in implementing the organizational strategy. Measure the correlation between the HR performance and the overall business strategy. Calculate the amount of contribution of the HR function to the overall business growth." ;
    bpot:hierarchyID "7.1.3.2" ;
    bpot:pcfID "10435" .

bpot:PCF_10436 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10417 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate plans and provide updates to stakeholders" ;
    bpot:apqcSourceText "Conveying the plans for HR function to stakeholders. Ensure that the HR plans and strategy are effectively communicated to the people who can affect or be affected by the organization's actions, objectives, and policies such as the creditors, shareholders, employees, and suppliers. Provide regular updates to these stakeholders to ensure effective communication." ;
    bpot:hierarchyID "7.1.3.3" ;
    bpot:pcfID "10436" .

bpot:PCF_10438 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10417 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review and revise HR plans" ;
    bpot:apqcSourceText "Reassessing the strategies, plans, and policies of the HR function, with the objective of revising them. Revisit the schematic plans for the HR function. Taking stock of any suggestions or feedback from the stakeholders, revamp the blueprint of HR strategies and plans." ;
    bpot:hierarchyID "7.1.3.4" ;
    bpot:pcfID "10438" .

bpot:PCF_10445 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Align staffing plan to work force plan and business unit strategies/resource needs" ;
    bpot:apqcSourceText "Creating a correspondence between the plan for hiring new employees and the desired employee requirements. Staff an adequate amount of people with the appropriate skills to effectively accomplish its legislative, regulatory, service, and production requirements." ;
    bpot:hierarchyID "7.2.1.1" ;
    bpot:pcfID "10445" .

bpot:PCF_10446 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Open job requisitions" ;
    bpot:apqcSourceText "Developing specific job requisitions, and ensuring their accessibility. Create and open a job requisition to fill the vacant positions within the organization. Clearly describe the job title, department, fill date, and the requisite skills and qualifications for the job." ;
    bpot:hierarchyID "7.2.1.3" ;
    bpot:pcfID "10446" .

bpot:PCF_10447 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and maintain job descriptions" ;
    bpot:apqcSourceText "Creating descriptions for job requisitions. Define the normal components of a job description, such as the overall position description with general areas of responsibility listed, essential functions of the job described with a couple of examples of each, required knowledge, skills, abilities, required education and experience, a description of the physical demands, and a description of the work environment." ;
    bpot:hierarchyID "7.2.1.2" ;
    bpot:pcfID "10447" .

bpot:PCF_10448 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Post job requisitions" ;
    bpot:apqcSourceText "Posting and advertising job descriptions. Display open job descriptions internally and externally. Use public portals, online portals, and websites to upload these requisitions in order for applications to be received." ;
    bpot:hierarchyID "7.2.1.4" ;
    bpot:pcfID "10448" .

bpot:PCF_10450 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Modify job requisitions" ;
    bpot:apqcSourceText "Making the necessary alterations to job requisitions. Revamp or revise the job requisitions in case a position is filled or is not vacant anymore, as well as in case of any new openings. (It involves Manage the internal/external job posting websites [10449] to make the necessary changes.)" ;
    bpot:hierarchyID "7.2.1.5" ;
    bpot:pcfID "10450" .

bpot:PCF_10451 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Notify hiring manager" ;
    bpot:apqcSourceText "Informing and communicating with the hiring manager. Notify the manager responsible for the hiring process in cases of any new position openings or changes." ;
    bpot:hierarchyID "7.2.1.6" ;
    bpot:pcfID "10451" .

bpot:PCF_10452 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage requisition dates" ;
    bpot:apqcSourceText "Determining and managing the dates for the employee requisition process. " ;
    bpot:hierarchyID "7.2.1.7" ;
    bpot:pcfID "10452" .

bpot:PCF_10453 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10440 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine recruitment methods and channels" ;
    bpot:apqcSourceText "Defining the methods and channels for recruitments in order to maximize the amount of candidate availability. Use channels such as headhunting, job postings, job portals, networking websites, and media advertising. Choose from the various methods of recruitment such as internal/external third-party sourcing." ;
    bpot:hierarchyID "7.2.2.1" ;
    bpot:pcfID "10453" .

bpot:PCF_10454 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10440 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform recruiting activities/events" ;
    bpot:apqcSourceText "Organizing and executing recruiting activities and events. Activities and events include on-campus hiring, refresher courses, information sessions, career fairs, etc. to increase the coverage of the sourcing in order to ensure that the most deserving and appropriate candidates are hired." ;
    bpot:hierarchyID "7.2.2.2" ;
    bpot:pcfID "10454" .

bpot:PCF_10455 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10440 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage recruitment vendors" ;
    bpot:apqcSourceText "Establishing and maintaining relationships with recruitment vendors (suppliers). Create and maintain relationships with third-party agencies such as staffing and firms to expand. Use these relationships to implement the sourcing process effectively." ;
    bpot:hierarchyID "7.2.2.3" ;
    bpot:pcfID "10455" .

bpot:PCF_10456 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and deploy candidate selection tools" ;
    bpot:apqcSourceText "Identifying and implementing tools for the selection of candidates. Recognize candidate selection tools such as screening, telephone interviews, hiring manager interviews, drug testing, and skills assessment. Effectively deploy these tools to check if the candidates fit in the workplace or not, as well as to ensure workplace safety." ;
    bpot:hierarchyID "7.2.3.1" ;
    bpot:pcfID "10456" .

bpot:PCF_10457 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Interview candidates" ;
    bpot:apqcSourceText "Assessing the candidates by their performance in the interviews. Conduct HR interview, technical interview, hiring manager interview, etc. Understand the mindset of the candidate, and comprehend his/her personal and professional lives." ;
    bpot:hierarchyID "7.2.3.2" ;
    bpot:pcfID "10457" .

bpot:PCF_10458 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Test candidates" ;
    bpot:apqcSourceText "Examining the candidates through tests. Prepare tools such as aptitude, technical, and grammar tests. Test the skills of the candidate through a written, oral, or computerized test." ;
    bpot:hierarchyID "7.2.3.3" ;
    bpot:pcfID "10458" .

bpot:PCF_10459 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20123 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select and reject candidates" ;
    bpot:apqcSourceText "Approving the deserving candidates, and rejecting the others. Examining the performance of candidates. Ensure candidates would fit well with the organization. (Assess performance from Interview candidates [10457] and Test candidates [10458].)" ;
    bpot:hierarchyID "7.2.3.4" ;
    bpot:pcfID "10459" .

bpot:PCF_10460 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10444 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Obtain candidate background information" ;
    bpot:apqcSourceText "Conducting a background investigation on the candidates with the objective of looking up and compiling criminal, commercial, and financial records." ;
    bpot:hierarchyID "7.2.5.1" ;
    bpot:pcfID "10460" .

bpot:PCF_10463 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10443 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Draw up and make offer" ;
    bpot:apqcSourceText "Compiling job-related information for the selected candidates in order to make up a job. Include information about the job description, reporting relationship, salary, bonus potential, benefits, and vacation allotment." ;
    bpot:hierarchyID "7.2.4.1" ;
    bpot:pcfID "10463" .

bpot:PCF_10464 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10443 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Negotiate offer" ;
    bpot:apqcSourceText "Negotiating an offer with selected candidates. Discuss the job offer with the candidate to ensure a mutual understanding. " ;
    bpot:hierarchyID "7.2.4.2" ;
    bpot:pcfID "10464" .

bpot:PCF_10465 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10443 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Hire candidate" ;
    bpot:apqcSourceText "Wrapping up the process for hiring candidates. Agree to all hiring terms and conditions. Have the candidate accept and sign the job offer. " ;
    bpot:hierarchyID "7.2.4.3" ;
    bpot:pcfID "10465" .

bpot:PCF_10466 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10444 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create applicant record" ;
    bpot:apqcSourceText "Creating and documenting the records of all applicants. Manage all individual applicants, including hires and non-hires. Maintain records to avoid any duplication and promote efficiency." ;
    bpot:hierarchyID "7.2.5.2" ;
    bpot:pcfID "10466" .

bpot:PCF_10468 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10444 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Archive and retain records of non-hires" ;
    bpot:apqcSourceText "Retaining and storing the records of the candidates who were rejected and not hired to ensure future availability in case the need arises. Create a centralized repository of profiles. Label these records in order to readily identify them. Add remarks for any future consideration." ;
    bpot:hierarchyID "7.2.5.4" ;
    bpot:pcfID "10468" .

bpot:PCF_10477 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10474 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop employee induction program" ;
    bpot:apqcSourceText "Designing a program to systematically introduce newly hired employees to the organizational culture of the company." ;
    bpot:hierarchyID "7.3.1.1.1" ;
    bpot:pcfID "10477" .

bpot:PCF_10478 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10474 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain/Update employee induction program" ;
    bpot:apqcSourceText "Managing the orientation and training of new employees about the organizational culture of the company." ;
    bpot:hierarchyID "7.3.1.1.2" ;
    bpot:pcfID "10478" .

bpot:PCF_10479 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10470 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define employee performance objectives" ;
    bpot:apqcSourceText "Outlining the objectives for employee performance. Establish key performance objectives and measures such as customer-focus objectives, financially focused objectives, and employee growth objectives." ;
    bpot:hierarchyID "7.3.2.1" ;
    bpot:pcfID "10479" .

bpot:PCF_10481 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10470 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate and review performance program" ;
    bpot:apqcSourceText "Assessing and revamping performance programs, including the instruments used to measure employee performance standards. Review and upgrade these performance programs to avoid any deprivations and ensure effectiveness." ;
    bpot:hierarchyID "7.3.2.4" ;
    bpot:pcfID "10481" .

bpot:PCF_10483 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17052 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage labor relations" ;
    bpot:apqcSourceText "Managing labor relations, the collective bargaining process, and the relationships between the labor and management. Take care of employee grievances." ;
    bpot:hierarchyID "7.4.1" ;
    bpot:pcfID "10483" .

bpot:PCF_10484 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17052 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage collective bargaining process" ;
    bpot:apqcSourceText "Managing any negotiations between an employer and a group of employees that determine the conditions of employment. Engage employees to reach agreements in regulating working conditions. " ;
    bpot:hierarchyID "7.4.2" ;
    bpot:pcfID "10484" .

bpot:PCF_10485 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17052 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage labor management partnerships" ;
    bpot:apqcSourceText "Handling partnerships between labor and management. Develop a lasting two-way relationship that is beneficial for the labor, management, and the organization." ;
    bpot:hierarchyID "7.4.3" ;
    bpot:pcfID "10485" .

bpot:PCF_10487 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define employee development guidelines" ;
    bpot:apqcSourceText "Outlining the guidelines for development of employees. Design development policies and procedures to identify areas of growth for employees, either in their current position or in preparation for future roles. Include topics related to knowledge and skill development." ;
    bpot:hierarchyID "7.3.3.1" ;
    bpot:pcfID "10487" .

bpot:PCF_10488 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop employee career plans and career paths" ;
    bpot:apqcSourceText "Designing a future career path for the employees that encourages them to explore and gather information. " ;
    bpot:hierarchyID "7.3.3.2" ;
    bpot:pcfID "10488" .

bpot:PCF_10490 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10473 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Align employee with organization development needs" ;
    bpot:apqcSourceText "Aligning the needs of the employees to development needs." ;
    bpot:hierarchyID "7.3.4.1" ;
    bpot:pcfID "10490" .

bpot:PCF_10491 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10473 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Align learning programs with competencies and skills" ;
    bpot:apqcSourceText "Aligning the learning programs with the core capabilities and competencies of the organization. Contextualize the training programs so that employees can expand their knowledge base and add new skills in line with the core competencies of the organization." ;
    bpot:hierarchyID "7.3.4.3" ;
    bpot:pcfID "10491" .

bpot:PCF_10492 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10473 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish training needs by analysis of required and available skills" ;
    bpot:apqcSourceText "Determining the training necessitated by business processes, using an examination of skill sets that are needed by the organization and those already possessed. Examine the various skills required by individual employees. Design training in light of the availability of resources to provide specific segments of training." ;
    bpot:hierarchyID "7.3.4.4" ;
    bpot:pcfID "10492" .

bpot:PCF_10493 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10473 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop, conduct, and manage employee and/or management training programs" ;
    bpot:apqcSourceText "Creating, implementing, and managing the programs for training employees. Create and design sessions on the basis of the needs and the availability of the skills. Conduct the sessions on the ground. Manage all aspects related to the training programs. Consider including literacy training, interpersonal skills training, technical training, problem-solving training, diversity or sensitivity training, etc." ;
    bpot:hierarchyID "7.3.4.5" ;
    bpot:pcfID "10493" .

bpot:PCF_10497 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10412 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Administer payroll" ;
    bpot:apqcSourceText "Managing the sum of all financial records of salaries for an employee, including wages, bonuses, and deductions. Use a payroll management system to deal with the financial aspects of employees' salaries, allowances, deductions, gross pay, net pay, etc. Generate pay slips for a specific period." ;
    bpot:hierarchyID "7.5.4" ;
    bpot:pcfID "10497" .

bpot:PCF_10498 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop salary/compensation structure and plan" ;
    bpot:apqcSourceText "Creating the framework for the provision of salary/compensation to employees. Break down the salary structure into different components such as fixed pay, variable pay, bonus, and allowances such medical allowance, and rent allowance, etc. Develop, adjust, and maintain a pay structure." ;
    bpot:hierarchyID "7.5.1.1" ;
    bpot:pcfID "10498" .

bpot:PCF_10499 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop benefits and rewards plan" ;
    bpot:apqcSourceText "Developing a plan for provision of rewards, commission, and benefits to employees. Plan health benefits, retirement benefits, non-monetary benefits, etc." ;
    bpot:hierarchyID "7.5.1.2" ;
    bpot:pcfID "10499" .

bpot:PCF_10500 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform competitive analysis of benefits and rewards" ;
    bpot:apqcSourceText "Analyzing and evaluating the organization's benefits and rewards plan. Compare/Benchmark the benefits and employees plan with other organizations to adhere to industry standard practices." ;
    bpot:hierarchyID "7.5.1.3" ;
    bpot:pcfID "10500" .

bpot:PCF_10501 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify compensation requirements based on financial, benefits, and HR policies" ;
    bpot:apqcSourceText "Recognizing the employee requirements for compensation on the basis of the financial, benefits, and HR policies of the organization. Recognize individual compensation requirements regarding the financial policies of the organization. Consider the benefits plan and overall HR policies while selecting compensation requirements." ;
    bpot:hierarchyID "7.5.1.4" ;
    bpot:pcfID "10501" .

bpot:PCF_10502 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Administer compensation and rewards to employees" ;
    bpot:apqcSourceText "Managing the provision of compensations and rewards to the employees while maintaining consistency with the compensation and benefits plan. Follow the compensation and benefits plan rigorously in order to avoid any discrepancies." ;
    bpot:hierarchyID "7.5.1.5" ;
    bpot:pcfID "10502" .

bpot:PCF_10503 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reward and motivate employees" ;
    bpot:apqcSourceText "Rewarding and stimulating the performance efforts of employees. Create methods for motivating employees. Spur extrinsic and intrinsic motivation." ;
    bpot:hierarchyID "7.5.1.6" ;
    bpot:pcfID "10503" .

bpot:PCF_10504 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10495 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver employee benefits program" ;
    bpot:apqcSourceText "Implementing the programs that specify employee benefits, other than salary provided, such as those concerning medical care, death, and disability." ;
    bpot:hierarchyID "7.5.2.1" ;
    bpot:pcfID "10504" .

bpot:PCF_10505 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10495 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Administer benefit enrollment" ;
    bpot:apqcSourceText "Handling the employee enrollment for obtaining benefits. Manage employee enrollment and eligibility. Encourage employees to enroll for benefits." ;
    bpot:hierarchyID "7.5.2.2" ;
    bpot:pcfID "10505" .

bpot:PCF_10506 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10495 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process claims" ;
    bpot:apqcSourceText "Processing any formal requests or demands made by the employees claiming that they have earned some benefits. Send the request further up the managerial hierarchy to ensure approval." ;
    bpot:hierarchyID "7.5.2.3" ;
    bpot:pcfID "10506" .

bpot:PCF_10507 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10495 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform benefit reconciliation" ;
    bpot:apqcSourceText "Carrying out reconciliation of benefits delivered to employees. Compare the estimated benefit requirement made by the employee and the actual amount of benefits the employee is entitled to receive." ;
    bpot:hierarchyID "7.5.2.4" ;
    bpot:pcfID "10507" .

bpot:PCF_10509 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop family support systems" ;
    bpot:apqcSourceText "Creating a support structure that aligns with local and federal laws that allow for support for families. This could include things like maternity leave, care for a family member, or in some cases, extended sick leave." ;
    bpot:hierarchyID "7.5.3.2" ;
    bpot:pcfID "10509" .

bpot:PCF_10510 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review retention and motivation indicators" ;
    bpot:apqcSourceText "Reassessing the indicators for retention and motivation of employees. Monitor the indicators that signal the levels of motivation and retention. Regularly update and upgrade indicators to avoid depreciation and ensure high efficiency." ;
    bpot:hierarchyID "7.5.1.7" ;
    bpot:pcfID "10510" .

bpot:PCF_10511 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21438 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review compensation plan" ;
    bpot:apqcSourceText "Analyzing existing compensation plans and making changes necessary to continue to retain employees. " ;
    bpot:hierarchyID "7.5.1.8" ;
    bpot:pcfID "10511" .

bpot:PCF_10512 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage promotion and demotion process" ;
    bpot:apqcSourceText "Administering the process of promoting and demoting employees. Design a system for advancing or demoting an employee's rank or position. Leverage techniques such as horizontal promotion, vertical promotion, dry promotion, and involuntary/voluntary demotion." ;
    bpot:hierarchyID "7.6.1" ;
    bpot:pcfID "10512" .

bpot:PCF_10513 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage separation" ;
    bpot:apqcSourceText "Managing the process of employee separation, including resignations, discharges, and layoffs. Inform the employee of the termination. Complete paperwork for continuation of benefits." ;
    bpot:hierarchyID "7.6.2" ;
    bpot:pcfID "10513" .

bpot:PCF_10514 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage retirement" ;
    bpot:apqcSourceText "Managing and administering instances where a person stops employment completely." ;
    bpot:hierarchyID "7.6.3" ;
    bpot:pcfID "10514" .

bpot:PCF_10515 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage leave of absence" ;
    bpot:apqcSourceText "Managing the period of time that an employee must be away from their primary job, while maintaining the status of employee (i.e., paid and unpaid leave of absence but not vacations, holidays, hiatuses, sabbaticals, and work-from-home programs)." ;
    bpot:hierarchyID "7.6.4" ;
    bpot:pcfID "10515" .

bpot:PCF_10516 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and implement employee outplacement" ;
    bpot:apqcSourceText "Helping former employees transition to new jobs or to re-orient themselves in the job market. Deliver help through one-on-one sessions or in a group format. Provide guidance in career evaluation, resume writing, interview preparation, developing networks, and job searching." ;
    bpot:hierarchyID "7.6.5" ;
    bpot:pcfID "10516" .

bpot:PCF_10517 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20132 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage resource deployment" ;
    bpot:apqcSourceText "Allocating employees. Deploy personnel to ensure that the labor of the organization is continuously in an optimal relation to the jobs and organizational structure. " ;
    bpot:hierarchyID "7.6.6.2" ;
    bpot:pcfID "10517" .

bpot:PCF_10520 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17055 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage expatriates" ;
    bpot:apqcSourceText "Managing foreign resources. Manage employees who are sent to live abroad for a defined time period, as well as non-native employees." ;
    bpot:hierarchyID "7.6.7.1" ;
    bpot:pcfID "10520" .

bpot:PCF_10522 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage reporting processes" ;
    bpot:apqcSourceText "Providing information and reports regarding employees to management." ;
    bpot:hierarchyID "7.7.1" ;
    bpot:pcfID "10522" .

bpot:PCF_10523 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee inquiry process" ;
    bpot:apqcSourceText "Handling instances where an employee believes that he/she has been inappropriately treated or he/she desires clarification. Encourage employees to inquire when needed. Record and clarify the issues for which the enquiry has been made." ;
    bpot:hierarchyID "7.7.2" ;
    bpot:pcfID "10523" .

bpot:PCF_10524 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage and maintain employee data" ;
    bpot:apqcSourceText "Capturing and updating employee information and data and information on the employees. " ;
    bpot:hierarchyID "7.7.3" ;
    bpot:pcfID "10524" .

bpot:PCF_10525 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage human resource information systems HRIS" ;
    bpot:apqcSourceText "Administering and maintaining HR information systems that take care of activities related to HR, accounting, management, and payroll." ;
    bpot:hierarchyID "7.7.4" ;
    bpot:pcfID "10525" .

bpot:PCF_10526 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage employee measures" ;
    bpot:apqcSourceText "Creating and maintaining performance metrics for employees. Create and manage a strategic system of data and statistics to accurately gauge each employee's information. Consider productivity metrics, efficiency metrics, training metrics, etc." ;
    bpot:hierarchyID "7.7.5" ;
    bpot:pcfID "10526" .

bpot:PCF_10527 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage time and attendance systems" ;
    bpot:apqcSourceText "Developing and maintaining systems for managing the time and attendance of employees. Routinely upgrade the process and systems that track when employees start and stop work, the department where the work is performed, attendance in addition to tracking meals and breaks, the type of work performed, and the number of items produced." ;
    bpot:hierarchyID "7.7.6" ;
    bpot:pcfID "10527" .

bpot:PCF_10529 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21451 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop employee communication plan" ;
    bpot:apqcSourceText "Creating a plan for managing communication among employees. Inform employees of direction. Counter resistance with change management approaches. Seek specific areas of input to the decision-making process. Seek varying degrees of involvement and co-creation." ;
    bpot:hierarchyID "7.8.1" ;
    bpot:pcfID "10529" .

bpot:PCF_10530 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage/Collect employee suggestions and perform employee research" ;
    bpot:apqcSourceText "Procuring and handling suggestions from employees, and performing research on employees. Manage and analyze the programs that help the organization to tap into employee ideas for improving the organization's processes and/or products. Use surveys, focus groups, and other data-gathering methods to find out the attitudes, opinions, and feelings of members of an organization." ;
    bpot:hierarchyID "7.7.9" ;
    bpot:pcfID "10530" .

bpot:PCF_10531 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17052 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee grievances" ;
    bpot:apqcSourceText "Taking care or resolving any complaint raised by an employee by procedures provided for in a collective agreement, an employment contract, or by other mechanisms established by an employer." ;
    bpot:hierarchyID "7.4.4" ;
    bpot:pcfID "10531" .

bpot:PCF_10532 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21451 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver employee communications" ;
    bpot:apqcSourceText "Implementing the communication plan for employees. Initiate dialogues and engagement by monitoring the exchange of ideas and opinions, the development of personal relationships, etc." ;
    bpot:hierarchyID "7.8.3" ;
    bpot:pcfID "10532" .

bpot:PCF_10767 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10737 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor international rates" ;
    bpot:apqcSourceText "Forecasting and monitoring changes in foreign currency value or interest rates around the world that play an important role in the organization." ;
    bpot:hierarchyID "9.10.1" ;
    bpot:pcfID "10767" .

bpot:PCF_10768 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10737 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage transactions" ;
    bpot:apqcSourceText "Managing any transfer of funds in the course of conducting cross-border trades or investments, including conversion across currencies. Find the most suitable alternative for making payments, while saving taxes and avoiding any unwarranted regulation, with the objective of protecting capital." ;
    bpot:hierarchyID "9.10.2" ;
    bpot:pcfID "10768" .

bpot:PCF_10769 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10737 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor currency exposure/hedge currency" ;
    bpot:apqcSourceText "Assessing exposure to potential financial losses as a result of changes in the value of currencies. Forecast the impact of movements in foreign currency values. Enter into financial transactions designed to offset or limit potential exposure to loss." ;
    bpot:hierarchyID "9.10.3" ;
    bpot:pcfID "10769" .

bpot:PCF_10770 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10737 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report results" ;
    bpot:apqcSourceText "Documenting and reporting accounting entries to formally report financial gains or losses experienced as a result of foreign exchange activity." ;
    bpot:hierarchyID "9.10.4" ;
    bpot:pcfID "10770" .

bpot:PCF_10771 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10738 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and maintain budget policies and procedures" ;
    bpot:apqcSourceText "Formulating financial budgetary guidelines and strategies. Develop a framework for rules and regulations regarding budgets. Create a step-by-step process to achieve financial goals. " ;
    bpot:hierarchyID "9.1.1.1" ;
    bpot:pcfID "10771" .

bpot:PCF_10772 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10738 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare periodic budgets and plans" ;
    bpot:apqcSourceText "Creating reports on a quarterly or annual basis for fund allocation. Create a financial statement that estimates revenues and expenses over a specific period of time. (Leverage budget methods such as cost-based and zero-based budgeting techniques, in light of the periodic targets outlined during Develop and maintain budget policies and procedures [10771].)" ;
    bpot:hierarchyID "9.1.1.2" ;
    bpot:pcfID "10772" .

bpot:PCF_10773 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10738 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare periodic financial forecasts" ;
    bpot:apqcSourceText "Creating estimates of the projected income and expenses required over a predetermined time frame. Develop the projections of profit and loss statements, balance sheets, and the cash flow forecast." ;
    bpot:hierarchyID "9.1.1.4" ;
    bpot:pcfID "10773" .

bpot:PCF_10774 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10739 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform inventory accounting" ;
    bpot:apqcSourceText "Conducting accounting for assets, and finding reasons for changes (depreciation, obsolescence, deterioration, change in customer taste, increased demand, decreased market supply, etc.)." ;
    bpot:hierarchyID "9.1.2.1" ;
    bpot:pcfID "10774" .

bpot:PCF_10775 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10739 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform cost of sales analysis" ;
    bpot:apqcSourceText "Studying expenses directly associated with product. Analyze the cost of sales, which is the cost of manufacturing products." ;
    bpot:hierarchyID "9.1.2.3" ;
    bpot:pcfID "10775" .

bpot:PCF_10776 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10739 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform product costing" ;
    bpot:apqcSourceText "Studying and finding out the relevant cost center for a product by studying every resource used in its making." ;
    bpot:hierarchyID "9.1.2.4" ;
    bpot:pcfID "10776" .

bpot:PCF_10777 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10739 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform variance analysis" ;
    bpot:apqcSourceText "Discovering the changes between forecasted and actual costing. Analyze actual and planned behavior by reviewing the amount of a variance on a trend line in order to maintain control over a business." ;
    bpot:hierarchyID "9.1.2.5" ;
    bpot:pcfID "10777" .

bpot:PCF_10778 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine key cost drivers" ;
    bpot:apqcSourceText "Defining cost drivers for a particular activity. " ;
    bpot:hierarchyID "9.1.3.1" ;
    bpot:pcfID "10778" .

bpot:PCF_10779 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure cost drivers" ;
    bpot:apqcSourceText "Calculating cost drivers. " ;
    bpot:hierarchyID "9.1.3.2" ;
    bpot:pcfID "10779" .

bpot:PCF_10780 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine critical activities" ;
    bpot:apqcSourceText "Determine the activities that hinder the progress of finance activities. This requires the organization to determine those business activities carried out by the financial function of the organization and which are indispensable. This undertaking helps the organization triangulate those activities which are essential and where costs cannot be slashed." ;
    bpot:hierarchyID "9.1.3.3" ;
    bpot:pcfID "10780" .

bpot:PCF_10781 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage asset resource deployment and utilization" ;
    bpot:apqcSourceText "Distributing or allocating asset resources in different processes for optimal utilization." ;
    bpot:hierarchyID "9.1.3.4" ;
    bpot:pcfID "10781" .

bpot:PCF_10782 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10741 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess customer and product profitability" ;
    bpot:apqcSourceText "Studying product demand and targeted customer preferences. Study customers' demands or preferences after deducting the cost of delivering the final product." ;
    bpot:hierarchyID "9.1.4.1" ;
    bpot:pcfID "10782" .

bpot:PCF_10783 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10741 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate new products" ;
    bpot:apqcSourceText "Checking demand about a specific product by a customer segment. Conduct a detailed study--or research a customer behavior or preference for a product--in order to determine its production and profitability in a specific market. " ;
    bpot:hierarchyID "9.1.4.2" ;
    bpot:pcfID "10783" .

bpot:PCF_10784 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10741 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform life cycle costing" ;
    bpot:apqcSourceText "Determining the cost of delivering an end product at different stages of production. Study the total life cycle of a product/process to determine how much revenue and production cost will be incurred at every stage in order to make strategic decisions. " ;
    bpot:hierarchyID "9.1.4.3" ;
    bpot:pcfID "10784" .

bpot:PCF_10785 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10741 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Optimize customer and product mix" ;
    bpot:apqcSourceText "Creating the best fit between a product and the end user. Maximize the customer base by providing different products in the market. " ;
    bpot:hierarchyID "9.1.4.4" ;
    bpot:pcfID "10785" .

bpot:PCF_10786 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10741 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track performance of new-customer and product strategies" ;
    bpot:apqcSourceText "Observing the behavior of a new set of customers for different products. Prepare strategies to improve sales and profits." ;
    bpot:hierarchyID "9.1.4.5" ;
    bpot:pcfID "10786" .

bpot:PCF_10787 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10741 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare activity-based performance measures" ;
    bpot:apqcSourceText "Evaluating performance based on different sets of activities created by management to measure performance." ;
    bpot:hierarchyID "9.1.4.6" ;
    bpot:pcfID "10787" .

bpot:PCF_10788 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10741 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage continuous cost improvement" ;
    bpot:apqcSourceText "Conducting activities to improve cost distribution regularly. Follow or adopt different ways of reducing costs." ;
    bpot:hierarchyID "9.1.4.7" ;
    bpot:pcfID "10788" .

bpot:PCF_10789 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10742 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish credit policies" ;
    bpot:apqcSourceText "Creating guidelines for providing advances. Set up credit standards, credit terms, and collection policies." ;
    bpot:hierarchyID "9.2.1.1" ;
    bpot:pcfID "10789" .

bpot:PCF_10790 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10742 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze/Approve new account applications" ;
    bpot:apqcSourceText "Checking and accepting new requests based on eligibility criteria. Analyze the status of applicants and requirements to be met for a new account." ;
    bpot:hierarchyID "9.2.1.2" ;
    bpot:pcfID "10790" .

bpot:PCF_10791 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10742 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review existing accounts" ;
    bpot:apqcSourceText "Evaluating existing account holders and their past performance. Regularly review existing accounts to get the required information about the status at present." ;
    bpot:hierarchyID "9.2.1.5" ;
    bpot:pcfID "10791" .

bpot:PCF_10792 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10742 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Produce credit/collection reports" ;
    bpot:apqcSourceText "Preparing account payable reports about payments to be made according to accounting rules and principles, and providing the reports to management." ;
    bpot:hierarchyID "9.2.1.6" ;
    bpot:pcfID "10792" .

bpot:PCF_10793 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10742 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reinstate or suspend accounts based on credit policies" ;
    bpot:apqcSourceText "Closing or restarting accounts according to changes made in credit policies. " ;
    bpot:hierarchyID "9.2.1.7" ;
    bpot:pcfID "10793" .

bpot:PCF_10794 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10743 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain customer/product master files" ;
    bpot:apqcSourceText "Creating and updating a record of customers and the products being purchased by them in a database. This process element requires the organization to maintain a database of customers and their purchases. Such a master-file can be used to ensure customer touch point, enhance customer satisfaction, explore cross selling opportunities, and identify future trends. This database will include several particulars about the personal details of the organization's customers and a tracking of the products being sold." ;
    bpot:hierarchyID "9.2.2.1" ;
    bpot:pcfID "10794" .

bpot:PCF_10795 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10743 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate customer billing data" ;
    bpot:apqcSourceText "Preparing detailed reports about products purchased by customers. Record and generate a detail account of transactions made by customers fat a particular time and location. Include all details about products such as price, quantity, and name." ;
    bpot:hierarchyID "9.2.2.2" ;
    bpot:pcfID "10795" .

bpot:PCF_10796 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10743 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Transmit billing data to customers" ;
    bpot:apqcSourceText "Providing information to customers about purchases made by them. Communicate the details of purchases. Provide customers with a copy of details for their reference." ;
    bpot:hierarchyID "9.2.2.3" ;
    bpot:pcfID "10796" .

bpot:PCF_10797 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10743 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Post receivable entries" ;
    bpot:apqcSourceText "Registering transactions and their scheduled payments. " ;
    bpot:hierarchyID "9.2.2.4" ;
    bpot:pcfID "10797" .

bpot:PCF_10798 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10743 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Resolve customer billing inquiries" ;
    bpot:apqcSourceText "Checking and solving billing queries raised by customers. " ;
    bpot:hierarchyID "9.2.2.5" ;
    bpot:pcfID "10798" .

bpot:PCF_10799 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10744 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish AR policies" ;
    bpot:apqcSourceText "Creating rules and regulations to be followed in case of credit sales to customers. Create rules and procedures to follow at the time of sale (e.g., the allowable number of installments)." ;
    bpot:hierarchyID "9.2.3.1" ;
    bpot:pcfID "10799" .

bpot:PCF_10800 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10744 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Receive/Deposit customer payments" ;
    bpot:apqcSourceText "Collecting cash from customers. Deposit it into bank account. Make entries into the books of accounts." ;
    bpot:hierarchyID "9.2.3.2" ;
    bpot:pcfID "10800" .

bpot:PCF_10801 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10744 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Apply cash remittances" ;
    bpot:apqcSourceText "Checking and moving funds between countries for business activities, typically through authorized remittance agents." ;
    bpot:hierarchyID "9.2.3.3" ;
    bpot:pcfID "10801" .

bpot:PCF_10802 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10744 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare AR reports" ;
    bpot:apqcSourceText "Preparing reports that detail balances due or what to collect from customers at a certain point in time. " ;
    bpot:hierarchyID "9.2.3.4" ;
    bpot:pcfID "10802" .

bpot:PCF_10803 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10744 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Post AR activity to the general ledger" ;
    bpot:apqcSourceText "Preparing the general ledger for account receivables from journals. Place all journal entries related to accounts receivables in the general ledger accounts of a business. " ;
    bpot:hierarchyID "9.2.3.5" ;
    bpot:pcfID "10803" .

bpot:PCF_10804 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10745 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish policies for delinquent accounts" ;
    bpot:apqcSourceText "Creating a process to follow in case of a failed payment by account holders. Create rules and regulations for the account holder who has failed to make at least the minimum monthly payment by the due date. " ;
    bpot:hierarchyID "9.2.4.1" ;
    bpot:pcfID "10804" .

bpot:PCF_10805 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10745 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze delinquent account balances" ;
    bpot:apqcSourceText "Examining balance statements of accountholders who failed to make required payments. Study or review the account details of customers' past payments when preparing negotiations policies. " ;
    bpot:hierarchyID "9.2.4.2" ;
    bpot:pcfID "10805" .

bpot:PCF_10806 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10745 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Correspond/Negotiate with delinquent accounts" ;
    bpot:apqcSourceText "Determine ways for customers in default to repay debts (e.g., allowing more time or discounts)." ;
    bpot:hierarchyID "9.2.4.3" ;
    bpot:pcfID "10806" .

bpot:PCF_10807 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10745 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Discuss account resolution with internal parties" ;
    bpot:apqcSourceText "Determining rules for handling accounts. Discuss and plan with internal parties (department heads, managers, and senior management) about rules to follow in coming months." ;
    bpot:hierarchyID "9.2.4.4" ;
    bpot:pcfID "10807" .

bpot:PCF_10808 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10745 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process adjustments/write off balances" ;
    bpot:apqcSourceText "Maintaining reserves for write-offs and adjustments. Adjust or write off certain expenses and losses. " ;
    bpot:hierarchyID "9.2.4.5" ;
    bpot:pcfID "10808" .

bpot:PCF_10809 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10746 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish policies/procedures for adjustments" ;
    bpot:apqcSourceText "Creating guidelines to follow in case of adjustments to business processes." ;
    bpot:hierarchyID "9.2.5.1" ;
    bpot:pcfID "10809" .

bpot:PCF_10810 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10746 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze adjustments" ;
    bpot:apqcSourceText "Checking changes made in accounts during the year. Examine the alterations made in final accounts to rectify errors/omissions." ;
    bpot:hierarchyID "9.2.5.2" ;
    bpot:pcfID "10810" .

bpot:PCF_10811 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10746 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Correspond/Negotiate with customer" ;
    bpot:apqcSourceText "Providing suitable offers to customers. Present different offers (e.g., discounts) available for customers or buyers." ;
    bpot:hierarchyID "9.2.5.3" ;
    bpot:pcfID "10811" .

bpot:PCF_10812 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10746 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Discuss resolution with internal parties" ;
    bpot:apqcSourceText "Discussing and planning with internal parties (department heads, managers, and senior management) about rules to follow in coming months." ;
    bpot:hierarchyID "9.2.5.4" ;
    bpot:pcfID "10812" .

bpot:PCF_10813 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10746 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare chargeback invoices" ;
    bpot:apqcSourceText "Creating a mechanism for consumer protection in case of a higher price charged. When a supplier sells a product at a higher price to the distributor than the price they have set with the end user, submit a chargeback to the supplier to recover the money lost in the transaction." ;
    bpot:hierarchyID "9.2.5.5" ;
    bpot:pcfID "10813" .

bpot:PCF_10814 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10746 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process related entries" ;
    bpot:apqcSourceText "Recording business transactions as they occur in order to provide a balanced accounts for financial reporting. " ;
    bpot:hierarchyID "9.2.5.6" ;
    bpot:pcfID "10814" .

bpot:PCF_10815 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10747 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Negotiate service-level agreements" ;
    bpot:apqcSourceText "Agreeing upon terms and conditions. Negotiate an agreement between two or more parties, the customer and service providers. Specify scope, quality, and responsibilities." ;
    bpot:hierarchyID "9.3.1.1" ;
    bpot:pcfID "10815" .

bpot:PCF_10816 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10747 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish accounting policies" ;
    bpot:apqcSourceText "Establishing policies and procedures to prepare financial statements, including methods, measurement systems, and procedures for providing disclosures." ;
    bpot:hierarchyID "9.3.1.2" ;
    bpot:pcfID "10816" .

bpot:PCF_10817 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10747 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Set and enforce approval limits" ;
    bpot:apqcSourceText "Implementing parameters for accounting. Apply set conditions for any approval process." ;
    bpot:hierarchyID "9.3.1.4" ;
    bpot:pcfID "10817" .

bpot:PCF_10818 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10747 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish common financial systems" ;
    bpot:apqcSourceText "Establishing processes and procedures to exercise financial control and accountability. Record, verify, and report transactions that affect revenues, expenditures, assets, and liabilities." ;
    bpot:hierarchyID "9.3.1.5" ;
    bpot:pcfID "10818" .

bpot:PCF_10819 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain chart of accounts" ;
    bpot:apqcSourceText "Preparing trial balance account from general ledgers. List all accounts used in the general ledger. Alter accounts according to business requirements." ;
    bpot:hierarchyID "9.3.2.1" ;
    bpot:pcfID "10819" .

bpot:PCF_10820 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process journal entries" ;
    bpot:apqcSourceText "Making ledger and trial balance accounts from journal entries. This process requires the organization to record every transaction into accounts done by business. It is a base documents for preparing final accounts of company." ;
    bpot:hierarchyID "9.3.2.2" ;
    bpot:pcfID "10820" .

bpot:PCF_10821 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process allocations" ;
    bpot:apqcSourceText "Allocating funds across functions. Apportion funds in line with the budgets created. Formalize allocations in centralized internal records." ;
    bpot:hierarchyID "9.3.2.3" ;
    bpot:pcfID "10821" .

bpot:PCF_10822 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process period end adjustments" ;
    bpot:apqcSourceText "Updating journal entries to adjust the balance of income and expenses at the end of an accounting period. " ;
    bpot:hierarchyID "9.3.2.4" ;
    bpot:pcfID "10822" .

bpot:PCF_10823 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Post and reconcile intercompany transactions" ;
    bpot:apqcSourceText "Checking accounts separately for a parent and subsidiary company. Manage relationship between a parent company and subsidiaries. Document intercompany transactions in separate financial statements. " ;
    bpot:hierarchyID "9.3.2.5" ;
    bpot:pcfID "10823" .

bpot:PCF_10824 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reconcile general ledger accounts" ;
    bpot:apqcSourceText "Reviewing general ledger accounts for a parent and subsidiaries companies. Validate the integrity of account balances on the company's general ledger of accounts. Review and compare general ledger accounts balances with source documents to ensure that balances match. " ;
    bpot:hierarchyID "9.3.2.6" ;
    bpot:pcfID "10824" .

bpot:PCF_10825 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform consolidations and process eliminations" ;
    bpot:apqcSourceText "Aggregating different processes in the business. Eliminate discontinued processes." ;
    bpot:hierarchyID "9.3.2.7" ;
    bpot:pcfID "10825" .

bpot:PCF_10826 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare trial balance" ;
    bpot:apqcSourceText "Balancing debit and credit balances of trial balance to preparing final accounts. Calculate the total debits and credits in company's accounts. Correspond the sum of all debits with the sum of all credits. Adjust entries as appropriate." ;
    bpot:hierarchyID "9.3.2.8" ;
    bpot:pcfID "10826" .

bpot:PCF_10827 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10748 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare and post management adjustments" ;
    bpot:apqcSourceText "Accounting for changes due to country-level policy changes. Record adjustments made by management in the accounts. " ;
    bpot:hierarchyID "9.3.2.9" ;
    bpot:pcfID "10827" .

bpot:PCF_10828 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish fixed-asset policies and procedures" ;
    bpot:apqcSourceText "Creating rules for fixed assets market valuation. Make rules and regulations for fixed assets regarding depreciation, provisions, resale, usage, etc." ;
    bpot:hierarchyID "9.3.3.1" ;
    bpot:pcfID "10828" .

bpot:PCF_10829 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain fixed-asset master data files" ;
    bpot:apqcSourceText "Keeping reports up-to-date regarding fixed assets. Create a fixed assets database detailing price, life cycle, depreciation rate, resale value, installation information, usage information, etc." ;
    bpot:hierarchyID "9.3.3.2" ;
    bpot:pcfID "10829" .

bpot:PCF_10830 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process and record fixed-asset additions and retires" ;
    bpot:apqcSourceText "Keeping a summary of sales and purchases of assets. Record any expenses made for new assets purchased and sales of any old assets during the fiscal year. " ;
    bpot:hierarchyID "9.3.3.3" ;
    bpot:pcfID "10830" .

bpot:PCF_10831 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process and record fixed-asset adjustments, enhancements, revaluations, and transfers" ;
    bpot:apqcSourceText "Keeping a summary of expenses for installing and modifying assets. Record any expenses made for new assets purchased, any expenses incurred on improvements, the valuation of assets to reach current market price, and any transfer assets from one location to another during the fiscal year." ;
    bpot:hierarchyID "9.3.3.4" ;
    bpot:pcfID "10831" .

bpot:PCF_10832 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process and record fixed-asset maintenance and repair expenses" ;
    bpot:apqcSourceText "Maintaining a record of expenses necessitated for repairs and the preservation of assets. Administer and oversee the maintenance and repair of any fixed assets. Record all related transactions." ;
    bpot:hierarchyID "9.3.3.5" ;
    bpot:pcfID "10832" .

bpot:PCF_10833 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Calculate and record depreciation expense" ;
    bpot:apqcSourceText "Carrying out accounting for depreciation over fixed assets. Compute the sums necessitated. Maintain a record of the cost value of fixed assets over their useful life in the book of accounts." ;
    bpot:hierarchyID "9.3.3.6" ;
    bpot:pcfID "10833" .

bpot:PCF_10834 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reconcile fixed-asset ledger" ;
    bpot:apqcSourceText "Balancing the ledger account balance for fixed assets. Correct errors in the books of fixed assets. Provide correct information in relevant accounts." ;
    bpot:hierarchyID "9.3.3.7" ;
    bpot:pcfID "10834" .

bpot:PCF_10835 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track fixed-assets including physical inventory" ;
    bpot:apqcSourceText "Checking and updating the record of all raw materials and fixed assets. Track all fixes asset. Maintain a record of all inventory items." ;
    bpot:hierarchyID "9.3.3.8" ;
    bpot:pcfID "10835" .

bpot:PCF_10836 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10749 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide fixed-asset data to support tax, statutory, and regulatory reporting" ;
    bpot:apqcSourceText "Showing market value and related expenses on fixed assets data for taxation. Provide complete information recorded in the books of fixed assets about purchase price, depreciation, installation charges, resale market value etc. for tax and regulatory purposes." ;
    bpot:hierarchyID "9.3.3.9" ;
    bpot:pcfID "10836" .

bpot:PCF_10837 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare business unit financial statements" ;
    bpot:apqcSourceText "Making reports of subsidiaries units to show profits generated from them. Prepare financial statements (balance sheets, income statements, cash flow statements and statements of shareholders' equity) for a single unit of a business." ;
    bpot:hierarchyID "9.3.4.1" ;
    bpot:pcfID "10837" .

bpot:PCF_10838 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare consolidated financial statements" ;
    bpot:apqcSourceText "Making final accounts for all units of company together. Prepare combined financial statements of a parent company and its subsidiaries (i.e., separate legal entities controlled by a parent company) showing assets, liabilities, equity, income, expenses, and cash flows." ;
    bpot:hierarchyID "9.3.4.2" ;
    bpot:pcfID "10838" .

bpot:PCF_10839 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform business unit reporting/review management reports" ;
    bpot:apqcSourceText "Making reports for units/subsidiaries to help management in decision making. Prepare financial statements (balance sheets, income statements, cash flow statements, and statements of shareholders' equity) for a single unit of a business. Break down profits and losses by function/unit, clients, products, and region." ;
    bpot:hierarchyID "9.3.4.3" ;
    bpot:pcfID "10839" .

bpot:PCF_10840 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform consolidated reporting/review of cost management reports" ;
    bpot:apqcSourceText "Making reports for all units to help higher management in decision making. Prepare combined financial statements of a parent company and its all subsidiaries (separate legal entities controlled by a parent company) showing assets, liabilities, equity, income, expenses and cash flows, and also going through periodic reports which shows the actual and estimated costs and their variances." ;
    bpot:hierarchyID "9.3.4.4" ;
    bpot:pcfID "10840" .

bpot:PCF_10841 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare statements for board review" ;
    bpot:apqcSourceText "Preparing a draft of financial statements for the board to review before they are sent to the auditor. " ;
    bpot:hierarchyID "9.3.4.5" ;
    bpot:pcfID "10841" .

bpot:PCF_10842 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Produce quarterly/annual filings and shareholder reports" ;
    bpot:apqcSourceText "Making and presenting financial reports to stakeholders. Create annual and quarterly financial statements for reporting purposes. Prepare shareholder reports with details of the profit-and-loss account, balance sheet, and past year's business activities." ;
    bpot:hierarchyID "9.3.4.6" ;
    bpot:pcfID "10842" .

bpot:PCF_10843 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10750 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Produce regulatory reports" ;
    bpot:apqcSourceText "Reporting raw or summary data for final accounts following rules and regulations." ;
    bpot:hierarchyID "9.3.4.7" ;
    bpot:pcfID "10843" .

bpot:PCF_10844 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10751 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop capital investment policies and procedures" ;
    bpot:apqcSourceText "Creating procedures and policies to follow for investing in capital projects. Create rules and regulations regarding large investment plans, which require in-depth forecasting for expenditure and revenue." ;
    bpot:hierarchyID "9.4.1.1" ;
    bpot:pcfID "10844" .

bpot:PCF_10845 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10751 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and approve capital expenditure plans and budgets" ;
    bpot:apqcSourceText "Creating budgets, and soliciting approvals for capital projects. Prepare budgets for projects that require heavy investments. Secure approvals from management." ;
    bpot:hierarchyID "9.4.1.2" ;
    bpot:pcfID "10845" .

bpot:PCF_10846 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10751 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review and approve capital projects and fixed-asset acquisitions" ;
    bpot:apqcSourceText "Evaluating and supporting capital investments in projects and fixed assets. Confirm details of capital projects. Secure approvals from managements for large investments." ;
    bpot:hierarchyID "9.4.1.3" ;
    bpot:pcfID "10846" .

bpot:PCF_10847 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10751 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct financial justification for project approval" ;
    bpot:apqcSourceText "Reviewing all project business cases in order to substantiate projected financial gains. Validate any project's business case. Juxtapose the benefits derived from moving a project forward against the associated costs. " ;
    bpot:hierarchyID "9.4.1.4" ;
    bpot:pcfID "10847" .

bpot:PCF_10848 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10752 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create project account codes" ;
    bpot:apqcSourceText "Giving reference codes for every project. " ;
    bpot:hierarchyID "9.4.2.1" ;
    bpot:pcfID "10848" .

bpot:PCF_10849 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10752 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record project-related transactions" ;
