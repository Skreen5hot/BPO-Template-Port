    bpot:hierarchyID "7.3.4.6.4" ;
    bpot:pcfID "20129" .

bpot:PCF_20133 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20132 ;
