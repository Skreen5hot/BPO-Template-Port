    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify impacted groups" ;
    bpot:apqcSourceText "Recognizing the impact of threats to critical assets. Determine what groups are impacted by this impact. " ;
    bpot:hierarchyID "13.4.1.10" ;
    bpot:pcfID "20143" .

bpot:PCF_20144 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
