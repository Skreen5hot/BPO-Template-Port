    bpot:hierarchyID "8.2.7.1" ;
    bpot:pcfID "20700" .

bpot:PCF_20701 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20699 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze emerging technology concepts" ;
    bpot:apqcSourceText "Assessing new and future technologies relevant to the organization's vision of its IT capabilities. " ;
    bpot:hierarchyID "8.2.7.2" ;
    bpot:pcfID "20701" .

bpot:PCF_20702 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20699 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify technology concepts and capabilities" ;
    bpot:apqcSourceText "Identification of conceptual elements that define the benefits of technology to business." ;
    bpot:hierarchyID "8.2.7.3" ;
    bpot:pcfID "20702" .

bpot:PCF_20703 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20699 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute IT research projects" ;
    bpot:apqcSourceText "Implement information technology research projects that focus on meeting the goals of the organization's IT services and capabilities." ;
    bpot:hierarchyID "8.2.7.4" ;
    bpot:pcfID "20703" .

bpot:PCF_20704 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20699 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and promote viable concepts" ;
