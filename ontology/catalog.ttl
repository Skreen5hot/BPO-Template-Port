    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain records for regulatory agencies" ;
    bpot:apqcSourceText "Identifying steps and procedures to manage and regularly update the records for regulatory agencies. Updates will be made to safety procedures, identity and access management, software tools and applications, internal accessibility policies, internal quality parameters, etc." ;
    bpot:hierarchyID "2.1.3.5.2" ;
    bpot:pcfID "12773" .

