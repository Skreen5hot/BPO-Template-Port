    skos:prefLabel "Receive required resources/skills and capabilities" ;
    bpot:apqcSourceText "Obtaining resources necessary to fill a position utilizing specific skills and capabilities." ;
    bpot:hierarchyID "7.6.6.1" ;
    bpot:pcfID "20133" .

bpot:PCF_20135 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
