    skos:broader bpot:PCF_12127 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver technical training" ;
    bpot:apqcSourceText "Ensuring that all personnel are trained on all technical aspects of service delivery." ;
    bpot:hierarchyID "5.2.3.5" ;
    bpot:pcfID "12133" .

bpot:PCF_12135 a owl:NamedIndividual,
