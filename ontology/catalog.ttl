    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20648 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Synthesize and distribute IT performance information" ;
    bpot:apqcSourceText "Providing stakeholders with collected IT performance measures for further development based on evaluation." ;
    bpot:hierarchyID "8.1.7.4" ;
    bpot:pcfID "20938" .

bpot:PCF_20939 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20699 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate IT research project outcomes" ;
    bpot:apqcSourceText "Assessing IT research projects based on defined outcome expectations. " ;
    bpot:hierarchyID "8.2.7.5" ;
    bpot:pcfID "20939" .

bpot:PCF_20940 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20707 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Understand business unit risk tolerance" ;
    bpot:apqcSourceText "Understand the risk tolerance levels of individual business units, given risk-return trade-offs for one or more anticipated and predictable consequences." ;
    bpot:hierarchyID "8.3.1.2" ;
    bpot:pcfID "20940" .

bpot:PCF_20941 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20707 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify systems to support compliance" ;
    bpot:apqcSourceText "Identifying and adopting information technology solutions to support changing regulatory compliance. Safeguard compliance and manage risk by outlining the risk policies and procedures. " ;
    bpot:hierarchyID "8.3.1.7" ;
    bpot:pcfID "20941" .

bpot:PCF_20942 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20721 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create and maintain IT security policies, standards, and procedures" ;
    bpot:apqcSourceText "Develop and maintain an architecture for securing and ensuring the privacy of data flows throughout the organization. Create, test, evaluate, and implement IT security policies to ensure the safe use of IT services and solutions." ;
    bpot:hierarchyID "8.3.3.4" ;
    bpot:pcfID "20942" .

bpot:PCF_20943 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20895 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain service support learning" ;
    bpot:apqcSourceText "Maintaining and transfer of knowledge towards service support with the change/upgrade in technology over a stipulated period. Ensure IT staff is well trained and tested on the new learning of service support." ;
    bpot:hierarchyID "8.7.5.4" ;
    bpot:pcfID "20943" .

bpot:PCF_20946 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20945 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assemble business model information" ;
    bpot:apqcSourceText "Collecting all relevant materials needed to develop the business model, so that it can adequately model its processes." ;
    bpot:hierarchyID "1.4.1.1" ;
    bpot:pcfID "20946" .

bpot:PCF_20947 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20945 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Secure appropriate approvals" ;
    bpot:apqcSourceText "Obtaining required permissions, licenses and authorizations that legitimize the business, help to mitigate associated risks and safeguard the operations." ;
    bpot:hierarchyID "1.4.1.2" ;
    bpot:pcfID "20947" .

bpot:PCF_20948 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20945 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify integration points with existing models" ;
    bpot:apqcSourceText "Ensuring coherence with pre-exsiting models to avoid contradictions between models. Make sure that all models represent the same long-term vision." ;
    bpot:hierarchyID "1.4.1.3" ;
    bpot:pcfID "20948" .

bpot:PCF_20949 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20945 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Adopt the business model" ;
    bpot:apqcSourceText "Consenting to a particular business model and formally accepting it to serve as the set of guiding principles in operating the company." ;
    bpot:hierarchyID "1.4.1.4" ;
    bpot:pcfID "20949" .

bpot:PCF_20951 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20950 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish business model maintenance parameters" ;
    bpot:apqcSourceText "Determining the timeline, procedures and responsibilities for reviewing the business model and for updating it to best serve the organization." ;
    bpot:hierarchyID "1.4.2.1" ;
    bpot:pcfID "20951" .

bpot:PCF_20952 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20950 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Accept business model feedback parameters" ;
    bpot:apqcSourceText "Deciding the type of responses, reactions, sentiments and insights that are crucial to be taken into consideration with business model maintenance." ;
    bpot:hierarchyID "1.4.2.2" ;
    bpot:pcfID "20952" .

bpot:PCF_20953 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20950 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prioritize and manage incoming feedback" ;
    bpot:apqcSourceText "Evaluating the feedback regarding products, services, processes or resources. Determine which judgments are critical and mandate changes to the current business model to better deliver the desired value " ;
    bpot:hierarchyID "1.4.2.3" ;
    bpot:pcfID "20953" .

bpot:PCF_20954 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20950 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Update existing models" ;
    bpot:apqcSourceText "Modifying the business models that are presently in use in response to incoming feedback or changing markets to achieve the enterprise business goals." ;
    bpot:hierarchyID "1.4.2.4" ;
    bpot:pcfID "20954" .

bpot:PCF_20955 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20944 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish business model governance" ;
    bpot:apqcSourceText "Creating and implementing a strategy, responsibilities and control mechanisms for managing business models that are timely, efficient and cost-effective." ;
    bpot:hierarchyID "1.4.3" ;
    bpot:pcfID "20955" .

bpot:PCF_20956 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10369 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage quality samples" ;
    bpot:apqcSourceText "Selecting a set of elements from a product lot to draw conclusions or make inferences about the quality of the product lot from which the sample is drawn. Sampling is frequently used because gathering data on every product produced by a company is often impossible, impractical, or too costly to collect. " ;
    bpot:hierarchyID "4.3.3.3" ;
    bpot:pcfID "20956" .

bpot:PCF_20957 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10340 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage warehouse transfers" ;
    bpot:apqcSourceText "Shipping items from one warehouse to another in a multi-warehouse environment. A warehouse transfer is typically handled electronically in a system designed to replicate the physical processes involved with transferring items from one warehouse to another." ;
    bpot:hierarchyID "4.4.3.8" ;
    bpot:pcfID "20957" .

bpot:PCF_20960 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage hypotheses" ;
    bpot:apqcSourceText "Creating theories that explain empirical data. Use the hypotheses to guide feature selection in the process of data collection." ;
    bpot:hierarchyID "13.7.3" ;
    bpot:pcfID "20960" .

bpot:PCF_20961 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collect data" ;
    bpot:apqcSourceText "Gathering and harvesting structured and unstructured data from disparate sources. Clean and pre-process data. Remove duplicates. Convert to a uniform format to make records comparable." ;
    bpot:hierarchyID "13.7.4" ;
    bpot:pcfID "20961" .

bpot:PCF_20962 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze data" ;
    bpot:apqcSourceText "Conducting data analysis. Choose statistical algorithms that best reveal patterns and trends in the data. Compare with hypotheses and time series forecasts. Determine error rates and significant outliers. " ;
    bpot:hierarchyID "13.7.6" ;
    bpot:pcfID "20962" .

bpot:PCF_20963 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report on analysis" ;
    bpot:apqcSourceText "Summarizing and documenting the results of data analysis. Create graphs and visualizations to illustrate numerical findings to make them more accessible to readers." ;
    bpot:hierarchyID "13.7.10" ;
    bpot:pcfID "20963" .

bpot:PCF_20964 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify remedial actions" ;
    bpot:apqcSourceText "Determining the steps that need to be taken to correct the shortcomings." ;
    bpot:hierarchyID "13.7.11" ;
    bpot:pcfID "20964" .

bpot:PCF_20966 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20965 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design resource model for KM approaches" ;
    bpot:apqcSourceText "Creating a model to describe resources and approaches to organization's knowledge management. Establish standards and guidelines to be followed." ;
    bpot:hierarchyID "13.5.3.2" ;
    bpot:pcfID "20966" .

bpot:PCF_20967 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20965 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Leverage and enhance IT for KM approaches" ;
    bpot:apqcSourceText "Using existing technologies to improve organization's knowledge management processes. Research available third-party offerings. Develop proprietary solutions. Employ knowledge engineers, data scientists and other relevant personnel." ;
    bpot:hierarchyID "13.5.3.4" ;
    bpot:pcfID "20967" .

bpot:PCF_20968 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20965 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop measures" ;
    bpot:apqcSourceText "Creating metrics that can be used to systematically describe KM approaches and capabilities. Choose applicable scales, benchmarks and units of measure. Determine required precision and error rates." ;
    bpot:hierarchyID "13.5.3.5" ;
    bpot:pcfID "20968" .

bpot:PCF_20970 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20969 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel " Sustain awareness and engagement" ;
    bpot:apqcSourceText "Developing awareness about available knowledge bases and promoting their use to maximize their impact." ;
    bpot:hierarchyID "13.5.4.2" ;
    bpot:pcfID "20970" .

bpot:PCF_20971 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20969 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Expand KM infrastructure to meet demand" ;
    bpot:apqcSourceText "Augmenting available resources to better leverage the offerings of the organization to serve existing clients and to expand the client base." ;
    bpot:hierarchyID "13.5.4.3" ;
    bpot:pcfID "20971" .

bpot:PCF_21421 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10017 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify potential product or service alternatives" ;
    bpot:apqcSourceText "Examining if there are other existing products or services in the marketplace, and building the business case to make a go/no go decision based upon substitutions.  " ;
    bpot:hierarchyID "1.1.1.3" ;
    bpot:pcfID "21421" .

bpot:PCF_21422 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10016 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review execution of strategic initiatives" ;
    bpot:apqcSourceText "Periodic review of initiatives based performance, conditions, and marketplace response." ;
    bpot:hierarchyID "1.3.6" ;
    bpot:pcfID "21422" .

bpot:PCF_21423 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10016 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Refine strategic initiatives and project plans as needed" ;
    bpot:apqcSourceText "Performing required updates to strategic initiatives based upon changes in the marketplace or performance." ;
    bpot:hierarchyID "1.3.7" ;
    bpot:pcfID "21423" .

bpot:PCF_21424 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10108 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Predict customer purchasing behavior" ;
    bpot:apqcSourceText "Using customer segmentation tools to examine past customer behavior to predict future purchasing patterns.  " ;
    bpot:hierarchyID "3.1.1.1.2" ;
    bpot:pcfID "21424" .

bpot:PCF_21425 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop go-to-market strategy" ;
    bpot:apqcSourceText "Creation of a plan detailing how a company plans to execute a successful product release and promotion, and ultimately its sale to customers." ;
    bpot:hierarchyID "3.3.8" ;
    bpot:pcfID "21425" .

bpot:PCF_21427 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform sales at physical outlets" ;
    bpot:apqcSourceText "Execution of sales at physical / brick and mortar locations.  " ;
    bpot:hierarchyID "3.5.6" ;
    bpot:pcfID "21427" .

bpot:PCF_21428 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform field sales" ;
    bpot:apqcSourceText "Execution of sales within field/remote locations.  This could be any location that is not part of a headquarters location. " ;
    bpot:hierarchyID "3.5.7" ;
    bpot:pcfID "21428" .

bpot:PCF_21429 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform digital sales" ;
    bpot:apqcSourceText "Execution of sales in an online environment." ;
    bpot:hierarchyID "3.5.8" ;
    bpot:pcfID "21429" .

bpot:PCF_21430 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine HR function roles and structure" ;
    bpot:apqcSourceText "Establishing the roles that are required to execute the HR function.  This process also examines the organizational structure required to support the organization." ;
    bpot:hierarchyID "7.1.1.3" ;
    bpot:pcfID "21430" .

bpot:PCF_21431 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine HR delivery model" ;
    bpot:apqcSourceText "Determining how an organization's human resources department offers services to and interacts with employees. " ;
    bpot:hierarchyID "7.1.1.4" ;
    bpot:pcfID "21431" .

bpot:PCF_21432 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20958 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage job families and positions" ;
    bpot:apqcSourceText "Overseeing a group of similar individual or teams with similar education, skills, training, or experience.  " ;
    bpot:hierarchyID "7.1.1.10" ;
    bpot:pcfID "21432" .

bpot:PCF_21433 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement diversity, equity, and inclusion plan" ;
    bpot:apqcSourceText "Execution of diversity, equity, and inclusion plans within an organization.  Often called a DEI plan.  " ;
    bpot:hierarchyID "7.1.2.7" ;
    bpot:pcfID "21433" .

bpot:PCF_21434 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10470 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review employee performance" ;
    bpot:apqcSourceText "Execution of employee reviews/performance on a frequent basis. " ;
    bpot:hierarchyID "7.3.2.2" ;
    bpot:pcfID "21434" .

bpot:PCF_21435 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10470 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee performance" ;
    bpot:apqcSourceText "Management of reviewing employee performance.  This includes the tools that are used, the frequency of the reviews, and how the reviews are used within the organization. " ;
    bpot:hierarchyID "7.3.2.3" ;
    bpot:pcfID "21435" .

bpot:PCF_21436 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10473 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and evaluate learning programs" ;
    bpot:apqcSourceText "Oversight of the organization's learning programs.  This process also includes the effectiveness of these programs. " ;
    bpot:hierarchyID "7.3.4.7" ;
    bpot:pcfID "21436" .

bpot:PCF_21437 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17052 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor legal and regulatory environment" ;
    bpot:apqcSourceText "Awareness of the employee legislature that is in place for the organization.  The regulatory environment could include areas, regions, or countries.  " ;
    bpot:hierarchyID "7.4.5" ;
    bpot:pcfID "21437" .

bpot:PCF_21440 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10508 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage flexible working" ;
    bpot:apqcSourceText "Creation and execution of a plan that might allow for work from home days, or alternate hours. " ;
    bpot:hierarchyID "7.5.3.1.1" ;
    bpot:pcfID "21440" .

bpot:PCF_21442 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21441 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine stakeholder requirements" ;
    bpot:apqcSourceText "Collect and manage requirements from various enterprise stakeholders about workforce analytics." ;
    bpot:hierarchyID "7.7.7.1" ;
    bpot:pcfID "21442" .

bpot:PCF_21443 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21441 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify research questions" ;
    bpot:apqcSourceText "Summarize stakeholder requirements into discrete research questions in support of workforce analytics. " ;
    bpot:hierarchyID "7.7.7.2" ;
    bpot:pcfID "21443" .

bpot:PCF_21444 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21441 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select workforce analysis methodology" ;
    bpot:apqcSourceText "Consider stakeholder requirements, research questions, and organizations standards around research to select appropriate research methodology in support of workforce analytics." ;
    bpot:hierarchyID "7.7.7.3" ;
    bpot:pcfID "21444" .

bpot:PCF_21445 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21441 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify workforce data sources" ;
    bpot:apqcSourceText "Identify appropriate data sources for workforce analytics data while considering organizational standards for data sources.  " ;
    bpot:hierarchyID "7.7.7.4" ;
    bpot:pcfID "21445" .

bpot:PCF_21446 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21441 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Gather workforce data" ;
    bpot:apqcSourceText "Collect and procure, as needed, workforce data from internal and external data sources in support of workforce analytics.  " ;
    bpot:hierarchyID "7.7.7.5" ;
    bpot:pcfID "21446" .

bpot:PCF_21448 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21447 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Transform workforce analysis data" ;
    bpot:apqcSourceText "Logically and statistically validate collected or purchased data in support of analytics needs" ;
    bpot:hierarchyID "7.7.8.1" ;
    bpot:pcfID "21448" .

bpot:PCF_21449 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21447 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop insights into workforce analytics outcomes" ;
    bpot:apqcSourceText "Synthesize insights from workforce analytics data" ;
    bpot:hierarchyID "7.7.8.2" ;
    bpot:pcfID "21449" .

bpot:PCF_21450 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21447 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate workforce analysis outcomes" ;
    bpot:apqcSourceText "Summarize, package, and distribute results of workforce analysis.  " ;
    bpot:hierarchyID "7.7.8.3" ;
    bpot:pcfID "21450" .

bpot:PCF_21452 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and denote process control points" ;
    bpot:apqcSourceText "Establishment of a \"checkpoint\" in a process that prevent the process from continuing unless all requirements are satisfied.  " ;
    bpot:hierarchyID "13.1.3.3" ;
    bpot:pcfID "21452" .

bpot:PCF_21454 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16411 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prioritize and select projects for the portfolio" ;
    bpot:apqcSourceText "Stack ranking of projects in the portfolio based upon preestablished criteria. " ;
    bpot:hierarchyID "13.2.3.1.6" ;
    bpot:pcfID "21454" .

bpot:PCF_21455 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16414 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct Project Reviews with Program Managers and other stakeholders" ;
    bpot:apqcSourceText "Hold post project reviews, lessons learned, or After Action Reviews (AARs) at the end of each project to understand what could be improved during future projects. " ;
    bpot:hierarchyID "13.2.3.4.5" ;
    bpot:pcfID "21455" .

bpot:PCF_21456 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16414 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Adjust project plan as needed" ;
    bpot:apqcSourceText "Changes to project plans based upon internal and or external influences on the project.  This would include the update to the project plan file, as well as the communication to the team." ;
    bpot:hierarchyID "13.2.3.4.7" ;
    bpot:pcfID "21456" .

bpot:PCF_21459 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify needs from stakeholders" ;
    bpot:apqcSourceText "Gathering information from stakeholders prior to conducting analytics. " ;
    bpot:hierarchyID "13.7.1" ;
    bpot:pcfID "21459" .

bpot:PCF_21460 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Scope analytics project" ;
    bpot:apqcSourceText "Determining the size and scale of the project based upon the collected information and analytics. " ;
    bpot:hierarchyID "13.7.2" ;
    bpot:pcfID "21460" .

bpot:PCF_21461 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare data" ;
    bpot:apqcSourceText "Creation and validation of data in order to initiate the process of analysis.  " ;
    bpot:hierarchyID "13.7.5" ;
    bpot:pcfID "21461" .

bpot:PCF_21462 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create data models" ;
    bpot:apqcSourceText "Creation of conceptual and physical data models as an outline for data structure and storage. " ;
    bpot:hierarchyID "13.7.7" ;
    bpot:pcfID "21462" .

bpot:PCF_21463 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review data models with stakeholders" ;
    bpot:apqcSourceText "Confirm data models represent the hypothesis supporting the original research question" ;
    bpot:hierarchyID "13.7.8" ;
    bpot:pcfID "21463" .

bpot:PCF_21464 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Refine data models" ;
    bpot:apqcSourceText "Make required changes to data model based upon review with stakeholders." ;
    bpot:hierarchyID "13.7.9" ;
    bpot:pcfID "21464" .

bpot:PCF_21577 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10952 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform cost vs. benefit analysis for replacement" ;
    bpot:apqcSourceText "Cost/benefit analysis of assets to determine retention or end-of-life. Evaluating asset total lifecycle cost against other factors such as repair/refurbishment, replacement, and alternate solutions." ;
    bpot:hierarchyID "10.4.1.2" ;
    bpot:pcfID "21577" .

bpot:PCF_21579 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21576 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Dismantle assets" ;
    bpot:apqcSourceText "Dismantling an asset into manageable parts. The parts may follow different dispositions, such as resale, reuse, recycle, etc." ;
    bpot:hierarchyID "10.4.5" ;
    bpot:pcfID "21579" .

bpot:PCF_21580 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21576 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track parts" ;
    bpot:apqcSourceText "Tracking the disposition of all parts from end-of-life assets. Tracking should provide an audit trail to include source, rational for disposition, and destination." ;
    bpot:hierarchyID "10.4.6" ;
    bpot:pcfID "21580" .

bpot:PCF_21581 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21576 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Recycle parts" ;
    bpot:apqcSourceText "Recycling parts in accordance with legal, regulatory, and social/environmental responsibilities." ;
    bpot:hierarchyID "10.4.7" ;
    bpot:pcfID "21581" .

bpot:PCF_21586 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21585 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain enterprise measurement models" ;
    bpot:apqcSourceText "Reviewing, evaluating, and updating enterprise measurement models. Align measurement models to current and future goals and performance targets, and make adjustments to support visibility and reporting needs across the organization." ;
    bpot:hierarchyID "13.6.1.2" ;
    bpot:pcfID "21586" .

bpot:PCF_21591 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_21590 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define sustainability disclosure requirements" ;
    bpot:apqcSourceText "Defining and communicating sustainability disclosure requirements. Clarify and align disclosure requirements to other organizational reporting requirements and needs. Integrate preparation and reporting activities." ;
    bpot:hierarchyID "13.9.1.1.1" ;
    bpot:pcfID "21591" .

bpot:PCF_21592 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_21590 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define sustainability governance requirements" ;
    bpot:apqcSourceText "Defining governance requirements for sustainability. Include structure, roles, alignment to organization models, processes and standards to be applied." ;
    bpot:hierarchyID "13.9.1.1.2" ;
    bpot:pcfID "21592" .

bpot:PCF_21593 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_21590 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define sustainability functional and performance requirements" ;
    bpot:apqcSourceText "Defining functional and performance requirements for sustainability. Align with ESG strategies, goals, and the implementation of sustainability efforts across the organization, provide a roadmap and visibility to shared and collective requirements." ;
    bpot:hierarchyID "13.9.1.1.3" ;
    bpot:pcfID "21593" .

bpot:PCF_21594 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21589 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish sustainability goals/objectives" ;
    bpot:apqcSourceText "Establishing organizational sustainability goals/objectives. Gather, align, and promote organization-wide sustainability goals that collectively address the overall sustainability requirements. Ensure the goals are measurable and have qualitative and quantitative targets." ;
    bpot:hierarchyID "13.9.1.2" ;
    bpot:pcfID "21594" .

bpot:PCF_21595 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21589 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create sustainability policies" ;
    bpot:apqcSourceText "Establishing, documenting, and communicating sustainability policies. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
    bpot:hierarchyID "13.9.1.3" ;
    bpot:pcfID "21595" .

bpot:PCF_21596 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21589 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define sustainability measures" ;
    bpot:apqcSourceText "Defining sustainability measures. Provide organization-wide measures, to include data collection strategies, calculations, analytics, and reporting formats." ;
    bpot:hierarchyID "13.9.1.4" ;
    bpot:pcfID "21596" .

bpot:PCF_21597 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21589 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create sustainability plan(s)" ;
    bpot:apqcSourceText "Creating sustainability plans. Develop and socialize sustainability plans for the organization, functional units, and support services. Ensure alignment to sustainability requirements, goals, and governance." ;
    bpot:hierarchyID "13.9.1.5" ;
    bpot:pcfID "21597" .

bpot:PCF_21599 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21598 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide sustainability training" ;
    bpot:apqcSourceText "Providing sustainability training and awareness. Plan, prepare, and oversee delivery of sustainability education and enablement activities." ;
    bpot:hierarchyID "13.9.2.1" ;
    bpot:pcfID "21599" .

bpot:PCF_21600 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21598 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide sustainability support" ;
    bpot:apqcSourceText "Providing support for sustainability activities. Augment functional units and support teams with coaching, mentoring, and SME capacity to perform sustainability projects and activities." ;
    bpot:hierarchyID "13.9.2.2" ;
    bpot:pcfID "21600" .

bpot:PCF_21602 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_21601 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure sustainability performance" ;
    bpot:apqcSourceText "Measuring sustainability performance. Setup, collect, and validate sustainability data. Conduct audits and inspections. Evaluate results to requirements and targets. Identify and track resolution of gaps and variances." ;
    bpot:hierarchyID "13.9.2.3.1" ;
    bpot:pcfID "21602" .

bpot:PCF_21603 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_21601 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare sustainability statements" ;
    bpot:apqcSourceText "Preparing sustainability statements. Given the multitude of potential audiences for reporting, alignment and consistency of sustainability statements provides clarity and reusability for those audiences." ;
    bpot:hierarchyID "13.9.2.3.2" ;
    bpot:pcfID "21603" .

bpot:PCF_21604 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20109 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage repair/refurbishment" ;
    bpot:apqcSourceText "Administering the reinstatement of the returned product in order to return them back to customers. Repair or remanufacture the defective or ineffective products returned by the customer. Process the delivery of the repaired or remanufactured products back to the customer." ;
    bpot:hierarchyID "4.4.2.5.3" ;
    bpot:pcfID "21604" .

bpot:PCF_21605 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20109 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Return to finished goods inventory" ;
    bpot:apqcSourceText "Moving a returned product back to inventory or stock. Whether a product is sufficient as returned, repaired, or refurbished, moving that product back to inventory for resale or returning to customer is the fnal step in Manage disposition of returned products." ;
    bpot:hierarchyID "4.4.2.5.4" ;
    bpot:pcfID "21605" .

bpot:PCF_21606 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate B2B options" ;
    bpot:apqcSourceText "Evaluating future business to business opportunities against past and current approaches and performance. Gather insights into what competitors and other similar organizations are doing and the needs, goals, and expectations of stakeholders and partners to understand potential future impact." ;
    bpot:hierarchyID "1.2.2.3" ;
    bpot:pcfID "21606" .

bpot:PCF_21607 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate B2C options" ;
    bpot:apqcSourceText "Evaluating future business to customer opportunities against past and current approaches and performance. Gather insights into what competitors and other similar organizations are doing and the needs, goals, and expectations of customers and partners to understand potential future impact." ;
    bpot:hierarchyID "1.2.2.4" ;
    bpot:pcfID "21607" .

bpot:PCF_21608 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate partner/alliance options" ;
    bpot:apqcSourceText "Evaluating partnership and alliance opportunities to deliver products/services. Understand existing product and market models in use across the markets you serve, evolving trends, and the cost/benefit of potential new/updated partnership/alliance options." ;
    bpot:hierarchyID "1.2.2.5" ;
    bpot:pcfID "21608" .

bpot:PCF_21609 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate IP acquisition options" ;
    bpot:apqcSourceText "Evaluating intellectual property acquisition options available to scale, modernize, and/or extend product/service reach. Understand the cost, risk, timing and lifecycle value of candidate acquisitions." ;
    bpot:hierarchyID "1.2.2.6" ;
    bpot:pcfID "21609" .

bpot:PCF_21610 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate innovation options" ;
    bpot:apqcSourceText "Evaluating innovation options to advance technology, products/services, and/or operational performance." ;
    bpot:hierarchyID "1.2.2.7" ;
    bpot:pcfID "21610" .

bpot:PCF_21611 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate sustainability options" ;
    bpot:apqcSourceText "Evaluating sustainability requirements, stakeholder expectations, and value proposition for options. Understand the potential activities and changes across environmental, social, and governance, the effort required, cost to implement, and benefits gained. The analysis should consider sustainable product/service lifecycles, operations, infrastructure, performance, and workforce." ;
    bpot:hierarchyID "1.2.2.8" ;
    bpot:pcfID "21611" .

bpot:PCF_21612 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate global support options" ;
    bpot:apqcSourceText "Evaluating options for global support services and functions. This should include structure, scale, adaptability to change, and alternative delivery models to balance cost, performance, and customer value." ;
    bpot:hierarchyID "1.2.2.9" ;
    bpot:pcfID "21612" .

bpot:PCF_21613 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate shared services options" ;
    bpot:apqcSourceText "Evaluating options for shared services and support functions. This should include structure, scale, adaptability to change, and alternative delivery models to balance cost, performance, and operational efficiencies." ;
    bpot:hierarchyID "1.2.2.10" ;
    bpot:pcfID "21613" .

bpot:PCF_21614 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate lean/continuous improvement options" ;
    bpot:apqcSourceText "Evaluating options to enhance and optimize processes and functional areas. Understand alternatives to strengthen business capabilities, enhance process efficiencies, and advance performance standards." ;
    bpot:hierarchyID "1.2.2.11" ;
    bpot:pcfID "21614" .

bpot:hierarchyID rdfs:comment "Positional dotted-decimal locator. NON-STABLE across PCF versions." .

<https://fandaws.com/ontology/bpot/catalog> a owl:Ontology ;
    dcterms:creator "Aaron Damiano" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://fandaws.com/ontology/bpo/scheme>,
        "APQC Process Classification Framework (Cross-Industry) v7.4" ;
    dcterms:title "Business Process Ontology -- APQC PCF catalog" ;
    rdfs:comment "Every row of the APQC Process Classification Framework (Cross-Industry, v7.4) as a SKOS concept; the dotted hierarchy as skos:broader. A lossless index of the framework, not a claim about what exists; process classes point at their row with designatesProcessType." ;
    owl:versionIRI <https://fandaws.com/ontology/bpot/0.0.0/catalog.ttl> ;
    owl:versionInfo "0.0.0" .

bpot:PCF_10047 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define strategic options" ;
    bpot:apqcSourceText "Defining the various options available to achieve the goals highlighted in the mission statement. Delineate (in accordance with a predefined criteria) the various permutations of strategic decisions that would help the organization achieve the objectives outlined in Develop overall mission statement [10037]. Involve senior management and key strategy personnel, with timely help from professional services providers." ;
    bpot:hierarchyID "1.2.2.1" ;
    bpot:pcfID "10047" .

bpot:PCF_10083 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assign resources to product/service project" ;
    bpot:apqcSourceText "Allocating resources to the design, development, and evaluation of product/service concepts. Allocate funds, personnel, and time for developing the new and/or revised products/services. Begin to design the potential new product/service concepts that have been prioritized and selected for further development." ;
    bpot:hierarchyID "2.3.1.1" ;
    bpot:pcfID "10083" .

bpot:PCF_10100 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19997 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Install and validate production/service delivery process" ;
    bpot:apqcSourceText "Finalizing production process or methodology. Install and initiate the production process to manufacture the new products, using the equipment and machinery already assembled. In the case of new services, implement delivery processes and methodologies. Validate processes for the accuracy of their operation and proper functioning." ;
    bpot:hierarchyID "2.3.3.4" ;
    bpot:pcfID "10100" .

bpot:PCF_10109 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10106 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify market segments" ;
    bpot:apqcSourceText "Identifying a section of the customer population to target for marketing products/services. Create segments within the customer population for targeted marketing campaigns, which increase the efficacy of marketing outlay. Determine the right customer segments, craft effective marketing messages, and efficiently communicate them. Determine the optimal pricing mix. Consider assistance from professional services for market segmentation studies, with coordination and oversight from the marketing/sales functions." ;
    bpot:hierarchyID "3.1.1.2" ;
    bpot:pcfID "10109" .

bpot:PCF_10117 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10107 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine target segments" ;
    bpot:apqcSourceText "Identifying the targeted segment of customers. Deduce those particular customer segments that are to be targeted from among the market segments. " ;
    bpot:hierarchyID "3.1.2.2" ;
    bpot:pcfID "10117" .

bpot:PCF_10425 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop compensation strategy" ;
    bpot:apqcSourceText "Designing a plan that specifies the combination of wages, salaries, and benefits the employees receive in exchange for work. Define the total amount of compensation, in addition to the manner in which the compensation is paid and the purposes for which employees can receive bonuses, salary increases, and incentives." ;
    bpot:hierarchyID "7.1.2.3" ;
    bpot:pcfID "10425" .

bpot:PCF_10467 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10444 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage/track applicant data" ;
    bpot:apqcSourceText "Keeping track of all the information about the candidates who apply for jobs. Use applicant-tracking systems that can be accessed online as a central location and database for recruitment efforts. " ;
    bpot:hierarchyID "7.2.5.3" ;
    bpot:pcfID "10467" .

bpot:PCF_10508 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21439 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver programs to support work/life balance for employees" ;
    bpot:apqcSourceText "Designing programs that prompt proper balance between work (i.e., career and ambition) and lifestyle (i.e., health, pleasure, leisure, family, and spiritual development/meditation). Account for dependent care, flexible working arrangements, leaves of absence, on-the-job training, etc." ;
    bpot:hierarchyID "7.5.3.1" ;
    bpot:pcfID "10508" .

bpot:PCF_16389 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16387 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze processes" ;
    bpot:apqcSourceText "Assessing and examining the set of activities and tasks that, once completed, will accomplish an organizational goal. Create a business process model that captures how a business process works and how individuals from different groups work together to achieve a business goal." ;
    bpot:hierarchyID "13.1.3.2" ;
    bpot:pcfID "16389" .

bpot:PCF_16395 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16392 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure and report process performance" ;
    bpot:apqcSourceText "Defining and using performance indicators to consider the financial perspective, customer perspective, internal process perspective, and learning perspective of the organization." ;
    bpot:hierarchyID "13.1.4.3" ;
    bpot:pcfID "16395" .

bpot:PCF_16458 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17462 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop mitigation plans for risks" ;
    bpot:apqcSourceText "Developing possibilities and arrangements to improve opportunities and reduce deviations to project objectives." ;
    bpot:hierarchyID "11.1.3.3" ;
    bpot:pcfID "16458" .

bpot:PCF_17055 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Relocate employees and manage assignments" ;
    bpot:apqcSourceText "Managing the relocation of employees in order to carry out assignments. Manage internal business processes to transfer employees, their families, and/or entire departments of a business to a new location." ;
    bpot:hierarchyID "7.6.7" ;
    bpot:pcfID "17055" .

bpot:PCF_20808 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20784 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute IT service/solution creation and testing" ;
    bpot:apqcSourceText "Understanding customer requirements. Design the IT services and solutions based on the requirements. Develop components for providing the requirements. Train resources to provide support. Test the IT services and solutions in advance. Confirm the customer experience post-sale." ;
    bpot:hierarchyID "8.5.4" ;
    bpot:pcfID "20808" .

bpot:PCF_20817 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20784 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform service/solution maintenance and testing" ;
    bpot:apqcSourceText "Engaging in all aspects of service/solution maintenance and testing includes all preventative, routine, and corrective activates. Ensure that IT service/solution are functioning properly and regulations where applicable." ;
    bpot:hierarchyID "8.5.5" ;
    bpot:pcfID "20817" .

bpot:PCF_20880 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and manage service delivery control" ;
    bpot:apqcSourceText "Determine and manage service delivery flow across different business functions. Understand the level of services needed by different stakeholders. Identify major service delivery touch points and criticality associated. Ensure timely communication with users." ;
    bpot:hierarchyID "8.7.3" ;
    bpot:pcfID "20880" .

bpot:PCF_10048 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10038 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess and analyze impact of each option" ;
    bpot:apqcSourceText "Scoping and probing to study the impact of strategic options for fulfilling the organization's objectives. Estimate a measure of the impact effectuated by each set of strategic decisions, which comprise Define strategic options [10047]. Closely examine the consequences of each option." ;
    bpot:hierarchyID "1.2.2.2" ;
    bpot:pcfID "10048" .

bpot:PCF_10058 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10016 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate strategic initiatives" ;
    bpot:apqcSourceText "Examining projects of strategic significance that lie outside the purview of the organization's routine operations. Closely analyze strategic initiatives for their applicability and feasibility, given the organization's vision." ;
    bpot:hierarchyID "1.3.2" ;
    bpot:pcfID "10058" .

bpot:PCF_10059 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10016 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select strategic initiatives" ;
    bpot:apqcSourceText "Selecting relevant projects of strategic significance that create opportunities for the organization to realize its long-term objectives, on the basis of their suitability to the organization's constraints and reality. Select from the process Evaluate strategic initiatives [10058], based on their applicability and feasibility for the organization. Enlist senior management, especially strategy personnel." ;
    bpot:hierarchyID "1.3.3" ;
    bpot:pcfID "10059" .

bpot:PCF_10101 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Understand markets, customers, and capabilities" ;
    bpot:apqcSourceText "Making sense of the market and customers to identify the right opportunities to be capitalized, given the organization's competencies. Discern trends and shift in the market and customers. Identify the right market opportunities that fit closely with the organization's capabilities and strategy by gathering intelligence on various attributes of different market/customer segments." ;
    bpot:hierarchyID "3.1" ;
    bpot:pcfID "10101" .

bpot:PCF_10108 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10106 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct customer and market research" ;
    bpot:apqcSourceText "Carrying out research studies to understand the behavior of customers and the realities of the market. Undertake research to understand the market conditions as well as the characteristics, drives, and desires of prospective customers. Gather highly contextualized intelligence through primary and secondary research methods, with the objective of gaining insights over how to best seize a market opportunity. Consider assistance from professional research services." ;
    bpot:hierarchyID "3.1.1.1" ;
    bpot:pcfID "10108" .

bpot:PCF_10119 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10107 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Validate opportunities" ;
    bpot:apqcSourceText "Confirming the practicability and reasonableness of the market opportunities that have been identified. Give substance to the real-time feasibility of the market opportunities." ;
    bpot:hierarchyID "3.1.2.4" ;
    bpot:pcfID "10119" .

bpot:PCF_10321 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10218 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify and schedule resources to meet service requirements" ;
    bpot:apqcSourceText "Determining and scheduling the resources required to fulfill customer service requirements. Create a detailed schedule about the service orders and development of these service orders. " ;
    bpot:hierarchyID "6.3.4.2" ;
    bpot:pcfID "10321" .

bpot:PCF_10370 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10217 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain production records and manage lot traceability" ;
    bpot:apqcSourceText "Perpetuating the production records by systematically documenting and using it to ensure the effective management of lots. Determine the lot numbering system and its use. (The lot number enables tracking of the constituent parts, as well as labor and equipment records involved in the manufacturing of a product. It enables manufacturers and to perform quality control checks, calculate expiration dates, and issue corrections of their production output.)" ;
    bpot:hierarchyID "4.3.4" ;
    bpot:pcfID "10370" .

bpot:PCF_10474 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10469 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create/maintain employee onboarding program" ;
    bpot:apqcSourceText "Creating and maintaining a mechanism through which new employees acquire the necessary knowledge, skills, and behaviors to become effective organizational members and insiders. Conduct formal meetings, lectures, videos, printed materials, and/or computer-based orientations to introduce newcomers to their new jobs and the organization." ;
    bpot:hierarchyID "7.3.1.1" ;
    bpot:pcfID "10474" .

bpot:PCF_10731 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage fixed-asset project accounting" ;
    bpot:apqcSourceText "Managing accounts for large funds-invested projects. Manage and account for fixed assets projects (capital projects), which required significant capital investments over many years." ;
    bpot:hierarchyID "9.4" ;
    bpot:pcfID "10731" .

bpot:PCF_10736 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage taxes" ;
    bpot:apqcSourceText "Estimating the organization's periodic tax liabilities. Ensure that appropriate taxing authorities receive tax return filings and payments when due." ;
    bpot:hierarchyID "9.9" ;
    bpot:pcfID "10736" .

bpot:PCF_10944 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10937 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide workspace and facilities" ;
    bpot:apqcSourceText "Managing the provision of the workspace and its assets. Arrange an office space with all assets (tables, chairs, computers, admin staff, etc.) according to requirements." ;
    bpot:hierarchyID "10.1.3" ;
    bpot:pcfID "10944" .

bpot:PCF_10949 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10937 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage facilities operations" ;
    bpot:apqcSourceText "Managing all operational activities of the facility. Manage how each function/business unit works. Support the manufacturing facility to attain organizational goals." ;
    bpot:hierarchyID "10.1.4" ;
    bpot:pcfID "10949" .

bpot:PCF_10952 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21576 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop exit strategy" ;
    bpot:apqcSourceText "Creating a strategy for managing asset exits. " ;
    bpot:hierarchyID "10.4.1" ;
    bpot:pcfID "10952" .

bpot:PCF_11012 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10012 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage relations with board of directors" ;
    bpot:apqcSourceText "Maintaining relations with representatives of the stockholders. Establish corporate management-related policies and to make decisions on major company issues. Implement practices designed to engender communication, trust, and cooperation." ;
    bpot:hierarchyID "12.3" ;
    bpot:pcfID "11012" .

bpot:PCF_11047 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Ensure compliance" ;
    bpot:apqcSourceText "Ensuring the organization's compliance position. Validate compliance with different statutes, regulatory directions, and legal principles (using Establish compliance framework and policies [17468]). Coordinate with compliance and risk management personnel." ;
    bpot:hierarchyID "12.4.4" ;
    bpot:pcfID "11047" .

bpot:PCF_11180 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11179 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine environmental health and safety impacts" ;
    bpot:apqcSourceText "Determining the impact of EHS offering--and the procedures it employs to process them--on the environment at large, as well as the health and safety of employees. Evaluate the environmental impact of the organization's products, services, and operations. Conduct health, safety, and environmental audits." ;
    bpot:hierarchyID "13.8.1" ;
    bpot:pcfID "11180" .

bpot:PCF_14208 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10183 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customer master data" ;
    bpot:apqcSourceText "Managing the corpus of data relating all customers acquired over time. Manage the storage, maintenance, access, revision, and usage of all data on customers. Ensure its security, and determine legitimate use cases that are beneficial to the organization." ;
    bpot:hierarchyID "3.5.2.5" ;
    bpot:pcfID "14208" .

bpot:PCF_16384 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and manage process frameworks" ;
    bpot:apqcSourceText "Determining and organizing the structural composition of business processes. Design, establish, and administer the framework. Identify any cross-functional processes that are mandatory for achieving business excellence." ;
    bpot:hierarchyID "13.1.2" ;
    bpot:pcfID "16384" .

bpot:PCF_16629 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product marketing material" ;
    bpot:apqcSourceText "Creating descriptions of products that are promotional and informative in content in order to initiate and increase sales. Marketing content consists of text, and optionally, images." ;
    bpot:hierarchyID "3.3.9" ;
    bpot:pcfID "16629" .

bpot:PCF_17467 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_16437 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage compliance" ;
    bpot:apqcSourceText "Managing steps to confirm enduring compliance to industry regulations and government legislation." ;
    bpot:hierarchyID "11.2" ;
    bpot:pcfID "17467" .

bpot:PCF_17482 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17471 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate performance to requirements" ;
    bpot:apqcSourceText "Analyzing if the performance of the quality plan has achieved the estimated and desired requirements. Conduct tests against the quality plan. Assess the results of these tests." ;
    bpot:hierarchyID "13.3.2" ;
    bpot:pcfID "17482" .

bpot:PCF_19971 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design customer experience support structure" ;
    bpot:apqcSourceText "Creating a roadmap for customer experience support with an overall approach, process flow, and impact timeframe. " ;
    bpot:hierarchyID "1.2.8.3" ;
    bpot:pcfID "19971" .

bpot:PCF_20026 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20025 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish service delivery governance and strategies" ;
    bpot:apqcSourceText "Creating rules and regulations for service delivery to the customer. Establish a system to manage performance, delivery, and direction of service delivery. Engage with the customer for satisfaction feedback. Define goals, policies, processes, and workplace layout and infrastructure as a part of the service delivery strategy." ;
    bpot:hierarchyID "5.1" ;
    bpot:pcfID "20026" .

bpot:PCF_20065 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20059 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify, select, and assign resources" ;
    bpot:apqcSourceText "Identifying, selecting, and assigning resources required to deliver service to the customer. Ensure that all objectives are established and met, and the all rules of engagement have been identified and communicated." ;
    bpot:hierarchyID "5.3.1.6" ;
    bpot:pcfID "20065" .

bpot:PCF_20094 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process returns" ;
    bpot:apqcSourceText "Acquiring returns and identify if the returns are scraped or salvaged." ;
    bpot:hierarchyID "6.2.4" ;
    bpot:pcfID "20094" .

bpot:PCF_20106 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_12658 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage supplier recovery" ;
    bpot:apqcSourceText "Managing the recovery of costs from suppliers for individual claims." ;
    bpot:hierarchyID "6.3.3" ;
    bpot:pcfID "20106" .

bpot:PCF_20132 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage workforce scheduling" ;
    bpot:apqcSourceText "Organizing the workforce so that all positions are covered for all shifts with the necessary skilled resources in place. Have a system in place to backfill positions while an employee is on leave." ;
    bpot:hierarchyID "7.6.6" ;
    bpot:pcfID "20132" .

bpot:PCF_20609 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20608 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Understand IT customer needs" ;
    bpot:apqcSourceText "Assessing the customer communities along with current IT operational capabilities and usage. " ;
    bpot:hierarchyID "8.1.1" ;
    bpot:pcfID "20609" .

bpot:PCF_20776 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20765 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and execute business information lifecycle planning and control" ;
    bpot:apqcSourceText "Develop and implement strategies to plan and manage the flow of an information system's data from creation and initial storage to the time when it becomes obsolete and deleted." ;
    bpot:hierarchyID "8.4.3" ;
    bpot:pcfID "20776" .

bpot:PCF_21439 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10412 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee assistance and retention" ;
    bpot:apqcSourceText "Managing activities centered around delivering programs to support work/life balance for employees; developing family support systems; reviewing retention and motivation indicators; and reviewing compensation plans." ;
    bpot:hierarchyID "7.5.3" ;
    bpot:pcfID "21439" .

bpot:PCF_21574 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10735 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Operate controls and monitor compliance with internal controls policies and procedures" ;
    bpot:apqcSourceText "Performing planning, management, operations, and monitoring of internal control mechanism policies and procedures in order to manage internal controls." ;
    bpot:hierarchyID "9.8.2" ;
    bpot:pcfID "21574" .

bpot:PCF_21585 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21584 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and manage organizational performance strategy" ;
    bpot:apqcSourceText "Creating and implementing a strategy for managing organizational performance. The strategy should include approaches for measuring, tracking, streamlining, and improving internal performance. It encompasses a blueprint for the tactical measurement of internal processes and work force improvement, in alignment with Employee Metrics Developed and Managed [10526]." ;
    bpot:hierarchyID "13.6.1" ;
    bpot:pcfID "21585" .

bpot:PCF_21588 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage sustainability" ;
    bpot:apqcSourceText "Developing and managing sustainability practices for the organization. Ensure proper understanding and communication of ESG standards, requirements, capabilities, and future trends. Promote awareness, alignment, and continuity." ;
    bpot:hierarchyID "13.9" ;
    bpot:pcfID "21588" .

bpot:PCF_21601 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21598 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform sustainability reporting" ;
    bpot:apqcSourceText "Conducting and supporting sustainability reporting. Collect, analyze, and report sustainability performance to requirements. Align reporting across functional units and support teams." ;
    bpot:hierarchyID "13.9.2.3" ;
    bpot:pcfID "21601" .

bpot:PCF_10018 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Survey market and determine customer needs and wants" ;
    bpot:apqcSourceText "Examining the market to identify customer required solutions. Assess the relevant market(s) to determine the products/services that are needed or wanted by customers. Carry out quantitative and qualitative analyses to capture and investigate products/services. Employ creative techniques that allow for a closer appreciation of the customer, and design relevant solutions." ;
    bpot:hierarchyID "1.1.2" ;
    bpot:pcfID "10018" .

bpot:PCF_10020 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish strategic vision" ;
    bpot:apqcSourceText "Establishing the organization's long-term vision as a strategic positioning and engagement of stakeholders. Institute the vision by creating strategic orientations of all stakeholders. Understand the strategy development frameworks in this context." ;
    bpot:hierarchyID "1.1.4" ;
    bpot:pcfID "10020" .

bpot:PCF_10037 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop overall mission statement" ;
    bpot:apqcSourceText "Establishing an overarching, compact statement that concisely underscores the mission of the organization. Define and communicate a clear and succinct mission statement, which encapsulates how the organization aims to proceed in order to Establish a strategic vision [10020]. Solicit critical inputs from senior management and strategy executives, and collaborate with marketing or personnel from allied functions." ;
    bpot:hierarchyID "1.2.1" ;
    bpot:pcfID "10037" .

bpot:PCF_10042 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and set organizational objectives" ;
    bpot:apqcSourceText "Developing overall goals for the organization that help in accomplishing its mission. Formulate organization-wide targets in the near to middle term, which will accumulate and propel the organization to realize its long-term objectives, as outlined in Develop an overall mission statement [10037]. Enlist business unit heads or equivalent personnel, in close collaboration with senior management executives." ;
    bpot:hierarchyID "1.2.6" ;
    bpot:pcfID "10042" .

bpot:PCF_10043 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Formulate business unit strategies" ;
    bpot:apqcSourceText "Charting a strategic course for business units in order to leverage opportunities, sidestep hurdles, and create synergies among each other. Create strategic road maps for the organization's units--in light of their individual resources and requirements, as well as their relationships with other business units--to achieve organizational goals." ;
    bpot:hierarchyID "1.2.7" ;
    bpot:pcfID "10043" .

bpot:PCF_10057 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10016 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop strategic initiatives" ;
    bpot:apqcSourceText "Developing strategic projects that help fulfill long-term goals. Develop time-bound projects that are discretionary in nature and lie beyond the scope of the organization's routine operations." ;
    bpot:hierarchyID "1.3.1" ;
    bpot:pcfID "10057" .

bpot:PCF_10060 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10016 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish high-level measures" ;
    bpot:apqcSourceText "Devising measures to examine strategic projects. Formulate evaluation criteria to assess the strategic initiatives for the level of impact." ;
    bpot:hierarchyID "1.3.4" ;
    bpot:pcfID "10060" .

bpot:PCF_10062 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10003 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop products and services" ;
    bpot:apqcSourceText "Developing new products/services from scratch, including all activities associated with the design, prototyping, evaluation, and market testing of these planned offerings." ;
    bpot:hierarchyID "2.3" ;
    bpot:pcfID "10062" .

bpot:PCF_10065 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19698 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform discovery research" ;
    bpot:apqcSourceText "Coordinating R&D activity to identify new technologies to integrate into the revamped portfolio of products/services. Conduct early-stage R&D activity to close gaps between existing solution offerings and changing market expectations. Triangulate appropriate technologies that can support the development of a revised product/service portfolio." ;
    bpot:hierarchyID "2.2.1" ;
    bpot:pcfID "10065" .

bpot:PCF_10211 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10187 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide sales and product/service training to sales partners/alliances" ;
    bpot:apqcSourceText "Imparting guidance and instruction to sales partners/alliances concerning products/services. Distribute literature about the organization's products/services. Conduct workshops. Disseminate useful media content to engage and enlighten partners. Create communities through group engagements." ;
    bpot:hierarchyID "3.5.5.1" ;
    bpot:pcfID "10211" .

bpot:PCF_10224 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create and manage master production schedule" ;
    bpot:apqcSourceText "Taking care of the master production plan. The master production includes creation and implementation of the site-level production plan, as well as management of the inventory that is currently in the production process." ;
    bpot:hierarchyID "4.1.4" ;
    bpot:pcfID "10224" .

bpot:PCF_10227 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review distribution planning policies" ;
    bpot:apqcSourceText "Revisiting and refurbishing the policies for planning the distribution process. Asses the distribution strategies, including how the products are to be made available and sent to different distributors. Set guidelines regarding relationships between the sources and the distribution centers." ;
    bpot:hierarchyID "4.1.7" ;
    bpot:pcfID "10227" .

bpot:PCF_10320 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10218 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Confirm specific service requirements for individual customer" ;
    bpot:apqcSourceText "Acquiring or soliciting information about specific service requirements for individual customers through the customer service function. Obtain information about customer specific requests, process these requests, and create customer profiles to generate a service order." ;
    bpot:hierarchyID "6.3.4.1" ;
    bpot:pcfID "10320" .

bpot:PCF_10322 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10218 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide service to specific customers" ;
    bpot:apqcSourceText "Dispatching resources for managing and fulfilling daily service requirements. Manage the progress of order fulfillment. Complete order blocks. " ;
    bpot:hierarchyID "6.3.4.3" ;
    bpot:pcfID "10322" .

bpot:PCF_10368 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop quality standards and procedures" ;
    bpot:apqcSourceText "Developing standards and procedures for maintaining the quality of products/services. Establish desired quality targets. Create standardized procedures for the quality. Ensure quality specifications are effectively communicated." ;
    bpot:hierarchyID "4.1.8" ;
    bpot:pcfID "10368" .

bpot:PCF_10401 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20595 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure customer satisfaction with customer problems, requests, and inquiries handling" ;
    bpot:apqcSourceText "Calculating satisfaction levels of customers by effectively evaluating the process of handling requests/inquiries of customers. Effectively calculate the performance of customer-requests/inquiries handling and resolution. Obtain information regarding requests/inquiries handling and resolution through customer feedback. Use it to explore new ideas and opportunities for enhanced customer requests/inquiries handling and resolution process." ;
    bpot:hierarchyID "6.5.1" ;
    bpot:pcfID "10401" .

bpot:PCF_10402 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20595 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure customer satisfaction with customer- complaint handling and resolution" ;
    bpot:apqcSourceText "Measuring the satisfaction level of customers as pertains to how their complaints are handled and resolved. This process element requires the organization to estimate the customers level of fulfillment with the process reconciling their complaints and towards the objective of ensuring customer retention. The feedback received can be used to develop concepts for new opportunities to boost the level of customer satisfaction." ;
    bpot:hierarchyID "6.5.2" ;
    bpot:pcfID "10402" .

bpot:PCF_10443 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage new hire/re-hire" ;
    bpot:apqcSourceText "Creating and making job offers to the selected candidates. Fairly negotiate the job offers. Agree on terms with the candidate to complete the hiring process." ;
    bpot:hierarchyID "7.2.4" ;
    bpot:pcfID "10443" .

bpot:PCF_10469 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20599 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee orientation and deployment" ;
    bpot:apqcSourceText "Creating and maintaining various employee on-boarding programs typically known as induction programs in order to ensure that the new employees are effectively introduced to the organization and its existing employees. Examine and evaluate the performance of these induction programs. Execute these programs on the ground level." ;
    bpot:hierarchyID "7.3.1" ;
    bpot:pcfID "10469" .

bpot:PCF_10472 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20599 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee career development" ;
    bpot:apqcSourceText "Establishing employee development guidelines. Lay out career paths and plans for them. Manage the development of their skills to enhance their skills, ability, and knowledge." ;
    bpot:hierarchyID "7.3.3" ;
    bpot:pcfID "10472" .

bpot:PCF_10732 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process payroll" ;
    bpot:apqcSourceText "Handling reporting time, managing pay, and processing taxes from salaries. Pay employees. Withhold taxes. Confirm the correct funds are paid to the correct government agency." ;
    bpot:hierarchyID "9.5" ;
    bpot:pcfID "10732" .

bpot:PCF_10733 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process accounts payable and expense reimbursements" ;
    bpot:apqcSourceText "Handling bills and reimbursements to be made. Make payments for goods or services taken or used on behalf of the organization." ;
    bpot:hierarchyID "9.6" ;
    bpot:pcfID "10733" .

bpot:PCF_10735 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage internal controls" ;
    bpot:apqcSourceText "Administering internal controls. This process requires the organization to manage entity's board of trustees, management, and other personnel in order to offer judicious assurance about the achievement of effectiveness, proficiency of operations, and reliability of financial reporting." ;
    bpot:hierarchyID "9.8" ;
    bpot:pcfID "10735" .

bpot:PCF_10765 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10736 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop tax strategy and plan" ;
    bpot:apqcSourceText "Setting targets for periodic tax liabilities. Assess the tax impact of various activities such as the acquisition or disposal of fixed assets or a deliberate change in number of employee." ;
    bpot:hierarchyID "9.9.1" ;
    bpot:pcfID "10765" .

bpot:PCF_10941 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10937 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop property strategy and long term vision" ;
    bpot:apqcSourceText "Strategizing a long-term vision for managing properties. Prepare strategies and a long-term vision for managing purchased/retained properties." ;
    bpot:hierarchyID "10.1.1" ;
    bpot:pcfID "10941" .

bpot:PCF_11010 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10012 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Build investor relationships" ;
    bpot:apqcSourceText "Creating a strategic management responsibility for integrating finance, communication, marketing, and securities law compliance. Allow the most effective two-way communication among the organization, the financial community, and other constituencies. Enlist the investor relations function to provide market intelligence to corporate management." ;
    bpot:hierarchyID "12.1" ;
    bpot:pcfID "11010" .

bpot:PCF_11040 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11011 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage relations with trade or industry groups" ;
    bpot:apqcSourceText "Managing relations with organizations established and financed by businesses that operate in a specific industry. Participate in public relations actions such as lobbying and publishing, advertising, education, and political donations." ;
    bpot:hierarchyID "12.2.3" ;
    bpot:pcfID "11040" .

bpot:PCF_11096 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11073 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess KM capabilities" ;
    bpot:apqcSourceText "Assessing the maturity of the existing initiatives in knowledge management, and evaluating existing KM approaches. Identify the gaps and needs in order to enhance the existing KM approaches. Develop and implement new KM approaches." ;
    bpot:hierarchyID "13.5.2" ;
    bpot:pcfID "11096" .

bpot:PCF_11137 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11074 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Sustain improvement" ;
    bpot:apqcSourceText "Sustaining the impact of the change process in order to enact continual process improvement. Monitor the performance of re-engineered business processes. Identify best practices and potential issues. Effectuate remedial steps." ;
    bpot:hierarchyID "13.4.4" ;
    bpot:pcfID "11137" .

bpot:PCF_11179 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage environmental health and safety (EHS)" ;
    bpot:apqcSourceText "Determining the impacts of environmental health and safety. Create and implement the EHS program. Train and educate employees of the EHS function. Oversee and manage the EHS program. " ;
    bpot:hierarchyID "13.8" ;
    bpot:pcfID "11179" .

bpot:PCF_12771 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19985 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage regulatory requirements" ;
    bpot:apqcSourceText "Aligning regulatory activities related to managing industry requirements. Train employees on regulatory requirements. Records for the appropriate regulatory agencies must be maintained and the new product process must be approved by the appropriate regulatory body before it is published to the organization. The submission lifecycle - i.e. creation, review, and approval of the submission and its components must be managed in a collaborative fashion." ;
    bpot:hierarchyID "2.1.3.5" ;
    bpot:pcfID "12771" .

bpot:PCF_16392 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage process performance" ;
    bpot:apqcSourceText "Evaluating and handling the performance of business processes. Provide training to process owners. Support the execution of business processes. Measure and report the performance of the business processes." ;
    bpot:hierarchyID "13.1.4" ;
    bpot:pcfID "16392" .

bpot:PCF_16400 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage portfolio, program, and project" ;
    bpot:apqcSourceText "Managing investments, holdings, products, businesses, and brands, along with the related projects that together constitute a program." ;
    bpot:hierarchyID "13.2" ;
    bpot:pcfID "16400" .

bpot:PCF_16401 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16400 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage portfolio" ;
    bpot:apqcSourceText "Managing the business portfolio of the organization, including investments, holdings, products, businesses, and brands. Establish a portfolio strategy. Define portfolio governance. Monitor and control the portfolio." ;
    bpot:hierarchyID "13.2.1" ;
    bpot:pcfID "16401" .

bpot:PCF_16792 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct organization restructuring opportunities" ;
    bpot:apqcSourceText "Examining the scope and contingencies for restructuring based on market situation and internal realities. Map the market forces over which any and all probabilities can be probed for utility and viability. Once the restructuring options have been analyzed and the due-diligence performed, execute the deal. Consider seeking professional services for assistance in formalizing these opportunities." ;
    bpot:hierarchyID "1.1.5" ;
    bpot:pcfID "16792" .

bpot:PCF_17060 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_16437 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage enterprise risk" ;
    bpot:apqcSourceText "Creating requisite frameworks and coordinating all risk management activities for the entire organization and each function. Manage the enterprise risk by outlining the risk policies and procedures. Monitor and communicate all risk management activities. Encourage correspondence among the business units. Manage the risk of all business units and functions." ;
    bpot:hierarchyID "11.1" ;
    bpot:pcfID "17060" .

bpot:PCF_17483 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17482 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Test against quality plan" ;
    bpot:apqcSourceText "Examining the quality of organizational processes. Conduct tests. Collect information and data. Record the results of these tests. Determine the dispositions of the test results." ;
    bpot:hierarchyID "13.3.2.1" ;
    bpot:pcfID "17483" .

bpot:PCF_19209 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21575 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage capital program for assets" ;
    bpot:apqcSourceText "Producing and maintaining a planning schedule and a financial plan to purchase or manufacture productive assets. Determine the investment plan, monitor capital, and secure the necessary financing in order to realize completion of the program." ;
    bpot:hierarchyID "10.2.1" ;
    bpot:pcfID "19209" .

bpot:PCF_19238 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_19207 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain assets" ;
    bpot:apqcSourceText "Preserving productive assets through the planning, managing, and performance of preventative, routine, and critical maintenance work. " ;
    bpot:hierarchyID "10.3" ;
    bpot:pcfID "19238" .

bpot:PCF_19698 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10003 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate and define new product/service ideas" ;
    bpot:apqcSourceText "Identifying and describing new product or service thoughts based on organizational objectives/targets." ;
    bpot:hierarchyID "2.2" ;
    bpot:pcfID "19698" .

bpot:PCF_19960 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess customer experience" ;
    bpot:apqcSourceText "Measuring customer feedback in regard to product and services effectiveness based on overall satisfaction. The data to be analyzed is collected through surveys, customer responses, and feedbacks based on the delivered products/services." ;
    bpot:hierarchyID "1.2.8.1" ;
    bpot:pcfID "19960" .

bpot:PCF_19990 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19698 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define product/service development requirements" ;
    bpot:apqcSourceText "Encompassing the identification and capture of new product/service requirements or potential improvements to current products/services. Collaborating with members of the supply chain to ensure the feasibility of what is being defined in the requirements. For example, a product with manufacturing requirements that supply chain cannot currently fulfill requires a corporate decision to either upgrade manufacturing capabilities or abandon the new product. Enterprise-level effects and needs must be considered. Depending on the nature of the final product or service, these requirements are often defined as a set of abilities, such as availability or reliability, that influence product development decisions." ;
    bpot:hierarchyID "2.2.3" ;
    bpot:pcfID "19990" .

bpot:PCF_20004 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20000 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Orchestrate seamless customer experience across supported channels" ;
    bpot:apqcSourceText "Coordinating marketing and distribution efforts across different channels that integrate well with each other, are in conformance with company values, visual identity and branding, and offer uniform customer service experience that drives customer loyalty and repeat business." ;
    bpot:hierarchyID "3.2.3.7" ;
    bpot:pcfID "20004" .

bpot:PCF_20040 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20025 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage service delivery resources" ;
    bpot:apqcSourceText "Understanding the demands on resources and creating a plan to enable the delivery of services via those resources." ;
    bpot:hierarchyID "5.2" ;
    bpot:pcfID "20040" .

bpot:PCF_20058 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20025 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver service to customer" ;
    bpot:apqcSourceText "Rendering service to the customer by initiating, executing, and completing tasks associated with service delivery." ;
    bpot:hierarchyID "5.3" ;
    bpot:pcfID "20058" .

bpot:PCF_20731 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and manage IT continuity" ;
    bpot:apqcSourceText "Planning and managing IT's ability to recover from exposure to internal and external threats." ;
    bpot:hierarchyID "8.3.4" ;
    bpot:pcfID "20731" .

bpot:PCF_20766 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20765 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define business information and analytics strategy" ;
    bpot:apqcSourceText "Create an organization-wide strategy for the IT function by combining skills, technologies, applications, and processes in order to attain organizations objectives." ;
    bpot:hierarchyID "8.4.1" ;
    bpot:pcfID "20766" .

bpot:PCF_20944 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10002 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and maintain business models" ;
    bpot:apqcSourceText "Establishing how an organization creates, delivers and captures value or makes profit. Identify the products or services that a business will sell, its target market, anticipated expenses, and other core aspects of its modus operandi. Revise the plan as required to reflect changing circumstances." ;
    bpot:hierarchyID "1.4" ;
    bpot:pcfID "20944" .

bpot:PCF_20969 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11073 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evolve and sustain KM capabilities" ;
    bpot:apqcSourceText "Developing resources for improved knowledge management and knowledge engineering." ;
    bpot:hierarchyID "13.5.4" ;
    bpot:pcfID "20969" .

bpot:PCF_21447 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement workforce analytics" ;
    bpot:apqcSourceText "Transform, develop, and communicate workforce data into analytics in support of organizational requirements.  " ;
    bpot:hierarchyID "7.7.8" ;
    bpot:pcfID "21447" .

bpot:PCF_21451 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee communication" ;
    bpot:apqcSourceText "Creating an effective plan that initiates and promotes communication and engagement among the employees and between employees and management." ;
    bpot:hierarchyID "7.8" ;
    bpot:pcfID "21451" .

bpot:PCF_21584 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure and benchmark" ;
    bpot:apqcSourceText "Defining and managing measurement and benchmarking. Measure and benchmark the performance of internal processes, as well as the organization as a whole." ;
    bpot:hierarchyID "13.6" ;
    bpot:pcfID "21584" .

bpot:PCF_21590 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21589 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify sustainability requirements" ;
    bpot:apqcSourceText "Identifying, documenting, and communicating sustainability requirements. Closely examine all standards and matters of compliance relating to ESG. Determine protocols or standards to comply with, set by regulatory agencies or the organizations stakeholders." ;
    bpot:hierarchyID "13.9.1.1" ;
    bpot:pcfID "21590" .

bpot:PCF_21598 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21588 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage sustainability capability" ;
    bpot:apqcSourceText "Managing sustainability across the organization. Provide training, support, reporting, and oversight to the distributed sustainability efforts across functional units and support services." ;
    bpot:hierarchyID "13.9.2" ;
    bpot:pcfID "21598" .

bpot:PCF_10003 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and Manage Products and Services" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Detailing practices and procedures related to the concept of developing and managing products and services. These are reflected in the process groups Govern and manage product/service development program [19696], Generate and define new product/service ideas [19698], and Develop products and services [10062]." ;
    bpot:hierarchyID "2.0" ;
    bpot:pcfID "10003" .

bpot:PCF_10107 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10101 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate and prioritize market opportunities" ;
    bpot:apqcSourceText "Appraising market opportunities by quantifying and subjecting them to prioritization, as well as validation tests. Closely examine the market opportunities that have been identified by Perform customer and market intelligence analysis [10106]. Triangulate those opportunities to capitalize by finding a fit between identified opportunities and the composite of organizational capabilities and business strategy." ;
    bpot:hierarchyID "3.1.2" ;
    bpot:pcfID "10107" .

bpot:PCF_10123 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10102 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define pricing strategy" ;
    bpot:apqcSourceText "Creating a pricing strategy and mechanism that aligns with the benefits of the products/services, as perceived by customers. Chart a strategic course and a methodology that can guide the pricing of products/services. Draw heavily from the customer value proposition, and balance the expectations of different divisions inside the organization, while delivering the maximum ROI." ;
    bpot:hierarchyID "3.2.2" ;
    bpot:pcfID "10123" .

bpot:PCF_10129 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10103 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop sales forecast" ;
    bpot:apqcSourceText "Developing a sales forecast for the organization's portfolio of offerings, bearing in mind the effect of promotional events, and fine-tuning these in the context of the new forecast. Estimate the future demand for the organization's products/services by analyzing historical information and any promotional activity." ;
    bpot:hierarchyID "3.4.1" ;
    bpot:pcfID "10129" .

bpot:PCF_10149 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish marketing budgets" ;
    bpot:apqcSourceText "Creating a budget for the organization's marketing efforts, in line with the business-wide strategic outlook. Create a plan to distribute resources for achieving the marketing strategy in light of the overall business strategy. Make cost assumptions; calculate the estimated total revenue from the marketing activities against the costs/expenses of these activities. Forecast the return on investment. Attribute costs to the appropriate marketing activities such as promotional campaigns, advertising, marketing communications, PR campaigns, personnel, and office space. Enlist the financial and marketing functions." ;
    bpot:hierarchyID "3.3.2" ;
    bpot:pcfID "10149" .

bpot:PCF_10154 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage packaging strategy" ;
    bpot:apqcSourceText "Creating, executing, and administering a strategic road map for packaging products/services. Determine how to package products/services into finished offerings that can be directly marketed to prospective customers. Consider physicality, perishability, and shelf-life. Develop a strategy for packaging products/services. Test alternatives. Collect feedback. Refine the option chosen for execution. Have marketing, product development, and supply chain functions work together to develop sound packaging." ;
    bpot:hierarchyID "3.3.7" ;
    bpot:pcfID "10154" .

bpot:PCF_10187 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage sales partners and alliances" ;
    bpot:apqcSourceText "Managing the organization's partners and alliances, with the objective of maximizing revenue. Train partners regarding the organization's portfolio of products/services. Craft sales forecasts. Examine their performance. Manage all data held by the organization on these partners." ;
    bpot:hierarchyID "3.5.5" ;
    bpot:pcfID "10187" .

bpot:PCF_10216 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20022 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Procure materials and services" ;
    bpot:apqcSourceText "Creating a plan for procuring materials and services. Develop strategies for sourcing materials and services. Choose the most appropriate suppliers, and develop contracts with them. Order the materials and services as per the requirements. Manage relationships with suppliers." ;
    bpot:hierarchyID "4.2" ;
    bpot:pcfID "10216" .

bpot:PCF_10217 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20022 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Produce/Assemble/Test product" ;
    bpot:apqcSourceText "Processing and delivering the finished goods manufactured by the organization. Schedule the production of products. Execute the product production activities. Perform tests to oversee and ensure quality of production. Maintain records of the production process. Track lots." ;
    bpot:hierarchyID "4.3" ;
    bpot:pcfID "10217" .

bpot:PCF_10218 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_12658 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Service products" ;
    bpot:apqcSourceText "Validating specific service requirements for individual customers. Determine and schedule resource to fulfill these requirements. Provide service to specific individual customers. Ensure the quality of service delivery." ;
    bpot:hierarchyID "6.3.4" ;
    bpot:pcfID "10218" .

bpot:PCF_10219 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20022 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage logistics and warehousing" ;
    bpot:apqcSourceText "Administering and overseeing all activities related to logistics and warehousing. Outline and establish a strategy for the logistics function. Plan and administer the flow of inbound materials. Administer the operational activities of warehousing and outbound transportation. Manage reverse logistics including returns and exchanges." ;
    bpot:hierarchyID "4.4" ;
    bpot:pcfID "10219" .

bpot:PCF_10226 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish distribution planning constraints" ;
    bpot:apqcSourceText "Instituting the constraints for planning of distribution process. Create a plan that specifies every element in the distribution process from the blueprint of the distribution centers to how and when the inventory would reach the distribution centers." ;
    bpot:hierarchyID "4.1.6" ;
    bpot:pcfID "10226" .

bpot:PCF_10278 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select suppliers and develop/maintain contracts" ;
    bpot:apqcSourceText "Evaluating supplier options to select the most effective and efficient suppliers. Validate selected suppliers. Establish and manage supplier contracts." ;
    bpot:hierarchyID "4.2.2" ;
    bpot:pcfID "10278" .

bpot:PCF_10280 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage suppliers" ;
    bpot:apqcSourceText "Collecting and analyzing new information in order to track and rate suppliers through a supplier information management system." ;
    bpot:hierarchyID "4.2.4" ;
    bpot:pcfID "10280" .

bpot:PCF_10323 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10218 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Ensure quality of service" ;
    bpot:apqcSourceText "Guaranteeing the quality of service provided to customers. Identify the successful and unsuccessful orders along with the service failures. Collect customer feedback. Process the feedback to ensure the quality of service in the future. " ;
    bpot:hierarchyID "6.3.4.4" ;
    bpot:pcfID "10323" .

bpot:PCF_10341 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10219 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Operate outbound transportation" ;
    bpot:apqcSourceText "Creating a plan that specifies the schedule and system for transportation and delivery of the outbound products, as well as tracking the performance of the carrier delivery system. Conduct vehicle management and processing of all carrier-related documents." ;
    bpot:hierarchyID "4.4.4" ;
    bpot:pcfID "10341" .

bpot:PCF_10387 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and manage customer service work force" ;
    bpot:apqcSourceText "Creating and administering the work force deployed for the customer service process. Forecast the customer work force needs to correctly schedule the work force. Track the utility of the work force deployed. Examine the interactions between the customer and customer service representatives to achieve high quality." ;
    bpot:hierarchyID "6.2.1" ;
    bpot:pcfID "10387" .

bpot:PCF_10412 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reward and retain employees" ;
    bpot:apqcSourceText "Creating frameworks for rewarding and recognizing employees with the objective of retaining them. Create and manage programs for provision of rewards, recognition, and motivation. Manage and administer the benefits for employees. Help assist and retain employees. Administer payroll to employees." ;
    bpot:hierarchyID "7.5" ;
    bpot:pcfID "10412" .

bpot:PCF_10417 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17043 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and update strategy, plans, and policies" ;
    bpot:apqcSourceText "Supervising the HR strategy, plans, and policies in order to refurbish them whenever needed. Determine the performance of HR plans and policies by measuring the objective achievement rate and its contribution to the overall business strategy. Ensure that information about these plans and strategies is effectively communicated to various stakeholders. Incorporate any suggestions by these stakeholders when revising HR plans and policies." ;
    bpot:hierarchyID "7.1.3" ;
    bpot:pcfID "10417" .

bpot:PCF_10444 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage applicant information" ;
    bpot:apqcSourceText "Creating and maintaining a system for managing the information of applicants. Create records for all candidates who apply. Maintain and track information through the use applicant-tracking systems." ;
    bpot:hierarchyID "7.2.5" ;
    bpot:pcfID "10444" .

bpot:PCF_10470 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20599 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee performance" ;
    bpot:apqcSourceText "Defining individual performance objectives. Review performance in order to provide appraisals. Evaluate the efficiency and effectiveness of the current performance program. Update it regularly." ;
    bpot:hierarchyID "7.3.2" ;
    bpot:pcfID "10470" .

bpot:PCF_10495 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10412 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage and administer benefits" ;
    bpot:apqcSourceText "Managing and ensuring benefits enrollment by the employees. Process any benefit claims made by the employees. Balance the estimated amount and entitled amount of benefits." ;
    bpot:hierarchyID "7.5.2" ;
    bpot:pcfID "10495" .

bpot:PCF_10728 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform planning and management accounting" ;
    bpot:apqcSourceText "Determining different stages of the planning process and accounting. Classify, determine, analyze, interpret, and communicate information to make up-to-date business decisions for better management and control functions." ;
    bpot:hierarchyID "9.1" ;
    bpot:pcfID "10728" .

bpot:PCF_10730 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform general accounting and reporting" ;
    bpot:apqcSourceText "Making statements about business activities and functions. Prepare financial statements (balance sheet, income statement, statement of cash flows, and statement of stockholders' equity) according to accounting concepts and principles." ;
    bpot:hierarchyID "9.3" ;
    bpot:pcfID "10730" .

bpot:PCF_10737 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage international funds/consolidation" ;
    bpot:apqcSourceText "Managing cash collections and disbursements made by operating units across the enterprise. When appropriate, transfer cash from the operating units to parent-level bank accounts managed by the organization's treasury team." ;
    bpot:hierarchyID "9.10" ;
    bpot:pcfID "10737" .

bpot:PCF_10740 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10728 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform cost management" ;
    bpot:apqcSourceText "Deciding which expenses can be avoided to reduce some costs and increase revenues. Plan and control the organization's budget to forecast future expenditures. " ;
    bpot:hierarchyID "9.1.3" ;
    bpot:pcfID "10740" .

bpot:PCF_10751 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10731 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform capital planning and project approval" ;
    bpot:apqcSourceText "Preparing a project finance report to solicit approvals in capital projects. Prepare budgets for projects that require heavy investments. Report on project finances to solicit approvals from management." ;
    bpot:hierarchyID "9.4.1" ;
    bpot:pcfID "10751" .

bpot:PCF_10764 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10735 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report on internal controls compliance" ;
    bpot:apqcSourceText "Reporting on internal controls compliance to the appropriate authority, including IT regulations and pertinent data." ;
    bpot:hierarchyID "9.8.3" ;
    bpot:pcfID "10764" .

bpot:PCF_10937 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_19207 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and acquire assets" ;
    bpot:apqcSourceText "Planning, acquiring, and managing facilities, workspaces, and supporting assets. Acquire, configure, and manage facilities and workspaces, to include supporting equipment and materials." ;
    bpot:hierarchyID "10.1" ;
    bpot:pcfID "10937" .

bpot:PCF_11011 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10012 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage government and industry relationships" ;
    bpot:apqcSourceText "Creating and maintaining relationships with government and industry representatives. " ;
    bpot:hierarchyID "12.2" ;
    bpot:pcfID "11011" .

bpot:PCF_11039 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11011 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage relations with quasi-government bodies" ;
    bpot:apqcSourceText "Managing relations with quasi-governmental organizations, corporations, businesses, or any other agency that is treated by national laws and principles to be under the supervision of the government but also distinct and self-directed from the government." ;
    bpot:hierarchyID "12.2.2" ;
    bpot:pcfID "11039" .

bpot:PCF_11049 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Protect intellectual property" ;
    bpot:apqcSourceText "Safeguarding the intellectual property of the organization. This process requires the organization to protect a wide variety of intellectual property created by it. It involves creating and managing non-disclosure agreements (NDAs), following up on current developments in the areas where the organization holds patents, tracking the use of the organization's copyrighted material, creating and upholding licensing terms, and administering policies for safeguarding intellectual property." ;
    bpot:hierarchyID "12.4.6" ;
    bpot:pcfID "11049" .

bpot:PCF_11073 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage enterprise-wide knowledge management (KM) capability" ;
    bpot:apqcSourceText "Creating and administering the capability of the organization's knowledge management function. Develop a strategy for knowledge management. Assess capabilities of the knowledge management function. " ;
    bpot:hierarchyID "13.5" ;
    bpot:pcfID "11073" .

bpot:PCF_11074 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage change" ;
    bpot:apqcSourceText "Planning, designing, and implementing the change. Ensure improvement in the change process." ;
    bpot:hierarchyID "13.4" ;
    bpot:pcfID "11074" .

bpot:PCF_11168 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10102 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define offering and customer value proposition" ;
    bpot:apqcSourceText "Refining the attributes of organizational offerings to define their value proposition for the customer. Clearly define the suite of offerings in terms of the value delivered, from the perspective of what the customer desires. Validate the benefits delivered to the customers against target market segments, using techniques such as minimum viable product. Position brands for the respective products/services, in line with their unique value proposition and aligned with customers needs." ;
    bpot:hierarchyID "3.2.1" ;
    bpot:pcfID "11168" .

bpot:PCF_11181 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11179 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop EHS program" ;
    bpot:apqcSourceText "Identify the requirements for regulation and shareholders. Assess future risks and opportunities. Develop a policy for the EHS program. Record and manage EHS program events." ;
    bpot:hierarchyID "13.8.2" ;
    bpot:pcfID "11181" .

bpot:PCF_11209 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11208 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage interest rate risk" ;
    bpot:apqcSourceText "Handling risks arising from changes in the interest rate. " ;
    bpot:hierarchyID "9.7.5.2" ;
    bpot:pcfID "11209" .

bpot:PCF_11211 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11208 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage exposure risk" ;
    bpot:apqcSourceText "Taking care of exposure risks. Maintain financial investments in particular investments or a portfolios that could be risky for the organization." ;
    bpot:hierarchyID "9.7.5.4" ;
    bpot:pcfID "11211" .

bpot:PCF_12658 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20085 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Service products after sales" ;
    bpot:apqcSourceText "Assigning post-sales policies and paying claims on purchased products.  This is a process that is an administrative function focused on creating rules (claim codes). This group ensures that claims are valid and are processed quickly.  As well as to quickly determine responsibility for claim settlement. " ;
    bpot:hierarchyID "6.3" ;
    bpot:pcfID "12658" .

bpot:PCF_16379 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish and maintain process management governance" ;
    bpot:apqcSourceText "Defining and managing the organization's approach to governing business process management. Establish and manage tools to support the governance process. Assign ownership for all business processes. Perform activities to administer the governing process." ;
    bpot:hierarchyID "13.1.1" ;
    bpot:pcfID "16379" .

bpot:PCF_16405 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16400 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage programs" ;
    bpot:apqcSourceText "Establishing, implementing, and managing business programs. Successfully handle related projects that together constitute a program. Establish the program structure and approach. Coordinate with stakeholders and partners. Execute the program. Assess and report the performance of the program. Coordinate and prioritize resources across projects. Manage links between the projects and the overall costs and risks of the program." ;
    bpot:hierarchyID "13.2.2" ;
    bpot:pcfID "16405" .

bpot:PCF_16795 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16792 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze deal options" ;
    bpot:apqcSourceText "Examining various options shortlisted for assimilating new entities into the organization or dissociating from it. Undertake a piecemeal and comprehensive consideration of each option identified for acquisition, merger, de-merger, and divestment. Consider intangible and non-material aspects of the entities involved and synergic aspects. Consider the assistance of specialist professional services." ;
    bpot:hierarchyID "1.1.5.3" ;
    bpot:pcfID "16795" .

bpot:PCF_17043 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage human resources planning, policies, and strategies" ;
    bpot:apqcSourceText "Creating strategies for the HR function. Create and implement strategies for managing the work force. Supervise and enhance the strategies, plans, and policies supporting the HR function. Developing models for managing competency levels of the HR of the organization." ;
    bpot:hierarchyID "7.1" ;
    bpot:pcfID "17043" .

bpot:PCF_17468 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17467 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish compliance framework and policies" ;
    bpot:apqcSourceText "Developing a set of procedures detailing an organization's progress in complying with established guidelines, provisions, and legislation." ;
    bpot:hierarchyID "11.2.1" ;
    bpot:pcfID "17468" .

bpot:PCF_17471 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage enterprise quality" ;
    bpot:apqcSourceText "Managing organizational attributes that are closely associated with the quality of output. Determine the quality requirements. Evaluate the correspondence between the quality performance and requirements. Manage non-conformance activities. Ensure implementation and maintenance of the enterprise quality management system. " ;
    bpot:hierarchyID "13.3" ;
    bpot:pcfID "17471" .

bpot:PCF_17475 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17472 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop quality controls" ;
    bpot:apqcSourceText "Developing controls for managing the quality of enterprise. Define the process steps for quality controls and the sampling plan. Identify the tools and methods to measure quality. Define the competencies required. " ;
    bpot:hierarchyID "13.3.1.3" ;
    bpot:pcfID "17475" .

bpot:PCF_17487 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17482 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess results of tests" ;
    bpot:apqcSourceText "Assessing the significance of the sample. Summarize the results of the test. Recommend improvement actions. Decide what steps to take next." ;
    bpot:hierarchyID "13.3.2.2" ;
    bpot:pcfID "17487" .

bpot:PCF_19224 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21575 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage asset construction" ;
    bpot:apqcSourceText "Overseeing the performance and quality of work. Assure that records are maintained throughout the construction process. Adhere to all safety, security, and access regulations set forth by the organization and all government standards. " ;
    bpot:hierarchyID "10.2.4" ;
    bpot:pcfID "19224" .

bpot:PCF_19566 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10304 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and optimize production process" ;
    bpot:apqcSourceText "Integrating different resources in the production process: material, personnel, equipment, robotics, etc. Includes automating and controlling the plant, performing advanced process control and real-time optimization. This activity also includes managing plant alarms and alerts." ;
    bpot:hierarchyID "4.3.2.5" ;
    bpot:pcfID "19566" .

bpot:PCF_19696 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10003 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Govern and manage product/service development program" ;
    bpot:apqcSourceText "Supervising the complete product/service program from innovation until its commercial success. Meeting the customer demand and expectations. Conduct further development and innovation pertaining to business goals." ;
    bpot:hierarchyID "2.1" ;
    bpot:pcfID "19696" .

bpot:PCF_19959 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop customer experience strategy" ;
    bpot:apqcSourceText "Defining a roadmap to meet customer expectations while considering how it will affect the business." ;
    bpot:hierarchyID "1.2.8" ;
    bpot:pcfID "19959" .

bpot:PCF_19996 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10062 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Test market for new or revised products and services" ;
    bpot:apqcSourceText "Expanding on the marketplace analysis that took place earlier in the product development lifecycle by testing the market against offerings. The results from this in-depth analysis will help the organization finalize product/service characteristics and technical requirements and also identify any needed changes in the manufacturing and delivery processes that support market delivery. To prepare a detailed market study that accounts for any changes in the global environment, the organization may want to conduct a series of interviews, workshops, and focus groups with potential and existing customers." ;
    bpot:hierarchyID "2.3.2" ;
    bpot:pcfID "19996" .

bpot:PCF_20025 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver Services" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Offering services to customers. This is the act of providing service delivery as a core business practice and covers identifying strategies for performing service delivery, managing resources, and delivering services to the customer." ;
    bpot:hierarchyID "5.0" ;
    bpot:pcfID "20025" .

bpot:PCF_20027 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20026 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish service delivery governance" ;
    bpot:apqcSourceText "Establishing service delivery governance through a system that manages performance, development, and direction. Allow for customer feedback on delivery satisfaction." ;
    bpot:hierarchyID "5.1.1" ;
    bpot:pcfID "20027" .

bpot:PCF_20109 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20936 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage disposition of returned products" ;
    bpot:apqcSourceText "Determining if a returned product can be salvaged or repaired. Salvage or repair is dependent upon the product, the condition of the product, or the availability of a like item." ;
    bpot:hierarchyID "4.4.2.5" ;
    bpot:pcfID "20109" .

bpot:PCF_20123 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Screen and select candidates" ;
    bpot:apqcSourceText "Evaluating and selecting potential employees through interviews, tests, etc." ;
    bpot:hierarchyID "7.2.3" ;
    bpot:pcfID "20123" .

bpot:PCF_20125 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10473 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage examinations and certifications" ;
    bpot:apqcSourceText "Managing identified training programs for employees. Engage with industries to provide certifications, administer certification test, and maintain active certification." ;
    bpot:hierarchyID "7.3.4.6" ;
    bpot:pcfID "20125" .

bpot:PCF_20599 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee onboarding, training, and development" ;
    bpot:apqcSourceText "Assisting employees in developing their capabilities, and providing them counseling services. Handle the orientation and deployment of the employees. Administer the performance of employees. Administer the development and enhancement of the employees. Provide training and development programs for employees." ;
    bpot:hierarchyID "7.3" ;
    bpot:pcfID "20599" .

bpot:PCF_20612 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20608 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify IT customer transformation needs" ;
    bpot:apqcSourceText "Identifying changing needs of staff dependent on information technology based on continuous improvement to deliver results according to organizational goals." ;
    bpot:hierarchyID "8.1.2" ;
    bpot:pcfID "20612" .

bpot:PCF_20648 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20608 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze service performance" ;
    bpot:apqcSourceText "Proactively manage IT service levels against IT customer requirements." ;
    bpot:hierarchyID "8.1.7" ;
    bpot:pcfID "20648" .

bpot:PCF_20668 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20652 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and maintain enterprise architecture" ;
    bpot:apqcSourceText "Outlining and maintaining the organization's IT architecture. Establish the IT architecture definition and framework. Ensure the relevance of IT. Create and confirm the approach for IT maintenance. Create rules and regulations to guide IT architecture. Authenticate and finalize all IT related research and innovation that takes place within the organization." ;
    bpot:hierarchyID "8.2.3" ;
    bpot:pcfID "20668" .

bpot:PCF_20693 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20652 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage IT value portfolio" ;
    bpot:apqcSourceText "Creating and establishing the value portfolio. Defining, analyzing, and examining the value of projects, investments, and activities of the IT function." ;
    bpot:hierarchyID "8.2.6" ;
    bpot:pcfID "20693" .

bpot:PCF_20716 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop IT resilience strategy" ;
    bpot:apqcSourceText "Developing resilience strategies of IT across the organization so that prospective risks can be avoided." ;
    bpot:hierarchyID "8.3.2" ;
    bpot:pcfID "20716" .

bpot:PCF_20765 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20607 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage information" ;
    bpot:apqcSourceText "Creating strategies to manage the organization's information and content. Outline the architecture for information. Administer information resources. Administer the management of data and content. " ;
    bpot:hierarchyID "8.4" ;
    bpot:pcfID "20765" .

bpot:PCF_20779 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20765 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage business information" ;
    bpot:apqcSourceText "Creating strategies to administer information and content. Understand the needs of the organization for information and content management. Realize the role of IT services for implementing the overall business strategy. Assess the implications of new technologies for managing information and content. Identify and prioritize the most effective and efficient actions for managing information and content." ;
    bpot:hierarchyID "8.4.4" ;
    bpot:pcfID "20779" .

bpot:PCF_20945 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20944 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop business models" ;
    bpot:apqcSourceText "Creating an economic model that describes the goals of an organization and the business processes needed to achieve those goals. This involves information gathering, securing necessary approvals and authorizations, integrating with preexisting models, including the general business concept [10002] and business strategy [10015], and formally accepting the model as the basis for organization's day-to-day operations." ;
    bpot:hierarchyID "1.4.1" ;
    bpot:pcfID "20945" .

bpot:PCF_20950 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20944 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain business models" ;
    bpot:apqcSourceText "Revising and updating business models to reflect the changes in the marketed services, product inventory, market behavior, available resources or accrued expenses. Determine how and when to modify the accepted business model in response to incoming feedback." ;
    bpot:hierarchyID "1.4.2" ;
    bpot:pcfID "20950" .

bpot:PCF_21453 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Improve processes" ;
    bpot:apqcSourceText "Identifying, selecting, and managing improvements. Based on the type and scope of the improvement, determination of the appropriate improvement methodology (e.g., Lean, Six Sigma, etc.) should guide the effort. This includes continuous improvement, process redesign, process reengineering, and application of the organizations approaches for Manage projects." ;
    bpot:hierarchyID "13.1.5" ;
    bpot:pcfID "21453" .

bpot:PCF_21575 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_19207 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and construct assets" ;
    bpot:apqcSourceText "Designing and constructing assets such as machines, tools, factories, etc. Manage steps to acquire assets including managing capital, as well as planning, scheduling, and overseeing acquisition/construction." ;
    bpot:hierarchyID "10.2" ;
    bpot:pcfID "21575" .

bpot:PCF_21582 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21576 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform abandonment" ;
    bpot:apqcSourceText "Planning and performing abandonment activities. Whether facilities  or equipment, ensure assets to be abandoned are safe, secure, and meet all legal, regulatory, and social/environmental responsibilities." ;
    bpot:hierarchyID "10.4.10" ;
    bpot:pcfID "21582" .

bpot:PCF_10002 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop Vision and Strategy" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Establishing a direction and vision for an organization. This involves defining the business concept and long-term vision, as well as developing the business strategy and managing strategic initiatives. Processes in this category focus on creating a vision, a mission, and strategic objectives, and culminate in creating measures to ensure that the organization is moving in the desired direction." ;
    bpot:hierarchyID "1.0" ;
    bpot:pcfID "10002" .

bpot:PCF_10067 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19696 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product and service life cycle" ;
    bpot:apqcSourceText "Manage the introduction and withdrawal of products/services. Administer associated changes, namely measuring the performance of new solution offerings and the revision of master files in the archives." ;
    bpot:hierarchyID "2.1.2" ;
    bpot:pcfID "10067" .

bpot:PCF_10103 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop sales strategy" ;
    bpot:apqcSourceText "Developing concrete plans for guiding and providing support to the sales function. Chart a road map for the sales function, including an analysis of historical sales data to create forecasts for anticipated sales, forming sales targets, forging partnerships with other economic agents to boost sales, devising a budget for this function, and determining metrics to measure customer management activities as well as progress in achieving sales targets." ;
    bpot:hierarchyID "3.4" ;
    bpot:pcfID "10103" .

bpot:PCF_10153 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track customer management measures" ;
    bpot:apqcSourceText "Collating all customer-centered metrics. The objective is to create a big-picture view of the customers' mindset and their behavior pertaining to the organization's offerings." ;
    bpot:hierarchyID "3.3.5" ;
    bpot:pcfID "10153" .

bpot:PCF_10183 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customers and accounts" ;
    bpot:apqcSourceText "Managing the customer's expectations, with the intent of responsibly increasing the sale of the organization's products/services. Create a systematic method for governing sales, using sales forecasts and customer management measures. Develop a blueprint to manage relationships with customers and the data it holds on them, as well as the sale of its products/services to these customers. Devise a recipe for handling the organization's key customers in order to manage their expectations with tact and responsibility while maximizing revenue." ;
    bpot:hierarchyID "3.5.2" ;
    bpot:pcfID "10183" .

bpot:PCF_10184 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customer sales calls" ;
    bpot:apqcSourceText "Managing the entire sales process, from using leads to open sales to closing sales and creating records. Govern all sales activities. Make sales calls based on leads and preparatory work (drafting terms of the sale, creating proposals, suggesting prices, etc.). Close the sale, along with any administrative activities related to data entry and the processing of the sale." ;
    bpot:hierarchyID "3.5.1.8" ;
    bpot:pcfID "10184" .

bpot:PCF_10379 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20085 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and manage customer service contacts" ;
    bpot:apqcSourceText "Planning and administering work force operations for customer service provision by taking care of customer services requests/inquiries, as well as the complaints." ;
    bpot:hierarchyID "6.2" ;
    bpot:pcfID "10379" .

bpot:PCF_10389 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customer complaints" ;
    bpot:apqcSourceText "Obtaining customer complaints online or by phone. Direct these complaints to higher-level representatives as appropriate. Resolve them. Respond to customers." ;
    bpot:hierarchyID "6.2.3" ;
    bpot:pcfID "10389" .

bpot:PCF_10403 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20595 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure customer satisfaction with products and services" ;
    bpot:apqcSourceText "Calculating satisfaction levels of customers with products/services. Obtain customer feedback on products/services, as well as the effectiveness of the advertising campaigns. Examine this information to reach meaningful conclusions, which could then be used to enhance the customer service operations." ;
    bpot:hierarchyID "6.5.3" ;
    bpot:pcfID "10403" .

bpot:PCF_10410 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Recruit, source, and select employees" ;
    bpot:apqcSourceText "Determining and handling employee requirements. Recruit or source the candidates as per the requirements. Screen and select the most appropriate candidates. Take care of the newly hired and re-hired employees. Maintain records of information for all applicants. " ;
    bpot:hierarchyID "7.2" ;
    bpot:pcfID "10410" .

bpot:PCF_10440 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Recruit/Source candidates" ;
    bpot:apqcSourceText "Recruiting new candidates for deployment across various functional areas inside the organization. Select methods for sourcing new employees. Manage relationships with third-party agencies. Stage recruitment fairs and drives. Manage employee referral programs." ;
    bpot:hierarchyID "7.2.2" ;
    bpot:pcfID "10440" .

bpot:PCF_10729 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform revenue accounting" ;
    bpot:apqcSourceText "Comparing revenue targets to reality. Review all transactions and entries passed in final accounts in a year in order to examine profits." ;
    bpot:hierarchyID "9.2" ;
    bpot:pcfID "10729" .

bpot:PCF_10738 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10728 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform planning/budgeting/forecasting" ;
    bpot:apqcSourceText "Allocating funds to meet future and current financial goals. Led by the chief financial officer, have the finance function plan, budget, and forecast in order to determine and describe long and short-term financial goals." ;
    bpot:hierarchyID "9.1.1" ;
    bpot:pcfID "10738" .

bpot:PCF_10743 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10729 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Invoice customer" ;
    bpot:apqcSourceText "Preparing detailed reports of customer purchases. Prepare a commercial document between the seller and customer with details about transaction. Detail the quantity purchased, price of products/services, date, parties involved, unique invoice number, and tax information." ;
    bpot:hierarchyID "9.2.2" ;
    bpot:pcfID "10743" .

bpot:PCF_10744 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10729 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process accounts receivable (AR)" ;
    bpot:apqcSourceText "Processing payments due from customers. This includes all processing of funds received, whether by check or electronically. This does not include the generation of invoices." ;
    bpot:hierarchyID "9.2.3" ;
    bpot:pcfID "10744" .

bpot:PCF_10747 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10730 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage financial policies and procedures" ;
    bpot:apqcSourceText "Creating procedures to perform general accounting and reporting. Follow the rules and regulations made for a particular process in the business. Publish accounting policies. " ;
    bpot:hierarchyID "9.3.1" ;
    bpot:pcfID "10747" .

bpot:PCF_10752 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10731 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform capital project accounting" ;
    bpot:apqcSourceText "Accounting for large-scale and large-cost investments. Manage and account for ongoing activities related to capital projects, including setting up new projects, recording project transactions, monitoring and tracking spending, closing and capitalizing projects, and measuring the financial returns on completed projects." ;
    bpot:hierarchyID "9.4.2" ;
    bpot:pcfID "10752" .

bpot:PCF_10753 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10732 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report time" ;
    bpot:apqcSourceText "Recording the reporting time of employees on-site. Track working days, salary calculations, holidays taken, number of hours spend in the office, billing hours, etc." ;
    bpot:hierarchyID "9.5.1" ;
    bpot:pcfID "10753" .

bpot:PCF_10755 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10732 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage and process payroll taxes" ;
    bpot:apqcSourceText "Deducting and paying taxes from employees' salaries." ;
    bpot:hierarchyID "9.5.3" ;
    bpot:pcfID "10755" .

bpot:PCF_10757 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10733 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process expense reimbursements" ;
    bpot:apqcSourceText "Processing reimbursements to employees for the expenses incurred during the course of business. Approve and process advancements and reimbursements for employee expenses on the organization's behalf. Capture and report relevant tax data and manage personal accounts. " ;
    bpot:hierarchyID "9.6.2" ;
    bpot:pcfID "10757" .

bpot:PCF_10762 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10735 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish internal controls, policies, and procedures" ;
    bpot:apqcSourceText "Forming rules and regulations to ensure the achievement of effectiveness, proficiency of operations, and reliability of financial reporting." ;
    bpot:hierarchyID "9.8.1" ;
    bpot:pcfID "10762" .

bpot:PCF_10943 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10937 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan facility" ;
    bpot:apqcSourceText "Recognizing the needs of facility users in order to construct a project proposal that meets those needs." ;
    bpot:hierarchyID "10.1.2" ;
    bpot:pcfID "10943" .

bpot:PCF_11014 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10012 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage public relations program" ;
    bpot:apqcSourceText "Managing a public relations programs through business and communications skills. " ;
    bpot:hierarchyID "12.5" ;
    bpot:pcfID "11014" .

bpot:PCF_11072 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21584 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Benchmark performance" ;
    bpot:apqcSourceText "Comparing organizational performance internally or externally with other organizations. " ;
    bpot:hierarchyID "13.6.2" ;
    bpot:pcfID "11072" .

bpot:PCF_11136 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11074 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement change" ;
    bpot:apqcSourceText "Effectuating the change within the desired impact areas of the organization. Ensure adequate commitment from all corners of the organization for the desired change. Create support structures. Refashion all processes deemed necessary. Observe the progress." ;
    bpot:hierarchyID "13.4.3" ;
    bpot:pcfID "11136" .

bpot:PCF_11210 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11208 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage foreign exchange risk" ;
    bpot:apqcSourceText "Taking care of foreign-exchange risks. " ;
    bpot:hierarchyID "9.7.5.3" ;
    bpot:pcfID "11210" .

bpot:PCF_11216 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_16437 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage business resiliency" ;
    bpot:apqcSourceText "Including the processes required to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat. Develop a more dynamic, strategic, and integrated approach to managing compliance obligations." ;
    bpot:hierarchyID "11.4" ;
    bpot:pcfID "11216" .

bpot:PCF_12672 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20595 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate and manage warranty performance" ;
    bpot:apqcSourceText "Assessing the cost and effectiveness of warranties. " ;
    bpot:hierarchyID "6.5.4" ;
    bpot:pcfID "12672" .

bpot:PCF_16378 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage business processes" ;
    bpot:apqcSourceText "Establishing and administering governance for management of the processes. Outline and manage the frameworks for management of the processes. Define the business processes. Administer the performance of the processes. Enhance the business processes." ;
    bpot:hierarchyID "13.1" ;
    bpot:pcfID "16378" .

bpot:PCF_16387 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define processes" ;
    bpot:apqcSourceText "Outlining and establishing the business processes of the organization. Scope, analyze, map, and publish processes for the employees who may require it." ;
    bpot:hierarchyID "13.1.3" ;
    bpot:pcfID "16387" .

bpot:PCF_16437 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage Enterprise Risk, Compliance, Remediation, and Resiliency" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Ensuring that an organization effectively manages its risk. Process groups are aligned with traditional risk management activities." ;
    bpot:hierarchyID "11.0" ;
    bpot:pcfID "16437" .

bpot:PCF_16439 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17060 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish the enterprise risk framework and policies" ;
    bpot:apqcSourceText "Creating an agenda for the rules and regulations of enterprise risk that deal with hazardous, financial, operational, and strategic risks." ;
    bpot:hierarchyID "11.1.1" ;
    bpot:pcfID "16439" .

bpot:PCF_16613 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze and respond to customer insight" ;
    bpot:apqcSourceText "Reviewing and responding to customer feedback. Create tickets to initiate bug fixes or to propose feature updates. Monitor and track progress." ;
    bpot:hierarchyID "3.3.6" ;
    bpot:pcfID "16613" .

bpot:PCF_17040 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10002 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define the business concept and long-term vision" ;
    bpot:apqcSourceText "Creating a conceptual framework of the organization's business activity and strategic vision with long-term applicability. Scout the organization's internal capabilities, as well as the customer's needs and desires, to identify a fit that can be used to advance a conceptual structure of the organization's business activity. Conduct analysis in light of relevant externalities and large-scale shifts in the market landscape." ;
    bpot:hierarchyID "1.1" ;
    bpot:pcfID "17040" .

bpot:PCF_17052 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee relations" ;
    bpot:apqcSourceText "Assisting general management in developing, maintaining, and improving employee relationships. This is accomplished through communication, performance management, processing grievances, and/or dispute. Interpret and convey organizational policies." ;
    bpot:hierarchyID "7.4" ;
    bpot:pcfID "17052" .

bpot:PCF_17472 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17471 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish quality requirements" ;
    bpot:apqcSourceText "Determining essential activities, processes, and attributes for securing enterprise quality. Outline critical characteristics for quality. Outline activities encouraging the preservation of quality. Create quality controls. Confirm capabilities in accordance with quality requirements. Finalize the plan for quality maintenance." ;
    bpot:hierarchyID "13.3.1" ;
    bpot:pcfID "17472" .

bpot:PCF_17492 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17471 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage non-conformance" ;
    bpot:apqcSourceText "Handling any nonconformance activities or events. Assess the potential impact of the nonconformity. Decide the immediate actions to take. Identify the root causes. Take corrective or preventive action. Ensure future conformance." ;
    bpot:hierarchyID "13.3.3" ;
    bpot:pcfID "17492" .

bpot:PCF_18924 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10102 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and manage customer loyalty program" ;
    bpot:apqcSourceText "Creating and managing a customer loyalty program. The loyalty program is a key part of marketing, with an elaborate strategy and process for acquiring, retaining, and engaging with members. Members are engaged and acquainted to the loyalty program, thus growing relationship and adding value through the program. " ;
    bpot:hierarchyID "3.2.6" ;
    bpot:pcfID "18924" .

bpot:PCF_19207 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Acquire, Construct, and Manage Assets" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Relating to the design, construction, acquisition, and management of both productive and non-productive assets." ;
    bpot:hierarchyID "10.0" ;
    bpot:pcfID "19207" .

bpot:PCF_19229 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21575 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Schedule and perform construction work" ;
    bpot:apqcSourceText "Arranging a timetable for which to perform construction work. Schedule resources to contract assets for new or replacement assets. Reschedule or redesign assets if needed. " ;
    bpot:hierarchyID "10.2.3" ;
    bpot:pcfID "19229" .

bpot:PCF_19253 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19238 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform asset maintenance" ;
    bpot:apqcSourceText "Engaging in all aspects of asset maintenance. Ensure that all assets are functioning properly and to all specified codes and regulations where applicable. Maintenance includes all preventative, routine, and corrective activates." ;
    bpot:hierarchyID "10.3.3" ;
    bpot:pcfID "19253" .

bpot:PCF_19669 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19698 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Generate new product/service concepts" ;
    bpot:apqcSourceText "Producing and defining ideologies for new product/service offerings." ;
    bpot:hierarchyID "2.2.2" ;
    bpot:pcfID "19669" .

bpot:PCF_19985 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19696 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage patents, copyrights, and regulatory requirements" ;
    bpot:apqcSourceText "Determining the attributes necessary to protect and safeguard intellectual assets, maximize the value of IP assets through streamlined process, and collaboration between departments. Focus on needs to safeguard, critical assets, and assets' value." ;
    bpot:hierarchyID "2.1.3" ;
    bpot:pcfID "19985" .

bpot:PCF_19997 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10062 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Prepare for production/service delivery" ;
    bpot:apqcSourceText "Devising business plans and procedures for manufacturing/operations/production and delivery of services offered by the organization. Further in general terms the total amount of output that the manufacturing department is responsible to produce for each period." ;
    bpot:hierarchyID "2.3.3" ;
    bpot:pcfID "19997" .

bpot:PCF_20006 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10102 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze and manage channel performance" ;
    bpot:apqcSourceText "Monitoring marketing and distribution efforts of all channels individually and as a network. Re-distribute or add resources to channels that perform better than expected. Purge or consolidate under-performing channels, and find more promising replacements." ;
    bpot:hierarchyID "3.2.4" ;
    bpot:pcfID "20006" .

bpot:PCF_20022 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage Supply Chain for Physical Products" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Performing supply chain activities include planning supply chain, procuring materials and services, and managing logistics." ;
    bpot:hierarchyID "4.0" ;
    bpot:pcfID "20022" .

bpot:PCF_20089 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10378 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define warranty claims" ;
    bpot:apqcSourceText "Determining the exact terms and conditions under which specific warranties apply to certain goods or services." ;
    bpot:hierarchyID "6.1.6" ;
    bpot:pcfID "20089" .

bpot:PCF_20097 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_12669 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Investigate warranty issues" ;
    bpot:apqcSourceText "Executing investigational and analysis of warranty claims. This involves notification and definition of a warranty issue, includes the scheduling of a field service agent to perform further investigation; the request and receipt of defective parts; and diagnosis/root cause analysis. This concludes with the receipt of the result and recommendation for corrective action." ;
    bpot:hierarchyID "6.3.2.3" ;
    bpot:pcfID "20097" .

bpot:PCF_20137 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11208 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute hedging transactions" ;
    bpot:apqcSourceText "Implementing hedging strategy in attempt to alleviate risk. This will include all options, depravities, and futures contracts agreed upon in Develop risk management/hedging strategy [12974]." ;
    bpot:hierarchyID "9.7.5.5" ;
    bpot:pcfID "20137" .

bpot:PCF_20139 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21575 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and plan asset construction" ;
    bpot:apqcSourceText "Outlining the steps and strategies needed to construct assets. Verify that all regulations are adhered to and that all permissions have been granted. Organize and plan for resources to complete construction." ;
    bpot:hierarchyID "10.2.2" ;
    bpot:pcfID "20139" .

bpot:PCF_20595 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20085 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate customer service operations and customer satisfaction" ;
    bpot:apqcSourceText "Calculating and assessing the operational activities of the customer service function. Evaluation is achieved through the customer requests/inquiries handling process, the customer complaint handling process, and product and services quality. Examine activities to ensure high levels of customer service." ;
    bpot:hierarchyID "6.5" ;
    bpot:pcfID "20595" .

bpot:PCF_20617 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20608 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and communicate IT services" ;
    bpot:apqcSourceText "Create and design an organized and curated collection of all IT-related services that can be performed by, for, or within the organization. Maintain and convey information about deliverables, prices, contact points, and processes for requesting an information technology service." ;
    bpot:hierarchyID "8.1.3" ;
    bpot:pcfID "20617" .

bpot:PCF_20641 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20608 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage IT customer relationships" ;
    bpot:apqcSourceText "Managing the IT relationship with its customers by systematically coordinating interactions over multiple touch points on a regular basis. Coordinate the IT's efforts to reach out to its customers, which include emails, social-media interactions, newsletters, and direct conversations." ;
    bpot:hierarchyID "8.1.6" ;
    bpot:pcfID "20641" .

bpot:PCF_20743 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct and analyze IT compliance assessments" ;
    bpot:apqcSourceText "Evaluate and analyze the IT environment for the compliance of industry regulations and government legislation. Ensure that IT capability and resources meet the set standards." ;
    bpot:hierarchyID "8.3.6" ;
    bpot:pcfID "20743" .

bpot:PCF_20770 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20765 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and maintain business information architecture" ;
    bpot:apqcSourceText "Creating strategies to manage the organization's information and content. Outline the architecture for information collection and communication. Administer information resources, data management and content." ;
    bpot:hierarchyID "8.4.2" ;
    bpot:pcfID "20770" .

bpot:PCF_20784 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20607 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage services/solutions" ;
    bpot:apqcSourceText "Designing and maintaining the IT services/solutions catalogue. Evaluate the performance of IT services/solutions. Communicate the results to the management." ;
    bpot:hierarchyID "8.5" ;
    bpot:pcfID "20784" .

bpot:PCF_20793 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20784 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage service/solution lifecycle planning" ;
    bpot:apqcSourceText "Executing life-cycle planning for IT services and solutions. Develop new requirements and feature-function enhancements. Create and design a life cycle plan that addresses the current and future state of IT services and solutions." ;
    bpot:hierarchyID "8.5.2" ;
    bpot:pcfID "20793" .

bpot:PCF_20818 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20817 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute IT service/solution maintenance lifecycle" ;
    bpot:apqcSourceText "Executing IT service/solution maintenance lifecycle in order to reduce maintenance costs and increase reliability of IT infrastructure concerning service/solution related problems." ;
    bpot:hierarchyID "8.5.5.1" ;
    bpot:pcfID "20818" .

bpot:PCF_20824 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20607 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deploy services/solutions" ;
    bpot:apqcSourceText "Executing IT services/solutions by creating a strategy for deployment. Plan and execute the changes. Plan and administer the release of its IT services and solutions." ;
    bpot:hierarchyID "8.6" ;
    bpot:pcfID "20824" .

bpot:PCF_20867 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and establish service delivery strategy" ;
    bpot:apqcSourceText "Defining and establishing strategy for delivering IT services and solutions to the users. Design an IT service delivery model that defines the processes and procedures needed to deliver the IT services and solutions." ;
    bpot:hierarchyID "8.7.1" ;
    bpot:pcfID "20867" .

bpot:PCF_20888 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage infrastructure resource planning" ;
    bpot:apqcSourceText "Developing and managing the resources required for administration of infrastructure. Manage the IT inventory and assets to meet organization's IT resource capacity." ;
    bpot:hierarchyID "8.7.4" ;
    bpot:pcfID "20888" .

bpot:PCF_20936 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10219 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and manage inbound material flow" ;
    bpot:apqcSourceText "Creating and executing a strategy for all the internal activities related to the flow/transfer of inbound materials. This process includes planning inbound material receipts, managing inbound material flow, monitoring inbound delivery performance, managing the flow of returned products, controlling the quality of returned parts, and salvaging or repairing returned products." ;
    bpot:hierarchyID "4.4.2" ;
    bpot:pcfID "20936" .

bpot:PCF_20965 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11073 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and implement KM capabilities" ;
    bpot:apqcSourceText "Creating knowledge bases and other repositories to preserve and develop company expertise, and to train new employees." ;
    bpot:hierarchyID "13.5.3" ;
    bpot:pcfID "20965" .

bpot:PCF_21441 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17056 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop workforce analytics" ;
    bpot:apqcSourceText "Understand, develop, and gather workforce data in support of stakeholder requirements." ;
    bpot:hierarchyID "7.7.7" ;
    bpot:pcfID "21441" .

bpot:PCF_21589 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21588 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop sustainability capability" ;
    bpot:apqcSourceText "Developing sustainability (ESG) capabilities for the organization. Understand and communicate legal, regulatory, and social/environmental requirements. Establish policies, objectives, guidelines and approaches for ESG efforts and reporting." ;
    bpot:hierarchyID "13.9.1" ;
    bpot:pcfID "21589" .

bpot:PCF_10004 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Market and Sell Products and Services" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Outlining process groups related to understanding markets, customers, and capabilities; developing marketing strategies; executing marketing plans; developing sales strategies; developing and managing marketing plans; and managing sales partners and alliances." ;
    bpot:hierarchyID "3.0" ;
    bpot:pcfID "10004" .

bpot:PCF_10012 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage External Relationships" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Fostering external relationships with stakeholders of the entity, including investors, government and industry, the board of directors, and the general public. This is not related to customer management." ;
    bpot:hierarchyID "12.0" ;
    bpot:pcfID "10012" .

bpot:PCF_10019 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess the internal environment" ;
    bpot:apqcSourceText "Undertaking a review of the organization's in-house skills and resources in order to create a big-picture understanding of internal capacities. Assess the organization's capabilities in order to advance the advantageous and weed out the detrimental aspects. Identify synergic associations within the backdrop of the forces and players active in the market, and take into account all externalities." ;
    bpot:hierarchyID "1.1.3" ;
    bpot:pcfID "10019" .

bpot:PCF_10061 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19696 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product and service portfolio" ;
    bpot:apqcSourceText "Managing a portfolio of product/service offerings to take advantage of shifts in the market expectations, all the while coordinating with the overall business strategy. Revisit the product/service portfolio in light of market opportunities, and overhaul it to capture value created by these opportunities. Identify gaps between current offerings and the market expectations to direct the organization's R&D activity. Create new solutions, and revise or retire existing ones so that the revamped portfolio aligns with Develop a business strategy [10015]." ;
    bpot:hierarchyID "2.1.1" ;
    bpot:pcfID "10061" .

bpot:PCF_10102 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop marketing strategy" ;
    bpot:apqcSourceText "Charting a strategic course for marketing products/services. This will include defining the value proposition, creating a mechanism for pricing, and determining the right mix of marketing channels. Create a specific positioning and branding for the organization's offerings. Enlist marketing head to lead, with inputs from the business development and sales functions." ;
    bpot:hierarchyID "3.2" ;
    bpot:pcfID "10102" .

bpot:PCF_10106 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10101 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform customer and market intelligence analysis" ;
    bpot:apqcSourceText "Gathering intelligence on the market and customers. Closely examine the inherent attributes and collective behavior of the various market and customer segments. Track trends in the market. Determine what drives the customers to make purchasing decisions in order to identify opportunities in the market." ;
    bpot:hierarchyID "3.1.1" ;
    bpot:pcfID "10106" .

bpot:PCF_10131 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10103 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish overall sales budgets" ;
    bpot:apqcSourceText "Setting up a financial plan for the sales function. Calculate the estimated sales revenue and costs, which helps in calculating the overall net profit. Create a sound plan for resource outlay by comparing the forecast with historical data." ;
    bpot:hierarchyID "3.4.3" ;
    bpot:pcfID "10131" .

bpot:PCF_10185 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage sales orders" ;
    bpot:apqcSourceText "Taking, receiving, processing, and acknowledging new customer orders or amendments to outstanding customer orders. Monitoring status from order receipt to customer delivery/customer invoicing." ;
    bpot:hierarchyID "3.5.4" ;
    bpot:pcfID "10185" .

bpot:PCF_10223 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create materials plan" ;
    bpot:apqcSourceText "Developing a scheme that allows for advance planning for the availability of raw materials and spares. Start with an unconstrained plan, and refine based on supply chain realities by identifying critical materials required for production, checking material specifications, and collaborating with all vendors over the supply." ;
    bpot:hierarchyID "4.1.3" ;
    bpot:pcfID "10223" .

bpot:PCF_10304 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10217 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Produce/Assemble product" ;
    bpot:apqcSourceText "Manufacturing the product. Convert the raw materials to develop consumer-ready products. Manage the raw materials to implement the detailed production schedule. Reproduce defectives to establish and remediate cause. Ensure production optimization and benchmark performance." ;
    bpot:hierarchyID "4.3.2" ;
    bpot:pcfID "10304" .

bpot:PCF_10369 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10217 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform quality testing" ;
    bpot:apqcSourceText "Executing tests to evaluate the quality of the products manufactured. Calibrate the test equipment. Conduct the actual tests. Record the results and outcomes of the quality test conducted." ;
    bpot:hierarchyID "4.3.3" ;
    bpot:pcfID "10369" .

bpot:PCF_10388 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10379 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customer service problems, requests, and inquiries" ;
    bpot:apqcSourceText "Handling the requests and inquiries from customers that seek information regarding the organization's products/services. Obtain the customer requests online and by phone. Direct these requests to higher-level representatives. Approve requests, and respond to customers." ;
    bpot:hierarchyID "6.2.2" ;
    bpot:pcfID "10388" .

bpot:PCF_10734 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage treasury operations" ;
    bpot:apqcSourceText "Managing business's investments in trading in bonds, currencies, financial derivatives, etc. Manage the financial assets and holdings of the organization. Optimize the organization's liquidity. Invest excess cash. Reduce financial risks." ;
    bpot:hierarchyID "9.7" ;
    bpot:pcfID "10734" .

bpot:PCF_10739 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10728 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform cost accounting and control" ;
    bpot:apqcSourceText "Defining costs to be incurred and methods for optimum utilization. Determine the costs of products, processes, projects, etc. to compile in the financial statements, as well as to assist management in making decisions regarding planning and control. Control costs by managing and reducing business expenses." ;
    bpot:hierarchyID "9.1.2" ;
    bpot:pcfID "10739" .

bpot:PCF_10746 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10729 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage and process adjustments/deductions" ;
    bpot:apqcSourceText "Creating and providing funds for necessary adjustments and deductions, including all expenses that were required for the business at certain point in time." ;
    bpot:hierarchyID "9.2.5" ;
    bpot:pcfID "10746" .

bpot:PCF_11038 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11011 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage government relations" ;
    bpot:apqcSourceText "Persuading public and government policy at the local, regional, national, and global level (subject to government regulations)." ;
    bpot:hierarchyID "12.2.1" ;
    bpot:pcfID "11038" .

bpot:PCF_11048 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage outside counsel" ;
    bpot:apqcSourceText "Managing professionals, sought externally for assistance over legal and ethical concerns. Administer and oversee assistance from subject matter experts and professionals for sourcing expert opinion and counseling over legal and ethical matters." ;
    bpot:hierarchyID "12.4.5" ;
    bpot:pcfID "11048" .

bpot:PCF_11185 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_16437 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage remediation efforts" ;
    bpot:apqcSourceText "Administering the efforts and activities for remediation. This process element requires the organization to create plans for corrective action in collaboration with government agencies and pertinent professional services agencies which specialize in remediation efforts relevant to the organization's operations. Additionally, the organization needs to consult experts to validate the plan, determine resources allocation, resolve any legal concerns, and formulate a company-wide policy for remediation." ;
    bpot:hierarchyID "11.3" ;
    bpot:pcfID "11185" .

bpot:PCF_11208 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10734 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and execute risk and hedging transactions" ;
    bpot:apqcSourceText "Performing transactions that limit investment risk with the help of derivatives, such as options and futures contracts. Manage interest rates, foreign exchange, and exposure risks. Develop and execute hedging transactions. Evaluate and refine hedging positions. Produce hedge accounting transactions and reports. Monitor credit." ;
    bpot:hierarchyID "9.7.5" ;
    bpot:pcfID "11208" .

bpot:PCF_16410 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_16400 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage projects" ;
    bpot:apqcSourceText "Establishing the scope of the projects. Create plans for implementing the projects. Initiate projects. Review and report project performance to management. Close projects." ;
    bpot:hierarchyID "13.2.3" ;
    bpot:pcfID "16410" .

bpot:PCF_16411 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish project scope" ;
    bpot:apqcSourceText "Establishing the horizons of business projects. Identify the objectives of the program, along with the resource requirements. Assess the readiness for the project management approach. Identify methodologies for project management. Obtain funding. Develop performance measures and indicators." ;
    bpot:hierarchyID "13.2.3.1" ;
    bpot:pcfID "16411" .

bpot:PCF_17498 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17471 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement and maintain the enterprise quality management system (EQMS)" ;
    bpot:apqcSourceText "Establishing and administering the software that manages content and business processes for quality and compliance across the value chain. Define the quality strategy. Plan and deploy the EQMS scope, targets, and goals. Identify core process controls and metric. Develop EQMS governance. Assess the performance of EQMS. Encourage improvements in EQMS." ;
    bpot:hierarchyID "13.3.4" ;
    bpot:pcfID "17498" .

bpot:PCF_17504 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17498 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create environment and capability for EQMS improvement(s)" ;
    bpot:apqcSourceText "Rewarding excellence in quality. Create and maintain quality partnerships. Maintain talent capabilities and competencies. Incorporate EQMS messaging into communication channels. Transfer proven EQMS methods. Consider factors such as EQMS reviews and gap assessments and the alignment and compatibility of business processes and quality. Adopt Lean principles. " ;
    bpot:hierarchyID "13.3.4.6" ;
    bpot:pcfID "17504" .

bpot:PCF_19995 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19993 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design products/services" ;
    bpot:apqcSourceText "Creating a sketch of the customer focused product/service in Develop and Manage Products and Services [10003]." ;
    bpot:hierarchyID "2.3.1.8" ;
    bpot:pcfID "19995" .

bpot:PCF_20050 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create and manage resource plan" ;
    bpot:apqcSourceText "Identifying the need for and creating a resource plan. Understand resource demand and align with capacity, skills, and capabilities. Enlist suppliers and partners to supplement needed skills and capabilities. Monitor and manage capabilities and skills with an eye on critical resources and supplier capacity." ;
    bpot:hierarchyID "5.2.2" ;
    bpot:pcfID "20050" .

bpot:PCF_20085 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage Customer Service" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Managing customers before and after the delivery of services. This includes developing and planning customer service practices with an eye on steering processes relating to inquiries after sales, feedback, warranties, and recalls. " ;
    bpot:hierarchyID "6.0" ;
    bpot:pcfID "20085" .

bpot:PCF_20110 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20085 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product recalls and regulatory audits" ;
    bpot:apqcSourceText "Removing defective products from the distribution chain. Participate in audits from watchdog agencies." ;
    bpot:hierarchyID "6.4" ;
    bpot:pcfID "20110" .

bpot:PCF_20653 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20652 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define business technology and governance strategy" ;
    bpot:apqcSourceText "Defining the need of technology in business and systematic implementation of IT investments. It comprises of assessing competitive technology components to ensure structural analysis, development, usage and security of technology for efficient business operations." ;
    bpot:hierarchyID "8.2.1" ;
    bpot:pcfID "20653" .

bpot:PCF_20660 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20652 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage IT portfolio strategy" ;
    bpot:apqcSourceText "Strategy for systematic management of IT investments, projects, and activities. Analyze and examine the value of the IT portfolio and allocate resources based on business objectives." ;
    bpot:hierarchyID "8.2.2" ;
    bpot:pcfID "20660" .

bpot:PCF_20749 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and execute IT resilience and continuity operations" ;
    bpot:apqcSourceText "Create and execute a process to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat in IT. Maintain continuous IT operations to protect employees, assets, and overall brand equity." ;
    bpot:hierarchyID "8.3.7" ;
    bpot:pcfID "20749" .

bpot:PCF_20825 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20824 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage service/solution deployment strategy" ;
    bpot:apqcSourceText "Creating and implementing a strategy for the deployment of IT service/solution. Define all of the activities that make the IT function available for use. Establish the change policies for IT services and solutions. Define the deployment process, procedures, and tools. Select the most feasible and practical methodologies for the deployment process." ;
    bpot:hierarchyID "8.6.1" ;
    bpot:pcfID "20825" .

bpot:PCF_20873 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and develop service support strategy" ;
    bpot:apqcSourceText "Defining and creating a strategy for provision of support to users of IT services and solutions. " ;
    bpot:hierarchyID "8.7.2" ;
    bpot:pcfID "20873" .

bpot:PCF_20881 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20880 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan operational activities for IT service delivery" ;
    bpot:apqcSourceText "Planning different delivery services for operational activities within the IT function. Use service delivery systems to manage the IT service delivery services." ;
    bpot:hierarchyID "8.7.3.1" ;
    bpot:pcfID "20881" .

bpot:PCF_20914 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage infrastructure resource administration" ;
    bpot:apqcSourceText "Managing the resources required for administration of IT infrastructure. Manage the IT inventory and assets. Take care of the organization's IT resource capacity. " ;
    bpot:hierarchyID "8.7.7" ;
    bpot:pcfID "20914" .

bpot:PCF_20921 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Operate IT user support" ;
    bpot:apqcSourceText "Managing systematic user support functionality and capability through defined procedures. Determine, record, and monitor user requests. Execute issue/request resolution. Utilize escalation path when needed. Resolve issue/request. " ;
    bpot:hierarchyID "8.7.8" ;
    bpot:pcfID "20921" .

bpot:PCF_20929 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10733 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage corporate credit cards" ;
    bpot:apqcSourceText "Handling and authoring credit cards to business entities or for corporate purchases." ;
    bpot:hierarchyID "9.6.3" ;
    bpot:pcfID "20929" .

bpot:PCF_21587 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11179 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor and manage EHS program" ;
    bpot:apqcSourceText "Managing the performance, costs and benefits of EHS. Measure and report the performance of EHS. Implement plans for emergency response and pollution prevention. Train and educate employees. Provide EHS support." ;
    bpot:hierarchyID "13.8.3" ;
    bpot:pcfID "21587" .

bpot:PCF_10016 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10002 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and measure strategic initiatives" ;
    bpot:apqcSourceText "Managing strategic initiatives, from development through selection, execution, and evaluation. Conduct and oversee strategic projects supporting long-term objectives. Administer programs of strategic significance by developing such initiatives, select the most appropriate projects, and formulate measures to assess their impact." ;
    bpot:hierarchyID "1.3" ;
    bpot:pcfID "10016" .

bpot:PCF_10039 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Set/Develop long-term enterprise strategy" ;
    bpot:apqcSourceText "Developing a strategy for the achievement of business goals over the distant future. Adopt one of the strategic options for realizing its mission over the long term. Enlist senior management executives, comprising strategy and/or business unit personnel." ;
    bpot:hierarchyID "1.2.3" ;
    bpot:pcfID "10039" .

bpot:PCF_10222 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage demand for products" ;
    bpot:apqcSourceText "Forecasting demand for products using secondary research and customer feedback. Refine these forecasts. Inspect the approach used in creating forecasts, and determine its accuracy." ;
    bpot:hierarchyID "4.1.2" ;
    bpot:pcfID "10222" .

bpot:PCF_10277 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide sourcing governance and perform category management" ;
    bpot:apqcSourceText "Creating strategies for procuring materials and services from various sources, and for managing and evaluating categories. Establish a procurement process that describes the approach for obtaining products and purchasing activities. Evaluate the sources. Create sourcing relationships in order to continuously improve. Re-evaluate purchasing activities. " ;
    bpot:hierarchyID "4.2.1" ;
    bpot:pcfID "10277" .

bpot:PCF_10279 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Order materials and services" ;
    bpot:apqcSourceText "Creating and approving requisitions and distributing purchase orders accordingly. Hasten the procurement process to satisfy internal needs." ;
    bpot:hierarchyID "4.2.3" ;
    bpot:pcfID "10279" .

bpot:PCF_10303 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10217 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Schedule production" ;
    bpot:apqcSourceText "Scheduling the production of final products. Generate a detailed schedule plan. Create and release production orders and lots. Schedule the planned and unplanned maintenance orders." ;
    bpot:hierarchyID "4.3.1" ;
    bpot:pcfID "10303" .

bpot:PCF_10338 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10219 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide logistics governance" ;
    bpot:apqcSourceText "Outlining the strategy for managing logistics. Translate customer requirements logistic requirements. Create an efficient logistic network and outsourcing portions of logistics activities. Design a logistics strategy that optimizes transportation costs and schedule. Define key performance indicators." ;
    bpot:hierarchyID "4.4.1" ;
    bpot:pcfID "10338" .

bpot:PCF_10378 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20085 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop customer service strategy" ;
    bpot:apqcSourceText "Defining a plan that removes customer obstacles by gathering operational insight and competitive insight, as well as improving soft skills and forward resolution for employees. Develop customer segmentation. Define rules and regulations for customer service. Establish service levels for customers." ;
    bpot:hierarchyID "6.1" ;
    bpot:pcfID "10378" .

bpot:PCF_10413 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Redeploy and retire employees" ;
    bpot:apqcSourceText "Managing the reassignment and retirement of employees. Manage the process of employee promotion and demotion. Administer separation, retirement, and leaves of absence. Outplace employees. Deploy personnel. Relocate employees in order to manage assignments." ;
    bpot:hierarchyID "7.6" ;
    bpot:pcfID "10413" .

bpot:PCF_10439 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee requisitions" ;
    bpot:apqcSourceText "Handling the requirements for new employees. Create and open job requisitions by clearly defining the job descriptions. Post these requirements internally and externally, and modify them as appropriate. Manage the dates of the whole requisition process." ;
    bpot:hierarchyID "7.2.1" ;
    bpot:pcfID "10439" .

bpot:PCF_10473 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20599 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and train employees" ;
    bpot:apqcSourceText "Creating a link between employee and organizational development needs. Conduct and manage employee training programs by considering the need and availability of these programs. " ;
    bpot:hierarchyID "7.3.4" ;
    bpot:pcfID "10473" .

bpot:PCF_10741 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10728 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate and manage financial performance" ;
    bpot:apqcSourceText "Checking and achieving predetermined financial targets and timelines. Assess and manage the profitability, feasibility, and consistency of a business or project. Study the revenues generated." ;
    bpot:hierarchyID "9.1.4" ;
    bpot:pcfID "10741" .

bpot:PCF_10742 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10729 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process customer credit" ;
    bpot:apqcSourceText "Evaluating and processing requests for advances. Evaluate credit requests by customers requiring loans to buy products/services. " ;
    bpot:hierarchyID "9.2.1" ;
    bpot:pcfID "10742" .

bpot:PCF_10745 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10729 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage and process collections" ;
    bpot:apqcSourceText "Posting entries to respective accounts, and preparing accounts for receivables. Manage the cash collected by the business from its debtors. Record it in the books of accounts to provide clear information about the availability of the cash." ;
    bpot:hierarchyID "9.2.4" ;
    bpot:pcfID "10745" .

bpot:PCF_10760 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10734 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage in-house bank accounts" ;
    bpot:apqcSourceText "Managing financial services provided by an in-house bank structure in the corporation that is operating like a commercial bank. " ;
    bpot:hierarchyID "9.7.3" ;
    bpot:pcfID "10760" .

bpot:PCF_10766 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10736 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process taxes" ;
    bpot:apqcSourceText "Processing the taxes of the organization in line with the regional taxation structure, including corporate, property, excise, and service taxes." ;
    bpot:hierarchyID "9.9.2" ;
    bpot:pcfID "10766" .

bpot:PCF_11423 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10067 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct post launch review" ;
    bpot:apqcSourceText "Learning from either a test or a full production run within the consumer market. Companies use this as an opportunity to both test and react to new products, ideas, or innovations based on the initial reaction of consumers on an individual level. Within this process, analytics are used to determine the relative success of a new product offering. Within this process, companies will launch key analytics to test a products acceptance. They will also review market performance and compare to similar products and against the business case or the financial plan. Companies can also measure the effectiveness of their supply chain network, and can apply what is learned from the post launch review to other new products, processes, and procedures to ensure and enhance the product quality." ;
    bpot:hierarchyID "2.1.2.5" ;
    bpot:pcfID "11423" .

bpot:PCF_12127 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Enable service delivery resources" ;
    bpot:apqcSourceText "Instituting training to enable resources to provide service delivery to the customer. Develop a training plan. Create materials that provide for operation and technical training. Schedule, perform, and evaluate training." ;
    bpot:hierarchyID "5.2.3" ;
    bpot:pcfID "12127" .

bpot:PCF_16413 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop project plans" ;
    bpot:apqcSourceText "Defining the resources and their roles. Identify IT requirements. Create plans for effective training and communication. Design reward approaches. Plan the launch of project. Deploy the project." ;
    bpot:hierarchyID "13.2.3.3" ;
    bpot:pcfID "16413" .

bpot:PCF_16414 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute projects" ;
    bpot:apqcSourceText "Implementing the business projects of the organization. Evaluate the impact of project management. Record and report the status of the project. Manage the project scope. Promote and sustain activities and involvement. Realign and revamp the project management strategy and approach. " ;
    bpot:hierarchyID "13.2.3.4" ;
    bpot:pcfID "16414" .

bpot:PCF_17462 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17060 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage business unit and function risk" ;
    bpot:apqcSourceText "Analyzing the threats a business unit/function faces to prioritize the controls it implements.. " ;
    bpot:hierarchyID "11.1.3" ;
    bpot:pcfID "17462" .

bpot:PCF_19239 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19238 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan asset maintenance" ;
    bpot:apqcSourceText "Ensuring that necessary resources are available and tasks are prioritized accordingly through planning. Provide strategies and policies that identify tasks that need to be completed, and the resources necessary to fulfill those tasks." ;
    bpot:hierarchyID "10.3.1" ;
    bpot:pcfID "19239" .

bpot:PCF_19245 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19238 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage asset maintenance" ;
    bpot:apqcSourceText "Ensuring that asset maintenance is conducted in a timely manner and successfully. Schedule work with the required resources with an eye on quality control and safety. Verify that contracted maintenance meets performance targets." ;
    bpot:hierarchyID "10.3.2" ;
    bpot:pcfID "19245" .

bpot:PCF_19964 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19959 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design customer experience" ;
    bpot:apqcSourceText "Creating a design of how customers interact with the business by analyzing data captured through various customer interaction and customer involvement. These will be captured through various channels such as customer satisfaction surveys, feedback forms, product reviews, targeted studies, observational studies, or voice of customer research." ;
    bpot:hierarchyID "1.2.8.2" ;
    bpot:pcfID "19964" .

bpot:PCF_20032 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20026 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop service delivery strategies" ;
    bpot:apqcSourceText "Constructing strategies that identify goals, policies, processes, and procedures in relation to service delivery. Review and validate strategies. Define the workplace layout and infrastructure." ;
    bpot:hierarchyID "5.1.2" ;
    bpot:pcfID "20032" .

bpot:PCF_20059 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Initiate service delivery" ;
    bpot:apqcSourceText "Collaborating with the customer to understand service needs. Review, understand, and modify the delivery scope with the organization needs of the customer in mind. Confirm readiness and identify, select, and assign resources. Plan for service delivery." ;
    bpot:hierarchyID "5.3.1" ;
    bpot:pcfID "20059" .

bpot:PCF_20069 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute service delivery" ;
    bpot:apqcSourceText "Carrying out service delivery to the customer by creating and deploying the necessary solution. Analyze need and create a solution. Validate the solution and make changes if needed. Obtain approval to build/buy solution and then deploy solution to customer." ;
    bpot:hierarchyID "5.3.2" ;
    bpot:pcfID "20069" .

bpot:PCF_20077 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Complete service delivery" ;
    bpot:apqcSourceText "Implementing final steps to complete service delivery to the customer. Evaluate success through project review, complete finance activities, and confirm delivery. Release resources and manage completion by harvesting knowledge and systems by archiving records." ;
    bpot:hierarchyID "5.3.3" ;
    bpot:pcfID "20077" .

bpot:PCF_20608 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20607 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage IT customer relationships" ;
    bpot:apqcSourceText "Creating and administering relationships with IT customers. Understanding customer needs including high-level business requirements for IT transformation. Plan for and communicate IT services along with establishing IT service levels, providing transformation guidance, and performance analysis that foster IT customer relationships." ;
    bpot:hierarchyID "8.1" ;
    bpot:pcfID "20608" .

bpot:PCF_20632 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20608 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage IT service levels" ;
    bpot:apqcSourceText "Establishing and maintaining service levels for the provision of IT services and solutions. Design and maintain the IT services and solution catalogue, as well as service level agreements. Evaluate the performance of IT service level agreements. Communicate the results to the management." ;
    bpot:hierarchyID "8.1.5" ;
    bpot:pcfID "20632" .

bpot:PCF_20652 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20607 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage IT business strategy" ;
    bpot:apqcSourceText "Handling the business of IT. Create a organization-wide strategy for the IT function. Define the organization's IT architecture. Manage the IT portfolio. Research and innovate in the field of IT. Assess and convey the performance and the value of the IT function." ;
    bpot:hierarchyID "8.2" ;
    bpot:pcfID "20652" .

bpot:PCF_20674 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20652 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define IT service management strategy" ;
    bpot:apqcSourceText "Defining perspective, position, plans, and patterns needed to execute designing, delivering, managing, and improving the way information technology is used within an organization." ;
    bpot:hierarchyID "8.2.4" ;
    bpot:pcfID "20674" .

bpot:PCF_20699 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20652 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and manage technology innovation" ;
    bpot:apqcSourceText "Outline and manage the innovation of technology within the organization. Research and understand emerging future technological concepts and capabilities. Plan for IT innovation investments. Plan and execute viable innovation projects." ;
    bpot:hierarchyID "8.2.7" ;
    bpot:pcfID "20699" .

bpot:PCF_20735 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage IT security, privacy, and data protection" ;
    bpot:apqcSourceText "Creating and deploying an architecture for securing and ensuring the privacy of data flows throughout the organization. Create and develop protocols that ensure proper and efficient use of IT services and solutions" ;
    bpot:hierarchyID "8.3.5" ;
    bpot:pcfID "20735" .

bpot:PCF_20785 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20784 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop service/solution and integration strategy" ;
    bpot:apqcSourceText "Developing service/solution along with creating a strategy that provides a base for delivering service/solution aligned with overall business needs. Conduct research within the services/solutions field for development and integration." ;
    bpot:hierarchyID "8.5.1" ;
    bpot:pcfID "20785" .

bpot:PCF_20809 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20808 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute IT service/solution development lifecycle" ;
    bpot:apqcSourceText "Executing an information system, aiming to produce a high quality system that meets or exceeds customer expectations, reaches completion within time and cost estimates, and is inexpensive to maintain and cost-effective to enhance." ;
    bpot:hierarchyID "8.5.4.1" ;
    bpot:pcfID "20809" .

bpot:PCF_20832 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20824 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan service and solution implementation" ;
    bpot:apqcSourceText "Strategizing and executing changes in IT solutions and services. Create a plan for deploying the changes. Communicate with stakeholders about the changes. Administer and implement the changes. Train the resources who will be affected by these changes. Install changes and verify their effect." ;
    bpot:hierarchyID "8.6.2" ;
    bpot:pcfID "20832" .

bpot:PCF_20840 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20824 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage change deployment control" ;
    bpot:apqcSourceText "Creating and deploying an architecture for securing the changes deployed in the organization. Create and develop protocols that ensure proper and efficient use of deployed IT services and solutions. Test, evaluate, and implement the policies and protocols." ;
    bpot:hierarchyID "8.6.3" ;
    bpot:pcfID "20840" .

bpot:PCF_20858 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20824 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform service and solution rollout" ;
    bpot:apqcSourceText "Strategizing and executing changes in IT solutions and services. Create a plan for deploying the changes. Communicate with stakeholders about the changes. Administer and implement the changes. Train the resources who will be affected by these changes. Install changes and verify their effect." ;
    bpot:hierarchyID "8.6.5" ;
    bpot:pcfID "20858" .

bpot:PCF_10041 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create organizational design" ;
    bpot:apqcSourceText "Formulating a design for the organization's resources that allow it to meet its objectives. Develop a new framework for molding the organization's various processes into a coherent and seamless whole." ;
    bpot:hierarchyID "1.2.5" ;
    bpot:pcfID "10041" .

bpot:PCF_10105 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage sales plans" ;
    bpot:apqcSourceText "Selling products/services. Set appropriate customer expectations. Work with customers using the same schedule that product/service development, production, and customer service functions follow. Manage sales personnel and sales partnerships/alliances." ;
    bpot:hierarchyID "3.5" ;
    bpot:pcfID "10105" .

bpot:PCF_10182 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage leads/opportunities" ;
    bpot:apqcSourceText "Generating leads of prospective customers to grow the organization's business. Identify viable customers based on customer and market research. Discover leads through IT applications, cold calling, reference/network development, or other sales and business development techniques. Employ a scoring model qualify the prospective customers into leads, and prioritize them." ;
    bpot:hierarchyID "3.5.1" ;
    bpot:pcfID "10182" .

bpot:PCF_10195 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Collect and maintain account information" ;
    bpot:apqcSourceText "Collecting and maintaining all account information. Collect information about the purchase, servicing, return, and/or commitment of any products/services on part of the organization to its customers. Bring together information from various organizational divisions, and update periodically." ;
    bpot:hierarchyID "3.5.4.2" ;
    bpot:pcfID "10195" .

bpot:PCF_10215 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20022 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan for and align supply chain resources" ;
    bpot:apqcSourceText "Creating strategies for production and materials. Handle the demand for the products of the organization. Develop plans for handling materials. Develop and administer the schedule for master production. Plan for distribution requirements and its constraints by reviewing and assessing distribution policies and performance and by establishing quality standards and procedures. " ;
    bpot:hierarchyID "4.1" ;
    bpot:pcfID "10215" .

bpot:PCF_10340 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10219 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Operate warehousing" ;
    bpot:apqcSourceText "Tracking the inventory deployment. Accept and store products. Ship the products. Measure the accuracy of the inventory. Assess the performance of the outsourced logistics activities." ;
    bpot:hierarchyID "4.4.3" ;
    bpot:pcfID "10340" .

bpot:PCF_10750 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10730 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform financial reporting" ;
    bpot:apqcSourceText "Reporting on the organization's financial status to stakeholders. Include balance sheets, income statements, cash flow statements, and statements of shareholders' equity." ;
    bpot:hierarchyID "9.3.4" ;
    bpot:pcfID "10750" .

bpot:PCF_10754 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10732 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage pay" ;
    bpot:apqcSourceText "Managing the total payments made in employees payroll, including bonuses and compensation." ;
    bpot:hierarchyID "9.5.2" ;
    bpot:pcfID "10754" .

bpot:PCF_10758 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10734 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage treasury policies and procedures" ;
    bpot:apqcSourceText "Managing rules and regulations for investments in trading in bonds, currencies, financial derivatives, etc. Establish policies and procedures for investments made. Optimize liquidity in treasury operations." ;
    bpot:hierarchyID "9.7.1" ;
    bpot:pcfID "10758" .

bpot:PCF_10759 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10734 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage cash" ;
    bpot:apqcSourceText "Taking care of all cash-related activities in the business. Manage and reconcile cash positions. Manage cash equivalents. Process and oversee electronic fund transfers. Develop cash flow forecasts. Manage cash flows. Produce cash management accounting transactions and reports. Manage and oversee banking relationships. Analyze, negotiate, resolve, and confirm bank fees." ;
    bpot:hierarchyID "9.7.2" ;
    bpot:pcfID "10759" .

bpot:PCF_10761 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10734 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage debt and investment" ;
    bpot:apqcSourceText "Taking care of the organization's financial position. Manage its loans or debts from different sources and investments. Leverage the most profitable options to balance the financial position in the market." ;
    bpot:hierarchyID "9.7.4" ;
    bpot:pcfID "10761" .

bpot:PCF_11331 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19990 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define product/service requirements" ;
    bpot:apqcSourceText "Determining requirements related to the creation of the product/service. Explain potential achievements that could be made." ;
    bpot:hierarchyID "2.2.3.1" ;
    bpot:pcfID "11331" .

bpot:PCF_16848 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10102 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop marketing communication strategy" ;
    bpot:apqcSourceText "Establishing marketing communications that deliver promotional messages, in a coordinated way, through multiple marketing channels, such as print, radio, television, direct mail, online or mobile advertising, email, social media or personal selling." ;
    bpot:hierarchyID "3.2.5" ;
    bpot:pcfID "16848" .

bpot:PCF_20000 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10102 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and manage channel strategy" ;
    bpot:apqcSourceText "Establishing all the activities needed to identify the appropriate channels to market to different customer segments as defined in Determine target segments [10117]. This involves finding channel partners, ensuring that the channels align with organizational strategy for each segment, and the final channel selection process." ;
    bpot:hierarchyID "3.2.3" ;
    bpot:pcfID "20000" .

bpot:PCF_20010 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage promotional activities" ;
    bpot:apqcSourceText "Conceptualizing, testing, and executing product/service/brand promotions. Once a promotion has launched, this process continues as the organization tweaks parts of the promotion or chooses to use ideas or lessons learned during the promotion in future activities. The promotion's performance according to organizational measures is also evaluated in this process. Determine early on whether you need third party help with promotion. Purchase lists, consult with social media experts, hire seasonal staff, or pay for additional research." ;
    bpot:hierarchyID "3.3.4" ;
    bpot:pcfID "20010" .

bpot:PCF_20041 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage service delivery resource demand" ;
    bpot:apqcSourceText "Ensuring necessary resources are maintained through monitoring pipeline, developing forecasts, and collaborating with customers. Determine skills needed for service deliver and forecast customer orders. Monitor forecasted orders and modify if where needed. Measure forecast accuracy. " ;
    bpot:hierarchyID "5.2.1" ;
    bpot:pcfID "20041" .

bpot:PCF_20147 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21584 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate performance" ;
    bpot:apqcSourceText "Assessing process data, measures, and trends in an effort to evaluate process performance and identify possible improvements." ;
    bpot:hierarchyID "13.6.3" ;
    bpot:pcfID "20147" .

bpot:PCF_20607 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage Information Technology (IT)" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Managing process groups relevant to the business of information technology within an organization. The process groups include \"Develop and manage IT customer relationships\", \"Develop and manage IT business strategy\", \" Develop and manage IT resilience and risk\", \" Manage information\", \" Develop and manage services/solutions\", \"Deploy services/solutions\", and \" Create and manage support services/solutions\"." ;
    bpot:hierarchyID "8.0" ;
    bpot:pcfID "20607" .

bpot:PCF_20706 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20607 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage IT resilience and risk" ;
    bpot:apqcSourceText "Develop and include the processes required to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat to IT. Develop a more dynamic, strategic, and integrated approach to managing risk and compliance obligations." ;
    bpot:hierarchyID "8.3" ;
    bpot:pcfID "20706" .

bpot:PCF_20756 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage IT user identity and authorization" ;
    bpot:apqcSourceText "The process of identifying, authenticating, and authorizing IT users to have access to applications, systems, IT components, or networks by associating user rights and restrictions with established identities." ;
    bpot:hierarchyID "8.3.8" ;
    bpot:pcfID "20756" .

bpot:PCF_20799 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20784 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage service/solution architecture" ;
    bpot:apqcSourceText "Creating the architecture for the IT services and solutions. Assess architecture and business constraints in order to understand integration requirements. Promote existing architecture. Manage exceptions." ;
    bpot:hierarchyID "8.5.3" ;
    bpot:pcfID "20799" .

bpot:PCF_20866 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_20607 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create and manage support services/solutions" ;
    bpot:apqcSourceText "Establishing and managing services for providing support to users of IT services and solutions. Define the plethora of services by which the organization assists users of computers, software products, or other information technology products." ;
    bpot:hierarchyID "8.7" ;
    bpot:pcfID "20866" .

bpot:PCF_20905 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage service delivery operations" ;
    bpot:apqcSourceText "Developing and managing different delivery services using service delivery systems for operational activities within the IT function in order to achieve organizations goal." ;
    bpot:hierarchyID "8.7.6" ;
    bpot:pcfID "20905" .

bpot:PCF_21438 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10412 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage reward, recognition, and motivation programs" ;
    bpot:apqcSourceText "Developing a salary/compensation structure and plan; developing a benefits and reward plan; develop commission plan; performing competitive analyses of benefits and rewards; identifying compensation requirements based on compensation, benefits, and HR policies; administering compensation, commission, and rewards to employees; and rewarding and motivating employees." ;
    bpot:hierarchyID "7.5.1" ;
    bpot:pcfID "21438" .

bpot:PCF_21583 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_21576 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform waste and hazardous goods management" ;
    bpot:apqcSourceText "Planning and performing waste and hazardous goods management. In compliance with all legal, regulatory, and social/environmental requirements, plan, document, and conduct hazardous material handling, disposal, and reporting." ;
    bpot:hierarchyID "10.4.11" ;
    bpot:pcfID "21583" .

bpot:PCF_10007 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and Manage Human Capital" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Delivering processes traditionally defined as \"human resources\". Process groups include those related to developing and maintaining workforce strategy, recruiting employees, developing and counseling employees, managing employee relations, rewarding and retaining employees, redeploying and retiring employees, managing employee information, and managing employee communications." ;
    bpot:hierarchyID "7.0" ;
    bpot:pcfID "10007" .

bpot:PCF_10015 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10002 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop business strategy" ;
    bpot:apqcSourceText "Developing an organization's mission statement, strategy, and business design. Create a concise statement that clearly articulates the mission of the organization, outlining practicable targets to Establish a strategic vision [10020]. Delineate strategic options by matching these alternatives with the organization's internal capabilities. Create an organizational design, and identify goals by developing strategies at the functional and process levels." ;
    bpot:hierarchyID "1.2" ;
    bpot:pcfID "10015" .

bpot:PCF_10221 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop production and materials strategies" ;
    bpot:apqcSourceText "Creating strategies for production processes, as well as the process of managing materials. Define production and supply constraints. Design a blueprint of the workplace. Establish rules and regulations regarding the employees, outsourcing of services, and the expenditure to be incurred on the manufacturing capital." ;
    bpot:hierarchyID "4.1.1" ;
    bpot:pcfID "10221" .

bpot:PCF_10748 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10730 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform general accounting" ;
    bpot:apqcSourceText "Applying basic principles, concepts, and accounting practices in recording and preparing final accounts, and using accounting information in management." ;
    bpot:hierarchyID "9.3.2" ;
    bpot:pcfID "10748" .

bpot:PCF_10749 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10730 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform fixed-asset accounting" ;
    bpot:apqcSourceText "Accounting for long-term and fixed assets. Record purchased, fixed assets that are not easily convertible into cash. Account for costs, useful life, resale value, depreciation, and amortization." ;
    bpot:hierarchyID "9.3.3" ;
    bpot:pcfID "10749" .

bpot:PCF_11013 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10012 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage legal and ethical issues" ;
    bpot:apqcSourceText "Managing legal practices to abide by the law, as well as ethical practices." ;
    bpot:hierarchyID "12.4" ;
    bpot:pcfID "11013" .

bpot:PCF_11095 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11073 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop KM strategy" ;
    bpot:apqcSourceText "Creating a plan for managing the organization's knowledge base. Determine what kind of specialized knowledge the organization possesses, which elements of this collective knowledge can prove beneficial, how to capture and maintain this knowledge, how to grant access to this library of information, and how the organization should proceed." ;
    bpot:hierarchyID "13.5.1" ;
    bpot:pcfID "11095" .

bpot:PCF_11135 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11074 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design the change" ;
    bpot:apqcSourceText "Developing plans for change management, training, communication, and rewards/incentives. Establish metrics for measuring the change adoption. Clarify new roles for employees. Identify budgets." ;
    bpot:hierarchyID "13.4.2" ;
    bpot:pcfID "11135" .

bpot:PCF_16445 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17060 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Oversee and coordinate enterprise risk management activities" ;
    bpot:apqcSourceText "Coordinating to plan, organize, lead, and control the activities of an organization in order to minimize the special effects of risk on capital and earnings." ;
    bpot:hierarchyID "11.1.2" ;
    bpot:pcfID "16445" .

bpot:PCF_16463 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17467 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage regulatory compliance" ;
    bpot:apqcSourceText "Obeying laws, guidelines, strategies, and stipulations related to the business." ;
    bpot:hierarchyID "11.2.2" ;
    bpot:pcfID "16463" .

bpot:PCF_17056 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10007 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage employee information and analytics" ;
    bpot:apqcSourceText "Managing the employee reporting processes, employee inquiry process, employee information and data, and the HR information systems. Create and administer the employee metrics. Develop and handle the time and attendance systems. Refurbish the indicators for employee retention and motivation." ;
    bpot:hierarchyID "7.7" ;
    bpot:pcfID "17056" .

bpot:PCF_20008 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10004 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage marketing plans" ;
    bpot:apqcSourceText "Creating specific plans to market offerings to customers. This process group includes processes for making budgets, identifying and developing media, pricing products and services, managing packaging, managing marketing content and promotional activities, tracking and responding to customer insight and monitoring measures established within \"develop marketing strategy\". Additionally, in this process group, organizations take action on plans made in earlier processes. Here, marketing and customers are managed and measured along with any supporting materials." ;
    bpot:hierarchyID "3.3" ;
    bpot:pcfID "20008" .

bpot:PCF_20623 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20608 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide IT transformation guidance" ;
    bpot:apqcSourceText "Understanding the necessity of IT transformation for the business. Collect and analyze customer requirements. Identify opportunities and prioritize outcomes. Develop and support business case for transformation. Develop transformation plan and roadmap. " ;
    bpot:hierarchyID "8.1.4" ;
    bpot:pcfID "20623" .

bpot:PCF_20682 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20652 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Control IT management system" ;
    bpot:apqcSourceText "Regulating the IT management system through performance measures, governance, analysis, and monitoring through a variety of analytic tools. Evaluate IT finances, resource, services, projects, and value for report out. " ;
    bpot:hierarchyID "8.2.5" ;
    bpot:pcfID "20682" .

bpot:PCF_20848 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20824 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement technology solutions" ;
    bpot:apqcSourceText "Deploy the identified solutions for information technology important for healthy business operations. Confirm status and operational availability of IT resources. Perform testing and distribution of change. Execute roll-back protocol if necessary." ;
    bpot:hierarchyID "8.6.4" ;
    bpot:pcfID "20848" .

bpot:PCF_10013 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and Manage Business Capabilities" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Performing activities by an organization that are fundamental to the successful operation of the organization, even across functions in a business. Capabilities defined in the PCF include business process management; portfolio, program, and project management; quality management; change management; benchmarking; environmental health and safety management; and knowledge management." ;
    bpot:hierarchyID "13.0" ;
    bpot:pcfID "10013" .

bpot:PCF_10017 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17040 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess the external environment" ;
    bpot:apqcSourceText "Assessing all forces, entities, and systems that are external to an organization but can affect its operation. Analyze far-reaching currents in the macroeconomic situation, assess the competition, evaluate technological changes, and identify societal as well as ecological issues of concern. Create a big-picture understanding of externalities, with sufficient depth across individual aspects." ;
    bpot:hierarchyID "1.1.1" ;
    bpot:pcfID "10017" .

bpot:PCF_11740 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_19696 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product and service master data" ;
    bpot:apqcSourceText "Controlling/authorizing to enable services' and products' data and other critical data of these functions through a well secured storage and accessibility processes backed by siloed applications/IT systems." ;
    bpot:hierarchyID "2.1.4" ;
    bpot:pcfID "11740" .

bpot:PCF_12669 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_12658 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process warranty claims" ;
    bpot:apqcSourceText "Identifying, investigating, and processes warranty claims. This process includes: receipt and validation of a warranty claim; definition and diagnosis /root cause analysis of an issue and recommendation for corrective action; the determination of responsibility for settlement of the claim; the transaction being approved or denied; and the originator being notified and payment authorized. In the case of a recurring event, further investigation (definition and diagnosis or root cause analysis) is performed, and a recommendation for corrective action is made and implemented in production/design. It ends when the claim is closed." ;
    bpot:hierarchyID "6.3.2" ;
    bpot:pcfID "12669" .

bpot:PCF_17059 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_17058 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform global trade services" ;
    bpot:apqcSourceText "Making and collecting payments for transactions in products/services, and transporting them to interested markets." ;
    bpot:hierarchyID "9.11" ;
    bpot:pcfID "17059" .

bpot:PCF_20593 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20008 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage pricing" ;
    bpot:apqcSourceText "Determining and maintaining a pricing mechanism based on forecasted sales and that enables a pricing equilibrium for the lifecycles of products/services. Create a pricing mechanism, factoring in attributes relating to the market, customers, sales, and the cost of production. Implement this pricing mechanism over all products/services. Analyze its performance, and adjust accordingly." ;
    bpot:hierarchyID "3.3.3" ;
    bpot:pcfID "20593" .

bpot:PCF_20707 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop IT compliance, risk, and security strategy" ;
    bpot:apqcSourceText "Ensuring that the organization effectively manages risk. Develop rules and standards for robust IT operations, manage risk, and adopt measures to protect integrity, confidentiality, and security of IT assets. " ;
    bpot:hierarchyID "8.3.1" ;
    bpot:pcfID "20707" .

bpot:PCF_20721 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20706 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Control IT risk, compliance, and security" ;
    bpot:apqcSourceText "Ensure effective control in overall IT risk management, formulate and execute guidelines in-line with regulatory bodies, and manage organizational security throughout the business operations." ;
    bpot:hierarchyID "8.3.3" ;
    bpot:pcfID "20721" .

bpot:PCF_20895 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_20866 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define service support planning" ;
    bpot:apqcSourceText "Develop strategies and methodologies to provide service support. Examine service levels, support complexity, stakeholder requirements to offer service support." ;
    bpot:hierarchyID "8.7.5" ;
    bpot:pcfID "20895" .

bpot:PCF_20958 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17043 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop human resources strategy" ;
    bpot:apqcSourceText "Creating a long-term plan to associate human resource requirements with the strategic goals of the company to ensure that there is enough qualified staffing to achieve those goals, to maintain competitive advantage and to reduce employee turnover." ;
    bpot:hierarchyID "7.1.1" ;
    bpot:pcfID "20958" .

bpot:PCF_10038 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10015 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define and evaluate strategic options to achieve the mission" ;
    bpot:apqcSourceText "Assessing sets of strategic decisions designed to drive the organization's long-term objectives. Identify various strategies concerning core functional areas. Appraise strategic options in light of auxiliary decision frameworks that ensure smooth functioning, the advancement of functional efficiencies, and vitality. Involve senior management executives, especially strategy and/or business unit personnel, with need-based consultative assistance from professional services providers." ;
    bpot:hierarchyID "1.2.2" ;
    bpot:pcfID "10038" .

bpot:PCF_10756 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10733 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process accounts payable (AP)" ;
    bpot:apqcSourceText "Processing payments of operating expenses and other supplier charges. This includes the development of policies and procedures around processing of accounts payable and all operations. This process is often supported by key technology enablers." ;
    bpot:hierarchyID "9.6.1" ;
    bpot:pcfID "10756" .

bpot:PCF_20959 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_10013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop, manage, and deliver analytics" ;
    bpot:apqcSourceText "Creating new and improving existing analytical capabilities to enhance data management pipeline. " ;
    bpot:hierarchyID "13.7" ;
    bpot:pcfID "20959" .

bpot:PCF_21576 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: ProcessGroup" ;
    skos:broader bpot:PCF_19207 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage asset end-of-life" ;
    bpot:apqcSourceText "Managing the disposition of assets at their end-of-life. End-of-life for an asset may be due to obsolescence, replacement, excess capacity, or disrepair among other potential factors. Steps may include decommissioning, disassembly, recycling, etc. Tracking and reporting may also be appropriate for some or all asset types due to law, regulation, or social/environmental responsibility." ;
    bpot:hierarchyID "10.4" ;
    bpot:pcfID "21576" .

bpot:PCF_10130 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10103 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop sales partner/alliance relationships" ;
    bpot:apqcSourceText "Cultivating an alliance of partners by identifying, analyzing, negotiating, and managing partnerships with other economic agents." ;
    bpot:hierarchyID "3.4.2" ;
    bpot:pcfID "10130" .

bpot:PCF_17042 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10215 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan distribution requirements" ;
    bpot:apqcSourceText "Maintaining master data of finished products and inventory. Identify the requirements of finished products at the destination, as well as partner requirements. Calculate the consolidation at source. Manage replenishment planning. Create and administer a dispatch plan. Calculate load plans for destinations and partners. Manage the cost of supplying these products. Ensure effective utilization of capacity." ;
    bpot:hierarchyID "4.1.5" ;
    bpot:pcfID "17042" .

bpot:PCF_17058 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Category" ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage Financial Resources" ;
    skos:topConceptOf bpot:PCF ;
    bpot:apqcSourceText "Overseeing key back-office processes for organizations. This category includes process groups related to planning and management accounting, revenue accounting, general accounting and reporting, fixed-asset project accounting, payroll, accounts payable and expense reimbursements, treasury operations, internal controls, tax management, international funds/consolidation, and global trade services." ;
    bpot:hierarchyID "9.0" ;
    bpot:pcfID "17058" .

bpot:PCF_19993 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10062 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and prototype products and services" ;
    bpot:apqcSourceText "Sketching and standardizing product and service based on the market. Analyze the data market competitiveness and innovation attained for the product and service development." ;
    bpot:hierarchyID "2.3.1" ;
    bpot:pcfID "19993" .

bpot:PCF_11779 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_10105 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and manage sales proposals, bids, and quotes" ;
    bpot:apqcSourceText "Understanding and refining the customer requirements as provided in a RFP (Request for Proposal) or RFI (Request for Information).  When compiling the response, they must take into consideration whether the requirements are a match with the strategic or tactical plans of the organization and whether they are able to submit a bid/proposal that is competitive based on an understanding of the offerings of other competing organizations. The next step will be to define the pricing and scheduling of the proposed solution and determine whether the proposal will be profitable for the company if accepted. The bid is then submitted and a notification of whether or not it was successful is received." ;
    bpot:hierarchyID "3.5.3" ;
    bpot:pcfID "11779" .

bpot:PCF_17045 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_17043 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and implement workforce strategy and policies" ;
    bpot:apqcSourceText "Creating and executing strategies and policies for smooth administration of work force. Determine and gather skill requirements. Plan the requirements for employee resourcing per unit. Create compensation, succession, HR program, and employee diversity plans. Develop and administer policies for HR. Develop benefits for employees. Create models for work force strategies." ;
    bpot:hierarchyID "7.1.2" ;
    bpot:pcfID "17045" .

bpot:PCF_21457 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11074 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan for change" ;
    bpot:apqcSourceText "Evaluating impact and planning change activities. Spanning the lifecycle of change from initial concept, to designing, implementing, and sustaining the change, change planning identifies the activities to enage and enable the stakeholders and all impacted by the change. Change plans should address the interplay between people, process, technology, and knowledge to guide the transition, or tranformation, from current state to the future state." ;
    bpot:hierarchyID "13.4.1" ;
    bpot:pcfID "21457" .

bpot:PCF a skos:ConceptScheme ;
    rdfs:label "APQC Process Classification Framework (Cross-Industry)" ;
    skos:hasTopConcept bpot:PCF_10002,
        bpot:PCF_10003,
        bpot:PCF_10004,
        bpot:PCF_10007,
        bpot:PCF_10012,
        bpot:PCF_10013,
        bpot:PCF_16437,
        bpot:PCF_17058,
        bpot:PCF_19207,
        bpot:PCF_20022,
        bpot:PCF_20025,
        bpot:PCF_20085,
        bpot:PCF_20607 ;
    skos:prefLabel "APQC PCF Cross-Industry v7.4" .

