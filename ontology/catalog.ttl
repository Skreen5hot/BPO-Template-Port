    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage notification outcome" ;
    bpot:apqcSourceText "Handling proposals depending on whether they were accepted or rejected." ;
    bpot:hierarchyID "3.5.3.15" ;
    bpot:pcfID "11793" .

bpot:PCF_12045 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10369 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track and analyze non-conformance trends" ;
    bpot:apqcSourceText "Managing and monitoring the occurrences of problems with a process or product. It is important that nonconformance occurrences are tracked in a standardized way so the data can easily be reviewed to assess the impact of the problem. Ongoing analysis of trends in nonconformance gives an organization the ability to make process changes to reduce the incidence and cost of nonconformances." ;
    bpot:hierarchyID "4.3.3.5" ;
    bpot:pcfID "12045" .

bpot:PCF_12046 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10369 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform root cause analysis" ;
    bpot:apqcSourceText "Using a technique that helps people answer the question of why a problem occurred in the first place. It seeks to identify the origin of a problem using a specific set of steps, with associated tools, to find the primary cause of the problem to determine what happened, why, and how to reduce the likelihood that it will happen again." ;
    bpot:hierarchyID "4.3.3.6" ;
    bpot:pcfID "12046" .

bpot:PCF_12128 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_12127 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop service delivery training plan" ;
    bpot:apqcSourceText "Creating a detailed summary of all the actions relevant to teaching a person a particular skill or type of behavior. Determine who will deliver the training. Determine when and where the apprentice or trainee needs to go to receive the structured component of the training." ;
    bpot:hierarchyID "5.2.3.1" ;
    bpot:pcfID "12128" .

bpot:PCF_12129 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_12127 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop training materials" ;
    bpot:apqcSourceText "Developing materials necessary to provide comprehensive training for the skills or behavior needed to deliver services. This can be any number for formats such as classroom or computer based training." ;
    bpot:hierarchyID "5.2.3.2" ;
    bpot:pcfID "12129" .

bpot:PCF_12131 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_12127 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage training schedule" ;
    bpot:apqcSourceText "Providing training to the employee within a manageable timeframe to meet the needs of both the individual and the organization. " ;
    bpot:hierarchyID "5.2.3.3" ;
    bpot:pcfID "12131" .

bpot:PCF_12132 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_12127 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deliver operations training" ;
    bpot:apqcSourceText "Educating service delivery personnel on all aspects of the operations process of the organization." ;
    bpot:hierarchyID "5.2.3.4" ;
    bpot:pcfID "12132" .

bpot:PCF_12133 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
