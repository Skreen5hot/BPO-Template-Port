        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_12669 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Notify originator of approve/reject decision" ;
    bpot:apqcSourceText "Contacting the originator of whether the warranty claim has been approved or rejected." ;
    bpot:hierarchyID "6.3.2.7" ;
    bpot:pcfID "20103" .

