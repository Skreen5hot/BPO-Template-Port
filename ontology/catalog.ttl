    skos:inScheme bpot:PCF ;
    skos:prefLabel "Relocate material and tools" ;
    bpot:apqcSourceText "Relocating the tools and raw materials. Shift raw or finished material and machines of company from one place to another place according to changes in business requirements." ;
    bpot:hierarchyID "10.1.4.2" ;
    bpot:pcfID "10966" .

bpot:PCF_10967 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19239 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze assets and predict maintenance requirements" ;
    bpot:apqcSourceText "Evaluating assets in order to project future requirements for maintenance. Evaluate the present working condition of assets. Determine the future maintenance requirements of assets." ;
    bpot:hierarchyID "10.3.1.2" ;
    bpot:pcfID "10967" .

bpot:PCF_10968 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19239 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Integrate preventive maintenance into operations schedule" ;
    bpot:apqcSourceText "Devising a methodology and procedure for assimilating the works of planned maintenance into the schedule scheme for the processing of finished products that utilizes the same machinery. " ;
    bpot:hierarchyID "10.3.1.4" ;
    bpot:pcfID "10968" .

bpot:PCF_11035 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan, build, and manage lender relations" ;
    bpot:apqcSourceText "Building and managing relations with bankers or lenders through strong products/services strategies that bankers would want to invest in. Foster a receptive environment for low rates of interest, easy access to loans, etc." ;
    bpot:hierarchyID "12.1.1" ;
    bpot:pcfID "11035" .

bpot:PCF_11036 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan, build, and manage analyst relations" ;
    bpot:apqcSourceText "Creating and maintaining long-term relations with analysts. Involve analysts in strategy and product decisions in order to elicit valuable information." ;
    bpot:hierarchyID "12.1.2" ;
    bpot:pcfID "11036" .

bpot:PCF_11037 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11010 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate with shareholders" ;
    bpot:apqcSourceText "Practicing regular, transparent communication with shareholders through annual shareholders' meetings, quarterly earnings calls, shareholders letters, one-on-one emails or calls, etc." ;
    bpot:hierarchyID "12.1.3" ;
    bpot:pcfID "11037" .

bpot:PCF_11041 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11011 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage lobby activities" ;
    bpot:apqcSourceText "Managing lobbying activities to affect government policies. " ;
    bpot:hierarchyID "12.2.4" ;
    bpot:pcfID "11041" .

bpot:PCF_11042 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11012 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report financial results" ;
    bpot:apqcSourceText "Reporting financial results to management, and releasing results to the public. Report financial statements, including the income statement, balance sheet, and statement of cash flows." ;
    bpot:hierarchyID "12.3.1" ;
    bpot:pcfID "11042" .

bpot:PCF_11043 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11012 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report audit findings" ;
    bpot:apqcSourceText "Reporting audit findings to management. Practice an internal audit with criteria for confirming a problem, a description of the situation, and the root cause of the problem. Make recommendations that resolve the issue." ;
    bpot:hierarchyID "12.3.2" ;
    bpot:pcfID "11043" .

bpot:PCF_11044 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create ethics policies" ;
    bpot:apqcSourceText "Creating a code of ethics that communicate the organization's philosophy to employees, vendors, customers, clients, and the public." ;
    bpot:hierarchyID "12.4.1" ;
    bpot:pcfID "11044" .

bpot:PCF_11045 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage corporate governance policies" ;
    bpot:apqcSourceText "Administering the system of rules, practices, and processes through which a company is directed and controlled. Balance stakeholder interests including shareholders, management, customers, suppliers, financiers, government, and the community. Outline a strategy for achieving organizational goals, from action plans and internal controls to performance measurement and corporate disclosure." ;
    bpot:hierarchyID "12.4.2" ;
    bpot:pcfID "11045" .

bpot:PCF_11046 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and perform preventive law programs" ;
    bpot:apqcSourceText "Creating and applying programs and activities. Encourage the adherence preventive laws, such as environmental law, sex discrimination, computer law, estate planning, corporate compliance, business planning, and property transactions." ;
    bpot:hierarchyID "12.4.3" ;
    bpot:pcfID "11046" .

bpot:PCF_11050 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Resolve disputes and litigations" ;
    bpot:apqcSourceText "Resolving disputes or civil lawsuits internally or externally. " ;
    bpot:hierarchyID "12.4.7" ;
    bpot:pcfID "11050" .

bpot:PCF_11051 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide legal advice/counseling" ;
    bpot:apqcSourceText "Providing legal advice concerning the substance or procedure of a law in relation to a particular situation." ;
    bpot:hierarchyID "12.4.8" ;
    bpot:pcfID "11051" .

bpot:PCF_11052 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11013 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Negotiate and document agreements/contracts" ;
    bpot:apqcSourceText "Negotiating terms to reach a final draft of a contract that is acceptable to all parties. " ;
    bpot:hierarchyID "12.4.9" ;
    bpot:pcfID "11052" .

bpot:PCF_11053 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11047 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Plan and initiate compliance program" ;
    bpot:apqcSourceText "Employing an internal system or process to identify and reduce the risk of breaching the Competition and Consumer Act 2010. Remedy any breach. Create a culture of compliance. Design compliance programs." ;
    bpot:hierarchyID "12.4.4.1" ;
    bpot:pcfID "11053" .

bpot:PCF_11054 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11047 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Execute compliance program" ;
    bpot:apqcSourceText "Implementing the established compliance program in order to meet the government laws and regulations. Create a compliance team that scrutinizes the rules set out by government bodies such as the Securities and Exchange Commission." ;
    bpot:hierarchyID "12.4.4.2" ;
    bpot:pcfID "11054" .

bpot:PCF_11056 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess problem and determine work requirements" ;
    bpot:apqcSourceText "Examining the problems and deciding the action requirements for engaging outside counsel. This process element calls upon the organization to internally analyze the issues for which assistance from external counsel is needed. Additionally, the organization needs to break-down the issue, identifying the tasks and exercises where outside counsel can help." ;
    bpot:hierarchyID "12.4.5.1" ;
    bpot:pcfID "11056" .

bpot:PCF_11057 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Engage/Retain outside counsel if necessary" ;
    bpot:apqcSourceText "Recruiting the assistance of outside counsel for any legal and/or ethical concerns. Engage and/or retain any external counsel sought from subject matter experts and professionals." ;
    bpot:hierarchyID "12.4.5.2" ;
    bpot:pcfID "11057" .

bpot:PCF_11058 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Receive strategy/budget" ;
    bpot:apqcSourceText "Making a financial plan. This strategy sets out, using figures, an organization's expected future results. Enlist the finance function to support work generated by other business functions in order to build and secure their support for the budget." ;
    bpot:hierarchyID "12.4.5.3" ;
    bpot:pcfID "11058" .

bpot:PCF_11059 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Receive work product and manage/monitor case and work performed" ;
    bpot:apqcSourceText "Receiving deliverables from outside counsel, and monitoring the efforts committed by them. Track the progress of, collect, and validate the required work product from the subject matter experts and professionals engaged as external counsel. Verify the amount of effort dedicated by these counsels to the issue at hand, in order to confirm their fees." ;
    bpot:hierarchyID "12.4.5.4" ;
    bpot:pcfID "11059" .

bpot:PCF_11060 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Process payment for legal services" ;
    bpot:apqcSourceText "Making payments to legal advisers for their services. Payments include addressing issues or suits by customers, suppliers, competitors, bankers, government agencies, etc." ;
    bpot:hierarchyID "12.4.5.5" ;
    bpot:pcfID "11060" .

bpot:PCF_11061 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11048 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Track legal activity/performance" ;
    bpot:apqcSourceText "Keeping track of the legal activities and performance of the organization. " ;
    bpot:hierarchyID "12.4.5.6" ;
    bpot:pcfID "11061" .

bpot:PCF_11062 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11049 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage copyrights, patents, and trademarks" ;
    bpot:apqcSourceText "Managing the patents and copyrights already held or sought by the organization. Administer and oversee applying for, securing, and maintaining intellectual property rights in the form of patents and copyrights. Submit applications for such rights. Handle associated legal issues. Draft and communicate proper attributions. Collect royalties. Monitor any misuse of the intellectual property rights." ;
    bpot:hierarchyID "12.4.6.1" ;
    bpot:pcfID "11062" .

bpot:PCF_11063 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11049 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain intellectual property rights and restrictions" ;
    bpot:apqcSourceText "Managing the upkeep of intellectual property rights by creating and managing a framework of rules, policies, procedures, and restrictions. Outline a clear policy for any possible scenario of their use by any external agent." ;
    bpot:hierarchyID "12.4.6.2" ;
    bpot:pcfID "11063" .

bpot:PCF_11064 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11049 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Administer licensing terms" ;
    bpot:apqcSourceText "Administering and overseeing the terms and policies associated with licensing the organization's intellectual property. Create and manage the policies and terms governing the possible granting of a license to any external agent. Demarcate a clear framework that governs the licensing of any patents or copyrights held by the organization." ;
    bpot:hierarchyID "12.4.6.3" ;
    bpot:pcfID "11064" .

bpot:PCF_11065 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11049 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Administer options" ;
    bpot:apqcSourceText "Managing options regarding licensing agreements. Follow favorable terms and conditions. " ;
    bpot:hierarchyID "12.4.6.4" ;
    bpot:pcfID "11065" .

bpot:PCF_11066 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11014 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage community relations" ;
    bpot:apqcSourceText "Developing and administering community relations. Establish business connections with the people constituting the environment the organization operates in and draws resources from in order to foster mutual understanding, trust, and support. Create programs that promote the organization's image in a positive and community-oriented way." ;
    bpot:hierarchyID "12.5.1" ;
    bpot:pcfID "11066" .

bpot:PCF_11067 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11014 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage media relations" ;
    bpot:apqcSourceText "Developing and managing relations with media. Develop connections with journalists to solicit critical, third-party endorsements for a product, issue, service, or organization." ;
    bpot:hierarchyID "12.5.2" ;
    bpot:pcfID "11067" .

bpot:PCF_11068 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11014 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Promote political stability" ;
    bpot:apqcSourceText "Promoting political security and stability in the regions where the organization conducts business. Encourage political stability in the regions where the organization operates. Support civic programs, citizen engagement, connection platforms, etc." ;
    bpot:hierarchyID "12.5.3" ;
    bpot:pcfID "11068" .

bpot:PCF_11069 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11014 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create press releases" ;
    bpot:apqcSourceText "Developing press releases to communicate developments and generate interest in the organization. " ;
    bpot:hierarchyID "12.5.4" ;
    bpot:pcfID "11069" .

bpot:PCF_11070 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11014 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Issue press releases" ;
    bpot:apqcSourceText "Issuing press releases to carefully selected media in distribution channels such as the web, newspapers, and social media." ;
    bpot:hierarchyID "12.5.5" ;
    bpot:pcfID "11070" .

bpot:PCF_11075 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21585 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define enterprise measurement models" ;
    bpot:apqcSourceText "Developing a model for organization's management systems. Develop a high-level measurement system to track performance across the enterprise or in specific functions or business units. Determine which processes to measure, which measures to use, how often to measure, and measurement targets. Review strategic decisions about how to best measure an organization." ;
    bpot:hierarchyID "13.6.1.1" ;
    bpot:pcfID "11075" .

bpot:PCF_11083 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11072 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct performance assessments" ;
    bpot:apqcSourceText "Measuring, researching, and recording the performance of people, processes, mechanisms, or other areas of the business that the organization wants to benchmark or track." ;
    bpot:hierarchyID "13.6.2.1" ;
    bpot:pcfID "11083" .

bpot:PCF_11084 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11072 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop benchmarking capabilities" ;
    bpot:apqcSourceText "Improving an organization's ability to compare its performance internally or externally, and maintaining benchmarking relationships with other organizations. Train staff in benchmarking. Develop technological solutions or other materials to aid benchmarking efforts. Consult with external entities to gain knowledge or tools to help benchmark." ;
    bpot:hierarchyID "13.6.2.2" ;
    bpot:pcfID "11084" .

bpot:PCF_11085 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11072 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct internal and external benchmarking" ;
    bpot:apqcSourceText "Benchmarking internal processes and against external competitors. " ;
    bpot:hierarchyID "13.6.2.3" ;
    bpot:pcfID "11085" .

bpot:PCF_11087 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11072 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct gap analysis" ;
    bpot:apqcSourceText "Examining performance against benchmarked organizations or entities. Determine how much performance needs to change to meet expectations. Reach strategic goals." ;
    bpot:hierarchyID "13.6.2.4" ;
    bpot:pcfID "11087" .

bpot:PCF_11088 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11072 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish need for change" ;
    bpot:apqcSourceText "Establishing a need for changing the performance of the organization. Make use of the gap analysis results in order to define the need for change. " ;
    bpot:hierarchyID "13.6.2.5" ;
    bpot:pcfID "11088" .

bpot:PCF_11100 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop governance model with roles and accountability" ;
    bpot:apqcSourceText "Developing a structure for the governance of the organization's collective knowledge. Gather, maintain, and make accessible the collective knowledge base. Develop a standard procedure for the conservation and perpetuation of the organization's knowledge. Create policies for the usage and maintenance of this knowledge. Establish specialized roles." ;
    bpot:hierarchyID "13.5.1.1" ;
    bpot:pcfID "11100" .

bpot:PCF_11102 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define roles and accountability of core group versus operating units" ;
    bpot:apqcSourceText "Clearly determining the roles and responsibilities of all personnel involved in the management of the organization's corpus of knowledge. Flesh out the roles and responsibilities of the KM core group, as well as the operational staff involved in the upkeep of the knowledge management program." ;
    bpot:hierarchyID "13.5.1.2" ;
    bpot:pcfID "11102" .

bpot:PCF_11103 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop funding models" ;
    bpot:apqcSourceText "Analyze the organization's current approach to funding. Learn from the funding approaches of peer organizations. Evaluate the revenue potential and costs of those short-list funding models. Select funding models to implement." ;
    bpot:hierarchyID "13.5.1.3" ;
    bpot:pcfID "11103" .

bpot:PCF_11104 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify links to key initiatives" ;
    bpot:apqcSourceText "Identifying any links that exist between the strategy for knowledge management and any other functional areas. Determine any correlations that exist between the strategic road map for the knowledge management and any other functional areas. Study each function's/unit's attributes." ;
    bpot:hierarchyID "13.5.1.4" ;
    bpot:pcfID "11104" .

bpot:PCF_11105 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop core KM methodologies" ;
    bpot:apqcSourceText "Creating core knowledge management procedures and methodologies. Initiate developing a strategy, planning, execution, and improvement." ;
    bpot:hierarchyID "13.5.1.5" ;
    bpot:pcfID "11105" .

bpot:PCF_11106 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess IT needs and engage IT function" ;
    bpot:apqcSourceText "Determining the IT needs for developing the knowledge management strategy, and collaborating with the IT function to implement the strategy. Assess requirements for technologies such as computer hardware, software, electronics, semiconductors, internet, and telecommunications equipment in order to effectively build and implement the strategy for knowledge management." ;
    bpot:hierarchyID "13.5.1.6" ;
    bpot:pcfID "11106" .

bpot:PCF_11107 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop training and communication plans" ;
    bpot:apqcSourceText "Creating plans for KM training plans and conveying the knowledge management strategy within the organization. Create training programs, sessions, and activities in order to familiarize employees and management with the concept of knowledge management." ;
    bpot:hierarchyID "13.5.1.7" ;
    bpot:pcfID "11107" .

bpot:PCF_11108 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop change management approaches" ;
    bpot:apqcSourceText "Creating approaches for effectively administering the changes in knowledge management. Design an approach that transforms individuals, teams, and the organization to a desired future state represented by the change." ;
    bpot:hierarchyID "13.5.1.8" ;
    bpot:pcfID "11108" .

bpot:PCF_11109 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11095 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop strategic measures and indicators" ;
    bpot:apqcSourceText "Establishing measures and indicators for evaluating the performance of the knowledge management function. Define key performance indicators such as the amount of knowledge assets created and number of knowledge projects undertaken." ;
    bpot:hierarchyID "13.5.1.9" ;
    bpot:pcfID "11109" .

bpot:PCF_11110 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11096 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess maturity of existing KM initiatives" ;
    bpot:apqcSourceText "Evaluating if initiatives are effective or should be discarded. Design a framework for assessing maturity, typically from Level 1 (undefined), Level 2 (repeatable), Level 3 (defined), and Level 4 (managed) through Level 5 (optimized)." ;
    bpot:hierarchyID "13.5.2.1" ;
    bpot:pcfID "11110" .

bpot:PCF_11111 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11096 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate existing KM approaches" ;
    bpot:apqcSourceText "Evaluating existing procedures, policies, and guidelines for knowledge management. Study and examine the organization's approach against industry best practices by benchmarking, competitive analysis, etc." ;
    bpot:hierarchyID "13.5.2.2" ;
    bpot:pcfID "11111" .

bpot:PCF_11112 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11096 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify gaps and needs" ;
    bpot:apqcSourceText "Assessing the KM approach evaluations in order to identify any gaps or needs. Compare the performance of the KM approach against the desired or expected performance, as well as against the standard knowledge management industry approach." ;
    bpot:hierarchyID "13.5.2.3" ;
    bpot:pcfID "11112" .

bpot:PCF_11113 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20969 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Enhance/Modify existing KM approaches" ;
    bpot:apqcSourceText "Leveraging KM evaluations and identified gap to enhance existing approaches. " ;
    bpot:hierarchyID "13.5.4.1" ;
    bpot:pcfID "11113" .

bpot:PCF_11114 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20965 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop new KM approaches" ;
    bpot:apqcSourceText "Designing new policies, procedures, and guidelines to support knowledge management." ;
    bpot:hierarchyID "13.5.3.1" ;
    bpot:pcfID "11114" .

bpot:PCF_11115 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20965 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement new KM approaches" ;
    bpot:apqcSourceText "Implementing new policies, procedures, and guidelines to support knowledge management." ;
    bpot:hierarchyID "13.5.3.3" ;
    bpot:pcfID "11115" .

bpot:PCF_11117 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16411 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify project requirements and objectives" ;
    bpot:apqcSourceText "Recognizing and defining what the project is ultimately supposed to do. Specify the capabilities, features, or attributes of the project's deliverables, as well as any kind of formal documentation." ;
    bpot:hierarchyID "13.2.3.1.1" ;
    bpot:pcfID "11117" .

bpot:PCF_11118 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16411 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess culture and readiness for project management approach" ;
    bpot:apqcSourceText "Evaluating the culture and readiness of the organizational environment is order to implement the project management approach. " ;
    bpot:hierarchyID "13.2.3.1.3" ;
    bpot:pcfID "11118" .

bpot:PCF_11119 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_16410 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify appropriate project management methodologies" ;
    bpot:apqcSourceText "Identifying and implementing the techniques and procedures for managing business projects. Identify the most appropriate models, which are to be employed by the project managers for the purpose of designing, planning, implementing, and achieving project objectives. Examine and assess various project management methodologies such as adaptive project framework, agile development, crystal methods, and feature-driven development." ;
    bpot:hierarchyID "13.2.3.2" ;
    bpot:pcfID "11119" .

bpot:PCF_11120 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16411 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create business case" ;
    bpot:apqcSourceText "Creating a document that includes the current situation, proposed solution, financial analysis, conclusion, etc. Convince a decision maker and investors to approve the project. Obtain funding." ;
    bpot:hierarchyID "13.2.3.1.4" ;
    bpot:pcfID "11120" .

bpot:PCF_11121 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16411 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop project measures and indicators" ;
    bpot:apqcSourceText "Developing procedures and indictors to assess performance of business projects. Design and develop metrics and indicators--such as cost, schedule, resources, risk, and quality--that exhibit the performance of the business projects." ;
    bpot:hierarchyID "13.2.3.1.5" ;
    bpot:pcfID "11121" .

bpot:PCF_11123 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define roles and resources" ;
    bpot:apqcSourceText "Outlining the resources and their roles in the business projects. " ;
    bpot:hierarchyID "13.2.3.3.1" ;
    bpot:pcfID "11123" .

bpot:PCF_11124 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify specific IT requirements" ;
    bpot:apqcSourceText "Determining the IT requirements for specific business projects. Identify the requirements of computers and telecommunications equipment to store, retrieve, transmit, and manipulate data related to the project. Consider factors such as functional requirements, design requirements, project phases, and project schedule." ;
    bpot:hierarchyID "13.2.3.3.3" ;
    bpot:pcfID "11124" .

bpot:PCF_11125 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create training and communication plans" ;
    bpot:apqcSourceText "Designing a plan for equipping the project team with the necessary skills and abilities to fulfill their roles and responsibilities in the project effectively and efficiently. Offer formal training, mentoring, or coaching. Initiate informal conversations. Communicate messages during the project." ;
    bpot:hierarchyID "13.2.3.3.4" ;
    bpot:pcfID "11125" .

bpot:PCF_11127 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design recognition and reward approaches" ;
    bpot:apqcSourceText "Creating a plan for recognizing and rewarding extraordinary performances within the business projects. Use incentives, bonuses, and certificates for recognition and rewarding purposes." ;
    bpot:hierarchyID "13.2.3.3.5" ;
    bpot:pcfID "11127" .

bpot:PCF_11128 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design and plan launch of project" ;
    bpot:apqcSourceText "Creating a plan specifying when to initiate the project, and introducing it to the target audience. Clearly define the project team, objectives, timelines, and milestone." ;
    bpot:hierarchyID "13.2.3.3.6" ;
    bpot:pcfID "11128" .

bpot:PCF_11129 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16413 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Deploy the project" ;
    bpot:apqcSourceText "Putting the project into position by effectively bringing it into action. " ;
    bpot:hierarchyID "13.2.3.3.7" ;
    bpot:pcfID "11129" .

bpot:PCF_11131 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16414 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate impact of project management (strategy and projects) on measures and outcomes" ;
    bpot:apqcSourceText "Assessing the impact of business project management on the measures and outcomes of the projects. Gauge non-financial measures, frequency of measurement, action plan, etc." ;
    bpot:hierarchyID "13.2.3.4.1" ;
    bpot:pcfID "11131" .

bpot:PCF_11132 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16414 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Promote and sustain activity and involvement" ;
    bpot:apqcSourceText "Encouraging and sustaining the activities and involvement while executing projects. Promote the execution activities of the projects. Encourage employee involvement in project implementation. " ;
    bpot:hierarchyID "13.2.3.4.4" ;
    bpot:pcfID "11132" .

bpot:PCF_11133 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_16414 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Realign and refresh project management strategy and approaches" ;
    bpot:apqcSourceText "Reorganizing and stimulating the approach and strategy for managing business projects. Make improvements based on the project scope and on findings from Evaluate the impact of project management (strategy and projects) on measures and outcomes [11131]." ;
    bpot:hierarchyID "13.2.3.4.6" ;
    bpot:pcfID "11133" .

bpot:PCF_11138 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21453 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Select process improvement methodology" ;
    bpot:apqcSourceText "Assessing and choosing methodologies to identify, analyze, and improve existing processes within an organization to meet new goals and objective. Assess the various methodologies available such as process mapping, statistical process control, and simulation. Choose the most appropriate and effective methodology." ;
    bpot:hierarchyID "13.1.5.2" ;
    bpot:pcfID "11138" .

bpot:PCF_11139 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess readiness for change" ;
    bpot:apqcSourceText "Determining the level of preparedness of the conditions, attitudes, and resources at all levels in the organization needed for change to happen successfully. Define scope of the proposed change. Select the tools for a change readiness assessment." ;
    bpot:hierarchyID "13.4.1.2" ;
    bpot:pcfID "11139" .

bpot:PCF_11140 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine stakeholders" ;
    bpot:apqcSourceText "Identifying and communicating with shareholders affected by the change. Consider internal and external stakeholders that will be affected by the change. Determine the amount of influence the change will have on them. Ensure the involvement of these stakeholders in the change process by effectively communicating with them. " ;
    bpot:hierarchyID "13.4.1.1" ;
    bpot:pcfID "11140" .

bpot:PCF_11141 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify change champion(s)" ;
    bpot:apqcSourceText "Identifying people exhibit an extraordinary interest in the adoption, implementation, and success of the change. Engage champions in each division or team. Define the roles and responsibilities for the change champions. Determine criteria for selecting change champions. Provide training sessions to champions. Reward and recognize champions." ;
    bpot:hierarchyID "13.4.1.3" ;
    bpot:pcfID "11141" .

bpot:PCF_11142 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Form design team" ;
    bpot:apqcSourceText "Preparing a design team for implementing change throughout the organization. " ;
    bpot:hierarchyID "13.4.1.4" ;
    bpot:pcfID "11142" .

bpot:PCF_11143 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define scope" ;
    bpot:apqcSourceText "Defining the extent of the area or subject matter that the change process deals with or to which it is relevant. Establish a set of tools, processes, skills, and principles for managing the people side of change to achieve the required outcomes of the change process." ;
    bpot:hierarchyID "13.4.1.5" ;
    bpot:pcfID "11143" .

bpot:PCF_11144 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Understand current state" ;
    bpot:apqcSourceText "Using graphical and statistical tools such as pareto diagrams, process flow diagrams, cause-and-effect diagrams, check sheets, histograms, run charts, and scatter diagrams." ;
    bpot:hierarchyID "13.4.1.6" ;
    bpot:pcfID "11144" .

bpot:PCF_11145 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define future state" ;
    bpot:apqcSourceText "Determining the state or position that the organization wants to be in after the implementation of the change. Gather necessary information about the processes, structures, and cultures. Define resource requirements." ;
    bpot:hierarchyID "13.4.1.7" ;
    bpot:pcfID "11145" .

bpot:PCF_11146 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct organizational risk analysis" ;
    bpot:apqcSourceText "Looking beyond the immediate consequences of the threat to a critical asset and placing it in the context of what is important to the organization. Identify the impact of threats to critical assets. Create risk evaluation criteria. Evaluate the impact of threats to critical assets. Incorporate probability into the risk analysis." ;
    bpot:hierarchyID "13.4.1.8" ;
    bpot:pcfID "11146" .

bpot:PCF_11147 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess cultural context" ;
    bpot:apqcSourceText "Evaluating the culture within the organization. Adopt a quantitative, multidimensional measurement approach of an organization's culture and the aspirations for it. Diagnose cultural activities, enhance leadership sections. Integrate cultures." ;
    bpot:hierarchyID "13.4.1.9" ;
    bpot:pcfID "11147" .

bpot:PCF_11148 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish accountability for change management" ;
    bpot:apqcSourceText "Identifying and assigning the people accountable for effective change management. Hold managers accountable for ensuring change happens systematically and rigorously. Ensure that certain behaviors are rewarded or reprimanded accordingly." ;
    bpot:hierarchyID "13.4.1.12" ;
    bpot:pcfID "11148" .

bpot:PCF_11149 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify barriers to change" ;
    bpot:apqcSourceText "Recognizing the circumstances or obstacles that keep the organization from progressing. Identify who and what are the resources resisting change. Identify integration failures, threats by competitive forces, and complexity failures." ;
    bpot:hierarchyID "13.4.1.13" ;
    bpot:pcfID "11149" .

bpot:PCF_11150 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Determine change enablers" ;
    bpot:apqcSourceText "Identifying the person(s) or thing(s)responsible for making the change possible. Consider factors such as interdependence of efforts, reward to the integrators, sharing of power and responsibility, and employee understanding of why change is essential." ;
    bpot:hierarchyID "13.4.1.14" ;
    bpot:pcfID "11150" .

bpot:PCF_11151 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21457 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify resources and develop measures" ;
    bpot:apqcSourceText "Recognizing the resource requirements, and developing measures for change. Identify the financial, material, human, and informational resources needed to successfully implement the change. Develop programs, campaigns, etc. for establishing the change within the organization." ;
    bpot:hierarchyID "13.4.1.15" ;
    bpot:pcfID "11151" .

bpot:PCF_11152 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess connection to other initiatives" ;
    bpot:apqcSourceText "Correlating the change initiative with the other initiatives. Create an alignment between the goals and objectives of the change process and that of the other initiatives." ;
    bpot:hierarchyID "13.4.2.1" ;
    bpot:pcfID "11152" .

bpot:PCF_11153 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop change management plans" ;
    bpot:apqcSourceText "Creating a detailed structure summary for the purposes of managing the change. Demonstrate the reasons for the change. Define the type and scope of change. Form a change management team. Create a communication plan. " ;
    bpot:hierarchyID "13.4.2.2" ;
    bpot:pcfID "11153" .

bpot:PCF_11154 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop training plan" ;
    bpot:apqcSourceText "Creating a detailed summary of all the actions relevant to teaching a person a particular skill or type of behavior. Determine who will deliver the training. Determine when and where the apprentice or trainee needs to go to receive the structured component of the training." ;
    bpot:hierarchyID "13.4.2.3" ;
    bpot:pcfID "11154" .

bpot:PCF_11155 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop communication plan" ;
    bpot:apqcSourceText "Developing a plan for imparting or exchanging information relevant the to change. Define goals, objectives, and audience. Gather tools for all communications." ;
    bpot:hierarchyID "13.4.2.4" ;
    bpot:pcfID "11155" .

bpot:PCF_11156 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop rewards/incentives plan" ;
    bpot:apqcSourceText "Creating and designing the plan for rewarding the employees exhibiting the desired behavior. Specify rewards in recognition of service, effort, or achievement regarding the change, including bonuses, compensation, stock options, profit sharing, vacations, and flexible time." ;
    bpot:hierarchyID "13.4.2.6" ;
    bpot:pcfID "11156" .

bpot:PCF_11157 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish change adoption measures" ;
    bpot:apqcSourceText "Establishing a system or standard of measurement for measuring the adoption of the change. Consider activities such as the number of people who have adopted the change, how quickly have they adopted, number of unique adopters, and adopters by teams/divisions." ;
    bpot:hierarchyID "13.4.2.7" ;
    bpot:pcfID "11157" .

bpot:PCF_11158 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Establish/Clarify new roles" ;
    bpot:apqcSourceText "Establishing and explaining the new roles to employees. Assign roles and responsibilities to resources." ;
    bpot:hierarchyID "13.4.2.8" ;
    bpot:pcfID "11158" .

bpot:PCF_11159 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11135 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify budget/roles" ;
    bpot:apqcSourceText "Creating a plan of financial outlay for the newly defined roles. Determine the amount of capital the organization is willing to invest in effectuating these new roles, how would the roles be financed, and what would comprise the ROI from these flows. Coordinate personnel responsible for change management and the finance division." ;
    bpot:hierarchyID "13.4.2.9" ;
    bpot:pcfID "11159" .

bpot:PCF_11160 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11136 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create commitment for improvement/change" ;
    bpot:apqcSourceText "Kindling an organization wide commitment for effectuating the change. Effectively communicate the advantages of the desired change. Personalize the pitch for change. " ;
    bpot:hierarchyID "13.4.3.1" ;
    bpot:pcfID "11160" .

bpot:PCF_11161 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11136 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Reengineer business processes and systems" ;
    bpot:apqcSourceText "Restructuring, redesigning, repurposing, and/or retrofitting existing business processes, activities, and frameworks in order to effectuate the desired change. Review pertinent processes from the ground up by starting with the desired result. (Build on Select a process improvement methodology [11138] to create business processes that perfectly fit with the road map for change.)" ;
    bpot:hierarchyID "13.4.3.2" ;
    bpot:pcfID "11161" .

bpot:PCF_11162 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11136 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Support transition to new roles or exit strategies for incumbents" ;
    bpot:apqcSourceText "Supporting the transition of personnel to new roles and the dismissal of any existing employees, necessitated for the desired change. Create an on-boarding process for seamlessly transitioning personnel to new roles. Offer orientation and training. Address any concerns. Create a structured procedure for the discharge of incumbents from their positions." ;
    bpot:hierarchyID "13.4.3.3" ;
    bpot:pcfID "11162" .

bpot:PCF_11163 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11136 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor change" ;
    bpot:apqcSourceText "Monitoring activities in the change process in order to assess the performance of individual agents and the process as a whole. Oversee the implementation of activities needed for effectuating the change. Track the pace, impact, enthusiasm, reaction, and feedback over the change process." ;
    bpot:hierarchyID "13.4.3.4" ;
    bpot:pcfID "11163" .

bpot:PCF_11164 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor improved process performance" ;
    bpot:apqcSourceText "Monitoring the performance of improved business processes. Track the key performance indicators of the upgraded processes in order to gauge its contribution to the desired change. Expedite through the use of business process management software." ;
    bpot:hierarchyID "13.4.4.1" ;
    bpot:pcfID "11164" .

bpot:PCF_11165 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Capture and reuse lessons learned from change process" ;
    bpot:apqcSourceText "Documenting and standardizing insights gleaned and the knowledge acquired from studying the change process already implemented. Create case studies/best practices guides from the process of implementing change. Include experienced personnel. " ;
    bpot:hierarchyID "13.4.4.2" ;
    bpot:pcfID "11165" .

bpot:PCF_11166 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Take corrective action as necessary" ;
    bpot:apqcSourceText "Implement corrective action to adjust the re-engineered processes for maximizing the desired impact. Adjust business processes and systems to implement the desired change." ;
    bpot:hierarchyID "13.4.4.3" ;
    bpot:pcfID "11166" .

bpot:PCF_11169 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11168 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define offering and positioning" ;
    bpot:apqcSourceText "Defining problem(s) that the organization's products/services solve for the customers, thereby determining how they are positioned in the market. Refine the product/service concepts from the perspective of customers. Succinctly outline the problem the organization's offerings solves for the customers, making a case for why the customer should buy a product or use a service. Define the offering's unique value." ;
    bpot:hierarchyID "3.2.1.1" ;
    bpot:pcfID "11169" .

bpot:PCF_11170 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11168 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop value proposition including brand positioning for target segments" ;
    bpot:apqcSourceText "Boosting the attractiveness of products/services to the targeted customers, and creating a unique brand projection around these features. Identify and enhance those product/service features that reinforce the attractiveness of these offerings, for these segment of customers. Underscore the perceived value delivered to the customers by clearly specifying the relevance and desirability of these products/services. Once it has been clarified how the organization's offerings meet the customer's expectations or deliver specific benefits, position the brands around these benefits." ;
    bpot:hierarchyID "3.2.1.2" ;
    bpot:pcfID "11170" .

bpot:PCF_11171 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11168 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Validate value proposition with target segments" ;
    bpot:apqcSourceText "Validating the desirability of the perceived value delivered by the organization's offerings, to the targeted customer segment. Substantiate the value of the benefits accrued to the customers through the organization's offerings. Justify the value proposition in light of the targeted segments by gathering feedback (using teaser demonstrations, surveys, interviews, primary research studies, and customer case studies). Corroborate the benefits of the organization's offerings." ;
    bpot:hierarchyID "3.2.1.3" ;
    bpot:pcfID "11171" .

bpot:PCF_11172 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11168 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop new branding" ;
    bpot:apqcSourceText "Creating branding collaterals and campaigns that carve a significant and differentiated presence for the organization's offerings. Create new collaterals, which include names, designs, and symbols, for their products/services. Ensure collaterals reflect the unique value proposition of the respective offerings through a consistent theme. Create advertising and promotion campaigns." ;
    bpot:hierarchyID "3.2.1.4" ;
    bpot:pcfID "11172" .

bpot:PCF_11173 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10183 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop sales/key account plan" ;
    bpot:apqcSourceText "Creating a plan for managing the accounts of key customers in order to better maintain relationships with them. Chart a scheme for managing sales. Create a plan for administering accounts of the significant and most important customers of the organization. Coordinate the accounts of principal clients. " ;
    bpot:hierarchyID "3.5.2.2" ;
    bpot:pcfID "11173" .

bpot:PCF_11174 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10183 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage customer relationships" ;
    bpot:apqcSourceText "Managing the organization's relationship with its customers, by systematically coordinating interactions over multiple touch points, on a regular basis. Coordinate the organization's efforts to reach out to its customers. Create and manage effective touch points for interactions from the customers, which could include emails, social-media interactions, newsletters, and direct conversations." ;
    bpot:hierarchyID "3.5.2.4" ;
    bpot:pcfID "11174" .

bpot:PCF_11175 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10739 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Report on profitability" ;
    bpot:apqcSourceText "Making a report about revenues generated by the organization or business unit concerned. This process requires the organization to create a report which shows how business is generating profits. Profits are the part which is left after paying all expenses directly related to the generation of the revenue, such as producing a product, and other expenses related to conducting business activities." ;
    bpot:hierarchyID "9.1.2.6" ;
    bpot:pcfID "11175" .

bpot:PCF_11182 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21587 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Train and educate functional employees" ;
    bpot:apqcSourceText "Conducting programs such as on-the-job training sessions, group training workshops, and online training." ;
    bpot:hierarchyID "13.8.3.5" ;
    bpot:pcfID "11182" .

bpot:PCF_11186 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11180 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate environmental impact of products, services, and operations" ;
    bpot:apqcSourceText "Evaluating the impact of offerings and the auxiliary operations required to process them on the immediate ecosystem and the environment at large. Study the lifecycle of the products/services offered by the organization. Estimate any affect on the environment through metrics such as a calculation of carbon footprint." ;
    bpot:hierarchyID "13.8.1.1" ;
    bpot:pcfID "11186" .

bpot:PCF_11187 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11180 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct health and safety and environmental audits" ;
    bpot:apqcSourceText "Conducting an inspection to verify that the organization adequately complies with the environmental, health, and safety standards. Audit procedures and records regarding responsibility for the environment, health, and safety." ;
    bpot:hierarchyID "13.8.1.2" ;
    bpot:pcfID "11187" .

bpot:PCF_11188 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11181 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify regulatory and stakeholder requirements" ;
    bpot:apqcSourceText "Determining any protocols or standards to comply with, set by regulatory agencies or the organization's stakeholders. Closely examine all standards and matters of compliance relating to the environment, health, and safety." ;
    bpot:hierarchyID "13.8.2.1" ;
    bpot:pcfID "11188" .

bpot:PCF_11189 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11181 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Assess future risks and opportunities" ;
    bpot:apqcSourceText "Evaluating any risks and opportunities that might affect the environmental, health, and safety of products/services. Leverage techniques such as cost-benefit analysis, trend extrapolation, systems analysis, social surveys, historical surveys, historical analogy, Delphi, conferences, workshops, briefings, hearings, advisory committees, moot courts, artistic judgment, on-site field investigation, scaling techniques, and scenario creation." ;
    bpot:hierarchyID "13.8.2.2" ;
    bpot:pcfID "11189" .

bpot:PCF_11190 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11181 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create EHS policy" ;
    bpot:apqcSourceText "Creating a plan for managing the environmental, health, and safety impact of products/services. Establish minimum requirements for the organization regarding the environment at large and the health and safety of employees. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
    bpot:hierarchyID "13.8.2.3" ;
    bpot:pcfID "11190" .

bpot:PCF_11191 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11181 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Record and manage EHS events" ;
    bpot:apqcSourceText "Recording and managing all events and activities associated with complying with environmental, health and safety standards. Create event calendars. Assign funds. Educate employees. Conduct events." ;
    bpot:hierarchyID "13.8.2.4" ;
    bpot:pcfID "11191" .

bpot:PCF_11193 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21587 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage EHS costs and benefits" ;
    bpot:apqcSourceText "Administering the costs and benefits of EHS management program. Evaluate program costs to ensure that the benefits of the program always outweigh its costs. " ;
    bpot:hierarchyID "13.8.3.1" ;
    bpot:pcfID "11193" .

bpot:PCF_11194 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21587 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Measure and report EHS performance" ;
    bpot:apqcSourceText "Using performance techniques and indicators. Utilize number of audits or inspections performed, safety committee meetings, the number and types of findings and observations, timely preventive maintenance tasks performed, etc." ;
    bpot:hierarchyID "13.8.3.2" ;
    bpot:pcfID "11194" .

bpot:PCF_11195 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21587 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide EHS support" ;
    bpot:apqcSourceText "Supporting employees in light of the organization's environmental, health, and safety policies and standards. Provide medical insurance, maternity leave, environmental education, training over safety, etc." ;
    bpot:hierarchyID "13.8.3.6" ;
    bpot:pcfID "11195" .

bpot:PCF_11196 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21587 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement emergency response program" ;
    bpot:apqcSourceText "Implementing a program for organizing, coordinating, and directing available resources to respond to the event. Conduct a risk assessment to identify potential emergency scenarios in order to create a program that ensures that resources are on hand--or quickly available--in case of emergencies." ;
    bpot:hierarchyID "13.8.3.3" ;
    bpot:pcfID "11196" .

bpot:PCF_11197 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_21587 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement pollution prevention program" ;
    bpot:apqcSourceText "Implementing a program that reduces or eliminates the creation of pollutants through increased efficiency in the use of raw materials, energy, water, or other resources. Implement a program to inspect facilities that store, manufacture, or use hazardous, toxic, or polluting materials." ;
    bpot:hierarchyID "13.8.3.4" ;
    bpot:pcfID "11197" .

bpot:PCF_11201 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create remediation plans" ;
    bpot:apqcSourceText "Creating plans for remediation efforts. Make a plan to address a case of environmental adulteration. Identify and treat the adulteration so that the area will become operational again." ;
    bpot:hierarchyID "11.3.1" ;
    bpot:pcfID "11201" .

bpot:PCF_11202 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Contact and confer with experts" ;
    bpot:apqcSourceText "Discussing and soliciting advice from experts for in order to incorporate their suggestion (regarding Create remediation plans [11201])." ;
    bpot:hierarchyID "11.3.2" ;
    bpot:pcfID "11202" .

bpot:PCF_11203 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify/dedicate resources" ;
    bpot:apqcSourceText "Identifying and dedicating the resources for managing remediation efforts. Discern the resources needed for remediation efforts. Dispense with resources in a sound and well-reasoned manner." ;
    bpot:hierarchyID "11.3.3" ;
    bpot:pcfID "11203" .

bpot:PCF_11204 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Investigate legal aspects" ;
    bpot:apqcSourceText "Examining regulatory and legislative frameworks. Obligate the organization to remediate any damages through compensations, fines, and any other remedial efforts necessitated to correct the situations. Analyze local environmental laws, binding international covenants, etc. in order to examine legal accuracy about the rules and procedures." ;
    bpot:hierarchyID "11.3.4" ;
    bpot:pcfID "11204" .

bpot:PCF_11205 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Investigate damage cause" ;
    bpot:apqcSourceText "Studying the causes of damage, which could be environmental, physical, social, etc. at country level in order to institute better policies and regulations." ;
    bpot:hierarchyID "11.3.5" ;
    bpot:pcfID "11205" .

bpot:PCF_11206 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11185 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Amend or create policy" ;
    bpot:apqcSourceText "Crafting a new framework of policies and procedures for deploying remediation efforts, or change existing policies and procedures. Adapt the policy structure to the context of the apposite national and international regulatory frameworks." ;
    bpot:hierarchyID "11.3.6" ;
    bpot:pcfID "11206" .

bpot:PCF_11213 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate and refine hedging positions" ;
    bpot:apqcSourceText "Examining options in the market for hedging investments. Select an option." ;
    bpot:hierarchyID "9.7.5.5.4" ;
    bpot:pcfID "11213" .

bpot:PCF_11214 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11208 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Produce hedge accounting transactions and reports" ;
    bpot:apqcSourceText "Preparing and documenting accounts and records of all hedging investment transactions to reduce risks due to change in markets." ;
    bpot:hierarchyID "9.7.5.6" ;
    bpot:pcfID "11214" .

bpot:PCF_11215 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_20137 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor credit" ;
    bpot:apqcSourceText "Revising credit reports periodically for accurateness and changes that could be suggestive of duplicitous activity." ;
    bpot:hierarchyID "9.7.5.5.5" ;
    bpot:pcfID "11215" .

bpot:PCF_11221 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop the business resilience strategy" ;
    bpot:apqcSourceText "Creating a strategy for rapidly adapting to disturbances. Maintain continuous business processes and protecting employees, assets, and overall brand equity." ;
    bpot:hierarchyID "11.4.1" ;
    bpot:pcfID "11221" .

bpot:PCF_11222 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform continuous business operations planning" ;
    bpot:apqcSourceText "Developing plans to ensure continuous business operations. " ;
    bpot:hierarchyID "11.4.2" ;
    bpot:pcfID "11222" .

bpot:PCF_11223 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Test continuous business operations" ;
    bpot:apqcSourceText "Assessing ongoing activities within the organization that are not intended to stop except for in an emergency. " ;
    bpot:hierarchyID "11.4.3" ;
    bpot:pcfID "11223" .

bpot:PCF_11224 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Process" ;
    skos:broader bpot:PCF_11216 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain continuous business operations" ;
    bpot:apqcSourceText "Evaluating business operations. Determine which activities generate revenues, perform best, and provide good returns." ;
    bpot:hierarchyID "11.4.4" ;
    bpot:pcfID "11224" .

bpot:PCF_11236 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10402 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Solicit customer feedback on complaint handling and resolution" ;
    bpot:apqcSourceText "Requesting customer feedback on the process of handling and resolving customer complaints. Obtain information about the effectiveness and performance of the customer complaint handling process from the customers through various means (e.g., online and by phone)." ;
    bpot:hierarchyID "6.5.2.1" ;
    bpot:pcfID "11236" .

bpot:PCF_11237 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10402 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer complaint data and identify improvement opportunities" ;
    bpot:apqcSourceText "Examining the information obtained through handling and resolving complaints for development/improvement opportunities. Categorize the customer complaints data on the basis of speed, accuracy, courtesy, price, product choice, availability, hours, location, etc. Determine complaint patterns in order to diagnose areas needing enhancement." ;
    bpot:hierarchyID "6.5.2.2" ;
    bpot:pcfID "11237" .

bpot:PCF_11238 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10403 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Gather and solicit post-sale customer feedback on products and services" ;
    bpot:apqcSourceText "Obtaining customer feedback/review on the quality and utility derived from the products/services after the sale is complete. Use techniques such as surveys, feedback boxes, and user activity and usability tests." ;
    bpot:hierarchyID "6.5.3.1" ;
    bpot:pcfID "11238" .

bpot:PCF_11239 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10403 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Solicit post-sale customer feedback on ad effectiveness" ;
    bpot:apqcSourceText "Assessing the influence of advertisements on purchasing behavior. Use techniques such as surveys and product recognition tests, questionnaires or feedback flyers, and toll-free numbers in order to encourage customer interaction after the sale." ;
    bpot:hierarchyID "6.5.3.2" ;
    bpot:pcfID "11239" .

bpot:PCF_11240 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10403 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze product and service satisfaction data and identify improvement opportunities" ;
    bpot:apqcSourceText "Assessing the information collected on customer satisfaction levels with products/services in order to determine areas for improvement. Examine the data and information extracted from the customer feedback and reviews to measure the satisfaction levels of the customers. Identify opportunities that could enhance the customer satisfaction levels and the overall customer service strategy." ;
    bpot:hierarchyID "6.5.3.4" ;
    bpot:pcfID "11240" .

bpot:PCF_11241 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10403 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Provide feedback and insights to appropriate teams (product design/development, marketing, manufacturing)" ;
    bpot:apqcSourceText "Providing feedback from customers on products/services to the product management team. Analyze information collected through Gather and solicit post-sale customer feedback on products/services [11238]. Share with the product management team for consideration while improving existing offerings or developing new products/services. " ;
    bpot:hierarchyID "6.5.3.5" ;
    bpot:pcfID "11241" .

bpot:PCF_11243 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10469 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Evaluate the effectiveness of the employee onboarding program" ;
    bpot:apqcSourceText "Assessing the performance and effectiveness of employee on-boarding program. Examine the performance of on-boarding program through feedback and reviews from the new employees. Create web and written forms. Obtain information through face-to-face discussions." ;
    bpot:hierarchyID "7.3.1.2" ;
    bpot:pcfID "11243" .

bpot:PCF_11250 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10762 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define business process objectives and risks" ;
    bpot:apqcSourceText "Outlining the objectives and risks associated with a process. Delineate process goals. Determine the risks attached to it. Determine what the process is meant to accomplish, potential issues, a timeline of potential risks, the scope and potential impact of risks, etc." ;
    bpot:hierarchyID "9.8.1.4" ;
    bpot:pcfID "11250" .

bpot:PCF_11251 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10762 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define entity/unit risk tolerances" ;
    bpot:apqcSourceText "Outlining the risk tolerance levels of individual units, as well as the organization as a whole. Determine the specific maximum risk to take in quantitative terms for each relevant risk subcategory, including strategic, operational, financial, and compliance risks." ;
    bpot:hierarchyID "9.8.1.5" ;
    bpot:pcfID "11251" .

bpot:PCF_11276 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20139 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform construction performance management" ;
    bpot:apqcSourceText "Managing the construction process to ensure that activates are on task, on budget, and are being performed with safety and quality in mind." ;
    bpot:hierarchyID "10.2.2.2" ;
    bpot:pcfID "11276" .

bpot:PCF_11417 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_10100 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Monitor initial production runs" ;
    bpot:apqcSourceText "Regularly monitoring production runs of the production and/or delivery operations. " ;
    bpot:hierarchyID "2.3.3.4.1" ;
    bpot:pcfID "11417" .

bpot:PCF_11418 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_19997 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Request engineering/process change" ;
    bpot:apqcSourceText "Requesting changes in the production and/or delivery operations for processing the new or revised products/services. Rectify any problems identified in the manufacturing or delivery processes (through Monitor production runs [11417]). Seek changes in components, repair machinery, optimize production lines, and tweak factory assemblies through a formal notice to the concerned division, known as an engineering change order." ;
    bpot:hierarchyID "2.3.3.3" ;
    bpot:pcfID "11418" .

bpot:PCF_11424 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11423 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review market performance" ;
    bpot:apqcSourceText "Conducting customer and market analysis to review progress and identify opportunities for increasing market position. Track and review product/service response through sales reports, website statistics, direct response from customers, and survey reports." ;
    bpot:hierarchyID "2.1.2.5.2" ;
    bpot:pcfID "11424" .

bpot:PCF_11425 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11423 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review effectiveness of supply chain and distribution network" ;
    bpot:apqcSourceText "Determining the performance of supply chain to all departments and logistics from input to shop floor. Seeking performance reviews at each intersection and communication channels. Review effectiveness of supply chain and distribution to check if it is meeting the demands of the various groups and organizations that are concerned with its activities (groups might include customers, partners, suppliers, and vendors)." ;
    bpot:hierarchyID "2.1.2.5.3" ;
    bpot:pcfID "11425" .

bpot:PCF_11426 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11423 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review quality and performance of the product/service" ;
    bpot:apqcSourceText "Identifying the quality and performance of the product/service delivered to customers. Analyze data from the customer feedback, audits, measures of customer satisfaction (such as product quality complaints and recalls), and organizational policies on delivery." ;
    bpot:hierarchyID "2.1.2.5.5" ;
    bpot:pcfID "11426" .

bpot:PCF_11427 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11423 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct financial review" ;
    bpot:apqcSourceText "Evaluating organization's financial reports and financial reporting processes. Review and document the ROI catered by the product/service delivery to the customer in the market." ;
    bpot:hierarchyID "2.1.2.5.6" ;
    bpot:pcfID "11427" .

bpot:PCF_11428 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Task" ;
    skos:broader bpot:PCF_11423 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct new product development process assessment" ;
    bpot:apqcSourceText "Analyzing the steps involved in the development of new product, its effect on existing product, resources, and functions related to the development of the new product until its sale in the competitive market place." ;
    bpot:hierarchyID "2.1.2.5.7" ;
    bpot:pcfID "11428" .

bpot:PCF_11465 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop customer trade strategy and customer objectives/targets" ;
    bpot:apqcSourceText "Implementing category management strategies for customers through the use of consumer insights and understanding of customer specifics. Develop consumer and channel insights. Establish long term strategies, objectives and targets across the brand." ;
    bpot:hierarchyID "3.4.2.4" ;
    bpot:pcfID "11465" .

bpot:PCF_11466 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct planning activities for major trade customers" ;
    bpot:apqcSourceText "Arranging meetings with trade partners to coordinate logistics, manage critical resources, resolve bottlenecks, and schedule urgent or time-sensitive matters." ;
    bpot:hierarchyID "3.4.2.6" ;
    bpot:pcfID "11466" .

bpot:PCF_11468 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate planning information to customer teams" ;
    bpot:apqcSourceText "Sending invitations and distributing information about upcoming events to customer teams and other involved entities." ;
    bpot:hierarchyID "3.4.2.12" ;
    bpot:pcfID "11468" .

bpot:PCF_11495 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement promotional pricing programs" ;
    bpot:apqcSourceText "Managing schemes that offer lower pricing for a limited time as a promotional and sales incentive when launching a new product or a service. " ;
    bpot:hierarchyID "3.3.3.7" ;
    bpot:pcfID "11495" .

bpot:PCF_11496 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Implement other retail pricing programs" ;
    bpot:apqcSourceText "Determining the optimum consumer pricing for each product or service at the point of sale, based on production and distribution costs and estimated sales volume." ;
    bpot:hierarchyID "3.3.3.8" ;
    bpot:pcfID "11496" .

bpot:PCF_11497 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_20593 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Communicate and implement price changes" ;
    bpot:apqcSourceText "Assigning new prices or pricing adjustments to products or services to replace the original base prices. Update the prices in product catalogs and databases, and disseminate the information through all involved distribution and marketing channels." ;
    bpot:hierarchyID "3.3.3.9" ;
    bpot:pcfID "11497" .

bpot:PCF_11521 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Define trade programs and funding options" ;
    bpot:apqcSourceText "Establishing business-to-business marketing campaigns and financial incentives for wholesalers, dealers, distributors and other intermediaries that the company uses to distribute its products or services." ;
    bpot:hierarchyID "3.4.2.5" ;
    bpot:pcfID "11521" .

bpot:PCF_11522 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop promotional and category management calendars (trade marketing calendars)" ;
    bpot:apqcSourceText "Combining scheduled promotional, category management and trade marketing events into unified timetables. Update the calendars. Register new events." ;
    bpot:hierarchyID "3.4.2.10" ;
    bpot:pcfID "11522" .

bpot:PCF_11523 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10130 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Create strategic and tactical sales plans by customer" ;
    bpot:apqcSourceText "Establishing long term customer sales plans to assess current sales and to determine future sales objectives, strategies for achieving the goals, and available resources." ;
    bpot:hierarchyID "3.4.2.11" ;
    bpot:pcfID "11523" .

bpot:PCF_11622 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design talent development program" ;
    bpot:apqcSourceText "Identifying skills, knowledge, and attributes that need enhancement in order to perform a job. Develop the appropriate training programs. These programs can be computer-based, classroom, or on-the-job training, etc." ;
    bpot:hierarchyID "7.1.2.8" ;
    bpot:pcfID "11622" .

bpot:PCF_11623 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_17045 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Design talent acquisition program" ;
    bpot:apqcSourceText "Developing a program to entice prospective resources to engage with the organization for a position of employment." ;
    bpot:hierarchyID "7.1.2.9" ;
    bpot:pcfID "11623" .

bpot:PCF_11687 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10401 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Solicit customer feedback on customer service experience" ;
    bpot:apqcSourceText "Creating an avenue for which the customer can provide feedback on their experience with how their inquiry, problem, or request was handled. " ;
    bpot:hierarchyID "6.5.1.1" ;
    bpot:pcfID "11687" .

bpot:PCF_11688 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10401 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Analyze customer service data and identify improvement opportunities" ;
    bpot:apqcSourceText "Reviewing customer service feedback to identify areas in which improvements can be made. Engage with management to discuss issues." ;
    bpot:hierarchyID "6.5.1.2" ;
    bpot:pcfID "11688" .

bpot:PCF_11689 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10402 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify common customer complaints" ;
    bpot:apqcSourceText "Determining complaint patterns in order to identify common issues. Document common problems for correction." ;
    bpot:hierarchyID "6.5.2.3" ;
    bpot:pcfID "11689" .

bpot:PCF_11741 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage materials master lists" ;
    bpot:apqcSourceText "Controlling the details of materials' storage and utilization, supplier details linked to materials, in a defined sequential manner and ensuring regular updates with permissible accessibility." ;
    bpot:hierarchyID "2.1.4.1" ;
    bpot:pcfID "11741" .

bpot:PCF_11742 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage bills of material" ;
    bpot:apqcSourceText "Managing the purchase details/bills through regular and error free updates to applications. Create manual entries wherever necessary and ensure timely review of the laid processes and systems." ;
    bpot:hierarchyID "2.1.4.2" ;
    bpot:pcfID "11742" .

bpot:PCF_11743 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage routings" ;
    bpot:apqcSourceText "Controlling and executing the flow of operations from raw form to finished product in a defined format using industry applications/routing sheets for the specific product/service layout." ;
    bpot:hierarchyID "2.1.4.3" ;
    bpot:pcfID "11743" .

bpot:PCF_11744 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage specifications" ;
    bpot:apqcSourceText "Direct, supervise, and control the product/service details necessary to execute the process. Adhere to details and descriptions for product/service through identified or guided parameters towards final outcome in the market with due critical analysis formed on organizational objectives." ;
    bpot:hierarchyID "2.1.4.4" ;
    bpot:pcfID "11744" .

bpot:PCF_11745 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage drawings" ;
    bpot:apqcSourceText "Administering the specifications of the product/service and ensure accessibility for product alteration/new product development." ;
    bpot:hierarchyID "2.1.4.5" ;
    bpot:pcfID "11745" .

bpot:PCF_11746 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage product/material classification" ;
    bpot:apqcSourceText "Controlling the details of the product and the input materials. Manage classification throughout the production process, and for future accessibility to new product development or product enrichment." ;
    bpot:hierarchyID "2.1.4.6" ;
    bpot:pcfID "11746" .

bpot:PCF_11747 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop and maintain quality/inspection documents" ;
    bpot:apqcSourceText "Determining procedures required to assess the sustainability of defined criterion for product/service delivery to customers. Retain results for further review as a procedural practice." ;
    bpot:hierarchyID "2.1.4.7" ;
    bpot:pcfID "11747" .

bpot:PCF_11748 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Maintain process specification data" ;
    bpot:apqcSourceText "Directing and handling data with respect to the procedures followed across different functions and mission critical applications." ;
    bpot:hierarchyID "2.1.4.8" ;
    bpot:pcfID "11748" .

bpot:PCF_11749 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Manage traceability data" ;
    bpot:apqcSourceText "Identifying and handling data accessed by the permitted touch points. Ensure that no data is accessible to any unnecessary recipient. Data flow should be controlled through secured access and free from unauthorized access." ;
    bpot:hierarchyID "2.1.4.9" ;
    bpot:pcfID "11749" .

bpot:PCF_11750 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11740 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review and approve data access requests" ;
    bpot:apqcSourceText "Determining the requests pertaining to data accessibility. Review the requester details based on internal data security policies and permit data access only if internal policies and data access parameters are met." ;
    bpot:hierarchyID "2.1.4.10" ;
    bpot:pcfID "11750" .

bpot:PCF_11773 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_10182 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Match opportunities to business strategy" ;
    bpot:apqcSourceText "Aligning sales leads with business objectives." ;
    bpot:hierarchyID "3.5.1.4" ;
    bpot:pcfID "11773" .

bpot:PCF_11780 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Refine customer requirements" ;
    bpot:apqcSourceText "Clarifying the details about procurement requests, such as the scope, timeline, data sources, type and characteristics and evaluation criteria for the goods or services to be delivered, and any additional terms, conditions or special requirements." ;
    bpot:hierarchyID "3.5.3.2" ;
    bpot:pcfID "11780" .

bpot:PCF_11781 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Receive Request For Proposal (RFP)/Request For Quote (RFQ)" ;
    bpot:apqcSourceText "Accepting procurement proposals. " ;
    bpot:hierarchyID "3.5.3.1" ;
    bpot:pcfID "11781" .

bpot:PCF_11782 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Review RFP/RFQ request" ;
    bpot:apqcSourceText "Evaluating individual price and delivery solicitations for their strengths and weaknesses. Analyze how closely the submitted bids respond to the requirements outlined in the RFPs." ;
    bpot:hierarchyID "3.5.3.3" ;
    bpot:pcfID "11782" .

bpot:PCF_11783 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Perform competitive analysis" ;
    bpot:apqcSourceText "Comparing the proposals submitted by different bidders in terms of cost, efficiency and value. " ;
    bpot:hierarchyID "3.5.3.4" ;
    bpot:pcfID "11783" .

bpot:PCF_11784 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Validate with strategy/business plans" ;
    bpot:apqcSourceText "Assessing the business strategy, forecasted performance, financing and cash flow of the proposals." ;
    bpot:hierarchyID "3.5.3.5" ;
    bpot:pcfID "11784" .

bpot:PCF_11785 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Understand customer business and requirements" ;
    bpot:apqcSourceText "Deepening knowledge about the customer's field of operation and business needs." ;
    bpot:hierarchyID "3.5.3.6" ;
    bpot:pcfID "11785" .

bpot:PCF_11787 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Identify staffing requirements" ;
    bpot:apqcSourceText "Determining the needs for internal resources and vacancies." ;
    bpot:hierarchyID "3.5.3.8" ;
    bpot:pcfID "11787" .

bpot:PCF_11788 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Develop pricing and scheduling estimates" ;
    bpot:apqcSourceText "Establishing predicted delivery costs, fees and timelines." ;
    bpot:hierarchyID "3.5.3.9" ;
    bpot:pcfID "11788" .

bpot:PCF_11789 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Conduct profitability analysis" ;
    bpot:apqcSourceText "Reviewing profitability data. Analyze systematically all relevant metrics and parameters. Report findings and make recommendations for changes to operational strategies." ;
    bpot:hierarchyID "3.5.3.10" ;
    bpot:pcfID "11789" .

bpot:PCF_11790 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
    rdfs:comment "APQC level: Activity" ;
    skos:broader bpot:PCF_11779 ;
    skos:inScheme bpot:PCF ;
    skos:prefLabel "Submit/present bid/proposal/quote to customer" ;
    bpot:apqcSourceText "Delivering the proposal to the potential client." ;
    bpot:hierarchyID "3.5.3.13" ;
    bpot:pcfID "11790" .

bpot:PCF_11793 a owl:NamedIndividual,
        skos:Concept,
        cco:ont00000853 ;
