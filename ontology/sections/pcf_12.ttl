bpot:PCF_11052 bpot:designatesProcessType bpot:P11052 .

bpot:PCF_11053 bpot:designatesProcessType bpot:P11053 .

bpot:PCF_11054 bpot:designatesProcessType bpot:P11054 .

bpot:PCF_11056 bpot:designatesProcessType bpot:P11056 .

bpot:PCF_11057 bpot:designatesProcessType bpot:P11057 .

bpot:PCF_11058 bpot:designatesProcessType bpot:P11058 .

bpot:PCF_11059 bpot:designatesProcessType bpot:P11059 .

bpot:PCF_11060 bpot:designatesProcessType bpot:P11060 .

bpot:PCF_11061 bpot:designatesProcessType bpot:P11061 .

bpot:PCF_11062 bpot:designatesProcessType bpot:P11062 .

bpot:PCF_11063 bpot:designatesProcessType bpot:P11063 .

bpot:PCF_11064 bpot:designatesProcessType bpot:P11064 .

bpot:PCF_11065 bpot:designatesProcessType bpot:P11065 .

bpot:PCF_11066 bpot:designatesProcessType bpot:P11066 .

bpot:PCF_11067 bpot:designatesProcessType bpot:P11067 .

bpot:PCF_11068 bpot:designatesProcessType bpot:P11068 .

bpot:PCF_11069 bpot:designatesProcessType bpot:P11069 .

bpot:PCF_11070 bpot:designatesProcessType bpot:P11070 .

bpot:PCF_12869 bpot:designatesProcessType bpot:P12869 .

bpot:PCF_12870 bpot:designatesProcessType bpot:P12870 .

bpot:PCF_12871 bpot:designatesProcessType bpot:P12871 .

bpot:PCF_12872 bpot:designatesProcessType bpot:P12872 .

bpot:PCF_12873 bpot:designatesProcessType bpot:P12873 .

bpot:PCF_12874 bpot:designatesProcessType bpot:P12874 .

bpot:PCF_12875 bpot:designatesProcessType bpot:P12875 .

bpot:PCF_12876 bpot:designatesProcessType bpot:P12876 .

bpot:PCF_12877 bpot:designatesProcessType bpot:P12877 .

bpot:PCF_12878 bpot:designatesProcessType bpot:P12878 .

bpot:PCF_12879 bpot:designatesProcessType bpot:P12879 .

bpot:PCF_12880 bpot:designatesProcessType bpot:P12880 .

bpot:PCF_12881 bpot:designatesProcessType bpot:P12881 .

bpot:RegulatoryRequirement rdfs:comment "Directive (not Descriptive): it prescribes obligations. Input for 12.4.4 (Ensure compliance), 12.4.3 (preventive law programs)." ;
    skos:definition "A Directive Information Content Entity that prescribes a statute, regulatory direction, or legal principle with which an organization must comply." .

bpot:WorkProductDeliverable a owl:Class ;
    rdfs:label "Work Product Deliverable" ;
    rdfs:comment "Minted for 12.4.5.4: no other shared-vocab ICE captures counsel deliverables together with committed-effort records used to confirm fees. Genus Descriptive ICE because it records what was delivered/performed. Used ONLY as the has-input (received deliverable) of 12.4.5.4; the validated effort/fee record that act produces is the distinct bpo:WorkProductValidationRecord." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records a deliverable produced by engaged outside counsel and the effort committed to a matter." ;
    skos:example "A memorandum and timesheet delivered by outside counsel on a litigation matter." .

bpot:designatesProcessType rdfs:comment "Bridges a catalog node (bpo:PCF_<pcfID>) to its reality-layer class (bpo:P<pcfID> or a supporting capability)." .

<https://fandaws.com/ontology/bpot/sections/pcf_12> a owl:Ontology ;
    dcterms:creator "Aaron Damiano" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://fandaws.com/ontology/bpo/slice/12.0>,
        "APQC Process Classification Framework (Cross-Industry)" ;
    dcterms:title "Business Process Ontology -- PCF 12.0 Manage External Relationships" ;
    rdfs:comment "Reality layer for APQC PCF category 12.0: the process universals that pass the bounded-occurrent test, the organization capabilities, roles and information content entities they use." ;
    owl:versionIRI <https://fandaws.com/ontology/bpot/0.0.0/sections/pcf_12.ttl> ;
    owl:versionInfo "0.0.0" .

bpot:AdvisorRole a owl:Class ;
    rdfs:label "Advisor Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of providing advice or counsel to support a focal organization's relationships or decisions." .

bpot:AnalystRelationsManagementCapability a owl:Class ;
    rdfs:label "Analyst Relations Management Capability" ;
    rdfs:comment "Minted for 12.1.2 (P11036), re-judged under R5 as a standing function -> Organization Capability ('creating and maintaining LONG-TERM relations' signals the no-natural-end / standing-capacity branch), reconciled with 12.2.1-3 (Gate-F cross-row consistency). Realized in the bounded analyst-relationship-cultivation episodes via obo:BFO_0000054." ;
    rdfs:subClassOf bpot:StakeholderRelationshipManagementCapability ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to create and maintain long-term relationships with financial analysts so as to elicit market intelligence." .

bpot:AuditFindingsReport a owl:Class ;
    rdfs:label "Audit Findings Report" ;
    rdfs:comment "Output of 12.3.2 (Report audit findings)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the findings of an audit, including the situation, root cause, and recommendations for resolving a problem." .

bpot:Auditor rdfs:comment "Minted for 12.2.2.2 (Respond to audit inquiries) and 12.3.2 (Report audit findings). Agent because an auditor may be an individual or an audit firm." ;
    skos:definition "An Agent that bears an auditor role in virtue of conducting an examination of an organization's records, controls, or compliance." .

bpot:BoardOfDirectorsRole a owl:Class ;
    rdfs:label "Board of Directors Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of representing stockholders and governing a focal company's major decisions." .

bpot:Budget rdfs:comment "Input for 12.4.5.3 (Receive strategy/budget). Directive: a financial plan that constrains spending." ;
    skos:definition "A Directive Information Content Entity that prescribes, using figures, an organization's expected future financial results for an activity." .

bpot:Community a owl:Class ;
    rdfs:label "Community" ;
    rdfs:comment "Minted for 12.5.1 (Manage community relations). Modeled as Organization (a Group of Agents)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:CommunityRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a community role in virtue of constituting the population of the environment in which an organization operates and from which it draws resources." .

bpot:CommunityRole a owl:Class ;
    rdfs:label "Community Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of constituting the population of the environment in which a focal organization operates." .

bpot:CompliancePersonnel a owl:Class ;
    rdfs:label "Compliance Personnel" ;
    rdfs:comment "Minted for 12.4.4 (Ensure compliance; coordinate with compliance and risk-management personnel)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ComplianceOfficerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a compliance-officer role in virtue of being tasked with validating and maintaining an organization's compliance position." .

bpot:ContactRecord a owl:Class ;
    rdfs:label "Contact Record" ;
    rdfs:comment "Input/output for 12.2.2.3 (Maintain documentation of contacts)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a partner, prospect, or customer within an organization's network of contacts." .

bpot:Contract a owl:Class ;
    rdfs:label "Contract" ;
    rdfs:comment "Output of 12.4.9 (Negotiate and document agreements/contracts) and the engagement instrument in 12.4.5.2." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the mutually agreed terms binding two or more parties to a course of action." .

bpot:DetermineLegalWorkRequirements a owl:Class ;
    rdfs:label "Determine legal work requirements" ;
    rdfs:comment "Supporting act (no pcfID, so it carries NO targeted has-output someValuesFrom restriction -- the IRI scheme reserves pcfIDs for catalog-backed process classes and the process shape requires a pcfID on any class bearing an I/O restriction). Minted to de-conflate the compound row 12.4.5.1 (Phase-1): producing a Directive WorkRequirementsSpecification is a planning/decision facet whose genus is bpo:ActOfFormulation (Act of Planning), in agreement with its Directive output (GOLDEN PRINCIPLE). Its output bpo:WorkRequirementsSpecification is recorded here and in the definition rather than as a restriction. It is a cco:has process part of the appraisal P11056, which keeps only its Descriptive output." ;
    rdfs:subClassOf bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that determines and specifies the tasks and action requirements for engaging outside counsel on a legal problem and has as output a work requirements specification (bpo:WorkRequirementsSpecification, a Directive ICE)." ;
    skos:example "In-house counsel breaks down a dispute into the tasks to hand to outside counsel and documents the action requirements." .

bpot:DisputeResolution a owl:Class ;
    rdfs:label "Dispute Resolution" ;
    rdfs:comment "Output of 12.4.7 (Resolve disputes and litigations). Directive: a settlement that binds the parties." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the agreed or adjudicated terms settling a dispute or civil lawsuit." .

bpot:EthicsPolicy a owl:Class ;
    rdfs:label "Ethics Policy" ;
    rdfs:comment "Output of 12.4.1 (Create ethics policies)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an organization's code of ethics communicating its philosophy to employees, partners, and the public." .

bpot:ExecutiveAppointment a owl:Class ;
    rdfs:label "Executive Appointment" ;
    rdfs:comment "Output of 12.2.1.2 (Appoint responsible executives). Directive: it assigns responsibility." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the assignment of an executive-level agent to manage and drive a designated set of relationships." .

bpot:ExecutivePersonnel a owl:Class ;
    rdfs:label "Executive Personnel" ;
    rdfs:comment "Minted for 12.2.1.2 (Appoint responsible executives) and other rows assigning executive-level resources." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ExecutiveRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears an executive role in virtue of holding senior managerial authority responsible for driving and overseeing organizational relationships and activities." .

bpot:ExecutiveRole a owl:Class ;
    rdfs:label "Executive Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of holding senior managerial authority within an Organization." .

bpot:FinancialAnalyst a owl:Class ;
    rdfs:label "Financial Analyst" ;
    rdfs:comment "Minted for 12.1.2 (Plan, build, and manage analyst relations)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:FinancialAnalystRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a financial-analyst role in virtue of evaluating the securities, performance, and prospects of an organization." .

bpot:FinancialAnalystRole a owl:Class ;
    rdfs:label "Financial Analyst Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of evaluating the securities, performance, and prospects of a focal organization." .

bpot:FinancialData rdfs:comment "Input for 12.3.1 (Report financial results)." ;
    skos:definition "A Descriptive Information Content Entity that describes an organization's financial position and performance." .

bpot:FinancialResultsReport a owl:Class ;
    rdfs:label "Financial Results Report" ;
    rdfs:comment "Output of 12.3.1 (Report financial results)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an organization's financial results, including its income statement, balance sheet, and statement of cash flows." .

bpot:GovernmentBodyRole a owl:Class ;
    rdfs:label "Government Body Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of exercising public authority over a focal organization at some level of government." .

bpot:IntellectualPropertyManagementCapability rdfs:comment "Supports 12.4.6 (Protect intellectual property) when modeled as a standing function." .

bpot:IntellectualPropertyPolicy a owl:Class ;
    rdfs:label "Intellectual Property Policy" ;
    rdfs:comment "Output of 12.4.6.2 (Maintain intellectual property rights and restrictions)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the rules, procedures, and restrictions governing the use and protection of an organization's intellectual property." .

bpot:IntellectualPropertyRight a owl:Class ;
    rdfs:label "Intellectual Property Right" ;
    rdfs:comment "Subject/output of 12.4.6.1 (Manage copyrights, patents, and trademarks). Directive: an enforceable entitlement prescribing permitted and prohibited uses. Scope note (two-layer model): this class captures only the DIRECTIVE prescriptive content of the right (the permitted/prohibited-use rules) -- hence Directive ICE (cco:ont00000965), admissible as the definitional has-output of the output-neutral bpo:ActOfAcquisition at P11062. The legal ENTITLEMENT/STATUS itself (the holder's standing over the protected subject matter) is a distinct reality-layer legal relation/role and is deliberately NOT modeled here; if later represented it should be a separate entity, not this ICE." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the exclusive legal entitlement an organization holds over a patent, copyright, or trademark." .

bpot:InvestorRelationsCapability a owl:Class ;
    rdfs:label "Investor Relations Capability" ;
    rdfs:comment "Supports 12.1 (Build investor relationships) when modeled as a standing function under R5." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to integrate finance, communication, and securities-law compliance so as to manage two-way communication with the financial community." .

bpot:Invoice rdfs:comment "Input for 12.4.5.5 (Process payment for legal services)." ;
    skos:definition "A Descriptive Information Content Entity that describes fees claimed by a service provider for services rendered." .

bpot:Journalist a owl:Class ;
    rdfs:label "Journalist" ;
    rdfs:comment "Minted for 12.5.2 (Manage media relations)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:JournalistRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a journalist role in virtue of gathering, reporting, and publishing news on behalf of a media outlet." .

bpot:JournalistRole a owl:Class ;
    rdfs:label "Journalist Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of gathering, reporting, and publishing news on behalf of a media outlet." .

bpot:LegalActivityRecord a owl:Class ;
    rdfs:label "Legal Activity Record" ;
    rdfs:comment "Output of 12.4.5.6 (Track legal activity/performance)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the legal activities and performance of an organization over time." .

bpot:LegalAdvice a owl:Class ;
    rdfs:label "Legal Advice" ;
    rdfs:comment "Output of 12.4.8 (Provide legal advice/counseling). Descriptive: it informs rather than itself binding the recipient to act." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes counsel concerning the substance or procedure of a law as it applies to a particular situation." .

bpot:LegalProblemStatement a owl:Class ;
    rdfs:label "Legal Problem Statement" ;
    rdfs:comment "Input/output for 12.4.5.1 (Assess problem and determine work requirements)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a legal or ethical problem an organization faces and the tasks for which assistance may be needed." .

bpot:LegalWorkProduct a owl:Class ;
    rdfs:label "Legal Work Product" ;
    rdfs:comment "Input for 12.4.5.4 (Receive work product and manage/monitor case). See also bpo:WorkProductDeliverable for the deliverable-plus-effort record specifically monitored under 12.4.5.4." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a deliverable produced by outside counsel in the course of an engagement." .

bpot:Lender a owl:Class ;
    rdfs:label "Lender" ;
    rdfs:comment "Minted for 12.1.1 (Plan, build, and manage lender relations). Modeled as Organization (banks/lenders); use cco:Agent for an individual lender." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:LenderRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a lender role in virtue of extending loans or credit to a borrowing organization." .

bpot:LenderRelationsManagementCapability a owl:Class ;
    rdfs:label "Lender Relations Management Capability" ;
    rdfs:comment "Minted for 12.1.1 (P11035), re-judged under R5 as a standing function -> Organization Capability, reconciled with the parallel 'manage relations' rows 12.2.1-3 which are likewise capabilities (Gate-F cross-row consistency). Realized in the bounded lender-relationship-cultivation episodes via obo:BFO_0000054." ;
    rdfs:subClassOf bpot:StakeholderRelationshipManagementCapability ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to build, maintain, and advance ongoing relationships with bankers and lenders so as to foster a receptive environment for favorable lending terms." .

bpot:LenderRole a owl:Class ;
    rdfs:label "Lender Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of extending loans or credit to a focal organization." .

bpot:MediaOutlet a owl:Class ;
    rdfs:label "Media Outlet" ;
    rdfs:comment "Minted for 12.5.2 / 12.5.5 (media relations, issuing press releases)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:MediaOutletRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a media-outlet role in virtue of producing and distributing news or content through channels such as the web, newspapers, or social media." .

bpot:MediaOutletRole a owl:Class ;
    rdfs:label "Media Outlet Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of producing and distributing news or content to the public." .

bpot:MeetingRecord a owl:Class ;
    rdfs:label "Meeting Record" ;
    rdfs:comment "Minted for 12.2.2.4 (P12878). Distinct from the input-side bpo:RelationshipData ('describes the current state of a relationship', consumed as has-input in P12869/P12871/P12880): the recorded artifact a meeting produces is a meeting record (the output of recording), not the relationship-state data consumed elsewhere -- correcting the Gate-F category confusion of reusing an input class as a has-output filler." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records what transpired in a meeting, including attendees, topics discussed, and outcomes, for further analysis and use." ;
    skos:example "Minutes of a quarterly liaison meeting with a quasi-governmental body." .

bpot:OutsideCounselRole a owl:Class ;
    rdfs:label "Outside Counsel Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being an external expert engaged to provide legal or ethical assistance to a focal organization." .

bpot:P11010 a owl:Class ;
    rdfs:label "Build investor relationships" ;
    rdfs:comment "Modeled as an Organization Capability (R6), not a process: APQC describes a standing 'strategic management responsibility' / 'investor relations function' with no natural end. Specializes the shared bpo:InvestorRelationsCapability. Two of its three APQC children (12.1.1, 12.1.2) are themselves standing functions re-judged as capabilities under R5 (bpo:LenderRelationsManagementCapability, bpo:AnalystRelationsManagementCapability); a capability is realized only in PROCESSES (BFO_0000054), so this umbrella capability is realized in the bounded episode acts bpo:CultivateLenderRelations / bpo:CultivateAnalystRelations and in the shareholder-communication process bpo:P11037, not in the sub-capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:CultivateLenderRelations ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:CultivateAnalystRelations ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11037 ],
        bpot:InvestorRelationsCapability,
        cco:ont00000568 ;
    skos:definition "An Investor Relations Capability that inheres in an Organization in virtue of its capacity to realize the integrated two-way engagement of the organization with lenders, analysts, and shareholders." ;
    skos:example "An organization's standing investor-relations office that cultivates lender, analyst, and shareholder relationships across fiscal periods." ;
    bpot:apqcSourceText "Creating a strategic management responsibility for integrating finance, communication, marketing, and securities law compliance. Allow the most effective two-way communication among the organization, the financial community, and other constituencies. Enlist the investor relations function to provide market intelligence to corporate management." ;
    bpot:hierarchyID "12.1" ;
    bpot:pcfID "11010" .

bpot:P11012 a owl:Class ;
    rdfs:label "Manage relations with board of directors" ;
    rdfs:comment "R5 = capability, not a process: 'manage/maintain relations' denotes a standing function with no natural beginning or end, so it is modeled as an Organization Capability (cco:ont00000568) realized in its underlying acts (R6), not as a bounded occurrent. Subsumed under the shared StakeholderRelationshipManagementCapability. The realized-in restrictions link it to the bounded acts that exercise it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11042 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11043 ],
        bpot:StakeholderRelationshipManagementCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to sustain communicative and reporting relations with its board of directors and the stockholders the board represents." ;
    skos:example "A corporate secretariat's ongoing capacity to deliver financial and audit reporting to the board and shareholders." ;
    bpot:apqcSourceText "Maintaining relations with representatives of the stockholders. Establish corporate management-related policies and to make decisions on major company issues. Implement practices designed to engender communication, trust, and cooperation." ;
    bpot:hierarchyID "12.3" ;
    bpot:pcfID "11012" .

bpot:P11013 a owl:Class ;
    rdfs:label "Manage legal and ethical issues" ;
    rdfs:comment "R5/R6: 'Manage legal and ethical issues' is a standing function with no natural end, so it is an Organization Capability (cco:ont00000568), not a process. Realized in the modeled child acts. Narrower, pcf-bearing refinement of the shared bpo:LegalAndComplianceCapability. NOTE: 12.4.4 (P11047 Ensure compliance) is itself re-judged as a sub-capability under R5 (Gate-F), and a capability is realized only in processes, so this umbrella capability is realized in P11047's bounded acts bpo:P11053 / bpo:P11054 rather than in the P11047 sub-capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11044 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11046 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11053 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11054 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11050 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11051 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11052 ],
        bpot:LegalAndComplianceCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that an Organization realizes in the acts by which it manages its legal and ethical practices so as to abide by the law." ;
    bpot:apqcSourceText "Managing legal practices to abide by the law, as well as ethical practices." ;
    bpot:hierarchyID "12.4" ;
    bpot:pcfID "11013" .

bpot:P11035 a owl:Class ;
    rdfs:label "Plan, build, and manage lender relations" ;
    rdfs:comment "RE-ANCHORED (Gate-F, R5 cross-row consistency): previously modeled as a bounded bpo:ActOfRelationshipManagement. 'Plan, build, and manage an ongoing relation ... foster a receptive environment' has no natural beginning or end; it is a standing capacity realized in recurring episodes -- exactly the R5 'standing function -> capability' branch already applied to the parallel 'Manage ... relations' rows 12.2.1 (P11038), 12.2.2 (P11039), 12.2.3 (P11040). Leaf-vs-nonleaf is NOT the R5 ground (R5 is per-node bounded-occurrent, independent of whether children were enumerated), so the prior split mistyped parallel rows. Now an Organization Capability (cco:ont00000568) specializing bpo:LenderRelationsManagementCapability, realized in the bounded bpo:CultivateLenderRelations episodes (obo:BFO_0000054). The Lender participates in those episode acts, not in the capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:CultivateLenderRelations ],
        bpot:LenderRelationsManagementCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to build, maintain, and advance ongoing relationships with bankers and lenders so as to foster a receptive environment for favorable lending terms." ;
    skos:example "An organization's standing treasury function that nurtures banking relationships across fiscal periods to secure low-rate credit lines." ;
    bpot:apqcSourceText "Building and managing relations with bankers or lenders through strong products/services strategies that bankers would want to invest in. Foster a receptive environment for low rates of interest, easy access to loans, etc." ;
    bpot:hierarchyID "12.1.1" ;
    bpot:pcfID "11035" .

bpot:P11036 a owl:Class ;
    rdfs:label "Plan, build, and manage analyst relations" ;
    rdfs:comment "RE-ANCHORED (Gate-F, R5 cross-row consistency): previously modeled as a bounded bpo:ActOfRelationshipManagement. 'Creating and maintaining LONG-TERM relations with analysts' is the paradigm of a standing function with no natural end -- 'long-term' actively signals the no-natural-end (standing-capacity) branch of R5 -- the same pattern the module treats as a capability at 12.2.1-3. Reconciled to the same R5 verdict chosen for P11035. Now an Organization Capability (cco:ont00000568) specializing bpo:AnalystRelationsManagementCapability, realized in the bounded bpo:CultivateAnalystRelations episodes (analyst meetings, briefings) via obo:BFO_0000054. The FinancialAnalyst participates in those episode acts, not in the capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:CultivateAnalystRelations ],
        bpot:AnalystRelationsManagementCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to create and maintain long-term relationships with financial analysts so as to elicit market intelligence." ;
    skos:example "An organization's standing investor-relations function that maintains relationships with sell-side analysts covering the firm across reporting cycles." ;
    bpot:apqcSourceText "Creating and maintaining long-term relations with analysts. Involve analysts in strategy and product decisions in order to elicit valuable information." ;
    bpot:hierarchyID "12.1.2" ;
    bpot:pcfID "11036" .

bpot:P11038 a owl:Class ;
    rdfs:label "Manage government relations" ;
    rdfs:comment "R5: standing function ('Manage ...'), no natural end => Organization Capability (cco:ont00000568), not a process. Realized in its APQC child acts (R6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12869 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12870 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12871 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12872 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12873 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12874 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish, assess, monitor, and advance relationships with government bodies in order to influence public and government policy." ;
    skos:example "A corporate government-affairs office's ongoing program of engaging legislators and agencies." ;
    bpot:apqcSourceText "Persuading public and government policy at the local, regional, national, and global level (subject to government regulations)." ;
    bpot:hierarchyID "12.2.1" ;
    bpot:pcfID "11038" .

bpot:P11039 a owl:Class ;
    rdfs:label "Manage relations with quasi-government bodies" ;
    rdfs:comment "R5: standing function => Organization Capability (cco:ont00000568). Realized in its APQC child acts (R6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12875 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12876 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12877 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12878 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish, maintain, and advance relationships with quasi-government bodies." ;
    skos:example "An organization's ongoing engagement with a quasi-governmental regulator." ;
    bpot:apqcSourceText "Managing relations with quasi-governmental organizations, corporations, businesses, or any other agency that is treated by national laws and principles to be under the supervision of the government but also distinct and self-directed from the government." ;
    bpot:hierarchyID "12.2.2" ;
    bpot:pcfID "11039" .

bpot:P11040 a owl:Class ;
    rdfs:label "Manage relations with trade or industry groups" ;
    rdfs:comment "R5: standing function => Organization Capability (cco:ont00000568). Realized in its APQC child acts (R6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12879 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12880 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12881 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to evaluate, establish, monitor, extend, and modify relationships with trade or industry groups." ;
    skos:example "An organization's ongoing membership and lobbying activity within an industry association." ;
    bpot:apqcSourceText "Managing relations with organizations established and financed by businesses that operate in a specific industry. Participate in public relations actions such as lobbying and publishing, advertising, education, and political donations." ;
    bpot:hierarchyID "12.2.3" ;
    bpot:pcfID "11040" .

bpot:P11041 a owl:Class ;
    rdfs:label "Manage lobby activities" ;
    rdfs:comment "R5: standing function ('Manage ...'), no natural end and no decomposed APQC children => Organization Capability (cco:ont00000568), not a process." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to conduct and coordinate lobbying activities aimed at affecting government policies." ;
    skos:example "A firm's ongoing lobbying program directed at pending legislation." ;
    bpot:apqcSourceText "Managing lobbying activities to affect government policies." ;
    bpot:hierarchyID "12.2.4" ;
    bpot:pcfID "11041" .

bpot:P11045 a owl:Class ;
    rdfs:label "Manage corporate governance policies" ;
    rdfs:comment "R5/R6: administering the standing governance 'system' has no natural end, so it is an Organization Capability (cco:ont00000568). The corporate governance policy it maintains is the shared bpo:CorporateGovernancePolicy (a Directive ICE) produced by the underlying formulation acts." ;
    rdfs:subClassOf bpot:LegalAndComplianceCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that an Organization realizes in administering the system of rules, practices, and processes through which it is directed and controlled while balancing stakeholder interests." ;
    bpot:apqcSourceText "Administering the system of rules, practices, and processes through which a company is directed and controlled. Balance stakeholder interests including shareholders, management, customers, suppliers, financiers, government, and the community. Outline a strategy for achieving organizational goals, from action plans and internal controls to performance measurement and corporate disclosure." ;
    bpot:hierarchyID "12.4.2" ;
    bpot:pcfID "11045" .

bpot:P11047 a owl:Class ;
    rdfs:label "Ensure compliance" ;
    rdfs:comment "RE-ANCHORED (Gate-F, R5 / genus-vs-parts tension): previously a single bounded Act of Appraisal. (a) 'Ensuring the organization's compliance position' / 'coordinate with personnel' reads as a standing oversight function with no natural end -- like its modeled-as-Capability siblings P11045/P11048/P11049. (b) It was given cco:has process part to a FORMULATION act (P11053 design a compliance program) and an EXECUTION act (P11054), neither of which is an occurrent part of judging compliance -- an appraisal does not have 'design a program' as a part. Re-modeled as an Organization Capability (cco:ont00000568) specializing bpo:LegalAndComplianceCapability, realized (obo:BFO_0000054) in its bounded child acts P11053 and P11054, which are thereby re-parented as realizations of the capability rather than process parts of an appraisal. The bounded validation judgement against bpo:RegulatoryRequirement, performed with bpo:CompliancePersonnel, is itself one of the acts that realize this capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11053 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11054 ],
        bpot:LegalAndComplianceCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to ensure and oversee its compliance position by designing compliance programs and validating adherence to statutes, regulatory directions, and legal principles." ;
    skos:example "A standing compliance office that designs anti-trust programs and continually validates the firm's standing against SEC and consumer-protection statutes." ;
    bpot:apqcSourceText "Ensuring the organization's compliance position. Validate compliance with different statutes, regulatory directions, and legal principles (using Establish compliance framework and policies [17468]). Coordinate with compliance and risk management personnel." ;
    bpot:hierarchyID "12.4.4" ;
    bpot:pcfID "11047" .

bpot:P11048 a owl:Class ;
    rdfs:label "Manage outside counsel" ;
    rdfs:comment "R5/R6: a standing 'administer and oversee' function with no natural end, so an Organization Capability (cco:ont00000568). Realized in its six bounded child acts (12.4.5.1-12.4.5.6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11056 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11057 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11058 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11059 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11060 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11061 ],
        bpot:LegalAndComplianceCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that an Organization realizes in the acts by which it engages, oversees, pays, and monitors externally sourced professionals for legal and ethical assistance." ;
    bpot:apqcSourceText "Managing professionals, sought externally for assistance over legal and ethical concerns. Administer and oversee assistance from subject matter experts and professionals for sourcing expert opinion and counseling over legal and ethical matters." ;
    bpot:hierarchyID "12.4.5" ;
    bpot:pcfID "11048" .

bpot:P11049 a owl:Class ;
    rdfs:label "Protect intellectual property" ;
    rdfs:comment "R5/R6: an ongoing 'safeguarding/administering policies' function with no natural end, so an Organization Capability (cco:ont00000568). Realized in its four bounded child acts (12.4.6.1-12.4.6.4). Narrower, pcf-bearing refinement of the shared bpo:IntellectualPropertyManagementCapability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11062 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11063 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11064 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11065 ],
        bpot:IntellectualPropertyManagementCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that an Organization realizes in the acts by which it safeguards, registers, licenses, and polices its intellectual property." ;
    bpot:apqcSourceText "Safeguarding the intellectual property of the organization. This process requires the organization to protect a wide variety of intellectual property created by it. It involves creating and managing non-disclosure agreements (NDAs), following up on current developments in the areas where the organization holds patents, tracking the use of the organization's copyrighted material, creating and upholding licensing terms, and administering policies for safeguarding intellectual property." ;
    bpot:hierarchyID "12.4.6" ;
    bpot:pcfID "11049" .

bpot:PaymentInstrument rdfs:comment "Material participant of the Act of Payment in 12.4.5.5 (Process payment for legal services): the transferred MONEY moved by the act (obo:BFO_0000057), never the act, while the act's informational has-output is the separate Descriptive ICE bpo:PaymentRecord (process outputs in this domain are ICEs, S3). Renamed from bpo:Payment and re-anchored to cco:ont00000537 to mirror slice 9 and match CCO's treatment of money as a Financial Instrument (cf. Portion of Cash cco:ont00000475 subClassOf 537)." .

bpot:PaymentRecord a owl:Class ;
    rdfs:label "Payment Record" ;
    rdfs:comment "Definitional informational output of 12.4.5.5 (Process payment for legal services). The remittance/payment record is the ICE output of the act; the transferred money itself is the material entity bpo:PaymentInstrument, modeled as a definitional participant rather than as an informational output (per S3 OutputIsICE: process outputs in this domain are ICEs)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records a payment made to a service provider in settlement of an obligation, including payer, payee, amount, and the invoice settled." .

bpot:PreventiveLawProgram a owl:Class ;
    rdfs:label "Preventive Law Program" ;
    rdfs:comment "Output of 12.4.3 (Develop and perform preventive law programs)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes programs and activities encouraging adherence to preventive laws such as environmental, corporate-compliance, and property-transaction law." .

bpot:PublicRelationsCapability a owl:Class ;
    rdfs:label "Public Relations Capability" ;
    rdfs:comment "Supports 12.5 (Manage public relations program) when modeled as a standing function. The catalog node bpo:PCF_11014 designates this capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11066 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11067 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11068 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11069 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11070 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to manage its public image and relationships with the community, media, and the public." .

bpot:QuasiGovernmentBody a owl:Class ;
    rdfs:label "Quasi-Government Body" ;
    rdfs:comment "Minted for 12.2.2. Includes regulatory and auditing agencies." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:QuasiGovernmentBodyRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a quasi-government-body role in virtue of operating under government supervision while remaining distinct and self-directed from the government." .

bpot:QuasiGovernmentBodyRole a owl:Class ;
    rdfs:label "Quasi-Government Body Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of operating under government supervision while remaining distinct and self-directed from the government." .

bpot:RegulatoryAuthority rdfs:comment "Minted for 12.4.4 (Ensure compliance); e.g. the Securities and Exchange Commission." ;
    skos:definition "An Organization that bears a regulatory-authority role in virtue of issuing and enforcing statutes, regulatory directions, or legal principles binding on an organization." .

bpot:RelationshipAssessment a owl:Class ;
    rdfs:label "Relationship Assessment" ;
    rdfs:comment "Output of 12.2.1.1 (Assess relationships). The subject (the external-party relationship) is named in the definition; no formal 'is about' (cco:ont00001808) restriction is asserted because no reality-layer relationship class exists in the slice, and the only candidate filler bpo:RelationshipData is the Descriptive ICE consumed as this act's has-input -- pointing is-about at the input data would mis-state the subject as the data rather than the relationship." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of the state of an organization's relationship with an external party and areas needing growth." .

bpot:Shareholder a owl:Class ;
    rdfs:label "Shareholder" ;
    rdfs:comment "Minted for 12.1.3 (Communicate with shareholders). Agent (not Organization) because a shareholder may be an individual or an organization." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ShareholderRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a shareholder role in virtue of holding an equity interest in an organization." .

bpot:ShareholderCommunication a owl:Class ;
    rdfs:label "Shareholder Communication" ;
    rdfs:comment "Subject of 12.1.3 (Communicate with shareholders)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes information conveyed to shareholders, such as a shareholders' letter, earnings-call statement, or meeting briefing." .

bpot:ShareholderRole a owl:Class ;
    rdfs:label "Shareholder Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of holding an equity interest in a focal organization." .

bpot:TradeOrIndustryGroupRole a owl:Class ;
    rdfs:label "Trade or Industry Group Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of being established and financed by businesses operating in a specific industry." .

bpot:WorkProductValidationRecord a owl:Class ;
    rdfs:label "Work Product Validation Record" ;
    rdfs:comment "Minted for 12.4.5.4 (P11059) as the definitional OUTPUT of the monitoring act, distinct from its has-input bpo:WorkProductDeliverable (the raw received deliverable). Separating input and output ICEs corrects the Gate-F finding that the same class was asserted as both has-input and has-output (a vacuous distinction / thin-class over-commitment)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the validated work product and verified committed effort of engaged outside counsel, used to confirm the fees due." ;
    skos:example "A signed-off matter ledger confirming the briefs filed and billable hours verified before fee approval." .

bpot:AdvisoryInput a owl:Class ;
    rdfs:label "Advisory Input" ;
    rdfs:comment "Input for 12.2.1.4 / 12.2.1.5 (receive input from advisors)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes advice or counsel furnished by an internal or external advisor." .

bpot:AuditInquiry a owl:Class ;
    rdfs:label "Audit Inquiry" ;
    rdfs:comment "Input for 12.2.2.2 (Respond to audit inquiries) and 12.3.2 (Report audit findings)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a question or request raised by an auditor in the course of an audit." .

bpot:BoardOfDirectors a owl:Class ;
    rdfs:label "Board of Directors" ;
    rdfs:comment "Minted for 12.3. Modeled as Organization (a Group of Agents with rules), not as a single Agent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:BoardOfDirectorsRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a board-of-directors role in virtue of representing stockholders and governing a company's major decisions." .

bpot:ComplianceProgram a owl:Class ;
    rdfs:label "Compliance Program" ;
    rdfs:comment "Output of 12.4.4.1 (Plan and initiate compliance program); implemented by 12.4.4.2." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the internal system and activities for identifying and reducing the risk of breaching applicable laws and regulations." .

bpot:CultivateAnalystRelations a owl:Class ;
    rdfs:label "Cultivate Analyst Relations" ;
    rdfs:comment "Supporting bounded act (no pcfID) minted for 12.1.2: the discrete episodes (analyst meetings, briefings) in which bpo:AnalystRelationsManagementCapability is realized (obo:BFO_0000054). The FinancialAnalyst is a definitional participant of these episode acts (not of a capability), per the Gate-F fix." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:FinancialAnalyst ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management that cultivates and sustains an organization's relationship with one or more financial analysts during a bounded engagement episode in order to elicit market intelligence, and has a financial analyst as participant." ;
    skos:example "An investor-relations officer's briefing with a sell-side analyst ahead of an earnings release." .

bpot:CultivateLenderRelations a owl:Class ;
    rdfs:label "Cultivate Lender Relations" ;
    rdfs:comment "Supporting bounded act (no pcfID) minted for 12.1.1: the discrete episodes (a cultivation act, a banking meeting, a communication) in which bpo:LenderRelationsManagementCapability is realized (obo:BFO_0000054). The Lender is a definitional participant; typical relationship/contact data I/O is non-definitional (Phase-3) and omitted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Lender ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management that cultivates and sustains an organization's relationship with one or more lenders during a bounded engagement episode, fostering a receptive environment for favorable lending terms, and has a lender as participant." ;
    skos:example "A treasury team's quarterly banker briefing to secure a low-rate credit line." .

bpot:GovernmentBody a owl:Class ;
    rdfs:label "Government Body" ;
    rdfs:comment "Minted for 12.2.1 (Manage government relations). Covers government heads, representatives, and entities at all levels." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:GovernmentBodyRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a government-body role in virtue of exercising public authority at a local, regional, national, or supranational level." .

bpot:LicensingTerms a owl:Class ;
    rdfs:label "Licensing Terms" ;
    rdfs:comment "Output of 12.4.6.3 (Administer licensing terms) and referenced by 12.4.6.4 (Administer options)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the terms and conditions governing the granting of a license to an organization's intellectual property." .

bpot:OutsideCounsel a owl:Class ;
    rdfs:label "Outside Counsel" ;
    rdfs:comment "Minted for 12.4.5 (Manage outside counsel). Agent because counsel may be an individual attorney or a law firm." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:OutsideCounselRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears an outside-counsel role in virtue of being an external subject-matter expert engaged to provide legal or ethical assistance to an organization." .

bpot:P11037 a owl:Class ;
    rdfs:label "Communicate with shareholders" ;
    rdfs:comment "Anchored under cco:ont00000402 (Act of Communication) because the act consists in transferring an Information Content Entity from the organization to its shareholders. The output ShareholderCommunication is a Descriptive ICE and is definitional (every instance produces communicated content), so it is promoted to a restriction; the Shareholder is a definitional participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ShareholderCommunication ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Shareholder ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that transfers information from an organization to its shareholders and produces a shareholder communication." ;
    skos:example "A company holds its quarterly earnings call and issues a shareholders' letter." ;
    bpot:apqcSourceText "Practicing regular, transparent communication with shareholders through annual shareholders' meetings, quarterly earnings calls, shareholders letters, one-on-one emails or calls, etc." ;
    bpot:hierarchyID "12.1.3" ;
    bpot:pcfID "11037" .

bpot:P11042 a owl:Class ;
    rdfs:label "Report financial results" ;
    rdfs:comment "GOLDEN PRINCIPLE: a representative-communication (reporting) act asserting facts, so the definitional output bpo:FinancialResultsReport is a Descriptive ICE (cco:ont00000853). Financial data is a definitional input (one cannot report results without it). The Board of Directors / management are modeled as recipients of the communicated report; release to the public is a typical further recipient noted in the source text." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialResultsReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001922 ;
            owl:someValuesFrom bpot:BoardOfDirectors ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that has as input financial data and has as output a financial results report asserting an organization's financial statements to management and the public." ;
    skos:example "A controller's office issues the quarterly income statement, balance sheet, and statement of cash flows to the board and to the public." ;
    bpot:apqcSourceText "Reporting financial results to management, and releasing results to the public. Report financial statements, including the income statement, balance sheet, and statement of cash flows." ;
    bpot:hierarchyID "12.3.1" ;
    bpot:pcfID "11042" .

bpot:P11043 a owl:Class ;
    rdfs:label "Report audit findings" ;
    rdfs:comment "GOLDEN PRINCIPLE: a representative-communication (reporting) act, so the definitional output bpo:AuditFindingsReport is a Descriptive ICE (cco:ont00000853). The internal-audit inquiry that surfaces the findings is the definitional input. The conducting of the internal audit itself is a separate appraisal act outside this reporting node; here only the reporting (transfer of asserted findings to the board/management) is modeled. The Board of Directors / management are the recipients." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:AuditInquiry ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AuditFindingsReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001922 ;
            owl:someValuesFrom bpot:BoardOfDirectors ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that has as input an audit inquiry and has as output an audit findings report asserting confirmed problems, their situation and root cause, and recommendations to management." ;
    skos:example "Internal audit issues a findings report to the audit committee of the board, stating the confirmed control gap, its root cause, and remediation recommendations." ;
    bpot:apqcSourceText "Reporting audit findings to management. Practice an internal audit with criteria for confirming a problem, a description of the situation, and the root cause of the problem. Make recommendations that resolve the issue." ;
    bpot:hierarchyID "12.3.2" ;
    bpot:pcfID "11043" .

bpot:P11044 a owl:Class ;
    rdfs:label "Create ethics policies" ;
    rdfs:comment "GOLDEN PRINCIPLE: output EthicsPolicy is a Directive ICE, so the act genus is Formulation (Act of Planning), not Information Processing." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EthicsPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a code of ethics and has as output an ethics policy expressing the organization's philosophy." ;
    skos:example "A compliance team drafts and publishes the company code of ethics." ;
    bpot:apqcSourceText "Creating a code of ethics that communicate the organization's philosophy to employees, vendors, customers, clients, and the public." ;
    bpot:hierarchyID "12.4.1" ;
    bpot:pcfID "11044" .

bpot:P11046 a owl:Class ;
    rdfs:label "Develop and perform preventive law programs" ;
    rdfs:comment "Output PreventiveLawProgram is a Directive ICE (a program prescribing activities), so the genus is Formulation. 'Perform' is realization of the program; the definitional move is its creation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PreventiveLawProgram ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that creates programs and activities encouraging adherence to preventive laws and has as output a preventive law program." ;
    skos:example "Legal counsel rolls out an environmental-law and corporate-compliance preventive program." ;
    bpot:apqcSourceText "Creating and applying programs and activities. Encourage the adherence preventive laws, such as environmental law, sex discrimination, computer law, estate planning, corporate compliance, business planning, and property transactions." ;
    bpot:hierarchyID "12.4.3" ;
    bpot:pcfID "11046" .

bpot:P11050 a owl:Class ;
    rdfs:label "Resolve disputes and litigations" ;
    rdfs:comment "RE-ANCHORED (Gate-F sibling consistency): previously bpo:ActOfFormulation (=> cco:ont00000511 'Act of Planning' = making a plan to achieve an objective), but a dispute resolution is reached through negotiation or adjudication BETWEEN adverse parties -- a Social Act, not a solo planning act (the slice's own skos:example says the team 'negotiates a settlement'). The parallel binding-settlement sibling P11052 'Negotiate and document agreements' correctly uses bpo:ActOfNegotiation (a Social Act), so P11050 is anchored consistently. Output DisputeResolution (Directive ICE) is retained: bpo:ActOfNegotiation is defined as producing a Directive ICE such as a contract/settlement that prescribes the agreed terms, so the GOLDEN PRINCIPLE holds (negotiation's bargained output is directive). OutsideCounsel is a typical, non-definitional participant (external resolution only)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DisputeResolution ],
        bpot:ActOfNegotiation ;
    skos:definition "An Act of Negotiation that settles a dispute or civil lawsuit between adverse parties, internally or externally, and has as output a dispute resolution." ;
    skos:example "The legal team negotiates a settlement that ends a supplier lawsuit." ;
    bpot:apqcSourceText "Resolving disputes or civil lawsuits internally or externally." ;
    bpot:hierarchyID "12.4.7" ;
    bpot:pcfID "11050" .

bpot:P11051 a owl:Class ;
    rdfs:label "Provide legal advice/counseling" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): providing advice transfers an ICE from adviser to recipient. Output LegalAdvice is a Descriptive ICE (it represents/explains the legal position rather than prescribing a binding action), satisfying the GOLDEN PRINCIPLE for an information/advisory act. Advisor is a definitional participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LegalAdvice ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Advisor ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that conveys legal advice concerning the substance or procedure of a law in relation to a particular situation and has that legal advice as output." ;
    skos:example "Counsel advises management on the disclosure obligations triggered by an acquisition." ;
    bpot:apqcSourceText "Providing legal advice concerning the substance or procedure of a law in relation to a particular situation." ;
    bpot:hierarchyID "12.4.8" ;
    bpot:pcfID "11051" .

bpot:P11052 a owl:Class ;
    rdfs:label "Negotiate and document agreements/contracts" ;
    rdfs:comment "Reuses PROPOSE-EXT genus bpo:ActOfNegotiation (a Social Act). Output Contract is a Directive ICE, consistent with a negotiated, binding agreement." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:Contract ],
        bpot:ActOfNegotiation ;
    skos:definition "An Act of Negotiation that exchanges offers among parties to reach a final draft of a contract acceptable to all of them and has that contract as output." ;
    skos:example "Counsel negotiates and finalizes a master services agreement with a vendor." ;
    bpot:apqcSourceText "Negotiating terms to reach a final draft of a contract that is acceptable to all parties." ;
    bpot:hierarchyID "12.4.9" ;
    bpot:pcfID "11052" .

bpot:P11056 a owl:Class ;
    rdfs:label "Assess problem and determine work requirements" ;
    rdfs:comment "SPLIT (Gate-F GOLDEN-PRINCIPLE / Phase-1): previously a single Act of Appraisal carrying TWO definitional existential outputs of opposite kind -- bpo:LegalProblemStatement (Descriptive, the judgement, agreeing with Appraisal) and bpo:WorkRequirementsSpecification (Directive, the determined action requirements). A Directive specification is a planning/decision facet, so the appraisal genus disagreed with one of its own mandatory outputs. The compound row is de-conflated: P11056 retains only its Descriptive output (LegalProblemStatement), and the Directive-producing facet is the supporting bpo:ActOfFormulation class bpo:DetermineLegalWorkRequirements, linked via cco:has process part (cco:ont00001777)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LegalProblemStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:DetermineLegalWorkRequirements ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that examines the legal issues for which external counsel is needed and has as output a legal problem statement, and which has as process part the determination of the legal work requirements." ;
    skos:example "In-house counsel scopes a dispute (the appraisal) and, as a part, specifies the tasks to hand to outside counsel." ;
    bpot:apqcSourceText "Examining the problems and deciding the action requirements for engaging outside counsel. This process element calls upon the organization to internally analyze the issues for which assistance from external counsel is needed. Additionally, the organization needs to break-down the issue, identifying the tasks and exercises where outside counsel can help." ;
    bpot:hierarchyID "12.4.5.1" ;
    bpot:pcfID "11056" .

bpot:P11057 a owl:Class ;
    rdfs:label "Engage/Retain outside counsel if necessary" ;
    rdfs:comment "Reuses shared genus bpo:ActOfAcquisition: the organization obtains counsel services it did not previously hold. WorkRequirementsSpecification from 12.4.5.1 is a definitional input; OutsideCounsel is a definitional participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:WorkRequirementsSpecification ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:OutsideCounsel ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that obtains the assistance of outside counsel for legal or ethical concerns, taking a work requirements specification as input." ;
    skos:example "The legal department retains an external IP firm to handle a patent suit." ;
    bpot:apqcSourceText "Recruiting the assistance of outside counsel for any legal and/or ethical concerns. Engage and/or retain any external counsel sought from subject matter experts and professionals." ;
    bpot:hierarchyID "12.4.5.2" ;
    bpot:pcfID "11057" .

bpot:P11058 a owl:Class ;
    rdfs:label "Receive strategy/budget" ;
    rdfs:comment "Anchored at cco:ont00000366 (Act of Information Processing): an input ICE (the Budget, a Directive ICE) is received. Budget is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Budget ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that receives a budget, a financial plan setting out expected future results in figures, for the engaged legal work." ;
    skos:example "The legal team receives the finance-approved budget for an outside-counsel engagement." ;
    bpot:apqcSourceText "Making a financial plan. This strategy sets out, using figures, an organization's expected future results. Enlist the finance function to support work generated by other business functions in order to build and secure their support for the budget." ;
    bpot:hierarchyID "12.4.5.3" ;
    bpot:pcfID "11058" .

bpot:P11059 a owl:Class ;
    rdfs:label "Receive work product and manage/monitor case and work performed" ;
    rdfs:comment "I/O CORRECTED (Gate-F, Phase-3): previously the identical class bpo:WorkProductDeliverable was asserted as BOTH has-input and has-output, making the input/output distinction vacuous and over-committing (thin-class risk). The received raw deliverable (input) and the validated tracking/effort record the act produces (output) are different ICEs. Now has-input the received deliverable bpo:LegalWorkProduct and has-output the distinct bpo:WorkProductValidationRecord (the validated effort/fee-confirmation record). Reuses PROPOSE-EXT genus bpo:ActOfMonitoring; OutsideCounsel is a definitional participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:LegalWorkProduct ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkProductValidationRecord ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:OutsideCounsel ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that receives the work product of engaged outside counsel, tracks and validates the committed effort, and has as output a work product validation record used to confirm fees." ;
    skos:example "In-house counsel logs and verifies a law firm's filed briefs and billed hours before approving fees." ;
    bpot:apqcSourceText "Receiving deliverables from outside counsel, and monitoring the efforts committed by them. Track the progress of, collect, and validate the required work product from the subject matter experts and professionals engaged as external counsel. Verify the amount of effort dedicated by these counsels to the issue at hand, in order to confirm their fees." ;
    bpot:hierarchyID "12.4.5.4" ;
    bpot:pcfID "11059" .

bpot:P11060 a owl:Class ;
    rdfs:label "Process payment for legal services" ;
    rdfs:comment "Reuses PROPOSE-EXT genus bpo:ActOfPayment. Definitional informational output is the Descriptive ICE bpo:PaymentRecord (the remittance/payment record); the transferred money bpo:PaymentInstrument is the material entity moved by the act and is modeled as a definitional participant (obo:BFO_0000057), not as a has-output filler, because process outputs in this domain are ICEs (S3 OutputIsICE). Invoice is the informational (Descriptive ICE) input; Advisor is a definitional participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Advisor ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Invoice ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PaymentRecord ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        bpot:ActOfPayment ;
    skos:definition "An Act of Payment that transfers consideration to a legal adviser for services rendered, taking an invoice as input, transferring a payment as a material participant, and having a payment record as its informational output." ;
    skos:example "Accounts payable settles an outside-counsel invoice for litigation services and logs the remittance." ;
    bpot:apqcSourceText "Making payments to legal advisers for their services. Payments include addressing issues or suits by customers, suppliers, competitors, bankers, government agencies, etc." ;
    bpot:hierarchyID "12.4.5.5" ;
    bpot:pcfID "11060" .

bpot:P11061 a owl:Class ;
    rdfs:label "Track legal activity/performance" ;
    rdfs:comment "Reuses PROPOSE-EXT genus bpo:ActOfMonitoring; its descriptive output LegalActivityRecord records ongoing legal activity, satisfying the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LegalActivityRecord ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that tracks the legal activities and performance of the organization and has as output a legal activity record." ;
    skos:example "The legal operations team maintains a register of active matters and outcomes." ;
    bpot:apqcSourceText "Keeping track of the legal activities and performance of the organization." ;
    bpot:hierarchyID "12.4.5.6" ;
    bpot:pcfID "11061" .

bpot:P11062 a owl:Class ;
    rdfs:label "Manage copyrights, patents, and trademarks" ;
    rdfs:comment "RE-ANCHORED (Gate-F false-friend): previously bpo:ActOfRelationshipManagement (=> cco:ont00000433 'Act of Association' = 'an Agent unites with some other Agent in a Planned Act, enterprise or business'). The source describes administering an IP ASSET portfolio -- applying for, securing, maintaining rights; submitting applications; collecting royalties; monitoring misuse -- with no uniting-with-an-external-Agent to ground an Act of Association; the dominant definitional move is obtaining/securing the IntellectualPropertyRight, i.e. acquisition, not social uniting. 'Manage' -> RelationshipManagement was a surface-word false friend (D2/§6). Re-anchored to the shared genus bpo:ActOfAcquisition (a Planned Act in which an Agent obtains an entity it did not previously hold), keeping the IntellectualPropertyRight (Directive ICE) as definitional output. Royalty collection and misuse monitoring remain typical, non-definitional sub-steps (this comment, not restrictions). Evaluated minting a dedicated bpo:ActOfPortfolioAdministration (=> cco:ont00000228) but the acquisition core is captured by the existing shared genus, so no new genus is minted (reuse-before-mint, D5)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:IntellectualPropertyRight ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that applies for, secures, and maintains the organization's patents, copyrights, and trademarks and has as output the resulting intellectual property right." ;
    skos:example "The IP office files and renews patents and pursues infringers of company trademarks." ;
    bpot:apqcSourceText "Managing the patents and copyrights already held or sought by the organization. Administer and oversee applying for, securing, and maintaining intellectual property rights in the form of patents and copyrights. Submit applications for such rights. Handle associated legal issues. Draft and communicate proper attributions. Collect royalties. Monitor any misuse of the intellectual property rights." ;
    bpot:hierarchyID "12.4.6.1" ;
    bpot:pcfID "11062" .

bpot:P11063 a owl:Class ;
    rdfs:label "Maintain intellectual property rights and restrictions" ;
    rdfs:comment "Output IntellectualPropertyPolicy is a Directive ICE, so the genus is Formulation (Act of Planning), not relationship management; the definitional move is composing the policy framework." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:IntellectualPropertyPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that creates a framework of rules, procedures, and restrictions governing the use of the organization's intellectual property and has as output an intellectual property policy." ;
    skos:example "Legal drafts the company policy governing third-party use of its patents." ;
    bpot:apqcSourceText "Managing the upkeep of intellectual property rights by creating and managing a framework of rules, policies, procedures, and restrictions. Outline a clear policy for any possible scenario of their use by any external agent." ;
    bpot:hierarchyID "12.4.6.2" ;
    bpot:pcfID "11063" .

bpot:P11064 a owl:Class ;
    rdfs:label "Administer licensing terms" ;
    rdfs:comment "Output LicensingTerms is a Directive ICE, so the genus is Formulation; the definitional move is composing the licensing framework rather than ongoing oversight." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LicensingTerms ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that creates the policies and terms governing the licensing of the organization's intellectual property and has as output licensing terms." ;
    skos:example "Legal demarcates the standard royalty and field-of-use terms for licensing company patents." ;
    bpot:apqcSourceText "Administering and overseeing the terms and policies associated with licensing the organization's intellectual property. Create and manage the policies and terms governing the possible granting of a license to any external agent. Demarcate a clear framework that governs the licensing of any patents or copyrights held by the organization." ;
    bpot:hierarchyID "12.4.6.3" ;
    bpot:pcfID "11064" .

bpot:P11065 a owl:Class ;
    rdfs:label "Administer options" ;
    rdfs:comment "RE-ANCHORED (Gate-F false-friend, same pattern as P11062): previously bpo:ActOfRelationshipManagement (=> cco:ont00000433 'Act of Association'). There is no uniting-with-an-external-Agent here -- exercising/overseeing contractual options is decision/management over a Directive ICE (the governing bpo:LicensingTerms), not a social uniting; 'administer/manage' -> Act of Association was a surface-word false friend. Re-anchored to cco:ont00000228 (Planned Act), keeping P11065 in the same corrected Planned-Act genus family as the reconciled P11062 (bpo:ActOfAcquisition => Planned Act) rather than both defaulting to Act of Association. Considered bpo:ActOfSelection (Information Processing) but rejected it: the source 'follow favorable terms' is overseeing/exercising an already-granted option, and the apqc-ext caveat notes that ratifying a single already-settled option is NOT Selection (no candidate set), so the generic Planned Act is the correct anchor. LicensingTerms is the definitional input governing the options." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:LicensingTerms ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that administers and exercises the options available under the organization's licensing agreements so as to follow favorable terms and conditions, taking the governing licensing terms as input." ;
    skos:example "The IP office exercises a renewal option on a favorable inbound licensing agreement." ;
    bpot:apqcSourceText "Managing options regarding licensing agreements. Follow favorable terms and conditions." ;
    bpot:hierarchyID "12.4.6.4" ;
    bpot:pcfID "11065" .

bpot:P11066 a owl:Class ;
    rdfs:label "Manage community relations" ;
    rdfs:comment "R5: bounded, repeatable relationship-management engagement (a realization of the public-relations capability), not the standing function itself. Typical output: a bpo:RelationshipStatusReport; left in comment (not a someValuesFrom restriction) because not every instance produces one (Phase-3 necessity)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Community ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management in which an Agent develops and administers connections with the community in which an organization operates in order to foster mutual understanding, trust, and support, and has the community as participant." ;
    skos:example "A community-affairs team runs a neighbourhood sponsorship program and meets with local leaders to build goodwill." ;
    bpot:apqcSourceText "Developing and administering community relations. Establish business connections with the people constituting the environment the organization operates in and draws resources from in order to foster mutual understanding, trust, and support. Create programs that promote the organization's image in a positive and community-oriented way." ;
    bpot:hierarchyID "12.5.1" ;
    bpot:pcfID "11066" .

bpot:P11067 a owl:Class ;
    rdfs:label "Manage media relations" ;
    rdfs:comment "R5: bounded, repeatable relationship-management engagement with the press. Participant bpo:Journalist is definitional (relations are developed with journalists); bpo:MediaOutlet is the typical organizational counterparty and is noted here rather than asserted as a restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Journalist ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management in which an Agent develops and manages connections with media outlets and journalists in order to solicit third-party endorsements for a product, issue, service, or organization, and has a journalist as participant." ;
    skos:example "A PR officer pitches a feature story to a journalist and cultivates an ongoing media contact list." ;
    bpot:apqcSourceText "Developing and managing relations with media. Develop connections with journalists to solicit critical, third-party endorsements for a product, issue, service, or organization." ;
    bpot:hierarchyID "12.5.2" ;
    bpot:pcfID "11067" .

bpot:P11068 a owl:Class ;
    rdfs:label "Promote political stability" ;
    rdfs:comment "RE-ANCHORED (Gate-F false-friend): previously bpo:ActOfRelationshipManagement (=> cco:ont00000433 'Act of Association' = 'an Agent unites with some other Agent in a Planned Act, enterprise or business'). The de-conflated lead verbs are 'Promote / Encourage political security and stability' and 'Support civic programs, citizen engagement, connection platforms' -- the dominant intent is advocacy / influencing the societal-political environment, not bilateral uniting into a shared enterprise. The prior comment ('unites the org with civic/government parties') re-read an advocacy verb as an association verb -- exactly the false friend the methodology warns against (verify the differentia, not the surface). Re-anchored to the new shared-extension genus bpo:ActOfAdvocacy (=> cco:ont00001327 Social Act). Evaluated cco:ont00000079 'Act of Social Movement' (verified: 'A Social Act composed of a series of performances, displays and campaigns directed at implementing, resisting or undoing a change in society') as the nearer Social-Act sibling: it fits campaign-driven activism but is narrower than the general supporting/promoting intent here (supporting civic programs and citizen-engagement platforms is not necessarily a movement to implement/resist/undo a societal change), so the dedicated bpo:ActOfAdvocacy genus was preferred over both ont00000079 and Act of Association. (NB: the review note's 'cco:ont00000478' is NOT Act of Social Movement -- ont00000478 is 'Cuboidal', a shape; the correct Social-Movement IRI is ont00000079, verified in the closure.) bpo:Community is also a typical participant (noted, not asserted)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:GovernmentBody ],
        bpot:ActOfAdvocacy ;
    skos:definition "An Act of Advocacy in which an Agent promotes and encourages political security and stability in the regions where an organization operates -- supporting civic programs, citizen engagement, and connection platforms -- and has a government body as participant." ;
    skos:example "A corporate-affairs unit funds a local civic-engagement platform and partners with a municipal authority to support regional stability." ;
    bpot:apqcSourceText "Promoting political security and stability in the regions where the organization conducts business. Encourage political stability in the regions where the organization operates. Support civic programs, citizen engagement, connection platforms, etc." ;
    bpot:hierarchyID "12.5.3" ;
    bpot:pcfID "11068" .

bpot:P11069 a owl:Class ;
    rdfs:label "Create press releases" ;
    rdfs:comment "R5: bounded, repeatable authoring act. Anchored directly under cco:ont00000366 (Act of Information Processing) per the GOLDEN PRINCIPLE: its definitional output bpo:PressRelease is a Descriptive ICE (a representation of developments), not a directive. Output is definitional (every instance yields a press release) so it is asserted as a restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PressRelease ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing in which an Agent composes a press release that describes organizational developments in order to generate interest in the organization, and has that press release as output." ;
    skos:example "A communications writer drafts a press release announcing a new product launch." ;
    bpot:apqcSourceText "Developing press releases to communicate developments and generate interest in the organization." ;
    bpot:hierarchyID "12.5.4" ;
    bpot:pcfID "11069" .

bpot:P11070 a owl:Class ;
    rdfs:label "Issue press releases" ;
    rdfs:comment "R5: bounded, repeatable dissemination act. Anchored under cco:ont00000588 (Act of Mass Media Communication, verified: 'intended to reach a large audience using a medium such as the internet, television, radio, newspaper, and magazine'). Input bpo:PressRelease and participant bpo:MediaOutlet are both definitional (issuing necessarily transfers an existing press release to media)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PressRelease ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:MediaOutlet ],
        cco:ont00000228,
        cco:ont00000588 ;
    skos:definition "An Act of Mass Media Communication in which an Agent disseminates a press release to selected media in distribution channels such as the web, newspapers, and social media, and has a media outlet as participant." ;
    skos:example "A PR team distributes a finalized press release to wire services, newspapers, and the corporate social-media channels." ;
    bpot:apqcSourceText "Issuing press releases to carefully selected media in distribution channels such as the web, newspapers, and social media." ;
    bpot:hierarchyID "12.5.5" ;
    bpot:pcfID "11070" .

bpot:P12869 a owl:Class ;
    rdfs:label "Assess relationships" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it evaluates and judges the state of government relationships. GOLDEN PRINCIPLE: descriptive output (relationship assessment) agrees with the appraisal genus." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RelationshipData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RelationshipAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input relationship data and has as output a relationship assessment describing how the organization relates to all levels of government." ;
    skos:example "A government-affairs team rates the strength of the firm's ties to local, regional, and national government." ;
    bpot:apqcSourceText "Ascertaining how the business entity relates to all levels of government. Identify areas that needs further growth and resources to foster those relationships." ;
    bpot:hierarchyID "12.2.1.1" ;
    bpot:pcfID "12869" .

bpot:P12870 a owl:Class ;
    rdfs:label "Appoint responsible executives" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning) because appointing assigns a prescriptive responsibility; its output (executive appointment) is a Directive ICE. GOLDEN PRINCIPLE: directive output agrees with the planning/formulation genus." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ExecutiveAppointment ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ExecutivePersonnel ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output an executive appointment prescribing the executive-level resource assigned to manage and drive relationships with government bodies, and has executive personnel as participant." ;
    skos:example "A CEO assigns a VP of Government Affairs to own the relationship with a regulatory ministry." ;
    bpot:apqcSourceText "Assigning executive level resources to manage, grow, and drive relationships with government bodies." ;
    bpot:hierarchyID "12.2.1.2" ;
    bpot:pcfID "12870" .

bpot:P12871 a owl:Class ;
    rdfs:label "Monitor relationships" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring (Act of Information Processing): ongoing analysis of current government relationships yielding a descriptive status report. GOLDEN PRINCIPLE: descriptive output agrees with the information-processing genus." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RelationshipData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RelationshipStatusReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as input relationship data and has as output a relationship status report describing the current state of relationships with government bodies." ;
    skos:example "A liaison reviews recent interactions and reports the health of each government relationship quarterly." ;
    bpot:apqcSourceText "Analyzing current relationships with government bodies and entities." ;
    bpot:hierarchyID "12.2.1.3" ;
    bpot:pcfID "12871" .

bpot:P12872 a owl:Class ;
    rdfs:label "Receive input from internal advisors" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): an ICE (advisory input) is transferred from one Agent (the internal advisor) to another. The advisors are internal personnel; modeled as participants via bpo:Advisor." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:AdvisoryInput ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Advisor ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that has as input advisory input transferred from internal advisors to the organization in order to maintain and advance government relationships, and has an advisor as participant." ;
    skos:example "A government-affairs lead solicits guidance from an internal advisory committee before a policy push." ;
    bpot:apqcSourceText "Garnering internal advice from an informal group in order to successfully maintain and advance relationships." ;
    bpot:hierarchyID "12.2.1.4" ;
    bpot:pcfID "12872" .

bpot:P12873 a owl:Class ;
    rdfs:label "Receive input from external advisors" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): advisory input is transferred from an external Agent to the organization. Distinguished from 12.2.1.4 only by the advisor being third-party." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:AdvisoryInput ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Advisor ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that has as input advisory input transferred from third-party advisors to the organization in order to maintain and advance government relationships, and has an advisor as participant." ;
    skos:example "A firm retains an external lobbying advisor whose recommendations feed its government-relations plan." ;
    bpot:apqcSourceText "Garnering third party advice from an informal group in order to successfully maintain and advance relationships." ;
    bpot:hierarchyID "12.2.1.5" ;
    bpot:pcfID "12873" .

bpot:P12874 a owl:Class ;
    rdfs:label "Liaise with authorities" ;
    rdfs:comment "RE-ANCHORED (Gate-F false-friend): previously cco:ont00000144 'Act of Meeting', whose verified CCO definition is 'An Act of Association wherein two or more PERSONS assemble for some common purpose' -- Persons-restricted. The asserted participant bpo:GovernmentBody is an Organization (subClassOf cco:ont00001180), not a Person, so Act of Meeting does not genuinely fit; it is the same Persons defect this module already rejects for cco:ont00000168 'Act of Interpersonal Relationship' (a sibling of Act of Meeting under Act of Association carrying the same Persons restriction). The CCO Persons restriction is a skos annotation, not an OWL participant axiom, so the class stayed satisfiable at Gate D -- which is exactly why Gate F must catch it. Re-anchored to bpo:ActOfRelationshipManagement (=> cco:ont00000433 'Act of Association', whose definition unites an Agent with 'some other Agent', i.e. Organizations are admissible), mirroring the sibling relationship acts in this group (P12875, P12881). No definitional informational output; any minutes are typical, not necessary." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:GovernmentBody ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management in which representatives of the organization liaise with government heads and representatives in order to advance government relationships, and which has a government body as participant." ;
    skos:example "A government-affairs director liaises with a ministry's representatives to discuss a pending regulation." ;
    bpot:apqcSourceText "Meeting with government heads and representatives." ;
    bpot:hierarchyID "12.2.1.6" ;
    bpot:pcfID "12874" .

bpot:P12875 a owl:Class ;
    rdfs:label "Establish relationships with agencies" ;
    rdfs:comment "Anchored to bpo:ActOfRelationshipManagement (an Act of Association). Any analysis of inclusion requirements is a sub-step, not a definitional informational output, so it is recorded here rather than as a someValuesFrom restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management in which the organization engages government, regulatory, or industry agencies in order to establish a relationship, and which has a regulatory authority as participant." ;
    skos:example "A compliance team formally registers with a quasi-governmental regulator to gain recognized standing." ;
    bpot:apqcSourceText "Engaging government, regulatory, or industry agencies to establish relationships. Analyze steps and requirements necessary for inclusion, if needed." ;
    bpot:hierarchyID "12.2.2.1" ;
    bpot:pcfID "12875" .

bpot:P12876 a owl:Class ;
    rdfs:label "Respond to audit inquiries" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): the organization transfers responsive information in reply to an auditor's inquiry. The audit inquiry is the definitional input ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:AuditInquiry ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Auditor ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that has as input an audit inquiry and in which the organization cooperates with auditors regarding potential or ongoing inquiries, having an auditor as participant." ;
    skos:example "A finance team supplies documentation in response to a regulator's audit inquiry." ;
    bpot:apqcSourceText "Cooperating with auditors regarding potential or ongoing inquiries." ;
    bpot:hierarchyID "12.2.2.2" ;
    bpot:pcfID "12876" .

bpot:P12877 a owl:Class ;
    rdfs:label "Maintain documentation of contacts" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing: input ICEs are received, manipulated, or stored). 'Maintain' here is record-keeping of informational ICEs, NOT cco:ont00000950 'Act of Maintenance' (which modifies Material Artifacts). GOLDEN PRINCIPLE: descriptive output (contact records) agrees with the information-processing genus. Also considered cco:ont00000438 'Act of Official Documentation' (verified def: 'An Act of Declarative Communication in which an Agent records some information for official use by ANOTHER Agent') but retained cco:ont00000366: this node is INTERNAL record maintenance -- keeping the organization's own contact repository current through routine reviews -- not declarative documentation prepared for official use by another agent, so 438's declarative-communication differentia does not fit (a themed false friend)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ContactRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that has as output contact records and that stores and updates documents describing the organization's network of partners, prospects, and customers." ;
    skos:example "A relationship manager keeps a CRM repository of agency contacts current through routine reviews." ;
    bpot:apqcSourceText "Keeping a repository of documents that contain information about the network of partners, prospects and customers. Keep records up-to-date with routine reviews and modify as needed." ;
    bpot:hierarchyID "12.2.2.3" ;
    bpot:pcfID "12877" .

bpot:P12878 a owl:Class ;
    rdfs:label "Plan and manage meetings" ;
    rdfs:comment "RE-ANCHORED (Gate-F false-friend, same Persons defect as 12.2.1.6): previously cco:ont00000144 'Act of Meeting' ('two or more PERSONS assemble'), but the asserted participant bpo:QuasiGovernmentBody is an Organization, not a Person -- the Persons restriction is violated, contradicting the module's own rejection of the Persons-restricted Act of Interpersonal Relationship. Re-anchored to bpo:ActOfRelationshipManagement (=> cco:ont00000433 'Act of Association', Organizations admissible), consistent with the 'plan and manage ... interaction ... to maintain established relationships' reading. OUTPUT corrected (Phase-3 category confusion): the previous has-output filler bpo:RelationshipData is a Descriptive INPUT ICE ('describes the current state of a relationship', used as has-input in P12869/P12871/P12880); the artifact this act produces by 'collect and record meeting data' is a meeting record, so the definitional output is the distinct bpo:MeetingRecord (recording is definitional per the source, so it is retained as a someValuesFrom restriction rather than demoted)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MeetingRecord ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:QuasiGovernmentBody ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management in which the organization interacts regularly with quasi-government bodies to maintain established relationships, has as output a meeting record capturing the meeting data collected, and has a quasi-government body as participant." ;
    skos:example "A liaison holds quarterly meetings with a quasi-governmental body and logs the discussion for later analysis." ;
    bpot:apqcSourceText "Ensuring regular interaction between business entity and quasi-government bodies in order to maintain established relationships. Collect and record meeting data for further analysis and use." ;
    bpot:hierarchyID "12.2.2.4" ;
    bpot:pcfID "12878" .

bpot:P12879 a owl:Class ;
    rdfs:label "Evaluate the requirements for strategic relationships" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): the deliverable is a prescriptive specification of the requirements to enter an agreement (a Directive ICE). GOLDEN PRINCIPLE: directive output agrees with the planning/formulation genus, despite the surface verb 'evaluate'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkRequirementsSpecification ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:TradeOrIndustryGroup ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a work requirements specification prescribing the requirements to enter into an agreement with trade or industry agencies, and which has a trade or industry group as participant." ;
    skos:example "A partnerships team documents the membership and participation requirements needed to join an industry consortium." ;
    bpot:apqcSourceText "Determining the requirements to enter in to an agreement with trade or industry agencies. Discover what activities or processes can be conducted to provide the best mutual outcome." ;
    bpot:hierarchyID "12.2.3.1" ;
    bpot:pcfID "12879" .

bpot:P12880 a owl:Class ;
    rdfs:label "Monitor the success of the partnerships" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring (Act of Information Processing): ongoing analysis of partnership success yielding a descriptive status report. GOLDEN PRINCIPLE: descriptive output agrees with the information-processing genus." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RelationshipData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RelationshipStatusReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as input relationship data and has as output a relationship status report describing the current state and success of relationships with trade or industry groups." ;
    skos:example "A partnerships lead reviews engagement metrics and reports whether each industry-group relationship is on track." ;
    bpot:apqcSourceText "Analyzing current relationships with trade and industry groups. Ensure that the partnership in successful and make modifications where needed." ;
    bpot:hierarchyID "12.2.3.2" ;
    bpot:pcfID "12880" .

bpot:P12881 a owl:Class ;
    rdfs:label "Extend or change the relationships" ;
    rdfs:comment "Anchored to bpo:ActOfRelationshipManagement (an Act of Association). 'Communicate and execute changes' is a sub-step; no single informational ICE is definitional, so I/O is recorded in this comment rather than as a someValuesFrom restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:TradeOrIndustryGroup ],
        bpot:ActOfRelationshipManagement ;
    skos:definition "An Act of Relationship Management in which the organization extends or modifies an existing relationship with a trade or industry group by providing additional inclusion or changing its parameters, and which has a trade or industry group as participant." ;
    skos:example "A partnerships team upgrades the firm's membership tier in an industry association and notifies the counterpart." ;
    bpot:apqcSourceText "Providing additional information or inclusion for third party trade or industry entities; or changing existing parameters to modify the current relationship. Communicate and execute changes." ;
    bpot:hierarchyID "12.2.3.3" ;
    bpot:pcfID "12881" .

bpot:PressRelease a owl:Class ;
    rdfs:label "Press Release" ;
    rdfs:comment "Output of 12.5.4 (Create press releases) and subject of 12.5.5 (Issue press releases)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an official statement issued to the media to announce a newsworthy development of an organization." .

bpot:RelationshipStatusReport a owl:Class ;
    rdfs:label "Relationship Status Report" ;
    rdfs:comment "Output of monitoring rows (12.2.1.3 Monitor relationships, 12.2.3.2 Monitor partnership success). The subject (the monitored external-party relationships) is named in the definition; no formal 'is about' (cco:ont00001808) restriction is asserted -- the only candidate filler bpo:RelationshipData is these acts' has-input, so an is-about to it would mis-state the subject as the input data." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the current standing of an organization's relationships as observed through ongoing monitoring." .

bpot:TradeOrIndustryGroup a owl:Class ;
    rdfs:label "Trade or Industry Group" ;
    rdfs:comment "Minted for 12.2.3." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:TradeOrIndustryGroupRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a trade-or-industry-group role in virtue of being established and financed by businesses operating in a specific industry." .

bpot:WorkRequirementsSpecification a owl:Class ;
    rdfs:label "Work Requirements Specification" ;
    rdfs:comment "Output of 12.4.5.1 (Assess problem and determine work requirements) and 12.2.3.1 (Evaluate the requirements for strategic relationships). Directive: it specifies required actions." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the tasks and action requirements for engaging outside counsel on a legal problem, or for entering into a strategic relationship." .

bpot:P11053 a owl:Class ;
    rdfs:label "Plan and initiate compliance program" ;
    rdfs:comment "Output ComplianceProgram is a Directive ICE, so the genus is Formulation (Act of Planning)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceProgram ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that designs an internal system to identify and reduce the risk of statutory breach and has as output a compliance program." ;
    skos:example "A compliance lead designs and launches an anti-trust compliance program." ;
    bpot:apqcSourceText "Employing an internal system or process to identify and reduce the risk of breaching the Competition and Consumer Act 2010. Remedy any breach. Create a culture of compliance. Design compliance programs." ;
    bpot:hierarchyID "12.4.4.1" ;
    bpot:pcfID "11053" .

bpot:P11054 a owl:Class ;
    rdfs:label "Execute compliance program" ;
    rdfs:comment "Anchored at cco:ont00000228 (Planned Act): execution is prescribed by the ComplianceProgram (Directive ICE), modeled as a held prescription via cco:ont00001921 (has input). It produces no new definitional ICE of its own." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ComplianceProgram ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:CompliancePersonnel ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that implements an established compliance program to meet government laws and regulations, prescribed by that compliance program." ;
    skos:example "A compliance team carries out the scheduled controls and audits defined by the program." ;
    bpot:apqcSourceText "Implementing the established compliance program in order to meet the government laws and regulations. Create a compliance team that scrutinizes the rules set out by government bodies such as the Securities and Exchange Commission." ;
    bpot:hierarchyID "12.4.4.2" ;
    bpot:pcfID "11054" .

bpot:RelationshipData a owl:Class ;
    rdfs:label "Relationship Data" ;
    rdfs:comment "Input for assessing/monitoring relationships (12.2.1.1, 12.2.1.3, 12.2.3.2)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the current state of an organization's relationship with an external party." .

bpot:StakeholderRelationshipManagementCapability a owl:Class ;
    rdfs:label "Stakeholder Relationship Management Capability" ;
    rdfs:comment "Shared capability for the 'Manage/Build ... relations' standing-function rows (12.1, 12.2.x, 12.3, 12.5.x), realized in the relevant relationship-management acts via obo:BFO_0000054 (realized in)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to build and maintain relationships with external stakeholders such as investors, government bodies, and the public." .

bpot:Advisor a owl:Class ;
    rdfs:label "Advisor" ;
    rdfs:comment "Minted for 12.2.1.4 / 12.2.1.5 (receive input from internal/external advisors)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:AdvisorRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears an advisor role in virtue of providing advice or counsel, whether internally or as a third party, to support an organization's relationships." .

bpot:LegalAndComplianceCapability a owl:Class ;
    rdfs:label "Legal and Compliance Capability" ;
    rdfs:comment "Supports 12.4 / 12.4.4 (Manage legal and ethical issues; Ensure compliance) when modeled as standing functions." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to conduct legal and ethical practices and to validate adherence to applicable laws and regulations." .

