@prefix bpot: <https://fandaws.com/ontology/bpot#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bpot:CompliancePolicy rdfs:label "Compliance Policy" ;
    rdfs:comment "Output of 12.4.4 / 12.4.4.1 (compliance framework and programs)." ;
    skos:definition "A Directive Information Content Entity that prescribes the framework, rules, and procedures by which an organization maintains adherence to applicable statutes and regulations." .

bpot:CorporateGovernancePolicy a owl:Class ;
    rdfs:label "Corporate Governance Policy" ;
    rdfs:comment "Output of 12.4.2 (Manage corporate governance policies)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the system of rules, practices, and processes through which a company is directed and controlled." .

bpot:LobbyistRole a owl:Class ;
    rdfs:label "Lobbyist Role" ;
    rdfs:comment "Minted for 12.2.4 (Manage lobby activities)." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with influencing public or government policy on behalf of a focal organization." .

bpot:PCF_11010 bpot:designatesProcessType bpot:P11010 .

bpot:PCF_11012 bpot:designatesProcessType bpot:P11012 .

bpot:PCF_11013 bpot:designatesProcessType bpot:P11013 .

bpot:PCF_11014 bpot:designatesProcessType bpot:PublicRelationsCapability .

bpot:PCF_11035 bpot:designatesProcessType bpot:P11035 .

bpot:PCF_11036 bpot:designatesProcessType bpot:P11036 .

bpot:PCF_11037 bpot:designatesProcessType bpot:P11037 .

bpot:PCF_11038 bpot:designatesProcessType bpot:P11038 .

bpot:PCF_11039 bpot:designatesProcessType bpot:P11039 .

bpot:PCF_11040 bpot:designatesProcessType bpot:P11040 .

