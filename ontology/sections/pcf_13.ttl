bpot:PortfolioManagerRole a owl:Class ;
    rdfs:label "Portfolio Manager Role" ;
    rdfs:comment "Minted for recurring APQC 13.2.1 participant." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being responsible for governing and monitoring an Organization's business portfolio of investments, holdings, products, businesses, and brands." .

bpot:ProjectManager a owl:Class ;
    rdfs:label "Project Manager" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ProjectManagerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a project-manager role." .

bpot:QualityManagerRole a owl:Class ;
    rdfs:label "Quality Manager Role" ;
    rdfs:comment "Minted for recurring APQC 13.3 participant ('quality management team')." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being responsible for establishing, evaluating, and maintaining enterprise quality requirements and the quality management system." .

bpot:StakeholderRole rdfs:comment "Minted for the cross-cutting 'stakeholder' participant referenced across 13.2, 13.4, 13.7, 13.8, 13.9." .

bpot:SustainabilityManagerRole a owl:Class ;
    rdfs:label "Sustainability Manager Role" ;
    rdfs:comment "Minted for recurring APQC 13.9 participant." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being responsible for developing and managing an Organization's sustainability (ESG) capability, policies, and reporting." .

<https://fandaws.com/ontology/bpot/sections/pcf_13> a owl:Ontology ;
    dcterms:creator "Aaron Damiano" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://fandaws.com/ontology/bpo/slice/13.0>,
        "APQC Process Classification Framework (Cross-Industry)",
        "APQC Process Classification Framework (Cross-Industry) v7.4" ;
    dcterms:title "Business Process Ontology -- PCF 13.0 Develop and Manage Business Capabilities" ;
    rdfs:comment "Reality layer for APQC PCF category 13.0: the process universals that pass the bounded-occurrent test, the organization capabilities, roles and information content entities they use." ;
    owl:versionIRI <https://fandaws.com/ontology/bpot/0.0.0/sections/pcf_13.ttl> ;
    owl:versionInfo "0.0.0" .

bpot:AnalysisReport a owl:Class ;
    rdfs:label "Analysis Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that summarizes and documents the results of data analysis, including graphs and visualizations of numerical findings." .

bpot:AnalyticsCapability a owl:Class ;
    rdfs:label "Analytics Capability" ;
    rdfs:comment "Standing-function reading of APQC 13.7 'Develop, manage, and deliver analytics' (PCF 20959). Per R5 the 'Develop/manage/deliver' group node is a standing function -> Organization Capability; the catalog node bpo:PCF_20959 designates this capability. Its 11 bounded leaf acts (bpo:P21459..bpo:P20964) are wired as obo:BFO_0000054 (realized in) fillers, mirroring the 13.1/13.5 capability pattern; they are NOT has-process-part of a capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21459 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21460 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20960 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20961 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21461 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20962 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21462 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21463 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21464 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20963 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20964 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop, manage, and deliver analytics across its data-management pipeline, realized in its bounded analytics acts." .

bpot:AnalyticsProjectScopeStatement a owl:Class ;
    rdfs:label "Analytics Project Scope Statement" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the size and scale of an analytics project based on collected information." .

bpot:BPMGovernanceLeader a owl:Class ;
    rdfs:label "BPM Governance Leader" ;
    rdfs:comment "Minted as the named participant of bpo:P16380 (Define and manage governance approach). Bears the shared bpo:BPMGovernanceLeaderRole (D4: realizables on Agents only)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:BPMGovernanceLeaderRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears the BPM Governance Leader Role within an organization's business-process-management governance." .

bpot:BPMGovernanceLeaderRole a owl:Class ;
    rdfs:label "BPM Governance Leader Role" ;
    rdfs:comment "Minted for APQC 13.1.1.1 'Identify BPM governance leaders'." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being designated to set standards and priorities for business-process-management efforts within an Organization." .

bpot:BPMToolTemplate a owl:Class ;
    rdfs:label "BPM Tool Template" ;
    rdfs:comment "Directive: a template prescribes how a tool is set up. Minted because no shared-vocab ICE covers BPM tool/template artifacts (output of bpo:P16381)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a reusable configuration of a business-process-management tool (process engine, analytics, content management, or collaboration tool) ready for implementation." ;
    skos:example "A pre-built process-engine workflow template instantiated for new processes." .

bpot:BusinessCase rdfs:comment "Descriptive (an argument/justification representing a situation), not Directive; the go/no-go decision it supports is a separate Directive ICE." ;
    skos:definition "A Descriptive Information Content Entity that describes a current situation, proposed solution, financial analysis, and conclusion in order to justify a course of action to a decision maker." .

bpot:BusinessProcess a owl:Class ;
    rdfs:label "Business Process" ;
    rdfs:comment "Minted as the aboutness referent for descriptive process ICEs (e.g. bpo:ProcessAnalysis, bpo:ProcessModel). A business process is an occurrent (obo:BFO_0000015), NOT an ICE and NOT the bpo:ProcessOwner Agent. S8 (is-about-on-ICE) is subject-only and does not constrain this filler." ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "A Process consisting of a structured set of related activities and tasks carried out by the participants of one or more Organizations to achieve a business goal." .

bpot:BusinessProcessManagementCapability a owl:Class ;
    rdfs:label "Business Process Management Capability" ;
    rdfs:comment "Models APQC group 13.1 'Manage business processes' (PCF 16378). Per R5/R6 the verb 'Manage' denotes a standing organizational function with no natural end, so it is an Organization Capability realized in the child acts -- NOT a process class. No bpo:P16378 is minted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16379 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16384 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16387 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16392 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21453 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to govern, define, administer, and improve its business processes, realized in the acts of establishing process governance, defining process frameworks, defining processes, managing process performance, and improving processes." .

bpot:ChangeBarrierAnalysis a owl:Class ;
    rdfs:label "Change Barrier Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the obstacles, resistors, and enablers bearing on an Organization's change." .

bpot:ChangeChampionRole a owl:Class ;
    rdfs:label "Change Champion Role" ;
    rdfs:comment "Minted for APQC 13.4.1.3 'Identify change champion(s)' and 13.4.2.5 'Assign change champion(s)'." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being designated to promote, communicate, and drive the adoption of a change initiative within a division or team of an Organization." .

bpot:ChangeManager a owl:Class ;
    rdfs:label "Change Manager" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ChangeManagerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a change-manager role, held accountable for ensuring an Organization's change is managed systematically." .

bpot:ChangeManagerRole a owl:Class ;
    rdfs:label "Change Manager Role" ;
    rdfs:comment "Minted for APQC 13.4.1.12 'Establish accountability for change management'." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being held accountable for ensuring that an Organization's change is planned, designed, implemented, and sustained systematically." .

bpot:ChangeNeedStatement a owl:Class ;
    rdfs:label "Change Need Statement" ;
    rdfs:comment "Used by 13.6.2.5 'Establish need for change'; can feed 13.4 change planning." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the need and rationale for changing an Organization's performance, derived from gap-analysis results." .

bpot:ChangeReadinessAssessment a owl:Class ;
    rdfs:label "Change Readiness Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the preparedness of the conditions, attitudes, and resources at all levels of an Organization for a change to succeed." .

bpot:ChangeReport a owl:Class ;
    rdfs:label "Change Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the outcome of a change and the impact it had on critical assets." .

bpot:CompetencyRequirementSpecification a owl:Class ;
    rdfs:label "Competency Requirement Specification" ;
    rdfs:comment "Minted: no competency-requirement directive in the shared vocabulary (output of bpo:P17479)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the competencies required to perform a defined set of quality-control activities." .

bpot:ComplianceCapabilityDemonstration a owl:Class ;
    rdfs:label "Compliance Capability Demonstration" ;
    rdfs:comment "Minted: descriptive evidentiary artifact (SPC, process-capability analysis) of conformance ability (output of bpo:P17480)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes evidence demonstrating an organization's ability to confirm and fulfil its quality requirements before stakeholders." .

bpot:CorrectiveActionCompletionRecord a owl:Class ;
    rdfs:label "Corrective Action Completion Record" ;
    rdfs:comment "Descriptive (a completion/effect record), not Directive: it represents what was done and the brought-about state, in contrast to the governing bpo:CorrectiveAndPreventiveActionSpecification (the input directive). Output of bpo:P17496 'Take corrective or preventative action'." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the corrective and preventive actions carried out against a non-conformity and the resulting state after implementation and monitoring." ;
    skos:example "A closed CAPA log entry recording the tooling change implemented and the post-change defect rate observed." .

bpot:CriticalToQualityCharacteristicSpecification a owl:Class ;
    rdfs:label "Critical-to-Quality Characteristic Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the key measurable performance characteristics that products and processes must satisfy to meet customer needs." .

bpot:CrossFunctionalProcessRegister a owl:Class ;
    rdfs:label "Cross-Functional Process Register" ;
    rdfs:comment "Descriptive: represents which processes are cross-functional. Minted because no shared-vocab ICE covers this register (output of bpo:P16386)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the business processes spanning two or more functional areas of an organization." ;
    skos:example "A list of order-to-cash processes flagged as cross-functional." .

bpot:CulturalContextAssessment a owl:Class ;
    rdfs:label "Cultural Context Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an Organization's culture and the aspirations for it along multiple dimensions." .

bpot:CurrentStateAssessment a owl:Class ;
    rdfs:label "Current State Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the existing processes, structures, and culture of an Organization prior to a change." .

bpot:DataAnalystRole a owl:Class ;
    rdfs:label "Data Analyst Role" ;
    rdfs:comment "Minted for recurring APQC 13.7 participant ('knowledge engineers, data scientists, and other relevant personnel')." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with collecting, preparing, analyzing, and modeling data to produce analytical findings for an Organization." .

bpot:EHSAuditReport a owl:Class ;
    rdfs:label "EHS Audit Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the findings of an inspection verifying compliance with environmental, health, and safety standards." .

bpot:EHSCostBenefitAssessment a owl:Class ;
    rdfs:label "EHS Cost-Benefit Assessment" ;
    rdfs:comment "Descriptive (a judgement of cost vs benefit). Output of bpo:P11193 'Manage EHS costs and benefits'." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the evaluated costs and benefits of an environmental, health, and safety program and whether its benefits outweigh its costs." .

bpot:EHSEventRecord a owl:Class ;
    rdfs:label "EHS Event Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the events and activities associated with complying with environmental, health, and safety standards." .

bpot:EHSManagementCapability a owl:Class ;
    rdfs:label "EHS Management Capability" ;
    rdfs:comment "Standing-function reading of APQC 13.8 'Manage environmental health and safety' (PCF 11179). Per R5 the 'Manage' group node is a standing function -> Organization Capability; the catalog node bpo:PCF_11179 designates this capability. Its three bounded group children (bpo:P11180 determine impacts, bpo:P11181 develop program, bpo:P21587 monitor and manage) are wired as obo:BFO_0000054 (realized in) fillers, mirroring the 13.1/13.5 capability pattern. No bpo:P11179 process is minted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11180 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11181 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21587 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to determine, develop, monitor, and manage its environmental, health, and safety program, realized in its bounded EHS acts." .

bpot:EHSPerformanceReport a owl:Class ;
    rdfs:label "EHS Performance Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the measured performance of an environmental, health, and safety program against its indicators." .

bpot:EHSPolicy a owl:Class ;
    rdfs:label "EHS Policy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the minimum requirements, procedures, and tools by which an Organization will manage its environmental, health, and safety impact." .

bpot:EHSRequirementRegister a owl:Class ;
    rdfs:label "EHS Requirement Register" ;
    rdfs:comment "Descriptive (a register/record of discerned, externally-set requirements). Output of bpo:P11188 'Identify regulatory and stakeholder requirements', restoring Info-Processing -> Descriptive agreement (GOLDEN PRINCIPLE). The externally-authored Directive bpo:EHSRequirementSpecification is the has-input it captures." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that registers the regulatory and stakeholder protocols and standards an Organization has discerned it must comply with for environment, health, and safety." .

bpot:EHSRequirementSpecification a owl:Class ;
    rdfs:label "EHS Requirement Specification" ;
    rdfs:comment "Directive ICE authored externally by regulators/stakeholders, NOT by the discernment act bpo:P11188. P11188 consumes it as a has-input and produces the Descriptive bpo:EHSRequirementRegister; it does not compose this directive." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the regulatory and stakeholder protocols and standards an Organization must comply with for environment, health, and safety." .

bpot:EHSRiskAndOpportunityAssessment a owl:Class ;
    rdfs:label "EHS Risk and Opportunity Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the future risks and opportunities affecting the environmental, health, and safety of products and services." .

bpot:EQMSPerformanceAssessment a owl:Class ;
    rdfs:label "EQMS Performance Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the benchmarked performance of an enterprise quality management system and the gaps relative to industry peers." .

bpot:EmergencyResponseProgram a owl:Class ;
    rdfs:label "Emergency Response Program" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes how available resources are organized, coordinated, and directed to respond to emergency scenarios." .

bpot:EnvironmentalImpactAssessment a owl:Class ;
    rdfs:label "Environmental Impact Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the environmental impact of an Organization's products, services, and operations over their lifecycle." .

bpot:FunctionalEmployee a owl:Class ;
    rdfs:label "Functional Employee" ;
    rdfs:comment "Minted as the definitional training-recipient participant of bpo:P11182 'Train and educate functional employees' (13.8.3.5), mirroring the bpo:ProcessOwner pattern used by the sibling-analog bpo:P16393 'Provide process training'. NOT bpo:Stakeholder (an interested/affected party): the source names functional employees as the recipients." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:TraineeRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a trainee role as a functional employee receiving an organization's training -- e.g. environmental, health, and safety training." .

bpot:FutureStateSpecification a owl:Class ;
    rdfs:label "Future State Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the target state an Organization intends to reach after implementing a change, including resource requirements." .

bpot:Hypothesis a owl:Class ;
    rdfs:label "Hypothesis" ;
    rdfs:comment "Descriptive (853): a hypothesis is a proposed explanation -- a candidate account of how reality is -- not a prescription. CAUTION: the study-design / data-collection PLAN that prescribes how to TEST the hypothesis (what to sample, measure, and collect) is a separate Directive (965) ICE; do not conflate the descriptive conjecture with the directive test plan." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a proposed explanation of empirical data, used to guide feature selection during data collection." .

bpot:ITNeedsAssessment a owl:Class ;
    rdfs:label "IT Needs Assessment" ;
    rdfs:comment "Minted locally: not present in the shared vocabulary list. Descriptive (judges/represents requirements) per the GOLDEN PRINCIPLE; it is the definitional output of bpo:P11106." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the information-technology requirements for building and implementing a knowledge-management strategy." .

bpot:ITRequirementsStatement a owl:Class ;
    rdfs:label "IT Requirements Statement" ;
    rdfs:comment "FALSE FRIEND: despite the label 'Requirement', this is a DESCRIPTIVE (853) record of requirements gathered by a discernment act; the directive requirement itself is modeled separately. An enumeration of discerned IT requirements. Output of bpo:P11124 'Identify specific IT requirements'." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the information-technology requirements -- computers and telecommunications equipment to store, retrieve, transmit, and manipulate data -- of a specific project." .

bpot:ImprovementOpportunityAssessment a owl:Class ;
    rdfs:label "Improvement Opportunity Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes identified opportunities to improve an existing business process to meet new goals and objectives." .

bpot:KMAwarenessCommunication a owl:Class ;
    rdfs:label "KM Awareness Communication" ;
    rdfs:comment "Descriptive: the communicated content disseminated to raise awareness and drive use of knowledge bases. Output of bpo:P20970 'Sustain awareness and engagement' (a communication/promotion act)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the awareness-and-engagement messaging promoting use of an Organization's available knowledge bases." ;
    skos:example "An internal campaign message encouraging staff to contribute to and consult the knowledge base." .

bpot:KMFundingModel a owl:Class ;
    rdfs:label "KM Funding Model" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the funding approach selected for an Organization's knowledge management program." .

bpot:KMGovernanceModel a owl:Class ;
    rdfs:label "KM Governance Model" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the structure, roles, and accountability for governing an Organization's collective knowledge." .

bpot:KMInitiativeLinkageAnalysis a owl:Class ;
    rdfs:label "KM Initiative Linkage Analysis" ;
    rdfs:comment "Minted locally: not present in the shared vocabulary list. Descriptive (represents discovered correlations) per the GOLDEN PRINCIPLE; it is the definitional output of bpo:P11104." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the correlations and dependencies between an organization's knowledge-management strategy and its other functional areas or initiatives." .

bpot:KMResourceModel a owl:Class ;
    rdfs:label "KM Resource Model" ;
    rdfs:comment "Minted locally: not present in the shared vocabulary list. Directive (prescribes resources/standards/guidelines) per the GOLDEN PRINCIPLE; it is the definitional output of bpo:P20966." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the resources, standards, and guidelines an organization's knowledge-management approaches are to follow." .

bpot:KMStrategy a owl:Class ;
    rdfs:label "KM Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an Organization's plan for capturing, maintaining, accessing, and exploiting its knowledge base." .

bpot:KnowledgeManagementCapability a owl:Class ;
    rdfs:label "Knowledge Management Capability" ;
    rdfs:comment "Models APQC group 13.5 'Develop and manage enterprise-wide knowledge management capability' (PCF 11073). Per R5/R6 a standing function -> Organization Capability realized in its child acts; the catalog node bpo:PCF_11073 designates this capability. No bpo:P11073 process is minted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11095 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11096 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20965 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20969 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop strategy for, assess, design, implement, and sustain the management of its collective knowledge, realized in the acts of developing KM strategy, assessing KM capabilities, designing and implementing KM capabilities, and evolving and sustaining them." .

bpot:LessonsLearnedRecord a owl:Class ;
    rdfs:label "Lessons Learned Record" ;
    rdfs:comment "Shared across 13.4.4.2 and 13.2.3.4.5 project reviews." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the insights and knowledge captured from a completed change or project for reuse." .

bpot:MeasurementMethodSelection a owl:Class ;
    rdfs:label "Measurement Method Selection" ;
    rdfs:comment "Minted: Directive output of choosing measurement methods from candidate tools (output of bpo:P17478)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the tools and methods chosen to measure quality levels." .

bpot:MetricGapAssessment a owl:Class ;
    rdfs:label "Metric Gap Assessment" ;
    rdfs:comment "Descriptive (a gap-finding/discernment), not Directive: it represents the NEED for further metrics, not the composition of any new indicator. Output of bpo:P20141 'Identify additional metrics as required'. Distinct from bpo:PerformanceIndicatorSpecification (the Directive artifact a later formulation act would compose)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes whether additional performance indicators are needed to achieve a business goal and which measurement gaps exist." ;
    skos:example "A note finding that the new on-time-delivery goal is not yet covered by any existing KPI." .

bpot:MonitoringFrequencySpecification a owl:Class ;
    rdfs:label "Monitoring Frequency Specification" ;
    rdfs:comment "Minted for APQC 13.6.3.2 'Establish monitoring frequency'. Directive (not Descriptive) because it prescribes a monitoring cadence rather than describing reality. Distinct from bpo:PerformanceIndicatorSpecification (which prescribes what is measured, not how often)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes how often performance is to be supervised, measured, and assessed." .

bpot:OrganizationalPerformanceStrategy a owl:Class ;
    rdfs:label "Organizational Performance Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an Organization's approach for measuring, tracking, streamlining, and improving internal performance." .

bpot:OrganizationalRiskAnalysis a owl:Class ;
    rdfs:label "Organizational Risk Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the impact and probability of threats to an Organization's critical assets." .

bpot:P11074 a owl:Class ;
    rdfs:label "Manage change" ;
    rdfs:comment "Models APQC process group 13.4 as a bounded change-management cycle (an occurrent), not the standing 'change management' function. Its APQC children are process parts, not subclasses. DELIBERATE R5 DIVERGENCE FROM SIBLING GROUP NODES (auditable, uniform criterion): a 'Manage X' group node is minted as a bounded Planned Act ONLY when X denotes a discrete initiative with a natural terminus, and as an Organization Capability (cco:ont00000568, no bpo:P) when X denotes an open-ended enterprise function with no natural end. A change/transformation INITIATIVE has a natural end (the target future state is reached and adoption sustained), so 13.4 is a bounded Planned Act AND additionally carries the standing-function reading bpo:ChangeManagementCapability for orgs that run change as a permanent function. By contrast 13.3 'Manage enterprise quality' (P17471), 13.1 'Manage business processes' (16378), 13.5 'Manage KM' (11073), and 13.2 portfolio/program/project management are permanent functions with no natural end, so they are capability-only. See the cross-reference on bpo:P17471." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21457 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11135 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11136 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11137 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an Agent plans, designs, implements, and sustains a deliberate organizational change, comprising the planning, design, implementation, and improvement-sustainment of that change." ;
    skos:example "An organization's end-to-end transformation initiative from concept through sustained adoption." ;
    bpot:apqcSourceText "Planning, designing, and implementing the change. Ensure improvement in the change process." ;
    bpot:hierarchyID "13.4" ;
    bpot:pcfID "11074" .

bpot:P17471 a owl:Class ;
    rdfs:label "Manage enterprise quality" ;
    rdfs:comment "Modeled as Organization Capability (R5/R6): 'Manage enterprise quality' is a standing function with no natural end, realized in its constituent acts rather than being a single bounded occurrent. Same capability as the shared bpo:EnterpriseQualityManagementCapability. DELIBERATE R5 DIVERGENCE FROM SIBLING 13.4 (auditable, uniform criterion): unlike 'Manage change' (P11074), which is a discrete transformation INITIATIVE with a natural terminus and is therefore minted as a bounded Planned Act, quality management is a PERMANENT enterprise function with no natural end and so is capability-only (no bpo:P process). The same capability-only treatment applies to 13.1 (16378), 13.5 (11073), and the 13.2 portfolio/program/project management functions. See the cross-reference on bpo:P11074." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17472 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17482 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17492 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17498 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization to the extent of its capacity to establish quality requirements, evaluate quality performance against those requirements, handle nonconformances, and operate an enterprise quality management system." ;
    skos:example "A manufacturer's standing quality-management function spanning requirements, testing, nonconformance handling, and its EQMS." ;
    bpot:apqcSourceText "Managing organizational attributes that are closely associated with the quality of output. Determine the quality requirements. Evaluate the correspondence between the quality performance and requirements. Manage non-conformance activities. Ensure implementation and maintenance of the enterprise quality management system." ;
    bpot:hierarchyID "13.3" ;
    bpot:pcfID "17471" .

bpot:PerformanceImprovementPlan a owl:Class ;
    rdfs:label "Performance Improvement Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the actions for bridging identified performance gaps." .

bpot:PerformanceReport skos:definition "A Descriptive Information Content Entity that describes performance, including performance gaps, trends, and analysis, for the appropriate authority." .

bpot:PollutionPreventionProgram a owl:Class ;
    rdfs:label "Pollution Prevention Program" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes how an Organization reduces or eliminates the creation of pollutants through increased efficiency in resource use." .

bpot:PortfolioGovernanceFramework a owl:Class ;
    rdfs:label "Portfolio Governance Framework" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the rules, metrics, and procedures for identifying, selecting, prioritizing, and monitoring portfolio components." .

bpot:PortfolioManagementCapability a owl:Class ;
    rdfs:label "Portfolio Management Capability" ;
    rdfs:comment "Standing-function reading of APQC 13.2.1 'Manage portfolio' (PCF 16401). No bpo:P16401 process is minted; the catalog node bpo:PCF_16401 designates this capability. Wired with obo:BFO_0000054 (realized in) to its constituent acts bpo:P16402/bpo:P16403/bpo:P16404, mirroring the 13.1/13.5 capability pattern." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16402 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16403 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16404 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish strategy for, govern, and monitor its business portfolio of investments, holdings, products, businesses, and brands, realized in its constituent acts." .

bpot:PortfolioProgramProjectManagementCapability a owl:Class ;
    rdfs:label "Portfolio, Program, and Project Management Capability" ;
    rdfs:comment "Aggregate standing-function reading of APQC group 13.2 'Manage portfolio, program, and project' (PCF 16400). Sits above the three sub-capacities bpo:PortfolioManagementCapability / bpo:ProgramManagementCapability / bpo:ProjectManagementCapability. The catalog node bpo:PCF_16400 designates this aggregate. Per D8 the ProcessGroup level gets an aggregate capability node (not a process) consistent with the standing-function reading of its 'Manage X' children. No bpo:P16400 process is minted." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to manage its portfolio of investments and brands, its programs of related projects, and its individual projects." .

bpot:PortfolioStatusReport a owl:Class ;
    rdfs:label "Portfolio Status Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the health and progress of an Organization's business portfolio as observed through monitoring." .

bpot:PortfolioStrategy a owl:Class ;
    rdfs:label "Portfolio Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an Organization's plan for managing its portfolio of investments, holdings, products, businesses, and brands." .

bpot:PreventiveQualityActivitySpecification a owl:Class ;
    rdfs:label "Preventive Quality Activity Specification" ;
    rdfs:comment "Minted: distinct from event-triggered Corrective and Preventive Action Specification; this is requirement-gap-driven prevention (output of bpo:P17474)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes preventive quality activities and the standard methodology for designing or conducting them in order to mitigate the risk of not meeting critical-to-quality characteristics." .

bpot:ProcessAnalysis a owl:Class ;
    rdfs:label "Process Analysis" ;
    rdfs:comment "is-about target is the subject bpo:BusinessProcess (an occurrent), NOT the bpo:ProcessOwner Agent who is accountable for it. S8 (is-about-on-ICE) is subject-only and confirmed not to constrain the filler kind, so an occurrent filler is legal here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:BusinessProcess ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes how a business process works and how participants from different groups work together to achieve a business goal." .

bpot:ProcessImprovementMethodologySelection a owl:Class ;
    rdfs:label "Process Improvement Methodology Selection" ;
    rdfs:comment "Directive: the output of a selection act, prescribing the chosen methodology. Reused as input to 13.4.3.2 reengineering." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the process-improvement methodology (e.g. Lean, Six Sigma) chosen for an improvement effort." .

bpot:ProcessOwnerRole a owl:Class ;
    rdfs:label "Process Owner Role" ;
    rdfs:comment "Minted for recurring APQC 13.1 participant 'process owner'. Borne by an independent continuant (the assigned Agent), never by a process or ICE." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being assigned accountability for identifying, analyzing, and improving a given business process within an Organization." .

bpot:ProgramManagementCapability a owl:Class ;
    rdfs:label "Program Management Capability" ;
    rdfs:comment "Standing-function reading of APQC 13.2.2 'Manage programs' (PCF 16405). No bpo:P16405 process is minted; the catalog node bpo:PCF_16405 designates this capability. Wired with obo:BFO_0000054 (realized in) to bpo:P16406..bpo:P16409, mirroring the 13.1/13.5 capability pattern." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16407 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16408 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16409 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16406 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish, execute, and report on business programs comprising related projects, realized in its constituent acts." .

bpot:ProgramManager a owl:Class ;
    rdfs:label "Program Manager" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ProgramManagerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a program-manager role." .

bpot:ProgramManagerRole a owl:Class ;
    rdfs:label "Program Manager Role" ;
    rdfs:comment "Minted for recurring APQC 13.2.2 participant; also referenced in 13.2.3.4.5 project reviews with program managers." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being responsible for establishing, executing, and reporting on a business program comprising related projects." .

bpot:ProgramPerformanceReport a owl:Class ;
    rdfs:label "Program Performance Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the evaluated performance of a business program against its goals, completion dates, defects, and cost-effectiveness." .

bpot:ProgramStructureSpecification a owl:Class ;
    rdfs:label "Program Structure Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the framework and approach for managing a business program, including governance, alignment, assurance, and management." .

bpot:ProjectLaunchPlan a owl:Class ;
    rdfs:label "Project Launch Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes when to initiate a project and how to introduce it to its target audience, including team, objectives, timelines, and milestones." .

bpot:ProjectManagementCapability a owl:Class ;
    rdfs:label "Project Management Capability" ;
    rdfs:comment "Standing-function reading of APQC 13.2.3 'Manage projects' (PCF 16410). No bpo:P16410 process is minted; the catalog node bpo:PCF_16410 designates this capability. Wired with obo:BFO_0000054 (realized in) to its constituent Activity acts bpo:P16411/bpo:P11119/bpo:P16413/bpo:P16414/bpo:P16417/bpo:P16418, mirroring the 13.1/13.5 capability pattern." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16411 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11119 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16413 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16414 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16417 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16418 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to scope, plan, execute, review, and close business projects, realized in its constituent acts." .

bpot:ProjectManagementImpactAssessment a owl:Class ;
    rdfs:label "Project Management Impact Assessment" ;
    rdfs:comment "Descriptive (an assessment/judgement of impact). Output of bpo:P11131 'Evaluate impact of project management on measures and outcomes'." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the assessed impact of project-management strategy and projects on the organization's measures and outcomes." .

bpot:ProjectManagementMethodologySelection a owl:Class ;
    rdfs:label "Project Management Methodology Selection" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the project-management methodology chosen for designing, planning, implementing, and achieving project objectives." .

bpot:ProjectManagerRole a owl:Class ;
    rdfs:label "Project Manager Role" ;
    rdfs:comment "Minted for recurring APQC 13.2.3 participant." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being responsible for scoping, planning, executing, reporting on, and closing a business project." .

bpot:ProjectPerformanceReport a owl:Class ;
    rdfs:label "Project Performance Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a project's performance against scope, schedule, quality, cost, and risk criteria, including deviations from plan." .

bpot:ProjectPortfolioSelection a owl:Class ;
    rdfs:label "Project Portfolio Selection" ;
    rdfs:comment "Directive (a selection/prioritization decision). Output of bpo:P21454 'Prioritize and select projects for the portfolio'." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which projects are selected and prioritized for the portfolio based on preestablished criteria." .

bpot:ProjectReadinessAssessment a owl:Class ;
    rdfs:label "Project Readiness Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the culture and readiness of an organizational environment for adopting a project-management approach." .

bpot:ProjectRequirementsStatement a owl:Class ;
    rdfs:label "Project Requirements Statement" ;
    rdfs:comment "FALSE FRIEND: despite the label 'Requirement', this is a DESCRIPTIVE (853) record of requirements gathered by a discernment act; the directive requirement itself (deliverables MUST satisfy X) is modeled separately. Parallel to the sibling outputs bpo:ProjectResourceRequirementsStatement (853, P16412) and bpo:ITRequirementsStatement (853, P11124). Output of bpo:P11117 'Identify project requirements and objectives'. Any directive force would be a separate downstream Directive ICE composed by a Formulation act -- mirroring how bpo:BusinessCase (P11120) stays descriptive and leaves the go/no-go as a separate Directive -- and is not modeled by this discernment act." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the discerned capabilities, features, and attributes a project's deliverables are required to have, as recognized and registered by a requirements-discernment act." .

bpot:ProjectResourceRequirementsStatement a owl:Class ;
    rdfs:label "Project Resource Requirements Statement" ;
    rdfs:comment "FALSE FRIEND: despite the label 'Requirement', this is a DESCRIPTIVE (853) record of requirements gathered by a discernment act; the directive requirement itself is modeled separately. An enumeration of identified resource prerequisites. Output of bpo:P16412 'Identify project resource requirements'." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the people, skills, capital, facilities, equipment, material, and information a project requires." .

bpot:ProjectReviewRecord a owl:Class ;
    rdfs:label "Project Review Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the findings and lessons learned from a post-project or after-action review." .

bpot:ProjectStatusReport a owl:Class ;
    rdfs:label "Project Status Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the current status of a project, including completed, incomplete, and planned tasks and problems faced." .

bpot:QualityControlSpecification a owl:Class ;
    rdfs:label "Quality Control Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the process steps, methods, and competencies for controlling enterprise quality." .

bpot:QualityImprovementActionDecision a owl:Class ;
    rdfs:label "Quality Improvement Action Decision" ;
    rdfs:comment "Directive: a decision selecting and committing to a subset of recommended actions. Minted so that 17490 (produces the recommendation) -> 17491 (decides which recommended actions to adopt, producing this decision) form a non-degenerate input->output chain, rather than 17491 emitting its own input." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which of the recommended quality-improvement actions the organization has decided to adopt." ;
    skos:example "Management's documented decision to adopt two of the four recommended control-limit changes next quarter." .

bpot:QualityPartnershipAgreement a owl:Class ;
    rdfs:label "Quality Partnership Agreement" ;
    rdfs:comment "Minted: directive artifact governing an established quality partnership (output of bpo:P17506)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the terms of a partnership with a third party formed to advance quality excellence." .

bpot:QualityStrategy a owl:Class ;
    rdfs:label "Quality Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an Organization's techniques, standards, responsibilities, and procedures for managing enterprise quality." .

bpot:QualityTestResultDisposition a owl:Class ;
    rdfs:label "Quality Test Result Disposition" ;
    rdfs:comment "Directive: a disposition decision prescribes a course of action on the tested item." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the action to take on a quality test result, such as quarantine, scrap, or rework." .

bpot:RecognitionAndRewardPlan a owl:Class ;
    rdfs:label "Recognition and Reward Plan" ;
    rdfs:comment "Shared across 13.2.3.3.5 and 13.4.2.6." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes incentives, bonuses, and recognition for extraordinary performance within a project or change initiative." .

bpot:RemedialActionSpecification a owl:Class ;
    rdfs:label "Remedial Action Specification" ;
    rdfs:comment "Shared between 13.7.11 'Identify remedial actions' and corrective-action work in 13.4.4.3." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the steps to be taken to correct identified shortcomings." .

bpot:RewardsAndIncentivesPlan a owl:Class ;
    rdfs:label "Rewards and Incentives Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the rewards and incentives for employees who exhibit the behavior desired by a change." .

bpot:RootCauseAnalysis rdfs:comment "Shared with 13.3.3.3; also relevant to risk/root-cause work in 13.4." ;
    skos:definition "A Descriptive Information Content Entity that describes the underlying causes that triggered a non-conformance event or activity." .

bpot:SampleSignificanceAssessment a owl:Class ;
    rdfs:label "Sample Significance Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes whether a test sample is representative of the larger output and meets acceptance requirements." .

bpot:SamplingPlan a owl:Class ;
    rdfs:label "Sampling Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which parameters to measure, sample sizes, the sampling scheme, and the roles for taking samples." .

bpot:StakeholderAssessment a owl:Class ;
    rdfs:label "Stakeholder Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the internal and external stakeholders affected by a change and the degree of influence the change has on them." .

bpot:SustainabilityGoalSpecification a owl:Class ;
    rdfs:label "Sustainability Goal Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an Organization's measurable sustainability goals and qualitative and quantitative targets." .

bpot:SustainabilityManagementCapability a owl:Class ;
    rdfs:label "Sustainability Management Capability" ;
    rdfs:comment "Standing-function reading of APQC 13.9 'Manage sustainability' (PCF 21588). Per R5 the 'Manage' group node is a standing function -> Organization Capability; the catalog node bpo:PCF_21588 designates this capability. Its two bounded process children (bpo:P21589 Develop sustainability capability, bpo:P21598 Manage sustainability capability) are wired as obo:BFO_0000054 (realized in) fillers, mirroring the 13.1/13.5 capability pattern (previously a hollow stub with no realized-in restrictions). No bpo:P21588 process is minted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21589 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21598 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to develop and manage its sustainability (ESG) practices, policies, requirements, and reporting, realized in its bounded sustainability acts." .

bpot:SustainabilityMeasureSpecification a owl:Class ;
    rdfs:label "Sustainability Measure Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes organization-wide sustainability measures, including data-collection strategies, calculations, analytics, and reporting formats." .

bpot:SustainabilityPlan a owl:Class ;
    rdfs:label "Sustainability Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the sustainability actions for an Organization, its functional units, and support services, aligned to requirements, goals, and governance." .

bpot:SustainabilityPolicy a owl:Class ;
    rdfs:label "Sustainability Policy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the written procedures and supporting tools by which an Organization will meet its sustainability requirements." .

bpot:TraineeRole a owl:Class ;
    rdfs:label "Trainee Role" ;
    rdfs:comment "Minted for the training-recipient participant of EHS training (13.8.3.5). Distinct from bpo:StakeholderRole (an interested/affected party): a trainee is the recipient of the imparted competence." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being a recipient of training -- the Agent to whom knowledge, skills, or values are imparted by an Act of Training." .

bpot:ActOfReporting rdfs:comment "Registry genus (D9) for DISSEMINATE-class reporting acts whose source makes sharing/reporting-to-an-audience definitional (vs COMPILE-class acts that merely create/record/summarize a report ICE, which stay at cco:ont00000366 Act of Information Processing). VERIFIED in vendored CCO: cco:ont00000151 'Act of Reporting' subClassOf cco:ont00000379 (Act of Representative Communication) subClassOf cco:ont00000402 (Act of Communication), def 'performed by giving a detailed account or statement'. Co-asserts cco:ont00000228 because 379 is outside the standalone-SHACL S2 process allowlist {366,636,511,228}." ;
    skos:definition "An Act of Representative Communication in which an Agent gives a detailed account or statement of some subject matter and shares it with a target audience." .

bpot:AnalyticsDataset a owl:Class ;
    rdfs:label "Analytics Dataset" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity consisting of structured and unstructured data gathered, cleaned, and converted to a uniform format for analysis." .

bpot:BestPracticesRegister a owl:Class ;
    rdfs:label "Best Practices Register" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the practices and procedures identified as most effective for the success of a business." .

bpot:ChangeAdoptionMeasureSpecification a owl:Class ;
    rdfs:label "Change Adoption Measure Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the measures and standards for assessing the adoption of a change." .

bpot:ChangeChampion a owl:Class ;
    rdfs:label "Change Champion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ChangeChampionRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a change-champion role." .

bpot:ChangeImpactAssessment a owl:Class ;
    rdfs:label "Change Impact Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes which groups and assets are impacted by a change and the degree of that impact." .

bpot:DataAnalysisResult a owl:Class ;
    rdfs:label "Data Analysis Result" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the patterns, trends, error rates, and outliers revealed by statistical analysis of data." .

bpot:DataModelReviewRecord a owl:Class ;
    rdfs:label "Data Model Review Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the outcome of reviewing data models with stakeholders against the original research question and hypothesis." .

bpot:EQMSScopeAndGoalSpecification a owl:Class ;
    rdfs:label "EQMS Scope and Goal Specification" ;
    rdfs:comment "Minted: distinct from the broader Quality Strategy; fixes the deployable EQMS scope/targets/goals (output of bpo:P17498/bpo:P17500)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the scope, targets, and goals of an enterprise quality management system." .

bpot:KMApproachEvaluation a owl:Class ;
    rdfs:label "KM Approach Evaluation" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an evaluation of existing knowledge-management procedures, policies, and guidelines against industry best practices." .

bpot:KMCapabilityMaturityAssessment a owl:Class ;
    rdfs:label "KM Capability Maturity Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the maturity level of existing knowledge-management initiatives." .

bpot:NonconformanceImpactAssessment a owl:Class ;
    rdfs:label "Nonconformance Impact Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the potential impact of a non-conformance event and the need for corrective or preventive action." .

bpot:P10270 a owl:Class ;
    rdfs:label "Establish performance indicators (measures)" ;
    rdfs:comment "Directive output (a specification of indicators), so anchored under bpo:ActOfFormulation per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceIndicatorSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that designs key performance measures and composes a performance indicator specification prescribing how effectively the business is achieving its objectives." ;
    skos:example "A team defines a set of KPIs and their formulas for the order-fulfillment process." ;
    bpot:apqcSourceText "Designing key measures that analyze and interpret how effectively the business is achieving its objectives." ;
    bpot:hierarchyID "13.6.3.1" ;
    bpot:pcfID "10270" .

bpot:P10271 a owl:Class ;
    rdfs:label "Establish monitoring frequency" ;
    rdfs:comment "Directive output (a prescription of monitoring cadence), so anchored under bpo:ActOfFormulation per the GOLDEN PRINCIPLE. Output ICE bpo:MonitoringFrequencySpecification is minted here (not in the shared list)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MonitoringFrequencySpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that decides and composes a monitoring frequency specification prescribing how often performance is to be supervised and assessed." ;
    skos:example "Governance decides KPIs will be reviewed monthly and the dashboard refreshed weekly." ;
    bpot:apqcSourceText "Deciding on the appropriate amount of supervisions that are needed to effectively assess the performance of business plans." ;
    bpot:hierarchyID "13.6.3.2" ;
    bpot:pcfID "10271" .

bpot:P10272 a owl:Class ;
    rdfs:label "Calculate performance measures" ;
    rdfs:comment "Anchored directly to cco:ont00000345 (Act of Measuring): it determines the quantity/extent of performance relative to a standard. Input is performance data; output is a Descriptive ICE (performance measurement)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceMeasurement ],
        cco:ont00000228,
        cco:ont00000345 ;
    skos:definition "An Act of Measuring that quantifies process performance against defined indicators and records the results as a performance measurement." ;
    skos:example "A scorecard calculates the period's KPI values from the collected data." ;
    bpot:apqcSourceText "Measuring the performance of process planning. Quantify the performance, record results of the performance tests, and report them to the appropriate authority." ;
    bpot:hierarchyID "13.6.3.4" ;
    bpot:pcfID "10272" .

bpot:P10273 a owl:Class ;
    rdfs:label "Identify performance trends" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (inlined): it processes measurement ICEs into a representation of trends (Descriptive ICE). Not bpo:ActOfIdentification because the emphasis is analytic trend-detection rather than enumeration." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceMeasurement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceTrendAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines performance measurements over time and produces a performance trend analysis representing the recognized trends." ;
    skos:example "An analyst plots twelve months of KPI data and identifies a declining-quality trend." ;
    bpot:apqcSourceText "Recognizing the trends in performance. Carefully and strategically assess the results in order to effectively spot the trends." ;
    bpot:hierarchyID "13.6.3.5" ;
    bpot:pcfID "10273" .

bpot:P10274 a owl:Class ;
    rdfs:label "Analyze performance" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfAnalysis to cco:ont00000636 (Act of Appraisal). The source verb is 'EVALUATING the gaps ... Analyze how performance differs', and its asserted output bpo:PerformanceAssessment is defined as 'describes a JUDGEMENT of performance' -- the product of appraisal, not generic information-processing analysis. This makes the genus agree with the judgement-bearing output (GOLDEN PRINCIPLE) and makes the row consistent with its siblings P11083 and P20147, which also produce bpo:PerformanceAssessment under cco:ont00000636. (If a purely analytic gap-quantification reading were wanted, a distinct descriptive bpo:PerformanceGapAnalysis ICE would be used under bpo:ActOfAnalysis; here the appraisal/judgement reading is adopted for sibling consistency.)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceMeasurement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the gaps between achieved and benchmarked or expected performance and produces a performance assessment of how performance differs from the optimum." ;
    skos:example "An analyst explains why the period's throughput fell short of the benchmark target." ;
    bpot:apqcSourceText "Evaluating the gaps between achieved and benchmarked performance. Analyze how performance differs from the optimal or expected performance." ;
    bpot:hierarchyID "13.6.3.6" ;
    bpot:pcfID "10274" .

bpot:P10275 a owl:Class ;
    rdfs:label "Prepare performance reports" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): input ICEs (measurements, trends, analyses) are manipulated and assembled into an output Descriptive ICE (performance report). COMPILE-class (kept at 366, not re-anchored to bpo:ActOfReporting): the source leads with 'Creating reports ... Construct a detailed report' -- composing the report ICE -- with no sharing-to-an-audience verb, so dissemination is not definitional." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceTrendAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceReport ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that assembles performance measurements, trends, and analyses into a performance report that systematically records and represents performance." ;
    skos:example "A reporting analyst compiles the quarterly performance report including gaps, trends, and commentary." ;
    bpot:apqcSourceText "Creating reports that systematically record and represent the performance planning. Construct a detailed report specifying the performance, and include indicators such as the performance gaps, performance trends, and analysis." ;
    bpot:hierarchyID "13.6.3.7" ;
    bpot:pcfID "10275" .

bpot:P10276 a owl:Class ;
    rdfs:label "Develop performance improvement plan" ;
    rdfs:comment "Directive output (a plan), so anchored under bpo:ActOfFormulation per the GOLDEN PRINCIPLE. Input is the performance assessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceImprovementPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that uses performance indicators and assessments to compose a performance improvement plan prescribing actions to bridge identified performance gaps." ;
    skos:example "After analyzing gaps, a team drafts a performance improvement plan with owners and milestones." ;
    bpot:apqcSourceText "Using performance indicators to report, analyze, and create a detailed performance improvement plan to bridge the performance gaps." ;
    bpot:hierarchyID "13.6.3.8" ;
    bpot:pcfID "10276" .

bpot:P11072 a owl:Class ;
    rdfs:label "Benchmark performance" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal) because benchmarking evaluates and judges performance relative to comparators. Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BenchmarkAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11083 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11084 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11085 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11087 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11088 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that compares an organization's performance internally or externally against other organizations and produces a benchmark analysis." ;
    skos:example "A benchmarking team compares the firm's order-cycle time against industry peers." ;
    bpot:apqcSourceText "Comparing organizational performance internally or externally with other organizations." ;
    bpot:hierarchyID "13.6.2" ;
    bpot:pcfID "11072" .

bpot:P11075 a owl:Class ;
    rdfs:label "Define enterprise measurement models" ;
    rdfs:comment "Directive output (a measurement model/system is prescriptive), so anchored under bpo:ActOfFormulation per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnterpriseMeasurementModel ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes an enterprise measurement model prescribing which processes to measure, which measures to use, how often to measure, and the measurement targets across an enterprise or business unit." ;
    skos:example "A measurement office defines a balanced-scorecard-style enterprise measurement model for a business unit." ;
    bpot:apqcSourceText "Developing a model for organization's management systems. Develop a high-level measurement system to track performance across the enterprise or in specific functions or business units. Determine which processes to measure, which measures to use, how often to measure, and measurement targets. Review strategic decisions about how to best measure an organization." ;
    bpot:hierarchyID "13.6.1.1" ;
    bpot:pcfID "11075" .

bpot:P11083 a owl:Class ;
    rdfs:label "Conduct performance assessments" ;
    rdfs:comment "Descriptive output (a recorded assessment), consistent with cco:ont00000636 (Act of Appraisal, a kind of Act of Measuring)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that measures, researches, and records the performance of people, processes, or other areas of a business and produces a performance assessment." ;
    skos:example "An analyst measures and records contact-center handle times to support a benchmarking study." ;
    bpot:apqcSourceText "Measuring, researching, and recording the performance of people, processes, mechanisms, or other areas of the business that the organization wants to benchmark or track." ;
    bpot:hierarchyID "13.6.2.1" ;
    bpot:pcfID "11083" .

bpot:P11084 a owl:Class ;
    rdfs:label "Develop benchmarking capabilities" ;
    rdfs:comment "Modeled as a bounded improvement act (bpo:ActOfImprovement), not as the capability itself: the standing capacity is the shared bpo:BenchmarkingCapability (an Organization Capability), which this act brings about / enhances. REMOVED the prior obo:BFO_0000055 (realizes) some bpo:BenchmarkingCapability restriction: 'realizes' means the act IS an exercise of that capability (capability realized IN the act), which would wrongly type this act as an instance of benchmarking. Developing/improving the benchmarking capability does NOT exercise benchmarking -- it produces/enhances the capability. The capability's own obo:BFO_0000054 (realized in) restrictions reference the genuine benchmarking acts (P21584, and the benchmarking appraisals P11083/P11085); this developing act is related to the capability descriptively here, not by a realizes axiom (a capability is not an ICE, so it is not asserted as a has-output either)." ;
    rdfs:subClassOf bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that enhances an organization's benchmarking capability by training staff, developing tools, and maintaining benchmarking relationships with other organizations." ;
    skos:example "A center of excellence trains analysts and procures a benchmarking platform, strengthening the firm's benchmarking capability." ;
    bpot:apqcSourceText "Improving an organization's ability to compare its performance internally or externally, and maintaining benchmarking relationships with other organizations. Train staff in benchmarking. Develop technological solutions or other materials to aid benchmarking efforts. Consult with external entities to gain knowledge or tools to help benchmark." ;
    bpot:hierarchyID "13.6.2.2" ;
    bpot:pcfID "11084" .

bpot:P11085 a owl:Class ;
    rdfs:label "Conduct internal and external benchmarking" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal); the comparison yields a Descriptive ICE (benchmark analysis)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BenchmarkAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that compares internal processes against one another and against external competitors and produces a benchmark analysis." ;
    skos:example "A team benchmarks the firm's procurement cycle both across plants and against a rival." ;
    bpot:apqcSourceText "Benchmarking internal processes and against external competitors." ;
    bpot:hierarchyID "13.6.2.3" ;
    bpot:pcfID "11085" .

bpot:P11087 a owl:Class ;
    rdfs:label "Conduct gap analysis" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (inlined): it processes benchmark inputs into a representation of the performance gap (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BenchmarkAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GapAndNeedsAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines performance against benchmarked organizations and produces a gap and needs analysis quantifying how much performance must change to meet expectations." ;
    skos:example "An analyst computes the percentage improvement in cycle time needed to match the benchmark leader." ;
    bpot:apqcSourceText "Examining performance against benchmarked organizations or entities. Determine how much performance needs to change to meet expectations. Reach strategic goals." ;
    bpot:hierarchyID "13.6.2.4" ;
    bpot:pcfID "11087" .

bpot:P11088 a owl:Class ;
    rdfs:label "Establish need for change" ;
    rdfs:comment "Directive output (a change-need statement prescribing what must change), so anchored under bpo:ActOfFormulation per the GOLDEN PRINCIPLE. Input is the gap and needs analysis." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GapAndNeedsAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeNeedStatement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that uses gap analysis results to compose a change need statement defining the required change in organizational performance." ;
    skos:example "Following a gap analysis, leadership issues a statement establishing the need to reduce defect rates by 30%." ;
    bpot:apqcSourceText "Establishing a need for changing the performance of the organization. Make use of the gap analysis results in order to define the need for change." ;
    bpot:hierarchyID "13.6.2.5" ;
    bpot:pcfID "11088" .

bpot:P11095 a owl:Class ;
    rdfs:label "Develop KM strategy" ;
    rdfs:comment "Models APQC 13.5.1 as an occurrent. Its APQC children are process parts, not subclasses. Output is a Directive ICE per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11100 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11102 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11103 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11104 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11105 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11106 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11107 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11108 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11109 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and articulates a KM strategy prescribing how an organization will capture, maintain, access, and exploit its collective knowledge." ;
    skos:example "A KM team drafts the enterprise knowledge-management strategy for the coming planning cycle." ;
    bpot:apqcSourceText "Creating a plan for managing the organization's knowledge base. Determine what kind of specialized knowledge the organization possesses, which elements of this collective knowledge can prove beneficial, how to capture and maintain this knowledge, how to grant access to this library of information, and how the organization should proceed." ;
    bpot:hierarchyID "13.5.1" ;
    bpot:pcfID "11095" .

bpot:P11096 a owl:Class ;
    rdfs:label "Assess KM capabilities" ;
    rdfs:comment "Models APQC 13.5.2 as an occurrent. Its APQC children are process parts, not subclasses. Output is a Descriptive ICE per the GOLDEN PRINCIPLE (appraisal)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMCapabilityMaturityAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11110 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11111 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11112 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the maturity and effectiveness of an organization's existing knowledge-management capabilities and produces a KM capability maturity assessment." ;
    skos:example "A KM review board appraises current KM maturity ahead of the next planning cycle." ;
    bpot:apqcSourceText "Assessing the maturity of the existing initiatives in knowledge management, and evaluating existing KM approaches. Identify the gaps and needs in order to enhance the existing KM approaches. Develop and implement new KM approaches." ;
    bpot:hierarchyID "13.5.2" ;
    bpot:pcfID "11096" .

bpot:P11100 a owl:Class ;
    rdfs:label "Develop governance model with roles and accountability" ;
    rdfs:comment "Output is a Directive ICE (governance model) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMGovernanceModel ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a KM governance model prescribing the structure, standard procedures, policies, and specialized roles for governing an organization's collective knowledge." ;
    skos:example "A KM lead defines a governance model assigning knowledge-stewardship roles and usage policies." ;
    bpot:apqcSourceText "Developing a structure for the governance of the organization's collective knowledge. Gather, maintain, and make accessible the collective knowledge base. Develop a standard procedure for the conservation and perpetuation of the organization's knowledge. Create policies for the usage and maintenance of this knowledge. Establish specialized roles." ;
    bpot:hierarchyID "13.5.1.1" ;
    bpot:pcfID "11100" .

bpot:P11102 a owl:Class ;
    rdfs:label "Define roles and accountability of core group versus operating units" ;
    rdfs:comment "Output is a Directive ICE (role-definition specification) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RoleDefinitionSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a role-definition specification prescribing the responsibilities of the KM core group versus the operating-unit staff who maintain the knowledge-management program." ;
    skos:example "A KM governance team documents the split of accountabilities between the central KM office and business-unit knowledge owners." ;
    bpot:apqcSourceText "Clearly determining the roles and responsibilities of all personnel involved in the management of the organization's corpus of knowledge. Flesh out the roles and responsibilities of the KM core group, as well as the operational staff involved in the upkeep of the knowledge management program." ;
    bpot:hierarchyID "13.5.1.2" ;
    bpot:pcfID "11102" .

bpot:P11103 a owl:Class ;
    rdfs:label "Develop funding models" ;
    rdfs:comment "Anchored to bpo:ActOfSelection (not Formulation) because the differentiating step is choosing among short-listed candidate funding models; its output is a Directive ICE (the selected funding model)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMFundingModel ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that, having evaluated candidate funding approaches against revenue potential and cost, chooses and prescribes the KM funding model(s) to implement." ;
    skos:example "A KM steering group short-lists three funding approaches and selects a chargeback model to adopt." ;
    bpot:apqcSourceText "Analyze the organization's current approach to funding. Learn from the funding approaches of peer organizations. Evaluate the revenue potential and costs of those short-list funding models. Select funding models to implement." ;
    bpot:hierarchyID "13.5.1.3" ;
    bpot:pcfID "11103" .

bpot:P11104 a owl:Class ;
    rdfs:label "Identify links to key initiatives" ;
    rdfs:comment "Output is a Descriptive ICE (a linkage analysis representing discovered correlations) per the GOLDEN PRINCIPLE (information processing / discernment)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMInitiativeLinkageAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the correlations between the KM strategy and other functional areas and produces a KM initiative linkage analysis registering them." ;
    skos:example "An analyst maps how the KM roadmap intersects with the data-governance and HR-learning programs." ;
    bpot:apqcSourceText "Identifying any links that exist between the strategy for knowledge management and any other functional areas. Determine any correlations that exist between the strategic road map for the knowledge management and any other functional areas. Study each function's/unit's attributes." ;
    bpot:hierarchyID "13.5.1.4" ;
    bpot:pcfID "11104" .

bpot:P11105 a owl:Class ;
    rdfs:label "Develop core KM methodologies" ;
    rdfs:comment "Output is a Directive ICE (methodology specification) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMMethodologySpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a KM methodology specification prescribing the core procedures for strategizing, planning, executing, and improving knowledge management." ;
    skos:example "A KM center of excellence documents the standard lifecycle methodology for knowledge projects." ;
    bpot:apqcSourceText "Creating core knowledge management procedures and methodologies. Initiate developing a strategy, planning, execution, and improvement." ;
    bpot:hierarchyID "13.5.1.5" ;
    bpot:pcfID "11105" .

bpot:P11106 a owl:Class ;
    rdfs:label "Assess IT needs and engage IT function" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal) because the differentiating step evaluates/judges technology requirements; output is a Descriptive ICE per the GOLDEN PRINCIPLE. Engaging the IT function is a typical (non-definitional) collaboration, recorded in this comment rather than as a restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ITNeedsAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the information-technology requirements for building and implementing the KM strategy and produces an IT needs assessment." ;
    skos:example "A KM architect assesses the hardware and platform requirements and briefs the IT function." ;
    bpot:apqcSourceText "Determining the IT needs for developing the knowledge management strategy, and collaborating with the IT function to implement the strategy. Assess requirements for technologies such as computer hardware, software, electronics, semiconductors, internet, and telecommunications equipment in order to effectively build and implement the strategy for knowledge management." ;
    bpot:hierarchyID "13.5.1.6" ;
    bpot:pcfID "11106" .

bpot:P11107 a owl:Class ;
    rdfs:label "Develop training and communication plans" ;
    rdfs:comment "Dual Directive ICE output (training plan and communication plan) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TrainingPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CommunicationPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a training plan and a communication plan prescribing how the KM strategy will be taught and conveyed across the organization." ;
    skos:example "A KM team drafts a rollout training curriculum and a stakeholder communication plan." ;
    bpot:apqcSourceText "Creating plans for KM training plans and conveying the knowledge management strategy within the organization. Create training programs, sessions, and activities in order to familiarize employees and management with the concept of knowledge management." ;
    bpot:hierarchyID "13.5.1.7" ;
    bpot:pcfID "11107" .

bpot:P11108 a owl:Class ;
    rdfs:label "Develop change management approaches" ;
    rdfs:comment "Output is a Directive ICE (change management plan) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeManagementPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a change management plan prescribing how individuals, teams, and the organization will be transitioned to the desired KM future state." ;
    skos:example "A change lead designs the adoption approach for a new knowledge-sharing platform." ;
    bpot:apqcSourceText "Creating approaches for effectively administering the changes in knowledge management. Design an approach that transforms individuals, teams, and the organization to a desired future state represented by the change." ;
    bpot:hierarchyID "13.5.1.8" ;
    bpot:pcfID "11108" .

bpot:P11109 a owl:Class ;
    rdfs:label "Develop strategic measures and indicators" ;
    rdfs:comment "Establishing measures/indicators yields a Directive ICE (a specification of indicators) per the GOLDEN PRINCIPLE; aligns with bpo:EstablishIPThreatMeasures in the GOLD slice (an Act of Planning producing a Directive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceIndicatorSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes and prescribes a performance-indicator specification of the key indicators used to evaluate the performance of the KM function." ;
    skos:example "A KM analyst defines KPIs such as knowledge assets created per quarter." ;
    bpot:apqcSourceText "Establishing measures and indicators for evaluating the performance of the knowledge management function. Define key performance indicators such as the amount of knowledge assets created and number of knowledge projects undertaken." ;
    bpot:hierarchyID "13.5.1.9" ;
    bpot:pcfID "11109" .

bpot:P11110 a owl:Class ;
    rdfs:label "Assess maturity of existing KM initiatives" ;
    rdfs:comment "Output is a Descriptive ICE per the GOLDEN PRINCIPLE (appraisal)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMCapabilityMaturityAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges the maturity of existing KM initiatives against a defined maturity scale and produces a KM capability maturity assessment." ;
    skos:example "An assessor rates each KM initiative from Level 1 to Level 5 on the maturity model." ;
    bpot:apqcSourceText "Evaluating if initiatives are effective or should be discarded. Design a framework for assessing maturity, typically from Level 1 (undefined), Level 2 (repeatable), Level 3 (defined), and Level 4 (managed) through Level 5 (optimized)." ;
    bpot:hierarchyID "13.5.2.1" ;
    bpot:pcfID "11110" .

bpot:P11111 a owl:Class ;
    rdfs:label "Evaluate existing KM approaches" ;
    rdfs:comment "Output is a Descriptive ICE per the GOLDEN PRINCIPLE (appraisal). Benchmarking/competitive analysis are typical methods, noted here rather than as restrictions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMApproachEvaluation ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the organization's existing KM procedures, policies, and guidelines against industry best practice and produces a KM approach evaluation." ;
    skos:example "A KM lead benchmarks current knowledge policies against sector best practice." ;
    bpot:apqcSourceText "Evaluating existing procedures, policies, and guidelines for knowledge management. Study and examine the organization's approach against industry best practices by benchmarking, competitive analysis, etc." ;
    bpot:hierarchyID "13.5.2.2" ;
    bpot:pcfID "11111" .

bpot:P11112 a owl:Class ;
    rdfs:label "Identify gaps and needs" ;
    rdfs:comment "Has as input the KM approach evaluation produced by 13.5.2.2; that input is definitional for this gap analysis, so promoted to a restriction (Phase 3). Output is a Descriptive ICE per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:KMApproachEvaluation ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GapAndNeedsAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that, from the KM approach evaluations, discerns the gaps between actual and desired KM performance and produces a gap-and-needs analysis registering them." ;
    skos:example "An analyst compares current KM performance against the target state and lists capability gaps." ;
    bpot:apqcSourceText "Assessing the KM approach evaluations in order to identify any gaps or needs. Compare the performance of the KM approach against the desired or expected performance, as well as against the standard knowledge management industry approach." ;
    bpot:hierarchyID "13.5.2.3" ;
    bpot:pcfID "11112" .

bpot:P11113 a owl:Class ;
    rdfs:label "Enhance/Modify existing KM approaches" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement (PROPOSE-EXT). Has as input the gap-and-needs analysis from 13.5.2.3; that input is definitional (the enhancement is driven by the identified gaps), so promoted to a restriction (Phase 3)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GapAndNeedsAnalysis ],
        bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that, leveraging KM approach evaluations and identified gaps, enhances or modifies existing KM approaches to raise their performance." ;
    skos:example "A KM team revises the knowledge-capture workflow to close gaps found in the last capability review." ;
    bpot:apqcSourceText "Leveraging KM evaluations and identified gap to enhance existing approaches." ;
    bpot:hierarchyID "13.5.4.1" ;
    bpot:pcfID "11113" .

bpot:P11114 a owl:Class ;
    rdfs:label "Develop new KM approaches" ;
    rdfs:comment "Output is a Directive ICE (methodology specification) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMMethodologySpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes new KM policies, procedures, and guidelines, prescribed as a KM methodology specification, to support knowledge management." ;
    skos:example "A KM designer drafts a new set of knowledge-capture guidelines." ;
    bpot:apqcSourceText "Designing new policies, procedures, and guidelines to support knowledge management." ;
    bpot:hierarchyID "13.5.3.1" ;
    bpot:pcfID "11114" .

bpot:P11115 a owl:Class ;
    rdfs:label "Implement new KM approaches" ;
    rdfs:comment "Has as input the directive KM methodology specification it operationalizes; that input is definitional, so promoted to a restriction (Phase 3). An implementation act realizes a directive rather than producing a new ICE, so no has-output restriction is asserted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:KMMethodologySpecification ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that puts into effect the new KM policies, procedures, and guidelines prescribed by the KM methodology specification." ;
    skos:example "A KM team rolls out the newly approved knowledge-capture procedures across the operating units." ;
    bpot:apqcSourceText "Implementing new policies, procedures, and guidelines to support knowledge management." ;
    bpot:hierarchyID "13.5.3.3" ;
    bpot:pcfID "11115" .

bpot:P11117 a owl:Class ;
    rdfs:label "Identify project requirements and objectives" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment, under cco:ont00000366), NOT the false-friend cco:ont00001261 'Act of Identifying' (a communication act) per §6. Per the GOLDEN PRINCIPLE (Analysis/Info-Processing -> Descriptive), the output bpo:ProjectRequirementsStatement is Descriptive: this act registers the discerned required capabilities/features, parallel to its siblings bpo:P16412 (-> bpo:ProjectResourceRequirementsStatement, 853) and bpo:P11124 (-> bpo:ITRequirementsStatement, 853). Any directive force (deliverables MUST satisfy X) would be a separate downstream Directive ICE composed by a Formulation act, not authored here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectRequirementsStatement ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns and defines what a project is to accomplish -- the capabilities, features, and attributes of its deliverables -- registering them in a project requirements statement." ;
    skos:example "A business analyst defines the required features of the project's deliverables." ;
    bpot:apqcSourceText "Recognizing and defining what the project is ultimately supposed to do. Specify the capabilities, features, or attributes of the project's deliverables, as well as any kind of formal documentation." ;
    bpot:hierarchyID "13.2.3.1.1" ;
    bpot:pcfID "11117" .

bpot:P11118 a owl:Class ;
    rdfs:label "Assess culture and readiness for project management approach" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges readiness; output is the Descriptive bpo:ProjectReadinessAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectReadinessAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the culture and readiness of an organizational environment for adopting a project-management approach and produces a project readiness assessment." ;
    skos:example "A PMO surveys readiness for agile adoption before launching a project." ;
    bpot:apqcSourceText "Evaluating the culture and readiness of the organizational environment is order to implement the project management approach." ;
    bpot:hierarchyID "13.2.3.1.3" ;
    bpot:pcfID "11118" .

bpot:P11119 a owl:Class ;
    rdfs:label "Identify appropriate project management methodologies" ;
    rdfs:comment "Anchored to bpo:ActOfSelection (reused): the differentiating step ('Identify the most appropriate models ... Examine and assess various ... methodologies') chooses one option from a candidate set, yielding a Directive ICE. Output bpo:ProjectManagementMethodologySelection is Directive (the producing act being a selection whose output prescribes the chosen methodology)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectManagementMethodologySelection ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that examines and chooses the most appropriate project-management methodology from candidate models and produces a project management methodology selection." ;
    skos:example "A PMO assesses agile vs feature-driven development and selects the methodology for the project." ;
    bpot:apqcSourceText "Identifying and implementing the techniques and procedures for managing business projects. Identify the most appropriate models, which are to be employed by the project managers for the purpose of designing, planning, implementing, and achieving project objectives. Examine and assess various project management methodologies such as adaptive project framework, agile development, crystal methods, and feature-driven development." ;
    bpot:hierarchyID "13.2.3.2" ;
    bpot:pcfID "11119" .

bpot:P11120 a owl:Class ;
    rdfs:label "Create business case" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (under cco:ont00000366): it assembles a reasoned justification (a Descriptive ICE) rather than prescribing a course of action. Output bpo:BusinessCase is correctly Descriptive (an argument/justification representing a situation); the go/no-go approval it supports is a separate Directive decision, not modeled here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessCase ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the current situation, proposed solution, and financial analysis and produces a business case justifying the project to decision makers." ;
    skos:example "A sponsor writes the business case making the financial argument to fund the project." ;
    bpot:apqcSourceText "Creating a document that includes the current situation, proposed solution, financial analysis, conclusion, etc. Convince a decision maker and investors to approve the project. Obtain funding." ;
    bpot:hierarchyID "13.2.3.1.4" ;
    bpot:pcfID "11120" .

bpot:P11121 a owl:Class ;
    rdfs:label "Develop project measures and indicators" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: designing measures yields a Directive ICE (the shared bpo:PerformanceIndicatorSpecification, whose comment lists 13.2.3.1.5 as a consumer)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceIndicatorSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that designs and prescribes the metrics and indicators -- cost, schedule, resources, risk, and quality -- used to assess project performance, producing a performance indicator specification." ;
    skos:example "A project manager defines the cost, schedule, and quality KPIs for the project." ;
    bpot:apqcSourceText "Developing procedures and indictors to assess performance of business projects. Design and develop metrics and indicators--such as cost, schedule, resources, risk, and quality--that exhibit the performance of the business projects." ;
    bpot:hierarchyID "13.2.3.1.5" ;
    bpot:pcfID "11121" .

bpot:P11123 a owl:Class ;
    rdfs:label "Define roles and resources" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: outlining roles/resources yields a Directive ICE (the shared bpo:RoleDefinitionSpecification)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RoleDefinitionSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines and assigns the roles and resources of a business project, producing a role definition specification." ;
    skos:example "A project manager documents who fills each project role and the resources assigned." ;
    bpot:apqcSourceText "Outlining the resources and their roles in the business projects." ;
    bpot:hierarchyID "13.2.3.3.1" ;
    bpot:pcfID "11123" .

bpot:P11124 a owl:Class ;
    rdfs:label "Identify specific IT requirements" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment), NOT cco:ont00001261. Output is the Descriptive bpo:ITRequirementsStatement (an enumeration of discerned requirements), agreeing with the information-processing genus per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ITRequirementsStatement ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the information-technology requirements of a specific business project and registers them in an IT requirements statement." ;
    skos:example "A project's IT lead lists the hardware and telecom requirements for the project." ;
    bpot:apqcSourceText "Determining the IT requirements for specific business projects. Identify the requirements of computers and telecommunications equipment to store, retrieve, transmit, and manipulate data related to the project. Consider factors such as functional requirements, design requirements, project phases, and project schedule." ;
    bpot:hierarchyID "13.2.3.3.3" ;
    bpot:pcfID "11124" .

bpot:P11125 a owl:Class ;
    rdfs:label "Create training and communication plans" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: dual Directive ICE output (training plan and communication plan)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TrainingPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CommunicationPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a training plan and a communication plan for equipping the project team with the necessary skills and for communicating during the project." ;
    skos:example "A project manager drafts the team training curriculum and the project communication plan." ;
    bpot:apqcSourceText "Designing a plan for equipping the project team with the necessary skills and abilities to fulfill their roles and responsibilities in the project effectively and efficiently. Offer formal training, mentoring, or coaching. Initiate informal conversations. Communicate messages during the project." ;
    bpot:hierarchyID "13.2.3.3.4" ;
    bpot:pcfID "11125" .

bpot:P11127 a owl:Class ;
    rdfs:label "Design recognition and reward approaches" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (the shared bpo:RecognitionAndRewardPlan) is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RecognitionAndRewardPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a recognition and reward plan prescribing the incentives, bonuses, and recognition for extraordinary performance within a project." ;
    skos:example "A project manager designs a bonus-and-certificate scheme for outstanding project work." ;
    bpot:apqcSourceText "Creating a plan for recognizing and rewarding extraordinary performances within the business projects. Use incentives, bonuses, and certificates for recognition and rewarding purposes." ;
    bpot:hierarchyID "13.2.3.3.5" ;
    bpot:pcfID "11127" .

bpot:P11128 a owl:Class ;
    rdfs:label "Design and plan launch of project" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (project launch plan) is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectLaunchPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a project launch plan prescribing when to initiate the project and how to introduce it to its target audience, including team, objectives, timelines, and milestones." ;
    skos:example "A project manager plans the kickoff timing, audience, and milestones for the launch." ;
    bpot:apqcSourceText "Creating a plan specifying when to initiate the project, and introducing it to the target audience. Clearly define the project team, objectives, timelines, and milestone." ;
    bpot:hierarchyID "13.2.3.3.6" ;
    bpot:pcfID "11128" .

bpot:P11129 a owl:Class ;
    rdfs:label "Deploy the project" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228): deployment enacts the project plan rather than producing an ICE." ;
    rdfs:subClassOf bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that puts a business project into position and brings it into action per its project plan." ;
    skos:example "A project manager mobilizes the team and kicks off project execution." ;
    bpot:apqcSourceText "Putting the project into position by effectively bringing it into action." ;
    bpot:hierarchyID "13.2.3.3.7" ;
    bpot:pcfID "11129" .

bpot:P11131 a owl:Class ;
    rdfs:label "Evaluate impact of project management (strategy and projects) on measures and outcomes" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges impact; output is the Descriptive bpo:ProjectManagementImpactAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectManagementImpactAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the impact of project-management strategy and projects on the organization's measures and outcomes and produces a project management impact assessment." ;
    skos:example "A PMO assesses how the chosen PM approach affected delivery outcomes." ;
    bpot:apqcSourceText "Assessing the impact of business project management on the measures and outcomes of the projects. Gauge non-financial measures, frequency of measurement, action plan, etc." ;
    bpot:hierarchyID "13.2.3.4.1" ;
    bpot:pcfID "11131" .

bpot:P11132 a owl:Class ;
    rdfs:label "Promote and sustain activity and involvement" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228): enacting the engagement/promotion activities that keep the project moving; no single definitional ICE output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that encourages and sustains the execution activities and employee involvement during project implementation." ;
    skos:example "A project lead runs engagement activities to keep the team involved through delivery." ;
    bpot:apqcSourceText "Encouraging and sustaining the activities and involvement while executing projects. Promote the execution activities of the projects. Encourage employee involvement in project implementation." ;
    bpot:hierarchyID "13.2.3.4.4" ;
    bpot:pcfID "11132" .

bpot:P11133 a owl:Class ;
    rdfs:label "Realign and refresh project management strategy and approaches" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement (under cco:ont00000228): it modifies the existing PM approach/strategy toward better performance. The project management impact assessment from 11131 is a typical driving input, noted here." ;
    rdfs:subClassOf bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that reorganizes and refreshes an organization's project-management strategy and approaches based on impact findings to raise their effectiveness." ;
    skos:example "A PMO revises its delivery methodology based on the impact assessment findings." ;
    bpot:apqcSourceText "Reorganizing and stimulating the approach and strategy for managing business projects. Make improvements based on the project scope and on findings from Evaluate the impact of project management (strategy and projects) on measures and outcomes [11131]." ;
    bpot:hierarchyID "13.2.3.4.6" ;
    bpot:pcfID "11133" .

bpot:P11135 a owl:Class ;
    rdfs:label "Design the change" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning): its definitional outputs are Directive ICEs (plans/specs). APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11152 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11153 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11154 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11155 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20145 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11156 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11157 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11158 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11159 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that develops the change management, training, communication, and rewards plans, the adoption metrics, and the new-role definitions that together design how a change will be enacted." ;
    skos:example "The team produces the suite of plans and metrics that constitute the change design." ;
    bpot:apqcSourceText "Developing plans for change management, training, communication, and rewards/incentives. Establish metrics for measuring the change adoption. Clarify new roles for employees. Identify budgets." ;
    bpot:hierarchyID "13.4.2" ;
    bpot:pcfID "11135" .

bpot:P11136 a owl:Class ;
    rdfs:label "Implement change" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228 Planned Act): it executes the change design rather than producing a plan. APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11160 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11161 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11162 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11163 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20146 ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that effectuates a designed change within the targeted areas of the organization by building commitment, reengineering processes, supporting transitions, and observing progress." ;
    skos:example "The organization rolls out the redesigned processes and support structures for the change." ;
    bpot:apqcSourceText "Effectuating the change within the desired impact areas of the organization. Ensure adequate commitment from all corners of the organization for the desired change. Create support structures. Refashion all processes deemed necessary. Observe the progress." ;
    bpot:hierarchyID "13.4.3" ;
    bpot:pcfID "11136" .

bpot:P11137 a owl:Class ;
    rdfs:label "Sustain improvement" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement (under cco:ont00000228 Planned Act): it adjusts and reinforces the changed processes toward continually better performance. APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11164 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11165 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11166 ],
        bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that sustains the impact of a change by monitoring re-engineered process performance, capturing lessons, and effecting remedial steps for continual improvement." ;
    skos:example "After go-live the team tracks the new process, captures lessons, and applies fixes." ;
    bpot:apqcSourceText "Sustaining the impact of the change process in order to enact continual process improvement. Monitor the performance of re-engineered business processes. Identify best practices and potential issues. Effectuate remedial steps." ;
    bpot:hierarchyID "13.4.4" ;
    bpot:pcfID "11137" .

bpot:P11138 a owl:Class ;
    rdfs:label "Select process improvement methodology" ;
    rdfs:comment "Anchored to bpo:ActOfSelection: it chooses one option from a candidate set (Lean, Six Sigma, SPC, simulation) and yields a Directive ICE recording the choice." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessImprovementMethodologySelection ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses the most appropriate process-improvement methodology from available candidates and produces a process improvement methodology selection." ;
    skos:example "A black belt selects Six Sigma over process mapping for a defect-reduction effort." ;
    bpot:apqcSourceText "Assessing and choosing methodologies to identify, analyze, and improve existing processes within an organization to meet new goals and objective. Assess the various methodologies available such as process mapping, statistical process control, and simulation. Choose the most appropriate and effective methodology." ;
    bpot:hierarchyID "13.1.5.2" ;
    bpot:pcfID "11138" .

bpot:P11139 a owl:Class ;
    rdfs:label "Assess readiness for change" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges the level of preparedness; output is a Descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeReadinessAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the preparedness of an organization's conditions, attitudes, and resources for a change and produces a change readiness assessment." ;
    skos:example "A readiness survey across business units yields a change readiness assessment." ;
    bpot:apqcSourceText "Determining the level of preparedness of the conditions, attitudes, and resources at all levels in the organization needed for change to happen successfully. Define scope of the proposed change. Select the tools for a change readiness assessment." ;
    bpot:hierarchyID "13.4.1.2" ;
    bpot:pcfID "11139" .

bpot:P11140 a owl:Class ;
    rdfs:label "Determine stakeholders" ;
    rdfs:comment "Act of Identification (discernment): the definitional product is the Descriptive bpo:StakeholderAssessment registering the discerned stakeholders and their influence; the stakeholders themselves are continuant participants (has-agent), not the output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StakeholderAssessment ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the internal and external stakeholders affected by a change and produces a stakeholder assessment registering them and their influence." ;
    skos:example "A change team enumerates affected departments and external parties and rates their influence." ;
    bpot:apqcSourceText "Identifying and communicating with shareholders affected by the change. Consider internal and external stakeholders that will be affected by the change. Determine the amount of influence the change will have on them. Ensure the involvement of these stakeholders in the change process by effectively communicating with them." ;
    bpot:hierarchyID "13.4.1.1" ;
    bpot:pcfID "11140" .

bpot:P11141 a owl:Class ;
    rdfs:label "Identify change champion(s)" ;
    rdfs:comment "Output is a set of identified Agents (the champions), not an Information Content Entity, so no has-output restriction is asserted (Phase-3). Champion-role definition occurs in 13.4.2.8 / 13.4.2.5." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ChangeChampion ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the individuals who exhibit exceptional commitment to the success of a change and are to act as its champions." ;
    skos:example "Each division nominates an enthusiastic advocate to serve as its change champion." ;
    bpot:apqcSourceText "Identifying people exhibit an extraordinary interest in the adoption, implementation, and success of the change. Engage champions in each division or team. Define the roles and responsibilities for the change champions. Determine criteria for selecting change champions. Provide training sessions to champions. Reward and recognize champions." ;
    bpot:hierarchyID "13.4.1.3" ;
    bpot:pcfID "11141" .

bpot:P11142 a owl:Class ;
    rdfs:label "Form design team" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): forming a team is an organizational act that produces neither an analysis (Descriptive ICE) nor a plan (Directive ICE); no shared act genus fits, so the generic Planned Act is used." ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act in which an Agent assembles a team tasked with designing and implementing a change throughout the organization." ;
    skos:example "A sponsor convenes a cross-functional design team for the transformation." ;
    bpot:apqcSourceText "Preparing a design team for implementing change throughout the organization." ;
    bpot:hierarchyID "13.4.1.4" ;
    bpot:pcfID "11142" .

bpot:P11143 a owl:Class ;
    rdfs:label "Define scope" ;
    rdfs:comment "Reuses bpo:ProcessScopeStatement (Directive ICE) as the scope-defining output of the change effort." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessScopeStatement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that delimits and prescribes the extent of the area and subject matter that a change process addresses, producing a process scope statement." ;
    skos:example "The team documents which functions, locations, and systems fall inside the change." ;
    bpot:apqcSourceText "Defining the extent of the area or subject matter that the change process deals with or to which it is relevant. Establish a set of tools, processes, skills, and principles for managing the people side of change to achieve the required outcomes of the change process." ;
    bpot:hierarchyID "13.4.1.5" ;
    bpot:pcfID "11143" .

bpot:P11144 a owl:Class ;
    rdfs:label "Understand current state" ;
    rdfs:comment "Act of Analysis: characterizing the as-is baseline yields a Descriptive bpo:CurrentStateAssessment of how things presently are; the prescribed target is the separate Formulation act 13.4.1.7 (bpo:FutureStateSpecification)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CurrentStateAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the organization's as-is processes and conditions using graphical and statistical tools and produces a current state assessment." ;
    skos:example "Analysts chart current process flows and defect Pareto diagrams to characterize the baseline." ;
    bpot:apqcSourceText "Using graphical and statistical tools such as pareto diagrams, process flow diagrams, cause-and-effect diagrams, check sheets, histograms, run charts, and scatter diagrams." ;
    bpot:hierarchyID "13.4.1.6" ;
    bpot:pcfID "11144" .

bpot:P11145 a owl:Class ;
    rdfs:label "Define future state" ;
    rdfs:comment "Reuses bpo:FutureStateSpecification (Directive ICE): the future state is a prescribed target, not a description of present reality." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FutureStateSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that prescribes the target state the organization intends to reach after a change, producing a future state specification." ;
    skos:example "Leadership specifies the desired post-change operating model and its resource requirements." ;
    bpot:apqcSourceText "Determining the state or position that the organization wants to be in after the implementation of the change. Gather necessary information about the processes, structures, and cultures. Define resource requirements." ;
    bpot:hierarchyID "13.4.1.7" ;
    bpot:pcfID "11145" .

bpot:P11146 a owl:Class ;
    rdfs:label "Conduct organizational risk analysis" ;
    rdfs:comment "Act of Analysis: weighing asset threats by probability and consequence yields a Descriptive bpo:OrganizationalRiskAnalysis (an explanatory account of exposure), not a directive risk-treatment plan." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalRiskAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines threats to the organization's critical assets in light of their probability and consequence and produces an organizational risk analysis." ;
    skos:example "A risk team scores asset threats by likelihood and impact for the change." ;
    bpot:apqcSourceText "Looking beyond the immediate consequences of the threat to a critical asset and placing it in the context of what is important to the organization. Identify the impact of threats to critical assets. Create risk evaluation criteria. Evaluate the impact of threats to critical assets. Incorporate probability into the risk analysis." ;
    bpot:hierarchyID "13.4.1.8" ;
    bpot:pcfID "11146" .

bpot:P11147 a owl:Class ;
    rdfs:label "Assess cultural context" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges the state of organizational culture; output is a Descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CulturalContextAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the organization's culture along multiple dimensions and produces a cultural context assessment." ;
    skos:example "A culture survey produces a multidimensional assessment of organizational values." ;
    bpot:apqcSourceText "Evaluating the culture within the organization. Adopt a quantitative, multidimensional measurement approach of an organization's culture and the aspirations for it. Diagnose cultural activities, enhance leadership sections. Integrate cultures." ;
    bpot:hierarchyID "13.4.1.9" ;
    bpot:pcfID "11147" .

bpot:P11148 a owl:Class ;
    rdfs:label "Establish accountability for change management" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfFormulation to cco:ont00000228 (Planned Act). Source text -- 'Identifying and ASSIGNING the people accountable ... Hold managers accountable ... behaviors are rewarded or reprimanded' -- is a deontic role-assignment / organizational act of assigning accountability to specific persons, NOT the composition of a generic directive plan (Formulation). It parallels the other organizational-assignment Planned Acts P11142 'Form design team' and P20145 'Assign change champions'. DROPPED the has-output bpo:RoleDefinitionSpecification restriction: that role spec is properly the output of P11158 'Establish/Clarify new roles', and reusing it here both over-committed to Formulation and double-claimed P11158's output. The assigned bpo:ChangeManager is the salient participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ChangeManager ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that identifies and assigns accountability for managing a change to specific persons, holding them responsible for ensuring the change happens systematically." ;
    skos:example "Each manager is formally made accountable for delivering the change in their unit." ;
    bpot:apqcSourceText "Identifying and assigning the people accountable for effective change management. Hold managers accountable for ensuring change happens systematically and rigorously. Ensure that certain behaviors are rewarded or reprimanded accordingly." ;
    bpot:hierarchyID "13.4.1.12" ;
    bpot:pcfID "11148" .

bpot:P11149 a owl:Class ;
    rdfs:label "Identify barriers to change" ;
    rdfs:comment "Act of Identification (discernment): recognizing obstacles and resistance registers them in the Descriptive bpo:ChangeBarrierAnalysis; choosing how to overcome them is modeled by downstream Formulation/Selection acts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeBarrierAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the obstacles and sources of resistance impeding a change and registers them in a change barrier analysis." ;
    skos:example "The team catalogs integration, resistance, and complexity obstacles to the change." ;
    bpot:apqcSourceText "Recognizing the circumstances or obstacles that keep the organization from progressing. Identify who and what are the resources resisting change. Identify integration failures, threats by competitive forces, and complexity failures." ;
    bpot:hierarchyID "13.4.1.13" ;
    bpot:pcfID "11149" .

bpot:P11150 a owl:Class ;
    rdfs:label "Determine change enablers" ;
    rdfs:comment "Output is the set of identified enabling entities/factors, not a single shared Information Content Entity, so no has-output restriction is asserted (Phase-3); the enabler register is typical, not definitional." ;
    rdfs:subClassOf bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the persons and factors that make a change possible." ;
    skos:example "The team names the integrators and conditions that will enable the change to succeed." ;
    bpot:apqcSourceText "Identifying the person(s) or thing(s)responsible for making the change possible. Consider factors such as interdependence of efforts, reward to the integrators, sharing of power and responsibility, and employee understanding of why change is essential." ;
    bpot:hierarchyID "13.4.1.14" ;
    bpot:pcfID "11150" .

bpot:P11151 a owl:Class ;
    rdfs:label "Identify resources and develop measures" ;
    rdfs:comment "Reuses bpo:ChangeAdoptionMeasureSpecification (Directive ICE) for the developed measures/programs; resource identification is a typical sub-step recorded here in comment, not a separate output restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeAdoptionMeasureSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that, having identified the resources a change requires, develops the measures and programs prescribed to establish the change, producing a change adoption measure specification." ;
    skos:example "The team budgets the resources and designs adoption campaigns for the change." ;
    bpot:apqcSourceText "Recognizing the resource requirements, and developing measures for change. Identify the financial, material, human, and informational resources needed to successfully implement the change. Develop programs, campaigns, etc. for establishing the change within the organization." ;
    bpot:hierarchyID "13.4.1.15" ;
    bpot:pcfID "11151" .

bpot:P11152 a owl:Class ;
    rdfs:label "Assess connection to other initiatives" ;
    rdfs:comment "No shared output ICE for the alignment finding; the alignment representation is typical rather than definitional, so no has-output restriction is asserted (Phase-3)." ;
    rdfs:subClassOf bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines how a change initiative correlates with the organization's other initiatives and characterizes their alignment." ;
    skos:example "The team maps the change's goals against concurrent programs to find overlaps and conflicts." ;
    bpot:apqcSourceText "Correlating the change initiative with the other initiatives. Create an alignment between the goals and objectives of the change process and that of the other initiatives." ;
    bpot:hierarchyID "13.4.2.1" ;
    bpot:pcfID "11152" .

bpot:P11153 a owl:Class ;
    rdfs:label "Develop change management plans" ;
    rdfs:comment "Act of Formulation: composing the bpo:ChangeManagementPlan yields a Directive ICE prescribing how the change is to be managed (rationale, type, scope); enacting it is downstream implementation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeManagementPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a detailed change management plan structuring how a change will be managed." ;
    skos:example "The team drafts the master change management plan covering rationale, type, and scope." ;
    bpot:apqcSourceText "Creating a detailed structure summary for the purposes of managing the change. Demonstrate the reasons for the change. Define the type and scope of change. Form a change management team. Create a communication plan." ;
    bpot:hierarchyID "13.4.2.2" ;
    bpot:pcfID "11153" .

bpot:P11154 a owl:Class ;
    rdfs:label "Develop training plan" ;
    rdfs:comment "Act of Formulation: composing the shared Directive bpo:TrainingPlan prescribes how training is to be delivered; conducting the training itself is the separate Act of Training (cf. bpo:P17507)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TrainingPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a training plan prescribing the actions, delivery, timing, and location for teaching the skills a change requires." ;
    skos:example "The team specifies the courses, trainers, and schedule to equip staff for the change." ;
    bpot:apqcSourceText "Creating a detailed summary of all the actions relevant to teaching a person a particular skill or type of behavior. Determine who will deliver the training. Determine when and where the apprentice or trainee needs to go to receive the structured component of the training." ;
    bpot:hierarchyID "13.4.2.3" ;
    bpot:pcfID "11154" .

bpot:P11155 a owl:Class ;
    rdfs:label "Develop communication plan" ;
    rdfs:comment "Act of Formulation: composing the shared Directive bpo:CommunicationPlan prescribes the goals, audiences, and channels for change communication; the act of actually communicating is a separate reporting/communication act." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CommunicationPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a communication plan prescribing the goals, audiences, and channels for imparting information about a change." ;
    skos:example "The team plans the announcements, channels, and cadence for the change rollout." ;
    bpot:apqcSourceText "Developing a plan for imparting or exchanging information relevant the to change. Define goals, objectives, and audience. Gather tools for all communications." ;
    bpot:hierarchyID "13.4.2.4" ;
    bpot:pcfID "11155" .

bpot:P11156 a owl:Class ;
    rdfs:label "Develop rewards/incentives plan" ;
    rdfs:comment "Act of Formulation: composing the Directive bpo:RewardsAndIncentivesPlan prescribes how desired change behaviors are to be rewarded; granting the rewards is a separate enactment act (cf. bpo:P17505)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RewardsAndIncentivesPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a rewards and incentives plan prescribing how employees who exhibit the desired change behaviors are to be rewarded." ;
    skos:example "The team designs a bonus-and-recognition scheme for early adopters of the change." ;
    bpot:apqcSourceText "Creating and designing the plan for rewarding the employees exhibiting the desired behavior. Specify rewards in recognition of service, effort, or achievement regarding the change, including bonuses, compensation, stock options, profit sharing, vacations, and flexible time." ;
    bpot:hierarchyID "13.4.2.6" ;
    bpot:pcfID "11156" .

bpot:P11157 a owl:Class ;
    rdfs:label "Establish change adoption measures" ;
    rdfs:comment "Act of Formulation: establishing adoption metrics composes the Directive bpo:ChangeAdoptionMeasureSpecification (a prescription of what to measure and how); the adoption data later gathered against it is a separate Descriptive record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeAdoptionMeasureSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes the standards of measurement for tracking change adoption, producing a change adoption measure specification." ;
    skos:example "The team defines adoption-rate and unique-adopter metrics for the change." ;
    bpot:apqcSourceText "Establishing a system or standard of measurement for measuring the adoption of the change. Consider activities such as the number of people who have adopted the change, how quickly have they adopted, number of unique adopters, and adopters by teams/divisions." ;
    bpot:hierarchyID "13.4.2.7" ;
    bpot:pcfID "11157" .

bpot:P11158 a owl:Class ;
    rdfs:label "Establish/Clarify new roles" ;
    rdfs:comment "Act of Formulation: defining the new roles composes the Directive bpo:RoleDefinitionSpecification; this is the rightful home of that output (P11148 'Establish accountability' was de-coupled from it and re-anchored to a Planned Act, per the comment there)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RoleDefinitionSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines and assigns the new roles and responsibilities a change introduces, producing a role definition specification." ;
    skos:example "The team documents and explains each employee's role under the new operating model." ;
    bpot:apqcSourceText "Establishing and explaining the new roles to employees. Assign roles and responsibilities to resources." ;
    bpot:hierarchyID "13.4.2.8" ;
    bpot:pcfID "11158" .

bpot:P11159 a owl:Class ;
    rdfs:label "Identify budget/roles" ;
    rdfs:comment "Output is a budget/financing plan (a Directive ICE). No shared budget ICE exists in the section vocabulary, so the output is recorded in comment rather than promoted to a has-output restriction (Phase-3)." ;
    rdfs:subClassOf bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a plan of financial outlay funding the newly defined roles required by a change." ;
    skos:example "Finance and change leads set the capital and ROI assumptions for the new roles." ;
    bpot:apqcSourceText "Creating a plan of financial outlay for the newly defined roles. Determine the amount of capital the organization is willing to invest in effectuating these new roles, how would the roles be financed, and what would comprise the ROI from these flows. Coordinate personnel responsible for change management and the finance division." ;
    bpot:hierarchyID "13.4.2.9" ;
    bpot:pcfID "11159" .

bpot:P11160 a owl:Class ;
    rdfs:label "Create commitment for improvement/change" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): building commitment is a mobilization/communication act with no single definitional Information Content Entity output." ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act in which an Agent mobilizes organization-wide commitment to a change by communicating and personalizing its advantages." ;
    skos:example "Leaders run a campaign making the case for the change to every team." ;
    bpot:apqcSourceText "Kindling an organization wide commitment for effectuating the change. Effectively communicate the advantages of the desired change. Personalize the pitch for change." ;
    bpot:hierarchyID "13.4.3.1" ;
    bpot:pcfID "11160" .

bpot:P11161 a owl:Class ;
    rdfs:label "Reengineer business processes and systems" ;
    rdfs:comment "Builds on the methodology selected in 13.1.5.2 (PCF 11138). Reengineering existing processes to bring about the change is implementation; no single definitional ICE output." ;
    rdfs:subClassOf bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that restructures and redesigns existing business processes and systems in order to effectuate the desired change." ;
    skos:example "The team rebuilds the order-to-cash process from the desired outcome backward." ;
    bpot:apqcSourceText "Restructuring, redesigning, repurposing, and/or retrofitting existing business processes, activities, and frameworks in order to effectuate the desired change. Review pertinent processes from the ground up by starting with the desired result. (Build on Select a process improvement methodology [11138] to create business processes that perfectly fit with the road map for change.)" ;
    bpot:hierarchyID "13.4.3.2" ;
    bpot:pcfID "11161" .

bpot:P11162 a owl:Class ;
    rdfs:label "Support transition to new roles or exit strategies for incumbents" ;
    rdfs:comment "Implementation support act; onboarding and discharge procedures are operational sub-steps, not a single definitional Information Content Entity output." ;
    rdfs:subClassOf bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that supports personnel through their transition to new roles and, where necessary, through structured exit from current positions during a change." ;
    skos:example "HR onboards staff into new roles and manages structured exits for redundant positions." ;
    bpot:apqcSourceText "Supporting the transition of personnel to new roles and the dismissal of any existing employees, necessitated for the desired change. Create an on-boarding process for seamlessly transitioning personnel to new roles. Offer orientation and training. Address any concerns. Create a structured procedure for the discharge of incumbents from their positions." ;
    bpot:hierarchyID "13.4.3.3" ;
    bpot:pcfID "11162" .

bpot:P11163 a owl:Class ;
    rdfs:label "Monitor change" ;
    rdfs:comment "Reuses bpo:ActOfMonitoring. The tracked observations are recorded across heterogeneous channels (pace, impact, feedback); no single shared output ICE is definitional, so none is asserted (Phase-3)." ;
    rdfs:subClassOf bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that observes and tracks the activities, pace, and reception of a change in progress in order to register the performance of the agents and of the change process as a whole." ;
    skos:example "A change office tracks adoption pace and sentiment week by week during rollout." ;
    bpot:apqcSourceText "Monitoring activities in the change process in order to assess the performance of individual agents and the process as a whole. Oversee the implementation of activities needed for effectuating the change. Track the pace, impact, enthusiasm, reaction, and feedback over the change process." ;
    bpot:hierarchyID "13.4.3.4" ;
    bpot:pcfID "11163" .

bpot:P11164 a owl:Class ;
    rdfs:label "Monitor improved process performance" ;
    rdfs:comment "Reuses bpo:ActOfMonitoring and bpo:ProcessPerformanceReport (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessPerformanceReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that tracks the key performance indicators of improved business processes and produces a process performance report gauging their contribution to the change." ;
    skos:example "BPM dashboards track the upgraded process KPIs against targets." ;
    bpot:apqcSourceText "Monitoring the performance of improved business processes. Track the key performance indicators of the upgraded processes in order to gauge its contribution to the desired change. Expedite through the use of business process management software." ;
    bpot:hierarchyID "13.4.4.1" ;
    bpot:pcfID "11164" .

bpot:P11165 a owl:Class ;
    rdfs:label "Capture and reuse lessons learned from change process" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (under cco:ont00000366 Act of Information Processing): it studies the completed change and produces a Descriptive ICE (the lessons-learned record / best-practices guide)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LessonsLearnedRecord ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines an implemented change process and documents the insights and knowledge gained as a lessons-learned record." ;
    skos:example "The team writes a best-practices guide capturing what worked in the rollout." ;
    bpot:apqcSourceText "Documenting and standardizing insights gleaned and the knowledge acquired from studying the change process already implemented. Create case studies/best practices guides from the process of implementing change. Include experienced personnel." ;
    bpot:hierarchyID "13.4.4.2" ;
    bpot:pcfID "11165" .

bpot:P11166 a owl:Class ;
    rdfs:label "Take corrective action as necessary" ;
    rdfs:comment "Reuses bpo:ActOfImprovement: corrective action modifies the changed processes toward better performance. May consume a remedial-action specification (bpo:RemedialActionSpecification) as input; that input is typical rather than definitional, so no restriction is asserted (Phase-3)." ;
    rdfs:subClassOf bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that adjusts the re-engineered business processes and systems through corrective action so as to maximize the intended impact of the change." ;
    skos:example "Post-launch, the team retunes the new workflow to remove a bottleneck." ;
    bpot:apqcSourceText "Implement corrective action to adjust the re-engineered processes for maximizing the desired impact. Adjust business processes and systems to implement the desired change." ;
    bpot:hierarchyID "13.4.4.3" ;
    bpot:pcfID "11166" .

bpot:P11180 a owl:Class ;
    rdfs:label "Determine environmental health and safety impacts" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (under cco:ont00000366 Act of Information Processing): 'Determine' here is discernment from audit/lifecycle data, NOT the false-friend cco:ont00001261 'Act of Identifying' (a communication act). Aggregating process; its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11186 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11187 ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines audit and lifecycle data to determine the environmental, health, and safety impacts of an organization's offerings and operations." ;
    skos:example "An EHS team determines the lifecycle environmental and safety impacts of a product line from audit findings." ;
    bpot:apqcSourceText "Determining the impact of EHS offering--and the procedures it employs to process them--on the environment at large, as well as the health and safety of employees. Evaluate the environmental impact of the organization's products, services, and operations. Conduct health, safety, and environmental audits." ;
    bpot:hierarchyID "13.8.1" ;
    bpot:pcfID "11180" .

bpot:P11181 a owl:Class ;
    rdfs:label "Develop EHS program" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning): 'Develop ... program' is a bounded composing act that passes R5 (it has a natural end), so -- unlike the standing group node 11179 -- it is a process class, not a capability. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11188 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11189 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11190 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11191 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes an organization's environmental, health, and safety program by establishing its requirements, risk assessment, and policy." ;
    skos:example "An EHS team develops the program: requirements, risk assessment, and a published EHS policy." ;
    bpot:apqcSourceText "Identify the requirements for regulation and shareholders. Assess future risks and opportunities. Develop a policy for the EHS program. Record and manage EHS program events." ;
    bpot:hierarchyID "13.8.2" ;
    bpot:pcfID "11181" .

bpot:P11182 a owl:Class ;
    rdfs:label "Train and educate functional employees" ;
    rdfs:comment "Anchored to cco:ont00000234 (Act of Training, VERIFIED §6; parent cco:ont00000228) with explicit cco:ont00000228 co-parent so Gate C sees the Act anchor. NOT Act of Communication or Act of Planning (false-friend caution): the act imparts competence. The same training genus is used corpus-wide for training rows (13.1.4.1, 13.3.4.6.3, 13.9.2.1). The definitional participant is bpo:FunctionalEmployee (the training RECIPIENT, bearer of bpo:TraineeRole), mirroring the bpo:ProcessOwner pattern used by sibling-analog bpo:P16393 'Provide process training'. REJECTED bpo:Stakeholder here: that is an interested/affected PARTY, not a training recipient, so it mis-typed the definitional participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:FunctionalEmployee ],
        cco:ont00000228,
        cco:ont00000234 ;
    skos:definition "An Act of Training in which environmental, health, and safety knowledge and skills are imparted to the organization's functional employees through on-the-job, workshop, and online training programs." ;
    skos:example "An EHS trainer runs safety workshops for plant operators." ;
    bpot:apqcSourceText "Conducting programs such as on-the-job training sessions, group training workshops, and online training." ;
    bpot:hierarchyID "13.8.3.5" ;
    bpot:pcfID "11182" .

bpot:P11186 a owl:Class ;
    rdfs:label "Evaluate environmental impact of products, services, and operations" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (under cco:ont00000366): lifecycle study and footprint estimation manipulate input data into a descriptive understanding. Output is the descriptive bpo:EnvironmentalImpactAssessment (a descriptive output implies analysis/appraisal, not planning, per the GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnvironmentalImpactAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that studies the lifecycle of an organization's products, services, and operations and produces an environmental impact assessment." ;
    skos:example "An analyst computes the carbon footprint across a product's lifecycle." ;
    bpot:apqcSourceText "Evaluating the impact of offerings and the auxiliary operations required to process them on the immediate ecosystem and the environment at large. Study the lifecycle of the products/services offered by the organization. Estimate any affect on the environment through metrics such as a calculation of carbon footprint." ;
    bpot:hierarchyID "13.8.1.1" ;
    bpot:pcfID "11186" .

bpot:P11187 a owl:Class ;
    rdfs:label "Conduct health and safety and environmental audits" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): an audit is an appraisal/verification act judging conformance, producing a descriptive report. NOT Act of Planning (no plan composed) and NOT Act of Communication (no ICE-transfer is the essence)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EHSAuditReport ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that inspects and verifies an organization's compliance with environmental, health, and safety standards and produces an EHS audit report." ;
    skos:example "An EHS auditor inspects a facility and issues a compliance audit report." ;
    bpot:apqcSourceText "Conducting an inspection to verify that the organization adequately complies with the environmental, health, and safety standards. Audit procedures and records regarding responsibility for the environment, health, and safety." ;
    bpot:hierarchyID "13.8.1.2" ;
    bpot:pcfID "11187" .

bpot:P11188 a owl:Class ;
    rdfs:label "Identify regulatory and stakeholder requirements" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment, under cco:ont00000366). REJECTED cco:ont00001261 'Act of Identifying' (the communication sense of asserting who/what a thing is) per §6: the act discerns externally-set requirements. Per the GOLDEN PRINCIPLE (Info-Processing -> Descriptive), the definitional has-output is the Descriptive bpo:EHSRequirementRegister (a register of the discerned requirements). The externally-authored Directive bpo:EHSRequirementSpecification is a has-INPUT this act captures, NOT something it composes -- composing it would be a Formulation act, contradicting the discernment genus. This restores genus<->output agreement." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:EHSRequirementSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EHSRequirementRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the regulatory and stakeholder protocols and standards an organization must comply with for environment, health, and safety and registers them in an EHS requirement register." ;
    skos:example "A compliance officer compiles the EHS regulations and stakeholder standards the firm must meet." ;
    bpot:apqcSourceText "Determining any protocols or standards to comply with, set by regulatory agencies or the organization's stakeholders. Closely examine all standards and matters of compliance relating to the environment, health, and safety." ;
    bpot:hierarchyID "13.8.2.1" ;
    bpot:pcfID "11188" .

bpot:P11189 a owl:Class ;
    rdfs:label "Assess future risks and opportunities" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'Assess' yields a descriptive judgement; output is the descriptive bpo:EHSRiskAndOpportunityAssessment, agreeing with the appraisal genus (GOLDEN PRINCIPLE). PREDICTIVE-CONTENT CAUTION: the label and the source techniques (trend extrapolation, Delphi, scenario creation) give this assessment forward-looking content. It is deliberately kept as a Descriptive assessment (cco:ont00000853), NOT re-typed to Predictive ICE (cco:ont00000626) and NOT re-anchored to an Act of Prediction/Forecasting (cco:ont00000371): the definitional product is a judgement of the significance of risks and opportunities, not a standalone forecast. Because Predictive ICE is a subClassOf Descriptive ICE, any predictive sub-content remains validly subsumed by the 853 assessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EHSRiskAndOpportunityAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the future risks and opportunities affecting the environmental, health, and safety of products and services and produces an EHS risk and opportunity assessment." ;
    skos:example "An EHS planner runs scenario and cost-benefit analysis to assess emerging safety risks." ;
    bpot:apqcSourceText "Evaluating any risks and opportunities that might affect the environmental, health, and safety of products/services. Leverage techniques such as cost-benefit analysis, trend extrapolation, systems analysis, social surveys, historical surveys, historical analogy, Delphi, conferences, workshops, briefings, hearings, advisory committees, moot courts, artistic judgment, on-site field investigation, scaling techniques, and scenario creation." ;
    bpot:hierarchyID "13.8.2.2" ;
    bpot:pcfID "11189" .

bpot:P11190 a owl:Class ;
    rdfs:label "Create EHS policy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511): a directive output (the policy) requires a planning/formulation genus, NOT analysis or appraisal (GOLDEN PRINCIPLE). Output is the Directive bpo:EHSPolicy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EHSPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes an EHS policy prescribing the minimum requirements, procedures, and tools by which an organization will manage its environmental, health, and safety impact." ;
    skos:example "An EHS team issues the corporate environmental, health, and safety policy." ;
    bpot:apqcSourceText "Creating a plan for managing the environmental, health, and safety impact of products/services. Establish minimum requirements for the organization regarding the environment at large and the health and safety of employees. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
    bpot:hierarchyID "13.8.2.3" ;
    bpot:pcfID "11190" .

bpot:P11191 a owl:Class ;
    rdfs:label "Record and manage EHS events" ;
    rdfs:comment "Compound-verb de-conflation (Phase 1): the bounded 'Record' act (information processing producing the descriptive bpo:EHSEventRecord) is modeled here; the 'manage' standing-function aspect is carried by bpo:EHSManagementCapability, not by this occurrent. Anchored to cco:ont00000366 (Act of Information Processing); the descriptive output implies a recording act, not planning." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EHSEventRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that records the events and activities associated with environmental, health, and safety compliance and produces an EHS event record." ;
    skos:example "An EHS coordinator logs compliance events and activities into the EHS register." ;
    bpot:apqcSourceText "Recording and managing all events and activities associated with complying with environmental, health and safety standards. Create event calendars. Assign funds. Educate employees. Conduct events." ;
    bpot:hierarchyID "13.8.2.4" ;
    bpot:pcfID "11191" .

bpot:P11193 a owl:Class ;
    rdfs:label "Manage EHS costs and benefits" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): cost-benefit evaluation is an appraisal yielding a descriptive judgement. Output is the descriptive bpo:EHSCostBenefitAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EHSCostBenefitAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the costs and benefits of an EHS program and produces an EHS cost-benefit assessment of whether benefits outweigh costs." ;
    skos:example "A finance-EHS review judges whether the safety program's benefits exceed its costs." ;
    bpot:apqcSourceText "Administering the costs and benefits of EHS management program. Evaluate program costs to ensure that the benefits of the program always outweigh its costs." ;
    bpot:hierarchyID "13.8.3.1" ;
    bpot:pcfID "11193" .

bpot:P11194 a owl:Class ;
    rdfs:label "Measure and report EHS performance" ;
    rdfs:comment "Anchored to cco:ont00000345 (Act of Measuring, VERIFIED §6; parent cco:ont00000228) with explicit cco:ont00000228 co-parent so Gate C sees the Act anchor; 'Measure and report' against indicators determines performance relative to a standard. Input is the shared bpo:PerformanceIndicatorSpecification (whose comment lists 13.8.3.2 as a consumer); output is the descriptive bpo:EHSPerformanceReport. NOT planning." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceIndicatorSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EHSPerformanceReport ],
        cco:ont00000228,
        cco:ont00000345 ;
    skos:definition "An Act of Measuring that uses defined performance indicators to measure environmental, health, and safety performance and produces an EHS performance report." ;
    skos:example "An EHS analyst computes audit and incident metrics and issues the EHS performance report." ;
    bpot:apqcSourceText "Using performance techniques and indicators. Utilize number of audits or inspections performed, safety committee meetings, the number and types of findings and observations, timely preventive maintenance tasks performed, etc." ;
    bpot:hierarchyID "13.8.3.2" ;
    bpot:pcfID "11194" .

bpot:P11195 a owl:Class ;
    rdfs:label "Provide EHS support" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): a service/provision act bundling heterogeneous deliverables (insurance, leave, education, training). Phase-1 de-conflation: the bundled deliverables are method content, not separate process classes or a single definitional ICE output; no shared service genus fits, so the generic Planned Act is used." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that provides employees with support services -- such as medical insurance, leave, environmental education, and safety training -- in light of an organization's environmental, health, and safety policies and standards." ;
    skos:example "An EHS-HR function provides safety training, insurance, and leave benefits to staff." ;
    bpot:apqcSourceText "Supporting employees in light of the organization's environmental, health, and safety policies and standards. Provide medical insurance, maternity leave, environmental education, training over safety, etc." ;
    bpot:hierarchyID "13.8.3.6" ;
    bpot:pcfID "11195" .

bpot:P11196 a owl:Class ;
    rdfs:label "Implement emergency response program" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228 Planned Act): 'Implement a program' enacts a Directive ICE. The directive bpo:EmergencyResponseProgram is the definitional has-input it operationalizes; no new ICE is produced." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:EmergencyResponseProgram ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that puts an emergency response program into operation so that resources are organized, coordinated, and available to respond to emergency events." ;
    skos:example "An EHS team stands up and exercises the emergency response program across sites." ;
    bpot:apqcSourceText "Implementing a program for organizing, coordinating, and directing available resources to respond to the event. Conduct a risk assessment to identify potential emergency scenarios in order to create a program that ensures that resources are on hand--or quickly available--in case of emergencies." ;
    bpot:hierarchyID "13.8.3.3" ;
    bpot:pcfID "11196" .

bpot:P11197 a owl:Class ;
    rdfs:label "Implement pollution prevention program" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228), mirroring sibling bpo:P11196: both enact a Directive program. The directive bpo:PollutionPreventionProgram is the definitional has-input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PollutionPreventionProgram ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that puts a pollution prevention program into operation to reduce or eliminate the creation of pollutants through increased resource efficiency." ;
    skos:example "An EHS team rolls out the pollution prevention program and facility inspection regime." ;
    bpot:apqcSourceText "Implementing a program that reduces or eliminates the creation of pollutants through increased efficiency in the use of raw materials, energy, water, or other resources. Implement a program to inspect facilities that store, manufacture, or use hazardous, toxic, or polluting materials." ;
    bpot:hierarchyID "13.8.3.4" ;
    bpot:pcfID "11197" .

bpot:P16379 a owl:Class ;
    rdfs:label "Establish and maintain process management governance" ;
    rdfs:comment "Reality-layer occurrent for APQC 13.1.1. Anchored to bpo:ActOfFormulation because its definitional output is a Directive ICE (the governance framework). Its APQC children are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessGovernanceFramework ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16380 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16381 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16382 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16383 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and maintains an organization's approach to governing business process management and produces a process governance framework." ;
    skos:example "A BPM office stands up and maintains the charter, tooling, and ownership model that govern process management." ;
    bpot:apqcSourceText "Defining and managing the organization's approach to governing business process management. Establish and manage tools to support the governance process. Assign ownership for all business processes. Perform activities to administer the governing process." ;
    bpot:hierarchyID "13.1.1" ;
    bpot:pcfID "16379" .

bpot:P16380 a owl:Class ;
    rdfs:label "Define and manage governance approach" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the output (the governance approach/methodology) is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessGovernanceFramework ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:BPMGovernanceLeader ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that articulates the methodology for administering business process management and produces a process governance framework specifying standards, priorities, and participant roles." ;
    skos:example "A BPM lead documents how BPM standards are set and names the governance leaders and their roles." ;
    bpot:apqcSourceText "Outlining and managing the methodology for administering business process management (BPM). Define the method for setting standards and priorities for BPM efforts. Identify BPM governance leaders. Define BPM project participants' roles." ;
    bpot:hierarchyID "13.1.1.1" ;
    bpot:pcfID "16380" .

bpot:P16381 a owl:Class ;
    rdfs:label "Establish and maintain process tools and templates" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (a BPM tool template) is a Directive ICE prescribing a ready-to-implement tool configuration." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BPMToolTemplate ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that institutes and maintains the techniques of business process management and produces reusable BPM tool templates." ;
    skos:example "A team builds and curates reusable process-engine and analytics templates for the BPM toolkit." ;
    bpot:apqcSourceText "Instituting, organizing, and maintaining the upkeep of the techniques used for business process management (BPM). Create and maintain templates of BPM tools that can be readily implemented, including process engine, business analytics, content management, and collaboration tools." ;
    bpot:hierarchyID "13.1.1.2" ;
    bpot:pcfID "16381" .

bpot:P16382 a owl:Class ;
    rdfs:label "Assign and support process ownership" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): assigning ownership confers a Role on an Agent; it is neither analysis nor the formulation of a standalone strategy. The conferred role is bpo:ProcessOwnerRole, borne by bpo:ProcessOwner." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RoleDefinitionSpecification ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProcessOwner ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that allocates responsibility for business processes to employees, conferring the process owner role and producing a role-definition specification." ;
    skos:example "A BPM governance board names accountable owners for each end-to-end process." ;
    bpot:apqcSourceText "Assigning resources (employees) ownership of tasks. These include the responsibility of identifying, analyzing, and improving business processes in order to meet the goals and objectives such as increasing profits and performance, reducing costs, and accelerating schedules." ;
    bpot:hierarchyID "13.1.1.3" ;
    bpot:pcfID "16382" .

bpot:P16383 a owl:Class ;
    rdfs:label "Perform process governance activities" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation: the act enacts the governance framework (a Directive ICE input) rather than producing a new ICE; the framework is a definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ProcessGovernanceFramework ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that carries out the activities prescribed by an organization's process governance framework." ;
    skos:example "Governance staff run the recurring review and accountability rituals defined in the BPM charter." ;
    bpot:apqcSourceText "Implementing and executing activities for governing business processes. Execute activities that encourage participation, accountability, transparency, responsiveness, equity and inclusiveness, etc. within the business processes." ;
    bpot:hierarchyID "13.1.1.4" ;
    bpot:pcfID "16383" .

bpot:P16384 a owl:Class ;
    rdfs:label "Define and manage process frameworks" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (the process framework) is a Directive ICE. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessFramework ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16385 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16386 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that designs and organizes the structural composition of an organization's business processes and produces a process framework." ;
    skos:example "An enterprise-architecture team designs the process framework spanning strategy, operations, and enterprise management." ;
    bpot:apqcSourceText "Determining and organizing the structural composition of business processes. Design, establish, and administer the framework. Identify any cross-functional processes that are mandatory for achieving business excellence." ;
    bpot:hierarchyID "13.1.2" ;
    bpot:pcfID "16384" .

bpot:P16385 a owl:Class ;
    rdfs:label "Establish and maintain process framework" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: its definitional output (the process framework) is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessFramework ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and maintains the framework outlining an organization's required business processes, their key elements, and their interactions, and produces a process framework." ;
    skos:example "Architects publish the canonical process framework that all functions must align to." ;
    bpot:apqcSourceText "Defining and managing the framework that outlines the required business processes of the organization, key elements, and how they should interact. Institute strategy infrastructure and product, operations, and enterprise management." ;
    bpot:hierarchyID "13.1.2.1" ;
    bpot:pcfID "16385" .

bpot:P16386 a owl:Class ;
    rdfs:label "Identify cross-functional processes" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment sense): the act enumerates cross-functional processes; its definitional output is a Descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CrossFunctionalProcessRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the business processes spanning multiple functional areas and produces a cross-functional process register." ;
    skos:example "An analyst flags which processes require coordination across sales, finance, and operations." ;
    bpot:apqcSourceText "Recognizing the different functional areas working on the same project or goal." ;
    bpot:hierarchyID "13.1.2.2" ;
    bpot:pcfID "16386" .

bpot:P16387 a owl:Class ;
    rdfs:label "Define processes" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: defining processes establishes prescriptive process definitions (Directive ICEs). Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16388 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16389 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21452 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16390 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16391 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that outlines and establishes an organization's business processes by scoping, analyzing, mapping, and publishing them." ;
    skos:example "A process team scopes, analyzes, models, and publishes the procurement process set." ;
    bpot:apqcSourceText "Outlining and establishing the business processes of the organization. Scope, analyze, map, and publish processes for the employees who may require it." ;
    bpot:hierarchyID "13.1.3" ;
    bpot:pcfID "16387" .

bpot:P16388 a owl:Class ;
    rdfs:label "Scope processes" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: a scope statement is a Directive ICE that bounds the process." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessScopeStatement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines the extent and limits of a business process and produces a process scope statement." ;
    skos:example "A BPM analyst writes the scope statement bounding the order-to-cash process." ;
    bpot:apqcSourceText "Defining the extent and limits of business processes. Define the range and diversity of all the set of activities and tasks that, once completed, will accomplish an organizational goal." ;
    bpot:hierarchyID "13.1.3.1" ;
    bpot:pcfID "16388" .

bpot:P16389 a owl:Class ;
    rdfs:label "Analyze processes" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: it manipulates input information into a descriptive understanding (process analysis / process model). Its child Identify published best practices is a process part." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20140 ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the activities and tasks of a business process and produces a process analysis and a process model representing how the process works." ;
    skos:example "An analyst examines the as-is hiring process and produces a process model and analysis." ;
    bpot:apqcSourceText "Assessing and examining the set of activities and tasks that, once completed, will accomplish an organizational goal. Create a business process model that captures how a business process works and how individuals from different groups work together to achieve a business goal." ;
    bpot:hierarchyID "13.1.3.2" ;
    bpot:pcfID "16389" .

bpot:P16390 a owl:Class ;
    rdfs:label "Model and document processes" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (information processing): mapping and documenting yields a Descriptive ICE (the process model). Interviewing/mapping are method sub-steps, not separate processes." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessModel ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that gathers information about a business process and produces a process model documenting what is done, who is responsible, and to what standard." ;
    skos:example "An analyst interviews participants and maps the procure-to-pay process into a documented model." ;
    bpot:apqcSourceText "Defining what a business entity does, who is responsible, to what standard a business process should be completed, and how the success of a business process can be determined. Identify processes, gather information gathering, interview participants, map processes, and perform analysis." ;
    bpot:hierarchyID "13.1.3.4" ;
    bpot:pcfID "16390" .

bpot:P16391 a owl:Class ;
    rdfs:label "Publish processes" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): publishing transfers an ICE (the process model) from authors to recipients. The process model is a definitional input that is disseminated. cco:ont00000402 is VERIFIED in the §6 verified-core-terms table above (label 'Act of Communication'; def 'A Planned Act in which some Information Content Entity is transferred from some Agent to Another'; parent cco:ont00000228 Planned Act); the explicit cco:ont00000228 co-parent gives Gate C the Act anchor without the CCO closure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ProcessModel ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that transfers documented business-process information to process team members, stakeholders, and owners." ;
    skos:example "A BPM team posts the approved process models to the intranet for all stakeholders." ;
    bpot:apqcSourceText "Disclosing the information available on business processes. Ensure the availability of the information regarding the business processes to all process team members, business stakeholders, and process owners. Use BPM software, as well as business process diagrams and documents that help depict the required information." ;
    bpot:hierarchyID "13.1.3.5" ;
    bpot:pcfID "16391" .

bpot:P16392 a owl:Class ;
    rdfs:label "Manage process performance" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): this bounded administration cycle aggregates heterogeneous children (training, support, measurement) with no single definitional ICE output, so no has-output restriction is asserted; the children are process parts. DELIBERATE R5 DIVERGENCE FROM SIBLINGS (auditable): the parallel 'Manage X' GROUP nodes -- 16378 'Manage business processes', 17471 'Manage enterprise quality', 11073 'Manage KM', and the 13.2 Manage portfolio/program/project nodes -- are modeled as standing Organization Capabilities (cco:ont00000568) because each is an open-ended enterprise FUNCTION with no natural terminus. P16392 'Manage process performance' is NOT a group node but a 13.1.4 sub-process that, on each performance period (e.g. quarter), runs a bounded train->support->measure-and-report administration cycle with an identifiable begin (period open) and end (period KPI report issued); it passes R5 as a repeatable bounded occurrent and is a proper part of the standing bpo:BusinessProcessManagementCapability, which is realized in it. Thus the divergence is intentional: the standing FUNCTION is the capability; the repeatable bounded CYCLE that realizes it is this Planned Act." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16393 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16394 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16395 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that administers the ongoing performance of business processes by training owners, supporting execution, and measuring and reporting performance." ;
    skos:example "Each quarter the BPM office trains owners, supports execution, and reports process KPIs." ;
    bpot:apqcSourceText "Evaluating and handling the performance of business processes. Provide training to process owners. Support the execution of business processes. Measure and report the performance of the business processes." ;
    bpot:hierarchyID "13.1.4" ;
    bpot:pcfID "16392" .

bpot:P16393 a owl:Class ;
    rdfs:label "Provide process training" ;
    rdfs:comment "Anchored to cco:ont00000234 (Act of Training): the act imparts skills to Agents. Process owners are definitional participants/recipients. cco:ont00000234 is VERIFIED in the §6 verified-core-terms table above (label 'Act of Training'; def 'A Planned Act in which knowledge, skills or values are imparted from one or more Agents to at least one other Agent'; parent cco:ont00000228 Planned Act) -- its definition (imparting skills to Agents) matches this use." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProcessOwner ],
        cco:ont00000228,
        cco:ont00000234 ;
    skos:definition "An Act of Training in which process-management knowledge and skills are imparted to the employees and process owners who administer business processes." ;
    skos:example "The BPM office runs a workshop teaching new owners how to monitor their processes." ;
    bpot:apqcSourceText "Providing training for the employees and process owners that administer the business processes. Design internal training programs or source third party agencies to provide the skills and training necessary." ;
    bpot:hierarchyID "13.1.4.1" ;
    bpot:pcfID "16393" .

bpot:P16394 a owl:Class ;
    rdfs:label "Support process execution" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation: supporting execution enacts the defined processes rather than producing an ICE. BPEL is a method detail, not a definitional I/O." ;
    rdfs:subClassOf bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that assists and carries out the running of an organization's business processes." ;
    skos:example "A BPM support team keeps the automated approval workflows running and unblocks exceptions." ;
    bpot:apqcSourceText "Assisting and executing the business processes. Use business process execution language (BEPL), which is a standard, executable language for specifying actions within the business processes with the use of web services." ;
    bpot:hierarchyID "13.1.4.2" ;
    bpot:pcfID "16394" .

bpot:P16395 a owl:Class ;
    rdfs:label "Measure and report process performance" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring: it tracks performance and yields a Descriptive ICE (the performance report). Performance indicator specifications are a definitional input. Its child Identify additional metrics is a process part." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceIndicatorSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessPerformanceReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20141 ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that uses defined performance indicators to measure business-process performance and produces a process performance report." ;
    skos:example "An analyst publishes a balanced-scorecard report of the hiring process each month." ;
    bpot:apqcSourceText "Defining and using performance indicators to consider the financial perspective, customer perspective, internal process perspective, and learning perspective of the organization." ;
    bpot:hierarchyID "13.1.4.3" ;
    bpot:pcfID "16395" .

bpot:P16397 a owl:Class ;
    rdfs:label "Identify and select improvement opportunities" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: per the GOLDEN PRINCIPLE the definitional output is a Descriptive ICE (the improvement opportunity assessment), so the genus is information-processing rather than Selection. Process owners are definitional participants." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ImprovementOpportunityAssessment ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProcessOwner ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns and appraises candidate improvements to existing business processes and produces an improvement opportunity assessment." ;
    skos:example "A facilitator and the process owner surface and rank improvement opportunities for the billing process." ;
    bpot:apqcSourceText "Helping a process owner to identify, analyze, and improve existing business processes within an organization to meet new goals and objectives." ;
    bpot:hierarchyID "13.1.5.1" ;
    bpot:pcfID "16397" .

bpot:P16398 a owl:Class ;
    rdfs:label "Manage improvement projects" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation: managing an improvement project enacts a systematic optimization approach. Modeled as a single bounded improvement-project act; APQC defers detailed project mechanics to category Manage projects." ;
    rdfs:subClassOf bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that develops and puts into effect a systematic approach for optimizing an organization's underlying processes." ;
    skos:example "A PMO runs a chartered improvement project to streamline the returns process." ;
    bpot:apqcSourceText "Developing and implementing a systematic approach to help the organization optimize its underlying processes in order to achieve more efficient results. Systematically gather information to clarify issues or problems. Intervene for improvements. Restructure training programs as appropriate to increase effectiveness." ;
    bpot:hierarchyID "13.1.5.3" ;
    bpot:pcfID "16398" .

bpot:P16399 a owl:Class ;
    rdfs:label "Perform continuous improvement activities" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement: each cycle is a repeatable bounded change to a process. The 'persistent/ongoing' framing is realized as many repeatable instances, not a standing function." ;
    rdfs:subClassOf bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that persistently enacts incremental modifications to business processes to raise their performance." ;
    skos:example "A team runs weekly kaizen cycles trimming waste from the fulfillment process." ;
    bpot:apqcSourceText "Persistently implementing activities for improving business processes." ;
    bpot:hierarchyID "13.1.5.4" ;
    bpot:pcfID "16399" .

bpot:P16402 a owl:Class ;
    rdfs:label "Establish portfolio strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (portfolio strategy) is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PortfolioStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a portfolio strategy prescribing how an organization manages its portfolio of investments, holdings, products, businesses, and brands." ;
    skos:example "A portfolio office drafts the strategy governing the firm's brand and investment portfolio." ;
    bpot:apqcSourceText "Instituting the strategy for managing business portfolio. Create a systematic plan that defines the strategy for managing investments, holdings, products, businesses, and brands." ;
    bpot:hierarchyID "13.2.1.1" ;
    bpot:pcfID "16402" .

bpot:P16403 a owl:Class ;
    rdfs:label "Define portfolio governance" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (portfolio governance framework) is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PortfolioGovernanceFramework ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a portfolio governance framework prescribing the rules, metrics, and procedures for identifying, selecting, prioritizing, and monitoring portfolio components." ;
    skos:example "A portfolio board defines the governance rules and health metrics for portfolio components." ;
    bpot:apqcSourceText "Outlining the administration of business portfolio of the organization. Create and manage the rules and regulations regarding the business processes in order to identify, select, prioritize, and monitor portfolio components. Include a set of metrics to indicate the health and progress of the portfolio in the most vital area." ;
    bpot:hierarchyID "13.2.1.2" ;
    bpot:pcfID "16403" .

bpot:P16404 a owl:Class ;
    rdfs:label "Monitor and control portfolio" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring: it tracks portfolio activities over time and yields a Descriptive ICE (the status report)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PortfolioStatusReport ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that oversees and supervises the activities of an organization's business portfolio and produces a portfolio status report." ;
    skos:example "A portfolio manager tracks investment and brand performance and issues a portfolio status report." ;
    bpot:apqcSourceText "Overseeing and administering the business portfolio of the organization. Monitor all activities related to investments, holdings, products, businesses, and brands by effectively monitoring and supervising these activities." ;
    bpot:hierarchyID "13.2.1.3" ;
    bpot:pcfID "16404" .

bpot:P16406 a owl:Class ;
    rdfs:label "Establish program structure and approach" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (program structure specification) is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProgramStructureSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a program structure specification prescribing the framework and approach -- governance, alignment, assurance, and management -- for managing a business program." ;
    skos:example "A program office defines the governance and assurance framework for a transformation program." ;
    bpot:apqcSourceText "Constructing and instituting the framework and approach to manage business programs. Monitor key factors such as governance, alignment with the overall business vision, assurance, and management." ;
    bpot:hierarchyID "13.2.2.1" ;
    bpot:pcfID "16406" .

bpot:P16407 a owl:Class ;
    rdfs:label "Manage program stakeholders and partners" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): relationship management is an organizational act with no single definitional ICE output; the stakeholders/partners are the salient participants." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that manages the relationships with the stakeholders and partners of a business program." ;
    skos:example "A program manager runs the stakeholder and partner engagement cadence for a program." ;
    bpot:apqcSourceText "Managing relationships with stakeholders and partners of the business programs." ;
    bpot:hierarchyID "13.2.2.2" ;
    bpot:pcfID "16407" .

bpot:P16408 a owl:Class ;
    rdfs:label "Manage program execution" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228): executing the program enacts the program structure rather than producing an ICE." ;
    rdfs:subClassOf bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that administers and executes a business program by carrying out its constituent projects." ;
    skos:example "A program manager runs the program's constituent projects to completion." ;
    bpot:apqcSourceText "Administering and implementing business programs. Implement and execute programs with the intention of improving an organization's performance. Execute all the individual projects of the program to ensure the desired success." ;
    bpot:hierarchyID "13.2.2.3" ;
    bpot:pcfID "16408" .

bpot:P16409 a owl:Class ;
    rdfs:label "Review and report program performance" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring: it tracks program performance and yields a Descriptive ICE (the program performance report)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProgramPerformanceReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that evaluates and documents the performance of a business program against its indicators and produces a program performance report." ;
    skos:example "A program office issues the quarterly program performance report against goals and cost-effectiveness." ;
    bpot:apqcSourceText "Evaluating and documenting the performance of business programs. Evaluate the performance of the programs. Create reports on the basis of the analysis. Use performance indicators and metrics such as desired/achieved goals, completion dates, issues and defects, and cost effectiveness." ;
    bpot:hierarchyID "13.2.2.4" ;
    bpot:pcfID "16409" .

bpot:P16411 a owl:Class ;
    rdfs:label "Establish project scope" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (project scope statement) is a Directive ICE. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectScopeStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11117 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16412 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11118 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11120 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11121 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21454 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes the scope of a business project -- its objectives, resource requirements, and measures -- producing a project scope statement." ;
    skos:example "A project manager fixes the project's objectives, resourcing, and KPIs in a scope statement." ;
    bpot:apqcSourceText "Establishing the horizons of business projects. Identify the objectives of the program, along with the resource requirements. Assess the readiness for the project management approach. Identify methodologies for project management. Obtain funding. Develop performance measures and indicators." ;
    bpot:hierarchyID "13.2.3.1" ;
    bpot:pcfID "16411" .

bpot:P16412 a owl:Class ;
    rdfs:label "Identify project resource requirements" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment), NOT cco:ont00001261. Output is the Descriptive bpo:ProjectResourceRequirementsStatement (a discernment of prerequisites), agreeing with the information-processing genus per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectResourceRequirementsStatement ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the people, skills, and resources a project requires and registers them in a project resource requirements statement." ;
    skos:example "A project manager lists the skilled staff, capital, and equipment the project needs." ;
    bpot:apqcSourceText "Identifying the prerequisites of business projects. Identify the people with appropriate and applicable skills and competencies. Locate resources such as capital, facilities, equipment, material, and information required to accomplish the objectives of a specific project." ;
    bpot:hierarchyID "13.2.3.1.2" ;
    bpot:pcfID "16412" .

bpot:P16413 a owl:Class ;
    rdfs:label "Develop project plans" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (project plan) is a Directive ICE. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11123 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20142 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11124 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11125 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11127 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11128 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11129 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a project plan prescribing the resources, roles, IT requirements, training, communication, reward approaches, and launch for executing a business project." ;
    skos:example "A project manager assembles the resourcing, training, and launch plans into the project plan." ;
    bpot:apqcSourceText "Defining the resources and their roles. Identify IT requirements. Create plans for effective training and communication. Design reward approaches. Plan the launch of project. Deploy the project." ;
    bpot:hierarchyID "13.2.3.3" ;
    bpot:pcfID "16413" .

bpot:P16414 a owl:Class ;
    rdfs:label "Execute projects" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228): executing the project enacts the project plan. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11131 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16415 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16416 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11132 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21455 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11133 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21456 ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that carries out a business project by evaluating impact, reporting status, managing scope, sustaining involvement, and realigning approach." ;
    skos:example "A project team runs the project to plan, tracking status and adjusting scope as needed." ;
    bpot:apqcSourceText "Implementing the business projects of the organization. Evaluate the impact of project management. Record and report the status of the project. Manage the project scope. Promote and sustain activities and involvement. Realign and revamp the project management strategy and approach." ;
    bpot:hierarchyID "13.2.3.4" ;
    bpot:pcfID "16414" .

bpot:P16415 a owl:Class ;
    rdfs:label "Report the status of project" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): recording/documenting status assembles a Descriptive ICE (the project status report). COMPILE-class (kept at 366): the source leads with 'Recording and documenting the current status'; the phrase 'Record and report items such as completed/incomplete/planned tasks' enumerates the CONTENT recorded into the report, not dissemination to a named audience, so it is not a DISSEMINATE reporting act." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectStatusReport ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that records and documents the current status of a project -- completed, incomplete, and planned tasks and problems -- and produces a project status report." ;
    skos:example "A project manager issues the weekly status report of tasks done, pending, and blocked." ;
    bpot:apqcSourceText "Recording and documenting the current status and position of the project. Record and report items such as completed tasks, incomplete tasks, planned tasks, and problems faced." ;
    bpot:hierarchyID "13.2.3.4.2" ;
    bpot:pcfID "16415" .

bpot:P16416 a owl:Class ;
    rdfs:label "Manage project scope" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: determining-and-documenting the scope composes/maintains a Directive ICE (the shared bpo:ProjectScopeStatement)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectScopeStatement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that determines and documents the project's goals, deliverables, tasks, costs, and deadlines, maintaining the project scope statement that bounds the project." ;
    skos:example "A project manager keeps the scope statement current as goals and deliverables are confirmed." ;
    bpot:apqcSourceText "Determining and documenting a list of specific project goals, deliverables, tasks, costs, and deadlines. Use the scope statement to explain the boundaries of the project. Assign responsibilities for team members. Set up procedures for verifying and approving the completed tasks." ;
    bpot:hierarchyID "13.2.3.4.3" ;
    bpot:pcfID "16416" .

bpot:P16417 a owl:Class ;
    rdfs:label "Review and report project performance" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring: it tracks project performance against indicators and yields a Descriptive ICE (the project performance report). Performance indicators are a typical input; stakeholders are the reporting audience." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectPerformanceReport ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that measures a project's performance against its key performance indicators, identifies deviations from plan, and produces a project performance report for stakeholders." ;
    skos:example "A project manager reports schedule and cost variances against the baseline to stakeholders." ;
    bpot:apqcSourceText "Measuring the performance of a business project against key performance indicators including the project scope, schedule, quality, cost, and risk criteria. Identify any deviations from the plan. Assess the impact of these deviations on the project, as well as on the overall program. Report results to key stakeholders." ;
    bpot:hierarchyID "13.2.3.5" ;
    bpot:pcfID "16417" .

bpot:P16418 a owl:Class ;
    rdfs:label "Close projects" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): a bounded closing/finalization act (settling contracts, finalizing activities) with an identifiable end and no single definitional ICE output." ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act that settles the project's contracts and finalizes all activities to formally close a business project or project phase." ;
    skos:example "A project manager closes out all contracts and formally ends the project." ;
    bpot:apqcSourceText "Settling each contract. Close each contract applicable to the project or project phase. Finalize all activities across all of the process groups in order to formally close the project or a project phase." ;
    bpot:hierarchyID "13.2.3.6" ;
    bpot:pcfID "16418" .

bpot:P17472 a owl:Class ;
    rdfs:label "Establish quality requirements" ;
    rdfs:comment "Aggregating planning process; its APQC children are process parts (cco:ont00001777), not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17473 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17474 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17475 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17480 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17481 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that determines the critical characteristics, preventive activities, and controls securing enterprise quality and produces a quality plan." ;
    skos:example "A quality team translates customer needs into critical-to-quality characteristics, controls, and a finalized quality plan." ;
    bpot:apqcSourceText "Determining essential activities, processes, and attributes for securing enterprise quality. Outline critical characteristics for quality. Outline activities encouraging the preservation of quality. Create quality controls. Confirm capabilities in accordance with quality requirements. Finalize the plan for quality maintenance." ;
    bpot:hierarchyID "13.3.1" ;
    bpot:pcfID "17472" .

bpot:P17473 a owl:Class ;
    rdfs:label "Define critical-to-quality characteristics" ;
    rdfs:comment "Act of Formulation: composing measurable requirements from customer needs yields a Directive bpo:CriticalToQualityCharacteristicSpecification (a prescription of what products/processes MUST achieve), not a description of present quality." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CriticalToQualityCharacteristicSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that translates customer needs into a critical-to-quality characteristic specification of measurable product and process requirements." ;
    skos:example "An engineer converts a customer expectation into a measurable tolerance on a key product dimension." ;
    bpot:apqcSourceText "Outlining characteristics crucial for managing enterprise quality. Translate broad customer needs into specific, actionable, measurable performance requirements. Define the key measurable characteristics of key products and processes." ;
    bpot:hierarchyID "13.3.1.1" ;
    bpot:pcfID "17473" .

bpot:P17474 a owl:Class ;
    rdfs:label "Define preventive quality activities" ;
    rdfs:comment "Critical-to-quality characteristic specification is a typical input (the gap is judged against it) rather than definitional, so it is noted here, not asserted as a restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PreventiveQualityActivitySpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that specifies the preventive quality activities and methodology for reducing the risk of not meeting critical-to-quality characteristics." ;
    skos:example "A quality engineer documents a preventive inspection regime to close a requirement gap." ;
    bpot:apqcSourceText "Identifying gaps in customer requirements and determining whether the gap will be mitigated through preventive Quality activities or deemed as acceptable risk. The goal of any preventive quality activities is to create provisions to prevent, control, or reduce the risk of not meeting the CtQCs. In addition, any standard methodology that will be used to design or conduct preventive Quality activities are defined and documented." ;
    bpot:hierarchyID "13.3.1.2" ;
    bpot:pcfID "17474" .

bpot:P17475 a owl:Class ;
    rdfs:label "Develop quality controls" ;
    rdfs:comment "Aggregating planning process; its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityControlSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17476 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17477 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17478 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17479 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that develops a quality control specification comprising the control steps, sampling plan, measurement methods, and required competencies." ;
    skos:example "A quality team defines control steps, a sampling plan, measurement tools, and operator competencies for a production line." ;
    bpot:apqcSourceText "Developing controls for managing the quality of enterprise. Define the process steps for quality controls and the sampling plan. Identify the tools and methods to measure quality. Define the competencies required." ;
    bpot:hierarchyID "13.3.1.3" ;
    bpot:pcfID "17475" .

bpot:P17476 a owl:Class ;
    rdfs:label "Define process steps for controls (or integration points)" ;
    rdfs:comment "Act of Formulation: establishing control steps/integration points composes a Directive bpo:ProcessControlPointSpecification prescribing where quality is checked, not a record of testing already done." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessControlPointSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes the process steps and integration points of a quality control as a process control point specification." ;
    skos:example "A quality lead specifies alpha-test, rework, and beta-test gates as control points." ;
    bpot:apqcSourceText "Establishing the steps for developing quality controls. Conduct Alpha testing. Have the product team conduct rework. Send the product/service for Beta testing, and carry on rework as needed." ;
    bpot:hierarchyID "13.3.1.3.1" ;
    bpot:pcfID "17476" .

bpot:P17477 a owl:Class ;
    rdfs:label "Define sampling plan" ;
    rdfs:comment "Act of Formulation: authoring a bpo:SamplingPlan composes a Directive ICE that prescribes how samples are to be drawn; the data later collected under it is a separate Descriptive record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SamplingPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that produces a sampling plan specifying the parameters, sample sizes, scheme, and responsibilities for taking quality samples." ;
    skos:example "A quality engineer authors a sampling plan fixing sample sizes and inspection timing." ;
    bpot:apqcSourceText "Establishing a detailed summary including measures, on which material, in what manner, and by whom. Identify the parameters to be measured, the range of possible values, and the required resolution. Provide a sampling scheme that details how and when samples will be taken. Select sample sizes. Assign roles and responsibilities." ;
    bpot:hierarchyID "13.3.1.3.2" ;
    bpot:pcfID "17477" .

bpot:P17478 a owl:Class ;
    rdfs:label "Identify measurement methods" ;
    rdfs:comment "Anchored under bpo:ActOfSelection (reused from apqc-ext.ttl): choosing among candidate tools yields a Directive decision ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MeasurementMethodSelection ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses the tools and methods for measuring quality and produces a measurement method selection." ;
    skos:example "A quality team selects SPC software and gage-calibration tooling for line measurement." ;
    bpot:apqcSourceText "Using tools to measure quality. Use tools such as quality improvement oversight system tool, performance measurement tools, consumer information models/guides, and validation tools to effectively determine the quality levels." ;
    bpot:hierarchyID "13.3.1.3.3" ;
    bpot:pcfID "17478" .

bpot:P17479 a owl:Class ;
    rdfs:label "Define required competencies" ;
    rdfs:comment "Act of Formulation: specifying required competencies composes a Directive bpo:CompetencyRequirementSpecification (a prescription of what operators MUST be able to do); appraisal of whether staff hold them is modeled separately." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CompetencyRequirementSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that specifies the competencies required to perform quality-control activities as a competency requirement specification." ;
    skos:example "A quality manager documents that control operators must hold audit-management and document-control competencies." ;
    bpot:apqcSourceText "Defining the competencies required for developing quality controls. Define the required competencies including compliance management, audit management, and document control and document management." ;
    bpot:hierarchyID "13.3.1.3.4" ;
    bpot:pcfID "17479" .

bpot:P17480 a owl:Class ;
    rdfs:label "Prove capability to assess compliance with requirements" ;
    rdfs:comment "Anchored under cco:ont00000636 (Act of Appraisal); statistical-process-control and process-capability techniques judge conformance ability, yielding a descriptive evidentiary artifact." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceCapabilityDemonstration ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates and demonstrates an organization's ability to fulfil its quality requirements and produces a compliance capability demonstration." ;
    skos:example "A quality team runs a process-capability study and presents the results to a regulator." ;
    bpot:apqcSourceText "Demonstrating the ability and capability to confirm and fulfill the quality requirements in front of customers, managers, employees, board members, associations, regulatory bodies, and creditors. Leverage tools and techniques such as process behavior or control charts, statistical process control, measurement system analysis, gage calibration management, and process capability analysis." ;
    bpot:hierarchyID "13.3.1.4" ;
    bpot:pcfID "17480" .

bpot:P17481 a owl:Class ;
    rdfs:label "Finalize quality plan" ;
    rdfs:comment "Act of Formulation: consolidating requirements, controls, and verification into a finalized bpo:QualityPlan composes a single governing Directive ICE; the conformance records kept under it are separate Descriptive outputs." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that consolidates the quality requirements, controls, and verification approach into a finalized quality plan governing a product or service lifecycle." ;
    skos:example "A quality manager issues the approved quality plan covering verification criteria and nonconformance response." ;
    bpot:apqcSourceText "Establishing how the critical-to-quality characteristics will be achieved, controlled, ensured, and managed throughout the lifecycle of a product/service. Address quality requirements and critical-to-quality characteristics. Conduct a preventive quality assessment. Describe how to verify the product/service, verification criteria, and response to nonconformance. Keep records to demonstrate conformity." ;
    bpot:hierarchyID "13.3.1.5" ;
    bpot:pcfID "17481" .

bpot:P17482 a owl:Class ;
    rdfs:label "Evaluate performance to requirements" ;
    rdfs:comment "Aggregating appraisal process; its APQC children (testing and assessment) are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityTestSummary ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17483 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17487 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that analyzes whether quality performance has met the requirements set in the quality plan and produces a quality test summary." ;
    skos:example "A quality function tests output against the plan and judges whether requirements were met." ;
    bpot:apqcSourceText "Analyzing if the performance of the quality plan has achieved the estimated and desired requirements. Conduct tests against the quality plan. Assess the results of these tests." ;
    bpot:hierarchyID "13.3.2" ;
    bpot:pcfID "17482" .

bpot:P17483 a owl:Class ;
    rdfs:label "Test against quality plan" ;
    rdfs:comment "Aggregating process anchored at cco:ont00000366 (Act of Information Processing): the parent's OWN definitional product is the Descriptive bpo:QualityTestDataRecord, satisfying the GOLDEN PRINCIPLE (info-processing -> descriptive). It is a mixed aggregate -- its children span measuring (bpo:P17484, cco:ont00000345), recording (bpo:P17485, cco:ont00000366), and a Directive-producing disposition (bpo:P17486, bpo:ActOfSelection). The directive disposition facet is delegated to the child bpo:P17486 and is deliberately NOT lifted onto this parent; 366 (a subClassOf cco:ont00000228) is therefore retained rather than re-anchored to the bare Planned Act, preserving the descriptive-output agreement. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityTestDataRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17484 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17485 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17486 ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that conducts quality tests against the quality plan, records the resulting test data, and determines their disposition." ;
    skos:example "An inspector runs tests, logs the data, and assigns a disposition to each result." ;
    bpot:apqcSourceText "Examining the quality of organizational processes. Conduct tests. Collect information and data. Record the results of these tests. Determine the dispositions of the test results." ;
    bpot:hierarchyID "13.3.2.1" ;
    bpot:pcfID "17483" .

bpot:P17484 a owl:Class ;
    rdfs:label "Conduct test and collect data" ;
    rdfs:comment "Anchored at cco:ont00000345 (Act of Measuring): determines quality of an entity relative to a standard." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityTestDataRecord ],
        cco:ont00000228,
        cco:ont00000345 ;
    skos:definition "An Act of Measuring that tests quality characteristics against established standards and collects the resulting quality test data record." ;
    skos:example "A technician runs a scheduled gauge test and logs the measured values." ;
    bpot:apqcSourceText "Evaluating quality performance through periodic or episodic testing against the established standards for quality characteristics. For periodic testing, design a schedule with sufficient time to make any required adjustments to the process or system to maintain the desired level of quality. For episodic testing, conduct a test whenever a known non-conformance or fault occurs, which results in outputs or outcomes known to be unsatisfactory to performance requirements." ;
    bpot:hierarchyID "13.3.2.1.1" ;
    bpot:pcfID "17484" .

bpot:P17485 a owl:Class ;
    rdfs:label "Record result(s)" ;
    rdfs:comment "Act of Information Processing (cco:ont00000366): recording/storing results into a standard format yields the Descriptive bpo:QualityTestDataRecord; this is data capture, not the judgement of those results (which is the sibling Appraisal 17488)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityTestDataRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that records and stores quality test results in standard formats as a quality test data record." ;
    skos:example "A quality clerk enters test outcomes into the QMS in the standard template." ;
    bpot:apqcSourceText "Maintaining and recording the results of Test against the quality plan [17483] electronically and in standard formats. Assign ownership to a designated function or role." ;
    bpot:hierarchyID "13.3.2.1.2" ;
    bpot:pcfID "17485" .

bpot:P17486 a owl:Class ;
    rdfs:label "Determine disposition of result(s)" ;
    rdfs:comment "Anchored under bpo:ActOfSelection (reused): chooses a disposition (quarantine, scrap, rework) from candidates, yielding a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityTestDataRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityTestResultDisposition ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that decides the disposition action for quality test results and produces a quality test result disposition." ;
    skos:example "A quality engineer selects a quarantine-and-rework disposition for a failing lot." ;
    bpot:apqcSourceText "Deciding whether to take any additional actions based on the results of quality tests. Initiate a quarantine disposition and relocated inventory, scrap workflow item and scrap transaction, rework operation, net-able and nonnet-able items, and the activity list." ;
    bpot:hierarchyID "13.3.2.1.3" ;
    bpot:pcfID "17486" .

bpot:P17487 a owl:Class ;
    rdfs:label "Assess results of tests" ;
    rdfs:comment "Aggregating appraisal process; its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityTestDataRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityTestSummary ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17488 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17489 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17490 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17491 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges the significance of quality test results, summarizes them, and recommends improvement actions." ;
    skos:example "A quality analyst summarizes test outcomes and recommends corrective measures to management." ;
    bpot:apqcSourceText "Assessing the significance of the sample. Summarize the results of the test. Recommend improvement actions. Decide what steps to take next." ;
    bpot:hierarchyID "13.3.2.2" ;
    bpot:pcfID "17487" .

bpot:P17488 a owl:Class ;
    rdfs:label "Assess sample significance" ;
    rdfs:comment "Act of Appraisal (cco:ont00000636): judging sample representativeness produces a Descriptive bpo:SampleSignificanceAssessment; the underlying bpo:QualityTestDataRecord is the has-input evidence, not the output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityTestDataRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SampleSignificanceAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges whether a test sample is representative of the larger output and produces a sample significance assessment." ;
    skos:example "A statistician evaluates whether an inspection sample is representative of a production run." ;
    bpot:apqcSourceText "Assessing the significance of the sample chosen for the test in order to determine whether or not the sample is representative of the larger output or outcome. Determine if the sample meets or does not meet the requirements. Identify the conditions for acceptance, rejection, remediation, and prevention." ;
    bpot:hierarchyID "13.3.2.2.1" ;
    bpot:pcfID "17488" .

bpot:P17489 a owl:Class ;
    rdfs:label "Summarize result(s)" ;
    rdfs:comment "Act of Information Processing (cco:ont00000366): summarizing/compiling results into a bpo:QualityTestSummary is a Descriptive condensation act, NOT a reporting/communication act -- the source text makes summarizing (not disseminating to an audience) definitional." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityTestDataRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityTestSummary ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that condenses quality test results into a quality test summary of findings and conclusions." ;
    skos:example "An analyst compiles charts and conclusions into a quality test summary report." ;
    bpot:apqcSourceText "Outlining the major facts and figures of the quality test results in order to provide insights and information. Use charts, tables, statistical test results, and written findings and conclusions in a summary of results." ;
    bpot:hierarchyID "13.3.2.2.2" ;
    bpot:pcfID "17489" .

bpot:P17490 a owl:Class ;
    rdfs:label "Recommend actions" ;
    rdfs:comment "Anchored under bpo:ActOfFormulation (reused): a recommendation prescribes a course of action, hence a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityTestSummary ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityImprovementRecommendation ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes recommended improvement measures for the quality plan as a quality improvement recommendation." ;
    skos:example "A quality lead recommends tightening a control limit based on summarized results." ;
    bpot:apqcSourceText "Recommending measures for improvement. Assess the summarized results to identify areas which can be improved. Suggest actions to management for improving the quality plan basis on the results of the tests." ;
    bpot:hierarchyID "13.3.2.2.3" ;
    bpot:pcfID "17490" .

bpot:P17491 a owl:Class ;
    rdfs:label "Decide next steps" ;
    rdfs:comment "Anchored under bpo:ActOfSelection (reused): selects from candidate recommended actions, yielding a Directive ICE. FIXED degenerate I/O: the has-output now points at the distinct bpo:QualityImprovementActionDecision (the committed decision), while bpo:QualityImprovementRecommendation -- the output of sibling 17490 -- is retained as has-input only. Previously this act asserted the SAME ICE as both input and output (a vacuous self-emission) and collided with 17490's output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:QualityImprovementRecommendation ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityImprovementActionDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses, from the recommended quality-improvement actions, those the organization will adopt and produces a quality improvement action decision prescribing them." ;
    skos:example "Management selects which recommended quality measures to implement next quarter and records the decision." ;
    bpot:apqcSourceText "Selecting the subsequent actions that the organization can adopt for improving the enterprise quality. Select measures and recommended actions for managing the enterprise quality." ;
    bpot:hierarchyID "13.3.2.2.4" ;
    bpot:pcfID "17491" .

bpot:P17492 a owl:Class ;
    rdfs:label "Manage non-conformance" ;
    rdfs:comment "Modeled as a bounded process (Planned Act), not an Organization Capability: a nonconformance handling instance has an identifiable beginning (the event) and end (closure). Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:NonconformanceRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17493 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17494 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17495 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17496 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17497 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that handles a nonconformance event from impact assessment through corrective or preventive action to closure of the nonconformance record." ;
    skos:example "A quality team works a single nonconformance from detection through CAPA to documented closure." ;
    bpot:apqcSourceText "Handling any nonconformance activities or events. Assess the potential impact of the nonconformity. Decide the immediate actions to take. Identify the root causes. Take corrective or preventive action. Ensure future conformance." ;
    bpot:hierarchyID "13.3.3" ;
    bpot:pcfID "17492" .

bpot:P17493 a owl:Class ;
    rdfs:label "Assess potential impact" ;
    rdfs:comment "Act of Appraisal (cco:ont00000636): rating risk exposure of a nonconformity yields a Descriptive bpo:NonconformanceImpactAssessment; the resulting choice of action is the separate Selection act 13.3.3.2." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:NonconformanceRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:NonconformanceImpactAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates a nonconformance event and produces a nonconformance impact assessment determining the need for corrective or preventive action." ;
    skos:example "An analyst rates the risk exposure of a nonconformity to decide whether CAPA is warranted." ;
    bpot:apqcSourceText "Analyzing any nonconformance events. Determine the need for corrective and/or preventative action(s). Leverage root-cause analysis, risk exposure, and other evaluations to properly review and approve/reject subsequent actions." ;
    bpot:hierarchyID "13.3.3.1" ;
    bpot:pcfID "17493" .

bpot:P17494 a owl:Class ;
    rdfs:label "Determine immediate action(s)" ;
    rdfs:comment "Anchored under bpo:ActOfSelection (reused): selects among action options based on impact, yielding a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:NonconformanceImpactAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CorrectiveAndPreventiveActionSpecification ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses the immediate corrective, preventive, or no-action response to a nonconformance and produces a corrective and preventive action specification." ;
    skos:example "A quality manager selects an immediate containment action for a high-impact nonconformity." ;
    bpot:apqcSourceText "Initiating immediate corrective, preventative, or no action based upon the impact and likelihood of reoccurrence. Consider cost/benefit, risk exposure, timing, the assignment of responsibility, and other pertinent factors." ;
    bpot:hierarchyID "13.3.3.2" ;
    bpot:pcfID "17494" .

bpot:P17495 a owl:Class ;
    rdfs:label "Identify root cause(s)" ;
    rdfs:comment "Anchored under bpo:ActOfAnalysis (reused): information processing yielding an explanatory descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:NonconformanceRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RootCauseAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines a nonconformance event and produces a root cause analysis of the reasons that triggered it." ;
    skos:example "Investigators trace a defect to a miscalibrated tool via documentary evidence and interviews." ;
    bpot:apqcSourceText "Recognizing the reasons that have triggered the nonconformance events or activities. Perform a root-cause analysis through documentary evidence and interviews. Involve the appropriate individuals. Leverage cause analysis and risk assessment." ;
    bpot:hierarchyID "13.3.3.3" ;
    bpot:pcfID "17495" .

bpot:P17496 a owl:Class ;
    rdfs:label "Take corrective or preventative action" ;
    rdfs:comment "Anchored under bpo:ActOfImplementation (PROPOSE-EXT): enacts the prescribed CAPA in the organization. GOLDEN-PRINCIPLE FIX: an implementation/enactment act's definitional product is a brought-about state / descriptive completion record, NOT a fresh Directive specification. The Directive bpo:CorrectiveAndPreventiveActionSpecification is therefore the governing has-INPUT here (the spec authored by 13.3.3.2 'Determine immediate action'); the has-output is now the Descriptive bpo:CorrectiveActionCompletionRecord. The 'identify the appropriate CAPA' authoring facet is modeled separately as the Selection act 13.3.3.2 (bpo:P17494), not overloaded onto this implementation class. Root-cause analysis is a typical (non-definitional) supporting input, dropped to comment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CorrectiveAndPreventiveActionSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CorrectiveActionCompletionRecord ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that carries a corrective and preventive action specification into effect to eliminate the cause of a detected nonconformity and produces a corrective action completion record." ;
    skos:example "A team implements a tooling change and monitors the line for recurrence of the defect, then records completion." ;
    bpot:apqcSourceText "Pursuing corrective and preventative activities to eliminate the cause of a detected nonconformity. Define the nonconformity. Communicate and assign responsibility. Identify the appropriate corrective and preventive action. Implement and monitor for reoccurrence." ;
    bpot:hierarchyID "13.3.3.4" ;
    bpot:pcfID "17496" .

bpot:P17497 a owl:Class ;
    rdfs:label "Close non-conformance" ;
    rdfs:comment "Act of Information Processing (cco:ont00000366): this act documents root causes and the corrective/preventive actions taken and closes the Descriptive bpo:NonconformanceRecord; the actual remediation (enacting the CAPA) is modeled separately as the Implementation act 13.3.3.4 (bpo:P17496). The bpo:CorrectiveAndPreventiveActionSpecification is the governing has-input, not a fresh output.",
        "Anchored to cco:ont00000366 (Act of Information Processing): this is a pure compiling/recording act -- it documents root causes and CAPA into, and closes, the nonconformance record. It is NOT reporting/communication (cco:ont00000379/151), since no dissemination to an audience is definitional, and NOT formulation, since no new Directive is authored: the governing bpo:CorrectiveAndPreventiveActionSpecification (Directive) is the has-INPUT being documented, and the has-output bpo:NonconformanceRecord is Descriptive, preserving info-processing -> descriptive agreement (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CorrectiveAndPreventiveActionSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:NonconformanceRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that documents the root causes and corrective and preventive actions and closes the nonconformance record." ;
    skos:example "A quality clerk finalizes and closes the nonconformance record after CAPA verification." ;
    bpot:apqcSourceText "Closing nonconformance. Perform all the final processes related to the nonconformance, including documenting root causes. Document corrective and preventive actions." ;
    bpot:hierarchyID "13.3.3.5" ;
    bpot:pcfID "17497" .

bpot:P17498 a owl:Class ;
    rdfs:label "Implement and maintain the enterprise quality management system (EQMS)" ;
    rdfs:comment "Modeled as a bounded process (Act of Implementation, PROPOSE-EXT): the establish-and-deploy effort has identifiable phases and bounded children. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EQMSScopeAndGoalSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17499 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17500 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17501 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17502 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17503 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17504 ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that establishes and deploys the enterprise quality management system by defining its strategy, scope, controls, and policies and assessing and improving its performance." ;
    skos:example "A quality program stands up an EQMS platform, configures controls, and runs the first performance assessment." ;
    bpot:apqcSourceText "Establishing and administering the software that manages content and business processes for quality and compliance across the value chain. Define the quality strategy. Plan and deploy the EQMS scope, targets, and goals. Identify core process controls and metric. Develop EQMS governance. Assess the performance of EQMS. Encourage improvements in EQMS." ;
    bpot:hierarchyID "13.3.4" ;
    bpot:pcfID "17498" .

bpot:P17499 a owl:Class ;
    rdfs:label "Define the quality strategy" ;
    rdfs:comment "Act of Formulation: formalizing enterprise-quality techniques, standards, and responsibilities composes a Directive bpo:QualityStrategy (a prescriptive strategy ICE), consistent with the corpus-wide treatment of strategy as a Directive (965)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that formalizes the techniques, standards, and responsibilities for managing enterprise quality as a quality strategy." ;
    skos:example "A quality director issues the enterprise quality strategy standardizing tools, reporting, and roles." ;
    bpot:apqcSourceText "Outlining the strategy for managing enterprise quality. Define and formalize quality techniques and standards. Assign responsibilities for achieving the required quality levels. Standardize the quality maintenance procedure, tools and techniques, recording and reporting, the timing of quality maintenance activities, and the roles and responsibilities for the quality management team." ;
    bpot:hierarchyID "13.3.4.1" ;
    bpot:pcfID "17499" .

bpot:P17500 a owl:Class ;
    rdfs:label "Plan and deploy the EQMS scope, targets, and goals" ;
    rdfs:comment "Anchored under bpo:ActOfImplementation (PROPOSE-EXT): the planning of scope produces the directive, and deployment enacts it operationally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EQMSScopeAndGoalSpecification ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that establishes and deploys the EQMS scope, targets, and goals into operational activities, governed by an EQMS scope and goal specification." ;
    skos:example "A program rolls out the EQMS across audit, risk, and SPC modules per the defined scope." ;
    bpot:apqcSourceText "Establishing and effectively deploying the scope, targets, and goals of EQMS. Define the role of EQMS through nonconformance/corrective and preventive action, compliance/audit management, risk management, failure mode and effects analysis, and statistical process control. Implement EQMS into operational activities. Define the goals and objectives that are to be achieved by the EQMS." ;
    bpot:hierarchyID "13.3.4.2" ;
    bpot:pcfID "17500" .

bpot:P17501 a owl:Class ;
    rdfs:label "Identify core EQMS processes, controls, and metrics" ;
    rdfs:comment "Anchored under bpo:ActOfFormulation (reused): recognizing-and-specifying the control/metric set composes a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessControlPointSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceIndicatorSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that specifies the core EQMS processes, controls, and metrics as a process control point specification." ;
    skos:example "A quality architect defines the EQMS controls and the cost-of-quality and OEE metrics to track." ;
    bpot:apqcSourceText "Recognizing and implementing the processes, controls, and metrics for maintenance of EQMS. Define the role of EQMS in failure mode and effects analysis, complaint handling, and advanced product quality planning. Establish the role of EQMS in evaluating metrics such as cost of quality, overall equipment effectiveness, on-time and complete shipments, percentage of products in compliance, and new product introductions." ;
    bpot:hierarchyID "13.3.4.3" ;
    bpot:pcfID "17501" .

bpot:P17502 a owl:Class ;
    rdfs:label "Develop and document EQMS policies, procedures, standards, and measures" ;
    rdfs:comment "Act of Formulation: authoring EQMS policies, procedures, and standards composes a Directive bpo:ProcessGovernanceFramework that prescribes how the EQMS is governed." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessGovernanceFramework ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and documents the EQMS policies, procedures, standards, and measures as a process governance framework." ;
    skos:example "A quality team authors the EQMS procedure manual and document hierarchy." ;
    bpot:apqcSourceText "Setting the process limits. Gather required information. Align with other documents and processes. Define the document structure." ;
    bpot:hierarchyID "13.3.4.4" ;
    bpot:pcfID "17502" .

bpot:P17503 a owl:Class ;
    rdfs:label "Assess the EQMS performance" ;
    rdfs:comment "Act of Appraisal (cco:ont00000636): benchmarking EQMS metrics against peers yields a Descriptive bpo:EQMSPerformanceAssessment of gaps; implementing the resulting improvements is the separate Improvement act 13.3.4.6." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EQMSPerformanceAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that benchmarks EQMS quality metrics against industry peers and produces an EQMS performance assessment identifying performance gaps." ;
    skos:example "A quality lead benchmarks the EQMS against peers and reports the capability gaps." ;
    bpot:apqcSourceText "Benchmarking current performance in quality metrics that span across the value chain. Identify gaps in performance as compared to industry peers. Identify and implement complementary EQMS capabilities. Enable a continuous improvement environment." ;
    bpot:hierarchyID "13.3.4.5" ;
    bpot:pcfID "17503" .

bpot:P17504 a owl:Class ;
    rdfs:label "Create environment and capability for EQMS improvement(s)" ;
    rdfs:comment "Anchored under bpo:ActOfImprovement (PROPOSE-EXT). Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17505 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17506 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17507 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17508 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17509 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17510 ],
        bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that enacts the rewards, partnerships, talent, communications, and method-transfer changes that build an environment and capability for ongoing EQMS improvement." ;
    skos:example "A quality program launches recognition awards, supplier partnerships, and training to drive EQMS maturity." ;
    bpot:apqcSourceText "Rewarding excellence in quality. Create and maintain quality partnerships. Maintain talent capabilities and competencies. Incorporate EQMS messaging into communication channels. Transfer proven EQMS methods. Consider factors such as EQMS reviews and gap assessments and the alignment and compatibility of business processes and quality. Adopt Lean principles." ;
    bpot:hierarchyID "13.3.4.6" ;
    bpot:pcfID "17504" .

bpot:P17505 a owl:Class ;
    rdfs:label "Reward quality excellence" ;
    rdfs:comment "Anchored under bpo:ActOfImplementation (PROPOSE-EXT): enacts the recognition-and-reward plan. The plan is a typical governing input rather than a definitional one, noted here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that grants monetary and nonmonetary rewards to personnel in recognition of quality excellence, governed by a recognition and reward plan." ;
    skos:example "A manager awards gift cards to a team that eliminated a recurring defect." ;
    bpot:apqcSourceText "Provisioning rewards for achieving quality excellence. Provide monetary and nonmonetary rewards such as compensation, vacations, gift cards, and reimbursements to employees in in recognition of their services, efforts, and achievements in quality excellence." ;
    bpot:hierarchyID "13.3.4.6.1" ;
    bpot:pcfID "17505" .

bpot:P17506 a owl:Class ;
    rdfs:label "Create and maintain quality partnerships" ;
    rdfs:comment "Act of Implementation (PROPOSE-EXT): forming/maintaining third-party partnerships is an enactment act; its definitional artifact is the Directive bpo:QualityPartnershipAgreement governing the established partnership (minted, per the output comment at the registry entry)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityPartnershipAgreement ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that forms and maintains partnerships with third-party sources to advance quality excellence and produces a quality partnership agreement." ;
    skos:example "A quality director establishes a supplier-quality partnership with shared audit rights." ;
    bpot:apqcSourceText "Establishing and maintaining partnerships with third-party sources to achieve quality excellence. Source and evaluate third-party sources both public and private to ensure that the most effective and efficient partnerships are formed." ;
    bpot:hierarchyID "13.3.4.6.2" ;
    bpot:pcfID "17506" .

bpot:P17507 a owl:Class ;
    rdfs:label "Maintain talent capabilities and competencies" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfImplementation to cco:ont00000234 (Act of Training, VERIFIED §6: imparts knowledge/skills/values to Agents; parent cco:ont00000228 Planned Act). Source text -- 'Conduct training sessions, skill development activities ... to ensure that the resources of the organization are competent' -- is paradigmatically training, not the enactment of a directive plan. Rejected candidate bpo:ActOfImplementation: filing a training act under a generic local Implementation genus is a false genus and a D5 reuse miss (the module header provisions Act of Training). Explicit cco:ont00000228 co-parent added so Gate C (S2) sees the Act anchor without the CCO closure (same pattern as 17484). Training plan is a typical governing input, noted here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228,
        cco:ont00000234 ;
    skos:definition "An Act of Training that conducts training sessions and skill-development activities to maintain personnel competencies at the level required for quality, governed by a training plan." ;
    skos:example "A quality team runs SPC training to keep operators qualified." ;
    bpot:apqcSourceText "Maintaining a common denominator for the competency level within the organization's talent circle. Conduct training sessions, skill development activities, and quality excellence activities to ensure that the resources of the organization are competent enough and have the capabilities to achieve the required level of quality." ;
    bpot:hierarchyID "13.3.4.6.3" ;
    bpot:pcfID "17507" .

bpot:P17508 a owl:Class ;
    rdfs:label "Incorporate EQMS messaging into communication channels" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfImplementation to cco:ont00000402 (Act of Communication, VERIFIED §6: transfers an ICE from one Agent to another; parent cco:ont00000228 Planned Act). Source text -- 'Assimilating all the communication related to the EQMS into the organization's already established communication channels' -- is fundamentally a communication act, not the enactment of a directive plan. Rejected candidate bpo:ActOfImplementation: a false-friend genus and D5 reuse miss. Explicit cco:ont00000228 co-parent added so Gate C (S2) sees the Act anchor without the CCO closure. Communication plan is a typical governing input, noted here." ;
    rdfs:subClassOf cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that disseminates EQMS-related messaging through the organization's established communication channels, governed by a communication plan." ;
    skos:example "A quality communications lead adds EQMS updates to the intranet and newsletter." ;
    bpot:apqcSourceText "Assimilating all the communication related to the EQMS into the organization's already established communication channels." ;
    bpot:hierarchyID "13.3.4.6.4" ;
    bpot:pcfID "17508" .

bpot:P17509 a owl:Class ;
    rdfs:label "Assure independent EQMS management access to appropriate authority in the organization" ;
    rdfs:comment "Anchored under bpo:ActOfImplementation (PROPOSE-EXT): enacts an access/role arrangement defined by a role definition specification." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RoleDefinitionSpecification ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that establishes and secures EQMS management access for the authorized quality role, governed by a role definition specification." ;
    skos:example "An administrator grants EQMS administrative rights only to the designated quality manager." ;
    bpot:apqcSourceText "Ensuring EQMS access to the person in charge of the quality management process. Establish who has the authority to manage the EQMS. Ensure access of EQMS to only the person(s) in authority." ;
    bpot:hierarchyID "13.3.4.6.5" ;
    bpot:pcfID "17509" .

bpot:P17510 a owl:Class ;
    rdfs:label "Transfer proven EQMS methods" ;
    rdfs:comment "Anchored at cco:ont00000366 (Act of Information Processing): captures and transfers proven methods as a descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BestPracticesRegister ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that records and disseminates proven EQMS methods and best practices as a best practices register." ;
    skos:example "A knowledge lead documents a proven CAPA workflow and shares it across sites." ;
    bpot:apqcSourceText "Recording and transferring the best practices and proven methods associated with enterprise quality management systems (EQMS) that can be leveraged in improving the organization's framework. Record proven methodologies and approaches with the objective of communicating them for upgrading, refining, and enhancing the organization's systems." ;
    bpot:hierarchyID "13.3.4.6.6" ;
    bpot:pcfID "17510" .

bpot:P20140 a owl:Class ;
    rdfs:label "Identify published best practices" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment sense): the act enumerates effective practices; its definitional output is a Descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BestPracticesRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the practices and procedures most effective for business success and produces a best-practices register." ;
    skos:example "A center of excellence catalogs proven process practices for reuse." ;
    bpot:apqcSourceText "Realizing those practices and procedures that are the most effective to the success of the business and making that information available." ;
    bpot:hierarchyID "13.1.3.2.1" ;
    bpot:pcfID "20140" .

bpot:P20141 a owl:Class ;
    rdfs:label "Identify additional metrics as required" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfFormulation to bpo:ActOfIdentification. Source text is 'Determining the NEED for additional performance indicators that would be necessary' -- a discernment/appraisal that yields a descriptive gap-finding (whether more metrics are required), NOT the composition of the KPI specification itself. Rejected candidate bpo:ActOfFormulation (Planning -> Directive output): it over-commits, modeling the authoring of the indicator spec rather than the determination of the gap, and would violate the GOLDEN PRINCIPLE (a descriptive determination paired with a Directive output). This re-anchoring aligns the row with its sibling 'Identify' rows 16386 and 20140, which are bpo:ActOfIdentification (information-processing, Descriptive). The actual composition of any new indicator spec is a downstream formulation act (cf. bpo:P10270 / bpo:P11109)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MetricGapAssessment ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that determines whether additional performance indicators are needed to achieve a business goal and produces a metric gap assessment registering that need." ;
    skos:example "When a new goal is set, an analyst determines that no current KPI tracks it and records the metric gap." ;
    bpot:apqcSourceText "Determining the need for additional performance indicators that would be necessary to successfully achieve the business goal." ;
    bpot:hierarchyID "13.1.4.3.1" ;
    bpot:pcfID "20141" .

bpot:P20142 a owl:Class ;
    rdfs:label "Acquire/secure project resources" ;
    rdfs:comment "Anchored to bpo:ActOfAcquisition (reused from apqc-ext, under cco:ont00000228 Planned Act): obtaining/securing resources the organization did not previously hold. The role-definition specification from 11123 is a typical governing input, noted here; the resources acquired are material/independent continuants, not a definitional ICE output." ;
    rdfs:subClassOf bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that procures and secures the resources outlined for a business project that the organization did not previously hold." ;
    skos:example "A project manager procures the contractors and equipment the project plan requires." ;
    bpot:apqcSourceText "Procuring the necessary resources outlined in Define roles and resources [11123]" ;
    bpot:hierarchyID "13.2.3.3.2" ;
    bpot:pcfID "20142" .

bpot:P20143 a owl:Class ;
    rdfs:label "Identify impacted groups" ;
    rdfs:comment "Reuses bpo:ChangeImpactAssessment (Descriptive ICE) as the register of impacted groups; the companion act 13.4.1.11 quantifies the extent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeImpactAssessment ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns which organizational groups are impacted by a change and registers them in a change impact assessment." ;
    skos:example "The team lists the teams and functions touched by the proposed change." ;
    bpot:apqcSourceText "Recognizing the impact of threats to critical assets. Determine what groups are impacted by this impact." ;
    bpot:hierarchyID "13.4.1.10" ;
    bpot:pcfID "20143" .

bpot:P20144 a owl:Class ;
    rdfs:label "Determine degree/extent of impact" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges the magnitude of impact, refining the descriptive bpo:ChangeImpactAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeImpactAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the degree and extent to which the change impacts the organization's assets and records its judgement in a change impact assessment." ;
    skos:example "Analysts rate how severely each affected asset is impacted by the change." ;
    bpot:apqcSourceText "Evaluating the impact of threats to critical assets. Determine what assets will be impacted by the change." ;
    bpot:hierarchyID "13.4.1.11" ;
    bpot:pcfID "20144" .

bpot:P20145 a owl:Class ;
    rdfs:label "Assign change champion(s)" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act): deploying/engaging champions is an organizational act, not the production of an analysis or plan; the champion participants are the salient continuants." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ChangeChampion ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which trained change champions are deployed and engaged to carry out and communicate the change in their respective areas." ;
    skos:example "Each trained champion is formally tasked with driving the change in their division." ;
    bpot:apqcSourceText "Utilizing champions that have been trained to carry out needed changes. Engage champions to communicate roles and responsibilities for the change." ;
    bpot:hierarchyID "13.4.2.5" ;
    bpot:pcfID "20145" .

bpot:P20146 a owl:Class ;
    rdfs:label "Report on change" ;
    rdfs:comment "RE-ANCHORED from cco:ont00000366 (Act of Information Processing) to bpo:ActOfReporting (subClassOf cco:ont00000379 Act of Representative Communication + cco:ont00000228): the source makes dissemination definitional -- 'Share findings with those within the target audience: those impacted by the change, change champions, stakeholders, etc.' -- so this is a DISSEMINATE-class reporting act, not a mere COMPILE. The has_output ICE restriction (bpo:ChangeReport) is retained." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that documents the outcome and impact of a change and shares the resulting change report with its affected target audience." ;
    skos:example "The change office issues a closeout report to stakeholders and champions." ;
    bpot:apqcSourceText "Reporting on the outcome of the change. Document changes and the impact those changes had on critical assets. Share findings with those within the target audience: those impacted by the change, change champions, stakeholders, etc." ;
    bpot:hierarchyID "13.4.3.5" ;
    bpot:pcfID "20146" .

bpot:P20147 a owl:Class ;
    rdfs:label "Evaluate performance" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal) because it evaluates and judges performance. Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10270 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10271 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20148 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10272 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10273 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10274 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10275 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10276 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that assesses process data, measures, and trends to evaluate process performance and identify possible improvements, producing a performance assessment." ;
    skos:example "A quarterly performance review evaluates KPI results and flags improvement opportunities." ;
    bpot:apqcSourceText "Assessing process data, measures, and trends in an effort to evaluate process performance and identify possible improvements." ;
    bpot:hierarchyID "13.6.3" ;
    bpot:pcfID "20147" .

bpot:P20148 a owl:Class ;
    rdfs:label "Collect performance data" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): input metric ICEs are received and consolidated into an output Descriptive ICE (performance data)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceData ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that consolidates acquired metrics and trends into performance data suitable for benchmarking against historical data." ;
    skos:example "A reporting tool consolidates monthly KPI feeds into a single performance dataset." ;
    bpot:apqcSourceText "Consolidating acquired metrics and trends. Provide data that can be benchmarked against historical data." ;
    bpot:hierarchyID "13.6.3.3" ;
    bpot:pcfID "20148" .

bpot:P20960 a owl:Class ;
    rdfs:label "Develop and manage hypotheses" ;
    rdfs:comment "R5 de-conflation: the bounded 'develop hypotheses' act is modeled here; the 'manage' aspect is the standing analytics function carried by bpo:AnalyticsCapability (this act is one of its realized-in fillers), not a separate conflated occurrent. Anchored to bpo:ActOfAnalysis (under cco:ont00000366 Act of Information Processing): a hypothesis-forming act composes a descriptive account of empirical data, not a directive plan. Per the GOLDEN PRINCIPLE the Info-Processing genus agrees with the Descriptive output bpo:Hypothesis (a candidate account of how reality is). REJECTED bpo:ActOfFormulation (cco:ont00000511 Act of Planning): a Planning/Directive genus would contradict the descriptive output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:Hypothesis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Information Processing that composes and frames the hypotheses explaining empirical data, producing a hypothesis used to guide feature selection during data collection." ;
    skos:example "A data scientist frames a testable hypothesis about which features drive customer churn." ;
    bpot:apqcSourceText "Creating theories that explain empirical data. Use the hypotheses to guide feature selection in the process of data collection." ;
    bpot:hierarchyID "13.7.3" ;
    bpot:pcfID "20960" .

bpot:P20961 a owl:Class ;
    rdfs:label "Collect data" ;
    rdfs:comment "Anchored to bpo:ActOfAcquisition (reused from apqc-ext, under cco:ont00000228 Planned Act): the differentiating step is obtaining data the organization did not previously hold from disparate sources. DISPOSITIONED Act of Information Processing (cco:ont00000366): the clean/dedup/normalize sub-steps are information processing, but the dominant act-kind is acquisition (gather/harvest from sources); the consolidation is a method sub-step. Output is the descriptive bpo:AnalyticsDataset." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AnalyticsDataset ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that gathers and harvests structured and unstructured data from disparate sources and cleans, deduplicates, and normalizes it into an analytics dataset." ;
    skos:example "An ETL pipeline pulls and normalizes transaction logs from three source systems." ;
    bpot:apqcSourceText "Gathering and harvesting structured and unstructured data from disparate sources. Clean and pre-process data. Remove duplicates. Convert to a uniform format to make records comparable." ;
    bpot:hierarchyID "13.7.4" ;
    bpot:pcfID "20961" .

bpot:P20962 a owl:Class ;
    rdfs:label "Analyze data" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (under cco:ont00000366): the canonical analysis act of the group. Input is the prepared dataset (definitional); output is the descriptive bpo:DataAnalysisResult. Mirrors the Appendix-A AnalyzeCompetitors pattern." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PreparedDataset ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DataAnalysisResult ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that applies statistical algorithms to a prepared dataset to reveal patterns, trends, error rates, and outliers and produces a data analysis result." ;
    skos:example "A data scientist runs regression and clustering over the prepared data to surface churn drivers." ;
    bpot:apqcSourceText "Conducting data analysis. Choose statistical algorithms that best reveal patterns and trends in the data. Compare with hypotheses and time series forecasts. Determine error rates and significant outliers." ;
    bpot:hierarchyID "13.7.6" ;
    bpot:pcfID "20962" .

bpot:P20963 a owl:Class ;
    rdfs:label "Report on analysis" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): assembling and documenting analysis results into a Descriptive ICE. DISPOSITIONED cco:ont00000402 'Act of Communication': the dominant act here is composing/documenting the report (information processing); dissemination to readers is a downstream/typical facet. Input is the data analysis result; output is the descriptive bpo:AnalysisReport." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DataAnalysisResult ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AnalysisReport ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that summarizes and documents the results of data analysis, including graphs and visualizations, and produces an analysis report." ;
    skos:example "An analyst compiles the findings into a visual report for the business sponsor." ;
    bpot:apqcSourceText "Summarizing and documenting the results of data analysis. Create graphs and visualizations to illustrate numerical findings to make them more accessible to readers." ;
    bpot:hierarchyID "13.7.10" ;
    bpot:pcfID "20963" .

bpot:P20964 a owl:Class ;
    rdfs:label "Identify remedial actions" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation, NOT bpo:ActOfIdentification, despite the 'Identify' label: the source 'Determining the STEPS that need to be taken to correct the shortcomings' composes a prescription of corrective steps, and its output bpo:RemedialActionSpecification is Directive. Anchoring under the descriptive bpo:ActOfIdentification would pair a descriptive genus with a Directive output and violate the GOLDEN PRINCIPLE; the formulation genus agrees with the directive output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RemedialActionSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that determines the steps required to correct identified shortcomings and produces a remedial action specification prescribing them." ;
    skos:example "A team specifies the corrective steps to address the data-quality gaps the analysis revealed." ;
    bpot:apqcSourceText "Determining the steps that need to be taken to correct the shortcomings." ;
    bpot:hierarchyID "13.7.11" ;
    bpot:pcfID "20964" .

bpot:P20965 a owl:Class ;
    rdfs:label "Design and implement KM capabilities" ;
    rdfs:comment "Anchored at cco:ont00000228 (Planned Act): an aggregate build-and-deploy effort spanning formulation, implementation, and improvement sub-acts; no single act genus dominates, and its APQC children are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11114 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20966 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11115 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20967 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20968 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that designs and then puts into operation the knowledge bases, approaches, and supporting technology that preserve and develop an organization's expertise." ;
    skos:example "A KM program builds a new expertise repository and rolls it out to a business unit." ;
    bpot:apqcSourceText "Creating knowledge bases and other repositories to preserve and develop company expertise, and to train new employees." ;
    bpot:hierarchyID "13.5.3" ;
    bpot:pcfID "20965" .

bpot:P20966 a owl:Class ;
    rdfs:label "Design resource model for KM approaches" ;
    rdfs:comment "Output is a Directive ICE (resource model with standards/guidelines) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMResourceModel ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a KM resource model prescribing the resources, standards, and guidelines that the organization's KM approaches will follow." ;
    skos:example "A KM architect models the staffing, tooling, and content resources required for each KM approach." ;
    bpot:apqcSourceText "Creating a model to describe resources and approaches to organization's knowledge management. Establish standards and guidelines to be followed." ;
    bpot:hierarchyID "13.5.3.2" ;
    bpot:pcfID "20966" .

bpot:P20967 a owl:Class ;
    rdfs:label "Leverage and enhance IT for KM approaches" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement (PROPOSE-EXT): the act augments existing IT for a better-than-prior KM process state. Researching third-party offerings and employing specialists are typical methods, noted here rather than as restrictions." ;
    rdfs:subClassOf bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that uses and enhances existing information technology in order to raise the performance of an organization's knowledge-management processes." ;
    skos:example "A KM engineering team integrates a third-party search platform to speed knowledge retrieval." ;
    bpot:apqcSourceText "Using existing technologies to improve organization's knowledge management processes. Research available third-party offerings. Develop proprietary solutions. Employ knowledge engineers, data scientists and other relevant personnel." ;
    bpot:hierarchyID "13.5.3.4" ;
    bpot:pcfID "20967" .

bpot:P20968 a owl:Class ;
    rdfs:label "Develop measures" ;
    rdfs:comment "Establishing metrics yields a Directive ICE (a specification of indicators) per the GOLDEN PRINCIPLE; parallels bpo:P11109." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceIndicatorSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes and prescribes a performance-indicator specification of the metrics, scales, benchmarks, and units used to describe KM approaches and capabilities." ;
    skos:example "A KM analyst defines the measurement scales and precision targets for KM capability metrics." ;
    bpot:apqcSourceText "Creating metrics that can be used to systematically describe KM approaches and capabilities. Choose applicable scales, benchmarks and units of measure. Determine required precision and error rates." ;
    bpot:hierarchyID "13.5.3.5" ;
    bpot:pcfID "20968" .

bpot:P20969 a owl:Class ;
    rdfs:label "Evolve and sustain KM capabilities" ;
    rdfs:comment "Anchored at cco:ont00000228 (Planned Act): an aggregate of enhancement, sustainment, and expansion sub-acts; no single act genus dominates, and its APQC children are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11113 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20970 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20971 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that develops and augments resources in order to improve and sustain an organization's knowledge-management and knowledge-engineering capabilities over time." ;
    skos:example "A KM program runs a continuous-improvement cycle that upgrades repositories and grows usage." ;
    bpot:apqcSourceText "Developing resources for improved knowledge management and knowledge engineering." ;
    bpot:hierarchyID "13.5.4" ;
    bpot:pcfID "20969" .

bpot:P20970 a owl:Class ;
    rdfs:label "Sustain awareness and engagement" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfImplementation to cco:ont00000402 (Act of Communication, VERIFIED §6: transfers an ICE from one Agent to another; parent cco:ont00000228 Planned Act). Source text -- 'Developing awareness about available knowledge bases and promoting their use to maximize their impact' -- describes a PROMOTION / awareness-raising act whose essence is communication, not the neutral execution of a directive. Rejected candidate bpo:ActOfImplementation: a false-friend genus (the prior 'operationalizing the communication plan' framing buried the communicative act-kind) and a D5 reuse miss. Added a has-output (bpo:KMAwarenessCommunication) and an audience participant so the communicative content and recipients are visible. R5: read as repeatable bounded promotion campaigns (each campaign has a begin/end) realizing the standing engagement function, not as a single open-ended occurrent. Explicit cco:ont00000228 co-parent gives Gate C the Act anchor without the CCO closure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:KMAwarenessCommunication ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that develops awareness of available knowledge bases and promotes their use across the organization, producing awareness messaging directed at the organization's members in order to maximize the knowledge bases' impact." ;
    skos:example "A KM team runs an internal campaign encouraging staff to contribute to and consult the knowledge base." ;
    bpot:apqcSourceText "Developing awareness about available knowledge bases and promoting their use to maximize their impact." ;
    bpot:hierarchyID "13.5.4.2" ;
    bpot:pcfID "20970" .

bpot:P20971 a owl:Class ;
    rdfs:label "Expand KM infrastructure to meet demand" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement (PROPOSE-EXT): augmenting resources to a greater-than-prior capacity. Target may be material (servers, storage) or informational; modeled generically as improvement." ;
    rdfs:subClassOf bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that augments the available knowledge-management infrastructure and resources in order to increase capacity to serve existing and new clients." ;
    skos:example "A KM operations team adds storage and indexing capacity ahead of a surge in knowledge-base usage." ;
    bpot:apqcSourceText "Augmenting available resources to better leverage the offerings of the organization to serve existing clients and to expand the client base." ;
    bpot:hierarchyID "13.5.4.3" ;
    bpot:pcfID "20971" .

bpot:P21452 a owl:Class ;
    rdfs:label "Identify and denote process control points" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: a control-point specification is a Directive ICE that prescribes a gating rule." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessControlPointSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes checkpoints within a process and produces a process control point specification gating continuation on satisfied requirements." ;
    skos:example "A team designates an approval gate that halts the process until compliance checks pass." ;
    bpot:apqcSourceText "Establishment of a \"checkpoint\" in a process that prevent the process from continuing unless all requirements are satisfied." ;
    bpot:hierarchyID "13.1.3.3" ;
    bpot:pcfID "21452" .

bpot:P21453 a owl:Class ;
    rdfs:label "Improve processes" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement: the act changes existing processes to optimize them. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16397 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11138 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16398 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16399 ],
        bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that identifies, selects, and manages modifications to an organization's business processes so as to raise their efficiency and effectiveness." ;
    skos:example "A continuous-improvement program runs Lean and Six Sigma initiatives across the process portfolio." ;
    bpot:apqcSourceText "Identifying, selecting, and managing improvements. Based on the type and scope of the improvement, determination of the appropriate improvement methodology (e.g., Lean, Six Sigma, etc.) should guide the effort. This includes continuous improvement, process redesign, process reengineering, and application of the organizations approaches for Manage projects." ;
    bpot:hierarchyID "13.1.5" ;
    bpot:pcfID "21453" .

bpot:P21454 a owl:Class ;
    rdfs:label "Prioritize and select projects for the portfolio" ;
    rdfs:comment "Anchored to bpo:ActOfSelection (reused): chooses/prioritizes from candidate projects, yielding a Directive decision ICE (the selection/prioritization)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectPortfolioSelection ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that stack-ranks and chooses the projects for the portfolio against preestablished criteria and produces a project portfolio selection." ;
    skos:example "A portfolio board ranks and selects which projects to fund this cycle." ;
    bpot:apqcSourceText "Stack ranking of projects in the portfolio based upon preestablished criteria." ;
    bpot:hierarchyID "13.2.3.1.6" ;
    bpot:pcfID "21454" .

bpot:P21455 a owl:Class ;
    rdfs:label "Conduct Project Reviews with Program Managers and other stakeholders" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): a review judges what worked and what could improve; output is the Descriptive bpo:ProjectReviewRecord. Program managers and stakeholders are definitional participants." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectReviewRecord ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProgramManager ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that conducts a post-project or after-action review with program managers and stakeholders and produces a project review record of lessons learned." ;
    skos:example "A team holds an after-action review and records lessons for future projects." ;
    bpot:apqcSourceText "Hold post project reviews, lessons learned, or After Action Reviews (AARs) at the end of each project to understand what could be improved during future projects." ;
    bpot:hierarchyID "13.2.3.4.5" ;
    bpot:pcfID "21455" .

bpot:P21456 a owl:Class ;
    rdfs:label "Adjust project plan as needed" ;
    rdfs:comment "Anchored to bpo:ActOfImprovement (under cco:ont00000228): it modifies an existing project plan rather than composing one de novo. Input and revised output are both bpo:ProjectPlan; communication to the team is a typical sub-step." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ProjectPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectPlan ],
        bpot:ActOfImprovement ;
    skos:definition "An Act of Improvement that makes required changes to an existing project plan in response to internal and external influences and produces the updated project plan." ;
    skos:example "A project manager updates the plan and notifies the team after a scope change." ;
    bpot:apqcSourceText "Changes to project plans based upon internal and or external influences on the project.  This would include the update to the project plan file, as well as the communication to the team." ;
    bpot:hierarchyID "13.2.3.4.7" ;
    bpot:pcfID "21456" .

bpot:P21457 a owl:Class ;
    rdfs:label "Plan for change" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning) because its definitional output is a Directive ICE (the change plan). APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChangeManagementPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11140 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11139 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11141 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11142 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11143 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11144 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11145 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11146 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11147 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20143 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20144 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11148 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11149 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11150 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11151 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that evaluates the impact of an intended change and composes a change management plan identifying the activities needed to engage stakeholders and guide the transition from current to future state." ;
    skos:example "A program team scopes a transformation, assesses readiness, and produces the change management plan." ;
    bpot:apqcSourceText "Evaluating impact and planning change activities. Spanning the lifecycle of change from initial concept, to designing, implementing, and sustaining the change, change planning identifies the activities to enage and enable the stakeholders and all impacted by the change. Change plans should address the interplay between people, process, technology, and knowledge to guide the transition, or tranformation, from current state to the future state." ;
    bpot:hierarchyID "13.4.1" ;
    bpot:pcfID "21457" .

bpot:P21459 a owl:Class ;
    rdfs:label "Identify needs from stakeholders" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment, under cco:ont00000366). REJECTED cco:ont00001261 'Act of Identifying' (a communication act of asserting who/what a thing is) per §6: 'Identify' here means discerning needs, i.e. information processing. Output is a Descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StakeholderNeedsStatement ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that gathers and discerns the needs of stakeholders prior to conducting analytics and produces a stakeholder needs statement." ;
    skos:example "An analytics team interviews business stakeholders and records their information needs." ;
    bpot:apqcSourceText "Gathering information from stakeholders prior to conducting analytics." ;
    bpot:hierarchyID "13.7.1" ;
    bpot:pcfID "21459" .

bpot:P21460 a owl:Class ;
    rdfs:label "Scope analytics project" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the definitional output (the scope statement) is a Directive ICE prescribing size/scale, so the formulation genus agrees with the directive output (GOLDEN PRINCIPLE). Input is the stakeholder needs statement." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StakeholderNeedsStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AnalyticsProjectScopeStatement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that determines the size and scale of an analytics project from collected information and produces an analytics project scope statement." ;
    skos:example "A lead analyst sets the boundaries and resourcing of a churn-analysis project." ;
    bpot:apqcSourceText "Determining the size and scale of the project based upon the collected information and analytics." ;
    bpot:hierarchyID "13.7.2" ;
    bpot:pcfID "21460" .

bpot:P21461 a owl:Class ;
    rdfs:label "Prepare data" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): validation/preparation manipulates the collected dataset into an analysis-ready form. Genus is deliberately DISTINCT from sibling 20961 'Collect data' (bpo:ActOfAcquisition): collection obtains the data; preparation validates/transforms data already held. Input is bpo:AnalyticsDataset; output is the distinct bpo:PreparedDataset." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:AnalyticsDataset ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PreparedDataset ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that creates and validates an analytics dataset so as to produce a prepared dataset fit to initiate analysis." ;
    skos:example "A data engineer validates and feature-engineers the collected dataset before modeling." ;
    bpot:apqcSourceText "Creation and validation of data in order to initiate the process of analysis." ;
    bpot:hierarchyID "13.7.5" ;
    bpot:pcfID "21461" .

bpot:P21462 a owl:Class ;
    rdfs:label "Create data models" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the output bpo:DataModel is Directive (it prescribes required data structure/storage), so the formulation genus agrees with the directive output (GOLDEN PRINCIPLE). (If on review bpo:DataModel were read as a descriptive representation, it would be re-anchored to cco:ont00000853 and this genus switched to analysis to preserve agreement.)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DataModel ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes conceptual and physical data models prescribing how data is to be structured and stored, producing a data model." ;
    skos:example "A data architect produces the conceptual and physical schema for the analytics store." ;
    bpot:apqcSourceText "Creation of conceptual and physical data models as an outline for data structure and storage." ;
    bpot:hierarchyID "13.7.7" ;
    bpot:pcfID "21462" .

bpot:P21463 a owl:Class ;
    rdfs:label "Review data models with stakeholders" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'review/confirm against the hypothesis' judges the models, distinct from the formulation genus of its create/refine siblings 21462/21464. Input is the data model; output is the descriptive bpo:DataModelReviewRecord." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DataModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DataModelReviewRecord ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that reviews data models with stakeholders against the original research question and hypothesis and produces a data model review record." ;
    skos:example "The team confirms with stakeholders that the model captures the hypothesized relationships." ;
    bpot:apqcSourceText "Confirm data models represent the hypothesis supporting the original research question" ;
    bpot:hierarchyID "13.7.8" ;
    bpot:pcfID "21463" .

bpot:P21464 a owl:Class ;
    rdfs:label "Refine data models" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation, aligned with sibling 21462 'Create data models' per sibling consistency (the create->review->refine triad: 21462 formulation, 21463 appraisal, 21464 formulation). Input is the data model review record; output is the revised Directive bpo:DataModel." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DataModelReviewRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DataModel ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that makes the required changes to a data model based on the stakeholder review and produces the revised data model." ;
    skos:example "The architect updates the schema to address the review findings." ;
    bpot:apqcSourceText "Make required changes to data model based upon review with stakeholders." ;
    bpot:hierarchyID "13.7.9" ;
    bpot:pcfID "21464" .

bpot:P21584 a owl:Class ;
    rdfs:label "Measure and benchmark" ;
    rdfs:comment "Models APQC process group 13.6 as a bounded enterprise measure-and-benchmark cycle. RE-ANCHORED from cco:ont00000345 (Act of Measuring) to cco:ont00000228 (Planned Act): Act of Measuring is too narrow a genus for a group aggregate whose children also include strategy formulation (13.6.1 bpo:P21585) and appraisal (13.6.2 bpo:P11072), not just measurement; the broad Planned Act covers the heterogeneous cycle. R5 / SIBLING-CONSISTENCY note: 'Defining and MANAGING measurement and benchmarking' carries a standing-function signal like the 13.1 (16378) and 13.5 (11073) group nodes that are capability-only; 13.6 is modeled with the 13.4 (P11074) DUAL precedent instead -- the standing capacity is bpo:BenchmarkingCapability (an Organization Capability, which the catalog could alternatively bridge), and this Planned Act is the bounded annual cycle that realizes it. bpo:BenchmarkingCapability carries an explicit obo:BFO_0000054 (realized in) link to this act so the dual model is coherent. Its APQC children are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21585 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11072 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20147 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that constitutes an organization's bounded enterprise cycle of defining performance strategy, measuring, and benchmarking the performance of its internal processes and of the organization as a whole against standards and other organizations." ;
    skos:example "An enterprise's annual performance measurement and benchmarking cycle covering process and organization-level metrics." ;
    bpot:apqcSourceText "Defining and managing measurement and benchmarking. Measure and benchmark the performance of internal processes, as well as the organization as a whole." ;
    bpot:hierarchyID "13.6" ;
    bpot:pcfID "21584" .

bpot:P21585 a owl:Class ;
    rdfs:label "Define and manage organizational performance strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (inlined) because its definitional output is a Directive ICE (strategy). The 'and manage'/implementation facet is carried by its child processes; the parent itself produces the strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalPerformanceStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11075 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21586 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes an organizational performance strategy prescribing how an organization measures, tracks, streamlines, and improves its internal performance." ;
    skos:example "A performance management office drafts and ratifies the firm's organizational performance strategy for the planning cycle." ;
    bpot:apqcSourceText "Creating and implementing a strategy for managing organizational performance. The strategy should include approaches for measuring, tracking, streamlining, and improving internal performance. It encompasses a blueprint for the tactical measurement of internal processes and work force improvement, in alignment with Employee Metrics Developed and Managed [10526]." ;
    bpot:hierarchyID "13.6.1" ;
    bpot:pcfID "21585" .

bpot:P21586 a owl:Class ;
    rdfs:label "Maintain enterprise measurement models" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfImprovement to bpo:ActOfFormulation. bpo:ActOfImprovement's differentia is modifying an existing PROCESS, SYSTEM, or CAPABILITY to raise its performance; but the object here is an Enterprise Measurement MODEL -- an Information Content Entity (Directive ICE), not a process/system/capability. The source verb 'Reviewing, evaluating, and updating' an ICE is the revision/recomposition of a directive artifact, i.e. formulation/information-processing, not improvement-of-a-system. Contrast sibling P11084, which correctly uses bpo:ActOfImprovement on a CAPABILITY. The existing measurement model is the definitional has-input; the revised model is the has-output (both Directive)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:EnterpriseMeasurementModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnterpriseMeasurementModel ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that reviews, evaluates, and recomposes an existing enterprise measurement model to align it with current and future goals, performance targets, and reporting needs." ;
    skos:example "An annual review updates the enterprise measurement model to reflect new strategic targets." ;
    bpot:apqcSourceText "Reviewing, evaluating, and updating enterprise measurement models. Align measurement models to current and future goals and performance targets, and make adjustments to support visibility and reporting needs across the organization." ;
    bpot:hierarchyID "13.6.1.2" ;
    bpot:pcfID "21586" .

bpot:P21587 a owl:Class ;
    rdfs:label "Monitor and manage EHS program" ;
    rdfs:comment "RE-ANCHORED from bpo:ActOfMonitoring to cco:ont00000228 (Planned Act): Act of Monitoring is too narrow a genus for this heterogeneous group aggregate, whose children are mostly NOT monitoring -- appraisal (13.8.3.1 bpo:P11193 cost-benefit), implementation (bpo:P11196/bpo:P11197 enacting directive programs), training (bpo:P11182), and generic support (bpo:P11195); only bpo:P11194 'Measure and report' is genuinely monitoring/measuring. Per the documented 13.6 precedent (bpo:P21584: 'Act of Measuring is too narrow a genus for a group aggregate whose children also include ... appraisal ... the broad Planned Act covers the heterogeneous cycle'), the 13.8.3 aggregate is anchored at the broad Planned Act. R5 DECISION retained: this is the repeatable bounded oversight CYCLE that realizes the standing bpo:EHSManagementCapability (which carries an explicit obo:BFO_0000054 realized-in link to this act), not the capability itself. Any monitoring facet lives only on the genuinely-monitoring child bpo:P11194. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11193 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11194 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11196 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11197 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11182 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11195 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that constitutes an organization's bounded EHS management and oversight cycle -- measuring and reporting EHS performance, appraising costs and benefits, implementing emergency-response and pollution-prevention programs, training employees, and providing support." ;
    skos:example "An EHS office runs the quarterly cycle of measuring, reporting, training, and supporting the EHS program." ;
    bpot:apqcSourceText "Managing the performance, costs and benefits of EHS. Measure and report the performance of EHS. Implement plans for emergency response and pollution prevention. Train and educate employees. Provide EHS support." ;
    bpot:hierarchyID "13.8.3" ;
    bpot:pcfID "21587" .

bpot:P21589 a owl:Class ;
    rdfs:label "Develop sustainability capability" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning): its definitional children produce Directive ICEs (requirement spec, goal spec, policy, measure spec, plan), so this aggregating planning parent is a bounded Formulation act, not a standing capability. (R5: 'Develop ... capability' here is the bounded composing effort; the standing capacity is bpo:SustainabilityManagementCapability, which is realized in this act.) Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21590 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21594 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21595 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21596 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21597 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that develops an organization's sustainability (ESG) capability by establishing its requirements, goals, policies, measures, and plans." ;
    skos:example "An ESG office stands up the sustainability program: requirements, goals, policies, measures, and plans." ;
    bpot:apqcSourceText "Developing sustainability (ESG) capabilities for the organization. Understand and communicate legal, regulatory, and social/environmental requirements. Establish policies, objectives, guidelines and approaches for ESG efforts and reporting." ;
    bpot:hierarchyID "13.9.1" ;
    bpot:pcfID "21589" .

bpot:P21590 a owl:Class ;
    rdfs:label "Identify sustainability requirements" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation, NOT bpo:ActOfIdentification despite the 'Identify' label: the output bpo:SustainabilityRequirementSpecification is a DIRECTIVE ICE, and per the GOLDEN PRINCIPLE the directive output forces a formulation genus, not identification. The 'document and communicate' clauses confirm composition of a prescriptive artifact. Its APQC children (the three Define-requirement tasks) are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityRequirementSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21591 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21592 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21593 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that identifies, documents, and composes the disclosure, governance, functional, and performance requirements for sustainability, producing a sustainability requirement specification." ;
    skos:example "An ESG analyst documents the disclosure, governance, and performance requirements the firm must satisfy." ;
    bpot:apqcSourceText "Identifying, documenting, and communicating sustainability requirements. Closely examine all standards and matters of compliance relating to ESG. Determine protocols or standards to comply with, set by regulatory agencies or the organizations stakeholders." ;
    bpot:hierarchyID "13.9.1.1" ;
    bpot:pcfID "21590" .

bpot:P21591 a owl:Class ;
    rdfs:label "Define sustainability disclosure requirements" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: the output is a Directive ICE (the disclosure-requirement facet of the sustainability requirement specification)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityRequirementSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines and aligns the sustainability disclosure requirements an organization must satisfy, producing a sustainability requirement specification." ;
    skos:example "An ESG team specifies the firm's sustainability disclosure obligations and aligns them to financial reporting." ;
    bpot:apqcSourceText "Defining and communicating sustainability disclosure requirements. Clarify and align disclosure requirements to other organizational reporting requirements and needs. Integrate preparation and reporting activities." ;
    bpot:hierarchyID "13.9.1.1.1" ;
    bpot:pcfID "21591" .

bpot:P21592 a owl:Class ;
    rdfs:label "Define sustainability governance requirements" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: Directive output (the governance-requirement facet of the sustainability requirement specification)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityRequirementSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines the governance requirements for sustainability -- structure, roles, and standards -- producing a sustainability requirement specification." ;
    skos:example "An ESG lead specifies the governance structure and roles for the sustainability program." ;
    bpot:apqcSourceText "Defining governance requirements for sustainability. Include structure, roles, alignment to organization models, processes and standards to be applied." ;
    bpot:hierarchyID "13.9.1.1.2" ;
    bpot:pcfID "21592" .

bpot:P21593 a owl:Class ;
    rdfs:label "Define sustainability functional and performance requirements" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: Directive output (the functional/performance-requirement facet of the sustainability requirement specification)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityRequirementSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines the functional and performance requirements for sustainability, aligned to ESG strategies and goals, producing a sustainability requirement specification." ;
    skos:example "An ESG analyst specifies the functional and performance requirements and roadmap for sustainability efforts." ;
    bpot:apqcSourceText "Defining functional and performance requirements for sustainability. Align with ESG strategies, goals, and the implementation of sustainability efforts across the organization, provide a roadmap and visibility to shared and collective requirements." ;
    bpot:hierarchyID "13.9.1.1.3" ;
    bpot:pcfID "21593" .

bpot:P21594 a owl:Class ;
    rdfs:label "Establish sustainability goals/objectives" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: 'Establish ... goals' composes a Directive artifact. Output is the Directive bpo:SustainabilityGoalSpecification." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityGoalSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the organization's measurable sustainability goals and targets, producing a sustainability goal specification." ;
    skos:example "An ESG committee sets organization-wide, measurable sustainability targets." ;
    bpot:apqcSourceText "Establishing organizational sustainability goals/objectives. Gather, align, and promote organization-wide sustainability goals that collectively address the overall sustainability requirements. Ensure the goals are measurable and have qualitative and quantitative targets." ;
    bpot:hierarchyID "13.9.1.2" ;
    bpot:pcfID "21594" .

bpot:P21595 a owl:Class ;
    rdfs:label "Create sustainability policies" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: creating policies/written procedures composes a Directive artifact. Output is the Directive bpo:SustainabilityPolicy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the written sustainability policies and procedures dictating how an organization will meet its sustainability requirements, producing a sustainability policy." ;
    skos:example "An ESG office issues the corporate sustainability policy and supporting procedures." ;
    bpot:apqcSourceText "Establishing, documenting, and communicating sustainability policies. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
    bpot:hierarchyID "13.9.1.3" ;
    bpot:pcfID "21595" .

bpot:P21596 a owl:Class ;
    rdfs:label "Define sustainability measures" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: this is the act of SPECIFYING measures (a Directive measure spec), NOT the act of measuring. FALSE-FRIEND caution observed: 'measures' could lure cco:ont00000345 'Act of Measuring', which would be wrong here (the act produces a measure SPEC, not measurement data). Act of Measuring is reserved for 21602, which actually collects data. Output is the Directive bpo:SustainabilityMeasureSpecification." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityMeasureSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes organization-wide sustainability measures -- including data-collection strategies, calculations, and reporting formats -- producing a sustainability measure specification." ;
    skos:example "An ESG analyst defines the organization-wide sustainability metrics and their data-collection and reporting formats." ;
    bpot:apqcSourceText "Defining sustainability measures. Provide organization-wide measures, to include data collection strategies, calculations, analytics, and reporting formats." ;
    bpot:hierarchyID "13.9.1.4" ;
    bpot:pcfID "21596" .

bpot:P21597 a owl:Class ;
    rdfs:label "Create sustainability plan(s)" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning): plan composition is planning/formulation. Output is the Directive bpo:SustainabilityPlan." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes sustainability plans for the organization, its functional units, and support services, aligned to sustainability requirements, goals, and governance, producing a sustainability plan." ;
    skos:example "An ESG team develops the enterprise and functional-unit sustainability plans." ;
    bpot:apqcSourceText "Creating sustainability plans. Develop and socialize sustainability plans for the organization, functional units, and support services. Ensure alignment to sustainability requirements, goals, and governance." ;
    bpot:hierarchyID "13.9.1.5" ;
    bpot:pcfID "21597" .

bpot:P21598 a owl:Class ;
    rdfs:label "Manage sustainability capability" ;
    rdfs:comment "R5 DECISION (explicit, sibling-consistent): modeled as a bounded Planned Act mirroring 13.1.4 bpo:P16392 'Manage process performance' -- a bounded administration cycle aggregating training/support/reporting children with no single definitional ICE output. Although 'Manage' carries a standing-function signal, the standing capacity is bpo:SustainabilityManagementCapability (which is realized in this act); this Planned Act is its repeatable bounded realization. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21599 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21600 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21601 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that administers distributed sustainability efforts across an organization by providing training, support, and reporting and oversight to functional units and support services." ;
    skos:example "Each period an ESG office trains, supports, and reports on the distributed sustainability efforts." ;
    bpot:apqcSourceText "Managing sustainability across the organization. Provide training, support, reporting, and oversight to the distributed sustainability efforts across functional units and support services." ;
    bpot:hierarchyID "13.9.2" ;
    bpot:pcfID "21598" .

bpot:P21599 a owl:Class ;
    rdfs:label "Provide sustainability training" ;
    rdfs:comment "Anchored to cco:ont00000234 (Act of Training, VERIFIED §6; parent cco:ont00000228) with explicit cco:ont00000228 co-parent so Gate C sees the Act anchor -- matching the sibling-analog bpo:P16393 'Provide process training'. Sustainability trainees/manager are definitional participants." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228,
        cco:ont00000234 ;
    skos:definition "An Act of Training in which sustainability education and enablement are imparted to an organization's personnel." ;
    skos:example "An ESG trainer runs sustainability enablement workshops for functional teams." ;
    bpot:apqcSourceText "Providing sustainability training and awareness. Plan, prepare, and oversee delivery of sustainability education and enablement activities." ;
    bpot:hierarchyID "13.9.2.1" ;
    bpot:pcfID "21599" .

bpot:P21600 a owl:Class ;
    rdfs:label "Provide sustainability support" ;
    rdfs:comment "Anchored to bpo:ActOfImplementation (under cco:ont00000228), mirroring the sibling-analog bpo:P16394 'Support process execution': coaching/SME support enacts rather than producing an ICE; no definitional has-output." ;
    rdfs:subClassOf bpot:ActOfImplementation ;
    skos:definition "An Act of Implementation that augments functional units and support teams with coaching, mentoring, and subject-matter-expert capacity to carry out sustainability projects and activities." ;
    skos:example "An ESG center of excellence embeds SMEs to help business units run sustainability initiatives." ;
    bpot:apqcSourceText "Providing support for sustainability activities. Augment functional units and support teams with coaching, mentoring, and SME capacity to perform sustainability projects and activities." ;
    bpot:hierarchyID "13.9.2.2" ;
    bpot:pcfID "21600" .

bpot:P21601 a owl:Class ;
    rdfs:label "Perform sustainability reporting" ;
    rdfs:comment "RE-ANCHORED from cco:ont00000366 (Act of Information Processing) to bpo:ActOfReporting (subClassOf cco:ont00000379 + cco:ont00000228): as the aggregating reporting parent its definitional act is reporting performance OUT ('Collect, analyze, and report sustainability performance to requirements. Align reporting across functional units and support teams') -- a DISSEMINATE signature. The COMPILE sub-step (assembling the statement) is delegated to child bpo:P21603 (which stays cco:ont00000366); measurement to bpo:P21602. The has_output ICE restriction (bpo:SustainabilityStatement) and both has-process-part restrictions are retained." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21602 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21603 ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that collects, analyzes, and reports sustainability performance against requirements, aligning reporting across functional units, and disseminates the resulting sustainability statement to its reporting audiences." ;
    skos:example "An ESG reporting team consolidates measured sustainability data into the annual statement and reports it across functional units." ;
    bpot:apqcSourceText "Conducting and supporting sustainability reporting. Collect, analyze, and report sustainability performance to requirements. Align reporting across functional units and support teams." ;
    bpot:hierarchyID "13.9.2.3" ;
    bpot:pcfID "21601" .

bpot:P21602 a owl:Class ;
    rdfs:label "Measure sustainability performance" ;
    rdfs:comment "RE-ANCHORED from cco:ont00000345 (Act of Measuring) to cco:ont00000636 (Act of Appraisal, VERIFIED in vendored CCO: 'An Act of Measuring that involves evaluating, assessing, ... or judging the ... condition, or quality of something'; rdfs:subClassOf cco:ont00000345 -> ... -> cco:ont00000228 Planned Act). The source is broader than pure quantification: 'Conduct audits and inspections. Evaluate results to requirements and targets. Identify and track resolution of gaps and variances' are canonical appraisal signals (assessment of condition/value against a standard) and form the bulk of the description, not an aside. Both Measuring and Appraisal yield Descriptive ICE outputs, so the GOLDEN PRINCIPLE does not disambiguate; the appraisal genus is chosen on the de-conflated verb. REJECTED the narrower cco:ont00000345 reading and the cited analog bpo:P10272 'Calculate performance measures' (pure quantification: 'Quantify ... record results'), which lacks the audit/evaluate-against-target language and so is not a clean precedent. The explicit cco:ont00000228 co-parent (now redundant via the appraisal->measuring->planned-act chain) is retained so Gate C sees the Act anchor without the CCO closure. Output is the descriptive bpo:SustainabilityPerformanceMeasurement (an appraisal record)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityPerformanceMeasurement ],
        cco:ont00000228,
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that collects and validates sustainability data, conducts audits and inspections, and evaluates sustainability performance against requirements and targets -- tracking gaps and variances -- producing a sustainability performance assessment." ;
    skos:example "An ESG auditor inspects emissions data, evaluates results against targets, and logs gaps for resolution." ;
    bpot:apqcSourceText "Measuring sustainability performance. Setup, collect, and validate sustainability data. Conduct audits and inspections. Evaluate results to requirements and targets. Identify and track resolution of gaps and variances." ;
    bpot:hierarchyID "13.9.2.3.1" ;
    bpot:pcfID "21602" .

bpot:P21603 a owl:Class ;
    rdfs:label "Prepare sustainability statements" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing), mirroring the sibling-analog bpo:P10275 'Prepare performance reports': input ICEs are assembled into an output Descriptive ICE. Input is bpo:SustainabilityPerformanceMeasurement; output is bpo:SustainabilityStatement. COMPILE-class (kept at 366): lead verb is 'Preparing ... statements' (composing the ICE); 'audiences' is cited only as the rationale for alignment/consistency, not as a share-action. This is the compile sub-step under the DISSEMINATE parent bpo:P21601 (re-anchored to bpo:ActOfReporting), giving a clean compile/disseminate split." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:SustainabilityPerformanceMeasurement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SustainabilityStatement ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that assembles measured sustainability performance into aligned, consistent sustainability statements for an organization's reporting audiences." ;
    skos:example "An ESG reporting analyst compiles the validated metrics into the published sustainability statement." ;
    bpot:apqcSourceText "Preparing sustainability statements. Given the multitude of potential audiences for reporting, alignment and consistency of sustainability statements provides clarity and reusability for those audiences." ;
    bpot:hierarchyID "13.9.2.3.2" ;
    bpot:pcfID "21603" .

bpot:PerformanceData skos:definition "A Descriptive Information Content Entity that describes consolidated metrics and trends collected on the performance of a process, function, or organization." .

bpot:PerformanceTrendAnalysis a owl:Class ;
    rdfs:label "Performance Trend Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the trends discerned in performance results over time." .

bpot:PreparedDataset a owl:Class ;
    rdfs:label "Prepared Dataset" ;
    rdfs:comment "Descriptive: the validated, analysis-ready dataset. Minted distinct from bpo:AnalyticsDataset (the collected/cleaned dataset of 13.7.4) so the parallel pipeline steps 20961 'Collect data' and 21461 'Prepare data' have distinct outputs. Output of bpo:P21461." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity consisting of a validated dataset created and verified to be fit for the initiation of analysis." .

bpot:ProcessFramework a owl:Class ;
    rdfs:label "Process Framework" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the required business processes of an Organization, their key elements, and how they should interact." .

bpot:ProcessPerformanceReport a owl:Class ;
    rdfs:label "Process Performance Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the measured performance of business processes against defined performance indicators." .

bpot:ProcessScopeStatement a owl:Class ;
    rdfs:label "Process Scope Statement" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the extent and limits of a business process in terms of the activities and tasks it comprises." .

bpot:ProjectScopeStatement a owl:Class ;
    rdfs:label "Project Scope Statement" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the goals, deliverables, tasks, costs, deadlines, and boundaries of a business project." .

bpot:QualityImprovementRecommendation a owl:Class ;
    rdfs:label "Quality Improvement Recommendation" ;
    rdfs:comment "Directive: a recommendation that prescribes actions for management to consider." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes recommended measures for improving the quality plan based on test results." .

bpot:StakeholderNeedsStatement a owl:Class ;
    rdfs:label "Stakeholder Needs Statement" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the needs and requirements gathered from stakeholders prior to conducting analytics." .

bpot:SustainabilityPerformanceMeasurement a owl:Class ;
    rdfs:label "Sustainability Performance Measurement" ;
    rdfs:comment "Descriptive appraisal record. Output of bpo:P21602 'Measure sustainability performance' (an Act of Appraisal) and has-input of bpo:P21603." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes collected and validated sustainability performance data appraised against requirements and targets, including audit findings and identified gaps and variances." .

bpot:SustainabilityStatement a owl:Class ;
    rdfs:label "Sustainability Statement" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an Organization's sustainability performance prepared for reporting to its audiences." .

bpot:BenchmarkAnalysis a owl:Class ;
    rdfs:label "Benchmark Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a comparison of an Organization's performance internally or against external organizations." .

bpot:ChangeManagementPlan a owl:Class ;
    rdfs:label "Change Management Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the reasons, type, scope, team, and communications for managing an Organization's change." .

bpot:CommunicationPlan a owl:Class ;
    rdfs:label "Communication Plan" ;
    rdfs:comment "Shared across 13.2.3.3.4, 13.4.2.4, 13.5.1.7." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the goals, audiences, and tools for imparting or exchanging information relevant to a project, change, or initiative." .

bpot:CorrectiveAndPreventiveActionSpecification a owl:Class ;
    rdfs:label "Corrective and Preventive Action Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the corrective and preventive actions to eliminate the cause of a detected non-conformity and prevent its recurrence." .

bpot:DataModel a owl:Class ;
    rdfs:label "Data Model" ;
    rdfs:comment "Directive: a data model prescribes how data is to be structured and stored (a model/blueprint), per CCO's notion of prescription for Continuants. CAUTION (false friend): this is the Directive (965) design/specification sense of 'model' (a blueprint for structuring data); a statistical, learned, or predictive 'model' that DESCRIBES patterns in data is a separate Descriptive (853) or Predictive (626) ICE, not this class." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the conceptual and physical structure and storage of data." .

bpot:EnterpriseMeasurementModel a owl:Class ;
    rdfs:label "Enterprise Measurement Model" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which processes to measure, which measures to use, how often to measure, and the measurement targets across an enterprise." .

bpot:KMMethodologySpecification a owl:Class ;
    rdfs:label "KM Methodology Specification" ;
    rdfs:comment "Covers 'KM approaches' (policies, procedures, guidelines) developed and implemented in 13.5.3/13.5.4." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the core procedures and methodologies for developing, planning, executing, and improving knowledge management." .

bpot:PerformanceMeasurement a owl:Class ;
    rdfs:label "Performance Measurement" ;
    rdfs:comment "Genus is generic Descriptive ICE rather than CCO Measurement ICE leaf, per GOLD house style of anchoring at the descriptive parent." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the quantified performance of a process or organization relative to defined indicators." .

bpot:ProcessControlPointSpecification a owl:Class ;
    rdfs:label "Process Control Point Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes checkpoints in a business process that prevent its continuation unless stated requirements are satisfied." .

bpot:ProcessModel a owl:Class ;
    rdfs:label "Process Model" ;
    rdfs:comment "Documentation/representation of an as-is or to-be process (descriptive). Distinct from bpo:ProcessFramework, which prescribes the required process set." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes what a business entity does, who is responsible, the standard to which a business process should be completed, and how its success is determined." .

bpot:ProcessOwner a owl:Class ;
    rdfs:label "Process Owner" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ProcessOwnerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a process-owner role." .

bpot:ProjectPlan skos:definition "A Directive Information Content Entity that prescribes the resources, roles, IT requirements, training, communication, reward approaches, and launch for executing a business project." .

bpot:TrainingPlan rdfs:comment "Shared across 13.2.3.3.4, 13.4.2.3, 13.5.1.7." ;
    skos:definition "A Directive Information Content Entity that prescribes the actions for equipping personnel with the skills and abilities to fulfill their roles." .

bpot:GapAndNeedsAnalysis a owl:Class ;
    rdfs:label "Gap and Needs Analysis" ;
    rdfs:comment "Shared across 13.5.2.3 and the gap-analysis work in 13.6.2.4." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the gaps and needs identified by comparing actual performance or capability against a desired or standard reference." .

bpot:NonconformanceRecord a owl:Class ;
    rdfs:label "Nonconformance Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a closed non-conformance, including its documented root causes and the corrective and preventive actions taken." .

bpot:ProcessGovernanceFramework a owl:Class ;
    rdfs:label "Process Governance Framework" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an Organization's approach, standards, and priorities for governing business process management." .

bpot:QualityPlan a owl:Class ;
    rdfs:label "Quality Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes how critical-to-quality characteristics will be achieved, controlled, ensured, and managed throughout a product or service lifecycle." .

bpot:QualityTestSummary a owl:Class ;
    rdfs:label "Quality Test Summary" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the major facts, figures, and conclusions of quality test results." .

bpot:SustainabilityRequirementSpecification a owl:Class ;
    rdfs:label "Sustainability Requirement Specification" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the disclosure, governance, functional, and performance requirements an Organization must satisfy for sustainability (ESG)." .

bpot:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of the performance of people, processes, or other areas the Organization wants to benchmark or track." .

bpot:RoleDefinitionSpecification a owl:Class ;
    rdfs:label "Role Definition Specification" ;
    rdfs:comment "Shared across 13.4.2.8 'Establish/Clarify new roles' and 13.2.3.3.1 'Define roles and resources'." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the new roles and responsibilities to be assigned to personnel." .

bpot:PerformanceIndicatorSpecification rdfs:comment "Shared across 13.1.4.3, 13.2.3.1.5, 13.6.3.1, 13.8.3.2 -- one definition of 'measures/indicators' as a prescriptive artifact." ;
    skos:definition "A Directive Information Content Entity that prescribes the indicators and measures used to evaluate the performance of a process, project, program, or organization." .

bpot:QualityTestDataRecord a owl:Class ;
    rdfs:label "Quality Test Data Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the data and results collected from testing organizational outputs against the quality plan." .

bpot:Stakeholder rdfs:comment "Where the stakeholder is itself an Organization (e.g. a partner firm), use cco:ont00001180 as the genus instead." ;
    skos:definition "An Agent that bears a stakeholder role with respect to an Organization's initiative." .

