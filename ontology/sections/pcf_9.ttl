bpot:SupplierRole rdfs:comment "Used for accounts-payable counterparties (vendors) in 9.6." .

bpot:Treasurer a owl:Class ;
    rdfs:label "Treasurer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:TreasurerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a treasurer role and manages an Organization's cash, liquidity, debt, investments, and financial risk." .

bpot:TreasuryManagementCapability a owl:Class ;
    rdfs:label "Treasury Management Capability" ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to manage cash, liquidity, debt, investments, and financial risk." .

<https://fandaws.com/ontology/bpot/sections/pcf_9> a owl:Ontology ;
    dcterms:creator "Aaron Damiano" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://fandaws.com/ontology/bpo/slice/9.0>,
        "APQC Process Classification Framework (Cross-Industry)" ;
    dcterms:title "Business Process Ontology -- PCF 9.0 Manage Financial Resources" ;
    rdfs:comment "Reality layer for APQC PCF category 9.0: the process universals that pass the bounded-occurrent test, the organization capabilities, roles and information content entities they use." ;
    owl:versionIRI <https://fandaws.com/ontology/bpot/0.0.0/sections/pcf_9.ttl> ;
    owl:versionInfo "0.0.0" .

bpot:AccountApprovalDecision a owl:Class ;
    rdfs:label "Account Approval Decision" ;
    rdfs:comment "Minted locally: Directive (not Descriptive) because a decision prescribes rather than describes. Distinct from the shared bpo:CreditAssessment (the Descriptive judgement underlying it) and from bpo:PaymentApproval (a per-payment approval)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes whether to approve or decline the opening of a new customer credit account." ;
    skos:example "A recorded decision to approve a new customer's credit account at a $10,000 limit." .

bpot:AccountantRole a owl:Class ;
    rdfs:label "Accountant Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with recording, classifying, and reporting an Organization's financial transactions." .

bpot:AccountingCapability a owl:Class ;
    rdfs:label "Accounting Capability" ;
    rdfs:subClassOf cco:ont00001379 ;
    skos:definition "An Agent Capability that inheres in an Agent in virtue of its capacity to record, classify, reconcile, and report financial transactions." .

bpot:ActOfRemuneration rdfs:comment "PROPOSE-EXT (D9). Inlines the verified CCO leaf cco:ont00000449 (Act of Remuneration, subClassOf cco:ont00001334 Act of Purchasing subClassOf cco:ont00000836) for payroll rows whose APQC text is salary/compensation disbursement to employees -- a closer genus than bpo:ActOfFinancialTransaction. NOT used for payroll-TAX remittance to a government authority (the recipient is not the compensated employee; those keep bpo:ActOfFinancialTransaction). cco:ont00000228 co-asserted because 449 is outside the standalone-SHACL S2 process-anchor allowlist." .

bpot:ApprovalLimitSpecification a owl:Class ;
    rdfs:label "Approval Limit Specification" ;
    rdfs:comment "Minted locally: more specific than bpo:FinancialPolicy/bpo:FinancialProcedure (numeric approval thresholds). Directive per GOLDEN PRINCIPLE (it prescribes, not describes)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the monetary thresholds and conditions under which financial approvals may be granted." ;
    skos:example "A schedule stating that purchases over USD 50,000 require CFO sign-off." .

bpot:AssetDeploymentPlan a owl:Class ;
    rdfs:label "Asset Deployment Plan" ;
    rdfs:comment "Minted: shared vocab has bpo:FinancialPlan/bpo:Budget but no class specific to asset-resource allocation. Directive because it prescribes a deployment." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes how asset resources are allocated across processes for optimal utilization." ;
    skos:example "A plan reassigning two machines from line A to line B for the next quarter." .

bpot:AuditJudgement a owl:Class ;
    rdfs:label "Invoice Audit Judgement" ;
    rdfs:comment "Minted locally for 9.6.1.3: descriptive output of the invoice/AP-data audit." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the findings of an audit of invoices and key accounts-payable data." .

bpot:Auditor a owl:Class ;
    rdfs:label "Auditor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:AuditorRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears an auditor role and independently examines an Organization's financial records or controls." .

bpot:AuditorRole a owl:Class ;
    rdfs:label "Auditor Role" ;
    rdfs:comment "Covers both internal and external auditors; the bearer (a Person or Organization) carries the role." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of independently examining and attesting to an organization's records, controls, or compliance." .

bpot:BankFeeAnalysis a owl:Class ;
    rdfs:label "Bank Fee Analysis" ;
    rdfs:comment "Local mint for 9.7.2.8. Descriptive: it represents a judgement of fee levels rather than prescribing them." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a study and negotiated determination of the fees a bank charges for its services." .

bpot:BankingPartner a owl:Class ;
    rdfs:label "Banking Partner" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:BankingPartnerRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a banking partner role and provides banking, financial-intermediary, or custodial services to a focal Organization." .

bpot:BankingPartnerRole a owl:Class ;
    rdfs:label "Banking Partner Role" ;
    rdfs:comment "Used for banks and financial intermediaries in treasury and international-funds processes (9.7, 9.10)." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of providing banking, financial-intermediary, or custodial services to a focal Organization." .

bpot:CashPosition a owl:Class ;
    rdfs:label "Cash Position" ;
    rdfs:comment "Local mint for 9.7.2.1; reconciliation input/output not covered by the shared vocabulary." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the reconciled balance of an organization's available cash funds at a point in time." .

bpot:ChartOfAccounts a owl:Class ;
    rdfs:label "Chart of Accounts" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that enumerates and classifies the accounts used in an Organization's general ledger." .

bpot:CodeOfEthics a owl:Class ;
    rdfs:label "Code of Ethics" ;
    rdfs:comment "Minted for 9.8. Directive (cco:ont00000965), not Descriptive, because a code prescribes conduct rather than describing it." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the standards of ethical conduct expected of an organization's personnel." ;
    skos:example "A published corporate code of conduct circulated to all employees." .

bpot:ControlResponsibilityAssignment a owl:Class ;
    rdfs:label "Control Responsibility Assignment" ;
    rdfs:comment "Minted for 9.8. Directive because it prescribes who is accountable for what. Output of both 'establish board/audit committee' and 'assign roles and responsibility for internal controls'." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the roles, responsibilities, and accountabilities of agents for the effectiveness of an organization's internal controls and financial reporting." ;
    skos:example "A RACI matrix assigning internal-control duties to the audit committee and process owners." .

bpot:CorrectiveActionRecord a owl:Class ;
    rdfs:label "Corrective Action Record" ;
    rdfs:comment "Minted for 9.8.2.2. Descriptive: it records what remediation was performed. The remediation act itself is a Planned Act, not an information-processing act." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the corrective measures taken to rectify deficiencies in an organization's internal controls." ;
    skos:example "A remediation log noting that a missing approval control was reinstated for the procurement workflow." .

bpot:CostDriverMeasurement a owl:Class ;
    rdfs:label "Cost-Driver Measurement" ;
    rdfs:comment "Minted: distinct from bpo:CostDriverSpecification (which names the drivers) - this records their quantified values. Descriptive measurement record." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the measured magnitudes of identified cost drivers." ;
    skos:example "A table giving 12,400 machine-hours and 830 setups for the period." .

bpot:CreditScoreRequirementSpecification a owl:Class ;
    rdfs:label "Credit Score Requirement Specification" ;
    rdfs:comment "Directive (not Descriptive): a requirement prescribes a threshold the applicant must satisfy, rather than describing a projected future state. Minted for bpo:P14188 ('Planning credit score requirements based on established credit policies'); contrast bpo:FinancialForecast, which is a predictive description of income/cash flows and does not denote a credit-score requirement." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the minimum credit scores an applicant must meet for credit to be extended." .

bpot:CriticalActivityDetermination a owl:Class ;
    rdfs:label "Critical-Activity Determination" ;
    rdfs:comment "Minted: no shared-vocab class registers the essential/non-cuttable activities. Descriptive register of a determination." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records which finance activities are indispensable and where costs cannot be reduced." ;
    skos:example "A register marking payroll and statutory reporting as indispensable." .

bpot:CurrencyConversionRecord a owl:Class ;
    rdfs:label "Currency Conversion Record" ;
    rdfs:comment "Minted for group 9.11. Output of 9.11.4. Descriptive record of a performed conversion." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the conversion of a monetary amount from one currency to another at an identified exchange rate." ;
    skos:example "A record converting 100,000 yen to US dollars at the day's spot rate." .

bpot:CustomsInformation a owl:Class ;
    rdfs:label "Customs Information" ;
    rdfs:comment "Minted for group 9.11. The ICE transferred to customs in 9.11.6 (an Act of Communication)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the trade particulars mandated by law to be disclosed to the customs authority that controls and collects duties on the international exchange of products and services." ;
    skos:example "An electronic customs declaration submitted with a shipment." .

bpot:DutyCalculation a owl:Class ;
    rdfs:label "Duty Calculation" ;
    rdfs:comment "Minted for group 9.11. Output of 9.11.5. Descriptive: it represents a computed amount owed, it does not prescribe an action." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the excise duty computed as payable on a given international-trade transaction." ;
    skos:example "A line-item computation of customs duty owed on an imported shipment." .

bpot:EarningsInformation a owl:Class ;
    rdfs:label "Employee Earnings Information" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the structure and components of an employee's salary or wages held in a central repository." ;
    skos:example "The salary-structure record (base, allowances, bonus components) for one employee." .

bpot:EmployeeTaxStatement a owl:Class ;
    rdfs:label "Employee Annual Tax Statement" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the tax withheld from an employee's salary over a year, issued to the employee for reference or refund." ;
    skos:example "A year-end wage-and-tax statement provided to each employee." .

bpot:EmployeeUtilizationReport a owl:Class ;
    rdfs:label "Employee Utilization Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the productive (billable) hours of employees relative to their available hours." ;
    skos:example "A utilization dashboard showing each consultant's billable-hour ratio." .

bpot:ExceptionResolutionRecord a owl:Class ;
    rdfs:label "Payable Exception Resolution Record" ;
    rdfs:comment "Minted locally for 9.6.1.7: descriptive output of researching/resolving payable exceptions." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the investigation and disposition of an atypical or inconsistent accounts-payable situation." .

bpot:ExposureLimitResolution a owl:Class ;
    rdfs:label "Exposure Limit Resolution" ;
    rdfs:comment "Local mint for 9.7.5.4.2. Directive because a resolution prescribes the corrective course of action." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the settlement of a customer exposure-limit violation." .

bpot:FinanceFunctionRole a owl:Class ;
    rdfs:label "Finance Function Role" ;
    rdfs:comment "Shared across 9.0. Borne by the independent continuant (the finance unit or officer), never by an ICE." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent or organizational unit in virtue of being tasked with carrying out the financial management activities of an Organization." .

bpot:FinancialInstrument a owl:Class ;
    rdfs:label "Traded Financial Instrument" ;
    rdfs:comment "Specializes the verified CCO class cco:ont00000537 (a legally-sanctioned tradeable Material Artifact) for the treasury and trade instruments in 9.7, 9.10, 9.11." ;
    rdfs:subClassOf obo:BFO_0000040,
        cco:ont00000537 ;
    skos:definition "A Financial Instrument such as a bond, currency holding, derivative, or marketable security that is held, traded, or hedged in treasury operations." .

bpot:FinancialJustification a owl:Class ;
    rdfs:label "Financial Justification" ;
    rdfs:comment "Business case substantiating project approval in 9.4." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the projected costs and benefits supporting or opposing a capital project or investment." .

bpot:FixedAssetProjectAccountingCapability a owl:Class ;
    rdfs:label "Fixed-Asset Project Accounting Capability" ;
    rdfs:comment "Reality-layer node for APQC process group 9.4 (PCF 10731). Modeled as a standing function (R5/R6), not a bounded process: 'Manage ... project accounting' over many years has no natural end. Realized in its bounded child acts P10751 and P10752. Carries no bpo:pcfID per the IRI scheme (capabilities are supporting classes)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10751 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10752 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to plan, approve, and account for large capital (fixed-asset) projects over their multi-year lifecycle." ;
    skos:example "A corporation's standing ability to run capital-project accounting across its portfolio of multi-year investments." .

bpot:GovernanceBody a owl:Class ;
    rdfs:label "Governance Body" ;
    rdfs:comment "Participant minted for bpo:P10914 (the board of directors and audit committee that the establishment act constitutes). Modeled as an Organization (independent continuant) that bears the governance mandate, never as an ICE." ;
    rdfs:subClassOf cco:ont00001180 ;
    skos:definition "An Organization constituted within or over a focal Organization to direct, oversee, or assure its activities, such as a board of directors or an audit committee." .

bpot:HedgingStrategy a owl:Class ;
    rdfs:label "Hedging Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the positions an Organization will take to offset exposure to financial risk." .

bpot:ImportExportControlCapability a owl:Class ;
    rdfs:label "Import-Export Control Capability" ;
    rdfs:comment "Models APQC 9.11.2 'Control exports and imports' (PCF 14091). R5: 'overseeing and directing the flow of trade' is a standing control function with no natural end -- a capability, not a bounded process. Realized in the global-trade-servicing acts (R6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17059 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in the ongoing oversight and direction of the flow of trade into and out of an organization so as to secure financial gains." ;
    skos:example "A trade-compliance department's standing capacity to govern what the firm imports and exports." .

bpot:InternalControlCapability a owl:Class ;
    rdfs:label "Internal Control Capability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10762 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P21574 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10764 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to establish, operate, monitor, and report on internal controls over financial reporting and operations." .

bpot:InternationalFundsManagementCapability a owl:Class ;
    rdfs:label "International Funds Management Capability" ;
    rdfs:comment "Models APQC process group 9.10 (PCF 10737), a standing 'Manage...' function. Per R5/R6 it is an Organization Capability (cco:ont00000568) realized in its four child acts, NOT a process: it has no identifiable single beginning and end." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10767 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10768 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10769 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10770 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of monitoring international rates and currency exposure, managing cross-border fund transfers, hedging currency, and reporting foreign-exchange results so as to manage and consolidate funds across an enterprise's operating units." ;
    skos:example "An enterprise treasury team's ongoing program for consolidating subsidiary cash and managing cross-border currency risk." .

bpot:InvestmentPolicy a owl:Class ;
    rdfs:label "Investment Policy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the principles governing an Organization's investment decisions." .

bpot:LeaveRecord a owl:Class ;
    rdfs:label "Leave Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the paid and unpaid leave allowed to and taken by employees." ;
    skos:example "A monthly report of vacation, sick, and unpaid leave balances per employee." .

bpot:LetterOfCredit a owl:Class ;
    rdfs:label "Letter of Credit" ;
    rdfs:comment "Directive: it commits a bank to pay under stated conditions (9.11).",
        "FALSE-FRIEND note: this class models the CONTENT of a letter of credit (the bank's prescriptive payment commitment), hence Directive ICE -- it is the 9.11 process output (has output cco:ont00001986). It does NOT model the document/artifact that bears this content, nor the trade-finance sense in which a letter of credit is a negotiable instrument; that artifact, if needed, is a separate Material Artifact (cco:ont00000995). Do not re-anchor this ICE class to cco:ont00000537." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity issued by a bank that prescribes payment to a seller upon satisfaction of specified delivery conditions." .

bpot:LifeCycleCostAnalysis a owl:Class ;
    rdfs:label "Life-Cycle Cost Analysis" ;
    rdfs:comment "Minted: narrower than bpo:CostAnalysis, which is not stage/life-cycle structured. Descriptive." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the revenue and cost incurred at each stage of a product or process life cycle." ;
    skos:example "A cradle-to-grave cost breakdown for a product across design, production, and disposal." .

bpot:NewProductEvaluation a owl:Class ;
    rdfs:label "New-Product Evaluation" ;
    rdfs:comment "Minted: distinct from bpo:ProfitabilityAnalysis (general profit study) - this is the appraisal of a prospective product's viability. Descriptive judgement." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of the demand and projected profitability of a new product in a market." ;
    skos:example "A go-to-market assessment of a proposed product line for a target segment." .

bpot:P10728 a owl:Class ;
    rdfs:label "Perform planning and management accounting (capability)" ;
    rdfs:comment "R5 = capability (R6). The APQC process group denotes a standing finance function with no identifiable single beginning and end, so it is an Organization Capability (cco:ont00000568), not a process. Its four child Processes are the acts in which it is realized." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10738 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10739 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10740 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10741 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in a finance function in virtue of its capacity to plan, budget, account for, and evaluate financial performance, realized in acts of management accounting." ;
    skos:example "A corporation's standing management-accounting function exercised continuously across fiscal periods." ;
    bpot:apqcSourceText "Determining different stages of the planning process and accounting. Classify, determine, analyze, interpret, and communicate information to make up-to-date business decisions for better management and control functions." ;
    bpot:hierarchyID "9.1" ;
    bpot:pcfID "10728" .

bpot:P10729 a owl:Class ;
    rdfs:label "Perform revenue accounting" ;
    rdfs:comment "Models APQC process group 9.2 as a bounded occurrent. Its APQC level-3 children are process parts (cco:ont00001777), not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10742 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10743 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10744 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10745 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10746 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that reviews a period's revenue-related transactions and final-account entries and produces financial data comparing revenue targets to realized results." ;
    skos:example "A finance team's annual revenue close in which the year's customer transactions are reviewed to examine profits." ;
    bpot:apqcSourceText "Comparing revenue targets to reality. Review all transactions and entries passed in final accounts in a year in order to examine profits." ;
    bpot:hierarchyID "9.2" ;
    bpot:pcfID "10729" .

bpot:P10730 a owl:Class ;
    rdfs:label "Perform general accounting and reporting" ;
    rdfs:comment "Models APQC process group 9.3 as a bounded occurrent (the accounting-and-reporting cycle). Its APQC children are process parts (cco:ont00001777), not subclasses. 9.3.1 is a standing function modeled as a capability, hence absent from the partonomy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10748 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10749 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10750 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records an organization's financial transactions and produces financial statements describing its activities in accordance with accounting concepts and principles." ;
    skos:example "A company's fiscal-period close culminating in a published set of financial statements." ;
    bpot:apqcSourceText "Making statements about business activities and functions. Prepare financial statements (balance sheet, income statement, statement of cash flows, and statement of stockholders' equity) according to accounting concepts and principles." ;
    bpot:hierarchyID "9.3" ;
    bpot:pcfID "10730" .

bpot:P10732 a owl:Class ;
    rdfs:label "Process payroll" ;
    rdfs:comment "Models APQC group 9.5 as a bounded payroll-run occurrent. Its three APQC children are process parts, not subclasses. The disbursed monetary payment is a MATERIAL participant (obo:BFO_0000057, not has output: cco:ont00001986 has output is reserved for ICE outputs); time records and tax filings are produced by its parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10753 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10754 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10755 ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that disburses pay to an organization's employees by reporting their time, managing their pay, and processing their payroll taxes, producing monetary payments to employees and to tax authorities." ;
    skos:example "A company's biweekly payroll cycle that pays employees and remits withheld taxes." ;
    bpot:apqcSourceText "Handling reporting time, managing pay, and processing taxes from salaries. Pay employees. Withhold taxes. Confirm the correct funds are paid to the correct government agency." ;
    bpot:hierarchyID "9.5" ;
    bpot:pcfID "10732" .

bpot:P10733 a owl:Class ;
    rdfs:label "Process accounts payable and expense reimbursements" ;
    rdfs:comment "Models APQC process group 9.6 as a bounded occurrent (the organization's payables-and-reimbursement payment cycle); its APQC children are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10756 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10757 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20929 ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that handles bills and reimbursements owed by an organization and disburses payment for goods or services taken or used on its behalf." ;
    skos:example "A finance team's monthly run that settles supplier invoices, employee reimbursements, and corporate-card balances." ;
    bpot:apqcSourceText "Handling bills and reimbursements to be made. Make payments for goods or services taken or used on behalf of the organization." ;
    bpot:hierarchyID "9.6" ;
    bpot:pcfID "10733" .

bpot:P10734 a owl:Class ;
    rdfs:label "Manage treasury operations" ;
    rdfs:comment "R5: standing treasury function with no natural end -> Organization Capability (R6), not a process. Sub-functions and their underlying acts realize it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10885 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10893 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P14079 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12974 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of managing an organization's investments, financial assets, liquidity, and financial risk." ;
    skos:example "A corporate treasury department's ongoing stewardship of the firm's cash, debt, investments, and hedging." ;
    bpot:apqcSourceText "Managing business's investments in trading in bonds, currencies, financial derivatives, etc. Manage the financial assets and holdings of the organization. Optimize the organization's liquidity. Invest excess cash. Reduce financial risks." ;
    bpot:hierarchyID "9.7" ;
    bpot:pcfID "10734" .

bpot:P10758 a owl:Class ;
    rdfs:label "Manage treasury policies and procedures" ;
    rdfs:comment "R5: standing governance function -> Organization Capability (R6). Its discrete establish/develop/monitor/audit/revise children are processes that realize it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10885 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10886 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10887 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10888 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10889 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10890 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10891 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10892 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of establishing, developing, monitoring, auditing, and revising the policies and procedures governing treasury operations." ;
    skos:example "A treasury policy office continuously maintaining the firm's investment rulebook." ;
    bpot:apqcSourceText "Managing rules and regulations for investments in trading in bonds, currencies, financial derivatives, etc. Establish policies and procedures for investments made. Optimize liquidity in treasury operations." ;
    bpot:hierarchyID "9.7.1" ;
    bpot:pcfID "10758" .

bpot:P10759 a owl:Class ;
    rdfs:label "Manage cash" ;
    rdfs:comment "R5: standing cash-management function -> Organization Capability (R6). Discrete reconcile/transfer/forecast/report children are processes that realize it; standing sub-functions (cash equivalents, cash flows, banking relationships) are themselves capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10893 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10895 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10896 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10898 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10900 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of reconciling cash positions, transferring funds, forecasting cash flow, and accounting for and reporting on cash activity." ;
    skos:example "A cash-management team's ongoing oversight of corporate liquidity." ;
    bpot:apqcSourceText "Taking care of all cash-related activities in the business. Manage and reconcile cash positions. Manage cash equivalents. Process and oversee electronic fund transfers. Develop cash flow forecasts. Manage cash flows. Produce cash management accounting transactions and reports. Manage and oversee banking relationships. Analyze, negotiate, resolve, and confirm bank fees." ;
    bpot:hierarchyID "9.7.2" ;
    bpot:pcfID "10759" .

bpot:P10760 a owl:Class ;
    rdfs:label "Manage in-house bank accounts" ;
    rdfs:comment "R5: standing in-house-bank function -> Organization Capability (R6). Discrete borrowing/payment/interest/statement children are processes that realize it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10902 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10903 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10904 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10905 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10906 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10907 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of operating an internal banking structure providing financial services to the corporation and its subsidiaries." ;
    skos:example "A corporate in-house bank settling intercompany balances for the group." ;
    bpot:apqcSourceText "Managing financial services provided by an in-house bank structure in the corporation that is operating like a commercial bank." ;
    bpot:hierarchyID "9.7.3" ;
    bpot:pcfID "10760" .

bpot:P10761 a owl:Class ;
    rdfs:label "Manage debt and investment" ;
    rdfs:comment "R5: standing portfolio-management function -> Organization Capability (R6). Discrete establish/process/produce children are processes that realize it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P14079 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10911 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10912 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10913 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P14210 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of establishing investment policy and processing the organization's debt and investment transactions." ;
    skos:example "A treasury investment desk balancing the firm's debt and investment book." ;
    bpot:apqcSourceText "Taking care of the organization's financial position. Manage its loans or debts from different sources and investments. Leverage the most profitable options to balance the financial position in the market." ;
    bpot:hierarchyID "9.7.4" ;
    bpot:pcfID "10761" .

bpot:P10765 a owl:Class ;
    rdfs:label "Develop tax strategy and plan" ;
    rdfs:comment "R5=process. Genus bpo:ActOfFormulation (planning -> directive output) per GOLDEN PRINCIPLE. Assessment of tax impact of activities is a typical sub-step, recorded here rather than as a restriction (Phase-3 necessity)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10927 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10928 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10929 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that sets targets for the organization's periodic tax liabilities and produces a tax strategy prescribing how those liabilities are to be planned and met." ;
    skos:example "A tax department sets next year's effective-tax-rate target and documents the plan to achieve it." ;
    bpot:apqcSourceText "Setting targets for periodic tax liabilities. Assess the tax impact of various activities such as the acquisition or disposal of fixed assets or a deliberate change in number of employee." ;
    bpot:hierarchyID "9.9.1" ;
    bpot:pcfID "10765" .

bpot:P10766 a owl:Class ;
    rdfs:label "Process taxes" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to the neutral cco:ont00000228 (Planned Act), and the has output bpo:TaxReturn existential DROPPED. Two coupled defects fixed: (1) GENUS/OUTPUT disagreement -- bpo:ActOfFinancialTransaction is a money-transfer act, yet the sole asserted output was bpo:TaxReturn, a Descriptive reporting product (the 'pay' genus and the 'file' output describe two different acts). (2) The node is a standing file-and-pay umbrella: the source ('Processing the taxes ... corporate, property, excise, service taxes') and example ('runs the quarterly cycle that files and pays all taxes') span both filing and payment, and NONE of its seven children is itself a bpo:ActOfFinancialTransaction (10930 Formulation, 10931/10932/10936 Reporting, 10933/10934 Accounting, 10935 Monitoring) -- so the transaction genus was not exemplified by any part. No single definitional output spans both filing and payment, so the umbrella carries none; bpo:TaxReturn (filing) and Monetary Payment (payment) are produced by the respective children. REJECTED candidate bpo:ActOfFinancialTransaction (over-commits to the 'pay' facet)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10930 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10931 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10932 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10933 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10934 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10935 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10936 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that carries out the organization's tax obligations in line with the regional taxation structure -- encompassing corporate, property, excise, and service taxes -- and that has as process parts the planning, filing, accounting, monitoring, and payment of those taxes." ;
    skos:example "A finance shared-service center runs the quarterly cycle that files and pays all corporate and indirect taxes." ;
    bpot:apqcSourceText "Processing the taxes of the organization in line with the regional taxation structure, including corporate, property, excise, and service taxes." ;
    bpot:hierarchyID "9.9.2" ;
    bpot:pcfID "10766" .

bpot:P10788 a owl:Class ;
    rdfs:label "Manage continuous cost improvement (capability)" ;
    rdfs:comment "R5 = capability (R6). 'Continuous/regularly' denotes a standing function with no identifiable single beginning and end, so it is an Organization Capability (cco:ont00000568), not a bounded process. It is realized in cost-improvement acts and is realized-in-attached to its parent 10741 (the capability is realized in the process, per BFO_0000054 domain=realizable/range=process)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10741 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to regularly improve cost distribution, realized in recurring acts of cost reduction." ;
    skos:example "A standing kaizen-style cost-improvement program run every quarter." ;
    bpot:apqcSourceText "Conducting activities to improve cost distribution regularly. Follow or adopt different ways of reducing costs." ;
    bpot:hierarchyID "9.1.4.7" ;
    bpot:pcfID "10788" .

bpot:P10815 a owl:Class ;
    rdfs:label "Negotiate service-level agreements" ;
    rdfs:comment "Genus Act of Formulation (output a Directive ICE) per GOLDEN PRINCIPLE: a negotiated SLA prescribes obligations." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ServiceLevelAgreement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that negotiates terms among parties and produces a service-level agreement specifying scope, quality, and responsibilities." ;
    skos:example "A shared-services finance team negotiating an SLA with an internal customer." ;
    bpot:apqcSourceText "Agreeing upon terms and conditions. Negotiate an agreement between two or more parties, the customer and service providers. Specify scope, quality, and responsibilities." ;
    bpot:hierarchyID "9.3.1.1" ;
    bpot:pcfID "10815" .

bpot:P10894 a owl:Class ;
    rdfs:label "Manage cash equivalents" ;
    rdfs:comment "R5: standing function of maintaining cash-equivalent holdings, no natural end -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of holding and utilizing short-term assets readily convertible into cash." ;
    skos:example "Treasury parks surplus cash in treasury bills and commercial paper." ;
    bpot:apqcSourceText "Taking care of all cash-related activities in the business. Utilize short-term assets that can be easily convertible into cash, such as marketable securities, commercial paper and short-term government bonds, and treasury bills." ;
    bpot:hierarchyID "9.7.2.2" ;
    bpot:pcfID "10894" .

bpot:P10897 a owl:Class ;
    rdfs:label "Manage cash flows" ;
    rdfs:comment "R5: standing optimization function with no natural end -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of optimizing the timing of cash inflows and outflows." ;
    skos:example "Treasury accelerates receivables collection while extending payables." ;
    bpot:apqcSourceText "Delaying the outflow of funds as long as possible, but encourage the inflow of as fast as possible." ;
    bpot:hierarchyID "9.7.2.5" ;
    bpot:pcfID "10897" .

bpot:P10899 a owl:Class ;
    rdfs:label "Manage and oversee banking relationships" ;
    rdfs:comment "R5: standing relationship-maintenance function with no natural end -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of maintaining and directing relationships with banking partners." ;
    skos:example "Treasury holds quarterly reviews with its relationship banks." ;
    bpot:apqcSourceText "Maintaining and directing the course of relationships with banking partners." ;
    bpot:hierarchyID "9.7.2.7" ;
    bpot:pcfID "10899" .

bpot:P10901 a owl:Class ;
    rdfs:label "Manage in-house bank accounts for subsidiaries" ;
    rdfs:comment "R5: standing account-maintenance function for subsidiaries, no natural end -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of maintaining and servicing subsidiary accounts held within the corporation's in-house bank." ;
    skos:example "The in-house bank maintains a current account for each operating subsidiary." ;
    bpot:apqcSourceText "Maintaining subsidiaries' company accounts opened with bank inside the corporation. Manage different financial services provided by in-house bank structure for parent companies' subsidiaries or branches." ;
    bpot:hierarchyID "9.7.3.1" ;
    bpot:pcfID "10901" .

bpot:P10908 a owl:Class ;
    rdfs:label "Manage financial intermediary relationships" ;
    rdfs:comment "R5: standing relationship-maintenance function -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of maintaining relationships with financial intermediaries that provide loans and services." ;
    skos:example "Treasury maintains its panel of investment-banking counterparties." ;
    bpot:apqcSourceText "Maintaining smooth relations with financial investment banks that help availing loans and services." ;
    bpot:hierarchyID "9.7.4.2" ;
    bpot:pcfID "10908" .

bpot:P10909 a owl:Class ;
    rdfs:label "Manage liquidity" ;
    rdfs:comment "R5: standing liquidity-maintenance function with no natural end -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of maintaining sufficient cash and cash equivalents to meet the organization's obligations." ;
    skos:example "Treasury keeps a liquidity buffer sized to a stressed cash-outflow scenario." ;
    bpot:apqcSourceText "Managing and maintaining enough liquidity in form of cash and cash equivalents in the business to meet urgent and timely requirements" ;
    bpot:hierarchyID "9.7.4.3" ;
    bpot:pcfID "10909" .

bpot:P10910 a owl:Class ;
    rdfs:label "Manage issuer exposure" ;
    rdfs:comment "R5: standing exposure-control function -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of controlling the credit exposure incurred toward issuers and borrowers." ;
    skos:example "Treasury monitors and caps exposure to each bond issuer in the portfolio." ;
    bpot:apqcSourceText "Managing the exposure incurred by the issuer for providing credit to the borrower." ;
    bpot:hierarchyID "9.7.4.4" ;
    bpot:pcfID "10910" .

bpot:P11208 a owl:Class ;
    rdfs:label "Monitor and execute risk and hedging transactions" ;
    rdfs:comment "R5: standing risk-and-hedging function -> Organization Capability (R6). Discrete strategy/report children are processes; market/exposure sub-functions are themselves capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P12974 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11214 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of developing hedging strategy, managing market and exposure risks, executing hedges, and accounting for hedging activity." ;
    skos:example "A market-risk desk running the firm's hedging programme." ;
    bpot:apqcSourceText "Performing transactions that limit investment risk with the help of derivatives, such as options and futures contracts. Manage interest rates, foreign exchange, and exposure risks. Develop and execute hedging transactions. Evaluate and refine hedging positions. Produce hedge accounting transactions and reports. Monitor credit." ;
    bpot:hierarchyID "9.7.5" ;
    bpot:pcfID "11208" .

bpot:P11209 a owl:Class ;
    rdfs:label "Manage interest rate risk" ;
    rdfs:comment "R5: standing interest-rate-risk function -> Organization Capability (R6). Its four tasks are processes that realize it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19575 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19576 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19577 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19578 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of collecting interest-rate market data, determining interest-rate exposure and hedge requirements, and executing interest-rate trades." ;
    skos:example "The rates desk managing the firm's interest-rate risk position." ;
    bpot:apqcSourceText "Handling risks arising from changes in the interest rate." ;
    bpot:hierarchyID "9.7.5.2" ;
    bpot:pcfID "11209" .

bpot:P11210 a owl:Class ;
    rdfs:label "Manage foreign exchange risk" ;
    rdfs:comment "R5: standing FX-risk function -> Organization Capability (R6). Its five tasks are processes that realize it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19579 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19580 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19581 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19582 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19583 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of managing FX market data, determining FX exposure and hedge requirements, executing FX trades, and managing balance-sheet FX risk." ;
    skos:example "The FX desk managing the group's currency risk." ;
    bpot:apqcSourceText "Taking care of foreign-exchange risks." ;
    bpot:hierarchyID "9.7.5.3" ;
    bpot:pcfID "11210" .

bpot:P11211 a owl:Class ;
    rdfs:label "Manage exposure risk" ;
    rdfs:comment "R5: standing exposure-risk function -> Organization Capability (R6). Its four tasks are processes that realize it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19584 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19585 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19586 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19587 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of determining customer exposures, resolving limit violations, managing collateral, and reviewing customer credit." ;
    skos:example "The credit-risk team managing counterparty exposure limits." ;
    bpot:apqcSourceText "Taking care of exposure risks. Maintain financial investments in particular investments or a portfolios that could be risky for the organization." ;
    bpot:hierarchyID "9.7.5.4" ;
    bpot:pcfID "11211" .

bpot:P16958 a owl:Class ;
    rdfs:label "Manage financial fraud/dispute cases" ;
    rdfs:comment "R5: standing case-handling function with no decomposed children and no natural end -> Organization Capability (R6)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of handling financial-fraud cases and resolving disputes." ;
    skos:example "A treasury controls team investigating and resolving suspected payment fraud." ;
    bpot:apqcSourceText "Handling cases that involve financial fraud. Resolve disputes." ;
    bpot:hierarchyID "9.7.6" ;
    bpot:pcfID "16958" .

bpot:P20137 a owl:Class ;
    rdfs:label "Execute hedging transactions" ;
    rdfs:comment "R5: heading aggregating discrete hedge-execution tasks -> modeled as Organization Capability (R6) realized in those task processes. Implements the hedging strategy produced by bpo:P12974." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19588 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19589 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19590 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11213 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11215 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of measuring positions, establishing and unwinding hedges, refining hedging positions, and monitoring credit to implement a hedging strategy." ;
    skos:example "The desk puts on the futures and options called for by the hedging strategy." ;
    bpot:apqcSourceText "Implementing hedging strategy in attempt to alleviate risk. This will include all options, depravities, and futures contracts agreed upon in Develop risk management/hedging strategy [12974]." ;
    bpot:hierarchyID "9.7.5.5" ;
    bpot:pcfID "20137" .

bpot:PaymentMatchResult a owl:Class ;
    rdfs:label "Payment Match Result" ;
    rdfs:comment "Minted locally for 9.6.1.1: descriptive judgement of AP three-way matching. Descriptive, not Directive, because it represents a match state rather than prescribing action." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records whether an accounts-payable pay-file entry matches the corresponding vendor master and purchase-order record." .

bpot:PayrollInquiryResponse a owl:Class ;
    rdfs:label "Payroll Inquiry Response" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the answer given to an employee's salary-related query." ;
    skos:example "A help-desk reply explaining a deduction that reduced an employee's net pay." .

bpot:PeriodEndAdjustmentRecord a owl:Class ;
    rdfs:label "Payroll Period-End Adjustment Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes corrections to salary deductions reconciled at the close of a tax period." ;
    skos:example "A year-end recalculation adjusting an employee's tax-deduction shortfall or surplus." .

bpot:ProcessControlObjective a owl:Class ;
    rdfs:label "Process Control Objective" ;
    rdfs:comment "Minted for 9.8.1.4. Directive (prescribes intended accomplishment). Paired with a descriptive bpo:RiskAssessment describing the risks attached to the process." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes what a business process is intended to accomplish and the control objectives governing it." ;
    skos:example "A documented objective that all disbursements above a threshold require dual authorization." .

bpot:ProductClassification a owl:Class ;
    rdfs:label "Product Trade Classification" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that assigns products or services to trade categories according to national and international standards." .

bpot:ProductMixDecision a owl:Class ;
    rdfs:label "Product-Mix Decision" ;
    rdfs:comment "Minted: a decision/selection record (Directive ICE), distinct from descriptive analyses. Output of an Act of Selection (bpo:P10785)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the chosen combination of products and customer segments offered to the market." ;
    skos:example "A decision to offer products X and Y to segment A and product Z to segment B." .

bpot:ProjectAccountCode a owl:Class ;
    rdfs:label "Project Account Code" ;
    rdfs:comment "Local mint. Rejected bpo:ChartOfAccounts (the master account structure) as too broad for a single per-project classification code. Descriptive (it identifies/classifies, it does not prescribe)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that is a reference code identifying a capital project within a system of accounts so that its transactions can be classified and aggregated." ;
    skos:example "Cost-collection code 'CP-2026-014' assigned to a new turbine-replacement project." .

bpot:ProjectApprovalDecision a owl:Class ;
    rdfs:label "Project Approval Decision" ;
    rdfs:comment "Go/no-go decision in capital planning (9.4)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes whether a capital project or fixed-asset acquisition is authorized to proceed." .

bpot:ProjectContinuationDecision a owl:Class ;
    rdfs:label "Project Continuation Decision" ;
    rdfs:comment "Directive go/no-go decision in capital project accounting (9.4.2). Minted for bpo:P10851 ('Decide whether to proceed based on the revenues generated'), mirroring bpo:ProjectApprovalDecision." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes whether to proceed with a capital project on the basis of the returns it has generated." .

bpot:RegulatorRole a owl:Class ;
    rdfs:label "Regulator Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an authority in virtue of having legal power to issue and enforce financial, tax, or trade rules binding on an Organization." .

bpot:RestitutionManagementCapability a owl:Class ;
    rdfs:label "Restitution Management Capability" ;
    rdfs:comment "Models APQC 9.11.9 'Handle restitution' (PCF 14097). R5: 'Administering and overseeing all restitution activities... Manage compliance' is a standing managerial function with no natural end -- a capability, not a bounded process. Realized in the underlying restitution/compliance acts (R6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17059 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in the ongoing administration and oversight of an organization's restitution obligations, including maintaining compliance with applicable legal frameworks and discharging any fines or non-financial measures imposed by authorities." ;
    skos:example "A legal function's standing capacity to manage court-ordered restitution and regulatory penalties." .

bpot:RiskExposureData a owl:Class ;
    rdfs:label "Risk Exposure Data" ;
    rdfs:comment "Definitional input to exposure-determination analyses (9.7.5). Used by bpo:P19584; parallels bpo:MarketRateData (the input to the rate-exposure analyses bpo:P19576 / bpo:P19580) so all three exposure-determination rows carry a definitional input." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an Organization's current counterparty or customer exposures, positions, and the limits applicable to them." .

bpot:RiskToleranceSpecification a owl:Class ;
    rdfs:label "Risk Tolerance Specification" ;
    rdfs:comment "Minted for 9.8.1.5. Directive because it prescribes binding limits, not a description of current risk (that is bpo:RiskAssessment)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the maximum acceptable risk, in quantitative terms, for an entity or organizational unit across strategic, operational, financial, and compliance risk subcategories." ;
    skos:example "A board-approved statement capping aggregate operational loss exposure at 2% of revenue." .

bpot:SanctionedPartyList a owl:Class ;
    rdfs:label "Sanctioned Party List" ;
    rdfs:comment "Minted for group 9.11. Input to sanctioned-party screening. Descriptive (it represents who may trade), not Directive." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the parties approved or prohibited for engaging in international trade, together with their granted legal rights and credentials." ;
    skos:example "A consolidated denied-/approved-parties screening list maintained for export controls." .

bpot:SanctionedPartyScreeningResult a owl:Class ;
    rdfs:label "Sanctioned Party Screening Result" ;
    rdfs:comment "Minted for group 9.11. Output of 9.11.1. Descriptive (it records a clearance judgement) per the GOLDEN PRINCIPLE for an Appraisal act." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of whether the parties to a prospective transaction are clear to engage in international trade, based on evaluation of the approved-party list and their credentials." ;
    skos:example "A trade-compliance clearance record flagging a counterparty as cleared or blocked." .

bpot:ServiceLevelAgreement rdfs:label "Service-Level Agreement" ;
    skos:definition "A Directive Information Content Entity, agreed between parties, that prescribes the scope, quality, and responsibilities of a service." .

bpot:SubsidiaryRole a owl:Class ;
    rdfs:label "Subsidiary Role" ;
    rdfs:comment "Used in consolidation, in-house banking, and international-funds processes (9.3, 9.7, 9.10)." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of being a separate legal entity controlled by a parent Organization." .

bpot:SystemSecurityRequirement a owl:Class ;
    rdfs:label "System Security Requirement" ;
    rdfs:comment "Local mint for 9.7.1.8. Directive because requirements prescribe what a system must satisfy." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes requirements for controlling access, information reliability, accountability, and availability within an organization's treasury systems." .

bpot:TaxInquiryResponse a owl:Class ;
    rdfs:label "Tax Inquiry Response" ;
    rdfs:comment "Minted because no shared section-9.0 ICE denotes a response to an external tax inquiry; bpo:TaxReturn (a filing) and bpo:ComplianceReport (internal controls) do not fit. Descriptive (it represents/answers, not prescribes). Reuses verified cco:ont00000853 and cco:ont00001808 (is about)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:TaxData ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the organization's answer to a tax query raised by a regulatory or government authority, drawing on historical taxation records." ;
    skos:example "A written reply to a revenue authority's audit question, citing the relevant prior-year filings." .

bpot:TaxManagementCapability a owl:Class ;
    rdfs:label "Tax Management Capability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10866 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to estimate, plan, file, and pay its tax liabilities." .

bpot:TradeDocumentation a owl:Class ;
    rdfs:label "Trade Documentation" ;
    rdfs:comment "Output of 9.11 document-trade processes." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the description, quantity, transport, indemnity, and inspection details of an international-trade transaction." .

bpot:TradePreferenceDocumentation a owl:Class ;
    rdfs:label "Trade Preference Documentation" ;
    rdfs:comment "Minted for group 9.11. Output of 9.11.8. Descriptive (it evidences eligibility); the preferential-rate entitlement it records derives from external trade agreements, not from this artifact prescribing conduct." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a shipment's eligibility for trade under preference, by which products may be imported or exported at a lower or nil rate of customs duty or levy." ;
    skos:example "A certificate of origin claiming preferential tariff treatment under a free-trade agreement." .

bpot:TreasurerRole a owl:Class ;
    rdfs:label "Treasurer Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with managing an Organization's cash, liquidity, debt, investments, and financial risk." .

bpot:TreasuryGovernanceCharter a owl:Class ;
    rdfs:label "Treasury Governance Charter" ;
    rdfs:comment "Local mint for 9.7.1.1; no fitting class in the shared section vocabulary. Directive because it prescribes scope and authority rather than describing them." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the scope of treasury operations and designates the authoritative body governing investment decisions." .

bpot:TrialBalance a owl:Class ;
    rdfs:label "Trial Balance" ;
    rdfs:comment "Minted for bpo:P10826 ('Prepare trial balance'). A trial balance is a distinct derived statement, not the general ledger from which it is computed; modeling its output as bpo:GeneralLedger asserted a falsehood about the definitional artifact." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that lists the debit and credit balances of all ledger accounts to verify that total debits equal total credits." .

bpot:VendorMasterFile a owl:Class ;
    rdfs:label "Vendor Master File" ;
    rdfs:comment "Minted locally for 9.6: no shared-vocab ICE covers the supplier/vendor account register used in AP verification (shared bpo:CustomerMasterFile is the customer-side analogue). Is about a Supplier (cco:ont00001808)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:Supplier ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the account particulars of an organization's suppliers, against which accounts-payable entries are matched." .

bpot:CostAnalysis skos:definition "A Descriptive Information Content Entity that describes the composition, drivers, and behavior of an Organization's costs." .

bpot:CostDriverSpecification a owl:Class ;
    rdfs:label "Cost-Driver Specification" ;
    rdfs:comment "Minted: shared vocab has bpo:CostData (raw cost facts) and bpo:CostAnalysis (a cost study) but no class for the enumerated set of identified cost drivers. Descriptive because it registers what the drivers are." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that registers the factors identified as driving the cost of an activity." ;
    skos:example "A list naming machine-hours, setups, and order lines as the drivers of warehousing cost." .

bpot:HedgeRequirementSpecification a owl:Class ;
    rdfs:label "Hedge Requirement Specification" ;
    rdfs:comment "Local mint for 9.7.5.2.3 and 9.7.5.3.3. Directive because it prescribes which hedges must be put in place." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the hedging requirements for a class of market exposures in accordance with an organization's risk policy." .

bpot:HedgeSelectionDecision a owl:Class ;
    rdfs:label "Hedge Selection Decision" ;
    rdfs:comment "Local mint for 9.7.5.5.4. Directive because a selection decision commits to a chosen option." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which hedging option is to be executed after evaluation of available options." .

bpot:P10738 a owl:Class ;
    rdfs:label "Perform planning/budgeting/forecasting" ;
    rdfs:comment "Composite process; APQC children are process parts (cco:ont00001777), not subclasses. Genus is bpo:ActOfFormulation because the dominant output is a directive budget/plan." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:Budget ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10771 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10772 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20135 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10773 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20136 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation in which a finance function plans, budgets, and forecasts to set an organization's short- and long-term financial goals, producing a financial plan and budget." ;
    skos:example "A finance team's annual budgeting and forecasting cycle led by the CFO." ;
    bpot:apqcSourceText "Allocating funds to meet future and current financial goals. Led by the chief financial officer, have the finance function plan, budget, and forecast in order to determine and describe long and short-term financial goals." ;
    bpot:hierarchyID "9.1.1" ;
    bpot:pcfID "10738" .

bpot:P10739 a owl:Class ;
    rdfs:label "Perform cost accounting and control" ;
    rdfs:comment "Composite process; APQC children are process parts. Genus bpo:ActOfAccounting because the dominant output is descriptive accounting records (cost determination compiled into statements)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10774 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14057 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10775 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10776 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10777 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11175 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that determines the costs of products, processes, and projects and compiles them into financial records to support cost control." ;
    skos:example "A cost-accounting close that compiles product costs into the period's financial statements." ;
    bpot:apqcSourceText "Defining costs to be incurred and methods for optimum utilization. Determine the costs of products, processes, projects, etc. to compile in the financial statements, as well as to assist management in making decisions regarding planning and control. Control costs by managing and reducing business expenses." ;
    bpot:hierarchyID "9.1.2" ;
    bpot:pcfID "10739" .

bpot:P10740 a owl:Class ;
    rdfs:label "Perform cost management" ;
    rdfs:comment "Composite process anchored at cco:ont00000228 (Planned Act) because its parts are heterogeneous (descriptive cost-driver analysis plus directive resource allocation), so no single descriptive/directive act genus fits the whole." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10778 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10779 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10780 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10781 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an organization identifies and measures cost drivers and reallocates resources to reduce avoidable expenses and control costs." ;
    skos:example "A cost-reduction initiative that profiles cost drivers and reallocates assets." ;
    bpot:apqcSourceText "Deciding which expenses can be avoided to reduce some costs and increase revenues. Plan and control the organization's budget to forecast future expenditures." ;
    bpot:hierarchyID "9.1.3" ;
    bpot:pcfID "10740" .

bpot:P10742 a owl:Class ;
    rdfs:label "Process customer credit" ;
    rdfs:comment "Anchored to bpo:ActOfAccounting as a customer-credit handling act; its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10789 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10790 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14187 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14188 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10791 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10792 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10793 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that evaluates and processes customer requests for credit advances and produces a credit assessment of the requesting customer." ;
    skos:example "A credit department reviews a customer's loan request and decides on a credit line." ;
    bpot:apqcSourceText "Evaluating and processing requests for advances. Evaluate credit requests by customers requiring loans to buy products/services." ;
    bpot:hierarchyID "9.2.1" ;
    bpot:pcfID "10742" .

bpot:P10743 a owl:Class ;
    rdfs:label "Invoice customer" ;
    rdfs:comment "Output bpo:Invoice is a Descriptive ICE that is about the Customer (per shared vocabulary)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:Invoice ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10794 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10795 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10796 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10797 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10798 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that prepares a commercial invoice documenting a customer's purchase transaction and produces an invoice about that customer." ;
    skos:example "Billing issues a tax invoice for a customer's order." ;
    bpot:apqcSourceText "Preparing detailed reports of customer purchases. Prepare a commercial document between the seller and customer with details about transaction. Detail the quantity purchased, price of products/services, date, parties involved, unique invoice number, and tax information." ;
    bpot:hierarchyID "9.2.2" ;
    bpot:pcfID "10743" .

bpot:P10744 a owl:Class ;
    rdfs:label "Process accounts receivable (AR)" ;
    rdfs:comment "Excludes invoice generation (that is 9.2.2). Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10799 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10800 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10801 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10802 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10803 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that processes payments due from customers, whether received by check or electronically, and records the resulting receivable transactions." ;
    skos:example "The AR team applies and books a batch of customer cheque and electronic payments." ;
    bpot:apqcSourceText "Processing payments due from customers. This includes all processing of funds received, whether by check or electronically. This does not include the generation of invoices." ;
    bpot:hierarchyID "9.2.3" ;
    bpot:pcfID "10744" .

bpot:P10745 a owl:Class ;
    rdfs:label "Manage and process collections" ;
    rdfs:comment "Modeled on the bounded processing core ('posting entries', 'record it in the books'); its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10804 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10805 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10806 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10807 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10808 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14007 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that posts collection entries to the respective accounts and records cash collected from debtors to evidence available cash." ;
    skos:example "The collections team posts a day's debtor receipts to the ledger." ;
    bpot:apqcSourceText "Posting entries to respective accounts, and preparing accounts for receivables. Manage the cash collected by the business from its debtors. Record it in the books of accounts to provide clear information about the availability of the cash." ;
    bpot:hierarchyID "9.2.4" ;
    bpot:pcfID "10745" .

bpot:P10746 a owl:Class ;
    rdfs:label "Manage and process adjustments/deductions" ;
    rdfs:comment "Modeled on the bounded processing core; its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10809 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10810 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10811 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10812 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10813 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10814 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that creates and funds the necessary account adjustments and deductions for a period and records the resulting transactions." ;
    skos:example "Accounting books the period's required adjustments and deductions." ;
    bpot:apqcSourceText "Creating and providing funds for necessary adjustments and deductions, including all expenses that were required for the business at certain point in time." ;
    bpot:hierarchyID "9.2.5" ;
    bpot:pcfID "10746" .

bpot:P10748 a owl:Class ;
    rdfs:label "Perform general accounting" ;
    rdfs:comment "Parent of 9.3.2.1-9.3.2.9; children attached as process parts (cco:ont00001777)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10819 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10820 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10821 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10822 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10823 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10824 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10825 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10826 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10827 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that applies accounting principles and practices to record transactions and prepare an organization's general ledger and final accounts." ;
    skos:example "The monthly general-ledger close performed by a corporate accounting team." ;
    bpot:apqcSourceText "Applying basic principles, concepts, and accounting practices in recording and preparing final accounts, and using accounting information in management." ;
    bpot:hierarchyID "9.3.2" ;
    bpot:pcfID "10748" .

bpot:P10749 a owl:Class ;
    rdfs:label "Perform fixed-asset accounting" ;
    rdfs:comment "Parent of 9.3.3.1-9.3.3.9; children attached as process parts (cco:ont00001777)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10828 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10829 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10830 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10831 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10832 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10833 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10834 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10835 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10836 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records and maintains the cost, useful life, depreciation, and disposition of an organization's fixed assets to produce a fixed-asset register." ;
    skos:example "Maintaining the fixed-asset subledger across a fiscal year." ;
    bpot:apqcSourceText "Accounting for long-term and fixed assets. Record purchased, fixed assets that are not easily convertible into cash. Account for costs, useful life, resale value, depreciation, and amortization." ;
    bpot:hierarchyID "9.3.3" ;
    bpot:pcfID "10749" .

bpot:P10750 a owl:Class ;
    rdfs:label "Perform financial reporting" ;
    rdfs:comment "Parent of 9.3.4.1-9.3.4.8; children attached as process parts (cco:ont00001777)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10837 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10838 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10839 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10840 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10841 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10842 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10843 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14074 ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles an organization's financial statements and conveys its financial status to stakeholders." ;
    skos:example "Issuing the quarterly financial-reporting package to investors." ;
    bpot:apqcSourceText "Reporting on the organization's financial status to stakeholders. Include balance sheets, income statements, cash flow statements, and statements of shareholders' equity." ;
    bpot:hierarchyID "9.3.4" ;
    bpot:pcfID "10750" .

bpot:P10751 a owl:Class ;
    rdfs:label "Perform capital planning and project approval" ;
    rdfs:comment "Models APQC process 9.4.1 as a bounded occurrent. Its APQC dotted children are process parts (cco:ont00001777), not subclasses. Budget input/output handled by its child P10845; only the report output is asserted as definitional here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10844 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10845 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10846 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10847 ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles a project finance report on a capital project in order to solicit management approvals, and that has as process parts the development of capital-investment policies, expenditure plans and budgets, project review and approval, and financial justification." ;
    skos:example "A finance team assembles a capital-project finance report and budget package and submits it to the investment committee for approval." ;
    bpot:apqcSourceText "Preparing a project finance report to solicit approvals in capital projects. Prepare budgets for projects that require heavy investments. Report on project finances to solicit approvals from management." ;
    bpot:hierarchyID "9.4.1" ;
    bpot:pcfID "10751" .

bpot:P10752 a owl:Class ;
    rdfs:label "Perform capital project accounting" ;
    rdfs:comment "Models APQC process 9.4.2 as a bounded occurrent. Its APQC dotted children are process parts (cco:ont00001777), not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10848 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10849 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10850 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10851 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10852 ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records and maintains the financial Information Content Entities of capital projects across their lifecycle, and that has as process parts project account-code creation, transaction recording, spending monitoring, project capitalization, and return measurement." ;
    skos:example "An accounting team sets up a new capital project, books its transactions, tracks spend against budget, capitalizes it on completion, and measures its return." ;
    bpot:apqcSourceText "Accounting for large-scale and large-cost investments. Manage and account for ongoing activities related to capital projects, including setting up new projects, recording project transactions, monitoring and tracking spending, closing and capitalizing projects, and measuring the financial returns on completed projects." ;
    bpot:hierarchyID "9.4.2" ;
    bpot:pcfID "10752" .

bpot:P10753 a owl:Class ;
    rdfs:label "Report time" ;
    rdfs:comment "Bounded information-processing act; its five APQC activities are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TimeRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10853 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10854 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10855 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10856 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10857 ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that records the working time of employees and produces an employee time record." ;
    skos:example "Capturing every employee's daily hours, billable time, and leave into a time record." ;
    bpot:apqcSourceText "Recording the reporting time of employees on-site. Track working days, salary calculations, holidays taken, number of hours spend in the office, billing hours, etc." ;
    bpot:hierarchyID "9.5.1" ;
    bpot:pcfID "10753" .

bpot:P10754 a owl:Class ;
    rdfs:label "Manage pay" ;
    rdfs:comment "Despite the 'Manage' label this denotes the bounded pay-disbursement run; its eight APQC activities are process parts. The disbursed monetary payment is a MATERIAL participant (obo:BFO_0000057), not has output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10858 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10859 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10860 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10861 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10862 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10863 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10864 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10865 ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that computes and disburses the total pay owed to employees, including bonuses and compensation, producing monetary payments to employees." ;
    skos:example "Running a pay cycle that calculates and pays each employee's net salary and bonuses." ;
    bpot:apqcSourceText "Managing the total payments made in employees payroll, including bonuses and compensation." ;
    bpot:hierarchyID "9.5.2" ;
    bpot:pcfID "10754" .

bpot:P10755 a owl:Class ;
    rdfs:label "Manage and process payroll taxes" ;
    rdfs:comment "Bounded payroll-tax process; its modeled APQC children are process parts. 9.5.3.2 'Manage tax plan' is excluded as a process (standing oversight = capability, R6). The tax remittance is a MATERIAL participant Monetary Payment (obo:BFO_0000057), not has output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14075 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10866 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10867 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10868 ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that deducts payroll taxes from employees' salaries and remits them to the appropriate tax authority, producing a monetary payment of tax." ;
    skos:example "Withholding income tax from salaries and paying it to the revenue authority." ;
    bpot:apqcSourceText "Deducting and paying taxes from employees' salaries." ;
    bpot:hierarchyID "9.5.3" ;
    bpot:pcfID "10755" .

bpot:P10756 a owl:Class ;
    rdfs:label "Process accounts payable (AP)" ;
    rdfs:comment "APQC 9.6.1 as an occurrent; its activities are process parts. Policy/procedure development is a typical adjunct, noted not as a definitional restriction here." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10869 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10870 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10871 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10872 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10873 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10874 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10875 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10876 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10877 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10878 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10879 ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that processes payment of operating expenses and other supplier charges through an organization's accounts-payable operations." ;
    skos:example "An AP department settling a batch of approved supplier invoices." ;
    bpot:apqcSourceText "Processing payments of operating expenses and other supplier charges. This includes the development of policies and procedures around processing of accounts payable and all operations. This process is often supported by key technology enablers." ;
    bpot:hierarchyID "9.6.1" ;
    bpot:pcfID "10756" .

bpot:P10757 a owl:Class ;
    rdfs:label "Process expense reimbursements" ;
    rdfs:comment "APQC 9.6.2 as an occurrent; its activities are process parts. The employee is a definitional participant (the reimbursed party)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Employee ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10880 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10881 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10882 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10883 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10884 ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that processes reimbursements and advances to employees for expenses incurred during the course of business on the organization's behalf." ;
    skos:example "Settling an employee's approved travel-expense claim." ;
    bpot:apqcSourceText "Processing reimbursements to employees for the expenses incurred during the course of business. Approve and process advancements and reimbursements for employee expenses on the organization's behalf. Capture and report relevant tax data and manage personal accounts." ;
    bpot:hierarchyID "9.6.2" ;
    bpot:pcfID "10757" .

bpot:P10762 a owl:Class ;
    rdfs:label "Establish internal controls, policies, and procedures" ;
    rdfs:comment "Models APQC 9.8.1 as an occurrent. Its APQC children are process parts, not subclasses. Directive outputs (policy + procedure) confirm the Formulation genus (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:InternalControlPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10914 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10915 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10916 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11250 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11251 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes internal-control policies and procedures prescribing the rules that ensure operational effectiveness and reliable financial reporting." ;
    skos:example "A controllership team drafts and ratifies the company's internal-control policy and supporting procedures." ;
    bpot:apqcSourceText "Forming rules and regulations to ensure the achievement of effectiveness, proficiency of operations, and reliability of financial reporting." ;
    bpot:hierarchyID "9.8.1" ;
    bpot:pcfID "10762" .

bpot:P10764 a owl:Class ;
    rdfs:label "Report on internal controls compliance" ;
    rdfs:comment "Reporting -> Descriptive output bpo:ComplianceReport (GOLDEN PRINCIPLE). Recipients vary by child process." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10923 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10924 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10925 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10926 ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that communicates an internal-controls compliance report concerning regulatory adherence and pertinent data to the appropriate authority." ;
    skos:example "A compliance officer issues the annual internal-controls compliance report to the relevant stakeholders." ;
    bpot:apqcSourceText "Reporting on internal controls compliance to the appropriate authority, including IT regulations and pertinent data." ;
    bpot:hierarchyID "9.8.3" ;
    bpot:pcfID "10764" .

bpot:P10767 a owl:Class ;
    rdfs:label "Monitor international rates" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring (cco:ont00000366). GOLDEN PRINCIPLE: monitoring/forecasting yields a Descriptive ICE (the forecast), not a directive." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketRateData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialForecast ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as input market rate data and has as output a financial forecast describing anticipated changes in foreign-currency values and interest rates relevant to the organization." ;
    skos:example "A treasury analyst tracks global FX and interest-rate movements and issues a weekly currency-rate forecast." ;
    bpot:apqcSourceText "Forecasting and monitoring changes in foreign currency value or interest rates around the world that play an important role in the organization." ;
    bpot:hierarchyID "9.10.1" ;
    bpot:pcfID "10767" .

bpot:P10768 a owl:Class ;
    rdfs:label "Manage transactions" ;
    rdfs:comment "Anchored to bpo:ActOfFinancialTransaction (cco:ont00000228). Operations process: the transferred funds are a MATERIAL participant (bpo:PaymentInstrument via obo:BFO_0000057, not has output); the audit record is the informational has output (bpo:TransactionRecord). Tax-optimization and regulatory-avoidance objectives are typical sub-considerations, recorded here rather than as definitional restrictions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that transfers funds across borders in the course of trade or investment, converting between currencies, and produces a monetary payment and a record of the transaction." ;
    skos:example "A treasury operation converts EUR to USD and remits an intercompany payment to settle a cross-border purchase." ;
    bpot:apqcSourceText "Managing any transfer of funds in the course of conducting cross-border trades or investments, including conversion across currencies. Find the most suitable alternative for making payments, while saving taxes and avoiding any unwarranted regulation, with the objective of protecting capital." ;
    bpot:hierarchyID "9.10.2" ;
    bpot:pcfID "10768" .

bpot:P10769 a owl:Class ;
    rdfs:label "Monitor currency exposure/hedge currency" ;
    rdfs:comment "Re-anchored from bpo:ActOfMonitoring to bpo:ActOfAnalysis (false-friend on the label word 'Monitor'). The source verb is 'Assessing exposure to potential financial losses ... Forecast the impact of movements' -- a bounded discernment/judgement producing a risk assessment and forecast, i.e. analysis, not continuous status-observation against expected parameters (the bpo:ActOfMonitoring differentia, which fits standing oversight such as bpo:P19583). This aligns the exposure-assessment core with the methodology's parallel treatment of identical content in 9.7.5: bpo:P19580 'Determine foreign exchange exposure' and bpo:P19576 'Determine interest rate exposure', both bpo:ActOfAnalysis producing bpo:RiskAssessment from bpo:MarketRateData (D2 sibling/parallel-row consistency). HEDGING FACET (second defect, intentionally collapsed at 9.10's coarse grain): the label is compound ('...hedge currency') and the source's third sentence ('Enter into financial transactions designed to offset or limit potential exposure to loss') names hedging as a core facet. APQC 9.10 is modeled coarse-grained and does NOT mint separate child rows for it; the hedge decision and execution are first-class acts in the finer-grained 9.7.5 decomposition -- bpo:P19581 (bpo:ActOfSelection -> Directive bpo:HedgeRequirementSpecification, the decision-to-hedge / GOLDEN-PRINCIPLE directive facet) and bpo:P19582 (bpo:ActOfFinancialTransaction, trade execution). This row is therefore scoped to the assessment/forecast facet and cross-references that decomposition rather than mislabelling hedging as a mere non-definitional 'typical consequence'. REJECTED candidate bpo:ActOfMonitoring (continuous-oversight reading; diverges from the 9.7.5 siblings)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketRateData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialForecast ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines market rate data and produces a financial risk assessment and a financial forecast describing the organization's exposure to losses from movements in foreign-currency values." ;
    skos:example "A treasurer measures net open EUR exposure and forecasts its loss potential (the offsetting hedge decision/execution being modeled finer-grained at 9.7.5: bpo:P19581 / bpo:P19582)." ;
    bpot:apqcSourceText "Assessing exposure to potential financial losses as a result of changes in the value of currencies. Forecast the impact of movements in foreign currency values. Enter into financial transactions designed to offset or limit potential exposure to loss." ;
    bpot:hierarchyID "9.10.3" ;
    bpot:pcfID "10769" .

bpot:P10770 a owl:Class ;
    rdfs:label "Report results" ;
    rdfs:comment "Anchored to bpo:ActOfReporting (cco:ont00000366). GOLDEN PRINCIPLE: reporting produces a Descriptive ICE (the financial report). The accounting entries reported on are modeled as bpo:TransactionRecord inputs." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that has as input transaction records of foreign-exchange accounting entries and has as output a financial report that formally states the gains or losses realized from foreign-exchange activity." ;
    skos:example "Accounting documents realized FX gains and issues the period's foreign-exchange results report." ;
    bpot:apqcSourceText "Documenting and reporting accounting entries to formally report financial gains or losses experienced as a result of foreign exchange activity." ;
    bpot:hierarchyID "9.10.4" ;
    bpot:pcfID "10770" .

bpot:P10771 a owl:Class ;
    rdfs:label "Develop and maintain budget policies and procedures" ;
    rdfs:comment "Directive output (GOLDEN PRINCIPLE): formulating rules/procedures yields Directive ICEs (cco:ont00000965), so the act genus is bpo:ActOfFormulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes budgetary guidelines and produces a financial policy and a financial procedure governing how budgets are set." ;
    skos:example "A controller drafts the corporate budgeting policy and the step-by-step budgeting procedure." ;
    bpot:apqcSourceText "Formulating financial budgetary guidelines and strategies. Develop a framework for rules and regulations regarding budgets. Create a step-by-step process to achieve financial goals." ;
    bpot:hierarchyID "9.1.1.1" ;
    bpot:pcfID "10771" .

bpot:P10772 a owl:Class ;
    rdfs:label "Prepare periodic budgets and plans" ;
    rdfs:comment "Directive output (GOLDEN PRINCIPLE): a budget prescribes intended allocation (cco:ont00000965). Method references (cost-based/zero-based budgeting) and the budget policies from 10771 are typical, not definitional, so not promoted to restrictions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:Budget ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that allocates funds over a period and produces a budget prescribing estimated revenues and expenses." ;
    skos:example "The annual departmental budget estimating next year's revenues and expenses." ;
    bpot:apqcSourceText "Creating reports on a quarterly or annual basis for fund allocation. Create a financial statement that estimates revenues and expenses over a specific period of time. (Leverage budget methods such as cost-based and zero-based budgeting techniques, in light of the periodic targets outlined during Develop and maintain budget policies and procedures [10771].)" ;
    bpot:hierarchyID "9.1.1.2" ;
    bpot:pcfID "10772" .

bpot:P10773 a owl:Class ;
    rdfs:label "Prepare periodic financial forecasts" ;
    rdfs:comment "Re-anchored from bpo:ActOfAnalysis to cco:ont00000371 (Act of Prediction). The source text is purely predictive ('Creating estimates of the projected income and expenses ... Develop the projections of profit and loss statements, balance sheets, and the cash flow forecast') and CCO ships a dedicated verified class for exactly this: cco:ont00000371 (Act of Prediction) = 'A Planned Act that involves the generation of a Predictive Information Content entity that is intended to describe an uncertain possible future event, value, entity, or attribute', whose own examples include predicting a stock's future value. REJECTED candidate bpo:ActOfAnalysis (under Act of Information Processing): it is correct but under-committal and obscures the predictive nature; reuse-before-mint (D5) prefers the fitting verified CCO class over a broader local genus. Output bpo:FinancialForecast retyped under cco:ont00000626 (Predictive ICE, still a Descriptive ICE), so the GOLDEN PRINCIPLE holds under either genus and this is a pure act-genus specificity fix. P&L, balance-sheet, and cash-flow projections are facets of the one forecast." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialForecast ],
        cco:ont00000371 ;
    skos:definition "An Act of Prediction that examines financial data and generates a financial forecast projecting income and expenses over a predetermined time frame." ;
    skos:example "A quarterly cash-flow and P&L forecast for the next four quarters." ;
    bpot:apqcSourceText "Creating estimates of the projected income and expenses required over a predetermined time frame. Develop the projections of profit and loss statements, balance sheets, and the cash flow forecast." ;
    bpot:hierarchyID "9.1.1.4" ;
    bpot:pcfID "10773" .

bpot:P10774 a owl:Class ;
    rdfs:label "Perform inventory accounting" ;
    rdfs:comment "Descriptive output: accounting records/statements (cco:ont00000853). The fixed-asset register is the definitional input that is updated; the financial statement is the definitional output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records inventory and asset values and accounts for the causes of their change, producing a financial statement of those assets." ;
    skos:example "Recording depreciation and obsolescence write-downs against the fixed-asset register." ;
    bpot:apqcSourceText "Conducting accounting for assets, and finding reasons for changes (depreciation, obsolescence, deterioration, change in customer taste, increased demand, decreased market supply, etc.)." ;
    bpot:hierarchyID "9.1.2.1" ;
    bpot:pcfID "10774" .

bpot:P10775 a owl:Class ;
    rdfs:label "Perform cost of sales analysis" ;
    rdfs:comment "Descriptive output (cco:ont00000853). Genus bpo:ActOfAnalysis: examining cost data to produce an understanding." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CostData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CostAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the expenses directly associated with products and produces a cost analysis of the cost of sales." ;
    skos:example "Breaking down manufacturing cost of goods sold by component." ;
    bpot:apqcSourceText "Studying expenses directly associated with product. Analyze the cost of sales, which is the cost of manufacturing products." ;
    bpot:hierarchyID "9.1.2.3" ;
    bpot:pcfID "10775" .

bpot:P10776 a owl:Class ;
    rdfs:label "Perform product costing" ;
    rdfs:comment "Descriptive output (cco:ont00000853). Genus bpo:ActOfAnalysis: derives a cost figure from resource-usage data." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CostData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CostAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines every resource consumed in making a product and produces a cost analysis attributing the product's cost to the relevant cost center." ;
    skos:example "Allocating direct material, labor, and overhead to compute a unit product cost." ;
    bpot:apqcSourceText "Studying and finding out the relevant cost center for a product by studying every resource used in its making." ;
    bpot:hierarchyID "9.1.2.4" ;
    bpot:pcfID "10776" .

bpot:P10777 a owl:Class ;
    rdfs:label "Perform variance analysis" ;
    rdfs:comment "Descriptive output (cco:ont00000853). Genus bpo:ActOfAnalysis. Distinct from 20136 (variance against forecasts/budgets at the planning level); this one operates on cost data." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CostData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:VarianceAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that compares planned and actual costing and produces a variance analysis of the differences." ;
    skos:example "Plotting actual-vs-standard cost variances on a trend line." ;
    bpot:apqcSourceText "Discovering the changes between forecasted and actual costing. Analyze actual and planned behavior by reviewing the amount of a variance on a trend line in order to maintain control over a business." ;
    bpot:hierarchyID "9.1.2.5" ;
    bpot:pcfID "10777" .

bpot:P10778 a owl:Class ;
    rdfs:label "Determine key cost drivers" ;
    rdfs:comment "Descriptive output (cco:ont00000853): a register of identified drivers. Genus bpo:ActOfIdentification (discernment sense), reused from apqc-ext." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CostData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CostDriverSpecification ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the factors driving the cost of an activity and produces a cost-driver specification registering them." ;
    skos:example "Identifying machine-hours and order-count as the drivers of a warehousing activity's cost." ;
    bpot:apqcSourceText "Defining cost drivers for a particular activity." ;
    bpot:hierarchyID "9.1.3.1" ;
    bpot:pcfID "10778" .

bpot:P10779 a owl:Class ;
    rdfs:label "Measure cost drivers" ;
    rdfs:comment "Anchored at cco:ont00000345 (Act of Measuring) because the act literally quantifies driver magnitudes against a standard. Descriptive measurement output (cco:ont00000853). The cost-driver specification from 10778 is the definitional input. Explicit rdfs:subClassOf cco:ont00000228 (Planned Act) added so the act-anchor chain is visible to the standalone SHACL run (ont00000345 is a CCO subclass of ont00000228, but the closure is not merged for Gate C)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CostDriverSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CostDriverMeasurement ],
        cco:ont00000228,
        cco:ont00000345 ;
    skos:definition "An Act of Measuring that calculates the magnitude of identified cost drivers and produces a cost-driver measurement." ;
    skos:example "Counting the machine-hours consumed per product line." ;
    bpot:apqcSourceText "Calculating cost drivers." ;
    bpot:hierarchyID "9.1.3.2" ;
    bpot:pcfID "10779" .

bpot:P10780 a owl:Class ;
    rdfs:label "Determine critical activities" ;
    rdfs:comment "Descriptive output (cco:ont00000853): a register marking which activities are essential. Genus bpo:ActOfIdentification." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CriticalActivityDetermination ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns which finance activities are indispensable and produces a critical-activity determination." ;
    skos:example "Flagging payroll and regulatory reporting as indispensable, non-cuttable finance activities." ;
    bpot:apqcSourceText "Determine the activities that hinder the progress of finance activities. This requires the organization to determine those business activities carried out by the financial function of the organization and which are indispensable. This undertaking helps the organization triangulate those activities which are essential and where costs cannot be slashed." ;
    bpot:hierarchyID "9.1.3.3" ;
    bpot:pcfID "10780" .

bpot:P10781 a owl:Class ;
    rdfs:label "Manage asset resource deployment and utilization" ;
    rdfs:comment "Directive output (GOLDEN PRINCIPLE): an allocation plan prescribes how resources are deployed (cco:ont00000965), so the genus is bpo:ActOfFormulation. Modeled as a bounded allocation exercise (a single deployment decision), not the standing 'manage' sense." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AssetDeploymentPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that allocates asset resources across processes and produces an asset-deployment plan prescribing their optimal utilization." ;
    skos:example "Reassigning capital equipment between plants to improve utilization." ;
    bpot:apqcSourceText "Distributing or allocating asset resources in different processes for optimal utilization." ;
    bpot:hierarchyID "9.1.3.4" ;
    bpot:pcfID "10781" .

bpot:P10782 a owl:Class ;
    rdfs:label "Assess customer and product profitability" ;
    rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): the act evaluates/judges profitability. Descriptive output (cco:ont00000853)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CostData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerMasterFile ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProfitabilityAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges the profitability of customers and products after deducting delivery cost and produces a profitability analysis." ;
    skos:example "Ranking customer segments by net margin after cost-to-serve." ;
    bpot:apqcSourceText "Studying product demand and targeted customer preferences. Study customers' demands or preferences after deducting the cost of delivering the final product." ;
    bpot:hierarchyID "9.1.4.1" ;
    bpot:pcfID "10782" .

bpot:P10783 a owl:Class ;
    rdfs:label "Evaluate new products" ;
    rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal). Descriptive output (cco:ont00000853): a judgement of the product's viability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:NewProductEvaluation ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges the demand and projected profitability of a new product in a market and produces a new-product evaluation." ;
    skos:example "Assessing whether a proposed product line is worth producing for a target segment." ;
    bpot:apqcSourceText "Checking demand about a specific product by a customer segment. Conduct a detailed study--or research a customer behavior or preference for a product--in order to determine its production and profitability in a specific market." ;
    bpot:hierarchyID "9.1.4.2" ;
    bpot:pcfID "10783" .

bpot:P10784 a owl:Class ;
    rdfs:label "Perform life cycle costing" ;
    rdfs:comment "Descriptive output (cco:ont00000853). Genus bpo:ActOfAnalysis: derives stage-by-stage cost understanding from cost data." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CostData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LifeCycleCostAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines a product's full life cycle and produces a life-cycle cost analysis of the revenue and cost incurred at each stage." ;
    skos:example "Computing total cost of ownership across a product's design, production, and disposal stages." ;
    bpot:apqcSourceText "Determining the cost of delivering an end product at different stages of production. Study the total life cycle of a product/process to determine how much revenue and production cost will be incurred at every stage in order to make strategic decisions." ;
    bpot:hierarchyID "9.1.4.3" ;
    bpot:pcfID "10784" .

bpot:P10785 a owl:Class ;
    rdfs:label "Optimize customer and product mix" ;
    rdfs:comment "Directive output (GOLDEN PRINCIPLE): choosing an optimal mix from candidate combinations yields a decision (cco:ont00000965), so the genus is bpo:ActOfSelection, reused from apqc-ext." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ProfitabilityAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProductMixDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses the customer and product mix giving the best fit between products and end users and produces a product-mix decision prescribing that mix." ;
    skos:example "Selecting which products to offer to which segments to maximize the customer base." ;
    bpot:apqcSourceText "Creating the best fit between a product and the end user. Maximize the customer base by providing different products in the market." ;
    bpot:hierarchyID "9.1.4.4" ;
    bpot:pcfID "10785" .

bpot:P10786 a owl:Class ;
    rdfs:label "Track performance of new-customer and product strategies" ;
    rdfs:comment "Descriptive output (cco:ont00000853): tracked performance metrics. Genus bpo:ActOfMonitoring. The follow-on 'prepare strategies to improve sales' is a downstream, non-definitional step, so it is noted here rather than promoted to a restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceMeasure ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that observes the behavior of new customers toward products and produces a performance measure of those new-customer and product strategies." ;
    skos:example "Monitoring repeat-purchase rates of customers acquired under a new product strategy." ;
    bpot:apqcSourceText "Observing the behavior of a new set of customers for different products. Prepare strategies to improve sales and profits." ;
    bpot:hierarchyID "9.1.4.5" ;
    bpot:pcfID "10786" .

bpot:P10787 a owl:Class ;
    rdfs:label "Prepare activity-based performance measures" ;
    rdfs:comment "Descriptive output (cco:ont00000853): a performance measure is a representation of measured performance. Genus bpo:ActOfAnalysis: computes metrics from activity data." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceMeasure ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that derives performance metrics from activity data and produces activity-based performance measures." ;
    skos:example "Computing cost-per-transaction and cycle-time metrics for finance activities." ;
    bpot:apqcSourceText "Evaluating performance based on different sets of activities created by management to measure performance." ;
    bpot:hierarchyID "9.1.4.6" ;
    bpot:pcfID "10787" .

bpot:P10789 a owl:Class ;
    rdfs:label "Establish credit policies" ;
    rdfs:comment "Genus Act of Formulation (Directive output) per the Golden Principle: a policy is a Directive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes credit standards, terms, and collection guidelines and produces a credit policy." ;
    skos:example "A controller sets the firm's credit standards and collection terms for the coming year." ;
    bpot:apqcSourceText "Creating guidelines for providing advances. Set up credit standards, credit terms, and collection policies." ;
    bpot:hierarchyID "9.2.1.1" ;
    bpot:pcfID "10789" .

bpot:P10790 a owl:Class ;
    rdfs:label "Analyze/Approve new account applications" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges applicant status. Dual output -- a Descriptive credit assessment and a Directive approval decision." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerMasterFile ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AccountApprovalDecision ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates new-account applicants against eligibility criteria and produces a credit assessment and an account approval decision." ;
    skos:example "A credit analyst checks an applicant's status and approves a new account." ;
    bpot:apqcSourceText "Checking and accepting new requests based on eligibility criteria. Analyze the status of applicants and requirements to be met for a new account." ;
    bpot:hierarchyID "9.2.1.2" ;
    bpot:pcfID "10790" .

bpot:P10791 a owl:Class ;
    rdfs:label "Review existing accounts" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges account-holder performance/status." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerMasterFile ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AccountStatement ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates existing account holders and their past performance and produces an account statement of their present status." ;
    skos:example "A credit team reviews active accounts and reports each holder's current standing." ;
    bpot:apqcSourceText "Evaluating existing account holders and their past performance. Regularly review existing accounts to get the required information about the status at present." ;
    bpot:hierarchyID "9.2.1.5" ;
    bpot:pcfID "10791" .

bpot:P10792 a owl:Class ;
    rdfs:label "Produce credit/collection reports" ;
    rdfs:comment "Genus Act of Reporting (Descriptive output): the report represents, rather than prescribes." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles credit and collection information into a financial report provided to management." ;
    skos:example "Accounting prepares a monthly collections report for senior management." ;
    bpot:apqcSourceText "Preparing account payable reports about payments to be made according to accounting rules and principles, and providing the reports to management." ;
    bpot:hierarchyID "9.2.1.6" ;
    bpot:pcfID "10792" .

bpot:P10793 a owl:Class ;
    rdfs:label "Reinstate or suspend accounts based on credit policies" ;
    rdfs:comment "Operational accounting act on account records; takes the governing credit policy as input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CreditPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AccountStatement ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that closes or restarts customer accounts in accordance with current credit policy and updates the resulting account statement." ;
    skos:example "A clerk suspends an account that breaches the revised credit policy." ;
    bpot:apqcSourceText "Closing or restarting accounts according to changes made in credit policies." ;
    bpot:hierarchyID "9.2.1.7" ;
    bpot:pcfID "10793" .

bpot:P10794 a owl:Class ;
    rdfs:label "Maintain customer/product master files" ;
    rdfs:comment "Record-maintenance accounting act; output is the Descriptive customer master file." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerMasterFile ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that creates and updates records of customers and the products they purchase and produces a customer master file." ;
    skos:example "A clerk updates the customer master file after a new product is sold." ;
    bpot:apqcSourceText "Creating and updating a record of customers and the products being purchased by them in a database. This process element requires the organization to maintain a database of customers and their purchases. Such a master-file can be used to ensure customer touch point, enhance customer satisfaction, explore cross selling opportunities, and identify future trends. This database will include several particulars about the personal details of the organization's customers and a tracking of the products being sold." ;
    bpot:hierarchyID "9.2.2.1" ;
    bpot:pcfID "10794" .

bpot:P10795 a owl:Class ;
    rdfs:label "Generate customer billing data" ;
    rdfs:comment "Output modeled as bpo:FinancialData (Descriptive ICE) covering price/quantity/product detail." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialData ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records and compiles the details of a customer's purchase transactions and produces customer billing data." ;
    skos:example "The billing system generates the line-item billing data for a customer's monthly statement." ;
    bpot:apqcSourceText "Preparing detailed reports about products purchased by customers. Record and generate a detail account of transactions made by customers fat a particular time and location. Include all details about products such as price, quantity, and name." ;
    bpot:hierarchyID "9.2.2.2" ;
    bpot:pcfID "10795" .

bpot:P10796 a owl:Class ;
    rdfs:label "Transmit billing data to customers" ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000402 (Act of Communication). Transmit-only per the bpo:ActOfReporting carve-out: its rdfs:comment states 'Where a node only transmits an already-prepared report to a party, the group module reuses cco:ont00000402 instead.' The source text is delivery-only ('Providing information to customers ... Communicate the details ... Provide customers with a copy'); no new ICE is produced -- the invoice already exists from bpo:P10743/bpo:P10795. The invoice is therefore the transmitted ICE (has input), not an output, and the Customer is the recipient participant. cco:ont00000402 (Act of Communication) verified against CCO v2.0 (2024-11-06): 'A Planned Act in which some Information Content Entity is transferred from some Agent to Another.' Same transmit-only test applied to sibling 'provide a copy' nodes." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Invoice ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        cco:ont00000402 ;
    skos:definition "An Act of Communication that conveys a customer's purchase and billing details to that customer by delivering a copy of an already-prepared invoice." ;
    skos:example "The system emails a customer a copy of their invoice." ;
    bpot:apqcSourceText "Providing information to customers about purchases made by them. Communicate the details of purchases. Provide customers with a copy of details for their reference." ;
    bpot:hierarchyID "9.2.2.3" ;
    bpot:pcfID "10796" .

bpot:P10797 a owl:Class ;
    rdfs:label "Post receivable entries" ;
    rdfs:comment "Posting/registration accounting act; output is the Descriptive transaction record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that registers receivable transactions and their scheduled payments and produces a transaction record." ;
    skos:example "Accounting posts the receivable entry for a newly invoiced sale." ;
    bpot:apqcSourceText "Registering transactions and their scheduled payments." ;
    bpot:hierarchyID "9.2.2.4" ;
    bpot:pcfID "10797" .

bpot:P10798 a owl:Class ;
    rdfs:label "Resolve customer billing inquiries" ;
    rdfs:comment "Resolution of billing records; the Customer participates as the inquiring party." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AccountStatement ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that checks customer billing queries against the records and produces a corrected or clarified account statement resolving them." ;
    skos:example "A billing agent investigates and corrects an over-charge a customer disputed." ;
    bpot:apqcSourceText "Checking and solving billing queries raised by customers." ;
    bpot:hierarchyID "9.2.2.5" ;
    bpot:pcfID "10798" .

bpot:P10799 a owl:Class ;
    rdfs:label "Establish AR policies" ;
    rdfs:comment "Directive output (Financial Policy) -> Act of Formulation per the Golden Principle." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the rules and procedures governing credit sales and produces a financial policy for accounts receivable." ;
    skos:example "Finance sets the allowable installment terms for credit sales." ;
    bpot:apqcSourceText "Creating rules and regulations to be followed in case of credit sales to customers. Create rules and procedures to follow at the time of sale (e.g., the allowable number of installments)." ;
    bpot:hierarchyID "9.2.3.1" ;
    bpot:pcfID "10799" .

bpot:P10800 a owl:Class ;
    rdfs:label "Receive/Deposit customer payments" ;
    rdfs:comment "Operations category permits material I/O: the input is a Monetary Payment (material entity); the booked entries are a Descriptive transaction record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that receives monetary payment from a customer, deposits it into a bank account, and books the corresponding entries as a transaction record." ;
    skos:example "A cashier deposits a customer's cash payment and records the receipt." ;
    bpot:apqcSourceText "Collecting cash from customers. Deposit it into bank account. Make entries into the books of accounts." ;
    bpot:hierarchyID "9.2.3.2" ;
    bpot:pcfID "10800" .

bpot:P10801 a owl:Class ;
    rdfs:label "Apply cash remittances" ;
    rdfs:comment "Material input is a Monetary Payment (the remitted funds); the BankingPartner participates as the authorized remittance agent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:BankingPartner ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that checks and moves monetary payments, typically through authorized remittance agents, and records the applied remittance." ;
    skos:example "Treasury applies an inbound cross-border remittance to the customer's account via an authorized agent." ;
    bpot:apqcSourceText "Checking and moving funds between countries for business activities, typically through authorized remittance agents." ;
    bpot:hierarchyID "9.2.3.3" ;
    bpot:pcfID "10801" .

bpot:P10802 a owl:Class ;
    rdfs:label "Prepare AR reports" ;
    rdfs:comment "Genus Act of Reporting (Descriptive output)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles outstanding receivable balances at a point in time into a financial report." ;
    skos:example "Accounting produces an aged-receivables report at month-end." ;
    bpot:apqcSourceText "Preparing reports that detail balances due or what to collect from customers at a certain point in time." ;
    bpot:hierarchyID "9.2.3.4" ;
    bpot:pcfID "10802" .

bpot:P10803 a owl:Class ;
    rdfs:label "Post AR activity to the general ledger" ;
    rdfs:comment "Posting accounting act; output is the General Ledger (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that transfers accounts-receivable journal entries into the general ledger accounts." ;
    skos:example "The accountant posts the AR sub-ledger entries to the general ledger." ;
    bpot:apqcSourceText "Preparing the general ledger for account receivables from journals. Place all journal entries related to accounts receivables in the general ledger accounts of a business." ;
    bpot:hierarchyID "9.2.3.5" ;
    bpot:pcfID "10803" .

bpot:P10804 a owl:Class ;
    rdfs:label "Establish policies for delinquent accounts" ;
    rdfs:comment "Directive output (Financial Policy) -> Act of Formulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the rules to follow when an account holder fails to make required payments and produces a financial policy for delinquent accounts." ;
    skos:example "Collections defines the dunning policy for accounts past due." ;
    bpot:apqcSourceText "Creating a process to follow in case of a failed payment by account holders. Create rules and regulations for the account holder who has failed to make at least the minimum monthly payment by the due date." ;
    bpot:hierarchyID "9.2.4.1" ;
    bpot:pcfID "10804" .

bpot:P10805 a owl:Class ;
    rdfs:label "Analyze delinquent account balances" ;
    rdfs:comment "Genus Act of Analysis (information processing into a Descriptive judgement); input is the account statement." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:AccountStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the balance statements and past payments of delinquent account holders and produces a credit assessment informing negotiation." ;
    skos:example "An analyst studies a defaulter's payment history before settlement talks." ;
    bpot:apqcSourceText "Examining balance statements of accountholders who failed to make required payments. Study or review the account details of customers' past payments when preparing negotiations policies." ;
    bpot:hierarchyID "9.2.4.2" ;
    bpot:pcfID "10805" .

bpot:P10806 a owl:Class ;
    rdfs:label "Correspond/Negotiate with delinquent accounts" ;
    rdfs:comment "Genus Act of Formulation: the definitional output is a prescribed repayment arrangement (Directive ICE). The defaulting Customer participates." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that, through correspondence with a defaulting customer, determines and prescribes a repayment arrangement as a financial procedure." ;
    skos:example "A collections officer agrees an extended-time repayment plan with a customer in default." ;
    bpot:apqcSourceText "Determine ways for customers in default to repay debts (e.g., allowing more time or discounts)." ;
    bpot:hierarchyID "9.2.4.3" ;
    bpot:pcfID "10806" .

bpot:P10807 a owl:Class ;
    rdfs:label "Discuss account resolution with internal parties" ;
    rdfs:comment "Directive output (Financial Procedure) -> Act of Formulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation in which internal parties determine and prescribe the rules for handling accounts and produce a financial procedure." ;
    skos:example "Department heads agree the rules for handling overdue accounts next quarter." ;
    bpot:apqcSourceText "Determining rules for handling accounts. Discuss and plan with internal parties (department heads, managers, and senior management) about rules to follow in coming months." ;
    bpot:hierarchyID "9.2.4.4" ;
    bpot:pcfID "10807" .

bpot:P10808 a owl:Class ;
    rdfs:label "Process adjustments/write off balances" ;
    rdfs:comment "Posting/adjustment accounting act; output is the Descriptive transaction record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that adjusts or writes off uncollectible balances and maintains the related reserves, producing a transaction record." ;
    skos:example "Accounting writes off a bad debt and updates the allowance reserve." ;
    bpot:apqcSourceText "Maintaining reserves for write-offs and adjustments. Adjust or write off certain expenses and losses." ;
    bpot:hierarchyID "9.2.4.5" ;
    bpot:pcfID "10808" .

bpot:P10809 a owl:Class ;
    rdfs:label "Establish policies/procedures for adjustments" ;
    rdfs:comment "Directive output (Financial Procedure) -> Act of Formulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the guidelines to follow when making account adjustments and produces a financial procedure." ;
    skos:example "Finance documents the procedure for posting account adjustments." ;
    bpot:apqcSourceText "Creating guidelines to follow in case of adjustments to business processes." ;
    bpot:hierarchyID "9.2.5.1" ;
    bpot:pcfID "10809" .

bpot:P10810 a owl:Class ;
    rdfs:label "Analyze adjustments" ;
    rdfs:comment "Genus Act of Analysis (information processing into a Descriptive analysis)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:VarianceAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the alterations made in the final accounts during the year and produces a variance analysis identifying errors or omissions to rectify." ;
    skos:example "An accountant reviews the year's account adjustments to flag posting errors." ;
    bpot:apqcSourceText "Checking changes made in accounts during the year. Examine the alterations made in final accounts to rectify errors/omissions." ;
    bpot:hierarchyID "9.2.5.2" ;
    bpot:pcfID "10810" .

bpot:P10811 a owl:Class ;
    rdfs:label "Correspond/Negotiate with customer" ;
    rdfs:comment "Genus Act of Formulation: the definitional output is a prescribed offer (Directive ICE). The Customer participates." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that, through correspondence with a customer, determines and prescribes a suitable offer such as a discount as a financial procedure." ;
    skos:example "An agent offers a customer a settlement discount to clear an adjustment dispute." ;
    bpot:apqcSourceText "Providing suitable offers to customers. Present different offers (e.g., discounts) available for customers or buyers." ;
    bpot:hierarchyID "9.2.5.3" ;
    bpot:pcfID "10811" .

bpot:P10812 a owl:Class ;
    rdfs:label "Discuss resolution with internal parties" ;
    rdfs:comment "Directive output (Financial Procedure) -> Act of Formulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation in which internal parties discuss and prescribe the rules to follow for handling adjustments in the coming months and produce a financial procedure." ;
    skos:example "Managers agree the rules for processing customer deductions next quarter." ;
    bpot:apqcSourceText "Discussing and planning with internal parties (department heads, managers, and senior management) about rules to follow in coming months." ;
    bpot:hierarchyID "9.2.5.4" ;
    bpot:pcfID "10812" .

bpot:P10813 a owl:Class ;
    rdfs:label "Prepare chargeback invoices" ;
    rdfs:comment "Output bpo:Invoice (Descriptive ICE) is the chargeback document; the Supplier participates as the chargeback recipient." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:Invoice ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Supplier ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that prepares a chargeback invoice submitted to a supplier to recover an over-charged amount and produces that invoice." ;
    skos:example "A distributor issues a supplier chargeback invoice for an over-billed shipment." ;
    bpot:apqcSourceText "Creating a mechanism for consumer protection in case of a higher price charged. When a supplier sells a product at a higher price to the distributor than the price they have set with the end user, submit a chargeback to the supplier to recover the money lost in the transaction." ;
    bpot:hierarchyID "9.2.5.5" ;
    bpot:pcfID "10813" .

bpot:P10814 a owl:Class ;
    rdfs:label "Process related entries" ;
    rdfs:comment "Posting accounting act; output is the Descriptive transaction record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records related business transactions as they occur to maintain balanced accounts for financial reporting and produces a transaction record." ;
    skos:example "The ledger clerk records the offsetting entries for a processed deduction." ;
    bpot:apqcSourceText "Recording business transactions as they occur in order to provide a balanced accounts for financial reporting." ;
    bpot:hierarchyID "9.2.5.6" ;
    bpot:pcfID "10814" .

bpot:P10816 a owl:Class ;
    rdfs:label "Establish accounting policies" ;
    rdfs:comment "Genus Act of Formulation: output is a Financial Policy (Directive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the accounting policies and procedures governing how financial statements and disclosures are prepared." ;
    skos:example "A controller adopting a revenue-recognition policy for the organization." ;
    bpot:apqcSourceText "Establishing policies and procedures to prepare financial statements, including methods, measurement systems, and procedures for providing disclosures." ;
    bpot:hierarchyID "9.3.1.2" ;
    bpot:pcfID "10816" .

bpot:P10817 a owl:Class ;
    rdfs:label "Set and enforce approval limits" ;
    rdfs:comment "Genus Act of Formulation: output is an Approval Limit Specification (Directive ICE) per GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ApprovalLimitSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that sets the monetary thresholds and conditions governing financial-approval processes and prescribes their enforcement." ;
    skos:example "Defining tiered sign-off thresholds for expenditure approvals." ;
    bpot:apqcSourceText "Implementing parameters for accounting. Apply set conditions for any approval process." ;
    bpot:hierarchyID "9.3.1.4" ;
    bpot:pcfID "10817" .

bpot:P10818 a owl:Class ;
    rdfs:label "Establish common financial systems" ;
    rdfs:comment "Genus Act of Formulation: output is a Financial Procedure (Directive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the processes and procedures for exercising financial control and accountability over transactions affecting revenues, expenditures, assets, and liabilities." ;
    skos:example "Standing up a common ledger-posting and control procedure across business units." ;
    bpot:apqcSourceText "Establishing processes and procedures to exercise financial control and accountability. Record, verify, and report transactions that affect revenues, expenditures, assets, and liabilities." ;
    bpot:hierarchyID "9.3.1.5" ;
    bpot:pcfID "10818" .

bpot:P10819 a owl:Class ;
    rdfs:label "Maintain chart of accounts" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ChartOfAccounts ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that lists and updates the set of accounts used in the general ledger to produce a current chart of accounts." ;
    skos:example "Adding a new expense account to the chart of accounts for a new business line." ;
    bpot:apqcSourceText "Preparing trial balance account from general ledgers. List all accounts used in the general ledger. Alter accounts according to business requirements." ;
    bpot:hierarchyID "9.3.2.1" ;
    bpot:pcfID "10819" .

bpot:P10820 a owl:Class ;
    rdfs:label "Process journal entries" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records transactions as journal entries and posts them to produce the general ledger." ;
    skos:example "Posting the period's sales and purchase journals to the ledger." ;
    bpot:apqcSourceText "Making ledger and trial balance accounts from journal entries. This process requires the organization to record every transaction into accounts done by business. It is a base documents for preparing final accounts of company." ;
    bpot:hierarchyID "9.3.2.2" ;
    bpot:pcfID "10820" .

bpot:P10821 a owl:Class ;
    rdfs:label "Process allocations" ;
    rdfs:comment "Budget is a definitional input (the basis for apportionment); allocations are recorded as transaction records." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Budget ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that apportions funds across functions in line with the budget and records the allocations in centralized internal records." ;
    skos:example "Allocating shared overhead to business units per the approved budget." ;
    bpot:apqcSourceText "Allocating funds across functions. Apportion funds in line with the budgets created. Formalize allocations in centralized internal records." ;
    bpot:hierarchyID "9.3.2.3" ;
    bpot:pcfID "10821" .

bpot:P10822 a owl:Class ;
    rdfs:label "Process period end adjustments" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that updates journal entries to adjust income and expense balances at the close of an accounting period, updating the general ledger." ;
    skos:example "Booking accruals and deferrals at month-end close." ;
    bpot:apqcSourceText "Updating journal entries to adjust the balance of income and expenses at the end of an accounting period." ;
    bpot:hierarchyID "9.3.2.4" ;
    bpot:pcfID "10822" .

bpot:P10823 a owl:Class ;
    rdfs:label "Post and reconcile intercompany transactions" ;
    rdfs:comment "Subsidiaries are typical participants; recorded here as commentary rather than a definitional restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that posts and reconciles transactions between a parent company and its subsidiaries and documents them in the general ledger." ;
    skos:example "Reconciling an intercompany loan between a parent and its subsidiary." ;
    bpot:apqcSourceText "Checking accounts separately for a parent and subsidiary company. Manage relationship between a parent company and subsidiaries. Document intercompany transactions in separate financial statements." ;
    bpot:hierarchyID "9.3.2.5" ;
    bpot:pcfID "10823" .

bpot:P10824 a owl:Class ;
    rdfs:label "Reconcile general ledger accounts" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that compares general-ledger account balances against source documents to validate their integrity and produce a reconciled general ledger." ;
    skos:example "Tying cash-account balances to bank statements during close." ;
    bpot:apqcSourceText "Reviewing general ledger accounts for a parent and subsidiaries companies. Validate the integrity of account balances on the company's general ledger of accounts. Review and compare general ledger accounts balances with source documents to ensure that balances match." ;
    bpot:hierarchyID "9.3.2.6" ;
    bpot:pcfID "10824" .

bpot:P10825 a owl:Class ;
    rdfs:label "Perform consolidations and process eliminations" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that aggregates accounts across business processes and eliminates discontinued items to produce a consolidated general ledger." ;
    skos:example "Eliminating intercompany balances when consolidating group accounts." ;
    bpot:apqcSourceText "Aggregating different processes in the business. Eliminate discontinued processes." ;
    bpot:hierarchyID "9.3.2.7" ;
    bpot:pcfID "10825" .

bpot:P10826 a owl:Class ;
    rdfs:label "Prepare trial balance" ;
    rdfs:comment "Output corrected from bpo:GeneralLedger to bpo:TrialBalance: 'Prepare trial balance' produces a balanced trial balance (a distinct derived statement), not the general ledger. bpo:GeneralLedger is retained as the definitional has input (the trial balance is computed from it)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TrialBalance ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that totals debit and credit balances to produce a balanced trial balance as the basis for final accounts." ;
    skos:example "Producing the adjusted trial balance prior to drafting statements." ;
    bpot:apqcSourceText "Balancing debit and credit balances of trial balance to preparing final accounts. Calculate the total debits and credits in company's accounts. Correspond the sum of all debits with the sum of all credits. Adjust entries as appropriate." ;
    bpot:hierarchyID "9.3.2.8" ;
    bpot:pcfID "10826" .

bpot:P10827 a owl:Class ;
    rdfs:label "Prepare and post management adjustments" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records management- and policy-driven adjustments in the accounts, updating the general ledger." ;
    skos:example "Posting a management override to reclassify expenses after a tax-law change." ;
    bpot:apqcSourceText "Accounting for changes due to country-level policy changes. Record adjustments made by management in the accounts." ;
    bpot:hierarchyID "9.3.2.9" ;
    bpot:pcfID "10827" .

bpot:P10828 a owl:Class ;
    rdfs:label "Establish fixed-asset policies and procedures" ;
    rdfs:comment "Genus Act of Formulation: output is a Financial Procedure (Directive ICE) per GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the rules and procedures governing fixed-asset valuation, depreciation, provisions, resale, and usage." ;
    skos:example "Setting the straight-line depreciation policy for plant and equipment." ;
    bpot:apqcSourceText "Creating rules for fixed assets market valuation. Make rules and regulations for fixed assets regarding depreciation, provisions, resale, usage, etc." ;
    bpot:hierarchyID "9.3.3.1" ;
    bpot:pcfID "10828" .

bpot:P10829 a owl:Class ;
    rdfs:label "Maintain fixed-asset master data files" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that creates and keeps current the fixed-asset master data detailing price, life cycle, depreciation, and usage." ;
    skos:example "Updating an asset's useful-life parameter in the fixed-asset register." ;
    bpot:apqcSourceText "Keeping reports up-to-date regarding fixed assets. Create a fixed assets database detailing price, life cycle, depreciation rate, resale value, installation information, usage information, etc." ;
    bpot:hierarchyID "9.3.3.2" ;
    bpot:pcfID "10829" .

bpot:P10830 a owl:Class ;
    rdfs:label "Process and record fixed-asset additions and retires" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records additions and retirements of fixed assets during the fiscal year in the fixed-asset register." ;
    skos:example "Capitalizing a newly purchased machine and writing off a retired one." ;
    bpot:apqcSourceText "Keeping a summary of sales and purchases of assets. Record any expenses made for new assets purchased and sales of any old assets during the fiscal year." ;
    bpot:hierarchyID "9.3.3.3" ;
    bpot:pcfID "10830" .

bpot:P10831 a owl:Class ;
    rdfs:label "Process and record fixed-asset adjustments, enhancements, revaluations, and transfers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records fixed-asset adjustments, enhancements, revaluations, and inter-location transfers in the fixed-asset register." ;
    skos:example "Revaluing a building to current market price and recording the uplift." ;
    bpot:apqcSourceText "Keeping a summary of expenses for installing and modifying assets. Record any expenses made for new assets purchased, any expenses incurred on improvements, the valuation of assets to reach current market price, and any transfer assets from one location to another during the fiscal year." ;
    bpot:hierarchyID "9.3.3.4" ;
    bpot:pcfID "10831" .

bpot:P10832 a owl:Class ;
    rdfs:label "Process and record fixed-asset maintenance and repair expenses" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records the maintenance and repair expenses incurred to preserve fixed assets in the fixed-asset register." ;
    skos:example "Expensing a routine servicing cost against a vehicle asset." ;
    bpot:apqcSourceText "Maintaining a record of expenses necessitated for repairs and the preservation of assets. Administer and oversee the maintenance and repair of any fixed assets. Record all related transactions." ;
    bpot:hierarchyID "9.3.3.5" ;
    bpot:pcfID "10832" .

bpot:P10833 a owl:Class ;
    rdfs:label "Calculate and record depreciation expense" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that computes periodic depreciation on fixed assets and records the resulting expense and carrying value in the fixed-asset register." ;
    skos:example "Booking monthly straight-line depreciation for the asset base." ;
    bpot:apqcSourceText "Carrying out accounting for depreciation over fixed assets. Compute the sums necessitated. Maintain a record of the cost value of fixed assets over their useful life in the book of accounts." ;
    bpot:hierarchyID "9.3.3.6" ;
    bpot:pcfID "10833" .

bpot:P10834 a owl:Class ;
    rdfs:label "Reconcile fixed-asset ledger" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that balances and corrects the fixed-asset ledger so that its account balances are accurate." ;
    skos:example "Reconciling the fixed-asset subledger to the general ledger control account." ;
    bpot:apqcSourceText "Balancing the ledger account balance for fixed assets. Correct errors in the books of fixed assets. Provide correct information in relevant accounts." ;
    bpot:hierarchyID "9.3.3.7" ;
    bpot:pcfID "10834" .

bpot:P10835 a owl:Class ;
    rdfs:label "Track fixed-assets including physical inventory" ;
    rdfs:comment "Genus Act of Monitoring (not Accounting): the act observes assets over time and reconciles them to a physical count, maintaining a representational record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that checks fixed assets against physical inventory over time and updates the fixed-asset register to reflect their current state." ;
    skos:example "An annual physical-inventory count reconciled to the asset register." ;
    bpot:apqcSourceText "Checking and updating the record of all raw materials and fixed assets. Track all fixes asset. Maintain a record of all inventory items." ;
    bpot:hierarchyID "9.3.3.8" ;
    bpot:pcfID "10835" .

bpot:P10836 a owl:Class ;
    rdfs:label "Provide fixed-asset data to support tax, statutory, and regulatory reporting" ;
    rdfs:comment "Genus Act of Reporting: the act disseminates fixed-asset information; the Fixed-Asset Register is the definitional input and the conveyed Financial Report the output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FixedAssetRegister ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles fixed-asset data from the register and conveys it to support tax, statutory, and regulatory reporting." ;
    skos:example "Supplying depreciation schedules to the tax team for a return." ;
    bpot:apqcSourceText "Showing market value and related expenses on fixed assets data for taxation. Provide complete information recorded in the books of fixed assets about purchase price, depreciation, installation charges, resale market value etc. for tax and regulatory purposes." ;
    bpot:hierarchyID "9.3.3.9" ;
    bpot:pcfID "10836" .

bpot:P10837 a owl:Class ;
    rdfs:label "Prepare business unit financial statements" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares the financial statements of a single business unit from its general-ledger balances." ;
    skos:example "Producing a division's standalone income statement and balance sheet." ;
    bpot:apqcSourceText "Making reports of subsidiaries units to show profits generated from them. Prepare financial statements (balance sheets, income statements, cash flow statements and statements of shareholders' equity) for a single unit of a business." ;
    bpot:hierarchyID "9.3.4.1" ;
    bpot:pcfID "10837" .

bpot:P10838 a owl:Class ;
    rdfs:label "Prepare consolidated financial statements" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConsolidatedFinancialStatement ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that combines the accounts of a parent company and its subsidiaries to produce consolidated financial statements." ;
    skos:example "Preparing group consolidated statements at year-end." ;
    bpot:apqcSourceText "Making final accounts for all units of company together. Prepare combined financial statements of a parent company and its subsidiaries (i.e., separate legal entities controlled by a parent company) showing assets, liabilities, equity, income, expenses, and cash flows." ;
    bpot:hierarchyID "9.3.4.2" ;
    bpot:pcfID "10838" .

bpot:P10839 a owl:Class ;
    rdfs:label "Perform business unit reporting/review management reports" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares and reviews business-unit management reports breaking down results by function, client, product, and region." ;
    skos:example "Issuing a divisional profitability pack for the monthly management review." ;
    bpot:apqcSourceText "Making reports for units/subsidiaries to help management in decision making. Prepare financial statements (balance sheets, income statements, cash flow statements, and statements of shareholders' equity) for a single unit of a business. Break down profits and losses by function/unit, clients, products, and region." ;
    bpot:hierarchyID "9.3.4.3" ;
    bpot:pcfID "10839" .

bpot:P10840 a owl:Class ;
    rdfs:label "Perform consolidated reporting/review of cost management reports" ;
    rdfs:comment "Variance analysis is a typical reviewed input; recorded as commentary rather than a definitional restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConsolidatedFinancialStatement ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares consolidated management reports combining all units' results and reviewing actual-versus-estimated cost variances." ;
    skos:example "Reviewing group cost variances alongside the consolidated results." ;
    bpot:apqcSourceText "Making reports for all units to help higher management in decision making. Prepare combined financial statements of a parent company and its all subsidiaries (separate legal entities controlled by a parent company) showing assets, liabilities, equity, income, expenses and cash flows, and also going through periodic reports which shows the actual and estimated costs and their variances." ;
    bpot:hierarchyID "9.3.4.4" ;
    bpot:pcfID "10840" .

bpot:P10841 a owl:Class ;
    rdfs:label "Prepare statements for board review" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares a draft of the financial statements for board review prior to audit." ;
    skos:example "Circulating draft annual statements to the audit committee." ;
    bpot:apqcSourceText "Preparing a draft of financial statements for the board to review before they are sent to the auditor." ;
    bpot:hierarchyID "9.3.4.5" ;
    bpot:pcfID "10841" .

bpot:P10842 a owl:Class ;
    rdfs:label "Produce quarterly/annual filings and shareholder reports" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that produces quarterly and annual financial filings and shareholder reports and presents them to stakeholders." ;
    skos:example "Publishing the annual report and 10-K filing." ;
    bpot:apqcSourceText "Making and presenting financial reports to stakeholders. Create annual and quarterly financial statements for reporting purposes. Prepare shareholder reports with details of the profit-and-loss account, balance sheet, and past year's business activities." ;
    bpot:hierarchyID "9.3.4.6" ;
    bpot:pcfID "10842" .

bpot:P10843 a owl:Class ;
    rdfs:label "Produce regulatory reports" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RegulatoryFiling ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles final-account data in accordance with rules and regulations to produce a regulatory filing." ;
    skos:example "Filing statutory accounts with the securities regulator." ;
    bpot:apqcSourceText "Reporting raw or summary data for final accounts following rules and regulations." ;
    bpot:hierarchyID "9.3.4.7" ;
    bpot:pcfID "10843" .

bpot:P10844 a owl:Class ;
    rdfs:label "Develop capital investment policies and procedures" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (inlined) because creating policies/procedures composes Directive ICEs (Golden Principle: Formulation -> Directive)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the financial policies and procedures governing investment in capital projects." ;
    skos:example "Treasury drafts the corporate capital-investment policy and the accompanying approval procedure." ;
    bpot:apqcSourceText "Creating procedures and policies to follow for investing in capital projects. Create rules and regulations regarding large investment plans, which require in-depth forecasting for expenditure and revenue." ;
    bpot:hierarchyID "9.4.1.1" ;
    bpot:pcfID "10844" .

bpot:P10845 a owl:Class ;
    rdfs:label "Develop and approve capital expenditure plans and budgets" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: developing a budget composes a Directive ICE. The 'approve' facet ratifies the same budget and does not introduce a separate candidate set, so no separate selection act is modeled." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:Budget ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that prepares a capital-expenditure plan and budget for a heavy-investment project and secures management approval of it." ;
    skos:example "A project manager builds a multi-year capital-expenditure budget and obtains sign-off from the board." ;
    bpot:apqcSourceText "Creating budgets, and soliciting approvals for capital projects. Prepare budgets for projects that require heavy investments. Secure approvals from management." ;
    bpot:hierarchyID "9.4.1.2" ;
    bpot:pcfID "10845" .

bpot:P10846 a owl:Class ;
    rdfs:label "Review and approve capital projects and fixed-asset acquisitions" ;
    rdfs:comment "Re-anchored from cco:ont00000636 (Act of Appraisal) to bpo:ActOfSelection to satisfy the GOLDEN PRINCIPLE: the sole asserted output is bpo:ProjectApprovalDecision, a Directive ICE (cco:ont00000965), whereas an Act of Appraisal characteristically yields a DESCRIPTIVE judgement ('judges without committing', per apqc-ext). The act fuses a review/evaluate facet with an authorize/approve facet; the definitional product is the authorization (a go/no-go choice among the proposed investments), which is exactly what bpo:ActOfSelection was minted for ('chooses ... and produces a Directive Information Content Entity that prescribes the chosen option(s)'). REJECTED candidate cco:ont00000636 (Act of Appraisal): retained for the evaluative facet only would force a Descriptive output and split the act; here the directive approval is definitional, so Selection is the correct genus. Aligned with sibling bpo:P10851 (also a go/no-go decision -> bpo:ActOfSelection)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectApprovalDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that reviews proposed capital projects and fixed-asset acquisitions and authorizes which are to proceed, producing a project approval decision." ;
    skos:example "An investment committee reviews a capital project's details and approves the acquisition of the related fixed assets." ;
    bpot:apqcSourceText "Evaluating and supporting capital investments in projects and fixed assets. Confirm details of capital projects. Secure approvals from managements for large investments." ;
    bpot:hierarchyID "9.4.1.3" ;
    bpot:pcfID "10846" .

bpot:P10847 a owl:Class ;
    rdfs:label "Conduct financial justification for project approval" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it evaluates a business case's value. Output bpo:FinancialJustification is a Descriptive ICE (it represents an argument, it does not prescribe). Cost data is a typical input, recorded as comment not restriction (Phase-3)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialJustification ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that juxtaposes the projected benefits of a capital project against its costs and produces a financial justification substantiating the project's expected financial gains." ;
    skos:example "An analyst validates a project's business case and documents a cost-benefit justification recommending approval." ;
    bpot:apqcSourceText "Reviewing all project business cases in order to substantiate projected financial gains. Validate any project's business case. Juxtapose the benefits derived from moving a project forward against the associated costs." ;
    bpot:hierarchyID "9.4.1.4" ;
    bpot:pcfID "10847" .

bpot:P10848 a owl:Class ;
    rdfs:label "Create project account codes" ;
    rdfs:comment "Anchored to bpo:ActOfAccounting (creating classification codes within a system of accounts). Output bpo:ProjectAccountCode is a Descriptive ICE; bpo:ChartOfAccounts (the master structure) was rejected as too broad for a single per-project code." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectAccountCode ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that assigns a reference account code to each capital project so that its transactions can be classified and tracked." ;
    skos:example "The ledger administrator opens a new project and issues it a unique cost-collection account code." ;
    bpot:apqcSourceText "Giving reference codes for every project." ;
    bpot:hierarchyID "9.4.2.1" ;
    bpot:pcfID "10848" .

bpot:P10849 a owl:Class ;
    rdfs:label "Record project-related transactions" ;
    rdfs:comment "Anchored to bpo:ActOfAccounting. Output bpo:TransactionRecord is a Descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that documents every financial transaction associated with a capital project into a centralized repository, producing the project's transaction records." ;
    skos:example "A clerk posts each invoice and payment for a construction project to the shared project ledger." ;
    bpot:apqcSourceText "Noting every transaction during a project in a common financial database. Document all transactions associated with any project. Maintain a centralized repository of all such financial data." ;
    bpot:hierarchyID "9.4.2.2" ;
    bpot:pcfID "10849" .

bpot:P10850 a owl:Class ;
    rdfs:label "Monitor and track capital projects and budget spending" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring. The Budget is definitional (the comparison reference), so it is asserted as an input restriction; cost data is a typical input recorded in comment only (Phase-3)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Budget ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:VarianceAnalysis ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that observes the funds invested in a capital project, compares actual spending against its budget, and produces a variance analysis." ;
    skos:example "A controller tracks a project's cumulative spend against its approved budget and reports the variance each month." ;
    bpot:apqcSourceText "Evaluating project progress and funds invested. Observe and track significant funds invested on any long-term project. Compare to budget." ;
    bpot:hierarchyID "9.4.2.3" ;
    bpot:pcfID "10850" .

bpot:P10851 a owl:Class ;
    rdfs:label "Close/capitalize projects" ;
    rdfs:comment "Re-anchored from bpo:ActOfAccounting to bpo:ActOfSelection (D2 / Phase-1 fix). The verbatim apqcSourceText is an APPRAISAL-and-DECISION act: 'Checking for returns generated from projects for decision making. Evaluate capital projects ... Decide whether to proceed based on the revenues generated.' It never mentions closing or capitalizing onto the fixed-asset register; the previous 'close/capitalize' genus and bpo:FixedAssetRegister output were supplied from the LABEL, discarding the row's evaluate+decide meaning. Per D2 the genus must come from the de-conflated description, which describes evaluation of returns plus a go/no-go decision -- the same act kind as its 9.4.2 siblings bpo:P10846 (review+approve) and bpo:P10852 (measure returns). GOLDEN PRINCIPLE + sibling consistency: the definitional product is a Directive go/no-go decision (bpo:ProjectContinuationDecision), so the genus is bpo:ActOfSelection (chooses among proceed/not-proceed, produces a Directive ICE), aligned with bpo:P10846. REJECTED candidates: bpo:ActOfAccounting (label-driven, asserts a bookkeeping capitalization the description does not describe) and cco:ont00000636 (Act of Appraisal) (would pair an Appraisal genus with a Directive decision output, breaking genus-output agreement -- see bpo:P10846). bpo:ProfitabilityAnalysis (returns data) is the Descriptive input baseline. If a genuine bookkeeping 'capitalize onto fixed-asset register' facet is intended, it should be split into a separate Act of Accounting child rather than overwriting this PCF row's evaluative meaning." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ProfitabilityAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProjectContinuationDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that evaluates the returns generated by a capital project and decides whether to proceed with it, producing a project continuation decision." ;
    skos:example "On reviewing a project's realized returns, the committee decides to continue (or halt) the investment." ;
    bpot:apqcSourceText "Checking for returns generated from projects for decision making. Evaluate capital projects that require heavy investments. Decide whether to proceed based on the revenues generated." ;
    bpot:hierarchyID "9.4.2.4" ;
    bpot:pcfID "10851" .

bpot:P10852 a owl:Class ;
    rdfs:label "Measure financial returns on completed capital projects" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it measures/judges the project's return. The financial forecast is definitional (the comparison baseline), asserted as an input restriction; output bpo:ProfitabilityAnalysis is a Descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialForecast ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProfitabilityAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that compares a completed capital project's actual returns against its forecasted returns and produces a profitability analysis." ;
    skos:example "A finance analyst measures a finished plant project's realized IRR against the forecast and reports its profitability." ;
    bpot:apqcSourceText "Comparing a finished project's profitability with forecasted returns. Scrutinize revenues generated by completed projects that required heavy investments. Determine profitability." ;
    bpot:hierarchyID "9.4.2.5" ;
    bpot:pcfID "10852" .

bpot:P10853 a owl:Class ;
    rdfs:label "Establish policies and procedures" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (output is a Directive ICE) per the GOLDEN PRINCIPLE: developing policies/procedures produces a prescription, not a description." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a financial procedure prescribing how compensation is to be calculated." ;
    skos:example "HR drafts the standard operating procedure for computing employee compensation." ;
    bpot:apqcSourceText "Developing policies and procedures for the HR function to calculate compensation." ;
    bpot:hierarchyID "9.5.1.1" ;
    bpot:pcfID "10853" .

bpot:P10854 a owl:Class ;
    rdfs:label "Collect and record employee time worked" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TimeRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that collects the daily hours worked by each employee and produces an employee time record." ;
    skos:example "Recording every employee's clock-in and billable hours each day." ;
    bpot:apqcSourceText "Tracking billing hours of each employee on daily basis." ;
    bpot:hierarchyID "9.5.1.2" ;
    bpot:pcfID "10854" .

bpot:P10855 a owl:Class ;
    rdfs:label "Analyze and report paid and unpaid leave" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TimeRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LeaveRecord ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input employee time records and produces a leave report describing the paid and unpaid leave allowed to and taken by employees." ;
    skos:example "Producing a monthly leave-balance report from recorded time data." ;
    bpot:apqcSourceText "Tracking leaves allowed and taken by employees." ;
    bpot:hierarchyID "9.5.1.3" ;
    bpot:pcfID "10855" .

bpot:P10856 a owl:Class ;
    rdfs:label "Monitor regular, overtime, and other hours" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring: ongoing daily observation of hours against company standards, output is a descriptive record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TimeRecord ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that tracks the regular, overtime, and other hours worked by employees and produces an employee time record registering them." ;
    skos:example "Daily tracking of overtime hours against the standard work week." ;
    bpot:apqcSourceText "Observing the number of hours worked by an employees on daily basis. Track the number of hours worked by an employee, as well as the number of hours worked beyond normal working hour's according to company standards." ;
    bpot:hierarchyID "9.5.1.4" ;
    bpot:pcfID "10856" .

bpot:P10857 a owl:Class ;
    rdfs:label "Analyze and report employee utilization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TimeRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EmployeeUtilizationReport ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input employee time records and produces an employee utilization report describing employees' productive hours." ;
    skos:example "Computing and reporting each employee's billable-utilization ratio." ;
    bpot:apqcSourceText "Monitoring the number of productive hours for employees." ;
    bpot:hierarchyID "9.5.1.5" ;
    bpot:pcfID "10857" .

bpot:P10858 a owl:Class ;
    rdfs:label "Enter employee time worked into payroll system" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TimeRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that has as input an employee time record and registers the hours worked into the payroll system as a transaction record for salary calculation." ;
    skos:example "Importing approved timesheet hours into the payroll engine before a pay run." ;
    bpot:apqcSourceText "Tracking the number of hours worked for the payroll system. Register the number of hours worked by an employee into the payroll system for the purpose of calculating salaries or wages." ;
    bpot:hierarchyID "9.5.2.1" ;
    bpot:pcfID "10858" .

bpot:P10859 a owl:Class ;
    rdfs:label "Maintain and administer employee earnings information" ;
    rdfs:comment "Re-anchored from bpo:ActOfMonitoring to bpo:ActOfAccounting (false-friend fix). The source text ('manage and update information pertaining to the structure of every employee's salary ... updating any changes ... in a central repository') describes record creation/maintenance, not observation. bpo:ActOfMonitoring is defined as observing an ongoing process/position over time AGAINST EXPECTED PARAMETERS; maintaining a salary-structure repository involves no comparison against expected parameters and is not status observation -- it is records upkeep, which bpo:ActOfAccounting's scope ('produces or UPDATES a Descriptive ICE ... maintain ledgers/master files') covers. The Descriptive output (bpo:EarningsInformation) and R5 hold; only the act genus changes. Anchored identically to its 'Maintain and administer' twin bpo:P10860." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EarningsInformation ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that maintains and updates the employee earnings information held in a central repository, producing an updated employee-earnings record." ;
    skos:example "Updating an employee's salary-structure record after a raise." ;
    bpot:apqcSourceText "Tracking and oversee salary breakups of employees. This process requires the organization to manage and update information pertaining to the structure of every employee's salary. This would involve the updating any changes to the salary structures of the employees, in a central repository which can be accessed by pertinent departments." ;
    bpot:hierarchyID "9.5.2.2" ;
    bpot:pcfID "10859" .

bpot:P10860 a owl:Class ;
    rdfs:label "Maintain and administer applicable deductions" ;
    rdfs:comment "Re-anchored from bpo:ActOfMonitoring to bpo:ActOfAccounting (same false-friend fix as its twin bpo:P10859). The source verb is literally 'Processing'/'Keep and manage' ('Processing salary deductions for tax purposes. Keep and manage the details of every employee's salary deductions ...'), i.e. maintaining deduction records, not observing a position against expected parameters (the bpo:ActOfMonitoring differentia). Records upkeep falls under bpo:ActOfAccounting ('produces or UPDATES a Descriptive ICE ... maintain ledgers/master files'). Output bpo:PayrollDeductionRecord (Descriptive) and R5 are unchanged. Anchored identically to bpo:P10859 so the 'Maintain and administer' pair is consistent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PayrollDeductionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that keeps current the details of each employee's salary deductions and produces a payroll deduction record." ;
    skos:example "Recording an employee's updated investment declarations to adjust deductions." ;
    bpot:apqcSourceText "Processing salary deductions for tax purposes. Keep and manage the details of every employee's salary deductions based on their expenses and investments during the year." ;
    bpot:hierarchyID "9.5.2.3" ;
    bpot:pcfID "10860" .

bpot:P10861 a owl:Class ;
    rdfs:label "Monitor changes in tax status of employees" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring: ongoing tracking of tax-status changes; output is descriptive tax data." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxData ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that tracks changes in employees' tax status and produces updated tax data for payroll deduction." ;
    skos:example "Detecting an employee's change of tax bracket and flagging it for the next pay run." ;
    bpot:apqcSourceText "Tracking changes in the salary structure of employees for tax deductions." ;
    bpot:hierarchyID "9.5.2.4" ;
    bpot:pcfID "10861" .

bpot:P10862 a owl:Class ;
    rdfs:label "Process and distribute payments" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to bpo:ActOfRemuneration (the verified CCO leaf cco:ont00000449): an unambiguous employer->employee salary disbursement -- the exact differentia of Remuneration. The disbursed payment is a MATERIAL participant (obo:BFO_0000057), not has output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Employee ],
        bpot:ActOfRemuneration ;
    skos:definition "An Act of Remuneration that disburses salaries to employees, producing a monetary payment to each employee in compensation for services performed." ;
    skos:example "Paying every employee's net salary by direct deposit on payday." ;
    bpot:apqcSourceText "Processing and distributing salaries to all employees. Execute the payroll management function through the dispensation of employee salaries. Leverage a centralized database of all payroll expenses." ;
    bpot:hierarchyID "9.5.2.5" ;
    bpot:pcfID "10862" .

bpot:P10863 a owl:Class ;
    rdfs:label "Process and distribute manual checks" ;
    rdfs:comment "The monetary payment is a MATERIAL participant (obo:BFO_0000057), not has output; the off-cycle manual check corrects a prior payroll error. Substantively an Act of Remuneration (cco:ont00000449) but kept under bpo:ActOfFinancialTransaction: as an error-correction disbursement its differentia is rectifying an omission, one step removed from the canonical compensation-for-services run (cf. bpo:P10862, which moves to bpo:ActOfRemuneration)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that issues a manual payment to correct an incorrect or omitted salary payment, producing a monetary payment to the affected employee." ;
    skos:example "Cutting a manual check for an employee whose overtime was missed in the main run." ;
    bpot:apqcSourceText "Handling incorrect/omitted salary payments." ;
    bpot:hierarchyID "9.5.2.6" ;
    bpot:pcfID "10863" .

bpot:P10864 a owl:Class ;
    rdfs:label "Process period-end adjustments" ;
    rdfs:comment "Anchored to bpo:ActOfAccounting: reconciling/adjusting financial records; output is a descriptive ICE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PayrollDeductionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PeriodEndAdjustmentRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that reconciles and adjusts employees' salary deductions at the close of a tax period and produces a payroll period-end adjustment record." ;
    skos:example "Recomputing year-end tax deductions and posting the correcting adjustments." ;
    bpot:apqcSourceText "Adjusting salary deductions for tax purposes at the end of the year." ;
    bpot:hierarchyID "9.5.2.7" ;
    bpot:pcfID "10864" .

bpot:P10865 a owl:Class ;
    rdfs:label "Respond to employee payroll inquiries" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PayrollInquiryResponse ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Employee ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that addresses an employee's salary-related query and produces a payroll inquiry response." ;
    skos:example "Answering an employee's question about why a deduction changed this month." ;
    bpot:apqcSourceText "Addressing salary-related queries raised by employees." ;
    bpot:hierarchyID "9.5.2.8" ;
    bpot:pcfID "10865" .

bpot:P10867 a owl:Class ;
    rdfs:label "Produce and distribute employee annual tax statements" ;
    rdfs:comment "Anchored to bpo:ActOfReporting: compiling and issuing a statement; output is a descriptive ICE delivered to employees." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EmployeeTaxStatement ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Employee ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles and issues an employee annual tax statement describing the tax withheld from each employee's salary." ;
    skos:example "Issuing each employee a year-end statement of wages and taxes withheld." ;
    bpot:apqcSourceText "Providing tax deductions statements created by certified chartered accountants to every employee for their reference or refunds." ;
    bpot:hierarchyID "9.5.3.4" ;
    bpot:pcfID "10867" .

bpot:P10868 a owl:Class ;
    rdfs:label "File regulatory payroll tax forms" ;
    rdfs:comment "Anchored to bpo:ActOfReporting: compiling and issuing a filing to an authority; output is a descriptive ICE (regulatory filing)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RegulatoryFiling ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles and submits the required payroll-tax forms to a regulatory authority, producing a regulatory filing." ;
    skos:example "Submitting the quarterly payroll-tax return to the revenue authority." ;
    bpot:apqcSourceText "Filling taxes, and highlighting different sources of income and expenditures made." ;
    bpot:hierarchyID "9.5.3.5" ;
    bpot:pcfID "10868" .

bpot:P10869 a owl:Class ;
    rdfs:label "Verify AP pay file with purchase order vendor master file" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges an entry against a reference record, yielding a descriptive match judgement (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:VendorMasterFile ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PaymentMatchResult ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that checks accounts-payable pay-file entries against the vendor master file and produces a payment match result." ;
    skos:example "An AP clerk three-way-matching an invoice to the PO and vendor master before release." ;
    bpot:apqcSourceText "Matching records of bills to be paid with accounts. Check accounts payable entries with vendor's account for every payment made." ;
    bpot:hierarchyID "9.6.1.1" ;
    bpot:pcfID "10869" .

bpot:P10870 a owl:Class ;
    rdfs:label "Maintain/Manage electronic commerce" ;
    rdfs:comment "Anchored to bpo:ActOfMonitoring (cco:ont00000366): the source ('Tracking all online transactions') is longitudinal observation of a transaction stream, not a one-shot analysis. The status output is descriptive (TransactionRecord)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that tracks an organization's online accounts-payable transactions and produces a record of their status." ;
    skos:example "An e-commerce settlement console tracking the day's online supplier payments." ;
    bpot:apqcSourceText "Tracking all online transactions." ;
    bpot:hierarchyID "9.6.1.2" ;
    bpot:pcfID "10870" .

bpot:P10871 a owl:Class ;
    rdfs:label "Audit invoices and key data in AP system" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): auditing/evaluating registered bills judges them against records and yields a descriptive finding. Invoice is a typical input (commented, not definitional)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Invoice ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AuditJudgement ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates invoices and key data registered in the accounts-payable system and produces an invoice audit judgement." ;
    skos:example "An AP auditor reviewing posted invoices for accuracy and policy compliance." ;
    bpot:apqcSourceText "Monitoring and evaluating bills registered in accounts books. Check all invoices. Maintain records." ;
    bpot:hierarchyID "9.6.1.3" ;
    bpot:pcfID "10871" .

bpot:P10872 a owl:Class ;
    rdfs:label "Approve payments" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act) -- the §6-documented TOP intentional-act anchor -- because the act is an AUTHORIZATION/RATIFICATION of a single already-settled payment, for which CCO 2.0 has no dedicated act kind. REJECTED candidates (D5/§6 step 3): (1) cco:ont00000636 'Act of Appraisal' -- an Appraisal characteristically yields a DESCRIPTIVE judgement ('judges without committing'), but the definitional product here is the Directive bpo:PaymentApproval (an authorization that prescribes release), so re-anchoring to Appraisal would break the GOLDEN-PRINCIPLE genus-output agreement; the act commits rather than merely judges. (2) bpo:ActOfSelection -- there is no candidate set; approval ratifies one already-settled payment, and the apqc-ext ActOfSelection note explicitly routes 'ratifying a single already-settled option' to cco:ont00000228. The bare Planned Act is therefore the nearest correct class whose genus does not contradict the Directive output. Anchored identically to its 9.6 approval siblings bpo:P10882 and bpo:P20934 (sibling consistency)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PaymentApproval ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that authorizes a settled payment for products or services and produces a payment approval decision." ;
    skos:example "A controller approving a vetted supplier payment for release." ;
    bpot:apqcSourceText "Processing payments for products/services." ;
    bpot:hierarchyID "9.6.1.4" ;
    bpot:pcfID "10872" .

bpot:P10873 a owl:Class ;
    rdfs:label "Process financial accruals and reversals" ;
    rdfs:comment "Anchored to bpo:ActOfAccounting (cco:ont00000366): bookkeeping entries are recorded into a descriptive ledger artifact." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that records accrual and reversal entries in the books of accounts and produces the corresponding transaction records." ;
    skos:example "Month-end posting of accrued expenses and the reversal of the prior period's adjusting entries." ;
    bpot:apqcSourceText "Handling transactions for accruals and reversals. Record transactions in the books of accounts on an accrual basis (irrespective of the actual cash flow) and reversals basis (cancel out the adjusting entries) for balancing accounts." ;
    bpot:hierarchyID "9.6.1.5" ;
    bpot:pcfID "10873" .

bpot:P10874 a owl:Class ;
    rdfs:label "Process payables taxes" ;
    rdfs:comment "Anchored to bpo:ActOfReporting (cco:ont00000366): tax data is compiled into a return (Descriptive ICE) for submission." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxReturn ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares and files the payables taxes owed by an organization and produces a tax return." ;
    skos:example "Preparing and filing withholding/income tax returns tied to payables as of the balance-sheet date." ;
    bpot:apqcSourceText "Filing the amount of taxes that a company owes as of the balance sheet date. Prepare tax returns, including the income tax filing for an individual or business entity from earnings." ;
    bpot:hierarchyID "9.6.1.6" ;
    bpot:pcfID "10874" .

bpot:P10875 a owl:Class ;
    rdfs:label "Research/Resolve payable exceptions" ;
    rdfs:comment "Anchored directly to cco:ont00000366 (Act of Information Processing): ad hoc research/resolution of a payable anomaly producing a descriptive disposition record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ExceptionResolutionRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that investigates an atypical or inconsistent accounts-payable situation and produces a payable exception resolution record." ;
    skos:example "An AP analyst researching a duplicate-payment exception and recording its resolution." ;
    bpot:apqcSourceText "Resolving any atypical or inconsistent situation concerning payments to be made by the organization. Address any exceptional case of accounts payable on an ad hoc basis, by seeking counsel or carrying out any necessary research." ;
    bpot:hierarchyID "9.6.1.7" ;
    bpot:pcfID "10875" .

bpot:P10876 a owl:Class ;
    rdfs:label "Process payments" ;
    rdfs:comment "Anchored to bpo:ActOfFinancialTransaction (cco:ont00000228). The disbursed monetary payment is a MATERIAL participant (obo:BFO_0000057), not has output (operations material-I/O rule). The supplier is a definitional participant (it receives the payment)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Supplier ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that disburses monetary payment for products or services on the due dates of an agreed payment cycle." ;
    skos:example "Releasing a scheduled ACH run to suppliers on invoice due dates." ;
    bpot:apqcSourceText "Making payments for products/services on due dates (payment cycle) decided by parties involved." ;
    bpot:hierarchyID "9.6.1.8" ;
    bpot:pcfID "10876" .

bpot:P10877 a owl:Class ;
    rdfs:label "Respond to AP inquiries" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication, a Planned Act in which an ICE is transferred from one Agent to another). The transferred clarification is descriptive; the supplier is the definitional recipient/participant. Explicit rdfs:subClassOf cco:ont00000228 (Planned Act) added so the act-anchor chain is visible to the standalone SHACL run (ont00000402 is a CCO subclass of ont00000228, but the closure is not merged for Gate C). VERIFICATION (D6/§6): cco:ont00000402 verified against the pinned CCO v2.0 (2024-11-06) closure -- rdfs:label 'Act of Communication'@en, skos:definition 'A Planned Act in which some Information Content Entity is transferred from some Agent to Another', rdfs:subClassOf cco:ont00000228 (Planned Act). This is the correct verified communication class and is NOT the §6 false-friend reject cco:ont00001261 'Act of Identifying' (an Act of Representative Communication for discernment); ont00000402 genuinely denotes agent-to-agent ICE transfer, the act kind required for an inquiry response. It should be added to the §6 verified-core-terms table as the canonical Act-of-Communication anchor used corpus-wide (transmit-only nodes)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Supplier ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that clarifies queries about accounts-payable particulars and transfers the clarifying information to the inquiring party." ;
    skos:example "AP staff answering a supplier's query about a payment date and discount taken." ;
    bpot:apqcSourceText "Clarifying or address queries relating to the particulars of AP such as date, discounts, amount, and installments. Coordinate with concerned parties about the fulfillment of bills payable." ;
    bpot:hierarchyID "9.6.1.9" ;
    bpot:pcfID "10877" .

bpot:P10878 a owl:Class ;
    rdfs:label "Retain records" ;
    rdfs:comment "Re-anchored from bpo:ActOfAccounting to cco:ont00000366 (Act of Information Processing) directly, and the I/O direction corrected. Two defects fixed: (1) Genus stretch -- bpo:ActOfAccounting is defined as recording, classifying, posting, or reconciling transactions; retaining/archiving bills 'for future reference' is records retention/storage, none of those verbs, so it is generic records-management information processing. (2) Wrong I/O direction -- 'has output some bpo:TransactionRecord' was a semantic inversion: retention does not PRODUCE a transaction record; the record already exists and is being preserved, so it is an input/object, not an output generated at the end (contra cco:ont00001986's 'output present at end because the process made it'). The retained record is therefore modeled as has input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that preserves the bills and transaction records of every accounts-payable transaction for future reference." ;
    skos:example "Archiving paid invoices and remittance advices to the records repository." ;
    bpot:apqcSourceText "Keeping bills of every transaction for future reference." ;
    bpot:hierarchyID "9.6.1.10" ;
    bpot:pcfID "10878" .

bpot:P10879 a owl:Class ;
    rdfs:label "Adjust accounting records" ;
    rdfs:comment "Anchored to bpo:ActOfAccounting (cco:ont00000366): correcting bookkeeping entries updates a descriptive record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that rectifies alterations that occurred while recording in the accounts and produces corrected transaction records." ;
    skos:example "Posting correcting journal entries for a mis-keyed invoice amount." ;
    bpot:apqcSourceText "Rectifying for alterations occurred in accounts while recording." ;
    bpot:hierarchyID "9.6.1.11" ;
    bpot:pcfID "10879" .

bpot:P10880 a owl:Class ;
    rdfs:label "Establish and communicate expense reimbursement policies and approval limits" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (inlined; cco:ont00000511): setting reimbursement policy and limits composes a Directive ICE (GOLDEN PRINCIPLE). Communicating it to employees is a typical downstream adjunct, not a separate definitional output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that sets the policies and approval limits governing employee expense reimbursements and produces a financial policy." ;
    skos:example "Finance issuing an updated travel-and-expense policy with per-diem caps." ;
    bpot:apqcSourceText "Explaining policies and procedures related to reimbursements requests by employees. Set policies regarding reimbursement process and amount limits etc. Inform employees." ;
    bpot:hierarchyID "9.6.2.1" ;
    bpot:pcfID "10880" .

bpot:P10881 a owl:Class ;
    rdfs:label "Capture and report relevant tax data" ;
    rdfs:comment "Anchored to bpo:ActOfReporting (cco:ont00000366): pertinent information is compiled into a descriptive tax-data report." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxData ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that collects and reports the tax information pertinent to taxes paid by an organization's employees and produces tax data." ;
    skos:example "Compiling employee per-diem and reimbursement amounts for payroll-tax reporting." ;
    bpot:apqcSourceText "Collecting and reporting all pertinent information regarding the taxes paid by the organization's employees." ;
    bpot:hierarchyID "9.6.2.2" ;
    bpot:pcfID "10881" .

bpot:P10882 a owl:Class ;
    rdfs:label "Approve reimbursements and advances" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act) -- the §6 TOP intentional-act anchor -- as an AUTHORIZATION/RATIFICATION of a single already-settled request (no candidate set), for which CCO 2.0 has no dedicated act kind. REJECTED candidates (D5/§6 step 3), uniform with sibling bpo:P10872: (1) cco:ont00000636 'Act of Appraisal' -- would pair an Appraisal genus (Descriptive judgement, 'judges without committing') with the Directive bpo:PaymentApproval output, breaking GOLDEN-PRINCIPLE agreement; the act commits/authorizes rather than merely judging. (2) bpo:ActOfSelection -- no candidate set; the apqc-ext ActOfSelection note routes 'ratifying a single already-settled option' to cco:ont00000228. The employee is the definitional participant whose request is approved. Anchored identically to bpo:P10872 and bpo:P20934 (sibling consistency)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PaymentApproval ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Employee ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000063 ;
            owl:someValuesFrom bpot:P10883 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that authorizes an employee's expense-reimbursement or advance request and produces a payment approval decision." ;
    skos:example "A manager approving an employee's travel-advance request." ;
    bpot:apqcSourceText "Permitting expense reimbursement requests from employees." ;
    bpot:hierarchyID "9.6.2.3" ;
    bpot:pcfID "10882" .

bpot:P10884 a owl:Class ;
    rdfs:label "Manage personnel accounts" ;
    rdfs:comment "R5: despite the 'Manage' label the source ('Maintaining accounts') denotes discrete record-maintenance acts over personnel-account records, a bounded occurrent, not a no-end standing function. Anchored to bpo:ActOfAccounting (cco:ont00000366)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AccountStatement ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that maintains the financial accounts of individuals connected with the business and produces updated account statements." ;
    skos:example "Updating an employee's advance/reimbursement balance after a settlement." ;
    bpot:apqcSourceText "Maintaining accounts of individuals who are connected with business." ;
    bpot:hierarchyID "9.6.2.5" ;
    bpot:pcfID "10884" .

bpot:P10886 a owl:Class ;
    rdfs:label "Establish and publish treasury policies" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output). Reuses shared bpo:FinancialPolicy (treasury investment policy)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a financial policy that prescribes the organization's investment regulations." ;
    skos:example "Treasury issues and circulates the written corporate investment policy." ;
    bpot:apqcSourceText "Creating and providing investment regulations for the organization. Establish policies and procedures for investments to optimize liquidity in treasury operations. Create a written copy of it." ;
    bpot:hierarchyID "9.7.1.2" ;
    bpot:pcfID "10886" .

bpot:P10887 a owl:Class ;
    rdfs:label "Develop treasury procedures" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output). Reuses shared bpo:FinancialProcedure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a financial procedure prescribing the steps for executing investments." ;
    skos:example "Treasury drafts the step-by-step procedure for placing a bond trade." ;
    bpot:apqcSourceText "Making processes for investing. Create steps for investments in bonds, currencies, and financial derivatives in order to optimize company's liquidity, invest excess cash, and reduce its financial risks." ;
    bpot:hierarchyID "9.7.1.3" ;
    bpot:pcfID "10887" .

bpot:P10888 a owl:Class ;
    rdfs:label "Monitor treasury procedures" ;
    rdfs:comment "Genus bpo:ActOfMonitoring (Descriptive output) per GOLDEN PRINCIPLE: ongoing checking yields a judgement. Reuses shared bpo:FinancialProcedure and bpo:ControlEffectivenessAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ControlEffectivenessAssessment ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as input a financial procedure and has as output a control-effectiveness assessment of treasury processes." ;
    skos:example "A treasury controller periodically reviews adherence to investment procedures." ;
    bpot:apqcSourceText "Checking treasury processes in order to optimize company's liquidity, invest excess cash, and reduce its financial risks." ;
    bpot:hierarchyID "9.7.1.4" ;
    bpot:pcfID "10888" .

bpot:P10889 a owl:Class ;
    rdfs:label "Audit treasury procedures" ;
    rdfs:comment "Genus cco:ont00000636 (Act of Appraisal): auditing evaluates and judges, producing a Descriptive ICE. Reuses shared bpo:ControlEffectivenessAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ControlEffectivenessAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that examines the treasury function and has as output a control-effectiveness assessment." ;
    skos:example "Internal audit reviews treasury controls and issues an assessment." ;
    bpot:apqcSourceText "Auditing the treasury function." ;
    bpot:hierarchyID "9.7.1.5" ;
    bpot:pcfID "10889" .

bpot:P10890 a owl:Class ;
    rdfs:label "Revise treasury procedures" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output): revising reformulates a prescriptive procedure. Reuses shared bpo:ControlEffectivenessAssessment and bpo:FinancialProcedure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ControlEffectivenessAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as input a control-effectiveness assessment and has as output a revised financial procedure." ;
    skos:example "Treasury updates its trading procedures in response to audit findings." ;
    bpot:apqcSourceText "Reassessing all treasury procedures based on audit findings." ;
    bpot:hierarchyID "9.7.1.6" ;
    bpot:pcfID "10890" .

bpot:P10891 a owl:Class ;
    rdfs:label "Develop and confirm internal controls for treasury" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output). Reuses shared bpo:InternalControlPolicy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:InternalControlPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output an internal-control policy governing treasury investment activity." ;
    skos:example "Treasury defines the segregation-of-duties controls over derivative trades." ;
    bpot:apqcSourceText "Creating and managing the internal control systems for investments in bonds, currencies, and financial derivatives to verify procedures." ;
    bpot:hierarchyID "9.7.1.7" ;
    bpot:pcfID "10891" .

bpot:P10892 a owl:Class ;
    rdfs:label "Define system security requirements" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output). Output bpo:SystemSecurityRequirement minted locally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SystemSecurityRequirement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a system security requirement prescribing controls over access, reliability, accountability, and availability of treasury information." ;
    skos:example "Treasury IT specifies the access-control and audit-trail requirements for the dealing system." ;
    bpot:apqcSourceText "Describing the need of system security requirements for controlling access, reliability of information, accountability, and availability of information in the organization." ;
    bpot:hierarchyID "9.7.1.8" ;
    bpot:pcfID "10892" .

bpot:P10895 a owl:Class ;
    rdfs:label "Process and oversee electronic fund transfers (EFTs)" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Operations category: the material filler bpo:PaymentInstrument is the transferred MATERIAL participant (obo:BFO_0000057), not has output (has output is reserved for ICE outputs)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which monetary payments are transferred electronically between accounts." ;
    skos:example "Treasury executes a wire transfer to settle a supplier invoice." ;
    bpot:apqcSourceText "Supervising all online transactions." ;
    bpot:hierarchyID "9.7.2.3" ;
    bpot:pcfID "10895" .

bpot:P10896 a owl:Class ;
    rdfs:label "Develop cash flow forecasts" ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000371 (Act of Prediction) to reconcile a cross-group inconsistency: the SAME output type (bpo:FinancialForecast) is produced by bpo:P10773 'Prepare periodic financial forecasts', and both are forecasts, i.e. predictive projections rather than mere compilation/reporting of existing results. bpo:P10773 was re-anchored to cco:ont00000371 (Act of Prediction, output a Predictive ICE); this row is aligned to that precedent so the same artifact is not anchored under two different genera across groups (Gate-F reconciliation). REJECTED candidate bpo:ActOfReporting: reporting compiles existing results, whereas producing a forecast generates a Predictive ICE about an uncertain future state. Reuses shared bpo:FinancialData (input) and bpo:FinancialForecast (output, now a Predictive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialForecast ],
        cco:ont00000371 ;
    skos:definition "An Act of Prediction that examines financial data and generates a financial forecast of cash to be generated or used by the organization." ;
    skos:example "Treasury builds a 13-week rolling cash-flow forecast." ;
    bpot:apqcSourceText "Preparing forecasts for the cash generated or used by the organization." ;
    bpot:hierarchyID "9.7.2.4" ;
    bpot:pcfID "10896" .

bpot:P10898 a owl:Class ;
    rdfs:label "Produce cash management accounting transactions and reports" ;
    rdfs:comment "Genus bpo:ActOfReporting (Descriptive output). Reuses shared bpo:TransactionRecord and bpo:FinancialReport." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that has as input transaction records and has as output a financial report on cash-management activity." ;
    skos:example "Treasury issues the monthly cash-management activity report." ;
    bpot:apqcSourceText "Presenting reports on all cash-related activities. Collect and manage short-term investing activities. Prepare reports of all transactions done." ;
    bpot:hierarchyID "9.7.2.6" ;
    bpot:pcfID "10898" .

bpot:P10900 a owl:Class ;
    rdfs:label "Analyze, negotiate, resolve, and confirm bank fees" ;
    rdfs:comment "Genus bpo:ActOfAnalysis (Descriptive output) per GOLDEN PRINCIPLE: the dominant act is studying and determining fees. Reuses shared bpo:FinancialData; output bpo:BankFeeAnalysis minted locally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BankFeeAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input financial data and has as output a bank fee analysis determining the fees charged by a banking partner." ;
    skos:example "Treasury benchmarks and negotiates a bank's transaction-fee schedule." ;
    bpot:apqcSourceText "Studying and finalizing bank fees for services provided by banks. Negotiate and finalize nominal fees that bank charges for various services, such as requesting a deposit slip or counter check or certifying papers." ;
    bpot:hierarchyID "9.7.2.8" ;
    bpot:pcfID "10900" .

bpot:P10902 a owl:Class ;
    rdfs:label "Manage and facilitate inter-company borrowing transactions" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to the verified CCO leaf cco:ont00000884 (Act of Loaning): the in-house bank gives a Financial Instrument to the subsidiary as Debtor to receive repayments -- exactly 884's differentia, closer than the generic transaction genus. cco:ont00000228 (Planned Act) co-asserted because 884 is outside the standalone-SHACL S2 allowlist (884 -> 836 -> 566 -> 228). The loaned funds are a MATERIAL participant (obo:BFO_0000057)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Subsidiary ],
        cco:ont00000228,
        cco:ont00000884 ;
    skos:definition "An Act of Loaning in which the in-house bank (Creditor) extends a loan to a subsidiary (Debtor) to receive repayments of greater financial value." ;
    skos:example "The in-house bank books an intercompany loan to a foreign subsidiary." ;
    bpot:apqcSourceText "Arranging loans for subsidiaries from in-house banks." ;
    bpot:hierarchyID "9.7.3.2" ;
    bpot:pcfID "10902" .

bpot:P10903 a owl:Class ;
    rdfs:label "Manage centralized outgoing payments on behalf of subsidiaries" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Material filler bpo:PaymentInstrument is the definitional MATERIAL participant (obo:BFO_0000057, the payment disbursed), not has output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Subsidiary ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which the parent disburses monetary payments outward on behalf of its subsidiaries." ;
    skos:example "The parent pays a subsidiary's vendor through the central payments factory." ;
    bpot:apqcSourceText "Handling payments made for subsidiaries by parent company." ;
    bpot:hierarchyID "9.7.3.3" ;
    bpot:pcfID "10903" .

bpot:P10904 a owl:Class ;
    rdfs:label "Manage central incoming payments on behalf of subsidiaries" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Material filler bpo:PaymentInstrument is definitional (the payment collected)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Subsidiary ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which the parent collects monetary payments inward on behalf of its subsidiaries." ;
    skos:example "The parent receives a customer remittance owed to a subsidiary." ;
    bpot:apqcSourceText "Handling payments received by parent company for subsidiaries." ;
    bpot:hierarchyID "9.7.3.4" ;
    bpot:pcfID "10904" .

bpot:P10905 a owl:Class ;
    rdfs:label "Manage internal payments and netting transactions" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Recording produces a transaction record (Descriptive ICE), the definitional has output; the netted monetary payment is the MATERIAL participant (obo:BFO_0000057)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which internal payments across organizational units are settled on a netted basis and recorded." ;
    skos:example "The in-house bank nets intercompany balances and posts the residual settlement." ;
    bpot:apqcSourceText "Taking care of all business outflows and recording as whole. Manage making all payments for the organization and its units or subsidiaries. Track in books of accounts of parent company." ;
    bpot:hierarchyID "9.7.3.5" ;
    bpot:pcfID "10905" .

bpot:P10906 a owl:Class ;
    rdfs:label "Calculate interest and fees for in-house bank accounts" ;
    rdfs:comment "Genus bpo:ActOfAccounting (info-processing; Descriptive output). Reuses shared bpo:GeneralLedger and bpo:TransactionRecord." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that has as input a general ledger and has as output transaction records of computed interest and fees on in-house bank accounts." ;
    skos:example "The in-house bank computes and posts monthly interest on subsidiary balances." ;
    bpot:apqcSourceText "Computing all expenses paid to and receivables collected over the organization's banking activity. Calculate all charges and receivables, towards interest, fees, and any other payments over its own bank accounts. Record transactions in the books of accounts." ;
    bpot:hierarchyID "9.7.3.6" ;
    bpot:pcfID "10906" .

bpot:P10907 a owl:Class ;
    rdfs:label "Provide account statements for in-house bank accounts" ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000402 (Act of Communication). The source ('Facilitating account statements for all in-house banking activity') and the verb 'Provide/facilitate' read as delivering/transmitting an already-produced statement, not compiling it; the compilation is the sibling bpo:P10906 'Calculate interest and fees for in-house bank accounts' (which records the transactions and from which the statement is drawn). The bpo:ActOfReporting carve-out routes transmit-only nodes to cco:ont00000402: 'Where a node only transmits an already-prepared report to a party, the group module reuses cco:ont00000402 instead.' Keeping bpo:ActOfReporting would double-count the production step. The account statement is therefore the transmitted ICE (has input), and the subsidiary account holder is the recipient participant. cco:ont00000402 verified against CCO v2.0 (2024-11-06)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:AccountStatement ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Subsidiary ],
        cco:ont00000402 ;
    skos:definition "An Act of Communication that delivers an already-prepared account statement for in-house banking activity to the account holder." ;
    skos:example "The in-house bank issues each subsidiary its monthly account statement." ;
    bpot:apqcSourceText "Facilitating account statements for all in-house banking activity." ;
    bpot:hierarchyID "9.7.3.7" ;
    bpot:pcfID "10907" .

bpot:P10911 a owl:Class ;
    rdfs:label "Process and oversee debt and investment transactions" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Recording yields a transaction record (Descriptive ICE), included as a definitional output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which loans are taken or investments are placed and the resulting positions are recorded." ;
    skos:example "Treasury draws a term loan and books the proceeds and schedule." ;
    bpot:apqcSourceText "Tracking loans taken and money invested in different options. Arrange and supervise loans from banks and individuals and investments in different available and profitable options." ;
    bpot:hierarchyID "9.7.4.5" ;
    bpot:pcfID "10911" .

bpot:P10912 a owl:Class ;
    rdfs:label "Process and oversee foreign currency transactions" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Recording yields a transaction record (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which foreign-currency positions are exchanged and the resulting transactions are recorded." ;
    skos:example "Treasury converts EUR proceeds to USD and records the settled trade." ;
    bpot:apqcSourceText "Arranging and supervising foreign exchange rate changes to avoid loss on foreign-currency transactions." ;
    bpot:hierarchyID "9.7.4.6" ;
    bpot:pcfID "10912" .

bpot:P10913 a owl:Class ;
    rdfs:label "Produce debt and investment accounting transaction reports" ;
    rdfs:comment "Genus bpo:ActOfReporting (Descriptive output). Reuses shared bpo:TransactionRecord and bpo:FinancialReport." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that has as input transaction records and has as output a financial report on debt and investment activity." ;
    skos:example "Treasury issues the quarterly debt-and-investment portfolio report." ;
    bpot:apqcSourceText "Creating transactions report of loans and investments. Prepare and maintain records of loans and investment transactions." ;
    bpot:hierarchyID "9.7.4.7" ;
    bpot:pcfID "10913" .

bpot:P10914 a owl:Class ;
    rdfs:label "Establish board of directors and audit committee" ;
    rdfs:comment "Re-anchored from bpo:ActOfFormulation to bpo:ActOfOrganizationalEstablishment (false-friend fix: 'establish a committee' is not 'formulate a directive'). The lead verb 'Establishing a board / audit committee' primarily denotes CONSTITUTING/SEATING a governance body (an organizational establishment act on independent continuants), not composing-and-articulating a directive ICE. The control-responsibility assignment (bpo:ControlResponsibilityAssignment, Directive) is a downstream byproduct of seating the body, not the definitional output of every instance, so it is recorded here per the Phase-3 existential-necessity rule rather than promoted to a has output restriction (which would over-commit and reverse-engineer an output to justify a planning genus). REJECTED candidate bpo:ActOfFormulation (Act of Planning): would treat the responsibility directive as the definitional product. The constituted governance body (bpo:GovernanceBody, covering the board and audit committee) is the definitional participant. TYPICAL/secondary output (commented, not restricted): bpo:ControlResponsibilityAssignment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:GovernanceBody ],
        bpot:ActOfOrganizationalEstablishment ;
    skos:definition "An Act of Organizational Establishment that constitutes and seats a board of directors and audit committee to assign roles and responsibilities for internal controls." ;
    skos:example "Shareholders seat an audit committee and document its internal-control oversight mandate." ;
    bpot:apqcSourceText "Establishing board of directors and auditing committee in order to assign roles and responsibilities for internal controls." ;
    bpot:hierarchyID "9.8.1.1" ;
    bpot:pcfID "10914" .

bpot:P10915 a owl:Class ;
    rdfs:label "Define and communicate code of ethics" ;
    rdfs:comment "Formulation (Directive output bpo:CodeOfEthics). The communication step is a typical downstream act, not definitional, so it is noted here rather than restricted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CodeOfEthics ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a code of ethics prescribing the standards of responsible conduct for an organization's personnel." ;
    skos:example "A compliance office drafts the corporate code of ethics and distributes it to staff." ;
    bpot:apqcSourceText "Outlining and communicating a code of ethics act responsibly." ;
    bpot:hierarchyID "9.8.1.2" ;
    bpot:pcfID "10915" .

bpot:P10916 a owl:Class ;
    rdfs:label "Assign roles and responsibility for internal controls" ;
    rdfs:comment "Formulation (Directive output bpo:ControlResponsibilityAssignment): assigning accountabilities prescribes a control arrangement." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ControlResponsibilityAssignment ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that prescribes the roles, responsibilities, and accountabilities of agents for internal-control effectiveness and reliable financial reporting." ;
    skos:example "A controller documents which positions own each key financial control." ;
    bpot:apqcSourceText "Defining roles, responsibilities, and accountabilities for effectiveness and proficiency of operations and reliability of financial reporting." ;
    bpot:hierarchyID "9.8.1.3" ;
    bpot:pcfID "10916" .

bpot:P10918 a owl:Class ;
    rdfs:label "Monitor control effectiveness" ;
    rdfs:comment "Monitoring -> Descriptive output bpo:ControlEffectivenessAssessment (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalControlPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ControlEffectivenessAssessment ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that observes the operation of internal-control policies, procedures, and mechanisms and produces a control-effectiveness assessment of their adequacy in minimizing risk." ;
    skos:example "An auditor reviews whether reconciliation controls operated as designed and reports their effectiveness." ;
    bpot:apqcSourceText "Overseeing the activities for internal controls. Observe the effectiveness of policies, procedures, techniques, and mechanisms actions taken to minimize risk." ;
    bpot:hierarchyID "9.8.2.1" ;
    bpot:pcfID "10918" .

bpot:P10919 a owl:Class ;
    rdfs:label "Remediate control deficiencies" ;
    rdfs:comment "Anchored at cco:ont00000228 (Planned Act): remediation executes corrective measures rather than processing information (rejected bpo:ActOfMonitoring) or formulating a directive. Input bpo:ControlEffectivenessAssessment carries the identified deficiencies; output bpo:CorrectiveActionRecord documents the remediation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ControlEffectivenessAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CorrectiveActionRecord ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that takes corrective measures against deficiencies in internal-control policies, procedures, and mechanisms identified by control-effectiveness monitoring." ;
    skos:example "After a monitoring finding, the team reinstates a missing dual-approval control and logs the fix." ;
    bpot:apqcSourceText "Taking corrective measures for policies, procedures, techniques, and mechanisms actions taken to minimize risk. (Conduct in accordance with Monitor control effectiveness [10918] in order to determine and rectify the control deficiencies.)" ;
    bpot:hierarchyID "9.8.2.2" ;
    bpot:pcfID "10919" .

bpot:P10923 a owl:Class ;
    rdfs:label "Report to external auditors" ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000402 (Act of Communication). The source ('Reporting to external auditors ...') is pure transmission of an already-prepared compliance report whose PRODUCTION is the parent bpo:P10764 (9.8.3); the bpo:ActOfReporting definition is the production/compilation step and its comment routes transmit-only nodes to cco:ont00000402. The previous has output bpo:ComplianceReport over-asserted that each instance independently compiles its OWN report, when all four 9.8.3.x children distribute the single report produced by 9.8.3; bpo:ComplianceReport is therefore consumed/transmitted (has input), not produced. Recipient bpo:Auditor is the definitional recipient participant. cco:ont00000402 verified against CCO v2.0 (2024-11-06). REJECTED candidate bpo:ActOfReporting (§6 false-friend caution: communication-sense vs production-sense)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ComplianceReport ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Auditor ],
        cco:ont00000402 ;
    skos:definition "An Act of Communication that transmits an already-prepared internal-controls compliance report to external auditors regarding the regulations governing critical data held by the organization." ;
    skos:example "Management furnishes the external audit firm with its internal-controls compliance report." ;
    bpot:apqcSourceText "Reporting to external auditors. This process requires the organization to report to external auditors about the regulations for any critical data that the organization is holding." ;
    bpot:hierarchyID "9.8.3.1" ;
    bpot:pcfID "10923" .

bpot:P10924 a owl:Class ;
    rdfs:label "Report to regulators, share-/debt-holders, securities exchanges, etc." ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000402 (Act of Communication), consistent with its 9.8.3.x transmit-only siblings bpo:P10923/bpo:P10925/bpo:P10926. The compliance report is produced by the parent bpo:P10764 (9.8.3) and merely transmitted here, so bpo:ComplianceReport is has input, not has output. EXCEPTION retained per the Gate-F note: bpo:RegulatoryFiling IS genuinely compiled/produced in the act of filing with the regulator, so it is kept as a has output. Recipient bpo:RegulatoryAuthority is the definitional recipient participant. cco:ont00000402 verified against CCO v2.0 (2024-11-06). REJECTED candidate bpo:ActOfReporting for the compliance-report transmission (§6 false-friend caution)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ComplianceReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RegulatoryFiling ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        cco:ont00000402 ;
    skos:definition "An Act of Communication that transmits an already-prepared internal-controls compliance report to regulators, shareholders, debt holders, and securities exchanges, producing in the process a regulatory filing of the pertinent data." ;
    skos:example "A listed company files its internal-controls compliance attestation with the securities regulator and notifies bondholders." ;
    bpot:apqcSourceText "Reporting to regulators, shareholders, debt holders, securities exchanges, etc. about IT regulations and pertinent data." ;
    bpot:hierarchyID "9.8.3.2" ;
    bpot:pcfID "10924" .

bpot:P10925 a owl:Class ;
    rdfs:label "Report to third parties" ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000402 (Act of Communication), consistent with its 9.8.3.x transmit-only siblings. The compliance report is produced by the parent bpo:P10764 (9.8.3) and only distributed here, so bpo:ComplianceReport is has input, not has output. Recipients bpo:Supplier and bpo:Customer are the definitional recipient participants. cco:ont00000402 verified against CCO v2.0 (2024-11-06). REJECTED candidate bpo:ActOfReporting (§6 false-friend caution)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ComplianceReport ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Supplier ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        cco:ont00000402 ;
    skos:definition "An Act of Communication that transmits an already-prepared internal-controls compliance report to suppliers, customers, and business partners regarding IT regulations and pertinent data." ;
    skos:example "A vendor-management team shares the firm's data-controls compliance summary with key suppliers." ;
    bpot:apqcSourceText "Reporting to suppliers, customers, and partners that are doing business with the company about IT regulations and pertinent data." ;
    bpot:hierarchyID "9.8.3.3" ;
    bpot:pcfID "10925" .

bpot:P10926 a owl:Class ;
    rdfs:label "Report to internal management" ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000402 (Act of Communication), consistent with its 9.8.3.x transmit-only siblings. The compliance report is produced by the parent bpo:P10764 (9.8.3) and only distributed here, so bpo:ComplianceReport is has input, not has output. Recipient bpo:Employee (covering staff, directors, and management as internal personnel) is the definitional recipient participant. cco:ont00000402 verified against CCO v2.0 (2024-11-06). REJECTED candidate bpo:ActOfReporting (§6 false-friend caution)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ComplianceReport ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Employee ],
        cco:ont00000402 ;
    skos:definition "An Act of Communication that transmits an already-prepared internal-controls compliance report to an organization's employees, directors, and management regarding IT regulations and pertinent data." ;
    skos:example "Leadership circulates an internal memo summarizing the company's controls-compliance status to all staff." ;
    bpot:apqcSourceText "Reporting to internal management (all employees, directors, and management) about IT regulations and pertinent data." ;
    bpot:hierarchyID "9.8.3.4" ;
    bpot:pcfID "10926" .

bpot:P10927 a owl:Class ;
    rdfs:label "Develop foreign, national, state, and local tax strategy" ;
    rdfs:comment "R5=process. Directive output (Tax Strategy) -> bpo:ActOfFormulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a tax strategy governing the organization's tax position across foreign, national, state, and local jurisdictions." ;
    skos:example "A multinational drafts a transfer-pricing and import/export tax strategy spanning its operating jurisdictions." ;
    bpot:apqcSourceText "Developing a tax strategy for foreign, national, state, local administration. Set up tax strategies for foreign trade in imports and exports and at national, state, and local level." ;
    bpot:hierarchyID "9.9.1.1" ;
    bpot:pcfID "10927" .

bpot:P10928 a owl:Class ;
    rdfs:label "Consolidate and optimize total tax plan" ;
    rdfs:comment "R5=process. Although it draws on prior analysis of financial condition (a typical input, left as comment per Phase-3), its product is a consolidated directive plan, so genus is bpo:ActOfFormulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that combines and optimizes the organization's component tax plans into a single total tax plan aligning financial goals through efficient tax planning." ;
    skos:example "A finance team merges per-jurisdiction tax strategies into one optimized group tax plan." ;
    bpot:apqcSourceText "Combining and enhancing a rational analysis of a financial condition or plan from a tax perspective in order to align financial goals through efficient tax planning." ;
    bpot:hierarchyID "9.9.1.2" ;
    bpot:pcfID "10928" .

bpot:P10929 a owl:Class ;
    rdfs:label "Maintain tax master data" ;
    rdfs:comment "R5=process. Descriptive output (Tax Data master file). Re-anchored from the bare cco:ont00000366 to bpo:ActOfAccounting (which is itself subClassOf cco:ont00000366): the earlier 'No shared maintain genus fits' claim was false. bpo:ActOfAccounting is defined as an act that 'produces or UPDATES a Descriptive ICE ... such as a ledger, journal, or account record', and its PROPOSE-EXT scope explicitly lists 'maintain ledgers/master files' -- 'Maintaining a master file' is exactly that pattern. Anchoring this master-file-maintenance act to the bare parent while its descriptive-output siblings bpo:P10933 and bpo:P10934 (also output bpo:TaxData) use bpo:ActOfAccounting was an avoidable inconsistency. Descriptive output agrees with the info-processing genus (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxData ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that maintains and updates the tax master data file recording the reference data underpinning the organization's tax planning." ;
    skos:example "A tax analyst updates jurisdiction codes and rates in the tax master file each quarter." ;
    bpot:apqcSourceText "Maintaining a master file about the rational analysis of a financial condition or plan from a tax perspective in order to align financial goals through efficient tax planning." ;
    bpot:hierarchyID "9.9.1.3" ;
    bpot:pcfID "10929" .

bpot:P10930 a owl:Class ;
    rdfs:label "Perform tax planning/strategy" ;
    rdfs:comment "R5=process. Directive output (Tax Strategy) -> bpo:ActOfFormulation. The implementation aspect is carried out by the sibling transaction/accounting processes; here the definitional product is the strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that creates strategies for the taxes to be paid or collected by the organization and prescribes their implementation." ;
    skos:example "A tax team designs a strategy for collecting and remitting indirect taxes on sales." ;
    bpot:apqcSourceText "Creating and implementing strategies for taxes to be paid or collected by the business." ;
    bpot:hierarchyID "9.9.2.1" ;
    bpot:pcfID "10930" .

bpot:P10931 a owl:Class ;
    rdfs:label "Prepare tax returns" ;
    rdfs:comment "R5=process. Descriptive output (Tax Return) -> bpo:ActOfReporting. Employees are subjects of the per-employee filings (typical participant, left as comment); Tax Data is a typical input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxReturn ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares and submits a tax return reporting the tax paid by and deducted on behalf of the organization and its employees to the relevant tax authority." ;
    skos:example "Payroll files year-end employee tax statements with the tax department." ;
    bpot:apqcSourceText "Preparing and submitting tax reports for every employee to the tax department in order to show the tax paid and deducted from their salaries in the year." ;
    bpot:hierarchyID "9.9.2.2" ;
    bpot:pcfID "10931" .

bpot:P10932 a owl:Class ;
    rdfs:label "Prepare foreign taxes" ;
    rdfs:comment "R5=process. Descriptive output (Tax Return covering foreign tax) -> bpo:ActOfReporting." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxReturn ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares a tax return reporting the foreign taxes paid or accrued by the organization to an overseas taxing jurisdiction." ;
    skos:example "A subsidiary's controller prepares the foreign-tax accrual report for an overseas jurisdiction." ;
    bpot:apqcSourceText "Preparing reports about paid or accrued foreign taxes to an overseas country." ;
    bpot:hierarchyID "9.9.2.3" ;
    bpot:pcfID "10932" .

bpot:P10933 a owl:Class ;
    rdfs:label "Calculate deferred taxes" ;
    rdfs:comment "R5=process. Descriptive output (Tax Data) -> bpo:ActOfAccounting (info-processing genus; agrees with descriptive output). Financial data is a typical input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxData ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that computes the organization's deferred tax positions arising where income is recognized in a period different from the period in which the related tax is incurred, producing tax data on those positions." ;
    skos:example "An accountant computes the deferred tax liability from timing differences between book and tax depreciation." ;
    bpot:apqcSourceText "Calculating the income that has been realized when the tax on that income has not." ;
    bpot:hierarchyID "9.9.2.4" ;
    bpot:pcfID "10933" .

bpot:P10934 a owl:Class ;
    rdfs:label "Account for taxes" ;
    rdfs:comment "R5=process. Descriptive output (Tax Data) -> bpo:ActOfAccounting. General ledger / financial data are typical inputs (left as comment per Phase-3)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxData ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that maintains the organization's financial accounts for tax purposes and records the tax paid in each country in which it operates, producing tax data." ;
    skos:example "A controller books and reconciles the tax accounts at period close." ;
    bpot:apqcSourceText "Managing the organization's financial accounts for the purpose of taxation. Prepare and maintain the tax paid by the organization to the country they have business in." ;
    bpot:hierarchyID "9.9.2.5" ;
    bpot:pcfID "10934" .

bpot:P10935 a owl:Class ;
    rdfs:label "Monitor tax compliance" ;
    rdfs:comment "R5=process. Descriptive output (Compliance Report) -> bpo:ActOfMonitoring. Tax Data / Financial Policy are typical inputs (left as comment per Phase-3)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that checks the organization's tax policies and practices against applicable rules and regulations and produces a compliance report identifying and prompting correction of deviations." ;
    skos:example "An internal-controls reviewer audits VAT treatment against the tax code and flags exceptions." ;
    bpot:apqcSourceText "Checking and correcting the tax policies according to the rules and regulations set by the organization." ;
    bpot:hierarchyID "9.9.2.6" ;
    bpot:pcfID "10935" .

bpot:P10936 a owl:Class ;
    rdfs:label "Address tax inquiries" ;
    rdfs:comment "R5=process. Descriptive output (Tax Inquiry Response) -> bpo:ActOfReporting. The Regulatory Authority that raised the query is definitional to the act, so it is a participant restriction; reviewed historical records (Tax Data) are a typical input left as comment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxInquiryResponse ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that reviews the organization's historical taxation records and produces a tax inquiry response answering a query raised by a regulatory or government authority." ;
    skos:example "A tax manager researches prior filings and replies to an information request from the revenue authority." ;
    bpot:apqcSourceText "Addressing any tax queries by any regulatory or government authorities. Review historical records related to taxation within the organization in order to respond to queries." ;
    bpot:hierarchyID "9.9.2.7" ;
    bpot:pcfID "10936" .

bpot:P11175 a owl:Class ;
    rdfs:label "Report on profitability" ;
    rdfs:comment "Descriptive output (cco:ont00000853). Genus bpo:ActOfReporting: the act communicates an existing analysis as a report. The profitability analysis is the definitional input; the financial report is the definitional output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ProfitabilityAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that takes a profitability analysis and produces a financial report communicating how the organization or unit generates profit." ;
    skos:example "Issuing the quarterly profitability report to management." ;
    bpot:apqcSourceText "Making a report about revenues generated by the organization or business unit concerned. This process requires the organization to create a report which shows how business is generating profits. Profits are the part which is left after paying all expenses directly related to the generation of the revenue, such as producing a product, and other expenses related to conducting business activities." ;
    bpot:hierarchyID "9.1.2.6" ;
    bpot:pcfID "11175" .

bpot:P11213 a owl:Class ;
    rdfs:label "Evaluate and refine hedging positions" ;
    rdfs:comment "Genus bpo:ActOfSelection (Directive output) per GOLDEN PRINCIPLE: the act culminates in selecting an option. Output bpo:HedgeSelectionDecision minted locally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:HedgeSelectionDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that examines available hedging options and has as output a hedge selection decision prescribing the chosen option." ;
    skos:example "The desk compares collar structures and selects one to refine the hedge." ;
    bpot:apqcSourceText "Examining options in the market for hedging investments. Select an option." ;
    bpot:hierarchyID "9.7.5.5.4" ;
    bpot:pcfID "11213" .

bpot:P11214 a owl:Class ;
    rdfs:label "Produce hedge accounting transactions and reports" ;
    rdfs:comment "Genus bpo:ActOfReporting (Descriptive output). Reuses shared bpo:TransactionRecord and bpo:FinancialReport." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialReport ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that has as input transaction records and has as output a financial report documenting hedging investment activity." ;
    skos:example "Treasury issues the hedge-accounting effectiveness report." ;
    bpot:apqcSourceText "Preparing and documenting accounts and records of all hedging investment transactions to reduce risks due to change in markets." ;
    bpot:hierarchyID "9.7.5.6" ;
    bpot:pcfID "11214" .

bpot:P11215 a owl:Class ;
    rdfs:label "Monitor credit" ;
    rdfs:comment "Genus bpo:ActOfMonitoring (Descriptive output): periodic review of credit reports yields a judgement. Reuses shared bpo:CreditScoringHistory and bpo:CreditAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CreditScoringHistory ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditAssessment ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as input a credit scoring history and has as output a credit assessment flagging inaccuracies or signs of fraudulent activity." ;
    skos:example "The team rescreens counterparty credit files each quarter." ;
    bpot:apqcSourceText "Revising credit reports periodically for accurateness and changes that could be suggestive of duplicitous activity." ;
    bpot:hierarchyID "9.7.5.5.5" ;
    bpot:pcfID "11215" .

bpot:P11250 a owl:Class ;
    rdfs:label "Define business process objectives and risks" ;
    rdfs:comment "Formulation: the primary output is a Directive process-control objective (GOLDEN PRINCIPLE); the descriptive bpo:RiskAssessment is a co-output capturing the determined risks." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessControlObjective ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that prescribes the control objectives of a business process and produces a risk assessment describing the risks attached to that process." ;
    skos:example "A process owner documents the objectives of the payroll process and the risks that threaten them." ;
    bpot:apqcSourceText "Outlining the objectives and risks associated with a process. Delineate process goals. Determine the risks attached to it. Determine what the process is meant to accomplish, potential issues, a timeline of potential risks, the scope and potential impact of risks, etc." ;
    bpot:hierarchyID "9.8.1.4" ;
    bpot:pcfID "11250" .

bpot:P11251 a owl:Class ;
    rdfs:label "Define entity/unit risk tolerances" ;
    rdfs:comment "Formulation (Directive output bpo:RiskToleranceSpecification): tolerances are binding limits, distinct from a descriptive bpo:RiskAssessment of current exposure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskToleranceSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that prescribes the maximum acceptable risk, in quantitative terms, for organizational units and the organization as a whole across risk subcategories." ;
    skos:example "A risk committee sets a maximum tolerable compliance-risk threshold for each business unit." ;
    bpot:apqcSourceText "Outlining the risk tolerance levels of individual units, as well as the organization as a whole. Determine the specific maximum risk to take in quantitative terms for each relevant risk subcategory, including strategic, operational, financial, and compliance risks." ;
    bpot:hierarchyID "9.8.1.5" ;
    bpot:pcfID "11251" .

bpot:P14057 a owl:Class ;
    rdfs:label "Perform profit center accounting" ;
    rdfs:comment "Descriptive output (cco:ont00000853): a per-unit profitability statement. Genus bpo:ActOfAccounting." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProfitabilityAnalysis ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that determines the revenue, profit, and loss of each profit-producing unit and produces a profitability analysis of those units." ;
    skos:example "Computing each business unit's monthly profit and loss." ;
    bpot:apqcSourceText "Determining the revenue, profits, and losses incurred by each unit within the organization that produces profit." ;
    bpot:hierarchyID "9.1.2.2" ;
    bpot:pcfID "14057" .

bpot:P14074 a owl:Class ;
    rdfs:label "Perform legal and management consolidation" ;
    rdfs:comment "Genus Act of Accounting (not Reporting): the act combines and converts ledger data rather than merely conveying it; its output feeds the reporting acts of 9.3.4." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConsolidatedFinancialStatement ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that performs legal and management consolidation - currency conversion, balance carry-forward, and journal-entry consolidation - to produce consolidated financial statements." ;
    skos:example "Consolidating foreign-subsidiary ledgers into the group reporting currency." ;
    bpot:apqcSourceText "Carrying out activities associated with legal and management consolidation. Legal consolidation can include currency conversion, balance carry forward, and consolidation of journal entries. Management consolidation can include reporting on financials on a reporting cycle basis to gauge the performance of the organization." ;
    bpot:hierarchyID "9.3.4.8" ;
    bpot:pcfID "14074" .

bpot:P14075 a owl:Class ;
    rdfs:label "Develop tax plan" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (output is a Directive ICE) per the GOLDEN PRINCIPLE: devising a method/plan produces a prescription." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TaxStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that devises a tax strategy prescribing how to minimize payroll-tax liability through allowances, deductions, exclusions, or exemptions." ;
    skos:example "Designing a withholding strategy that lawfully reduces the firm's payroll-tax burden." ;
    bpot:apqcSourceText "Devising a method to minimize payroll tax liability by means of allowances, deductions, exclusions or exemptions." ;
    bpot:hierarchyID "9.5.3.1" ;
    bpot:pcfID "14075" .

bpot:P14090 a owl:Class ;
    rdfs:label "Screen sanctioned party list" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal) because the act evaluates and judges parties against an approved list; its output is a Descriptive ICE (a clearance judgement), satisfying the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:SanctionedPartyList ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SanctionedPartyScreeningResult ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a sanctioned party list and has as output a sanctioned-party screening result judging whether the parties to a prospective transaction are cleared to engage in international trade." ;
    skos:example "A compliance officer screens both counterparties of a shipment against the denied-parties list before release." ;
    bpot:apqcSourceText "Evaluating the approved list of parties for engaging in international trade in order to ensure the safety of the organization's business transactions. Examine agents that have been granted legal rights to engage in global trade and their credentials." ;
    bpot:hierarchyID "9.11.1" ;
    bpot:pcfID "14090" .

bpot:P14092 a owl:Class ;
    rdfs:label "Classify products" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (subClassOf cco:ont00000366) because categorizing offerings against standards processes input information into a classification ICE; the Descriptive output satisfies the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProductClassification ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines an organization's products and services against national and international trade standards and has as output a product trade classification." ;
    skos:example "A trade analyst assigns HS tariff codes to each item in the product catalogue." ;
    bpot:apqcSourceText "Systematically categorizing products/services for their suitability to international trade. Create classes and categories for demarcating the types of products suitable for international trade. Study requisite national and international standards and the adherence of the organization's portfolio of offerings to these." ;
    bpot:hierarchyID "9.11.3" ;
    bpot:pcfID "14092" .

bpot:P14093 a owl:Class ;
    rdfs:label "Calculate duty" ;
    rdfs:comment "Anchored to bpo:ActOfAccounting (subClassOf cco:ont00000366) because computing duty owed is a financial calculation that processes input information into a numeric Descriptive ICE, satisfying the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DutyCalculation ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that computes the excise duty payable on an international-trade transaction and has as output a duty calculation." ;
    skos:example "A customs broker computes the excise duty owed on a consignment before clearance." ;
    bpot:apqcSourceText "Computing the excise duty to be paid during international trade." ;
    bpot:hierarchyID "9.11.5" ;
    bpot:pcfID "14093" .

bpot:P14094 a owl:Class ;
    rdfs:label "Communicate with customs" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): an ICE (legally-mandated trade particulars) is transferred from one Agent to another. The Regulatory Authority is the definitional recipient; customs information is the definitional transferred ICE. Explicit rdfs:subClassOf cco:ont00000228 (Planned Act) added so the act-anchor chain is visible to the standalone SHACL run (ont00000402 is a CCO subclass of ont00000228, but the closure is not merged for Gate C)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomsInformation ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication in which an organization transfers customs information to the government customs authority in order to ensure compliance with international-trade law." ;
    skos:example "Filing the mandated electronic declaration with the national customs agency for a shipment." ;
    bpot:apqcSourceText "Communicating with the customs department to ensure fluid compliance. Share pertinent information mandated by law with the government agency that controls and collects the duties levied for the international exchange of products/services." ;
    bpot:hierarchyID "9.11.6" ;
    bpot:pcfID "14094" .

bpot:P14095 a owl:Class ;
    rdfs:label "Document trade" ;
    rdfs:comment "Anchored to bpo:ActOfReporting (subClassOf cco:ont00000366) because documenting/recording a trade gives a detailed account that processes input information into a Descriptive ICE, satisfying the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TradeDocumentation ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that records the particulars of a trade transaction -- including description, quality, quantity, transport medium, indemnity, and inspection -- and has as output trade documentation." ;
    skos:example "A logistics clerk records the bill of lading, packing list, and inspection certificate for a shipment." ;
    bpot:apqcSourceText "Documenting and recording the trade processes while making transactions, noting the description, quality, number, transportation medium, indemnity, and inspection." ;
    bpot:hierarchyID "9.11.7" ;
    bpot:pcfID "14095" .

bpot:P14096 a owl:Class ;
    rdfs:label "Process trade preferences" ;
    rdfs:comment "Anchored to bpo:ActOfReporting (subClassOf cco:ont00000366): preparing trade-under-preference paperwork records eligibility, processing input information into a Descriptive ICE (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TradePreferenceDocumentation ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that prepares the documentation establishing a shipment's eligibility for trade under preference and has as output trade preference documentation." ;
    skos:example "Preparing a certificate of origin to claim a preferential tariff under a free-trade agreement." ;
    bpot:apqcSourceText "Preparing global trade under preference, which allows the organization to import/export products at a lower or nil rate of customs duty and/or levy charge." ;
    bpot:hierarchyID "9.11.8" ;
    bpot:pcfID "14096" .

bpot:P14098 a owl:Class ;
    rdfs:label "Prepare letter of credit" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (inlined, subClassOf cco:ont00000511, Act of Planning) because creating a letter of credit composes a Directive ICE that prescribes a payment guarantee, satisfying the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LetterOfCredit ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a letter of credit prescribing the conditions under which a bank guarantees payment to a seller upon fulfilment of specified delivery conditions." ;
    skos:example "A bank issues a documentary letter of credit guaranteeing payment to an exporter on presentation of shipping documents." ;
    bpot:apqcSourceText "Creating a document assuring that a seller will receive payment when certain delivery conditions are met. (If the buyer is unable to make payment on the purchase, a bank covers the outstanding amount.)" ;
    bpot:hierarchyID "9.11.10" ;
    bpot:pcfID "14098" .

bpot:P14187 a owl:Class ;
    rdfs:label "Analyze credit scoring history" ;
    rdfs:comment "Genus Act of Analysis (information processing of input ICEs into a descriptive judgement)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CreditScoringHistory ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines a customer's past credit-scoring history and produces a credit assessment indicating whether credit should be extended." ;
    skos:example "An analyst reviews a customer's credit-score history to decide on extending a line of credit." ;
    bpot:apqcSourceText "Reviewing past credit scores to determine the if a line of credit will be extended to potential customers. This could also include extending additional credit to existing accounts." ;
    bpot:hierarchyID "9.2.1.3" ;
    bpot:pcfID "14187" .

bpot:P14188 a owl:Class ;
    rdfs:label "Forecast credit scoring requirement" ;
    rdfs:comment "Re-anchored from bpo:ActOfAnalysis to bpo:ActOfFormulation (Act of Planning, cco:ont00000511 family) and output changed from bpo:FinancialForecast to the Directive bpo:CreditScoreRequirementSpecification. The source text is 'Planning credit score requirements based on established credit policies' -- the act sets/determines the future credit-score REQUIREMENTS (thresholds an applicant must meet), which is prescriptive (a requirement prescribes), not a descriptive projection. The previous model leaned on the label word 'Forecast' to give genus=ActOfAnalysis + output=FinancialForecast, but a credit-score requirement is not an income/cash-flow forecast, so that output ICE did not denote what the process produces. GOLDEN PRINCIPLE: the description verb is 'planning' and the artifact is a requirement spec -> Directive output and a planning/formulation genus. REJECTED reading: that the act merely projects future demand for scoring (which would keep ActOfAnalysis with a Descriptive ICE); the verbatim verb 'Planning' and the prescriptive nature of a 'requirement' refute it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CreditPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditScoreRequirementSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that determines the credit-score requirements applicants must meet, based on established credit policies, and produces a credit-score requirement specification." ;
    skos:example "Setting the minimum credit scores required for next year's lending program from the firm's credit policy." ;
    bpot:apqcSourceText "Planning credit score requirements based on established credit policies." ;
    bpot:hierarchyID "9.2.1.4" ;
    bpot:pcfID "14188" .

bpot:P14210 a owl:Class ;
    rdfs:label "Process and oversee interest rate transactions" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Recording yields a transaction record (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which interest-rate swap or related transactions are arranged and recorded to manage interest-rate exposure." ;
    skos:example "Treasury enters a pay-fixed interest-rate swap and books the trade." ;
    bpot:apqcSourceText "Supervising the interest paid or received by the organization. Arrange and supervise interest rate swap transactions to manage exposure to fluctuations in interest rates. Or attain a marginally lower rate of interest than could be gained through a swap." ;
    bpot:hierarchyID "9.7.4.8" ;
    bpot:pcfID "14210" .

bpot:P19575 a owl:Class ;
    rdfs:label "Manage interest rate market data" ;
    rdfs:comment "Genus bpo:ActOfMonitoring (info-processing; Descriptive output): ongoing collection/storage of market data. Reuses shared bpo:MarketRateData." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MarketRateData ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that collects and stores interest-rate market data and has as output a market rate data record." ;
    skos:example "The rates desk feeds live swap curves into its data store." ;
    bpot:apqcSourceText "Collecting and storing data that pertains to interest rate markets." ;
    bpot:hierarchyID "9.7.5.2.1" ;
    bpot:pcfID "19575" .

bpot:P19576 a owl:Class ;
    rdfs:label "Determine interest rate exposure for all markets" ;
    rdfs:comment "Genus bpo:ActOfAnalysis (Descriptive output). Reuses shared bpo:MarketRateData and bpo:RiskAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketRateData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input market rate data and has as output a financial risk assessment of interest-rate exposure across markets." ;
    skos:example "The desk computes the portfolio's DV01 by market." ;
    bpot:apqcSourceText "Identifying potential interest rate risks for all markets." ;
    bpot:hierarchyID "9.7.5.2.2" ;
    bpot:pcfID "19576" .

bpot:P19577 a owl:Class ;
    rdfs:label "Determine interest rate hedge requirements in accordance with risk policy" ;
    rdfs:comment "Genus bpo:ActOfSelection (Directive output) per GOLDEN PRINCIPLE: deciding requirements commits to prescribed hedges. Reuses shared bpo:RiskAssessment and bpo:FinancialPolicy (risk policy); output bpo:HedgeRequirementSpecification minted locally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:HedgeRequirementSpecification ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that has as input a financial risk assessment and a financial policy and has as output a hedge requirement specification for interest-rate exposure." ;
    skos:example "The desk sets the required futures hedge given the accepted risk policy." ;
    bpot:apqcSourceText "Deciding the requirements on interest rate investments that are made by trading in futures or options market, on the basis of the accepted risk policy." ;
    bpot:hierarchyID "9.7.5.2.3" ;
    bpot:pcfID "19577" .

bpot:P19578 a owl:Class ;
    rdfs:label "Execute interest rate trades" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Recording yields a transaction record (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which interest-rate instruments are traded to implement a hedge." ;
    skos:example "The desk executes an interest-rate futures order." ;
    bpot:apqcSourceText "Performing trading on interest rates." ;
    bpot:hierarchyID "9.7.5.2.4" ;
    bpot:pcfID "19578" .

bpot:P19579 a owl:Class ;
    rdfs:label "Manage foreign exchange market data" ;
    rdfs:comment "Genus bpo:ActOfMonitoring (Descriptive output). Reuses shared bpo:MarketRateData." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MarketRateData ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that handles and processes foreign-exchange rate data and has as output a market rate data record." ;
    skos:example "The FX desk ingests live spot and forward rates." ;
    bpot:apqcSourceText "Handling and processing information about changes in foreign exchange rates." ;
    bpot:hierarchyID "9.7.5.3.1" ;
    bpot:pcfID "19579" .

bpot:P19580 a owl:Class ;
    rdfs:label "Determine foreign exchange exposure for all currencies" ;
    rdfs:comment "Genus bpo:ActOfAnalysis (Descriptive output). Reuses shared bpo:MarketRateData and bpo:RiskAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketRateData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input market rate data and has as output a financial risk assessment of foreign-exchange exposure across currencies." ;
    skos:example "The desk reports net open position by currency." ;
    bpot:apqcSourceText "Establishing potential foreign exchange risks for all currencies." ;
    bpot:hierarchyID "9.7.5.3.2" ;
    bpot:pcfID "19580" .

bpot:P19581 a owl:Class ;
    rdfs:label "Determine foreign exchange hedge requirements in accordance with risk policy" ;
    rdfs:comment "Genus bpo:ActOfSelection (Directive output). Reuses shared bpo:RiskAssessment and bpo:FinancialPolicy; output bpo:HedgeRequirementSpecification reused (minted locally)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:HedgeRequirementSpecification ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that has as input a financial risk assessment and a financial policy and has as output a hedge requirement specification for foreign-exchange exposure." ;
    skos:example "The desk sets required forward cover given the FX risk policy." ;
    bpot:apqcSourceText "Deciding the requirements on investments in foreign exchange made by trading in futures or options market, on the basis of current risk policy." ;
    bpot:hierarchyID "9.7.5.3.3" ;
    bpot:pcfID "19581" .

bpot:P19582 a owl:Class ;
    rdfs:label "Execute foreign exchange trades" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Recording yields a transaction record (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which currencies are bought, sold, or exchanged in the foreign-exchange market." ;
    skos:example "The desk executes a spot EUR/USD trade." ;
    bpot:apqcSourceText "Executing all aspects for foreign exchange trade within foreign exchange market. This includes buying, selling, and exchanging currencies at the current or expressed price point." ;
    bpot:hierarchyID "9.7.5.3.4" ;
    bpot:pcfID "19582" .

bpot:P19583 a owl:Class ;
    rdfs:label "Manage foreign exchange balance sheet risk" ;
    rdfs:comment "Genus bpo:ActOfMonitoring (Descriptive output): continuous oversight producing a risk judgement. Reuses shared bpo:RiskAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that oversees the foreign-exchange balance sheet and has as output a financial risk assessment of translation and settlement risk." ;
    skos:example "The desk tracks translation risk on non-base-currency balances." ;
    bpot:apqcSourceText "Overseeing the foreign exchange balance sheet with an eye towards potential risk. Risks include changes in conversion rates between the time the transaction occurred and when it is completed, or when transactions are made in a denomination other than that of the organization's base currency." ;
    bpot:hierarchyID "9.7.5.3.5" ;
    bpot:pcfID "19583" .

bpot:P19584 a owl:Class ;
    rdfs:label "Determine current customer exposures and limit exceptions" ;
    rdfs:comment "Genus bpo:ActOfAnalysis (Descriptive output). Reuses shared bpo:RiskAssessment. Phase-3 consistency fix: a definitional has input (bpo:RiskExposureData) was added to match the input pattern of its structurally parallel exposure-determination peers bpo:P19576 and bpo:P19580 (both has input bpo:MarketRateData). An exposure-determination analysis cannot occur without exposure/position data as input, so the input is definitional for all three; this row previously lacked it, making it look less constrained than its twins." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskExposureData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input risk exposure data and has as output a financial risk assessment describing current customer exposures and exceptions to exposure limits." ;
    skos:example "The team flags counterparties breaching their exposure limit." ;
    bpot:apqcSourceText "Establishing ongoing risks that the customers face, and the exceptions to exceeded limits." ;
    bpot:hierarchyID "9.7.5.4.1" ;
    bpot:pcfID "19584" .

bpot:P19585 a owl:Class ;
    rdfs:label "Resolve customer exposure limit violations" ;
    rdfs:comment "Genus bpo:ActOfSelection (Directive output) per GOLDEN PRINCIPLE: resolving a case commits to a prescribed remedy. Reuses shared bpo:RiskAssessment; output bpo:ExposureLimitResolution minted locally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ExposureLimitResolution ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that has as input a financial risk assessment and has as output an exposure limit resolution prescribing the settlement of a limit violation." ;
    skos:example "The team requires additional margin to cure a limit breach." ;
    bpot:apqcSourceText "Settling cases that involve violations of customer exposure limit." ;
    bpot:hierarchyID "9.7.5.4.2" ;
    bpot:pcfID "19585" .

bpot:P19586 a owl:Class ;
    rdfs:label "Manage customer collateral" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Reuses shared bpo:Customer as participant and bpo:FinancialInstrument as the collateral material entity (definitional)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialInstrument ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which customer securities held as collateral are realized to recover unpaid loans, with the customer bearing a debtor role." ;
    skos:example "The bank liquidates pledged shares to cover a defaulted margin loan." ;
    bpot:apqcSourceText "Handling customer securities to recover loans that are not paid back." ;
    bpot:hierarchyID "9.7.5.4.3" ;
    bpot:pcfID "19586" .

bpot:P19587 a owl:Class ;
    rdfs:label "Perform annual customer credit reviews" ;
    rdfs:comment "Genus cco:ont00000636 (Act of Appraisal; Descriptive output) per GOLDEN PRINCIPLE: a credit review judges creditworthiness. Reuses shared bpo:CreditScoringHistory, bpo:CreditAssessment, and bpo:Customer." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CreditScoringHistory ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CreditAssessment ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a credit scoring history and has as output a credit assessment about a customer." ;
    skos:example "Credit risk re-rates a corporate customer at its annual review." ;
    bpot:apqcSourceText "Conducting reviews to assess customer credit on a yearly basis. Introduce changes or make recommendations, if needed." ;
    bpot:hierarchyID "9.7.5.4.4" ;
    bpot:pcfID "19587" .

bpot:P19588 a owl:Class ;
    rdfs:label "Measure physical positions" ;
    rdfs:comment "Genus cco:ont00000636 (Act of Appraisal; Descriptive output): measuring/evaluating positions yields a judgement. Reuses shared bpo:RiskAssessment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as output a financial risk assessment of the physical positions held to offset opposing-market risk." ;
    skos:example "The desk marks the offsetting commodity position to market." ;
    bpot:apqcSourceText "Evaluating investments made in some market to offset the risks of investing in a contrary or opposing market." ;
    bpot:hierarchyID "9.7.5.5.1" ;
    bpot:pcfID "19588" .

bpot:P19589 a owl:Class ;
    rdfs:label "Establish hedges" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to bpo:ActOfSelection (critical fix). The verbatim source is 'Determining which hedge options to execute' -- i.e. CHOOSING among candidate hedges, a decision/selection act with a directive outcome, not the later execution. GOLDEN PRINCIPLE: the act's product is a directive (a chosen hedge to put on), so genus is bpo:ActOfSelection and the output is the Directive bpo:HedgeSelectionDecision, NOT a Descriptive TransactionRecord. This aligns the row with its near-identical direct sibling bpo:P11213 'Evaluate and refine hedging positions' ('Examining options in the market for hedging investments. Select an option.'), already modeled as bpo:ActOfSelection -> bpo:HedgeSelectionDecision; the two parallel rows now share one genus. The actual transacting/execution of the chosen hedge is covered by the trade-execution rows (bpo:P19582), not by this decision row. REJECTED candidate bpo:ActOfFinancialTransaction: it conflated the decision with the later execution and gave a Descriptive output for a directive product." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:HedgeSelectionDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that determines which hedge options to execute and produces a hedge selection decision prescribing the chosen option(s)." ;
    skos:example "The desk decides which put-option hedge to put on against an equity holding." ;
    bpot:apqcSourceText "Determining which hedge options to execute." ;
    bpot:hierarchyID "9.7.5.5.2" ;
    bpot:pcfID "19589" .

bpot:P19590 a owl:Class ;
    rdfs:label "Unwind hedges" ;
    rdfs:comment "Genus bpo:ActOfFinancialTransaction (Planned Act). Recording yields a transaction record (Descriptive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TransactionRecord ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction in which an open hedging position is closed out or derivatives are settled early." ;
    skos:example "The desk closes a futures hedge ahead of expiry." ;
    bpot:apqcSourceText "Closing out a position or cashing in derivatives early." ;
    bpot:hierarchyID "9.7.5.5.3" ;
    bpot:pcfID "19590" .

bpot:P19593 a owl:Class ;
    rdfs:label "Perform currency conversion" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to bpo:ActOfAnalysis (subClassOf cco:ont00000366) (genus/output mismatch + false-friend fix). The source ('Identifying current exchange rates between two currencies and converting the foreign currency to that of the local monetary unit') and the output bpo:CurrencyConversionRecord (a Descriptive ICE) describe a COMPUTATION that identifies rates and produces a record of the equivalent amount -- no money or Financial Instrument is actually transferred between agents, so bpo:ActOfFinancialTransaction's differentia ('transfers money or a Financial Instrument ... in settlement') is not satisfied ('conversion' is a false friend for a financial act). GOLDEN PRINCIPLE: a Descriptive-record output pairs with an information-processing genus. Note also that bpo:ActOfFinancialTransaction itself rejected cco:ont00000366 on the ground that 'a payment moves a material/financial-instrument filler, not only an ICE' -- this act has only an ICE output, confirming it does not fit the transaction genus. bpo:MarketRateData (current exchange rates) is the definitional input; the conversion record is the Descriptive output. REJECTED candidate bpo:ActOfFinancialTransaction (reserved for nodes that actually move money/instruments between agents, e.g. 9.5/9.6 disbursement and 9.11 settlement nodes)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketRateData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CurrencyConversionRecord ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines market rate data to convert a monetary amount from a foreign currency to the local monetary unit, producing a currency conversion record." ;
    skos:example "Converting an invoice denominated in yen into US dollars at the current spot rate." ;
    bpot:apqcSourceText "Identifying current exchange rates between two currencies and converting the foreign currency to that of the local monetary unit. I.E., yen to US dollar." ;
    bpot:hierarchyID "9.11.4" ;
    bpot:pcfID "19593" .

bpot:P20135 a owl:Class ;
    rdfs:label "Operationalize and implement plans to achieve budget" ;
    rdfs:comment "Anchored at cco:ont00000228 (Planned Act): this is execution/implementation, not the production of an informational artifact. The Budget is a definitional directive input; it has no definitional informational output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Budget ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that puts an approved budget into practical use, executing financial activity within designated forecasting parameters." ;
    skos:example "Releasing budgeted funds and steering spending to stay within the approved plan." ;
    bpot:apqcSourceText "Putting budgeting plans into practical use keeping within designated forecasting parameters." ;
    bpot:hierarchyID "9.1.1.3" ;
    bpot:pcfID "20135" .

bpot:P20136 a owl:Class ;
    rdfs:label "Perform variance analysis against forecasts and budgets" ;
    rdfs:comment "Descriptive output (GOLDEN PRINCIPLE): a variance analysis represents the gap between plan and actuals (cco:ont00000853). Budget and forecast are definitional inputs." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Budget ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialForecast ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:VarianceAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that compares actual financial behavior against the budget and the financial forecast and produces a variance analysis." ;
    skos:example "A monthly budget-versus-actual variance report." ;
    bpot:apqcSourceText "Conducting a quantitative analysis between what was forecasted and budgeted and actual financial behavior." ;
    bpot:hierarchyID "9.1.1.5" ;
    bpot:pcfID "20136" .

bpot:P20604 a owl:Class ;
    rdfs:label "Publish accounting policies" ;
    rdfs:comment "Re-anchored from bpo:ActOfReporting to cco:ont00000402 (Act of Communication). Two defects fixed: (1) GOLDEN-PRINCIPLE break -- bpo:ActOfReporting compiles a Descriptive ICE, but the asserted output was bpo:FinancialPolicy, a Directive ICE (cco:ont00000965); (2) the act merely disseminates an already-formulated policy (input == output == FinancialPolicy), i.e. transfer of an existing ICE between agents, which the bpo:ActOfReporting comment routes to cco:ont00000402: 'Where a node only transmits an already-prepared report to a party, the group module reuses cco:ont00000402 instead.' Publishing transmits the same ICE; it does not produce a new descriptive one, so the has output bpo:FinancialPolicy restriction is dropped and bpo:FinancialPolicy is kept as has input (the transmitted ICE). cco:ont00000402 verified against CCO v2.0 (2024-11-06): 'A Planned Act in which some Information Content Entity is transferred from some Agent to Another.'" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        cco:ont00000402 ;
    skos:definition "An Act of Communication that conveys an already-formulated accounting policy to the public." ;
    skos:example "Posting the firm's accounting-policy manual on its investor-relations website." ;
    bpot:apqcSourceText "Creating a written copy of agreed-upon procedures for preparing financial statements, and making them available to the public." ;
    bpot:hierarchyID "9.3.1.3" ;
    bpot:pcfID "20604" .

bpot:P20929 a owl:Class ;
    rdfs:label "Manage corporate credit cards" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to bpo:ActOfCardAdministration. (1) Genus fix: 'handling and authoring (issuing) credit cards' is card issuance/administration, not a transfer of money/Financial-Instrument in settlement, so bpo:ActOfFinancialTransaction's differentia is not satisfied (false friend on the theme 'credit card'); the new bpo:ActOfCardAdministration (a Planned Act) covers the issue/handle/deactivate family. (2) R5 discriminator (made explicit and applied identically to bpo:P10734): open-ended stewardship with no natural terminus -> Organization Capability (cco:ont00000568), as for bpo:P10734 'Manage treasury operations' (ongoing optimization of cash/liquidity/risk, realized-in its acts); a bounded card-lifecycle exercise over a concrete card-set with a definite completion -> a process, as here (issue a set of cards, run their lifecycle, deactivate). The source verbs 'Handling and authoring' name discrete bounded acts with material card participants, so 9.6.3 is a process whose activities are process parts -- distinct from the no-end stewardship that makes bpo:P10734 a capability. The corporate credit card is a definitional material participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:CorporateCreditCard ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20930 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20931 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20932 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20933 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20934 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20935 ],
        bpot:ActOfCardAdministration ;
    skos:definition "An Act of Card Administration that handles and authorizes the issuance of corporate credit cards to business entities and for corporate purchases, and that has as process parts the card-lifecycle activities of policy-setting, request handling, ordering, account maintenance, limit changes, and deactivation." ;
    skos:example "A finance team issuing and administering corporate purchasing cards." ;
    bpot:apqcSourceText "Handling and authoring credit cards to business entities or for corporate purchases." ;
    bpot:hierarchyID "9.6.3" ;
    bpot:pcfID "20929" .

bpot:P20930 a owl:Class ;
    rdfs:label "Establish corporate credit card policies and approval limits" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (cco:ont00000511): composing card-use procedures and limits yields a Directive ICE (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that develops the procedures and credit limits governing corporate credit-card use and produces a financial policy." ;
    skos:example "Issuing a corporate-card policy that sets default spend limits by role." ;
    bpot:apqcSourceText "Developing procedures for using company credit cards. Set or approve credit limits." ;
    bpot:hierarchyID "9.6.3.1" ;
    bpot:pcfID "20930" .

bpot:P20931 a owl:Class ;
    rdfs:label "Process corporate credit card requests" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to bpo:ActOfCardAdministration. Handling card applications transfers no money and settles no obligation, so it falls outside bpo:ActOfFinancialTransaction's differentia; 'family coherence' is not a valid reason to file an act under a genus whose differentia it fails (same false-friend as bpo:P20929/bpo:P20935). bpo:ActOfCardAdministration (a Planned Act) is the correct shared genus. The corporate-card request remains a typical input ICE (commented, not a definitional restriction); the card requested is the material participant in the lifecycle." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:CorporateCreditCard ],
        bpot:ActOfCardAdministration ;
    skos:definition "An Act of Card Administration that handles applications for corporate credit cards for business expenses within the card-issuance lifecycle." ;
    skos:example "Intake and routing of an employee's corporate-card application." ;
    bpot:apqcSourceText "Handling applications credit card applications for business expenses." ;
    bpot:hierarchyID "9.6.3.2" ;
    bpot:pcfID "20931" .

bpot:P20932 a owl:Class ;
    rdfs:label "Order corporate credit cards" ;
    rdfs:comment "Anchored to bpo:ActOfAcquisition (inlined; cco:ont00000228 Planned Act): obtaining a card from an issuer that the organization did not previously hold. The card obtained is a MATERIAL participant (obo:BFO_0000057), not has output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:CorporateCreditCard ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that obtains corporate credit cards, not previously held, for business-related expenses." ;
    skos:example "Ordering newly approved corporate purchasing cards from the issuing bank." ;
    bpot:apqcSourceText "Obtaining credit cards for business-related expenses." ;
    bpot:hierarchyID "9.6.3.3" ;
    bpot:pcfID "20932" .

bpot:P20933 a owl:Class ;
    rdfs:label "Manage corporate credit card accounts" ;
    rdfs:comment "R5: the source ('Handling credit card accounts') denotes discrete account-record maintenance, a bounded occurrent, not a no-end function. Anchored to bpo:ActOfAccounting (cco:ont00000366)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AccountStatement ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that maintains the corporate credit-card accounts of business customers and produces updated account statements." ;
    skos:example "Reconciling and updating a corporate-card account at month-end." ;
    bpot:apqcSourceText "Handling credit card accounts of business customers." ;
    bpot:hierarchyID "9.6.3.4" ;
    bpot:pcfID "20933" .

bpot:P20934 a owl:Class ;
    rdfs:label "Approve/Change credit limits" ;
    rdfs:comment "Anchored to cco:ont00000228 (Planned Act) -- the §6 TOP intentional-act anchor -- as an AUTHORIZATION/RATIFICATION of a settled limit change (no candidate set), for which CCO 2.0 has no dedicated act kind. REJECTED candidates (D5/§6 step 3), uniform with the 9.6 approval siblings bpo:P10872 and bpo:P10882: (1) cco:ont00000636 'Act of Appraisal' -- would pair an Appraisal genus (Descriptive judgement) with the Directive bpo:PaymentApproval output, breaking GOLDEN-PRINCIPLE agreement. (2) bpo:ActOfSelection -- no candidate set; ratifying a single settled change routes to cco:ont00000228 per the apqc-ext ActOfSelection note. Output is the Directive bpo:PaymentApproval (reused for the authorization decision)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PaymentApproval ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that authorizes a change to the available credit advances on a corporate credit card and produces an approval decision." ;
    skos:example "Approving an increase to a department card's monthly credit limit." ;
    bpot:apqcSourceText "Authorizing changes to the available credit advances." ;
    bpot:hierarchyID "9.6.3.5" ;
    bpot:pcfID "20934" .

bpot:P20935 a owl:Class ;
    rdfs:label "Cancel/Deactivate credit card" ;
    rdfs:comment "Re-anchored from bpo:ActOfFinancialTransaction to bpo:ActOfCardAdministration (critical fix). bpo:ActOfFinancialTransaction is 'A Planned Act in which an Agent transfers money or a Financial Instrument ... in settlement ...'; blocking a card to disable future transactions transfers no money and settles nothing -- it is the OPPOSITE of a financial transaction, a false friend driven by the theme 'credit card' rather than the verb 'block/deactivate'. The genus definition does not subsume this act. REJECTED candidate bpo:ActOfFinancialTransaction (reason: no money/instrument transfer). Modeled as a card-lifecycle administrative act (bpo:ActOfCardAdministration, a Planned Act over the card artifact), with the corporate credit card as the definitional material participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:CorporateCreditCard ],
        bpot:ActOfCardAdministration ;
    skos:definition "An Act of Card Administration that blocks an existing corporate credit card so as to disable all of its future transactions." ;
    skos:example "Deactivating a lost corporate card to prevent further charges." ;
    bpot:apqcSourceText "Blocking an existing credit card to disable all future transactions." ;
    bpot:hierarchyID "9.6.3.6" ;
    bpot:pcfID "20935" .

bpot:P21574 a owl:Class ;
    rdfs:label "Operate controls and monitor compliance with internal controls policies and procedures" ;
    rdfs:comment "Re-anchored from bpo:ActOfMonitoring to cco:ont00000228 (Planned Act) as a composite OPERATE-and-monitor process. The source enumerates 'Performing planning, management, OPERATIONS, and monitoring of internal control mechanism' and the label leads with 'OPERATE controls': operating/running controls is a performative Planned Act, not an information-processing/observation act, so anchoring the whole as bpo:ActOfMonitoring captured only the 'monitor' facet and silently dropped the dominant 'operate' facet. This is now consistent with the module's own treatment of the sibling child bpo:P10919 ('Remediate'), which was pulled OUT of bpo:ActOfMonitoring to cco:ont00000228 because executing a measure is not information-processing. The monitoring facet is carried by the has-process-part bpo:P10918 (a bpo:ActOfMonitoring that produces bpo:ControlEffectivenessAssessment); the bpo:ControlEffectivenessAssessment output is therefore NOT asserted as a definitional output of the whole composite (it is produced by the monitoring part, not by the operate-and-monitor process as a whole). Input bpo:InternalControlPolicy is the control standard operated and monitored; definitional, so restricted. REJECTED candidate bpo:ActOfMonitoring (would scope the whole to pure observation, dropping the operate facet)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalControlPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10918 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10919 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that operates an organization's internal-control mechanisms and monitors compliance with control policies and procedures, having as process parts the monitoring of control effectiveness and the remediation of control deficiencies." ;
    skos:example "An internal-controls team runs the control suite each period and assesses whether procedures were followed." ;
    bpot:apqcSourceText "Performing planning, management, operations, and monitoring of internal control mechanism policies and procedures in order to manage internal controls." ;
    bpot:hierarchyID "9.8.2" ;
    bpot:pcfID "21574" .

bpot:PayrollDeductionRecord a owl:Class ;
    rdfs:label "Payroll Deduction Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the deductions applied to an employee's salary on the basis of expenses, investments, and tax rules." ;
    skos:example "A record of an employee's statutory and voluntary deductions for the year." .

bpot:PerformanceMeasure rdfs:label "Performance Measure" ;
    rdfs:comment "Modeled as Descriptive ICE when it records/reports a quantified performance value; a KPI specification prescribing what to measure, how, and against what target should be modeled separately as a Directive ICE (cco:ont00000965)." ;
    skos:definition "A Descriptive Information Content Entity that describes a quantified measure of financial or operational performance." .

bpot:ConsolidatedFinancialStatement a owl:Class ;
    rdfs:label "Consolidated Financial Statement" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the combined financial position and results of a parent Organization and its subsidiaries." .

bpot:CreditPolicy a owl:Class ;
    rdfs:label "Credit Policy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the credit standards, terms, and collection rules an Organization applies to its customers." .

bpot:CreditScoringHistory a owl:Class ;
    rdfs:label "Credit Scoring History" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the past credit scores and payment behavior of a customer or applicant." .

bpot:P10741 a owl:Class ;
    rdfs:label "Evaluate and manage financial performance" ;
    rdfs:comment "Composite process anchored at cco:ont00000228 (Planned Act) because its parts mix appraisal (assess profitability, evaluate new products) with planning/selection (optimize mix), so no single act genus fits the whole." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10782 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10783 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10784 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10785 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10786 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10787 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an organization appraises and manages the profitability and feasibility of its products, customers, and projects against predetermined financial targets." ;
    skos:example "A profitability and product-mix review cycle assessing performance against targets." ;
    bpot:apqcSourceText "Checking and achieving predetermined financial targets and timelines. Assess and manage the profitability, feasibility, and consistency of a business or project. Study the revenues generated." ;
    bpot:hierarchyID "9.1.4" ;
    bpot:pcfID "10741" .

bpot:P10866 a owl:Class ;
    rdfs:label "Calculate and pay applicable payroll taxes" ;
    rdfs:comment "The remitted Monetary Payment is a MATERIAL participant (obo:BFO_0000057), not has output; calculation per tax regulations is a sub-step. Certified accountants typically participate (rdfs:comment, not definitional)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TaxData ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that calculates the payroll-tax liability owed on employees' salaries and pays it to the tax authority, producing a monetary payment of tax." ;
    skos:example "Computing and remitting withheld income tax for the period to the revenue authority." ;
    bpot:apqcSourceText "Paying tax according to appropriate deductions made from salaries. Calculate and pay the tax liabilities according to the salaries and tax regulations of employees with the help of certified chartered accountants." ;
    bpot:hierarchyID "9.5.3.3" ;
    bpot:pcfID "10866" .

bpot:P10883 a owl:Class ;
    rdfs:label "Process reimbursements and advances" ;
    rdfs:comment "Anchored to bpo:ActOfFinancialTransaction (cco:ont00000228). The disbursed monetary payment is a MATERIAL participant; the employee is the definitional recipient. The source cross-reference licenses bfo:precedes from 10882 (see precedence block)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:PaymentInstrument ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Employee ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PaymentApproval ],
        bpot:ActOfFinancialTransaction ;
    skos:definition "An Act of Financial Transaction that disburses monetary payment to employees in settlement of approved expense-reimbursement and advance requests." ;
    skos:example "Paying an employee's approved expense claim by direct deposit." ;
    bpot:apqcSourceText "Paying for expense reimbursement requests from employees. (Follow Approve reimbursements and advances [10882] according to policies and conditions.)" ;
    bpot:hierarchyID "9.6.2.4" ;
    bpot:pcfID "10883" .

bpot:P10885 a owl:Class ;
    rdfs:label "Establish scope and governance of treasury operations" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output) per GOLDEN PRINCIPLE: establishing scope and authority composes a prescriptive directive." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TreasuryGovernanceCharter ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a treasury governance charter prescribing the scope of treasury operations and its authoritative governing body." ;
    skos:example "A board committee sets the mandate and approval authority for the treasury desk." ;
    bpot:apqcSourceText "Selecting opportunities and the authoritative body for investments in trading in bonds, currencies, financial derivatives, etc." ;
    bpot:hierarchyID "9.7.1.1" ;
    bpot:pcfID "10885" .

bpot:P10893 a owl:Class ;
    rdfs:label "Manage and reconcile cash positions" ;
    rdfs:comment "Genus bpo:ActOfAccounting (info-processing; Descriptive output). Reuses shared bpo:GeneralLedger; output bpo:CashPosition minted locally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:GeneralLedger ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CashPosition ],
        bpot:ActOfAccounting ;
    skos:definition "An Act of Accounting that has as input a general ledger and has as output a reconciled cash position." ;
    skos:example "Treasury reconciles bank statements against the ledger and corrects discrepancies." ;
    bpot:apqcSourceText "Correcting cash differences in the books of accounts. Make optimum utilization of funds available in the business. Check for differences to rectify." ;
    bpot:hierarchyID "9.7.2.1" ;
    bpot:pcfID "10893" .

bpot:P12974 a owl:Class ;
    rdfs:label "Develop risk management/hedging strategy" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output). Reuses shared bpo:HedgingStrategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:HedgingStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a hedging strategy prescribing positions taken to offset exposure to financial risks." ;
    skos:example "The risk committee adopts a strategy to hedge 80 percent of forecast FX exposure." ;
    bpot:apqcSourceText "Taking an investment position to offset exposure to certain risks. This may include purchasing opposite of the organization's position in the marketplace, using derivatives transactions, or futures contracts." ;
    bpot:hierarchyID "9.7.5.1" ;
    bpot:pcfID "12974" .

bpot:P14007 a owl:Class ;
    rdfs:label "Perform recovery workout" ;
    rdfs:comment "Genus Act of Formulation: the definitional output is the revised agreement terms (Directive ICE). The defaulting Customer participates." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialProcedure ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Customer ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that renegotiates the terms of a loan agreement with a defaulting debtor and prescribes revised repayment terms as a financial procedure to recoup the debt." ;
    skos:example "A workout specialist renegotiates a defaulted loan into a restructured repayment schedule." ;
    bpot:apqcSourceText "Renegotiating the terms of a loan agreement in order to recoup money from a default account." ;
    bpot:hierarchyID "9.2.4.6" ;
    bpot:pcfID "14007" .

bpot:P14079 a owl:Class ;
    rdfs:label "Establish investment policy" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Directive output). Reuses shared bpo:InvestmentPolicy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:InvestmentPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output an investment policy prescribing the principles the organization will follow in making investments." ;
    skos:example "The investment committee adopts a policy capping single-issuer exposure." ;
    bpot:apqcSourceText "Developing and instituting principles that the organization ill use in making investments." ;
    bpot:hierarchyID "9.7.4.1" ;
    bpot:pcfID "14079" .

bpot:P17059 a owl:Class ;
    rdfs:label "Perform global trade services" ;
    rdfs:comment "Models APQC process group 9.11 as a bounded occurrent. Anchored at the generic cco:ont00000228 (Planned Act) because the group bundles heterogeneous acts (financial transactions, information processing, communication, formulation) with no single dominant genus. Its APQC dotted children are process parts (cco:ont00001777); the two standing-function children (Control exports/imports; Handle restitution) are modeled as Organization Capabilities and are therefore not process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14090 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14092 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19593 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14093 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14094 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14095 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14096 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14098 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an organization services an international-trade transaction by screening parties, classifying and documenting goods, converting currency, calculating and clearing customs duties, and arranging payment instruments so that products and services can be exchanged across markets." ;
    skos:example "An exporter's end-to-end handling of a cross-border shipment, from sanctions screening through customs clearance and letter-of-credit settlement." ;
    bpot:apqcSourceText "Making and collecting payments for transactions in products/services, and transporting them to interested markets." ;
    bpot:hierarchyID "9.11" ;
    bpot:pcfID "17059" .

bpot:RegulatoryFiling a owl:Class ;
    rdfs:label "Regulatory Filing" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity submitted to a regulatory authority that reports required financial, tax, or compliance information." .

bpot:TaxReturn a owl:Class ;
    rdfs:label "Tax Return" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that reports an Organization's or individual's taxable income, deductions, and tax owed to a tax authority." .

bpot:CorporateCreditCard a owl:Class ;
    rdfs:label "Corporate Credit Card" ;
    rdfs:comment "Material object handled in 9.6.3 (manage corporate credit cards): ordered, issued, deactivated. Anchored to cco:ont00000995 (Material Artifact), NOT cco:ont00000537 (Financial Instrument): a credit card is an access/authorization device, not a tradeable asset, so 537's 'designed to be a tradeable asset' differentia is unsatisfied (a finance-theme false friend). Genuinely tradeable instruments are modeled separately under 537 via bpo:FinancialInstrument." ;
    rdfs:subClassOf obo:BFO_0000040,
        cco:ont00000995 ;
    skos:definition "A Material Artifact issued to an Organization or its personnel that is designed to realize the function of authorizing the charging of business expenses to a corporate credit account." .

bpot:CustomerMasterFile a owl:Class ;
    rdfs:label "Customer Master File" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the identifying details and purchase history of an Organization's customers." .

bpot:InternalControlPolicy a owl:Class ;
    rdfs:label "Internal Control Policy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the controls, roles, and responsibilities an Organization adopts to assure reliable financial reporting and operations." .

bpot:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "Descriptive: it records the particulars of a transaction rather than prescribing a course of action; the obligation to pay is borne separately." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:Customer ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a commercial transaction between a seller and a customer, itemizing quantities, prices, dates, and tax." .

bpot:PaymentApproval a owl:Class ;
    rdfs:label "Payment Approval Decision" ;
    rdfs:comment "Directive: an approval authorizes (prescribes) an action; covers approve-payments, approve-reimbursements, approve credit-limit changes." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes that a particular payment, reimbursement, or credit change is authorized to proceed." .

bpot:RegulatoryAuthority rdfs:comment "Covers tax authorities, securities exchanges, and customs agencies referenced in 9.3, 9.8, 9.9, 9.11." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:RegulatorRole ] ;
    skos:definition "An Organization that bears a regulator role and issues or enforces financial, tax, or trade rules binding on other organizations." .

bpot:Subsidiary a owl:Class ;
    rdfs:label "Subsidiary" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:SubsidiaryRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a subsidiary role, being a separate legal entity controlled by a parent Organization." .

bpot:VarianceAnalysis a owl:Class ;
    rdfs:label "Variance Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the differences between budgeted or forecasted figures and actual financial results." .

bpot:ControlEffectivenessAssessment a owl:Class ;
    rdfs:label "Control Effectiveness Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of how effectively an Organization's internal controls mitigate risk." .

bpot:Supplier rdfs:comment "Vendor counterparty for accounts payable (9.6)." ;
    skos:definition "An Agent that bears a supplier role and provides goods or services to a focal Organization for payment." .

bpot:TaxStrategy a owl:Class ;
    rdfs:label "Tax Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes how an Organization will manage and minimize its tax liabilities." .

bpot:ComplianceReport a owl:Class ;
    rdfs:label "Internal Controls Compliance Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the state of an Organization's compliance with its internal-control policies and procedures." .

bpot:CostData skos:definition "A Descriptive Information Content Entity that describes the costs incurred in producing products, delivering services, or performing activities." .

bpot:CreditAssessment a owl:Class ;
    rdfs:label "Credit Assessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:Customer ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of a customer's or applicant's creditworthiness." .

bpot:FinancialForecast a owl:Class ;
    rdfs:label "Financial Forecast" ;
    rdfs:comment "Predictive (a specialization of Descriptive, cco:ont00000853): a forecast describes an uncertain expected future state rather than prescribing an allocation; contrast bpo:Budget. Re-anchored from cco:ont00000853 to cco:ont00000626 (Predictive Information Content Entity) so the output kind matches the predictive nature of bpo:P10773 (Act of Prediction). Still a Descriptive ICE for GOLDEN-PRINCIPLE purposes (cco:ont00000626 subClassOf cco:ont00000853)." ;
    rdfs:subClassOf cco:ont00000626 ;
    skos:definition "A Predictive Information Content Entity that describes projected future income, expenses, or cash flows of an Organization." .

bpot:ProfitabilityAnalysis skos:definition "A Descriptive Information Content Entity that describes the revenues, costs, and resulting profit attributable to a customer, product, unit, or project." .

bpot:TimeRecord a owl:Class ;
    rdfs:label "Employee Time Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the working days, hours, billing hours, and leave of an employee over a reporting period." ;
    skos:example "A weekly timesheet capturing each employee's hours and billable time." .

bpot:AccountStatement a owl:Class ;
    rdfs:label "Account Statement" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the balance and activity of a particular financial account over a period." .

bpot:Budget a owl:Class ;
    rdfs:label "Budget" ;
    rdfs:comment "Directive: a budget prescribes intended fund allocation, constraining subsequent spending." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the planned allocation of funds to activities over a defined period." .

bpot:Employee rdfs:comment "Subject of payroll (9.5) and expense reimbursement (9.6)." ;
    skos:definition "An Agent that bears an employee role in relation to an employing Organization." .

bpot:FinancialData a owl:Class ;
    rdfs:label "Financial Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an Organization's financial transactions, balances, or results." .

bpot:FinancialStatement skos:definition "A Descriptive Information Content Entity that describes an Organization's financial position and results, comprising balance sheet, income statement, cash-flow statement, and statement of equity." .

bpot:MarketRateData a owl:Class ;
    rdfs:label "Market Rate Data" ;
    rdfs:comment "Input to treasury, hedging, and international-funds processes (9.7, 9.10)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes prevailing interest rates, foreign-exchange rates, or other market prices." .

bpot:TaxData a owl:Class ;
    rdfs:label "Tax Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes income, deductions, and liabilities relevant to an Organization's taxation." .

bpot:Customer skos:definition "An Agent that bears a customer role in relation to a focal Organization." .

bpot:RiskAssessment a owl:Class ;
    rdfs:label "Financial Risk Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an organization's exposure to interest-rate, foreign-exchange, credit, or market risk." .

bpot:FinancialPolicy a owl:Class ;
    rdfs:label "Financial Policy" ;
    rdfs:comment "General policy genus for the many 'Establish ... policies' nodes across 9.0." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the rules governing a financial process such as budgeting, accounting, credit, or reimbursement." .

bpot:FinancialReport a owl:Class ;
    rdfs:label "Financial Report" ;
    rdfs:comment "General report genus for AR/AP, profitability, treasury, and shareholder reports across 9.0." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that presents financial data compiled for a management, shareholder, or regulatory audience." .

bpot:FixedAssetRegister a owl:Class ;
    rdfs:label "Fixed-Asset Register" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records each of an Organization's fixed assets together with its cost, useful life, depreciation, and resale value." .

bpot:FinancialProcedure a owl:Class ;
    rdfs:label "Financial Procedure" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the ordered steps for carrying out a financial process." .

bpot:PaymentInstrument a owl:Class ;
    rdfs:label "Payment Instrument" ;
    rdfs:comment "Material input/participant of Acts of Financial Transaction (payments, salary disbursements, deposits, remittances) in 9.2, 9.5, 9.6, 9.7, 9.10, 9.11. Renamed from bpo:PaymentInstrument, whose label misread as the payment EVENT; this class is the transferred MONEY (a material filler), never the act. Anchored to cco:ont00000537 to match CCO's treatment of money as a Financial Instrument (cf. Portion of Cash cco:ont00000475 subClassOf 537)." ;
    rdfs:subClassOf obo:BFO_0000040,
        cco:ont00000537 ;
    skos:definition "A Financial Instrument consisting of a quantity of money (cash or funds) transferred from one Agent to another in settlement of an obligation or exchange." .

bpot:GeneralLedger a owl:Class ;
    rdfs:label "General Ledger" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records, by account, the complete set of an Organization's financial transactions for an accounting period." .

bpot:ActOfFinancialTransaction rdfs:comment "PROPOSE-EXT (D9). Re-anchored from the bare cco:ont00000228 to cco:ont00000836 (Act of Financial Instrument Use): every subclass here uses/transfers a Financial Instrument (money and cash are Financial Instruments in CCO -- cf. Portion of Cash cco:ont00000475 subClassOf 537), and CCO models settlements, loans, purchases, deposits, withdrawals and exchanges uniformly under 836, so the earlier claim that this genus is 'broader than financial-instrument use' was incorrect (investments and exchanges still USE financial instruments). Rejected cco:ont00001334 'Act of Purchasing' and cco:ont00000389 'Act of Buying' (both acquire a good/service -- too narrow for payments/remittances/trades/deposits) and cco:ont00000366 'Act of Information Processing' (a payment moves a material/financial-instrument filler, not only an ICE). cco:ont00000228 co-asserted because 836 falls outside the S2 standalone-SHACL allowlist. Recurs in payment/treasury/trade categories (9.0)." .

bpot:TransactionRecord a owl:Class ;
    rdfs:label "Transaction Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that registers an individual financial transaction together with its amount, date, and parties." .

