@prefix bpot: <https://fandaws.com/ontology/bpot#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bpot:Accountant a owl:Class ;
    rdfs:label "Accountant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001954 ;
            owl:someValuesFrom bpot:AccountingCapability ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:AccountantRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that has an accounting capability and bears an accountant role." .

bpot:DebtorRole a owl:Class ;
    rdfs:label "Debtor Role" ;
    rdfs:comment "Used for delinquent/default account holders in 9.2." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of owing an outstanding amount to an Organization under a credit or payment obligation." .

bpot:DefaultAccountManagementCapability a owl:Class ;
    rdfs:label "Default Account Management Capability" ;
    rdfs:comment "Models APQC 9.2.4.7 'Manage default accounts' (PCF 14008). R5: a standing function with no natural end, so modeled as an Organization Capability (cco:ont00000568) per R6 rather than a process. Bears no bpo:pcfID (supporting class); realized in bpo:P14007 (Perform recovery workout) as a bounded act of that management." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P14007 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in the recovery and collection acts by which an organization handles customer accounts that have not met their agreed repayment obligations." .

bpot:EmployeeRole rdfs:comment "Used for payroll and expense-reimbursement subjects in 9.5 and 9.6." .

bpot:FinanceFunction a owl:Class ;
    rdfs:label "Finance Function" ;
    rdfs:comment "Models the finance department/function as an organizational unit (an Organization), NOT a realizable function/capability despite the 'Function' label. Mirrors the slice-7 bpo:HumanResourcesFunction precedent: cco:ont00001180 (Organization) is a Group of Agents / Object Aggregate, not an Agent (cco:ont00001017). Bearer of the finance-function role and the agent/participant of section 9.0 acts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:FinanceFunctionRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a finance-function role within a larger organization in virtue of being tasked with carrying out its financial management activities." .

bpot:FinancialManagementCapability a owl:Class ;
    rdfs:label "Financial Management Capability" ;
    rdfs:comment "Process-layer 'Manage ...' standing functions (R5 capabilities) realize-in the section's acts; group modules attach realized-in restrictions to this or its specializations." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to plan, account for, control, and report on its financial resources." .

bpot:FinancialPlan a owl:Class ;
    rdfs:label "Financial Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the financial goals and the actions intended to achieve them over a planning horizon." .

bpot:FinancialPolicyManagementCapability a owl:Class ;
    rdfs:label "Financial Policy Management Capability" ;
    rdfs:comment "R5/R6: APQC 9.3.1 'Manage financial policies and procedures' is a standing function (no natural end), so modeled as a capability realized in its bounded child acts. No bpo:pcfID (capability, not a PCF process)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10816 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P20604 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10817 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10818 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in the acts of establishing, publishing, and enforcing an organization's accounting policies and procedures." ;
    skos:example "A finance department's ongoing capacity to keep accounting policy current and enforced." .

