@prefix bpot: <https://fandaws.com/ontology/bpot#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bpot:ComplianceControl a owl:Class ;
    rdfs:label "Compliance Control Specification" ;
    rdfs:comment "Output/subject of 11.2.2.5 (implement missing or stronger controls) and 11.2.1.4 (controls-related technologies and tools). Directive: a control prescribes required behaviour." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a control, safeguard, or check implemented to ensure regulatory compliance and the security of an organization's information and processes." .

bpot:ComplianceOfficer a owl:Class ;
    rdfs:label "Compliance Officer" ;
    rdfs:comment "Definitional participant in compliance acts across 11.2." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ComplianceOfficerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a compliance-officer role." .

bpot:EnterpriseRiskManagementCapability a owl:Class ;
    rdfs:label "Enterprise Risk Management Capability" ;
    rdfs:comment "Models the standing function of 11.1 'Manage enterprise risk' (R5/R6). The realized-in axioms to the bounded 11.1 acts are carried by bpo:P17060 below, which is this capability's reality-layer correlate." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of establishing risk frameworks and policies and of overseeing, coordinating, and managing risk across an organization and its business units." .

bpot:ExecutiveManagement a owl:Class ;
    rdfs:label "Executive Management" ;
    rdfs:comment "Definitional recipient in 11.1.1.5 (report enterprise risk to executive management and board)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ExecutiveManagementRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears an executive-management role and is a recipient of enterprise risk and compliance reports." .

bpot:PCF_11185 bpot:designatesProcessType bpot:RemediationManagementCapability .

bpot:PCF_11201 bpot:designatesProcessType bpot:P11201 .

bpot:PCF_11202 bpot:designatesProcessType bpot:P11202 .

bpot:PCF_11203 bpot:designatesProcessType bpot:P11203 .

bpot:PCF_11204 bpot:designatesProcessType bpot:P11204 .

bpot:PCF_11205 bpot:designatesProcessType bpot:P11205 .

bpot:PCF_11206 bpot:designatesProcessType bpot:P11206 .

bpot:PCF_11216 bpot:designatesProcessType bpot:BusinessResiliencyCapability .

bpot:PCF_11221 bpot:designatesProcessType bpot:P11221 .

bpot:PCF_11222 bpot:designatesProcessType bpot:P11222 .

bpot:PCF_11223 bpot:designatesProcessType bpot:P11223 .

bpot:PCF_11224 bpot:designatesProcessType bpot:P11224 .

bpot:PCF_14133 bpot:designatesProcessType bpot:InternalAuditManagementCapability .

bpot:PCF_14137 bpot:designatesProcessType bpot:ControlsTechnologyMaintenanceCapability .

bpot:PCF_16439 bpot:designatesProcessType bpot:P16439 .

bpot:PCF_16440 bpot:designatesProcessType bpot:P16440 .

bpot:PCF_16441 bpot:designatesProcessType bpot:P16441 .

bpot:PCF_16442 bpot:designatesProcessType bpot:P16442 .

bpot:PCF_16443 bpot:designatesProcessType bpot:P16443 .

bpot:PCF_16444 bpot:designatesProcessType bpot:P16444 .

bpot:PCF_16445 bpot:designatesProcessType bpot:P16445 .

bpot:PCF_16446 bpot:designatesProcessType bpot:P16446 .

bpot:PCF_16447 bpot:designatesProcessType bpot:P16447 .

bpot:PCF_16448 bpot:designatesProcessType bpot:P16448 .

bpot:PCF_16449 bpot:designatesProcessType bpot:P16449 .

bpot:PCF_16450 bpot:designatesProcessType bpot:P16450 .

bpot:PCF_16451 bpot:designatesProcessType bpot:P16451 .

bpot:PCF_16452 bpot:designatesProcessType bpot:P16452 .

bpot:PCF_16453 bpot:designatesProcessType bpot:P16453 .

bpot:PCF_16454 bpot:designatesProcessType bpot:P16454 .

bpot:PCF_16456 bpot:designatesProcessType bpot:P16456 .

bpot:PCF_16457 bpot:designatesProcessType bpot:P16457 .

bpot:PCF_16458 bpot:designatesProcessType bpot:P16458 .

bpot:PCF_16459 bpot:designatesProcessType bpot:P16459 .

bpot:PCF_16460 bpot:designatesProcessType bpot:P16460 .

bpot:PCF_16461 bpot:designatesProcessType bpot:P16461 .

bpot:PCF_16462 bpot:designatesProcessType bpot:P16462 .

bpot:PCF_16463 bpot:designatesProcessType bpot:RegulatoryComplianceManagementCapability .

bpot:PCF_16464 bpot:designatesProcessType bpot:P16464 .

bpot:PCF_16465 bpot:designatesProcessType bpot:P16465 .

bpot:PCF_16466 bpot:designatesProcessType bpot:P16466 .

bpot:PCF_16467 bpot:designatesProcessType bpot:P16467 .

bpot:PCF_16468 bpot:designatesProcessType bpot:P16468 .

bpot:PCF_16469 bpot:designatesProcessType bpot:P16469 .

bpot:PCF_16470 bpot:designatesProcessType bpot:RegulatorRelationshipManagementCapability .

bpot:PCF_16471 bpot:designatesProcessType bpot:P16471 .

bpot:PCF_17060 bpot:designatesProcessType bpot:P17060 .

bpot:PCF_17462 bpot:designatesProcessType bpot:P17462 .

bpot:PCF_17467 bpot:designatesProcessType bpot:ComplianceManagementCapability .

bpot:PCF_17468 bpot:designatesProcessType bpot:P17468 .

bpot:PCF_17469 bpot:designatesProcessType bpot:P17469 .

bpot:PCF_17470 bpot:designatesProcessType bpot:P17470 .

bpot:PCF_18129 bpot:designatesProcessType bpot:P18129 .

bpot:PCF_19595 bpot:designatesProcessType bpot:P19595 .

bpot:PCF_19596 bpot:designatesProcessType bpot:P19596 .

bpot:RegulatoryAuthorityRole rdfs:comment "Borne by the authority Organization, never by the requirement or report ICE it issues or receives." .

bpot:RiskManager a owl:Class ;
    rdfs:label "Risk Manager" ;
    rdfs:comment "Definitional participant in enterprise and business-unit risk acts across 11.1." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:RiskManagerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a risk-manager role." .

bpot:designatesProcessType rdfs:comment "Bridges a catalog node (bpo:PCF_<pcfID>) to its reality-layer class (bpo:P<pcfID> or a supporting capability). The catalog nodes themselves are declared and typed (owl:NamedIndividual, cco:ont00000853 Descriptive ICE, skos:Concept) in apqc-catalog.ttl. An ANNOTATION property is used (not an object property) deliberately, to keep the slice in OWL DL and avoid ICE-to-class punning (ADR-001 R4)." .

<https://fandaws.com/ontology/bpot/sections/pcf_11> a owl:Ontology ;
    dcterms:creator "Aaron Damiano" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://fandaws.com/ontology/bpo/slice/11.0>,
        "APQC Process Classification Framework (Cross-Industry)",
        "APQC Process Classification Framework (Cross-Industry) v7.4" ;
    dcterms:title "Business Process Ontology -- PCF 11.0 Manage Enterprise Risk, Compliance, Remediation, and Resiliency" ;
    rdfs:comment "Reality layer for APQC PCF category 11.0: the process universals that pass the bounded-occurrent test, the organization capabilities, roles and information content entities they use." ;
    owl:versionIRI <https://fandaws.com/ontology/bpot/0.0.0/sections/pcf_11.ttl> ;
    owl:versionInfo "0.0.0" .

bpot:ApplicableRequirementsDetermination a owl:Class ;
    rdfs:label "Applicable Requirements Determination" ;
    rdfs:comment "Output of 11.2.2.2 (identify applicable regulatory requirements), produced by bpo:ActOfIdentification (discernment). Gate-F mint: an information-processing/discernment act produces a DESCRIPTIVE determination of which requirements apply -- it does NOT author the Directive bpo:RegulatoryRequirement (which is issued by a governing authority and is the act's INPUT/subject). This realigns genus, output kind, and the GOLDEN PRINCIPLE. Descriptive (cco:ont00000853)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:RegulatoryRequirement ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about one or more regulatory requirements, that describes which of the candidate body of regulation applies to the organization." .

bpot:BusinessContinuityPlan a owl:Class ;
    rdfs:label "Business Continuity Plan" ;
    rdfs:comment "Output of 11.4.2 (perform continuous business operations planning); subject of 11.4.3 (test) and 11.4.4 (maintain). Directive: prescribes continuity actions." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the arrangements ensuring continuous business operations are maintained, including during disruption or emergency." .

bpot:BusinessOperationsEvaluation a owl:Class ;
    rdfs:label "Business Operations Evaluation" ;
    rdfs:comment "Output of 11.4.4 (maintain continuous business operations -- the text is evaluative)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of an organization's continuous business operations, including which activities generate revenue, perform best, and provide good returns." .

bpot:BusinessResilienceStrategy a owl:Class ;
    rdfs:label "Business Resilience Strategy" ;
    rdfs:comment "Output of 11.4.1 (develop the business resilience strategy), produced by bpo:ActOfFormulation (reused from ext)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an organization's integrated approach for rapidly adapting and responding to internal or external opportunities, demands, disruptions, or threats while protecting employees, assets, and brand equity." .

bpot:BusinessResiliencyCapability a owl:Class ;
    rdfs:label "Business Resiliency Capability" ;
    rdfs:comment "Models APQC process group 11.4 ('Manage business resiliency') under R5/R6: it is a standing function with no natural end, so it is an Organization Capability (cco:ont00000568) realized in its constituent acts, NOT a process. Per R3/R5 it carries no has-process-part to its children. rdfs:label/skos:definition are supplied in the shared-vocabulary block above.",
        "Models the standing function of 11.4 'Manage business resiliency' (R5/R6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11222 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11223 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11224 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16471 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11221 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of developing resilience strategy, planning, testing, and maintaining continuous business operations, and sharing risk knowledge so an organization can rapidly adapt to disruption." ;
    skos:example "An enterprise's standing ability to keep critical operations running and recover quickly during a regional outage." ;
    bpot:apqcSourceText "Including the processes required to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat. Develop a more dynamic, strategic, and integrated approach to managing compliance obligations." ;
    bpot:hierarchyID "11.4" ;
    bpot:pcfID "11216" .

bpot:ComplianceAssessment a owl:Class ;
    rdfs:label "Compliance Assessment" ;
    rdfs:comment "Shared output of appraisal acts in 11.2.2.4 and input to control-implementation acts (11.2.2.5)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of an organization's current compliance position against applicable regulations, including identified weaknesses, shortfalls, and necessary changes." .

bpot:ComplianceMonitoringReport a owl:Class ;
    rdfs:label "Compliance Monitoring Report" ;
    rdfs:comment "Output of 11.2.2.6 (monitor and test regulatory compliance position), produced by bpo:ActOfVerification (inlined above)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the observed compliance position of an organization and the robustness of its existing controls, tracked and tested over time against regulatory requirements." .

bpot:ComplianceOfficerRole a owl:Class ;
    rdfs:label "Compliance Officer Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with validating, maintaining, and ensuring an organization's enduring compliance with applicable regulations and legislation." .

bpot:ComplianceReport rdfs:label "Compliance Report" ;
    rdfs:comment "Transferred ICE of 11.2.2.8 (compile and communicate internal and regulatory compliance reports): an already-compiled report submitted to regulators, modeled as the `has input` of P19596 (cco:ont00000151 communication/submission act), not its output. Descriptive: it represents compliance state." ;
    skos:definition "A Descriptive Information Content Entity that describes an organization's compliance status for submission to internal stakeholders or regulatory agencies." .

bpot:ComplianceScorecard a owl:Class ;
    rdfs:label "Compliance Scorecard" ;
    rdfs:comment "Output of 11.2.2.7 (compile and communicate compliance scorecards)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that presents a graphical summary of metrics describing the general health of an organization with respect to risk and compliance." .

bpot:ContaminatedMaterial a owl:Class ;
    rdfs:label "Contaminated Material" ;
    rdfs:comment "Material subject of 11.3 remediation. Anchored at BFO material entity (obo:BFO_0000040) rather than a 'Portion of Waste Material' class (processed material the user wants to dispose of) because contaminated soil/water/site is not necessarily processed waste; the relevant fact is its adulterated state. The remediation PLAN and POLICY are separate informational artifacts (Directive ICEs)." ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity that has been subject to environmental adulteration and that remediation efforts seek to identify and treat so that the affected area becomes operational again." .

bpot:ContinuityTestResult a owl:Class ;
    rdfs:label "Continuity Test Result" ;
    rdfs:comment "Output of 11.4.3 (test continuous business operations), produced by bpo:ActOfVerification (inlined above)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the results of assessing whether continuous business operations perform as intended under test conditions." .

bpot:ControlsTechnologyMaintenanceCapability a owl:Class ;
    rdfs:label "Controls Technology Maintenance Capability" ;
    rdfs:comment "Reality-layer correlate of APQC 11.2.1.4 (PCF 14137), a standing 'Maintain' function with no natural end; modeled as a capability (R5/R6) rather than a process." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to manage and maintain the technologies and tools that safeguard the confidentiality, integrity, and availability of its information." .

bpot:DamageCauseAnalysis a owl:Class ;
    rdfs:label "Damage Cause Analysis" ;
    rdfs:comment "Output of 11.3.5 (investigate damage cause), produced by bpo:ActOfInvestigation (inlined above)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:DamagedMaterialEntity ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about an instance of damage, that describes a study of the environmental, physical, or social causes of that damage in order to inform better policies and regulations." .

bpot:DamagedMaterialEntity a owl:Class ;
    rdfs:label "Damaged Material Entity" ;
    rdfs:comment "The damaged site or system that is the subject of bpo:DamageCauseAnalysis (cco:ont00001808 'is about'). Renamed from bpo:Damage so the label matches its BFO category: it is a Material Entity (obo:BFO_0000040) that has undergone harm -- the damaged thing, not the damage condition itself. (If a contributor needs the harm qua condition, model it separately as a BFO Quality borne by this entity.)" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity that has undergone harmful physical, environmental, or social alteration whose causes are studied in order to inform better policies and regulations." .

bpot:ERMProcessConformanceReport a owl:Class ;
    rdfs:label "ERM Process Conformance Report" ;
    rdfs:comment "Output of 11.1.2.8 (ensure each unit follows the ERM process), produced by bpo:ActOfVerification (inlined above). Gate-F mint: a dedicated process-conformance finding ICE replacing the false-friend bpo:RiskMonitoringReport (a time-series monitoring artifact) so the verification genus and its output ICE agree. Descriptive (cco:ont00000853)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the finding of a check of whether each business unit and function follows the enterprise risk management process." .

bpot:ERMReportingConformanceReport a owl:Class ;
    rdfs:label "ERM Reporting Conformance Report" ;
    rdfs:comment "Output of 11.1.2.9 (ensure each unit follows the ERM reporting process), produced by bpo:ActOfVerification (inlined above). Gate-F mint: a dedicated reporting-process-conformance finding ICE replacing the false-friend bpo:RiskMonitoringReport so the verification genus and its output ICE agree. Sibling of bpo:ERMProcessConformanceReport. Descriptive (cco:ont00000853)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the finding of a check of whether each business unit and function follows the enterprise risk reporting process." .

bpot:EnterpriseRiskTool a owl:Class ;
    rdfs:label "Enterprise Risk Management Tool Specification" ;
    rdfs:comment "Output of 11.1.1.3 (identify and implement enterprise risk management tools). Modeled as a Directive ICE (a methodological specification), distinct from any physical software tool; if a particular org deploys a software artifact, that is a separate Material Artifact not minted here." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the methods, models, and processes adopted for managing risks and opportunities associated with business objectives." .

bpot:ExecutiveManagementRole a owl:Class ;
    rdfs:label "Executive Management Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of exercising executive authority and accountability for an organization, including oversight of enterprise risk and compliance." .

bpot:ExpertAdvice a owl:Class ;
    rdfs:label "Expert Advice" ;
    rdfs:comment "Output/input of 11.3.2 (contact and confer with experts); consumed by 11.3.1 (create remediation plans). Descriptive: it represents expert opinion." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the recommendations and judgements solicited from subject-matter experts to inform remediation planning." .

bpot:InsuranceCoverageAssessment a owl:Class ;
    rdfs:label "Insurance Coverage Assessment" ;
    rdfs:comment "Output of 11.1.3.3.1 (assess adequacy of insurance coverage)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of the adequacy of an organization's insurance coverage against its changing needs and available providers and offerings." .

bpot:InternalAuditManagementCapability a owl:Class ;
    rdfs:label "Internal Audit Management Capability" ;
    rdfs:comment "Reality-layer correlate of APQC 11.2.1.3 (PCF 14133), a standing 'Manage' function with no natural end; modeled as a capability (R5/R6) rather than a process. Its discrete auditing acts are modeled in the relevant audit subtree." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to plan, conduct, and report on internal audits of its accounts and performance." .

bpot:LegalAnalysis a owl:Class ;
    rdfs:label "Legal Analysis" ;
    rdfs:comment "Output of 11.3.4 (investigate legal aspects), produced by bpo:ActOfInvestigation (inlined above)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an examination of regulatory and legislative frameworks bearing on an organization's remediation obligations, including liabilities for compensation, fines, and corrective effort." .

bpot:P17060 a owl:Class ;
    rdfs:label "Manage enterprise risk" ;
    rdfs:comment "R5: standing function ('Manage ... for the entire organization', no natural end) -> modeled as Organization Capability (cco:ont00000568), not a process. Realized in the bounded child processes 11.1.1-11.1.3. Corresponds to the shared bpo:EnterpriseRiskManagementCapability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16439 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16445 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17462 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to create enterprise-risk frameworks and policies and to coordinate, monitor, and communicate all risk-management activities across the entire organization and each of its functions." ;
    skos:example "A firm's enterprise risk management office that sets risk policy and oversees risk across all business units." ;
    bpot:apqcSourceText "Creating requisite frameworks and coordinating all risk management activities for the entire organization and each function. Manage the enterprise risk by outlining the risk policies and procedures. Monitor and communicate all risk management activities. Encourage correspondence among the business units. Manage the risk of all business units and functions." ;
    bpot:hierarchyID "11.1" ;
    bpot:pcfID "17060" .

bpot:RegulatorRelationshipManagementCapability a owl:Class ;
    rdfs:label "Regulator Relationship Management Capability" ;
    rdfs:comment "Reality-layer correlate of APQC 11.2.2.9 (PCF 16470), an ongoing relational standing function with no natural end and no definitional informational output; modeled as a capability (R5/R6) rather than a process." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to develop and preserve appropriate working relationships with its regulators without compromising the legal basis of those relationships." .

bpot:RegulatoryAuthority rdfs:comment "Recipient/counterparty in 11.2 (maintain relationships with regulators 11.2.2.9; submit reports 11.2.2.8) and source of requirements investigated in 11.3.4." ;
    skos:definition "An Organization that bears a regulatory-authority role, issuing laws, statutes, permits, or requirements and overseeing an organization's compliance." .

bpot:RegulatoryComplianceManagementCapability a owl:Class ;
    rdfs:label "Regulatory Compliance Management Capability" ;
    rdfs:comment "Reality-layer correlate of APQC 11.2.2 (PCF 16463), a standing 'Manage' function with no natural end; modeled as a capability (R5/R6). Its APQC children that are bounded occurrents (16464, 16465, 16466, 16467, 16468, 16469, 19595, 19596) are the acts in which it is realized -- not process parts, since a capability is not a process. bpo:RegulatoryComplianceManagementCapability is a specialization of bpo:ComplianceManagementCapability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16464 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16465 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16466 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16467 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16468 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P16469 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19595 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19596 ],
        bpot:ComplianceManagementCapability,
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an organization in virtue of its capacity to obey the laws, guidelines, strategies, and stipulations applicable to its business, realized in acts of developing procedures, identifying requirements, monitoring the regulatory environment, assessing and testing its compliance position, implementing controls, and reporting on compliance." .

bpot:RegulatoryEnvironmentAnalysis a owl:Class ;
    rdfs:label "Regulatory Environment Analysis" ;
    rdfs:comment "Output of 11.2.2.3 (monitor the regulatory environment), produced by bpo:ActOfMonitoring (inlined above)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an examination of the regulatory environment to spot changing or emerging regulations relevant to an organization." .

bpot:RemediationManagementCapability a owl:Class ;
    rdfs:label "Remediation Management Capability" ;
    rdfs:comment "Models the standing function of 11.3 'Manage remediation efforts' (R5/R6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11201 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11202 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11203 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11204 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11205 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P11206 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of planning, resourcing, investigating, and policy-making for the remediation of environmental adulteration." ;
    bpot:apqcSourceText "Administering the efforts and activities for remediation. This process element requires the organization to create plans for corrective action in collaboration with government agencies and pertinent professional services agencies which specialize in remediation efforts relevant to the organization's operations. Additionally, the organization needs to consult experts to validate the plan, determine resources allocation, resolve any legal concerns, and formulate a company-wide policy for remediation." ;
    bpot:hierarchyID "11.3" ;
    bpot:pcfID "11185" .

bpot:RemediationPlan rdfs:comment "Output of 11.3.1 (create remediation plans), produced by bpo:ActOfFormulation (reused from ext). Directive: a plan prescribes intended corrective acts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ContaminatedMaterial ] ;
    skos:definition "A Directive Information Content Entity, about a case of contamination, that prescribes the corrective actions for identifying and treating environmental adulteration so that an affected area becomes operational again." .

bpot:RemediationPolicy a owl:Class ;
    rdfs:label "Remediation Policy" ;
    rdfs:comment "Output of 11.3.6 (amend or create policy), produced by bpo:ActOfFormulation (reused from ext)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a company-wide framework of policies and procedures for deploying remediation efforts, adapted to applicable national and international regulatory frameworks." .

bpot:ResourceRequirementsAssessment a owl:Class ;
    rdfs:label "Resource Requirements Assessment" ;
    rdfs:comment "Output of 11.3.3 (identify/dedicate resources). The actual dedication of resources is a directive/planning act; this ICE is the descriptive identification step." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the resources discerned to be needed for managing remediation efforts and the rationale for their dedication." .

bpot:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "bpo:Risk is the REALITY-LAYER risk disposition (BFO Realizable Entity, obo:BFO_0000017): the standing possibility of an adverse outcome borne by some entity -- NOT a process and NOT an information artifact. CAUTION for contributors: information artifacts ABOUT risks are modeled separately as ICEs -- bpo:RiskRegister, bpo:RiskAssessment, bpo:RiskAnalysisReport, etc. (each cco:ont00000853 Descriptive ICE, 'is about' some bpo:Risk). Do NOT use bpo:Risk as an ICE / has-output filler; use the corresponding artifact class." ;
    rdfs:subClassOf obo:BFO_0000017 ;
    skos:definition "A Realizable Entity that is the disposition of some entity to give rise, under specified conditions, to an adverse or uncertain consequence for an organization's objectives." .

bpot:RiskAnalysisReport a owl:Class ;
    rdfs:label "Risk Analysis Report" ;
    rdfs:comment "Output of 11.1.3.6 (analyze risk activities and update plans)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an examination of the impact of risk activities, including the potential for adverse consequences and the methods available to manage them." .

bpot:RiskManagerRole a owl:Class ;
    rdfs:label "Risk Manager Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with identifying, assessing, mitigating, monitoring, and reporting risk on behalf of an organization or business unit." .

bpot:RiskMitigationVerificationReport a owl:Class ;
    rdfs:label "Risk Mitigation Verification Report" ;
    rdfs:comment "Output of 11.1.2.4 (verify mitigation plans are implemented), produced by bpo:ActOfVerification (inlined above). Gate-F mint: a dedicated one-shot conformance-finding ICE, separating verification findings from the continuous-monitoring bpo:RiskMonitoringReport (a false friend) so that genus (Verification) and output ICE share semantic traceability. Both are Descriptive (cco:ont00000853)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the finding of a bounded check of whether business-unit and functional risk mitigation plans have been correctly implemented." .

bpot:RiskTolerance a owl:Class ;
    rdfs:label "Risk Tolerance Statement" ;
    rdfs:comment "Output of 11.1.1.1 (determine risk tolerance). Directive: it prescribes acceptable-risk thresholds that govern downstream decisions." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the level of risk an organization is willing to accept, given risk-return trade-offs for anticipated and predictable consequences." .

bpot:SubjectMatterExpertRole a owl:Class ;
    rdfs:label "Subject Matter Expert Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of possessing specialized expertise solicited to advise on and validate remediation plans." .

bpot:ComplianceManagementCapability a owl:Class ;
    rdfs:label "Compliance Management Capability" ;
    rdfs:comment "Models the standing function of 11.2 'Manage compliance' (R5/R6). Its regulatory-compliance facet is further specialized by bpo:RegulatoryComplianceManagementCapability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P17468 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of establishing compliance frameworks and policies and of managing enduring compliance with industry regulations and government legislation." .

bpot:EnterpriseRiskReport a owl:Class ;
    rdfs:label "Enterprise Risk Report" ;
    rdfs:comment "Shared reporting output across 11.1.1.5, 11.1.2.6, and 11.1.3.7. Descriptive (it represents the state of risk), produced by Act of Reporting." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes hazard, financial, and operational risks and risk-management activities for presentation to executive management and the board." .

bpot:P11201 a owl:Class ;
    rdfs:label "Create remediation plans" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (subClassOf cco:ont00000511 Act of Planning): the act makes a plan, so its definitional output is a Directive ICE (bpo:RemediationPlan)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RemediationPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a remediation plan prescribing the corrective actions needed to treat adulteration or damage and restore an affected area to operation." ;
    skos:example "An environmental team drafts a remediation plan for a contaminated site so it can return to operational status." ;
    bpot:apqcSourceText "Creating plans for remediation efforts. Make a plan to address a case of environmental adulteration. Identify and treat the adulteration so that the area will become operational again." ;
    bpot:hierarchyID "11.3.1" ;
    bpot:pcfID "11201" .

bpot:P11202 a owl:Class ;
    rdfs:label "Contact and confer with experts" ;
    rdfs:comment "Gate-F reconciliation: anchored under cco:ont00000379 (Act of Representative Communication, a truth-committed conveyance; subClassOf cco:ont00000402 Act of Communication), with cco:ont00000228 (Planned Act) co-asserted for the standalone S2 act anchor (379 is outside the allowlist {366,636,511,228}). The act's defining axioms -- bpo:SubjectMatterExpert as the has-sender (cco:ont00001844) and bpo:ExpertAdvice (a Descriptive ICE) as the conveyed has-output -- describe the SME->organization advice transfer, which is a representative communication. Previously modeled as cco:ont00000133 (Act of Directive Communication) on the 'soliciting' reading; but that genus casts the soliciting organization as sender and the SME as hearer, contradicting the asserted SME-as-sender axiom, so the genus was reconciled to 379. The earlier rejection of bpo:ActOfAcquisition still stands: obtaining advice by conferral is communication, not procurement (cco:ont00000228-scoped acquisition of an authorization/license/resource). bpo:SubjectMatterExpert is also a definitional participant (obo:BFO_0000057)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ExpertAdvice ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001844 ;
            owl:someValuesFrom bpot:SubjectMatterExpert ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:SubjectMatterExpert ],
        cco:ont00000228,
        cco:ont00000379 ;
    skos:definition "An Act of Representative Communication in which subject matter experts, conferred with by the organization, convey their expert advice -- committing to its truth -- so that their suggestions can be incorporated into remediation planning." ;
    skos:example "A remediation lead convenes subject matter experts and captures their advice to refine the remediation plan." ;
    bpot:apqcSourceText "Discussing and soliciting advice from experts for in order to incorporate their suggestion (regarding Create remediation plans [11201])." ;
    bpot:hierarchyID "11.3.2" ;
    bpot:pcfID "11202" .

bpot:P11203 a owl:Class ;
    rdfs:label "Identify/dedicate resources" ;
    rdfs:comment "Gate-F fix (false-friend genus + GOLDEN PRINCIPLE / sibling consistency): RE-ANCHORED from cco:ont00000636 (Act of Appraisal) to bpo:ActOfIdentification (subClassOf cco:ont00000366 Act of Information Processing). Rejected cco:ont00000636: verified in the pinned CCO file, Act of Appraisal is 'An Act of Measuring that involves evaluating, assessing, estimating, or judging the nature, VALUE, importance, condition, or QUALITY of something' (e.g. a critic rating a restaurant). The source text is NOT a value/quality judgement on a scale; it is discernment/enumeration ('DISCERN the resources NEEDED for remediation efforts'). 'Judge what resources are needed' is a surface-word false friend for 'judge the value/quality of resources'. This also matches the sibling 'Identify enterprise level risks' (P16446), an identical 'identify/discern X needed' act anchored at bpo:ActOfIdentification. Output remains the Descriptive ICE bpo:ResourceRequirementsAssessment, so the GOLDEN PRINCIPLE (Information-Processing/discernment -> Descriptive) still holds. The downstream allocation/dedication of resources is operational and non-definitional, so it is not promoted to a restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ResourceRequirementsAssessment ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the resources needed for managing remediation efforts and produces a resource requirements assessment to guide their dedication." ;
    skos:example "A remediation manager discerns staffing, equipment, and funding needs and records a resource requirements assessment." ;
    bpot:apqcSourceText "Identifying and dedicating the resources for managing remediation efforts. Discern the resources needed for remediation efforts. Dispense with resources in a sound and well-reasoned manner." ;
    bpot:hierarchyID "11.3.3" ;
    bpot:pcfID "11203" .

bpot:P11204 a owl:Class ;
    rdfs:label "Investigate legal aspects" ;
    rdfs:comment "Anchored to bpo:ActOfInvestigation (subClassOf cco:ont00000366 Act of Information Processing): the act examines input regulatory-requirement ICEs and yields a Descriptive ICE (bpo:LegalAnalysis). bpo:RegulatoryRequirement is definitional as input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RegulatoryRequirement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:LegalAnalysis ],
        bpot:ActOfInvestigation ;
    skos:definition "An Act of Investigation that examines the regulatory and legislative frameworks bearing on remediation and produces a legal analysis of the organization's obligations and the accuracy of applicable rules and procedures." ;
    skos:example "Counsel reviews environmental statutes and international covenants and issues a legal analysis of remediation liabilities." ;
    bpot:apqcSourceText "Examining regulatory and legislative frameworks. Obligate the organization to remediate any damages through compensations, fines, and any other remedial efforts necessitated to correct the situations. Analyze local environmental laws, binding international covenants, etc. in order to examine legal accuracy about the rules and procedures." ;
    bpot:hierarchyID "11.3.4" ;
    bpot:pcfID "11204" .

bpot:P11205 a owl:Class ;
    rdfs:label "Investigate damage cause" ;
    rdfs:comment "Anchored to bpo:ActOfInvestigation (subClassOf cco:ont00000366 Act of Information Processing): the act examines evidence of damage and yields a Descriptive ICE (bpo:DamageCauseAnalysis)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DamageCauseAnalysis ],
        bpot:ActOfInvestigation ;
    skos:definition "An Act of Investigation that studies the environmental, physical, or social causes of damage and produces a damage cause analysis that can inform better policies and regulations." ;
    skos:example "Investigators study a contamination incident and document the chain of causes that led to the damage." ;
    bpot:apqcSourceText "Studying the causes of damage, which could be environmental, physical, social, etc. at country level in order to institute better policies and regulations." ;
    bpot:hierarchyID "11.3.5" ;
    bpot:pcfID "11205" .

bpot:P11206 a owl:Class ;
    rdfs:label "Amend or create policy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (subClassOf cco:ont00000511 Act of Planning): crafting/amending a policy-and-procedure framework yields a Directive ICE (bpo:RemediationPolicy)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RemediationPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that crafts a new framework of remediation policies and procedures, or revises an existing one, to align with applicable national and international regulatory frameworks." ;
    skos:example "A policy team revises the company-wide remediation policy to reflect new international environmental covenants." ;
    bpot:apqcSourceText "Crafting a new framework of policies and procedures for deploying remediation efforts, or change existing policies and procedures. Adapt the policy structure to the context of the apposite national and international regulatory frameworks." ;
    bpot:hierarchyID "11.3.6" ;
    bpot:pcfID "11206" .

bpot:P11221 a owl:Class ;
    rdfs:label "Develop the business resilience strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning): its definitional output is a Directive ICE (a strategy), per the GOLDEN PRINCIPLE. Models APQC 11.4.1 as an occurrent, not the strategy artifact (bpo:BusinessResilienceStrategy) nor a standing function." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessResilienceStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and articulates a business resilience strategy prescribing how an organization rapidly adapts to disturbances while maintaining continuous operations and protecting employees, assets, and brand equity." ;
    skos:example "A resilience team drafts the enterprise's business resilience strategy for the coming planning cycle." ;
    bpot:apqcSourceText "Creating a strategy for rapidly adapting to disturbances. Maintain continuous business processes and protecting employees, assets, and overall brand equity." ;
    bpot:hierarchyID "11.4.1" ;
    bpot:pcfID "11221" .

bpot:P11222 a owl:Class ;
    rdfs:label "Perform continuous business operations planning" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning): the definitional output is a Directive ICE (a continuity plan), per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessContinuityPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and articulates a business continuity plan prescribing the measures required to ensure continuous business operations." ;
    skos:example "A continuity planner produces the business continuity plan for the firm's critical processes." ;
    bpot:apqcSourceText "Developing plans to ensure continuous business operations." ;
    bpot:hierarchyID "11.4.2" ;
    bpot:pcfID "11222" .

bpot:P11223 a owl:Class ;
    rdfs:label "Test continuous business operations" ;
    rdfs:comment "Anchored to bpo:ActOfVerification (inlined; Act of Appraisal cco:ont00000636; also information-processing in character): testing exercises operations against a standard and yields a Descriptive ICE (a test result), per the GOLDEN PRINCIPLE. The business continuity plan is a typical (not definitional) input, so it is noted here rather than promoted to a restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ContinuityTestResult ],
        bpot:ActOfVerification ;
    skos:definition "An Act of Verification that exercises the organization's ongoing, non-stop activities against the business continuity plan and produces a continuity test result recording whether those operations perform as intended." ;
    skos:example "A resilience team runs a failover drill and records the continuity test result." ;
    bpot:apqcSourceText "Assessing ongoing activities within the organization that are not intended to stop except for in an emergency." ;
    bpot:hierarchyID "11.4.3" ;
    bpot:pcfID "11223" .

bpot:P11224 a owl:Class ;
    rdfs:label "Maintain continuous business operations" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): despite the APQC label 'Maintain', the Element Description is evaluative ('Evaluating ... Determine which activities ... perform best'), so the definitional output is a Descriptive ICE (an evaluation/judgement), per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessOperationsEvaluation ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates ongoing business operations to judge which activities generate revenue, perform best, and provide good returns, and produces a business operations evaluation." ;
    skos:example "An operations analyst evaluates ongoing activities and issues a business operations evaluation ranking them by return." ;
    bpot:apqcSourceText "Evaluating business operations. Determine which activities generate revenues, perform best, and provide good returns." ;
    bpot:hierarchyID "11.4.4" ;
    bpot:pcfID "11224" .

bpot:P16439 a owl:Class ;
    rdfs:label "Establish the enterprise risk framework and policies" ;
    rdfs:comment "Genus Act of Formulation (Planning): its definitional output is a Directive ICE (the enterprise risk policy/framework)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnterpriseRiskPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16440 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16441 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16442 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16443 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16444 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the enterprise-risk rules and regulations governing hazard, financial, operational, and strategic risks and produces enterprise risk policies and procedures." ;
    skos:example "A risk committee drafting the firm's enterprise risk policy framework for the coming year." ;
    bpot:apqcSourceText "Creating an agenda for the rules and regulations of enterprise risk that deal with hazardous, financial, operational, and strategic risks." ;
    bpot:hierarchyID "11.1.1" ;
    bpot:pcfID "16439" .

bpot:P16440 a owl:Class ;
    rdfs:label "Determine risk tolerance for organization" ;
    rdfs:comment "Genus Act of Formulation: the output is a Directive ICE (a prescriptive tolerance threshold to be observed), not a mere description, per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskTolerance ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes the organization's tolerance for risk in light of risk-return trade-offs and produces a risk tolerance statement." ;
    skos:example "A board setting the maximum acceptable annual value-at-risk for the enterprise." ;
    bpot:apqcSourceText "Recognizing the organization's tolerance for risk, given risk-return trade-offs for one or more anticipated and predictable consequences." ;
    bpot:hierarchyID "11.1.1.1" ;
    bpot:pcfID "16440" .

bpot:P16441 a owl:Class ;
    rdfs:label "Develop and maintain enterprise risk policies and procedures" ;
    rdfs:comment "Genus Act of Formulation: definitional output is a Directive ICE (the enterprise risk policy and procedure)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnterpriseRiskPolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and maintains the policies and procedures for managing hazard, financial, operational, and strategic risk and produces enterprise risk policies and procedures." ;
    skos:example "A risk team updating the corporate risk policy manual after a regulatory change." ;
    bpot:apqcSourceText "Establishing and maintaining the policies and procedures for managing risk. Create rules and regulations for enterprise risk dealing with hazardous, financial, operational, and strategic risks." ;
    bpot:hierarchyID "11.1.1.2" ;
    bpot:pcfID "16441" .

bpot:P16442 a owl:Class ;
    rdfs:label "Identify and implement enterprise risk management tools" ;
    rdfs:comment "Genus Act of Selection (Info Processing): a candidate set of ERM tools is narrowed to a chosen, specified set; output is a Directive ICE (the tool specification). Implementation/application of the selected tools is a downstream concern, captured as a comment rather than a separate definitional output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnterpriseRiskTool ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses enterprise risk management tools from available candidates and produces an enterprise risk management tool specification for their application." ;
    skos:example "Selecting and configuring a GRC platform and a Monte-Carlo risk-modeling tool as the firm's standard ERM toolset." ;
    bpot:apqcSourceText "Recognizing and implementing tools for managing risk. Identify and apply enterprise risk management tools. Leverage methods and processes to manage risks and opportunities associated with business objectives." ;
    bpot:hierarchyID "11.1.1.3" ;
    bpot:pcfID "16442" .

bpot:P16443 a owl:Class ;
    rdfs:label "Coordinate the sharing of risk knowledge across the organization" ;
    rdfs:comment "Genus reuses cco:ont00000151 (Act of Reporting, an Act of Representative Communication): the act gives a detailed account of risk to organizational audiences. Output is a Descriptive ICE (risk knowledge). Gate-F cross-reference: its parallel 'share risk knowledge' row P16471 (11.4.5) was reconciled to this SAME genus (cco:ont00000151) and to this SAME output-only I/O pattern, removing the prior 402-vs-151 split between the two rows." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskKnowledge ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that communicates risk knowledge throughout the organization and produces and disseminates shared risk knowledge." ;
    skos:example "A risk manager circulating an operational-risk briefing to all business-unit heads." ;
    bpot:apqcSourceText "Communicating the knowledge about risk within the organization. Identify operational risks. Share risk information within the organization." ;
    bpot:hierarchyID "11.1.1.4" ;
    bpot:pcfID "16443" .

bpot:P16444 a owl:Class ;
    rdfs:label "Prepare and report enterprise risk to executive management and board" ;
    rdfs:comment "Genus reuses cco:ont00000151 (Act of Reporting). Output is a Descriptive ICE (the enterprise risk report). Executive management and the board are the report audience (typical participants, not definitional fillers)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnterpriseRiskReport ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that prepares and presents an account of enterprise hazard, financial, and operational risks to executive management and the board and produces an enterprise risk report." ;
    skos:example "The CRO presenting the quarterly enterprise risk report to the audit committee." ;
    bpot:apqcSourceText "Preparing and presenting reports about enterprise risk to the management of the organization. Create reports for management on hazard risks (e.g., property damage and liability torts), financial risks (e.g., currency and liquidity risks), and operational risks (e.g., product failure, customer satisfaction, social trends, and competition)." ;
    bpot:hierarchyID "11.1.1.5" ;
    bpot:pcfID "16444" .

bpot:P16445 a owl:Class ;
    rdfs:label "Oversee and coordinate enterprise risk management activities" ;
    rdfs:comment "R5: modeled as a bounded coordinating/oversight occurrent (a management cycle), distinct from the org-wide standing capability 17060. Anchored at cco:ont00000228 (Planned Act) because it spans planning, organizing, and controlling rather than a single act kind. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16446 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16447 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16448 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16449 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16450 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16451 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16452 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16453 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16454 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that coordinates the planning, organizing, leading, and controlling of an organization's risk-management activities in order to minimize the effects of risk on capital and earnings." ;
    skos:example "An enterprise-risk steering cycle that runs identify, assess, mitigate, verify, monitor, and report across the year." ;
    bpot:apqcSourceText "Coordinating to plan, organize, lead, and control the activities of an organization in order to minimize the special effects of risk on capital and earnings." ;
    bpot:hierarchyID "11.1.2" ;
    bpot:pcfID "16445" .

bpot:P16446 a owl:Class ;
    rdfs:label "Identify enterprise level risks" ;
    rdfs:comment "Genus Act of Identification (discernment sense): output is a Descriptive ICE (the risk register)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the enterprise-level risks that could thwart organizational objectives and produces a risk register documenting them." ;
    skos:example "A workshop enumerating strategic and operational risks into the corporate risk register." ;
    bpot:apqcSourceText "Determining risks that could thwart objectives. Document and communicate the concern." ;
    bpot:hierarchyID "11.1.2.1" ;
    bpot:pcfID "16446" .

bpot:P16447 a owl:Class ;
    rdfs:label "Assess risks to determine which to mitigate" ;
    rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): it evaluates/judges risks. Output is a Descriptive ICE (the risk assessment), so genus and output kind agree (GOLDEN PRINCIPLE). Gate-F fix: the risk register is a TYPICAL input, not definitional -- a risk assessment can be performed without a pre-existing formal register (the register may itself be assembled in the same act), so per the Phase-3 existential-necessity rule the prior `has input some bpo:RiskRegister` restriction was REMOVED and demoted to this annotation (CQ target: 'which risk register, if any, did this assessment consume?')." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates identified risks and their root causes to judge which to mitigate and produces a risk assessment." ;
    skos:example "Scoring each registered risk by likelihood and impact to prioritize mitigation." ;
    bpot:apqcSourceText "Identifying options/actions to enhance opportunities and reduce threats. Recognize the root reasons of the identified risks." ;
    bpot:hierarchyID "11.1.2.2" ;
    bpot:pcfID "16447" .

bpot:P16448 a owl:Class ;
    rdfs:label "Develop risk mitigation and management strategy and integrate with existing performance management processes" ;
    rdfs:comment "Genus Act of Formulation (Planning): definitional output is a Directive ICE (the risk mitigation and management strategy)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskMitigationStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes activities, strategies, and policies to enhance opportunities and lessen threats and produces a risk mitigation and management strategy." ;
    skos:example "Drafting a hedging-and-controls strategy and integrating it into the annual performance plan." ;
    bpot:apqcSourceText "Developing activities to improve opportunities and lessen threats. Specify the organization's objectives. Evolve strategies and policies to attain these objectives. Assign resources to project objectives." ;
    bpot:hierarchyID "11.1.2.3" ;
    bpot:pcfID "16448" .

bpot:P16449 a owl:Class ;
    rdfs:label "Verify business unit and functional risk mitigation plans are implemented" ;
    rdfs:comment "Genus bpo:ActOfVerification (inlined; Act of Appraisal cco:ont00000636; also information-processing in character): confirming conformance of implementation to the plan; output is a Descriptive ICE (the verification finding). Gate-F fix (1): the `has input some bpo:RiskMitigationPlan` restriction was REMOVED -- per the Phase-3 existential-necessity rule the mitigation plan is a TYPICAL input (it is the conformance reference, but the comment formerly labeled it 'typical' while encoding it existentially), so it is demoted to this annotation. Gate-F fix (2): the output was changed from the FALSE-FRIEND bpo:RiskMonitoringReport (a continuous-monitoring time-series artifact) to the dedicated one-shot conformance ICE bpo:RiskMitigationVerificationReport, restoring genus/output semantic traceability (both Descriptive)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskMitigationVerificationReport ],
        bpot:ActOfVerification ;
    skos:definition "An Act of Verification that checks whether business-unit and functional risk mitigation plans have been correctly implemented and produces a risk mitigation verification report recording the conformance finding." ;
    skos:example "Auditing a division to confirm its mitigation controls are in place and operating." ;
    bpot:apqcSourceText "Checking that the blueprint created for managing risk in individual business units and divisions is correctly effectuated. Validate the implementation of all activities geared to mitigate risks." ;
    bpot:hierarchyID "11.1.2.4" ;
    bpot:pcfID "16449" .

bpot:P16450 a owl:Class ;
    rdfs:label "Ensure risks and risk mitigation actions are monitored" ;
    rdfs:comment "Genus bpo:ActOfMonitoring (under Info Processing): ongoing observation/tracking of risks and actions; output is a Descriptive ICE (the risk monitoring report)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskMonitoringReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that tracks risks and risk-mitigation actions over time and produces a risk monitoring report." ;
    skos:example "A dashboard tracking key risk indicators and the status of open mitigation actions each month." ;
    bpot:apqcSourceText "Ensuring risk monitoring and mitigation activities. Monitor actions to enhance opportunities and reduce threats to project objectives." ;
    bpot:hierarchyID "11.1.2.5" ;
    bpot:pcfID "16450" .

bpot:P16451 a owl:Class ;
    rdfs:label "Report on enterprise risk activities" ;
    rdfs:comment "Genus reuses cco:ont00000151 (Act of Reporting). Output is a Descriptive ICE (the enterprise risk report)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EnterpriseRiskReport ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that gives a detailed account of the activities undertaken to address enterprise hazard, financial, and operational risks and produces an enterprise risk report." ;
    skos:example "Compiling the period's risk-treatment activities into a report for governance." ;
    bpot:apqcSourceText "Creating a report of activities to address hazard risks, liability torts, financial risks, operational risks, social trends, competition, etc." ;
    bpot:hierarchyID "11.1.2.6" ;
    bpot:pcfID "16451" .

bpot:P16452 a owl:Class ;
    rdfs:label "Coordinate business unit and functional risk management activities" ;
    rdfs:comment "Anchored at cco:ont00000228 (Planned Act): a coordinating/organizing act with no single dominant ICE output. The mitigation strategy is a typical input governing the coordination." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskMitigationStrategy ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that coordinates the risk-management activities of business units and functions, specifying objectives and assigning resources to improve opportunities and lessen threats." ;
    skos:example "Aligning each division's risk plan and assigning shared resources across the enterprise program." ;
    bpot:apqcSourceText "Coordinating risk management activities to improve opportunities and lessen threats. Specify the organization's objectives. Assign resources to project objectives." ;
    bpot:hierarchyID "11.1.2.7" ;
    bpot:pcfID "16452" .

bpot:P16453 a owl:Class ;
    rdfs:label "Ensure that each business unit/function follows the enterprise risk management process" ;
    rdfs:comment "Genus bpo:ActOfVerification (inlined; Act of Appraisal cco:ont00000636; also information-processing in character): confirming process conformance; output is a Descriptive ICE. Gate-F fix (1): the `has input some bpo:EnterpriseRiskPolicy` restriction was REMOVED -- the source text ('checking each business unit's/function's options and activities') does not establish the policy as present for EVERY instance, so per the Phase-3 existential-necessity rule it is demoted to this annotation as the typical conformance reference. Gate-F fix (2): the output was changed from the FALSE-FRIEND bpo:RiskMonitoringReport (a time-series monitoring artifact) to the dedicated bpo:ERMProcessConformanceReport, restoring genus/output traceability (both Descriptive)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ERMProcessConformanceReport ],
        bpot:ActOfVerification ;
    skos:definition "An Act of Verification that checks whether each business unit and function follows the enterprise risk management process and produces an ERM process conformance report." ;
    skos:example "Reviewing a division against the ERM process checklist." ;
    bpot:apqcSourceText "Checking each business unit's/function's options and activities to improve opportunities and lessen threats." ;
    bpot:hierarchyID "11.1.2.8" ;
    bpot:pcfID "16453" .

bpot:P16454 a owl:Class ;
    rdfs:label "Ensure that each business unit/function follows the enterprise risk reporting process" ;
    rdfs:comment "Genus bpo:ActOfVerification (inlined; Act of Appraisal cco:ont00000636; also information-processing in character): confirming conformance of the reporting process; output is a Descriptive ICE. Sibling of P16453. Gate-F fix (1): the `has input some bpo:EnterpriseRiskPolicy` restriction was REMOVED -- the source text ('checking the reporting process ...') does not establish the policy as present for EVERY instance, so per the Phase-3 existential-necessity rule it is demoted to this annotation as the typical conformance reference. Gate-F fix (2): the output was changed from the FALSE-FRIEND bpo:RiskMonitoringReport (a time-series monitoring artifact) to the dedicated bpo:ERMReportingConformanceReport, restoring genus/output traceability (both Descriptive)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ERMReportingConformanceReport ],
        bpot:ActOfVerification ;
    skos:definition "An Act of Verification that checks whether each business unit and function follows the enterprise risk reporting process and produces an ERM reporting conformance report." ;
    skos:example "Confirming each unit submits its risk report on the prescribed cadence and template." ;
    bpot:apqcSourceText "Checking the reporting process of each business unit's/function's options and activities to improve opportunities and lessen threats." ;
    bpot:hierarchyID "11.1.2.9" ;
    bpot:pcfID "16454" .

bpot:P16456 a owl:Class ;
    rdfs:label "Identify risks" ;
    rdfs:comment "Genus Act of Identification (discernment sense): output is a Descriptive ICE (the risk register)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the risks and activities that might hinder a business unit's goals and produces a risk register documenting them." ;
    skos:example "A project team listing the events that could delay delivery into its risk register." ;
    bpot:apqcSourceText "Developing a timely and continuous process to identify activities that might hinder a project's goals." ;
    bpot:hierarchyID "11.1.3.1" ;
    bpot:pcfID "16456" .

bpot:P16457 a owl:Class ;
    rdfs:label "Assess risks using enterprise risk framework policies and procedures" ;
    rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): it evaluates/judges the likelihood of adverse events. Output is a Descriptive ICE (the risk assessment). The enterprise risk policy/framework is DEFINITIONAL input (the source text fixes the assessment to the 'established tools, implements, and frameworks'), so it remains an existential `has input` restriction. Gate-F fix: the risk register is only a TYPICAL input (the comment formerly self-contradictingly encoded it as someValuesFrom while labeling it 'typical'); per the Phase-3 existential-necessity rule the `has input some bpo:RiskRegister` restriction was REMOVED and demoted to this annotation (CQ target: 'which risk register did this assessment draw on?')." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:EnterpriseRiskPolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that estimates the likelihood of specified undesirable events using the established enterprise risk framework, policies, and procedures and produces a risk assessment." ;
    skos:example "Using the corporate risk-scoring framework to rate a proposed venture's exposure." ;
    bpot:apqcSourceText "Determining the possibility that a specified undesirable event will occur using established tools, implements, and frameworks. Use risk assessments to determine, for example, whether to undertake a particular venture, what rate of return a particular investment requires, and how to mitigate an activity's potential losses." ;
    bpot:hierarchyID "11.1.3.2" ;
    bpot:pcfID "16457" .

bpot:P16458 a owl:Class ;
    rdfs:label "Develop mitigation plans for risks" ;
    rdfs:comment "Genus Act of Formulation (Planning): definitional output is a Directive ICE (the risk mitigation plan). Has its assess-insurance-coverage task as a process part." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskMitigationPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P18129 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that devises arrangements to improve opportunities and reduce deviations to objectives and produces a risk mitigation plan." ;
    skos:example "Drafting a mitigation plan with controls, owners, and contingency arrangements for the top risks." ;
    bpot:apqcSourceText "Developing possibilities and arrangements to improve opportunities and reduce deviations to project objectives." ;
    bpot:hierarchyID "11.1.3.3" ;
    bpot:pcfID "16458" .

bpot:P16459 a owl:Class ;
    rdfs:label "Implement mitigation plans for risks" ;
    rdfs:comment "Anchored at cco:ont00000228 (Planned Act): an execution act prescribed by the mitigation plan; it has no definitional ICE output of its own. The risk mitigation plan is a definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskMitigationPlan ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that executes a risk mitigation plan to improve opportunities and reduce deviations to objectives." ;
    skos:example "Standing up the controls and contingency arrangements specified in the approved mitigation plan." ;
    bpot:apqcSourceText "Executing mitigation plans to improve opportunities and reduce deviations to project objectives." ;
    bpot:hierarchyID "11.1.3.4" ;
    bpot:pcfID "16459" .

bpot:P16460 a owl:Class ;
    rdfs:label "Monitor risks" ;
    rdfs:comment "Genus bpo:ActOfMonitoring (under Info Processing): ongoing observation of risks; output is a Descriptive ICE (the risk monitoring report)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskMonitoringReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that tracks and examines a business unit's risks over time and produces a risk monitoring report." ;
    skos:example "Watching key risk indicators on a recurring basis and flagging breaches." ;
    bpot:apqcSourceText "Identifying, examining, and recognizing/justifying any improbability in investment decision making." ;
    bpot:hierarchyID "11.1.3.5" ;
    bpot:pcfID "16460" .

bpot:P16461 a owl:Class ;
    rdfs:label "Analyze risk activities and update plans" ;
    rdfs:comment "Genus Act of Analysis (Info Processing): its definitional output is a Descriptive ICE (the risk analysis report). The revised risk mitigation plan is a typical further output (a Directive ICE), recorded in comment rather than as a definitional restriction. Has the risk monitoring report as a typical input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RiskMonitoringReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskAnalysisReport ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the impact of risk activities and the potential for adverse consequences and produces a risk analysis report used to update the risk mitigation plan." ;
    skos:example "Reviewing the period's incidents and revising the mitigation plan accordingly." ;
    bpot:apqcSourceText "Examining the impact of risk activities in order to update the existing scheme of risk management. Analyze and substantiate the potential for adverse consequences to occur. Consider the risks associated with the activity and the methods available to manage those risks." ;
    bpot:hierarchyID "11.1.3.6" ;
    bpot:pcfID "16461" .

bpot:P16462 a owl:Class ;
    rdfs:label "Report on risk activities" ;
    rdfs:comment "Genus reuses cco:ont00000151 (Act of Reporting). Output is a Descriptive ICE (the risk monitoring report)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskMonitoringReport ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that gives a detailed account of a business unit's risk activities and communicates it to management, producing a risk monitoring report." ;
    skos:example "Submitting the unit's monthly risk-status report to the program lead." ;
    bpot:apqcSourceText "Creating reports on risk activities, and communicating them to management. Prepare reports on the potential for adverse safety consequences." ;
    bpot:hierarchyID "11.1.3.7" ;
    bpot:pcfID "16462" .

bpot:P16464 a owl:Class ;
    rdfs:label "Develop regulatory compliance procedures" ;
    rdfs:comment "Output is a Directive ICE (bpo:CompliancePolicy), so anchored under bpo:ActOfFormulation (Act of Planning) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CompliancePolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes procedures and methodologies for complying with relevant laws and regulations, producing a compliance policy and procedure specification." ;
    skos:example "A compliance function documents the step-by-step procedures the firm follows to satisfy a new regulation." ;
    bpot:apqcSourceText "Developing procedures and methodologies to comply with relevant laws and regulations of an organization's obedience to laws, guidelines, strategies and stipulations related to business." ;
    bpot:hierarchyID "11.2.2.1" ;
    bpot:pcfID "16464" .

bpot:P16465 a owl:Class ;
    rdfs:label "Identify applicable regulatory requirements" ;
    rdfs:comment "Anchored under bpo:ActOfIdentification (Act of Information Processing): the act discerns/enumerates applicable requirements. Gate-F fix (GOLDEN PRINCIPLE / Phase-3): the prior `has output some bpo:RegulatoryRequirement` was WRONG -- bpo:RegulatoryRequirement is a DIRECTIVE ICE 'issued by a governing authority', and an information-processing/discernment act does not author that directive (the comment itself notes 'the requirements are not authored here'). The act's true definitional output is a DESCRIPTIVE determination of WHICH requirements apply (bpo:ApplicableRequirementsDetermination, subClassOf cco:ont00000853), which agrees with the ext ActOfIdentification definition ('produces an ICE that registers them') and the GOLDEN PRINCIPLE. The pre-existing body of regulation is the act's INPUT/subject (the candidate regulation it screens), now modeled as `has input some bpo:RegulatoryRequirement`." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RegulatoryRequirement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ApplicableRequirementsDetermination ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns which regulatory requirements apply to the organization and produces an applicable requirements determination registering them." ;
    skos:example "A compliance officer screens the legal landscape and registers which statutes and rules the organization must obey." ;
    bpot:apqcSourceText "Determining the regulatory requirements that are most appropriate for the organization. Identify goals in order to follow the appropriate rules and regulations, guidelines, and strategies." ;
    bpot:hierarchyID "11.2.2.2" ;
    bpot:pcfID "16465" .

bpot:P16466 a owl:Class ;
    rdfs:label "Monitor the regulatory environment for changing or emerging regulations" ;
    rdfs:comment "Anchored under bpo:ActOfMonitoring (inlined above). Output is a Descriptive ICE (bpo:RegulatoryEnvironmentAnalysis), satisfying the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RegulatoryEnvironmentAnalysis ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that repeatedly observes and analyzes the regulatory environment to detect new or changed statutes, policies, and enactments, producing a regulatory environment analysis." ;
    skos:example "A regulatory-affairs team continuously scans government bulletins and reports newly issued rules affecting the firm." ;
    bpot:apqcSourceText "Analyzing and overseeing the regulatory environment in order to spot any changing or emerging regulations. This process element calls upon the organization to monitor the regulatory environment for any new statutes, policies, and enactments issued by the respective government authorities or those which have been updated." ;
    bpot:hierarchyID "11.2.2.3" ;
    bpot:pcfID "16466" .

bpot:P16467 a owl:Class ;
    rdfs:label "Assess current compliance position and identify weaknesses or shortfalls therein" ;
    rdfs:comment "Anchored under cco:ont00000636 (Act of Appraisal): the act evaluates and judges performance. Output is a Descriptive ICE (bpo:ComplianceAssessment) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the organization's current compliance position against applicable regulations and judges its weaknesses and shortfalls, producing a compliance assessment." ;
    skos:example "An internal review judges where the firm falls short of its regulatory obligations and documents the gaps." ;
    bpot:apqcSourceText "Evaluating current regulatory policies and regulations. Assess their performance. Make necessary changes." ;
    bpot:hierarchyID "11.2.2.4" ;
    bpot:pcfID "16467" .

bpot:P16468 a owl:Class ;
    rdfs:label "Implement missing or stronger regulatory compliance controls and policies" ;
    rdfs:comment "Anchored directly under cco:ont00000228 (Planned Act): implementing controls is the carrying-out of prescribed controls, not the production of a new informational artifact, so it bears no definitional has-output restriction. The control and policy specifications it enacts (bpo:ComplianceControl, bpo:CompliancePolicy) are typical prescriptive inputs rather than definitional outputs." ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act that puts into effect missing or strengthened regulatory compliance controls and policies as required to close identified compliance gaps." ;
    skos:example "Following a gap assessment, the firm deploys an additional access-control policy to meet a regulatory requirement." ;
    bpot:apqcSourceText "Assessing the current policies and policies. Implement missing and necessary changes environmental changes, political changes, technological changes, etc." ;
    bpot:hierarchyID "11.2.2.5" ;
    bpot:pcfID "16468" .

bpot:P16469 a owl:Class ;
    rdfs:label "Monitor and test regulatory compliance position and existing controls" ;
    rdfs:comment "Anchored under bpo:ActOfVerification (inlined above): the act tests whether existing controls satisfy requirements. Output is a Descriptive ICE (bpo:ComplianceMonitoringReport) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceMonitoringReport ],
        bpot:ActOfVerification ;
    skos:definition "An Act of Verification that tests the robustness of the organization's compliance controls, frameworks, and procedures against regulatory requirements, producing a compliance monitoring report of their performance and any necessary changes." ;
    skos:example "An assurance team runs control tests and reports which compliance controls hold and which must be revised." ;
    bpot:apqcSourceText "Monitoring, appraising, and evaluating the compliance position of the organization in order to fine-tune for effective remediation. Track efforts for handling regulatory and compliance requirements necessitated by law. Test the robustness of internal frameworks, procedures, and approaches for dealing with these requirements, in order to clearly identify any necessary changes." ;
    bpot:hierarchyID "11.2.2.6" ;
    bpot:pcfID "16469" .

bpot:P16471 a owl:Class ;
    rdfs:label "Share knowledge of specific risks across other parts of the organization" ;
    rdfs:comment "Gate-F fix (sibling/parallel-row consistency): RE-ANCHORED from the generic cco:ont00000402 (Act of Communication) to cco:ont00000151 (Act of Reporting, an Act of Representative Communication) to match its semantically parallel 11.1 sibling P16443 (11.1.1.4 'Coordinate the sharing of risk knowledge', source 'Share risk information within the organization'), which is anchored at cco:ont00000151. Both rows describe an agent conveying bpo:RiskKnowledge across the organization; reconciling them to ONE genus removes the former split (402 vs 151). Also reconciled the I/O pattern: the former `has input some bpo:RiskKnowledge` restriction was DROPPED (a report 'gives an account', it does not consume the same ICE it emits), leaving the single Descriptive output bpo:RiskKnowledge to match P16443's output-only pattern. Cross-reference: P16443." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RiskKnowledge ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that gives other parts of the organization a detailed account of risk knowledge about business operations so that prospective risks can be avoided." ;
    skos:example "A risk manager circulates lessons learned about a near-miss disruption to other business units." ;
    bpot:apqcSourceText "Sharing information about risks and resilience strategies of business operations across the organization so that prospective risks can be avoided." ;
    bpot:hierarchyID "11.4.5" ;
    bpot:pcfID "16471" .

bpot:P17462 a owl:Class ;
    rdfs:label "Manage business unit and function risk" ;
    rdfs:comment "R5: although labeled 'Manage', the element description denotes a bounded analyze-and-prioritize cycle that decomposes into the concrete child acts 11.1.3.1-11.1.3.7; modeled as a composite Planned Act (cco:ont00000228) with those children as process parts, not as a standing capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16456 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16457 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16458 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16459 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16460 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16461 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16462 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that analyzes the threats faced by a business unit or function in order to prioritize and operate the controls it implements, comprising the identification, assessment, mitigation, monitoring, and reporting of that unit's risks." ;
    skos:example "A business unit running its annual risk-and-controls cycle." ;
    bpot:apqcSourceText "Analyzing the threats a business unit/function faces to prioritize the controls it implements.." ;
    bpot:hierarchyID "11.1.3" ;
    bpot:pcfID "17462" .

bpot:P17468 a owl:Class ;
    rdfs:label "Establish compliance framework and policies" ;
    rdfs:comment "Anchored under bpo:ActOfFormulation (Act of Planning) per the GOLDEN PRINCIPLE: 'establish a framework and policies' composes a Directive ICE. Its APQC children 17469 and 17470 are process parts (cco:ont00001777); standing-function children 14133 and 14137 are Organization Capabilities, not process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CompliancePolicy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17469 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P17470 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes and articulates an organization's compliance policies and procedures, producing a compliance policy and procedure specification." ;
    skos:example "A compliance team drafts the enterprise compliance policy-and-procedure set governing how the organization meets its legal obligations." ;
    bpot:apqcSourceText "Developing a set of procedures detailing an organization's progress in complying with established guidelines, provisions, and legislation." ;
    bpot:hierarchyID "11.2.1" ;
    bpot:pcfID "17468" .

bpot:P17469 a owl:Class ;
    rdfs:label "Develop enterprise compliance policies and procedures" ;
    rdfs:comment "Output is a Directive ICE (bpo:CompliancePolicy), so the act is anchored under bpo:ActOfFormulation (Act of Planning) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CompliancePolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a standardized, risk-focused approach to ethics and compliance, producing a compliance policy and procedure specification." ;
    skos:example "An organization authors its enterprise code of conduct and the procedures implementing it." ;
    bpot:apqcSourceText "Creating a standardized approach to ethics and compliance. Have a programmatic approach for compliance that focuses on the definite risks the organization faces." ;
    bpot:hierarchyID "11.2.1.1" ;
    bpot:pcfID "17469" .

bpot:P17470 a owl:Class ;
    rdfs:label "Implement enterprise compliance activities" ;
    rdfs:comment "Anchored directly under cco:ont00000228 (Planned Act): implementation is the carrying-out of an already-formulated program, not the production of a new informational artifact, so it bears no definitional has-output restriction. The compliance policy that governs it (bpo:CompliancePolicy) is a typical prescriptive input rather than a definitional one." ;
    rdfs:subClassOf cco:ont00000228 ;
    skos:definition "A Planned Act that carries out the organization's prescribed compliance program by executing the activities specified in its compliance policies and procedures." ;
    skos:example "Compliance staff roll out and operate the ethics-and-compliance program defined by the policy set." ;
    bpot:apqcSourceText "Implementing standardized for ethics and compliance. Have a programmatic approach, built from the top down, to enterprise compliance that focuses on the definite risks the organization faces." ;
    bpot:hierarchyID "11.2.1.2" ;
    bpot:pcfID "17470" .

bpot:P18129 a owl:Class ;
    rdfs:label "Assess adequacy of insurance coverage" ;
    rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): it judges the adequacy of coverage. Output is a Descriptive ICE (the insurance coverage assessment). Process part of 16458." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:InsuranceCoverageAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the organization's changing insurance-coverage needs against available providers and offerings and produces an insurance coverage assessment." ;
    skos:example "Comparing current policy limits to projected exposures and recommending added coverage." ;
    bpot:apqcSourceText "Evaluating the changing needs for insurance coverage. Research available insurance providers and offerings." ;
    bpot:hierarchyID "11.1.3.3.1" ;
    bpot:pcfID "18129" .

bpot:P19595 a owl:Class ;
    rdfs:label "Compile and communicate compliance scorecard(s)" ;
    rdfs:comment "Anchored under bpo:ActOfReporting (PROPOSE-EXT, compilation sense). Output is a Descriptive ICE (bpo:ComplianceScorecard) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceScorecard ],
        bpot:ActOfReporting ;
    skos:definition "An Act of Reporting that compiles compliance metrics into a graphical representation and conveys it to stakeholders, producing a compliance scorecard." ;
    skos:example "A compliance function publishes a red/amber/green dashboard summarizing the firm's compliance health." ;
    bpot:apqcSourceText "Creating a graphical representation of metrics in order to communicate the general health of the organization in relation to risk and compliancy." ;
    bpot:hierarchyID "11.2.2.7" ;
    bpot:pcfID "19595" .

bpot:P19596 a owl:Class ;
    rdfs:label "Compile and communicate internal and regulatory compliance reports" ;
    rdfs:comment "Gate-F fix (genus vs verbatim source / sibling consistency): RE-ANCHORED from bpo:ActOfReporting (PROPOSE-EXT, compilation sense) to cco:ont00000151 (Act of Reporting, an Act of Representative Communication). Verified cco:ont00000151: 'An Act of Representative Communication performed by giving a detailed account or statement' (subClassOf cco:ont00000379). Reason: although the LABEL says 'compile and communicate', the verbatim apqcSourceText describes ONLY 'Submitting compliance reports to regulatory agencies' -- the mere transfer of an already-existing report, which the bpo:ActOfReporting comment explicitly scopes OUT (it belongs to cco:ont00000151). This also reconciles with the 11.1 reporting siblings (P16443/P16444/P16451/P16462) deliberately anchored at cco:ont00000151. Consequently bpo:ComplianceReport is the TRANSFERRED ICE (`has input`, not has output -- the report pre-exists this submission act), and bpo:RegulatoryAuthority is the definitional recipient via cco:ont00001922 (verified 'has recipient', subPropertyOf BFO_0000057, domain Act of Communication). Rejected option (b) (split compile+submit into two acts) as over-modeling for a single PCF row whose source describes only submission. Compilation of the report is covered upstream (the scorecard/report-creation acts)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ComplianceReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001922 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that submits an already-compiled compliance report to internal stakeholders and regulatory agencies, giving them a detailed account of the organization's compliance status." ;
    skos:example "The firm files its periodic securities-compliance report with the relevant regulator." ;
    bpot:apqcSourceText "Submitting compliance reports to regulatory agencies. These reports can be made to environmental, securities, or human resources agencies as stipulated by the local governing body." ;
    bpot:hierarchyID "11.2.2.8" ;
    bpot:pcfID "19596" .

bpot:RiskKnowledge a owl:Class ;
    rdfs:label "Risk Knowledge" ;
    rdfs:comment "Shared informational payload of the reporting/communication acts in 11.1.1.4 (P16443, coordinate sharing of risk knowledge) and 11.4.5 (P16471, share knowledge of specific risks). Descriptive content; per the Gate-F reconciliation both acts are anchored at cco:ont00000151 (Act of Reporting, a Representative Communication) and emit this ICE as a has-output only (it is not consumed as an input)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes information about specific risks and resilience strategies, shared across an organization so prospective risks can be anticipated and avoided." .

bpot:RiskMitigationPlan a owl:Class ;
    rdfs:label "Risk Mitigation Plan" ;
    rdfs:comment "Output of 11.1.3.3 (develop mitigation plans); input to 11.1.3.4 (implement) and 11.1.2.4 (verify implementation). Directive: it prescribes mitigation actions." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the arrangements and activities for improving opportunities and reducing deviations to project objectives in response to identified risks." .

bpot:RiskMitigationStrategy a owl:Class ;
    rdfs:label "Risk Mitigation and Management Strategy" ;
    rdfs:comment "Output of 11.1.2.3 (develop risk mitigation and management strategy), produced by bpo:ActOfFormulation (reused from ext)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the organization's objectives, strategies, and policies for improving opportunities and lessening threats, integrated with existing performance-management processes." .

bpot:RiskRegister a owl:Class ;
    rdfs:label "Risk Register" ;
    rdfs:comment "Shared output of identification acts across 11.1 (11.1.2.1 identify enterprise-level risks, 11.1.3.1 identify risks) and input to assessment acts. Descriptive: it registers discerned risks rather than prescribing action." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that enumerates and describes the risks identified for an organization, business unit, or project, including their sources and potential consequences." .

bpot:SubjectMatterExpert a owl:Class ;
    rdfs:label "Subject Matter Expert" ;
    rdfs:comment "Definitional participant in 11.3.2 (contact and confer with experts)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:SubjectMatterExpertRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a subject-matter-expert role and is consulted to validate remediation plans." .

bpot:CompliancePolicy a owl:Class ;
    rdfs:label "Compliance Policy and Procedure" ;
    rdfs:comment "Shared output across 11.2.1.1 (enterprise compliance policies) and 11.2.2.1 (regulatory compliance procedures). Directive: prescribes compliance conduct." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an organization's standardized approach to ethics and compliance and the procedures for complying with applicable guidelines, provisions, and legislation." .

bpot:EnterpriseRiskPolicy a owl:Class ;
    rdfs:label "Enterprise Risk Policy and Procedure" ;
    rdfs:comment "Output of 11.1.1.2 (develop and maintain enterprise risk policies and procedures); reference framework for 11.1.3.2 (assess risks using enterprise risk framework). Directive: prescribes conduct." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the rules, regulations, and procedures for managing hazardous, financial, operational, and strategic risk across an organization." .

bpot:RegulatoryRequirement a owl:Class ;
    rdfs:label "Regulatory Requirement" ;
    rdfs:comment "Directive (not Descriptive): a regulatory requirement prescribes obligatory conduct. Shared input across 11.2 (identify applicable requirements 11.2.2.2) and 11.3 (investigate legal aspects 11.3.4). Anchored to cco:ont00000965 (Directive/Prescriptive ICE)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity, issued by a governing authority, that prescribes a law, guideline, statute, or stipulation with which an organization must comply." .

bpot:RiskAssessment rdfs:label "Risk Assessment" ;
    rdfs:comment "Shared output of appraisal acts (11.1.2.2, 11.1.3.2). Descriptive (a judgement), per GOLDEN PRINCIPLE for Act of Appraisal." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:Risk ] ;
    skos:definition "A Descriptive Information Content Entity, about one or more risks, that describes a judgement of the likelihood and impact of those risks together with their root causes, used to determine which to mitigate." .

bpot:RiskMonitoringReport a owl:Class ;
    rdfs:label "Risk Monitoring Report" ;
    rdfs:comment "Output of monitoring acts (11.1.2.5, 11.1.3.5) produced by bpo:ActOfMonitoring (inlined above). NOTE (Gate-F): this is a continuous time-series monitoring artifact and is a FALSE FRIEND for one-shot verification findings; verification acts (11.1.2.4, 11.1.2.8, 11.1.2.9) use the dedicated conformance-finding ICEs below instead." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the observed status of risks and risk-mitigation actions tracked over time against expected parameters." .

