bpot:PartnerOrganization a owl:Class ;
    rdfs:label "Partner Organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:PartnerRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a partner role in relation to a focal organization." .

bpot:ProfessionalServicesProvider a owl:Class ;
    rdfs:label "Professional Services Provider" ;
    rdfs:comment "Modeled as Agent (not strictly Organization) so it covers both individual consultants and consulting firms." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ProfessionalServicesProviderRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a professional services provider role." .

bpot:StrategicPlanningCapability a owl:Class ;
    rdfs:label "Strategic Planning Capability" ;
    rdfs:comment "Use as the realizable behind standing 'develop/define strategy' functions. Subclass of ont00000568 because the bearer is the Organization as a whole." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to formulate vision, mission, and strategy through intentional acts of strategy formulation and selection." .

bpot:apqcSourceText a owl:AnnotationProperty ;
    rdfs:label "APQC source description" ;
    rdfs:comment "Verbatim APQC Element Description retained for provenance." ;
    skos:definition "An annotation property that relates an ontology term to the verbatim element description of its source row in a specified release of the APQC Process Classification Framework." .

bpot:designatesProcessType a owl:AnnotationProperty ;
    rdfs:label "designates process type" ;
    rdfs:comment "ADR-001 R4 bridge: catalog node -> reality-layer process universal or capability. Populated during reality-layer modeling, NOT by the catalog generator." ;
    skos:definition "An annotation property that relates an APQC PCF catalog concept to an OWL class representing the Process type or Organization Capability type designated by that concept." .

bpot:hierarchyID a owl:AnnotationProperty ;
    rdfs:label "APQC Hierarchy ID" ;
    rdfs:comment "Positional dotted-decimal locator. NON-STABLE across PCF versions. Reference only; never for IRI minting or subsumption." ;
    skos:definition "An annotation property that relates an ontology term to the dotted-decimal hierarchy identifier assigned to its source row in a particular release of the APQC Process Classification Framework, whose value may change between releases." .

bpot:pcfID a owl:AnnotationProperty ;
    rdfs:label "APQC PCF ID" ;
    rdfs:comment "Stable APQC identifier. Anchor IRIs to this; it persists across PCF versions." ;
    skos:definition "An annotation property that relates an ontology term to the unique process element identifier assigned by APQC to its source row, which remains stable across PCF releases while the conceptual meaning of the element remains unchanged." .

<https://fandaws.com/ontology/bpot/sections/pcf_1> a owl:Ontology ;
    dcterms:creator "Aaron Damiano" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://fandaws.com/ontology/bpo/slice/1.0>,
        "APQC Process Classification Framework (Cross-Industry)",
        "APQC Process Classification Framework (Cross-Industry) v7.4" ;
    dcterms:title "Business Process Ontology -- PCF 1.0 Develop Vision and Strategy" ;
    rdfs:comment "Reality layer for APQC PCF category 1.0: the process universals that pass the bounded-occurrent test, the organization capabilities, roles and information content entities they use." ;
    owl:versionIRI <https://fandaws.com/ontology/bpot/0.0.0/sections/pcf_1.ttl> ;
    owl:versionInfo "0.0.0" .

bpot:BusinessAuthorization a owl:Class ;
    rdfs:label "Business Authorization" ;
    rdfs:comment "Minted for 1.4.1.2 output. Subclass of cco:ont00000751 (Action Permission, altLabel Authorization/License), itself a Directive ICE." ;
    rdfs:subClassOf cco:ont00000751,
        cco:ont00000965 ;
    skos:definition "An Action Permission that authorizes the conduct of a particular business or business activity." .

bpot:BusinessModelAdoptionDecision a owl:Class ;
    rdfs:label "Business Model Adoption Decision" ;
    rdfs:comment "Minted for 1.4.1.4 output. Directive (a decision prescribes) rather than Descriptive." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes that a particular business model is to serve as the accepted basis of an organization's operations." .

bpot:BusinessModelGovernancePolicy a owl:Class ;
    rdfs:label "Business Model Governance Policy" ;
    rdfs:comment "Output of 1.4.3 'Establish business model governance' and the maintenance-parameter nodes of 1.4.2." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the responsibilities, control mechanisms, and review parameters for managing an organization's business models." .

bpot:BusinessModelMaintenancePlan a owl:Class ;
    rdfs:label "Business Model Maintenance Plan" ;
    rdfs:comment "Minted for 1.4.2.1 output. Directive (it prescribes the maintenance procedure)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the timeline, procedures, and responsibilities for reviewing and updating a business model." .

bpot:BusinessModelSourceMaterial a owl:Class ;
    rdfs:label "Business Model Source Material" ;
    rdfs:comment "Minted (Gate-F) for P20946 'Assemble business model information' as the definitional input its Act-of-Information-Processing genus receives. Distinct from bpo:BusinessModelInformation (the assembled output)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity comprising the relevant materials, documents, and process facts gathered as the raw input from which a business model is developed." .

bpot:BusinessUnitRole a owl:Class ;
    rdfs:label "Business Unit Role" ;
    rdfs:comment "Borne by the sub-organization (the unit), not by the business-unit-strategy ICE about it." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of being a constituent operating unit within a larger parent organization." .

bpot:CompetitiveAnalysisCapability a owl:Class ;
    rdfs:label "Competitive Analysis Capability" ;
    rdfs:comment "Carried over from the 1.1.1 reference module; the realized-in filler is re-pointed to bpo:P19945 (this module's IRI for 'Identify competitors / Analyze competitors')." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19945 ],
        cco:ont00001379 ;
    skos:definition "An Agent Capability that is realized in Acts of Analyzing Competitors." .

bpot:CompetitiveBenchmark a owl:Class ;
    rdfs:label "Competitive Benchmark" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a juxtaposition of processes and performance metrics against competitors." .

bpot:CompetitiveForcesAssessment a owl:Class ;
    rdfs:label "Competitive Forces Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of the competitive forces in a marketplace." .

bpot:CompetitiveIntelligenceAnalyst a owl:Class ;
    rdfs:label "Competitive Intelligence Analyst" ;
    rdfs:comment "Narrower than BFO material entity: cco:Agent excludes tools, animals, and arbitrary material objects from being analysts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001954 ;
            owl:someValuesFrom bpot:CompetitiveAnalysisCapability ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:CompetitiveIntelligenceAnalystRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that has a competitive analysis capability and bears a competitive-intelligence analyst role." .

bpot:CompetitiveIntelligenceAnalystRole a owl:Class ;
    rdfs:label "Competitive Intelligence Analyst Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with analyzing competitors on behalf of an Organization." .

bpot:Competitor a owl:Class ;
    rdfs:label "Competitor" ;
    rdfs:comment "Modeled as Organization per APQC 'competing firms'. Use cco:Agent for individual (non-organizational) competitors." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:CompetitorRole ],
        cco:ont00001180 ;
    skos:definition "An Organization that bears a competitor role in relation to some focal organization or market." .

bpot:CompetitorAnalysis a owl:Class ;
    rdfs:label "Competitor Analysis" ;
    rdfs:comment "Carried over from the 1.1.1 reference module. Descriptive (not Directive) because it represents competitors rather than prescribing a course of action." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:Competitor ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes one or more competitors with respect to their strengths and weaknesses relative to a focal organization." ;
    skos:example "A report comparing two competitors' pricing, product capabilities, and market position." .

bpot:CompetitorRole a owl:Class ;
    rdfs:label "Competitor Role" ;
    rdfs:comment "Borne by an independent continuant (the rival Organization), never by the analysis ICE that is about it." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of competing with a focal organization in a market." .

bpot:CurrentBusinessAnalysis a owl:Class ;
    rdfs:label "Current Business Analysis" ;
    rdfs:comment "Minted (Gate-F) for P10044 'Define current business'. Descriptive (it represents an understanding of the status quo), so it agrees with the bpo:ActOfAnalysis genus; bpo:BusinessConcept (Directive) is reserved for the formulation acts P10045/P17040." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the de-facto core of what a business does and the capacities that underpin it, as understood at the present time." .

bpot:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "Modeled as Agent so it covers both individual persons and organizational buyers; use bpo:CustomerRole on an Organization for B2B customers." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:CustomerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a customer role." .

bpot:CustomerJourneyMap a owl:Class ;
    rdfs:label "Customer Journey Map" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the sequence of a customer's interactions with an organization from initial contact through long-term relationship." .

bpot:CustomerRole a owl:Class ;
    rdfs:label "Customer Role" ;
    rdfs:comment "Minted because CCO 2.0 has no Customer class/role. Borne by an independent continuant (the buying Agent/Organization), never by the customer-profile ICE that is about it." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent or Organization in virtue of acquiring, consuming, contracting for, or being a target acquirer of the goods or services of a focal organization." .

bpot:CustomerTouchpointInventory a owl:Class ;
    rdfs:label "Customer Touchpoint Inventory" ;
    rdfs:comment "Minted (Gate-F) for P19961 'Identify and review customer touchpoints'. A register of discerned touchpoints, agreeing with the bpo:ActOfIdentification genus; replaces the mis-typed bpo:CustomerExperienceAssessment output." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that registers the touchpoints through which customers interact with an organization, such as billboards, web sites, direct mail, and service calls." .

bpot:CustomerValueAssessment a owl:Class ;
    rdfs:label "Customer Value Assessment" ;
    rdfs:comment "Minted (Gate-F) for P19979 'Determine the customer value'. Descriptive judgement of value, parallel to bpo:BusinessValueAssessment (the sibling P19978 output)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the assessed value a customer derives from a product or service relative to what the customer gives up to obtain it." .

bpot:DemographicAnalysis a owl:Class ;
    rdfs:label "Demographic Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the size, distribution, and composition of relevant populations." .

bpot:DemographicData a owl:Class ;
    rdfs:label "Demographic Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the size, distribution, and composition of populations." .

bpot:EcologicalConcernRegister a owl:Class ;
    rdfs:label "Ecological Concern Register" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes identified ecological concerns." .

bpot:EcologicalData a owl:Class ;
    rdfs:label "Ecological Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes ecological factors and shifts relevant to an organization." .

bpot:ExternalEnvironmentAssessment a owl:Class ;
    rdfs:label "External Environment Assessment" ;
    rdfs:comment "Carried over from the 1.1.1 reference module so this module is self-contained." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a big-picture understanding of an organization's external environment." ;
    skos:example "A strategy team's annual environmental scan report." .

bpot:FeedbackCriteriaSpecification a owl:Class ;
    rdfs:label "Feedback Criteria Specification" ;
    rdfs:comment "Minted for 1.4.2.2 output. Directive (it prescribes admissible feedback)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which types of feedback are to be taken into consideration during business-model maintenance." .

bpot:FeedbackPrioritization a owl:Class ;
    rdfs:label "Feedback Prioritization" ;
    rdfs:comment "Minted for 1.4.2.3 output. Descriptive (it represents a judgement of importance)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the relative importance of items of incoming feedback, identifying which are critical to act upon." .

bpot:FinancialHealthAnalysis a owl:Class ;
    rdfs:label "Financial Health Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an appraisal of an organization's financial state and capacities." .

bpot:FinancialStatement a owl:Class ;
    rdfs:label "Financial Statement" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the financial state of an organization, including its balance sheet, income, cash flows, equity, and liquidity." .

bpot:GoNoGoDecision a owl:Class ;
    rdfs:label "Go/No-Go Decision" ;
    rdfs:comment "Carried over from the 1.1.1 reference module. Directive (not Descriptive) because a decision prescribes rather than describes." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes whether to proceed or not proceed with a course of action." .

bpot:IPThreatMeasureSpecification a owl:Class ;
    rdfs:label "IP Threat Measure Specification" ;
    rdfs:comment "Carried over from the 1.1.1 reference module." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes measures and procedures for identifying intellectual-property threats." ;
    skos:example "A documented procedure listing IP-threat indicators and the steps to screen for them." .

bpot:InternalEnvironmentAssessment a owl:Class ;
    rdfs:label "Internal Environment Assessment" ;
    rdfs:comment "Internal counterpart of bpo:ExternalEnvironmentAssessment from the 1.1.1 reference module." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a big-picture understanding of an organization's internal skills, resources, and capacities." .

bpot:InternalOperationsAnalysis a owl:Class ;
    rdfs:label "Internal Operations Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the key elements and measured effectiveness of an organization's internal operations." .

bpot:MacroeconomicData a owl:Class ;
    rdfs:label "Macroeconomic Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes macroeconomic indicators such as interest rates, taxation, commodity prices, and unemployment." .

bpot:MacroeconomicTrendAnalysis a owl:Class ;
    rdfs:label "Macroeconomic Trend Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes medium- to long-term macroeconomic shifts relevant to an organization." .

bpot:ModelIntegrationPointRegister a owl:Class ;
    rdfs:label "Model Integration Point Register" ;
    rdfs:comment "Minted for 1.4.1.3 output. Descriptive (it represents integration points) rather than Directive." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the points at which a new business model must integrate with pre-existing models to remain coherent with them." .

bpot:OrganizationalCharacteristicsAnalysis a owl:Class ;
    rdfs:label "Organizational Characteristics Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the key attributes differentiating an organization in its market and underpinning its operations." .

bpot:OrganizationalStructureAdoptionDecision a owl:Class ;
    rdfs:label "Organizational Structure Adoption Decision" ;
    rdfs:comment "Minted (Gate-F) for P10056 'Migrate to new organization', parallel to bpo:BusinessModelAdoptionDecision. Subject-matched (an organizational structure, not a strategic initiative), replacing the mis-subjected bpo:InitiativeSelectionDecision." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes that a particular organizational structure is to serve as the accepted basis of an organization's operations." .

bpot:P10015 a owl:Class ;
    rdfs:label "Develop business strategy" ;
    rdfs:comment "Models APQC process group 1.2 as an occurrent. Its APQC dotted children are process parts (cco:ont00001777), not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10037 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10038 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10039 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10040 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10041 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10042 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10043 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19959 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P18916 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that develops an organization's mission statement, strategy, and business design and produces a business strategy together with an organizational design." ;
    skos:example "An organization's annual strategic-planning programme that produces a refreshed mission, long-term strategy, and organizational design." ;
    bpot:apqcSourceText "Developing an organization's mission statement, strategy, and business design. Create a concise statement that clearly articulates the mission of the organization, outlining practicable targets to Establish a strategic vision [10020]. Delineate strategic options by matching these alternatives with the organization's internal capabilities. Create an organizational design, and identify goals by developing strategies at the functional and process levels." ;
    bpot:hierarchyID "1.2" ;
    bpot:pcfID "10015" .

bpot:P10016 a owl:Class ;
    rdfs:label "Develop and measure strategic initiatives" ;
    rdfs:comment "Models APQC process group 1.3 as a bounded occurrent (an end-to-end initiative cycle), not a standing function. Its APQC children are process parts, not subclasses (D1)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10057 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10058 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10059 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10060 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19507 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21422 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21423 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that develops, selects, executes, and evaluates programs of strategic significance and formulates the measures used to assess their impact." ;
    skos:example "An organization's annual strategic-initiative cycle, from drafting candidate initiatives to evaluating the executed ones." ;
    bpot:apqcSourceText "Managing strategic initiatives, from development through selection, execution, and evaluation. Conduct and oversee strategic projects supporting long-term objectives. Administer programs of strategic significance by developing such initiatives, select the most appropriate projects, and formulate measures to assess their impact." ;
    bpot:hierarchyID "1.3" ;
    bpot:pcfID "10016" .

bpot:P17040 a owl:Class ;
    rdfs:label "Define the business concept and long-term vision" ;
    rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it produces a directive conceptual framework (the business concept) to be achieved. The bpo:StrategicVision output is demoted (Gate-F) from an existential has-output to this comment/CQ note: the long-term vision is supplied by the has-process-part child P10020 'Establish strategic vision', so asserting it as a direct output of P17040 double-counts it. The definitional direct output of P17040 is bpo:BusinessConcept. CQ: 'which acts in 1.1 produce a strategic vision?' is answered by P10020 (and its child P19949), not by P17040 directly. Its APQC children 1.1.1-1.1.5 are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessConcept ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10017 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10018 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10019 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10020 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16792 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that synthesizes internal capability, customer, and external-environment findings into a business concept and long-term strategic vision for an organization." ;
    skos:example "An executive team integrates market and capability analyses into a ten-year business concept and vision." ;
    bpot:apqcSourceText "Creating a conceptual framework of the organization's business activity and strategic vision with long-term applicability. Scout the organization's internal capabilities, as well as the customer's needs and desires, to identify a fit that can be used to advance a conceptual structure of the organization's business activity. Conduct analysis in light of relevant externalities and large-scale shifts in the market landscape." ;
    bpot:hierarchyID "1.1" ;
    bpot:pcfID "17040" .

bpot:P20944 a owl:Class ;
    rdfs:label "Develop and maintain business models" ;
    rdfs:comment "Models APQC process group 1.4 as a bounded occurrent. Its APQC dotted children are process parts (cco:ont00001777), not subclasses (D1). This is a Process Group, not the Category 1.0, so a has-process-part restriction is licensed." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20945 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20950 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20955 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that establishes how an organization creates, delivers, and captures value, and revises that arrangement as circumstances change, comprising the development, maintenance, and governance of its business models." ;
    skos:example "An organization's program to design its business model, keep it current against market feedback, and govern its evolution over a planning horizon." ;
    bpot:apqcSourceText "Establishing how an organization creates, delivers and captures value or makes profit. Identify the products or services that a business will sell, its target market, anticipated expenses, and other core aspects of its modus operandi. Revise the plan as required to reflect changing circumstances." ;
    bpot:hierarchyID "1.4" ;
    bpot:pcfID "20944" .

bpot:PartnerRole a owl:Class ;
    rdfs:label "Partner Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Organization in virtue of entering a partnership or alliance with a focal organization to deliver products or services." .

bpot:PartnershipSelectionDecision a owl:Class ;
    rdfs:label "Partnership Selection Decision" ;
    rdfs:comment "Minted (Gate-F) for P18083 'Select partnerships and relationships' as the Directive chosen-option output required by the bpo:ActOfSelection genus (the Descriptive bpo:StrategicOptionAnalysis alone did not satisfy it)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which partnerships, alliances, and make-versus-buy relationships an organization will pursue to support its extended enterprise." .

bpot:PerformanceMonitoringMethodSpecification a owl:Class ;
    rdfs:label "Performance Monitoring Method Specification" ;
    rdfs:comment "Minted (Gate-F) for P19955 'Monitor performance against objective', whose lead verb is 'defining methodology and frequency' (a formulation act producing a Directive monitoring-method spec), not the appraisal that produces a bpo:PerformanceReport." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the methodology and frequency by which the performance of functions, processes, and activities is to be measured and monitored against set goals." .

bpot:PrioritizedInitiativeList a owl:Class ;
    rdfs:label "Prioritized Initiative List" ;
    rdfs:comment "Minted for PCF 19980: no shared-vocab ICE captures a ranked order of initiatives. Directive (prescribes order of pursuit)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that ranks strategic initiatives from most to least important to guide which are pursued first." .

bpot:ProcessBaseline a owl:Class ;
    rdfs:label "Process Baseline" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a standard reference level of process performance against which current performance is benchmarked." .

bpot:ProfessionalServicesProviderRole a owl:Class ;
    rdfs:label "Professional Services Provider Role" ;
    rdfs:comment "Covers APQC 'specialist professional services providers' engaged for due-diligence and deal evaluation (1.1.5)." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent or Organization in virtue of being engaged externally to supply legal, accounting, consulting, or advisory services to a focal organization." .

bpot:RegulatoryConcernRegister a owl:Class ;
    rdfs:label "Regulatory Concern Register" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes identified public-policy and regulatory concerns." .

bpot:RegulatoryData a owl:Class ;
    rdfs:label "Regulatory Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes public-policy and regulatory measures issued by sovereign or multinational authorities." .

bpot:RequiredCapabilityList a owl:Class ;
    rdfs:label "Required Capability List" ;
    rdfs:comment "Minted (Gate-F) for P19972 'Identify required capabilities'. A register of discerned required skills, agreeing with the bpo:ActOfIdentification genus; replaces the mis-scoped bpo:CoreCompetencyAnalysis output." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that registers the skills and competencies required to operate a function or support structure." .

bpot:ResearchPublication a owl:Class ;
    rdfs:label "Research Publication" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity published as a report, brief, or article and used as analytic input." .

bpot:RootCauseAnalysis a owl:Class ;
    rdfs:label "Root Cause Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the underlying causes of a problematic outcome, such as a negative customer experience." .

bpot:SeniorManagerRole a owl:Class ;
    rdfs:label "Senior Manager Role" ;
    rdfs:comment "Narrower than the 1.1.1 reference module's bpo:ManagerRole; used where APQC text specifies senior executives / senior strategy personnel. MERGE DECISION: this Senior pair (bpo:SeniorManagerRole / bpo:SeniorManagement) deliberately supersedes the reference's generic bpo:ManagerRole / bpo:ManagementPersonnel for the 1.1.1.8 (P10024) participant, which APQC scopes to 'mid- to senior-level management'. The generic role/agent pair is intentionally not carried over: no process in this merged module requires a non-senior management universal, so re-adding it would leave orphaned classes. Re-mint bpo:ManagerRole (and bpo:ManagementPersonnel bearing it) as the rdfs:subClassOf parent of this pair only if a future merged process needs the generic universal." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of exercising senior managerial or executive authority over the strategy and direction of an Organization." .

bpot:SocioculturalData a owl:Class ;
    rdfs:label "Sociocultural Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes societal composition, distribution, and value systems." .

bpot:SocioculturalShiftAnalysis a owl:Class ;
    rdfs:label "Sociocultural Shift Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes shifts in societal makeup and cultural composition." .

bpot:StakeholderRole a owl:Class ;
    rdfs:label "Stakeholder Role" ;
    rdfs:comment "Minted because CCO 2.0 has no Stakeholder class/role. Superset of customer, partner, and regulator relations relative to a focal organization." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent or Organization in virtue of having an interest in, or being affected by, the operations, strategy, processes, programs, or policies of a focal organization." .

bpot:StrategyAlignmentPlan a owl:Class ;
    rdfs:label "Strategy Alignment Plan" ;
    rdfs:comment "Minted (Gate-F) for P10040 'Coordinate and align cross-functional and process strategies'. Units/processes-oriented, replacing the stakeholder-oriented bpo:StakeholderAlignmentPlan, which concerns orienting stakeholders rather than calibrating unit plans." ;
    rdfs:subClassOf cco:ont00000965,
        cco:ont00000974 ;
    skos:definition "A Plan that prescribes how the plans and methods of an organization's individual units, departments, and processes are to be calibrated to the adopted enterprise strategy." .

bpot:StrategyPersonnelRole a owl:Class ;
    rdfs:label "Strategy Personnel Role" ;
    rdfs:comment "Covers APQC 'strategy personnel', 'strategy executives', and 'business-unit strategy personnel'." ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with formulating, evaluating, or coordinating an Organization's strategy." .

bpot:StrategyReviewReport a owl:Class ;
    rdfs:label "Strategy Review Report" ;
    rdfs:comment "Minted (Gate-F) for P19977 'Review with stakeholders'. A specialization of bpo:PerformanceReport carrying an is-about (cco:ont00001808) to bpo:BusinessStrategy, so the reviewed strategy is captured as the report's subject matter rather than as a (mis-typed) has-input to a communication act." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:PerformanceReport ;
    skos:definition "A Performance Report that describes an evaluation of an organization's business objectives and strategies and is about the business strategy reviewed." .

bpot:SubstitutionBusinessCase a owl:Class ;
    rdfs:label "Substitution Business Case" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an argument for or against a course of action in light of substitute products or services." .

bpot:SystemsAndTechnologyAnalysis a owl:Class ;
    rdfs:label "Systems and Technology Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the capabilities of technology and process-automation systems deployed within an organization." .

bpot:TechnologyAssessment a owl:Class ;
    rdfs:label "Technology Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of current, emerging, and disruptive technologies." .

bpot:TechnologyData a owl:Class ;
    rdfs:label "Technology Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes deployed, emerging, and disruptive technologies." .

bpot:BusinessConcept a owl:Class ;
    rdfs:label "Business Concept" ;
    rdfs:comment "Output of process group 1.1 'Define the business concept and long-term vision'." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the conceptual framework of an organization's business activity with long-term applicability." .

bpot:BusinessModelInformation a owl:Class ;
    rdfs:label "Business Model Information" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the materials, goals, and process facts gathered as the basis for developing or revising a business model." .

bpot:BusinessValueDriver a owl:Class ;
    rdfs:label "Business Value Driver" ;
    rdfs:comment "Minted for PCF 19982/19983: distinct from bpo:PerformanceMetric (a target measure) -- a driver is the underlying value-causing factor." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a key operational, financial, or sustainability indicator responsible for driving business value." .

bpot:BusinessValueDriverBaseline a owl:Class ;
    rdfs:label "Business Value Driver Baseline" ;
    rdfs:comment "Minted for PCF 19983/19984: distinct from bpo:ProcessBaseline (process-scoped) -- this baselines a value driver. Distinct from bpo:PerformanceRecord (actuals)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records a baseline standard measure for a business value driver against which later performance is assessed." .

bpot:CommunicationStrategy a owl:Class ;
    rdfs:label "Communication Strategy" ;
    rdfs:comment "Reuses CCO Plan. Output of the 'communicate' nodes (1.1.4.3, 1.2.1.3, 1.2.9, 1.3.3.2, 1.2.8.2.7 content strategy)." ;
    rdfs:subClassOf cco:ont00000965,
        cco:ont00000974 ;
    skos:definition "A Plan that prescribes the intended channels and acts for conveying a mission, vision, or strategy to stakeholders." .

bpot:CompetitorData a owl:Class ;
    rdfs:label "Competitor Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes competitors and their products or services." .

bpot:CoreCompetencyAnalysis a owl:Class ;
    rdfs:label "Core Competency Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the strategically significant competences and capacities that differentiate an organization in its market." .

bpot:DueDiligenceReport a owl:Class ;
    rdfs:label "Due-Diligence Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes verified tangible and substantial facts about an entity being considered for a restructuring transaction." .

bpot:InitiativeSelectionDecision a owl:Class ;
    rdfs:label "Initiative Selection Decision" ;
    rdfs:comment "Directive (a decision prescribes a course of action), parallel to bpo:GoNoGoDecision in the 1.1.1 reference module. Output of 1.3.3 'Select strategic initiatives'." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which strategic initiatives an organization will pursue." .

bpot:P10017 a owl:Class ;
    rdfs:label "Assess the external environment" ;
    rdfs:comment "Anchored (Gate-F) to bpo:ActOfAnalysis, kept consistent with its sibling P10019 'Assess the internal environment': both differentiate on building a 'big-picture understanding' and emit a Descriptive assessment, so both are Analysis. Rejected cco:ont00000636 (Act of Appraisal): the dominant gerund is creating a synthetic understanding of externalities, not rendering a value-judgement. Was bpo:AnalyzeExternalBusinessEnvironment in the GOLD module. Its APQC children are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ExternalEnvironmentAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19945 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10021 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21421 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10022 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10023 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10027 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10026 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10024 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10025 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16790 ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the external forces, entities, and systems bearing on an organization and produces a big-picture external-environment assessment." ;
    skos:example "An organization's yearly strategic environmental scan culminating in an external-environment assessment." ;
    bpot:apqcSourceText "Assessing all forces, entities, and systems that are external to an organization but can affect its operation. Analyze far-reaching currents in the macroeconomic situation, assess the competition, evaluate technological changes, and identify societal as well as ecological issues of concern. Create a big-picture understanding of externalities, with sufficient depth across individual aspects." ;
    bpot:hierarchyID "1.1.1" ;
    bpot:pcfID "10017" .

bpot:P10018 a owl:Class ;
    rdfs:label "Survey market and determine customer needs and wants" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis (information processing): it examines market/customer data into a needs assessment. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerNeedsAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10028 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19946 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19947 ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines market and customer data to determine the products and services customers need or want and produces a customer needs assessment." ;
    skos:example "A market-research team surveys a segment and reports the customer needs the firm should address." ;
    bpot:apqcSourceText "Examining the market to identify customer required solutions. Assess the relevant market(s) to determine the products/services that are needed or wanted by customers. Carry out quantitative and qualitative analyses to capture and investigate products/services. Employ creative techniques that allow for a closer appreciation of the customer, and design relevant solutions." ;
    bpot:hierarchyID "1.1.2" ;
    bpot:pcfID "10018" .

bpot:P10019 a owl:Class ;
    rdfs:label "Assess the internal environment" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000636 (Act of Appraisal) to bpo:ActOfAnalysis for sibling consistency with P10017 'Assess the external environment': the source's differentia is 'create a big-picture understanding of internal capacities', and the Descriptive bpo:InternalEnvironmentAssessment output agrees with the Information-Processing genus. Rejected Act of Appraisal: building a synthetic understanding is analysis, not a value-judgement. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:InternalEnvironmentAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10030 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19948 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10031 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10032 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10033 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10034 ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that reviews an organization's in-house skills, resources, and capabilities and produces a big-picture internal-environment assessment." ;
    skos:example "A strategy team reviews the firm's capabilities and produces an internal-environment assessment." ;
    bpot:apqcSourceText "Undertaking a review of the organization's in-house skills and resources in order to create a big-picture understanding of internal capacities. Assess the organization's capabilities in order to advance the advantageous and weed out the detrimental aspects. Identify synergic associations within the backdrop of the forces and players active in the market, and take into account all externalities." ;
    bpot:hierarchyID "1.1.3" ;
    bpot:pcfID "10019" .

bpot:P10020 a owl:Class ;
    rdfs:label "Establish strategic vision" ;
    rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it produces a directive vision. Its APQC children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicVision ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19949 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10035 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10036 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that formulates an organization's long-term strategic vision and orients stakeholders around it, producing a strategic vision." ;
    skos:example "An executive team establishes a ten-year vision and aligns stakeholders behind it." ;
    bpot:apqcSourceText "Establishing the organization's long-term vision as a strategic positioning and engagement of stakeholders. Institute the vision by creating strategic orientations of all stakeholders. Understand the strategy development frameworks in this context." ;
    bpot:hierarchyID "1.1.4" ;
    bpot:pcfID "10020" .

bpot:P10021 a owl:Class ;
    rdfs:label "Analyze and evaluate competition" ;
    rdfs:comment "Carried over from GOLD module (bpo:AssessMarketplaceCompetitiveForces). Anchored to cco:ont00000636 (Act of Appraisal)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CompetitorData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CompetitiveForcesAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CompetitiveBenchmark ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input competitor data and market data and has as output a competitive-forces assessment and competitive benchmarks." ;
    skos:example "An analyst benchmarks rivals and issues an assessment of the competitive forces in the sector." ;
    bpot:apqcSourceText "Assessing the competitive forces in the marketplace that could potentially affect the organization. Analyze various aspects of business competition including competing firms. Aggregate competitive intelligence, create benchmarks to juxtapose processes and performance metrics, and inject crucial information about the competition into management models to synthesize insights." ;
    bpot:hierarchyID "1.1.1.2" ;
    bpot:pcfID "10021" .

bpot:P10022 a owl:Class ;
    rdfs:label "Identify economic trends" ;
    rdfs:comment "Carried over from GOLD module (bpo:DetermineMacroeconomicTrends)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MacroeconomicData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MacroeconomicTrendAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input macroeconomic data and has as output a macroeconomic trend analysis." ;
    skos:example "An economist reviews indicators and reports the trends likely to affect the firm over five years." ;
    bpot:apqcSourceText "Determining large-scale macroeconomic shifts and trends, with medium to long-term relevance for the organization. Vet the immediate and the larger economic ecosystem to identify broad-based movements that affect the organization. In the immediate vicinity, for example, examine the stock price of key vendors/suppliers in the organizational value-chain. In the larger economic ecosystem, analyze according to geographical distribution where factors such as interest rates, taxation structures, oil prices, and unemployment rates are explored." ;
    bpot:hierarchyID "1.1.1.4" ;
    bpot:pcfID "10022" .

bpot:P10023 a owl:Class ;
    rdfs:label "Identify political and regulatory factors" ;
    rdfs:comment "Carried over from GOLD module (bpo:IdentifyRegulatoryConcerns)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RegulatoryData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RegulatoryConcernRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that has as input regulatory data and has as output a regulatory concern register." ;
    skos:example "A compliance team screens jurisdictions and registers the regulatory changes that bear on the firm." ;
    bpot:apqcSourceText "Identifying areas of concern pertaining to public policy and regulation, established by sovereign or multinational authorities. Examine various regions and geopolitical formations to identify those political and regulatory issues-present or developing-that can potentially affect the organization. Plan for an iterative process, partitioned across regional and geopolitical entities that have a direct bearing on the organization's activities. Assess changes in environmental compliance, product standards, trade barriers, etc." ;
    bpot:hierarchyID "1.1.1.5" ;
    bpot:pcfID "10023" .

bpot:P10024 a owl:Class ;
    rdfs:label "Assess new technologies" ;
    rdfs:comment "Carried over from GOLD module (bpo:AssessTechnologyDevelopments). Participant re-bound to shared bpo:SeniorManagement per the manifest agent vocabulary." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:TechnologyData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:TechnologyAssessment ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:SeniorManagement ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input technology data, has as output a technology assessment, and has senior management as participant." ;
    skos:example "Senior managers appraise an emerging technology and issue a technology assessment." ;
    bpot:apqcSourceText "Assessing developments in technologies presently being used by the business, new technologies that have a potential for the business, and any disruptive innovations. Conduct a survey of advancement in technologies that are already deployed with inputs from the personnel closely working with them, tracking utility and feasibility for deployment. Arrange for mid- to senior-level management personnel who explore contingent uses to assess new and disruptive technologies. Follow up with desk research, involving physical scoping and viability assessment." ;
    bpot:hierarchyID "1.1.1.8" ;
    bpot:pcfID "10024" .

bpot:P10025 a owl:Class ;
    rdfs:label "Analyze demographics" ;
    rdfs:comment "Carried over from GOLD module (bpo:AnalyzeDemographics)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DemographicData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DemographicAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input demographic data and has as output a demographic analysis." ;
    skos:example "A team analyzes census data and produces a demographic profile of a target market." ;
    bpot:apqcSourceText "Analyzing statistical data relating to the size, distribution, and composition of relevant populations, as well as their characteristics. Perform quantitative analysis over raw data-sets gathered from well-founded sources such as government census or large, private databases. Consider employing primary research in collecting required statistics. Use comprehensive studies (reports, briefs, and articles) to assist with the analysis, in place of raw data." ;
    bpot:hierarchyID "1.1.1.9" ;
    bpot:pcfID "10025" .

bpot:P10026 a owl:Class ;
    rdfs:label "Identify social and cultural changes" ;
    rdfs:comment "Carried over from GOLD module (bpo:DistinguishSocioculturalShifts)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:SocioculturalData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SocioculturalShiftAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that has as input sociocultural data and has as output a sociocultural shift analysis." ;
    skos:example "A market researcher distinguishes generational value shifts relevant to the brand." ;
    bpot:apqcSourceText "Distinguishing changes in societal makeup, as well as the cultural composite. Isolate shifts in the societal composition and distribution, as well as the value systems and attributes that bind the organization together. Analyze well-regarded publications--and gather the perspective of public intellectuals and opinion leaders--on relevant issues." ;
    bpot:hierarchyID "1.1.1.7" ;
    bpot:pcfID "10026" .

bpot:P10027 a owl:Class ;
    rdfs:label "Identify environmental factors" ;
    rdfs:comment "Carried over from GOLD module (bpo:IdentifyEcologicalConcerns)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:EcologicalData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:ResearchPublication ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:EcologicalConcernRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that has as input ecological data and research publications and has as output an ecological concern register." ;
    skos:example "An ESG analyst registers ecological risks drawn from scientific publications and expert input." ;
    bpot:apqcSourceText "Identifying changes in ecological ecosystems that can be directly or indirectly detrimental to the organization. Analyze ecological factors within the immediate ecosystem for near to middle-term impact. Analyze the ecology, at large, to get a sense of long-term shifts and concerns. Gather analyses from research publications. Speak to subject matter experts. Engage with advocacy groups, lawyers, journalists, and the active populations." ;
    bpot:hierarchyID "1.1.1.6" ;
    bpot:pcfID "10027" .

bpot:P10028 a owl:Class ;
    rdfs:label "Conduct qualitative/quantitative research and assessments" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis. Research/investigation of market features is information processing." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerNeedsAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input market data and customer data and has as output a customer needs assessment derived from qualitative and quantitative research." ;
    skos:example "Researchers run a survey and focus groups and distill the findings into a needs assessment." ;
    bpot:apqcSourceText "Investigating key market features and customer characteristics, using qualitative and quantitative measures to capture relevant aspects. Distill key ingredients that allow the organization to Capture customer needs and wants [19946], and Assess customer needs and wants [19947]. Conduct standardized appraisals by defining selection parameters and setting quotas." ;
    bpot:hierarchyID "1.1.2.1" ;
    bpot:pcfID "10028" .

bpot:P10030 a owl:Class ;
    rdfs:label "Analyze organizational characteristics" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis. Senior management modeled as definitional participant per the source ('Have senior executives conduct the analysis')." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalCharacteristicsAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:SeniorManagement ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input internal-capability data and has as output an organizational-characteristics analysis, with senior management as participant." ;
    skos:example "Senior executives examine the firm's differentiating attributes and document an organizational-characteristics analysis." ;
    bpot:apqcSourceText "Identifying and examining key attributes that differentiate the organization in the market and those that underscore the core of its operations. Consider how the organization functions. Reflect over tangible and intangible aspects in order to spot critical correlations and the interplay between these attributes. Have senior executives conduct the analysis, with input from management and operational personnel." ;
    bpot:hierarchyID "1.1.3.1" ;
    bpot:pcfID "10030" .

bpot:P10031 a owl:Class ;
    rdfs:label "Create baselines for current processes" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000511 (Act of Planning) to bpo:ActOfAnalysis, kept consistent with its sibling P19983 'Establish baselines for business value drivers': a baseline is a Descriptive reference measure DERIVED from archival performance records (the output bpo:ProcessBaseline is Descriptive), so the act is information processing. Rejected Act of Planning (would require a Directive output, but a baseline describes a reference level rather than prescribing action) and rejected cco:ont00000345 Act of Measuring (measuring determines a value AGAINST an existing standard, whereas this act DERIVES the standard from records)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ProcessBaseline ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input performance records and has as output a process baseline derived from them as a reference measure for benchmarking current processes." ;
    skos:example "Management surveys archival performance records and derives process baselines for benchmarking." ;
    bpot:apqcSourceText "Establishing baselines that provide standards for assessing performance levels and allow for a relational benchmarking of current processes. Undertake a survey of archival performance records, conducted in conjunction by the management and the operations personnel. Take into account the organization's internal objectives, particularly for process improvement and enhancement. Understand industry best practices." ;
    bpot:hierarchyID "1.1.3.3" ;
    bpot:pcfID "10031" .

bpot:P10032 a owl:Class ;
    rdfs:label "Analyze systems and technology" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: it examines deployed systems and reports their capabilities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SystemsAndTechnologyAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input internal-capability data and has as output a systems-and-technology analysis of deployed technology and automation systems." ;
    skos:example "An IT team surveys deployed automation systems and documents a systems-and-technology analysis." ;
    bpot:apqcSourceText "Analyzing the capabilities of technology and process automation systems deployed within the organization in order to direct future associated processes. Conduct a broad-based survey to examine various aspects associated with such systems and technologies, with the objective of identifying key facets that are of interest. Investigate the intended purpose, purpose served, utility, longevity, remaining service-life, repair or service requirements, etc." ;
    bpot:hierarchyID "1.1.3.4" ;
    bpot:pcfID "10032" .

bpot:P10033 a owl:Class ;
    rdfs:label "Analyze financial health" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it appraises the financial state. Source notes its output feeds 1.1.5 and 1.1." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:FinancialStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FinancialHealthAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input financial statements and has as output a financial-health analysis of the organization's financial state." ;
    skos:example "A finance team scrutinizes the balance sheet and cash-flow statements and reports the firm's financial health." ;
    bpot:apqcSourceText "Appraising the financial state of the organization so that management can create resource allocation strategies. Scrutinize the organization's financials--including balance sheets, statements of income, cash-flows, equity holdings, and liquidity--with the objective of understanding the organization's financial health and capacities. (This analysis directly feeds into Conduct organizational restructuring opportunities [16792] and Define a business concept and long-term vision [17040].)" ;
    bpot:hierarchyID "1.1.3.5" ;
    bpot:pcfID "10033" .

bpot:P10034 a owl:Class ;
    rdfs:label "Identify core competencies" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment sense): it discerns and registers strategically significant competencies." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CoreCompetencyAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that has as input internal-capability data and has as output a core-competency analysis registering the organization's distinguishing competencies." ;
    skos:example "Senior executives determine and document the firm's core competencies for its value proposition." ;
    bpot:apqcSourceText "Determining a strategically significant aggregate of competence and capacities that differentiates the organization in the market. Identify distinguishing attributes including unique skills and resources and its brand and services in the marketplace. Have senior executives and management personnel assess competencies in order to further develop these capabilities into distinct commercial value propositions." ;
    bpot:hierarchyID "1.1.3.6" ;
    bpot:pcfID "10034" .

bpot:P10035 a owl:Class ;
    rdfs:label "Align stakeholders around strategic vision" ;
    rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it produces a directive alignment plan. Strategy personnel modeled as definitional participant per the source." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicVision ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StakeholderAlignmentPlan ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:StrategyPersonnel ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that has as input a strategic vision and has as output a stakeholder alignment plan mapping stakeholders in strategic configurations, with strategy personnel as participant." ;
    skos:example "Senior strategy personnel map stakeholders and produce a plan to align them with the vision." ;
    bpot:apqcSourceText "Orienting those entities, associated with the organization that have a direct bearing on its operations and output, in a way that advances its strategic vision. Map all stakeholders in strategic configurations, within the architectural layout of the marketplace, and position the organization relative to them. (This exercise is undertaken by senior strategy personnel, drawing upon the process Define a business concept and long-term vision [17040].)" ;
    bpot:hierarchyID "1.1.4.2" ;
    bpot:pcfID "10035" .

bpot:P10036 a owl:Class ;
    rdfs:label "Communicate strategic vision to stakeholders" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication, verified v2.0): an ICE (the vision/alignment plan) is transferred from the organization to its stakeholders." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StakeholderAlignmentPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicVision ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CommunicationStrategy ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:StrategyPersonnel ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that has as input a stakeholder alignment plan and a strategic vision and conveys the vision to stakeholders by means of a communication strategy." ;
    skos:example "Strategy personnel and marketing convey the vision to stakeholders through tailored channels." ;
    bpot:apqcSourceText "Developing and executing communication strategies to convey an alignment plan of all organizational stakeholders, which helps the organization realize its vision. Create custom communication strategies and delivery channels with the objective of orienting stakeholders according to the configuration maps created in the process Align stakeholders around a strategic vision [10035]. Have senior strategy personnel closely collaborate with the communications/marketing team." ;
    bpot:hierarchyID "1.1.4.3" ;
    bpot:pcfID "10036" .

bpot:P10037 a owl:Class ;
    rdfs:label "Develop overall mission statement" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (subClassOf Act of Planning). Senior management/strategy personnel are typical (non-definitional) participants per the source." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MissionStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10044 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10045 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10046 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines and communicates an organization's mission and produces a mission statement." ;
    skos:example "An executive team drafts, ratifies, and circulates a one-paragraph corporate mission statement." ;
    bpot:apqcSourceText "Establishing an overarching, compact statement that concisely underscores the mission of the organization. Define and communicate a clear and succinct mission statement, which encapsulates how the organization aims to proceed in order to Establish a strategic vision [10020]. Solicit critical inputs from senior management and strategy executives, and collaborate with marketing or personnel from allied functions." ;
    bpot:hierarchyID "1.2.1" ;
    bpot:pcfID "10037" .

bpot:P10038 a owl:Class ;
    rdfs:label "Define and evaluate strategic options to achieve the mission" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the group's defining act is appraising sets of strategic decisions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10047 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10048 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21606 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21607 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21608 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21609 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21610 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21611 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21612 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21613 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21614 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that defines candidate strategic options and evaluates them against the organization's objectives, producing a strategic-option analysis." ;
    skos:example "Strategy leadership enumerates and weighs make-vs-buy, B2B, B2C, partnership, and improvement options before committing to a direction." ;
    bpot:apqcSourceText "Assessing sets of strategic decisions designed to drive the organization's long-term objectives. Identify various strategies concerning core functional areas. Appraise strategic options in light of auxiliary decision frameworks that ensure smooth functioning, the advancement of functional efficiencies, and vitality. Involve senior management executives, especially strategy and/or business unit personnel, with need-based consultative assistance from professional services providers." ;
    bpot:hierarchyID "1.2.2" ;
    bpot:pcfID "10038" .

bpot:P10039 a owl:Class ;
    rdfs:label "Set/Develop long-term enterprise strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): develops the long-term strategy. The chosen strategic option is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicOption ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16803 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14189 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16805 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19952 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19950 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19951 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P14197 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that adopts a strategic option and develops it into a long-term enterprise strategy, producing a business strategy." ;
    skos:example "The executive committee commits to and elaborates a ten-year enterprise strategy." ;
    bpot:apqcSourceText "Developing a strategy for the achievement of business goals over the distant future. Adopt one of the strategic options for realizing its mission over the long term. Enlist senior management executives, comprising strategy and/or business unit personnel." ;
    bpot:hierarchyID "1.2.3" ;
    bpot:pcfID "10039" .

bpot:P10040 a owl:Class ;
    rdfs:label "Coordinate and align cross-functional and process strategies" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): aligning unit plans to the enterprise strategy composes a coordinated plan. Output replaced (Gate-F) from the stakeholder-oriented bpo:StakeholderAlignmentPlan (which concerns orienting stakeholders around the vision, the subject of 1.1.4.2) with the units/processes-oriented bpo:StrategyAlignmentPlan, which matches the source ('aligning the approach and method of individual units, departments, systems, and operations'). The business strategy is the definitional input. Leaf process." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategyAlignmentPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that calibrates the plans of individual units and processes to the adopted enterprise strategy and produces a strategy alignment plan." ;
    skos:example "A PMO calibrates each division's annual plan to the enterprise strategy and publishes the alignment plan." ;
    bpot:apqcSourceText "Aligning the approach and method of individual units, departments, systems, and operations within the organization, in accordance with the larger strategic course adopted. Employ the organization's strategic path to guide the functions, divisions, and operations. Calibrate the plan and method of each functional area, as well as the processes therein, to Select the long-term business strategy [10039]." ;
    bpot:hierarchyID "1.2.4" ;
    bpot:pcfID "10040" .

bpot:P10041 a owl:Class ;
    rdfs:label "Create organizational design" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): composes an organizational design." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalDesign ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10049 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10050 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10051 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10052 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10053 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10054 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10055 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10056 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that designs a framework for the organization's resources and processes and produces an organizational design." ;
    skos:example "An org-design team produces a new operating-structure framework aligned to strategy." ;
    bpot:apqcSourceText "Formulating a design for the organization's resources that allow it to meet its objectives. Develop a new framework for molding the organization's various processes into a coherent and seamless whole." ;
    bpot:hierarchyID "1.2.5" ;
    bpot:pcfID "10041" .

bpot:P10042 a owl:Class ;
    rdfs:label "Develop and set organizational objectives" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): composes objectives. The mission statement is the definitional input the objectives must support." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MissionStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalObjective ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19953 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19954 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19955 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that develops organization-wide near- to middle-term goals supporting the mission and produces organizational objectives." ;
    skos:example "Leadership sets the firm's annual organization-wide objectives in support of the mission." ;
    bpot:apqcSourceText "Developing overall goals for the organization that help in accomplishing its mission. Formulate organization-wide targets in the near to middle term, which will accumulate and propel the organization to realize its long-term objectives, as outlined in Develop an overall mission statement [10037]. Enlist business unit heads or equivalent personnel, in close collaboration with senior management executives." ;
    bpot:hierarchyID "1.2.6" ;
    bpot:pcfID "10042" .

bpot:P10043 a owl:Class ;
    rdfs:label "Formulate business unit strategies" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): composes unit-level strategies." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19956 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19957 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19958 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that charts strategic roadmaps for the organization's business units and produces a business strategy for each unit." ;
    skos:example "Each division head drafts a unit strategy aligned to enterprise goals." ;
    bpot:apqcSourceText "Charting a strategic course for business units in order to leverage opportunities, sidestep hurdles, and create synergies among each other. Create strategic road maps for the organization's units--in light of their individual resources and requirements, as well as their relationships with other business units--to achieve organizational goals." ;
    bpot:hierarchyID "1.2.7" ;
    bpot:pcfID "10043" .

bpot:P10044 a owl:Class ;
    rdfs:label "Define current business" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: 'reflect over' and 'delineate capacities' is examination of the status quo. Output changed (Gate-F) from the Directive bpo:BusinessConcept to the Descriptive bpo:CurrentBusinessAnalysis so the output's descriptive kind agrees with the Analysis genus (Golden Principle). bpo:BusinessConcept (Directive) is reserved for the formulation acts P10045 'Formulate mission' and P17040 'Define the business concept and long-term vision'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CurrentBusinessAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines what the business does and the capacities that underpin it and produces a current-business analysis describing the status quo." ;
    skos:example "A strategy team documents the firm's de-facto business and core capacities before redrafting the mission." ;
    bpot:apqcSourceText "Defining the status quo relating to the de facto core of what the business is. Reflect over the fundamental essence of what the business accomplishes and the manner in which it operates. Look beyond the obvious solution capabilities to delineate capacities that form the basis of the business engine. Involve senior executives and management personnel and possibly professional services providers." ;
    bpot:hierarchyID "1.2.1.1" ;
    bpot:pcfID "10044" .

bpot:P10045 a owl:Class ;
    rdfs:label "Formulate mission" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: 'outline actionable objectives' composes the mission (a Directive ICE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MissionStatement ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that articulates the organization's mission as actionable objectives and produces a mission statement." ;
    skos:example "Executives translate the long-term vision into a concise, actionable mission statement." ;
    bpot:apqcSourceText "Outlining actionable objectives that effectively set a course to fulfill the organization's vision. In this fundamental activity, articulate certain goals or targets in broad but practicable terms to reach long-term objectives." ;
    bpot:hierarchyID "1.2.1.2" ;
    bpot:pcfID "10045" .

bpot:P10046 a owl:Class ;
    rdfs:label "Communicate mission" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): an existing mission statement ICE is transferred from the organization to its stakeholders. The mission statement is the definitional input being conveyed; the Stakeholder participants are the recipients. The bpo:CommunicationStrategy output is demoted (Gate-F, Phase-3): a communication strategy is only a TYPICAL vehicle (not every instance produces a fresh strategy), so it is recorded here rather than as an existential has-output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MissionStatement ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that conveys an organization's mission statement to its stakeholders." ;
    skos:example "Leadership rolls out the new mission to employees, customers, and the public across email, town halls, and the website." ;
    bpot:apqcSourceText "Developing and executing a communication strategy to convey the mission statement. Create a universal communication strategy and appropriate delivery channels, with the objective of leveraging the latter to execute the former. Convey the inherent message of the mission to all stakeholders, including employees, customers, and the public. Ensure collaboration between senior strategy personnel and the communications/marketing team." ;
    bpot:hierarchyID "1.2.1.3" ;
    bpot:pcfID "10046" .

bpot:P10047 a owl:Class ;
    rdfs:label "Define strategic options" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: defining/delineating options composes prescriptive option specifications. The mission statement is a definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MissionStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOption ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P18083 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that delineates the candidate strategic options available to achieve the organization's mission and produces a set of strategic options." ;
    skos:example "A strategy team enumerates make-vs-buy and market-entry permutations consistent with the mission." ;
    bpot:apqcSourceText "Defining the various options available to achieve the goals highlighted in the mission statement. Delineate (in accordance with a predefined criteria) the various permutations of strategic decisions that would help the organization achieve the objectives outlined in Develop overall mission statement [10037]. Involve senior management and key strategy personnel, with timely help from professional services providers." ;
    bpot:hierarchyID "1.2.2.1" ;
    bpot:pcfID "10047" .

bpot:P10048 a owl:Class ;
    rdfs:label "Assess and analyze impact of each option" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'estimate a measure of the impact' is an evaluation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicOption ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P13289 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P13290 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that estimates and examines the impact of each strategic option and produces a strategic-option analysis." ;
    skos:example "Analysts model the projected impact of each candidate strategy on revenue and operations." ;
    bpot:apqcSourceText "Scoping and probing to study the impact of strategic options for fulfilling the organization's objectives. Estimate a measure of the impact effectuated by each set of strategic decisions, which comprise Define strategic options [10047]. Closely examine the consequences of each option." ;
    bpot:hierarchyID "1.2.2.2" ;
    bpot:pcfID "10048" .

bpot:P10049 a owl:Class ;
    rdfs:label "Evaluate breadth and depth of organizational structure" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation/judgement of structure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalStructureAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the structural makeup and synergies of the organization and produces an organizational structure assessment." ;
    skos:example "An org-design analyst assesses the firm's span-of-control and reporting layers." ;
    bpot:apqcSourceText "Evaluating the structural makeup of the organization, including pertinent features of and associated synergies among constituent elements. Examine the organization's architectural framework, paying close attention to the individual elements, the relations among them, and the conjoint and co-acting forces therein. Analyze functions and processes, as well as work-related positions. Scrutinize various relevant characteristics associated with each of them, depending upon the scale, scope, and type of organization." ;
    bpot:hierarchyID "1.2.5.1" ;
    bpot:pcfID "10049" .

bpot:P10050 a owl:Class ;
    rdfs:label "Perform job-specific roles mapping and value-added analyses" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: 'analyze a map of work-related roles ... examine the value added' is examination producing an understanding." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalStructureAssessment ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that maps job-specific roles within the organizational chart and examines the value added by each position, producing an organizational structure assessment." ;
    skos:example "An analyst maps every role to its value contribution across operations." ;
    bpot:apqcSourceText "Appraising job-specific roles within the organizational chart and their hierarchical architecture. Analyze a map of work-related roles within the organizational structure. Examine the value added by the positions associated with jobs to be performed and how they stack up within the organization's operations." ;
    bpot:hierarchyID "1.2.5.2" ;
    bpot:pcfID "10050" .

bpot:P10051 a owl:Class ;
    rdfs:label "Develop role activity diagrams to assess hand-off activity" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: deconstruct roles into activities and visualize their relations." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RoleActivityDiagram ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that deconstructs job-specific roles into their constituent activities and produces a role activity diagram." ;
    skos:example "An analyst breaks a manager role into tasks and charts the hand-offs between them." ;
    bpot:apqcSourceText "Examining the constituent exercises and undertakings within a work-related position for the purpose of effective delegation. Deconstruct job-specific roles into activities and visualize the relations among them, with the objective of assigning responsibilities to the appropriate personnel." ;
    bpot:hierarchyID "1.2.5.3" ;
    bpot:pcfID "10051" .

bpot:P10052 a owl:Class ;
    rdfs:label "Perform organization redesign workshops" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): the workshop transfers the organizational design ICE to personnel. The organizational design is the definitional input; personnel are participants. CHOSEN READING (Gate-F): Communication, because the source's purpose is to 'COMMUNICATE the organizational structure ... to facilitate an effective UNDERSTANDING among personnel' -- conveyance of an existing ICE. Rejected bpo:ActOfFormulation (the design already exists; the workshop disseminates rather than composes it) and cco:ont00000234 Act of Training (no skills/values are imparted, only the structure is explained)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:OrganizationalDesign ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:StrategyPersonnel ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that conveys the proposed organizational design to personnel through participative workshop sessions to build shared understanding." ;
    skos:example "Facilitators run redesign workshops to walk staff through the new structure and role map." ;
    bpot:apqcSourceText "Organizing workshop sessions to adopt organizational redesign. Communicate the organizational structure and mapping of responsibilities against job roles in order to facilitate an effective understanding among personnel. Use a collaborative process that may include participative workshop sessions." ;
    bpot:hierarchyID "1.2.5.4" ;
    bpot:pcfID "10052" .

bpot:P10053 a owl:Class ;
    rdfs:label "Design the relationships between organizational units" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): formalizes relationships as part of the organizational design." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalDesign ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that delineates and formalizes the relationships and dependencies among the organization's units and produces an organizational design of inter-unit relationships." ;
    skos:example "Designers formalize the dependencies and shared resources between two divisions." ;
    bpot:apqcSourceText "Fleshing out the connections and dependencies among the various units of the organization. Delineate the relationship among business units or process frameworks within the organization, in terms of activities, synergies, and shared resources and responsibilities. Formalize relationships among business units so that any mutual coherence is clearly understood and can be attended to." ;
    bpot:hierarchyID "1.2.5.5" ;
    bpot:pcfID "10053" .

bpot:P10054 a owl:Class ;
    rdfs:label "Develop role analysis and activity diagrams for key processes" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: deconstruct key processes and examine roles. Takes cues from 1.2.5.3 (PCF 10051) per the source." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RoleActivityDiagram ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that deconstructs key processes into activities and examines the fit between job roles and those processes, producing a role activity diagram." ;
    skos:example "An analyst maps roles to each step of the order-to-cash process." ;
    bpot:apqcSourceText "Creating an understanding of the fit between job roles and organizational processes in order to properly place personnel. Deconstruct key processes into constituent activities, and examine job-related roles. Take cues from Develop role activity diagrams to assess hand-off activity [10051]. Map appropriate positions against these important processes, which in turn expedite the deployment of staff members." ;
    bpot:hierarchyID "1.2.5.6" ;
    bpot:pcfID "10054" .

bpot:P10055 a owl:Class ;
    rdfs:label "Assess organizational implication of feasible alternatives" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation of options. The organizational design options are the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:OrganizationalDesign ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalStructureAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the long-term repercussions of each feasible organizational design option and produces an organizational structure assessment." ;
    skos:example "An analyst weighs the multi-year impact of three candidate structures." ;
    bpot:apqcSourceText "Probing the repercussions of all practicable organizational design options. Analyze the significance and impact of workable organizational structure options. Closely examine the long-term impact of these frameworks over the functioning of the organization." ;
    bpot:hierarchyID "1.2.5.7" ;
    bpot:pcfID "10055" .

bpot:P10056 a owl:Class ;
    rdfs:label "Migrate to new organization" ;
    rdfs:comment "Output replaced (Gate-F) from the subject-mismatched bpo:InitiativeSelectionDecision (which prescribes which strategic INITIATIVES to pursue) with the subject-matched Directive bpo:OrganizationalStructureAdoptionDecision, parallel to bpo:BusinessModelAdoptionDecision. CHOSEN READING (reconciled with sibling-in-kind P20949 'Adopt the business model'): anchored to cco:ont00000228 (Planned Act). Both leaves RATIFY a single best-fit option already settled by a prior assessment (here P10055), which is a commitment/ratification, not a choice among a candidate set -- so bpo:ActOfSelection (definitionally 'chooses from a SET of candidates') does not fit. No narrower CCO act denotes ratification, so it anchors at the generic Planned Act. The organizational design is the definitional input; the ratification decision is the output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:OrganizationalDesign ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalStructureAdoptionDecision ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that ratifies the best-fit organizational design already determined among the assessed alternatives and produces an organizational-structure adoption decision adopting the new structure." ;
    skos:example "Leadership formally ratifies the new operating structure and authorizes the move to it." ;
    bpot:apqcSourceText "Embracing and ratifying a new organizational structure. (Assume the new framework to be the best fit through Assess the organizational implications of feasible alternatives [10055].)" ;
    bpot:hierarchyID "1.2.5.8" ;
    bpot:pcfID "10056" .

bpot:P10057 a owl:Class ;
    rdfs:label "Develop strategic initiatives" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511 Act of Planning): developing initiatives produces a Directive ICE (the specification). Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicInitiativeSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19975 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19976 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19977 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes discretionary, time-bound strategic projects supporting long-term goals and produces a strategic-initiative specification." ;
    skos:example "A strategy team drafts a slate of discretionary projects to advance the firm's ten-year goals." ;
    bpot:apqcSourceText "Developing strategic projects that help fulfill long-term goals. Develop time-bound projects that are discretionary in nature and lie beyond the scope of the organization's routine operations." ;
    bpot:hierarchyID "1.3.1" ;
    bpot:pcfID "10057" .

bpot:P10058 a owl:Class ;
    rdfs:label "Evaluate strategic initiatives" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the act judges applicability and feasibility. Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicInitiativeSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicInitiativeEvaluation ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19978 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19979 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that examines strategic initiatives for applicability and feasibility against the organization's vision and produces a strategic-initiative evaluation." ;
    skos:example "A review board appraises each candidate initiative for fit with the firm's vision and constraints." ;
    bpot:apqcSourceText "Examining projects of strategic significance that lie outside the purview of the organization's routine operations. Closely analyze strategic initiatives for their applicability and feasibility, given the organization's vision." ;
    bpot:hierarchyID "1.3.2" ;
    bpot:pcfID "10058" .

bpot:P10059 a owl:Class ;
    rdfs:label "Select strategic initiatives" ;
    rdfs:comment "Anchored to bpo:ActOfSelection (under cco:ont00000366 Act of Information Processing). Senior management participant is definitional (the source enlists them). Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicInitiativeEvaluation ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:InitiativeSelectionDecision ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:SeniorManagement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19980 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19981 ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses strategic initiatives from the evaluated set on the basis of suitability to the organization's constraints and produces an initiative selection decision." ;
    skos:example "Senior managers and strategists pick the initiatives the firm will fund this cycle." ;
    bpot:apqcSourceText "Selecting relevant projects of strategic significance that create opportunities for the organization to realize its long-term objectives, on the basis of their suitability to the organization's constraints and reality. Select from the process Evaluate strategic initiatives [10058], based on their applicability and feasibility for the organization. Enlist senior management, especially strategy personnel." ;
    bpot:hierarchyID "1.3.3" ;
    bpot:pcfID "10059" .

bpot:P10060 a owl:Class ;
    rdfs:label "Establish high-level measures" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511): devising measures produces a Directive ICE (the metrics). Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceMetric ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19982 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19983 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19984 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that devises evaluation criteria for assessing the impact of strategic initiatives and produces a set of performance metrics." ;
    skos:example "A team defines the high-level KPIs by which the initiatives' impact will be judged." ;
    bpot:apqcSourceText "Devising measures to examine strategic projects. Formulate evaluation criteria to assess the strategic initiatives for the level of impact." ;
    bpot:hierarchyID "1.3.4" ;
    bpot:pcfID "10060" .

bpot:P13289 a owl:Class ;
    rdfs:label "Identify implications for key operating model business elements that require change" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: 'determine impacts ... which need change' discerns and registers affected elements." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicOption ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns which operating-model elements require change under a strategic option and produces a strategic-option analysis of those implications." ;
    skos:example "An analyst lists the staffing and policy changes a candidate strategy would force on the operating model." ;
    bpot:apqcSourceText "Determine impacts of elements such as staffing, skills, training, new markets, technology, or policies within operating model which needs change." ;
    bpot:hierarchyID "1.2.2.2.1" ;
    bpot:pcfID "13289" .

bpot:P13290 a owl:Class ;
    rdfs:label "Identify implications for key technology aspects" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: 'determining key factors for technology ROI, benefits, architecture' discerns and registers the technology implications of an option." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicOption ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the key technology factors implicated by a strategic option and produces a strategic-option analysis of technology implications." ;
    skos:example "An architect identifies the ROI and architecture impacts of a proposed strategy." ;
    bpot:apqcSourceText "Determining key factors for technology ROI, benefits, architecture, etc." ;
    bpot:hierarchyID "1.2.2.2.2" ;
    bpot:pcfID "13290" .

bpot:P14189 a owl:Class ;
    rdfs:label "Develop sustainability strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: composes a sustainability strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes strategies for the long-run sustenance and vitality of the business and produces a business strategy for sustainability." ;
    skos:example "A sustainability office formulates the firm's long-term ESG strategy and resource commitments." ;
    bpot:apqcSourceText "Formulating strategic options that create opportunities for the sustenance and prosperity of the business in the long run. Go beyond business longevity to consider alternate strategies that allow the organizations preservation of vitality over time. Earmark resources and target processes, the former of which are dedicated to the absorption of sustainable practices in the latter." ;
    bpot:hierarchyID "1.2.3.2" ;
    bpot:pcfID "14189" .

bpot:P14197 a owl:Class ;
    rdfs:label "Develop lean/continuous improvement strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: composes a continuous-improvement strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a roadmap for continuous optimization of processes and functional areas and produces a business strategy for continuous improvement." ;
    skos:example "A lean office formulates the multi-year continuous-improvement roadmap." ;
    bpot:apqcSourceText "Developing strategies for the optimization of processes and the improvement of functional areas in order to improve the bottom line. Create a road map of decision choices that would allow the organization to continuously enhance process efficiencies and advance performance standards." ;
    bpot:hierarchyID "1.2.3.7" ;
    bpot:pcfID "14197" .

bpot:P16612 a owl:Class ;
    rdfs:label "Define and manage personas" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: 'identifying a set of characteristics that define ... patterns of the customer'. Modeled as a bounded act despite 'manage' in the label, because the source describes a definable identification activity producing a customer profile. Gate-F split: the source's standing 'manage and optimize your interactions with the contacts classified by a persona' aspect is NOT part of this bounded act -- it is a continuant standing function carried by the already-minted bpo:CustomerExperienceManagementCapability (Organization Capability), realized in repeated CX-management acts. This leaf captures only the bounded persona-definition occurrent (R5 bounded-occurrent test)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerProfile ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the demographic and behavioral characteristics defining customer personas and produces a customer profile." ;
    skos:example "A marketer defines three buyer personas from demographic and behavioral data." ;
    bpot:apqcSourceText "Identifying a set of characteristics that define the demographic and behavioral patterns of the customer. Further, use persona scoring to design your marketing strategies around personas, and measure and optimize your interactions with the contacts classified by a certain persona." ;
    bpot:hierarchyID "1.2.8.2.1" ;
    bpot:pcfID "16612" .

bpot:P16790 a owl:Class ;
    rdfs:label "Evaluate intellectual property" ;
    rdfs:comment "Carried over from GOLD module (bpo:EstablishIPThreatMeasures). Anchored to cco:ont00000511 (Act of Planning)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:IPThreatMeasureSpecification ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that has as output an IP threat measure specification prescribing procedures for identifying intellectual-property threats." ;
    skos:example "Legal counsel establishes a procedure for screening incoming filings for IP-infringement risk." ;
    bpot:apqcSourceText "Establishing measures and procedures for identifying various intellectual property threats and concerns." ;
    bpot:hierarchyID "1.1.1.10" ;
    bpot:pcfID "16790" .

bpot:P16792 a owl:Class ;
    rdfs:label "Conduct organization restructuring opportunities" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): the dominant gerund is examining/probing restructuring options for viability. Its APQC children are process parts; deal execution is a downstream consequence noted in the source." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RestructuringOpportunityAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16793 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16794 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16795 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that examines the scope and contingencies for restructuring an organization in light of market and internal realities and produces a restructuring opportunity analysis." ;
    skos:example "A corporate-development team probes merger and divestment options and documents a restructuring opportunity analysis." ;
    bpot:apqcSourceText "Examining the scope and contingencies for restructuring based on market situation and internal realities. Map the market forces over which any and all probabilities can be probed for utility and viability. Once the restructuring options have been analyzed and the due-diligence performed, execute the deal. Consider seeking professional services for assistance in formalizing these opportunities." ;
    bpot:hierarchyID "1.1.5" ;
    bpot:pcfID "16792" .

bpot:P16793 a owl:Class ;
    rdfs:label "Identify restructuring opportunities" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment sense): it discerns and registers restructuring opportunities from internal and market review." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RestructuringOpportunityAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that has as input internal-capability data and market data and has as output a restructuring opportunity analysis registering candidate restructuring opportunities." ;
    skos:example "A strategy team surveys the market and internal readiness and lists viable restructuring opportunities." ;
    bpot:apqcSourceText "Identifying opportunities for restructuring the organization, through an analysis of internal viability and external contingency. Conduct a broad-based survey of the market landscape, taking the large-scale trends and movements into account, to determine the necessity and possibility of restructuring the organization. Review the organization's internal capacities, the readiness of its process frameworks, the robustness of its financials, the capableness of its systems, the resourcefulness of its personnel, etc. for assimilating an extensive overhaul." ;
    bpot:hierarchyID "1.1.5.1" ;
    bpot:pcfID "16793" .

bpot:P16794 a owl:Class ;
    rdfs:label "Perform due-diligence" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): an audit verifying facts is an evaluation/judgement. Professional-services providers noted as typical (non-definitional) participant in source." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RestructuringOpportunityAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DueDiligenceReport ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a restructuring opportunity analysis and has as output a due-diligence report verifying the tangible and substantial facts about candidate entities." ;
    skos:example "Advisors audit a target company's financials and legal status and issue a due-diligence report." ;
    bpot:apqcSourceText "Auditing the status quo of the probabilities, before formalizing any restructuring of the organization with another entity. Systematically investigate all entities discerned to be of interest in Identify restructuring opportunities [16793], to verify all tangible and substantial facts. Consider engaging specialist professional services including legal, accounting, and consulting help." ;
    bpot:hierarchyID "1.1.5.2" ;
    bpot:pcfID "16794" .

bpot:P16795 a owl:Class ;
    rdfs:label "Analyze deal options" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: it examines and compares shortlisted deal options. Its APQC tasks are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DueDiligenceReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DealOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16796 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16797 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16798 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16799 ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input a due-diligence report and has as output a deal-option analysis comparing acquisition, merger, de-merger, and divestment options." ;
    skos:example "A corporate-development team compares acquisition and divestment options and documents a deal-option analysis." ;
    bpot:apqcSourceText "Examining various options shortlisted for assimilating new entities into the organization or dissociating from it. Undertake a piecemeal and comprehensive consideration of each option identified for acquisition, merger, de-merger, and divestment. Consider intangible and non-material aspects of the entities involved and synergic aspects. Consider the assistance of specialist professional services." ;
    bpot:hierarchyID "1.1.5.3" ;
    bpot:pcfID "16795" .

bpot:P16796 a owl:Class ;
    rdfs:label "Evaluate acquisition options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it appraises acquisition candidates for fit and viability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DealOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessValueAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a deal-option analysis and has as output a business value assessment of the suitability and viability of entities shortlisted for acquisition." ;
    skos:example "An M&A team appraises an acquisition target's fit and reports its business value." ;
    bpot:apqcSourceText "Appraising entities identified as being suitable for acquisition, taking into account the restructuring opportunities in the internal and external context. Verify the appropriateness and viability of the short-listed options. Ensure these entities pertain to the state-of-affairs in the market, as well as fit with the resources and capabilities of the organization." ;
    bpot:hierarchyID "1.1.5.3.1" ;
    bpot:pcfID "16796" .

bpot:P16797 a owl:Class ;
    rdfs:label "Evaluate merger options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal). In-house personnel or professional-services providers are typical (non-definitional) participants per source." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DealOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessValueAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a deal-option analysis and has as output a business value assessment of the suitability and viability of entities shortlisted for a merger." ;
    skos:example "A strategy team appraises a merger candidate's fit and reports its business value." ;
    bpot:apqcSourceText "Appraising entities identified as being suitable for a merger, taking stock of the restructuring opportunities within the firm and the market. Verify the appropriateness and viability of such options. Assess these entities to ensure their pertinence to the contextual state-of-affairs in the market, as well as a fit with the resources and capabilities of the organization itself. (This process can be carried out, in its entirety, by qualified in-house personnel or may be designated to specialist professional services providers.)" ;
    bpot:hierarchyID "1.1.5.3.2" ;
    bpot:pcfID "16797" .

bpot:P16798 a owl:Class ;
    rdfs:label "Evaluate de-merger options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges the soundness of a de-merger." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DealOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessValueAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a deal-option analysis and has as output a business value assessment of the appropriateness of de-merging departments, subsidiaries, or previously merged entities." ;
    skos:example "A corporate-development team evaluates spinning off a subsidiary and reports its business value." ;
    bpot:apqcSourceText "Evaluating departments and subsidiaries within the organization, and/or previously merged entities, to assess the appropriateness of a de-merger, taking account of the fit between these entities as well as any relevant externalities. Examine the pertinence and soundness of a formalized dissociation." ;
    bpot:hierarchyID "1.1.5.3.3" ;
    bpot:pcfID "16798" .

bpot:P16799 a owl:Class ;
    rdfs:label "Evaluate divesture options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it judges the soundness of a divestment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:DealOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessValueAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a deal-option analysis and has as output a business value assessment of the appropriateness of divesting departments or subsidiaries." ;
    skos:example "A strategy team evaluates divesting a business unit and reports its business value." ;
    bpot:apqcSourceText "Evaluating departments and/or subsidiaries within the organization to assess the appropriateness of a divestment, taking account of all market externalities. Examine any internal entities that have been identified to be suitable for dismemberment from the organization. Ensure the pertinence and soundness of such a move." ;
    bpot:hierarchyID "1.1.5.3.4" ;
    bpot:pcfID "16799" .

bpot:P16803 a owl:Class ;
    rdfs:label "Develop partner/alliance strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: creating a vision, objectives, and measures composes a partnership strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines the direction, objectives, and measures for partnering with other companies and produces a business strategy for alliances." ;
    skos:example "An alliance office drafts the multi-year partnership strategy and its success measures." ;
    bpot:apqcSourceText "Defining direction and plan objectives for partnering with other companies to deliver product/services. Focus on creating a vision and strategic objectives and culminate in creating measures for the strategic alliance or partnership." ;
    bpot:hierarchyID "1.2.3.1" ;
    bpot:pcfID "16803" .

bpot:P16805 a owl:Class ;
    rdfs:label "Develop merger/demerger/acquisition/exit strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: composes a strategy and an evaluation framework. The candidate-evaluation framework is recorded informally as a secondary output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines a corporate-development strategy for mergers, demergers, acquisitions, and exits and produces a business strategy together with a framework for evaluating candidates." ;
    skos:example "Corporate development drafts the M&A strategy and the screening criteria for targets." ;
    bpot:apqcSourceText "Defining a strategy for corporate development. Include providing a framework for evaluating merger and acquisition candidates; and planning for a value creation through merging/demerging with a company, acquiring a company, or exiting from an already merged/acquired company." ;
    bpot:hierarchyID "1.2.3.3" ;
    bpot:pcfID "16805" .

bpot:P18083 a owl:Class ;
    rdfs:label "Select partnerships and relationships to support the extended enterprise" ;
    rdfs:comment "Anchored to bpo:ActOfSelection: 'make strategic choices' commits to make-vs-buy and partnership options. Added (Gate-F) the Directive chosen-option output bpo:PartnershipSelectionDecision required by the Selection genus (the Golden Principle ties a Selection act to a Directive decision output); previously only the Descriptive bpo:StrategicOptionAnalysis was asserted, which the genus alone did not satisfy. The analysis is retained as the supporting evidence the decision rests on." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicOption ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PartnershipSelectionDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that chooses among make-versus-buy and partnership options for the extended enterprise and produces a partnership selection decision prescribing the chosen relationships." ;
    skos:example "Executives decide to outsource distribution and franchise dealerships rather than run them in-house." ;
    bpot:apqcSourceText "Supporting the design, manufacture and distribution of product and services through the extended enterprise model.  This is concerned with the strategic decisions on make vs buy, in house or out sourced.  Senior Executives map out how they want to run their business.  Make strategic choices as to whether to buy in components / sub-assemblies, run their own distribution fleet or contract out, own their dealerships or franchise out, etc.  Strategize with partnerships. Collaborate design consideration at strategy level for automotive and procurement act within the Target Operating Model set at strategy level." ;
    bpot:hierarchyID "1.2.2.1.1" ;
    bpot:pcfID "18083" .

bpot:P18916 a owl:Class ;
    rdfs:label "Communicate strategies internally and externally" ;
    rdfs:comment "Anchored to cco:ont00000402 (Act of Communication): an existing business strategy ICE is transferred from the organization to internal and external stakeholders. The business strategy is the definitional input; stakeholders are participants. Leaf process." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000228,
        cco:ont00000402 ;
    skos:definition "An Act of Communication that conveys the organization's business strategy to internal departments and external stakeholders." ;
    skos:example "Leadership rolls out the new strategy to staff, customers, and suppliers via briefings and publications." ;
    bpot:apqcSourceText "Conveying planned procedures and methods to both internal departments and external stakeholders like customers, suppliers, etc., in an effective manner based on organizational objective." ;
    bpot:hierarchyID "1.2.9" ;
    bpot:pcfID "18916" .

bpot:P19507 a owl:Class ;
    rdfs:label "Execute strategic initiatives" ;
    rdfs:comment "Anchored directly to cco:ont00000228 (Planned Act): no narrower CCO act denotes execution/implementation, and execution is prescribed by the initiative specification (the Directive ICE). DELIBERATE non-mint: not Act of Planning/Appraisal/Measuring -- it carries out rather than plans or judges." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicInitiativeSpecification ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that implements the connected activities prescribed by a strategic-initiative specification in order to make the strategy work." ;
    skos:example "Project teams carry out the funded initiatives across the organization." ;
    bpot:apqcSourceText "Successfully implement strategic initiatives. Execution of strategy is also defined as the process of implementing logical set of connected activities by an organization to make a strategy work." ;
    bpot:hierarchyID "1.3.5" ;
    bpot:pcfID "19507" .

bpot:P19946 a owl:Class ;
    rdfs:label "Capture customer needs and wants" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment sense): it discerns and registers which consumer needs are important." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerNeedsAssessment ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that has as input customer feedback and has as output a customer needs assessment registering customers' wants and needs." ;
    skos:example "A marketing analyst collects survey responses and registers the unmet needs of a customer segment." ;
    bpot:apqcSourceText "Identifying and collecting customers' wants and needs of a product and/or services from a marketing perspective. Identify which consumer needs are important and whether needs are being met by current products/services." ;
    bpot:hierarchyID "1.1.2.2" ;
    bpot:pcfID "19946" .

bpot:P19947 a owl:Class ;
    rdfs:label "Assess customer needs and wants" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000636 (Act of Appraisal) to bpo:ActOfIdentification: the source is 'creating customer profiles ... identify particular groups of people/organizations' -- profiling/segmentation is discernment, and its Descriptive output bpo:CustomerProfile agrees with the Information-Processing genus. Rejected Act of Appraisal: there is no evaluative value-judgement here, only characterization of segments." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerNeedsAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerProfile ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns and characterizes groups of customers who benefit from an organization's products or services and produces a customer profile of those groups and their needs." ;
    skos:example "An analyst segments the market and builds customer profiles for the strategy team." ;
    bpot:apqcSourceText "Creating customer profiles to get a picture of customers and their needs. Identify particular groups of people/organizations that benefit from your product/services and then selling to them." ;
    bpot:hierarchyID "1.1.2.3" ;
    bpot:pcfID "19947" .

bpot:P19948 a owl:Class ;
    rdfs:label "Analyze internal operations" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: it examines and measures operational elements." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:InternalOperationsAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input internal-capability data and has as output an internal-operations analysis measuring the effectiveness of operational elements." ;
    skos:example "An operations team measures the effectiveness of key processes and reports an internal-operations analysis." ;
    bpot:apqcSourceText "Identify key elements of operations and measure effectiveness of these elements within internal operations." ;
    bpot:hierarchyID "1.1.3.2" ;
    bpot:pcfID "19948" .

bpot:P19949 a owl:Class ;
    rdfs:label "Define the strategic vision" ;
    rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it formulates and documents a directive vision and its goals." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicVision ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalObjective ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that has as output a strategic vision documenting the goals, direction, and activities that define an organization's vision." ;
    skos:example "A strategy team drafts and documents the firm's strategic vision statement." ;
    bpot:apqcSourceText "Developing goals to define organizations vision. Define and document ideas, direction, and activities which enable the organization to reach these goals." ;
    bpot:hierarchyID "1.1.4.1" ;
    bpot:pcfID "19949" .

bpot:P19950 a owl:Class ;
    rdfs:label "Develop global support strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: composes a global-support strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a plan to deploy support services globally and produces a business strategy for global support." ;
    skos:example "A shared-services office formulates the plan to deliver global support at scale." ;
    bpot:apqcSourceText "Developing a plan to deploy support services and support functions throughout the organization globally. Arrange the organizations functional support areas to create efficiencies of scale in the delivery of support services, globally." ;
    bpot:hierarchyID "1.2.3.5" ;
    bpot:pcfID "19950" .

bpot:P19951 a owl:Class ;
    rdfs:label "Develop shared services strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: composes a shared-services strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that charts a plan to leverage internal shared services and produces a business strategy for shared services." ;
    skos:example "A transformation office formulates the strategy to consolidate functions into shared services." ;
    bpot:apqcSourceText "Charting a plan to leverage internal services and support functions throughout the organization. Delineate a framework of parameters and criteria to selectively filter service areas for inclusion among the organizations common resources. Arrange the organizations functional areas to create efficiencies of scale in the delivery of internal services." ;
    bpot:hierarchyID "1.2.3.6" ;
    bpot:pcfID "19951" .

bpot:P19952 a owl:Class ;
    rdfs:label "Develop innovation strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation: composes an innovation strategy/roadmap." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a plan and roadmap to advance technology and products and produces a business strategy for innovation." ;
    skos:example "An R&D leadership team formulates the three-year innovation roadmap." ;
    bpot:apqcSourceText "Developing a plan and vision to encourage advancements in technology or product/services. Create a roadmap for changing or innovating the business model to make business operations more competitive. Set up new R&D services for changing or bringing new value propositions, services, production processes, and invention of technology not previously used by competitors etc." ;
    bpot:hierarchyID "1.2.3.4" ;
    bpot:pcfID "19952" .

bpot:P19953 a owl:Class ;
    rdfs:label "Identify organizational objectives" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation rather than bpo:ActOfIdentification: the source says 'creating and developing strategic objectives', i.e. composing new prescriptive goals, not discerning pre-existing entities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:OrganizationalObjective ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that creates strategic objectives outlining expected outcomes for the organization and produces organizational objectives." ;
    skos:example "Strategy leadership drafts the outcome-oriented objectives that will guide employee effort." ;
    bpot:apqcSourceText "Creating and developing strategic objectives that establishes a process to outline expected outcomes and guide employees' efforts." ;
    bpot:hierarchyID "1.2.6.1" ;
    bpot:pcfID "19953" .

bpot:P19954 a owl:Class ;
    rdfs:label "Establish baseline metrics" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): composes prescriptive standards. Organizational objectives are the definitional input the metrics are derived from." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:OrganizationalObjective ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceMetric ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes baseline metrics and KPIs as standards for assessing performance and produces a set of performance metrics." ;
    skos:example "A performance office defines the KPI baselines for each function from the organizational goals." ;
    bpot:apqcSourceText "Establishing baselines that provide standards for assessing performance. Create metrics and KPI's for various functions/processes/activities based on organizational goals." ;
    bpot:hierarchyID "1.2.6.2" ;
    bpot:pcfID "19954" .

bpot:P19955 a owl:Class ;
    rdfs:label "Monitor performance against objective" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000636 (Act of Appraisal) to bpo:ActOfFormulation: the source's lead verb is 'DEFINING methodology and frequency of assessment', i.e. composing a Directive monitoring-method spec, not actually rendering the value-judgement. The existential bpo:PerformanceReport output is removed (it is produced by the downstream monitoring runs, not by this defining act); the new Directive output bpo:PerformanceMonitoringMethodSpecification agrees with the Formulation genus. Performance metrics are the definitional standard the method monitors against." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceMetric ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceMonitoringMethodSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines the methodology and frequency for measuring and monitoring the performance of functions, processes, and activities against set goals, and produces a performance-monitoring method specification." ;
    skos:example "A performance office defines the quarterly methodology and cadence for monitoring each function's KPIs." ;
    bpot:apqcSourceText "Defining methodology and frequency of assessment for measuring and monitoring performance of various functions/processes/activities against standard set goals." ;
    bpot:hierarchyID "1.2.6.3" ;
    bpot:pcfID "19955" .

bpot:P19956 a owl:Class ;
    rdfs:label "Analyze business unit strategies" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): assessing performance against goals. Performance metrics are the definitional standard input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceMetric ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceReport ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that assesses a business unit's performance against organizational goals using predefined metrics and produces a performance report." ;
    skos:example "An analyst assesses a division's results against its KPI targets." ;
    bpot:apqcSourceText "Assessing the performance of a business unit against set organizational goals which are based on pre-defined metrics collected through various business unit operations." ;
    bpot:hierarchyID "1.2.7.1" ;
    bpot:pcfID "19956" .

bpot:P19957 a owl:Class ;
    rdfs:label "Identify core competency for each business unit" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: 'determining the resources and skills of each business unit' discerns and registers existing capacities." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InternalCapabilityData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CoreCompetencyAnalysis ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the resources and skills constituting each business unit's core competency and produces a core competency analysis." ;
    skos:example "An analyst catalogs each unit's distinctive technical capabilities." ;
    bpot:apqcSourceText "Determining the resources and skills of each business unit based on knowledge and technical capacity. Enable business units to meet customer needs and grow in a competitive marketplace." ;
    bpot:hierarchyID "1.2.7.2" ;
    bpot:pcfID "19957" .

bpot:P19958 a owl:Class ;
    rdfs:label "Refine business unit strategies in support of organizational strategy" ;
    rdfs:comment "Re-anchored (Gate-F) from bpo:ActOfSelection to bpo:ActOfFormulation: the act takes an existing bpo:BusinessStrategy and emits a revised bpo:BusinessStrategy (a Directive plan in, a Directive plan out) -- this is reformulation of a plan, not the selection of one option from a set of candidates. Rejected Act of Selection: there is no slate of discrete candidate strategies being chosen among; the single existing strategy is being re-worked. The enterprise business strategy is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that reformulates an existing business-unit strategy in light of the enterprise strategy, pruning and re-considering its resources and elements, and produces a refined business strategy." ;
    skos:example "A division reworks its strategy to drop initiatives that conflict with the enterprise strategy." ;
    bpot:apqcSourceText "Evaluating existing business unit strategy based on the company's strategy and eliminate unwanted/unnecessary resources/elements and re-consider necessary resources to meet the overall company's strategy." ;
    bpot:hierarchyID "1.2.7.3" ;
    bpot:pcfID "19958" .

bpot:P19959 a owl:Class ;
    rdfs:label "Develop customer experience strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): composes a customer-experience strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceRoadmap ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19960 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19964 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19971 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19974 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines a roadmap to meet customer expectations and produces a customer experience roadmap." ;
    skos:example "A CX office drafts the multi-year roadmap for improving customer experience." ;
    bpot:apqcSourceText "Defining a roadmap to meet customer expectations while considering how it will affect the business." ;
    bpot:hierarchyID "1.2.8" ;
    bpot:pcfID "19959" .

bpot:P19960 a owl:Class ;
    rdfs:label "Assess customer experience" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): measuring customer feedback based on satisfaction. Customer feedback is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceAssessment ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19961 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19962 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19963 ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that measures customer feedback on product and service effectiveness and produces a customer experience assessment." ;
    skos:example "A CX team scores satisfaction from survey responses on delivered services." ;
    bpot:apqcSourceText "Measuring customer feedback in regard to product and services effectiveness based on overall satisfaction. The data to be analyzed is collected through surveys, customer responses, and feedbacks based on the delivered products/services." ;
    bpot:hierarchyID "1.2.8.1" ;
    bpot:pcfID "19960" .

bpot:P19961 a owl:Class ;
    rdfs:label "Identify and review customer touchpoints" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: 'review ... evaluate touchpoints ... e.g. billboards, web sites' discerns and registers the relevant touchpoints. Output replaced (Gate-F) from the off-target bpo:CustomerExperienceAssessment (a satisfaction/feedback measure, the output of the appraisal sibling P19962) with the discernment-matched bpo:CustomerTouchpointInventory (a register of touchpoints). Customer feedback is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerTouchpointInventory ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns and reviews the customer touchpoints relevant to a product or service and produces a customer touchpoint inventory." ;
    skos:example "A CX analyst enumerates and reviews every channel through which customers reach the brand." ;
    bpot:apqcSourceText "Creating methods to gauge customer experiences, expectations, and suggestions. Review both liked and disliked areas of product/services to be delivered. Evaluate touchpoints based on the nature of product/service in the market e.g., billboards, web sites, direct mail, service calls, etc." ;
    bpot:hierarchyID "1.2.8.1.1" ;
    bpot:pcfID "19961" .

bpot:P19962 a owl:Class ;
    rdfs:label "Assess customer experience across touchpoints" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'evaluating customer experiences ... evaluate the gaps'. Customer feedback is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates customer experiences and gaps across all touchpoints in the relationship lifecycle and produces a customer experience assessment." ;
    skos:example "A CX team scores experience quality at each interaction across the customer lifecycle." ;
    bpot:apqcSourceText "Evaluating customer experiences, expectations, and suggestions in both liked and disliked areas of the product or services. Analyze all modes of communication, human and physical interactions, or customers experience during the relationship lifecycle with your organization. Evaluate the gaps/further development/alterations to the existing product/service to attain better customer response." ;
    bpot:hierarchyID "1.2.8.1.2" ;
    bpot:pcfID "19962" .

bpot:P19963 a owl:Class ;
    rdfs:label "Perform root cause analysis of problematic customer experiences" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: 'analyzing the core reason for the customer experience'. Customer feedback is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RootCauseAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines the core reasons behind problematic customer experiences and produces a root cause analysis." ;
    skos:example "An analyst traces recurring complaints to a flawed onboarding step." ;
    bpot:apqcSourceText "Analyzing the core reason for the customer experience/feedback/response about the product/service to take considerable action for better customer experience." ;
    bpot:hierarchyID "1.2.8.1.3" ;
    bpot:pcfID "19963" .

bpot:P19964 a owl:Class ;
    rdfs:label "Design customer experience" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): composes a prescriptive design. Customer data is the definitional input it is built from." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceRoadmap ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P16612 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19965 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19966 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19967 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19968 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19969 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19970 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that designs how customers interact with the business from captured customer data and produces a customer experience roadmap." ;
    skos:example "A CX team designs the target interaction model from voice-of-customer research." ;
    bpot:apqcSourceText "Creating a design of how customers interact with the business by analyzing data captured through various customer interaction and customer involvement. These will be captured through various channels such as customer satisfaction surveys, feedback forms, product reviews, targeted studies, observational studies, or voice of customer research." ;
    bpot:hierarchyID "1.2.8.2" ;
    bpot:pcfID "19964" .

bpot:P19965 a owl:Class ;
    rdfs:label "Create customer journey maps" ;
    rdfs:comment "Anchored to bpo:ActOfAnalysis: 'creating a story of the customer's experience ... to teach the organization about the customer' produces an analytic representation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerJourneyMap ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that traces the customer's experience from initial contact through long-term relationship and produces a customer journey map." ;
    skos:example "A CX designer charts the end-to-end journey from awareness to renewal." ;
    bpot:apqcSourceText "Creating a story of the customer's experience: from initial contact, through the process of engagement and into a long-term relationship. The goal is to teach organization about the customer." ;
    bpot:hierarchyID "1.2.8.2.2" ;
    bpot:pcfID "19965" .

bpot:P19966 a owl:Class ;
    rdfs:label "Define single view of the customer for the organization" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): 'defining parameters ... which enable the tracking of customers' composes a prescriptive specification." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerProfile ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines the parameters for an aggregated, holistic representation of customer data and produces a customer profile specification." ;
    skos:example "A data team defines the unified customer-record parameters spanning all channels." ;
    bpot:apqcSourceText "Defining parameters to show aggregated, consistent, and holistic representation of known data about customers. Define key parameters which enable the tracking of customers and communications across every channel." ;
    bpot:hierarchyID "1.2.8.2.3" ;
    bpot:pcfID "19966" .

bpot:P19967 a owl:Class ;
    rdfs:label "Define a vision for the customer experience" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): 'establishing a direction and vision' composes a prescriptive vision; reuses bpo:StrategicVision." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicVision ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes a direction and vision for how the organization behaves toward customers and produces a strategic vision for the customer experience." ;
    skos:example "Leadership articulates the guiding vision for every customer interaction." ;
    bpot:apqcSourceText "Establishing a direction and vision on how the organization behaves towards customers in a consistent, effective way. The key attributes for customer experience vision consists of emotional connection, commitments and expectations, compelling value proposition, and ease of understanding the organization's behavior." ;
    bpot:hierarchyID "1.2.8.2.4" ;
    bpot:pcfID "19967" .

bpot:P19968 a owl:Class ;
    rdfs:label "Validate with customers" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'validate ... understand if the products/services have a repeatable, scalable business model' evaluates assumptions against evidence. Customer feedback is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that tests the assumptions underpinning the business model against customer reality and produces a customer experience assessment." ;
    skos:example "A product team validates the pricing assumptions through customer interviews." ;
    bpot:apqcSourceText "Creating a process to validate the sales process and the assumptions that underpin the business model. Understand if the products/services have a repeatable, scalable business model around that product." ;
    bpot:hierarchyID "1.2.8.2.5" ;
    bpot:pcfID "19968" .

bpot:P19969 a owl:Class ;
    rdfs:label "Align experience with brand values and business strategies" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): aligns experience to brand/strategy. The business strategy is the definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceRoadmap ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that aligns the customer experience with the brand's value proposition and business strategies and produces a customer experience roadmap." ;
    skos:example "A brand team aligns the service experience to the brand promise and strategy." ;
    bpot:apqcSourceText "Aligning and defining a relevant, differentiated, and credible value proposition for the brand. Align experience to ensure that the product and service quality is consistent with brand promise and business strategies." ;
    bpot:hierarchyID "1.2.8.2.6" ;
    bpot:pcfID "19969" .

bpot:P19970 a owl:Class ;
    rdfs:label "Develop content strategy" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): 'strategic planning of content creation, delivery, and governance' composes a content strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that plans the creation, delivery, and governance of content and produces a business strategy for content." ;
    skos:example "A content team formulates the editorial and distribution strategy for the year." ;
    bpot:apqcSourceText "Planning, development, and management of content-written or in other media. Getting the right content to the right user at the right time through strategic planning of content creation, delivery, and governance." ;
    bpot:hierarchyID "1.2.8.2.7" ;
    bpot:pcfID "19970" .

bpot:P19971 a owl:Class ;
    rdfs:label "Design customer experience support structure" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): composes a prescriptive support structure." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceRoadmap ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19972 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19973 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that designs the support structure for customer experience with an approach, process flow, and timeframe and produces a customer experience roadmap." ;
    skos:example "A CX office designs the support model and rollout timeframe for the new experience." ;
    bpot:apqcSourceText "Creating a roadmap for customer experience support with an overall approach, process flow, and impact timeframe." ;
    bpot:hierarchyID "1.2.8.3" ;
    bpot:pcfID "19971" .

bpot:P19972 a owl:Class ;
    rdfs:label "Identify required capabilities" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: 'determining the necessary skills and competencies required' discerns and registers needed capabilities. Output replaced (Gate-F) from the off-target bpo:CoreCompetencyAnalysis (which describes an organization's strategically DIFFERENTIATING competencies) with the required-skills bpo:RequiredCapabilityList, matching the source's 'necessary skills and competencies required to operate the support structure'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RequiredCapabilityList ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the skills and competencies required to operate the customer-experience support structure and produces a required capability list." ;
    skos:example "A CX lead lists the analytics and service skills the support team must have." ;
    bpot:apqcSourceText "Determining the necessary skills and competencies required to efficiently collect customer experiences through the support structure." ;
    bpot:hierarchyID "1.2.8.3.1" ;
    bpot:pcfID "19972" .

bpot:P19973 a owl:Class ;
    rdfs:label "Identify impact on functional processes" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification: 'identifying the affect ... on other functions' discerns and registers cross-functional impacts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceAssessment ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the impact of the customer-experience support structure on other customer-service functions and produces a customer experience assessment of those impacts." ;
    skos:example "An analyst identifies how the new CX support model changes the call-center workflow." ;
    bpot:apqcSourceText "Identifying the affect of customer experience through customer experience support structure on other functions of customer services related to customer." ;
    bpot:hierarchyID "1.2.8.3.2" ;
    bpot:pcfID "19973" .

bpot:P19974 a owl:Class ;
    rdfs:label "Develop customer experience roadmap to develop and implement defined capabilities" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (Act of Planning): 'defining a standard guideline to create and execute the capacities' composes an implementation roadmap." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerExperienceRoadmap ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that defines the guideline, behaviors, and talent needed to implement the customer-experience capabilities and produces a customer experience roadmap." ;
    skos:example "A CX office publishes the roadmap and talent plan to stand up the new capabilities." ;
    bpot:apqcSourceText "Defining a standard guideline to create and execute the capacities of registering customer experiences in a timely manner. Create a common understanding of what behaviors are required to implement the strategy. Define what talent/skills your organization needs to reach customer experience goals." ;
    bpot:hierarchyID "1.2.8.4" ;
    bpot:pcfID "19974" .

bpot:P19975 a owl:Class ;
    rdfs:label "Identify strategic priorities" ;
    rdfs:comment "Re-anchored (Gate-F) from bpo:ActOfIdentification to cco:ont00000636 (Act of Appraisal), matching its sibling P19980 'Prioritize strategic initiatives': the source's core operation is that 'strategic objectives are ranked by their importance', and ranking-by-importance is an evaluative judgement, not mere discernment. Rejected bpo:ActOfIdentification: the objectives already exist (taken as input); the act adds a value-ordering over them. Output remains the Directive bpo:StrategicPriority (the ranked priorities prescribe subsequent allocation) -- consistent with an Appraisal that issues a prescriptive ranking, as P19980 does with bpo:PrioritizedInitiativeList." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:OrganizationalObjective ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicPriority ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that ranks the organization's strategic objectives by their importance in achieving the strategic goals and produces a statement of strategic priorities guiding resource allocation." ;
    skos:example "Leadership ranks its objectives and issues the priorities that govern the year's budgeting." ;
    bpot:apqcSourceText "Creating a statement of the organization's direction to guide decision making around the allocation of resources. Provide a focus on the organization's overarching goals to ensure coherent and considered action. Strategic objectives are ranked by their importance in achieving the strategic goals. All subsequent operational or tactical planning and resource allocation is based on strategic priorities" ;
    bpot:hierarchyID "1.3.1.1" ;
    bpot:pcfID "19975" .

bpot:P19976 a owl:Class ;
    rdfs:label "Develop strategic initiatives based on business/customer value" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation. The bpo:BusinessValueAssessment input is demoted (Gate-F, Phase-3) from an existential has-input to this comment: the source ('based on what is considered value to the customer or business') treats value as the framing notion guiding formulation, not a formal assessment ICE that every instance must consume. Output bpo:StrategicInitiativeSpecification retained." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicInitiativeSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes strategic initiatives grounded in what is considered value to the customer or the business and produces a strategic-initiative specification." ;
    skos:example "A team frames its candidate initiatives explicitly around customer value drivers." ;
    bpot:apqcSourceText "Creating a statement of the organization's direction based on what is considered \"value\" to the customer or business." ;
    bpot:hierarchyID "1.3.1.2" ;
    bpot:pcfID "19976" .

bpot:P19977 a owl:Class ;
    rdfs:label "Review with stakeholders" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000402 (Act of Communication) to cco:ont00000636 (Act of Appraisal): the source's substance is 'report on the EVALUATION of the business objectives, strategies, ... or past events' -- the defining act is the evaluation/review, not the mere transfer of an ICE (the stakeholder dialogue is the channel through which the review is conducted and reported). The reviewed bpo:BusinessStrategy is demoted from a has-input to an is-about (cco:ont00001808) on the output ICE: the new bpo:StrategyReviewReport (a bpo:PerformanceReport specialization) is about the business strategy. The PerformanceReport genus output is definitional (the review produces a report). Stakeholder participant retained." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategyReviewReport ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Stakeholder ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates an organization's business objectives and strategies and reports the resulting strategy review to stakeholders through structured dialogue." ;
    skos:example "Strategists hold a review session reporting strategy evaluation results to the board and partners." ;
    bpot:apqcSourceText "Developing a process for stakeholder dialog that is integrated into the assessment of business strategies. Report on the evaluation of the business objectives, strategies, subject, or past events." ;
    bpot:hierarchyID "1.3.1.3" ;
    bpot:pcfID "19977" .

bpot:P19978 a owl:Class ;
    rdfs:label "Determine business value for each strategic priority" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): determining worth is judging value. Input is the strategic priorities (cross-reference to PCF 19975)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicPriority ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessValueAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges the business worth of each strategic priority against a standard measure of value and produces a business-value assessment." ;
    skos:example "Analysts score each priority by the benefit it adds to the business." ;
    bpot:apqcSourceText "Establishing a standard measure of value to determine the business worth for each of the Identify strategic priorities [19975]. List the effectiveness and utility for every important strategic element based on the benefit it adds to the business." ;
    bpot:hierarchyID "1.3.2.1" ;
    bpot:pcfID "19978" .

bpot:P19979 a owl:Class ;
    rdfs:label "Determine the customer value for each strategic priority" ;
    rdfs:comment "Re-anchored (Gate-F) from bpo:ActOfAnalysis to cco:ont00000636 (Act of Appraisal), matching its sibling P19978 'Determine business value for each strategic priority': 'determining customer value' (the satisfaction a consumer feels relative to what is given up) is a value-judgement, the same evaluative operation P19978 applies to business value. Output replaced from the off-target bpo:CustomerNeedsAssessment (which describes needs, not value) with the Descriptive bpo:CustomerValueAssessment, parallel to bpo:BusinessValueAssessment. Inputs are the strategic priorities (cross-ref PCF 19975) and customer feedback." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicPriority ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CustomerValueAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges the value a customer derives from the offerings tied to each strategic priority and produces a customer value assessment." ;
    skos:example "A team appraises what customers gain from offerings tied to each strategic priority." ;
    bpot:apqcSourceText "Analyzing the value preposition; the value the customer gets from a product/services for each of your Identify strategic priorities [19975]. Customer value is the satisfaction a consumer feels after making a purchase for goods or services relative to what he/she must give up to receive them." ;
    bpot:hierarchyID "1.3.2.2" ;
    bpot:pcfID "19979" .

bpot:P19980 a owl:Class ;
    rdfs:label "Prioritize strategic initiatives" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): ranking by importance is judging importance. Output is Directive (the ranking prescribes order of pursuit)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:StrategicInitiativeEvaluation ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PrioritizedInitiativeList ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges strategic initiatives by importance and produces a prioritized initiative list ordering them from most to least important." ;
    skos:example "A filter scores initiatives so the team can list them most- to least-important." ;
    bpot:apqcSourceText "Listing the most effective procedures in the order of most important to the least. Create measures or filter for determining which of many \"strategic initiatives\" is most important to the least important." ;
    bpot:hierarchyID "1.3.3.1" ;
    bpot:pcfID "19980" .

bpot:P19981 a owl:Class ;
    rdfs:label "Communicate strategic initiatives to business units and stakeholders" ;
    rdfs:comment "CHOSEN READING (Gate-F): re-anchored from cco:ont00000402 (Act of Communication) to bpo:ActOfFormulation. The source is 'ESTABLISHING procedures for communications ... which creates the ROADMAP for successful understanding' -- the leaf composes a Directive bpo:CommunicationStrategy (a plan), it does not itself perform the conveyance. Under this reading the business-unit and stakeholder recipients are NOT definitional participants of the formulation act (they are the audience the planned strategy will later address), so the bfo:has participant restrictions are dropped. Rejected the Act-of-Communication reading (the actual rollout) because the source's verb is 'establishing/creating' the communication scheme, not transferring an ICE. The selected initiatives (bpo:InitiativeSelectionDecision) are the definitional input the strategy is built around." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:InitiativeSelectionDecision ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CommunicationStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes the procedures and roadmap for communicating the selected strategic initiatives to business units and stakeholders and produces a communication strategy." ;
    skos:example "Leadership drafts the communication plan and roadmap so every business unit will understand the chosen initiatives." ;
    bpot:apqcSourceText "Establishing procedures for communications within the organization which creates the road map for successful understanding of strategic initiatives for both business units and stakeholders (internal and external)." ;
    bpot:hierarchyID "1.3.3.2" ;
    bpot:pcfID "19981" .

bpot:P19982 a owl:Class ;
    rdfs:label "Identify business value drivers" ;
    rdfs:comment "Discernment sense -> bpo:ActOfIdentification (shared). Output is a Descriptive ICE describing each driver." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessValueDriver ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns the key operational, financial, and sustainability indicators responsible for driving business value and produces a register of business value drivers." ;
    skos:example "Analysts enumerate the operational and financial factors that move enterprise value." ;
    bpot:apqcSourceText "Determining key indicators or factors responsible for driving business value. Key business value drivers comprise of operational, financial, and sustainability drivers." ;
    bpot:hierarchyID "1.3.4.1" ;
    bpot:pcfID "19982" .

bpot:P19983 a owl:Class ;
    rdfs:label "Establish baselines for business value drivers" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000345 (Act of Measuring) to bpo:ActOfAnalysis, kept consistent with its sibling P10031 'Create baselines for current processes': a baseline is a Descriptive reference measure DERIVED from the value drivers (the output bpo:BusinessValueDriverBaseline is Descriptive). Rejected cco:ont00000345 Act of Measuring (measuring determines a value AGAINST an existing standard; here the standard is being established, not applied) and rejected Act of Planning (the output describes a reference level, it does not prescribe action). Input is the value drivers (cross-ref PCF 19982)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessValueDriver ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessValueDriverBaseline ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input the business value drivers and has as output business-value-driver baselines derived as reference standards for assessing later performance." ;
    skos:example "The team derives the starting-period value of each driver as its assessment benchmark." ;
    bpot:apqcSourceText "Establishing baseline measures that provide standards for assessing performance of Identify business value drivers [19982]." ;
    bpot:hierarchyID "1.3.4.2" ;
    bpot:pcfID "19983" .

bpot:P19984 a owl:Class ;
    rdfs:label "Monitor performance against baselines" ;
    rdfs:comment "Anchored to cco:ont00000345 (Act of Measuring): monitoring measures performance relative to the baseline standard (cross-ref PCF 19983)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessValueDriverBaseline ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceRecord ],
        cco:ont00000228,
        cco:ont00000345 ;
    skos:definition "An Act of Measuring that determines actual performance of activities against the established business-value-driver baselines and produces a performance record." ;
    skos:example "A PMO tracks each driver's running value against its baseline to flag off-course initiatives." ;
    bpot:apqcSourceText "Overseeing the progress of activities to ensure they are on-course and on-schedule in meeting the objectives and performance targets against Establish baselines for business value drivers [19983]." ;
    bpot:hierarchyID "1.3.4.3" ;
    bpot:pcfID "19984" .

bpot:P20945 a owl:Class ;
    rdfs:label "Develop business models" ;
    rdfs:comment "Inputs bpo:BusinessConcept and bpo:BusinessStrategy are definitional (the source states the model must integrate the general business concept [10002] and business strategy [10015]), so they are promoted to restrictions (Phase-3 necessity)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessConcept ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20946 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20947 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20948 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20949 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that examines a business concept and business strategy and produces a business model describing an organization's goals and the processes needed to achieve them." ;
    skos:example "A strategy team integrates the firm's business concept and strategy into a formally adopted business model." ;
    bpot:apqcSourceText "Creating an economic model that describes the goals of an organization and the business processes needed to achieve those goals. This involves information gathering, securing necessary approvals and authorizations, integrating with preexisting models, including the general business concept [10002] and business strategy [10015], and formally accepting the model as the basis for organization's day-to-day operations." ;
    bpot:hierarchyID "1.4.1" ;
    bpot:pcfID "20945" .

bpot:P20946 a owl:Class ;
    rdfs:label "Assemble business model information" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): assembling is the receiving and storing of input ICEs, not the analysis (bpo:ActOfAnalysis) of their subject matter. Added (Gate-F) the definitional has-input bpo:BusinessModelSourceMaterial that the Information-Processing genus (whose definition is 'one or more input ICEs are received, manipulated, transferred, or stored') requires; without an input ICE the genus' differentia was unsatisfied." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessModelSourceMaterial ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModelInformation ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that collects business-model source material and produces a body of assembled business-model information." ;
    skos:example "An analyst gathers cost, market, and process documents into a single business-model information pack." ;
    bpot:apqcSourceText "Collecting all relevant materials needed to develop the business model, so that it can adequately model its processes." ;
    bpot:hierarchyID "1.4.1.1" ;
    bpot:pcfID "20946" .

bpot:P20947 a owl:Class ;
    rdfs:label "Secure appropriate approvals" ;
    rdfs:comment "Output bpo:BusinessAuthorization is a Directive ICE (Action Permission). Genus is the local bpo:ActOfAcquisition because no CCO Act covers obtaining a held authorization (see that genus' rdfs:comment). Rejected (Gate-F, per §6) cco:ont00000366 (Act of Information Processing): securing approvals is coming to HOLD an authorization the agent did not previously have, not receiving/manipulating/transferring/storing the CONTENT of an input ICE -- the authorization is acquired as a held entity, not processed for its information. Also rejected cco:ont00000402 (Act of Communication): the transfer of the permission to the agent is incidental to the agent's coming to hold it." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessAuthorization ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that obtains the permissions, licenses, and authorizations required to legitimize a business and produces a business authorization." ;
    skos:example "A compliance officer secures the licenses needed to operate the proposed line of business." ;
    bpot:apqcSourceText "Obtaining required permissions, licenses and authorizations that legitimize the business, help to mitigate associated risks and safeguard the operations." ;
    bpot:hierarchyID "1.4.1.2" ;
    bpot:pcfID "20947" .

bpot:P20948 a owl:Class ;
    rdfs:label "Identify integration points with existing models" ;
    rdfs:comment "Genus bpo:ActOfIdentification (discernment sense, from apqc-ext.ttl): the act discerns and enumerates integration points. Input bpo:BusinessModel ranges over pre-existing models. CHOSEN READING (Gate-F): Identification, because the leaf 'ensures coherence' by discerning and registering the points of contact (output bpo:ModelIntegrationPointRegister, Descriptive). Rejected bpo:ActOfAnalysis: the act enumerates discrete integration points rather than examining subject matter to synthesize an understanding -- discernment, not analysis." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessModelInformation ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ModelIntegrationPointRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that has as input business-model information and pre-existing business models and has as output a register of the points at which the new model must integrate with them." ;
    skos:example "A modeller maps where the new business model touches the existing operating model to prevent contradictions." ;
    bpot:apqcSourceText "Ensuring coherence with pre-exsiting models to avoid contradictions between models. Make sure that all models represent the same long-term vision." ;
    bpot:hierarchyID "1.4.1.3" ;
    bpot:pcfID "20948" .

bpot:P20949 a owl:Class ;
    rdfs:label "Adopt the business model" ;
    rdfs:comment "Re-anchored (Gate-F) from bpo:ActOfSelection to cco:ont00000228 (Planned Act): the source is 'consenting to a PARTICULAR business model and formally accepting it' -- a commitment/ratification act over a single model, not a choice among a set of candidates (bpo:ActOfSelection definitionally chooses from a set). Rejected bpo:ActOfSelection: there is no candidate set here; the model has already been settled, and this leaf is the ratification. No narrower CCO act denotes ratification/acceptance, so it anchors at the generic Planned Act, parallel to bpo:P19507 'Execute strategic initiatives'. Output bpo:BusinessModelAdoptionDecision (Directive) is kept: a ratification still prescribes that the model govern operations. Anchored as Planned Act consistently with the parallel ratification leaf bpo:P10056 'Migrate to new organization'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModelAdoptionDecision ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that consents to and formally ratifies a single business model, producing an adoption decision accepting it as the basis of operations." ;
    skos:example "An executive board formally adopts the proposed business model as the company's operating basis." ;
    bpot:apqcSourceText "Consenting to a particular business model and formally accepting it to serve as the set of guiding principles in operating the company." ;
    bpot:hierarchyID "1.4.1.4" ;
    bpot:pcfID "20949" .

bpot:P20950 a owl:Class ;
    rdfs:label "Maintain business models" ;
    rdfs:comment "R5 bounded-occurrent test: this is a bounded revision PROCESS, not the standing function. Begin/end criterion (Gate-F): an instance BEGINS when a triggering condition (incoming feedback or a scheduled review) opens a revision episode and ENDS when the reissued business model is published; it has a determinate temporal extent and modeled child steps. By contrast, the standing upkeep/oversight FUNCTION (which has no per-episode begin/end and persists between revisions) is the continuant bpo:BusinessModelGovernanceCapability set up by 1.4.3, not this process. The bpo:CustomerFeedback input is demoted (Gate-F, Phase-3) from an existential has-input to this comment: the source's wider scope ('changes in marketed services, product inventory, market behavior, available resources or accrued expenses') shows feedback is only one of several alternative triggers, so it is not necessary for every instance." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModel ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20951 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20952 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20953 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20954 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that revises and updates an organization's business models in response to feedback and changing circumstances and produces an updated business model." ;
    skos:example "A product team runs its periodic review and reissues the business model to reflect new market behavior." ;
    bpot:apqcSourceText "Revising and updating business models to reflect the changes in the marketed services, product inventory, market behavior, available resources or accrued expenses. Determine how and when to modify the accepted business model in response to incoming feedback." ;
    bpot:hierarchyID "1.4.2" ;
    bpot:pcfID "20950" .

bpot:P20951 a owl:Class ;
    rdfs:label "Establish business model maintenance parameters" ;
    rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): it makes a procedure (a Directive ICE) prescribing how and when maintenance occurs." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModelMaintenancePlan ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that determines the timeline, procedures, and responsibilities for reviewing and updating a business model and produces a business-model maintenance plan." ;
    skos:example "A governance lead sets a quarterly review cadence and assigns owners for business-model updates." ;
    bpot:apqcSourceText "Determining the timeline, procedures and responsibilities for reviewing the business model and for updating it to best serve the organization." ;
    bpot:hierarchyID "1.4.2.1" ;
    bpot:pcfID "20951" .

bpot:P20952 a owl:Class ;
    rdfs:label "Accept business model feedback parameters" ;
    rdfs:comment "Genus bpo:ActOfSelection: the act picks, among candidate feedback types, those that count. Output bpo:FeedbackCriteriaSpecification is a Directive ICE prescribing which feedback is admissible. CHOSEN READING (Gate-F): Selection, because the source verb is 'DECIDING the type of responses ... crucial to be taken into consideration' -- choosing admissible types from a candidate set, with a Directive chosen-option output (Golden Principle agreement). Rejected bpo:ActOfFormulation: the act selects among pre-existing feedback kinds rather than composing a novel specification from scratch." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FeedbackCriteriaSpecification ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that determines which types of feedback are to be taken into consideration during business-model maintenance and produces a feedback-criteria specification." ;
    skos:example "A team decides that only structured customer-survey and churn signals will drive model changes." ;
    bpot:apqcSourceText "Deciding the type of responses, reactions, sentiments and insights that are crucial to be taken into consideration with business model maintenance." ;
    bpot:hierarchyID "1.4.2.2" ;
    bpot:pcfID "20952" .

bpot:P20953 a owl:Class ;
    rdfs:label "Prioritize and manage incoming feedback" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): it evaluates and judges the importance of feedback. Input bpo:CustomerFeedback is definitional (the act is about the feedback)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CustomerFeedback ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FeedbackPrioritization ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates incoming feedback to judge which items are critical and produces a prioritization of that feedback." ;
    skos:example "A product council ranks incoming feedback and flags the items that mandate model changes." ;
    bpot:apqcSourceText "Evaluating the feedback regarding products, services, processes or resources. Determine which judgments are critical and mandate changes to the current business model to better deliver the desired value" ;
    bpot:hierarchyID "1.4.2.3" ;
    bpot:pcfID "20953" .

bpot:P20954 a owl:Class ;
    rdfs:label "Update existing models" ;
    rdfs:comment "Anchored to cco:ont00000511 (Act of Planning): revising the operative plan (the business model, a Directive ICE). The bpo:CustomerFeedback input is demoted (Gate-F, Phase-3) from an existential has-input to this comment: the source says the update is triggered by 'incoming feedback OR changing markets', so feedback is only ONE of two alternative triggers and is not necessary for every instance. Output bpo:BusinessModel retained." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModel ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that modifies the business models presently in use in response to feedback or changing markets and produces an updated business model." ;
    skos:example "A team revises the in-force business model to reflect prioritized feedback and new market conditions." ;
    bpot:apqcSourceText "Modifying the business models that are presently in use in response to incoming feedback or changing markets to achieve the enterprise business goals." ;
    bpot:hierarchyID "1.4.2.4" ;
    bpot:pcfID "20954" .

bpot:P21421 a owl:Class ;
    rdfs:label "Identify potential product or service alternatives" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000636 (Act of Appraisal) to bpo:ActOfSelection: the source builds a business case in order to 'make a go/no go decision', and the definitional output is the Directive bpo:GoNoGoDecision (a chosen-option commitment), which the Golden Principle ties to a Selection act, not an Appraisal. This supersedes the 1.1.1 reference module's Act-of-Appraisal + dual-output model (the Selection genus is the cleaner anchor for an act culminating in a decision). The source explicitly says the act is 'building the business case to make a go/no go decision', so bpo:SubstitutionBusinessCase is restored as a SECOND (Descriptive) has-output produced by this act en route to the decision -- a Selection act may carry a secondary descriptive output -- rather than demoted to prose; this answers the CQ 'what document supports the substitution go/no-go?'. Was bpo:EvaluateSubstituteProducts in the GOLD module." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SubstitutionBusinessCase ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GoNoGoDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that examines substitute products or services on the market and produces a go/no-go decision on the alternative." ;
    skos:example "A product team weighs a substitute on the market and commits to a no-go decision." ;
    bpot:apqcSourceText "Examining if there are other existing products or services in the marketplace, and building the business case to make a go/no go decision based upon substitutions." ;
    bpot:hierarchyID "1.1.1.3" ;
    bpot:pcfID "21421" .

bpot:P21422 a owl:Class ;
    rdfs:label "Review execution of strategic initiatives" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): a periodic review judges execution. Repeatable occurrence with identifiable begin/end each cycle." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PerformanceReport ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that periodically judges the execution of strategic initiatives against performance, conditions, and marketplace response and produces a performance report." ;
    skos:example "A quarterly steering review assesses how the executed initiatives are performing." ;
    bpot:apqcSourceText "Periodic review of initiatives based performance, conditions, and marketplace response." ;
    bpot:hierarchyID "1.3.6" ;
    bpot:pcfID "21422" .

bpot:P21423 a owl:Class ;
    rdfs:label "Refine strategic initiatives and project plans as needed" ;
    rdfs:comment "Anchored to bpo:ActOfFormulation (under cco:ont00000511): re-formulating a plan is planning. Input is the performance report that triggers the revision." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceReport ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicInitiativeSpecification ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that revises strategic initiatives and project plans in response to marketplace or performance changes and produces an updated strategic-initiative specification." ;
    skos:example "After a downturn, the team rewrites two initiatives' project plans to fit the new market." ;
    bpot:apqcSourceText "Performing required updates to strategic initiatives based upon changes in the marketplace or performance." ;
    bpot:hierarchyID "1.3.7" ;
    bpot:pcfID "21423" .

bpot:P21606 a owl:Class ;
    rdfs:label "Evaluate B2B options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal). Performance records are the definitional comparison baseline; stakeholder/partner expectations are typical inputs recorded informally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates future business-to-business opportunities against current performance and produces a strategic-option analysis." ;
    skos:example "Strategists weigh new B2B channels against the firm's historical B2B performance." ;
    bpot:apqcSourceText "Evaluating future business to business opportunities against past and current approaches and performance. Gather insights into what competitors and other similar organizations are doing and the needs, goals, and expectations of stakeholders and partners to understand potential future impact." ;
    bpot:hierarchyID "1.2.2.3" ;
    bpot:pcfID "21606" .

bpot:P21607 a owl:Class ;
    rdfs:label "Evaluate B2C options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal). Performance records are the definitional baseline; customer needs/partner expectations are typical inputs recorded informally." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PerformanceRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates future business-to-customer opportunities against current performance and produces a strategic-option analysis." ;
    skos:example "Strategists assess new direct-to-consumer offerings against historical B2C results." ;
    bpot:apqcSourceText "Evaluating future business to customer opportunities against past and current approaches and performance. Gather insights into what competitors and other similar organizations are doing and the needs, goals, and expectations of customers and partners to understand potential future impact." ;
    bpot:hierarchyID "1.2.2.4" ;
    bpot:pcfID "21607" .

bpot:P21608 a owl:Class ;
    rdfs:label "Evaluate partner/alliance options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): cost/benefit evaluation of partnership options." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the cost and benefit of partnership and alliance opportunities and produces a strategic-option analysis." ;
    skos:example "An alliance team weighs the cost and benefit of candidate distribution partners." ;
    bpot:apqcSourceText "Evaluating partnership and alliance opportunities to deliver products/services. Understand existing product and market models in use across the markets you serve, evolving trends, and the cost/benefit of potential new/updated partnership/alliance options." ;
    bpot:hierarchyID "1.2.2.5" ;
    bpot:pcfID "21608" .

bpot:P21609 a owl:Class ;
    rdfs:label "Evaluate IP acquisition options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation of cost/risk/value of candidate IP acquisitions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the cost, risk, and lifecycle value of intellectual-property acquisition options and produces a strategic-option analysis." ;
    skos:example "A team appraises licensing versus acquiring a patent portfolio." ;
    bpot:apqcSourceText "Evaluating intellectual property acquisition options available to scale, modernize, and/or extend product/service reach. Understand the cost, risk, timing and lifecycle value of candidate acquisitions." ;
    bpot:hierarchyID "1.2.2.6" ;
    bpot:pcfID "21609" .

bpot:P21610 a owl:Class ;
    rdfs:label "Evaluate innovation options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation of candidate innovation options." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates innovation options for advancing technology, products, services, or operational performance and produces a strategic-option analysis." ;
    skos:example "An innovation board weighs candidate R&D bets for the coming cycle." ;
    bpot:apqcSourceText "Evaluating innovation options to advance technology, products/services, and/or operational performance." ;
    bpot:hierarchyID "1.2.2.7" ;
    bpot:pcfID "21610" .

bpot:P21611 a owl:Class ;
    rdfs:label "Evaluate sustainability options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): cost/benefit/effort evaluation of ESG options." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates sustainability requirements and stakeholder expectations across environmental, social, and governance dimensions and produces a strategic-option analysis." ;
    skos:example "A sustainability office appraises the cost and benefit of carbon-reduction initiatives." ;
    bpot:apqcSourceText "Evaluating sustainability requirements, stakeholder expectations, and value proposition for options. Understand the potential activities and changes across environmental, social, and governance, the effort required, cost to implement, and benefits gained. The analysis should consider sustainable product/service lifecycles, operations, infrastructure, performance, and workforce." ;
    bpot:hierarchyID "1.2.2.8" ;
    bpot:pcfID "21611" .

bpot:P21612 a owl:Class ;
    rdfs:label "Evaluate global support options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation balancing cost, performance, and customer value of global-support options." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates options for global support services and delivery models and produces a strategic-option analysis." ;
    skos:example "A shared-services team appraises centralized versus regional global support models." ;
    bpot:apqcSourceText "Evaluating options for global support services and functions. This should include structure, scale, adaptability to change, and alternative delivery models to balance cost, performance, and customer value." ;
    bpot:hierarchyID "1.2.2.9" ;
    bpot:pcfID "21612" .

bpot:P21613 a owl:Class ;
    rdfs:label "Evaluate shared services options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation balancing cost, performance, and operational efficiency of shared-services options." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates options for shared services and delivery models and produces a strategic-option analysis." ;
    skos:example "A team appraises consolidating finance and HR into a shared-services center." ;
    bpot:apqcSourceText "Evaluating options for shared services and support functions. This should include structure, scale, adaptability to change, and alternative delivery models to balance cost, performance, and operational efficiencies." ;
    bpot:hierarchyID "1.2.2.10" ;
    bpot:pcfID "21613" .

bpot:P21614 a owl:Class ;
    rdfs:label "Evaluate lean/continuous improvement options" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): evaluation of process-improvement alternatives." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:StrategicOptionAnalysis ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates options to optimize processes and functional areas and produces a strategic-option analysis." ;
    skos:example "A continuous-improvement office appraises lean initiatives for the operations division." ;
    bpot:apqcSourceText "Evaluating options to enhance and optimize processes and functional areas. Understand alternatives to strengthen business capabilities, enhance process efficiencies, and advance performance standards." ;
    bpot:hierarchyID "1.2.2.11" ;
    bpot:pcfID "21614" .

bpot:RoleActivityDiagram a owl:Class ;
    rdfs:label "Role Activity Diagram" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the constituent activities of a work-related role and the hand-offs among them." .

bpot:StakeholderAlignmentPlan a owl:Class ;
    rdfs:label "Stakeholder Alignment Plan" ;
    rdfs:comment "Output of 1.1.4.2 'Align stakeholders around strategic vision'." ;
    rdfs:subClassOf cco:ont00000965,
        cco:ont00000974 ;
    skos:definition "A Plan that prescribes how stakeholders are to be oriented and positioned in support of an organization's strategic vision." .

bpot:CustomerProfile a owl:Class ;
    rdfs:label "Customer Profile" ;
    rdfs:comment "Covers APQC customer profiles, personas, and the 'single view of the customer'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:Customer ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a group of customers with respect to their characteristics, needs, and behavioral patterns." .

bpot:OrganizationalStructureAssessment a owl:Class ;
    rdfs:label "Organizational Structure Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the evaluated breadth, depth, and implications of an organization's structural makeup." .

bpot:P19945 a owl:Class ;
    rdfs:label "Analyze competitors" ;
    rdfs:comment "Carried over from GOLD module (bpo:AnalyzeCompetitors). Represents APQC 1.1.1.1 as an occurrent, not as the analysis artifact (that is bpo:CompetitorAnalysis) nor an organizational function." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CompetitorData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CompetitorAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:CompetitiveIntelligenceAnalyst ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input competitor data and has as output a competitor analysis about one or more competitors." ;
    skos:example "A competitive-intelligence team reviews market reports and produces a competitor analysis." ;
    bpot:apqcSourceText "Identifying your competitors, their service and/or product. Evaluating competitors strategies to determine their strengths and weaknesses relative to those of your own product or service." ;
    bpot:hierarchyID "1.1.1.1" ;
    bpot:pcfID "19945" .

bpot:P20955 a owl:Class ;
    rdfs:label "Establish business model governance" ;
    rdfs:comment "R5/R6: the bounded establishing act passes R5 and is modeled here as a process; the standing governance function it stands up is the pre-existing shared bpo:BusinessModelGovernanceCapability (Organization Capability), reused (not re-minted) and linked via obo:BFO_0000054 (realized in)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BusinessModelGovernancePolicy ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that creates and implements the strategy, responsibilities, and control mechanisms for governing an organization's business models and produces a business-model governance policy." ;
    skos:example "An organization stands up a model-governance board with a charter, owners, and review controls." ;
    bpot:apqcSourceText "Creating and implementing a strategy, responsibilities and control mechanisms for managing business models that are timely, efficient and cost-effective." ;
    bpot:hierarchyID "1.4.3" ;
    bpot:pcfID "20955" .

bpot:RestructuringOpportunityAnalysis a owl:Class ;
    rdfs:label "Restructuring Opportunity Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes identified opportunities for restructuring an organization in light of internal viability and external contingency." .

bpot:SeniorManagement a owl:Class ;
    rdfs:label "Senior Management" ;
    rdfs:comment "Section-wide participant: APQC repeatedly assigns strategy formulation/selection to 'senior management executives'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:SeniorManagerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a senior manager role." .

bpot:Stakeholder a owl:Class ;
    rdfs:label "Stakeholder" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:StakeholderRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a stakeholder role." .

bpot:StrategicInitiativeEvaluation a owl:Class ;
    rdfs:label "Strategic Initiative Evaluation" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the applicability and feasibility of a strategic initiative relative to an organization's vision and constraints." .

bpot:StrategicPriority a owl:Class ;
    rdfs:label "Strategic Priority" ;
    rdfs:comment "Reuses CCO Objective. Output of 1.3.1.1 'Identify strategic priorities'; priorities are objectives ordered by importance." ;
    rdfs:subClassOf cco:ont00000476,
        cco:ont00000965 ;
    skos:definition "An Objective that prescribes a ranked organizational direction used to guide resource-allocation decisions." .

bpot:StrategyPersonnel a owl:Class ;
    rdfs:label "Strategy Personnel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:StrategyPersonnelRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a strategy personnel role." .

bpot:CustomerExperienceAssessment a owl:Class ;
    rdfs:label "Customer Experience Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes measured customer experience, satisfaction, and feedback across touchpoints." .

bpot:CustomerNeedsAssessment a owl:Class ;
    rdfs:label "Customer Needs Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the products and services that are needed or wanted by customers in a relevant market." .

bpot:PerformanceMetric a owl:Class ;
    rdfs:label "Performance Metric" ;
    rdfs:comment "Covers APQC baseline metrics, KPIs, business-value drivers, and high-level measures (1.2.6, 1.3.4). Directive because a metric/target prescribes the standard to be met." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a standard measure and target against which the performance of a function, process, or initiative is assessed." .

bpot:PerformanceReport a owl:Class ;
    rdfs:label "Performance Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes monitored performance of functions, processes, or initiatives against established baselines or objectives." .

bpot:BusinessValueAssessment a owl:Class ;
    rdfs:label "Business Value Assessment" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the assessed business or customer value of a strategic priority or initiative." .

bpot:CustomerData a owl:Class ;
    rdfs:label "Customer Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes customers, their characteristics, and their needs and wants." .

bpot:CustomerExperienceRoadmap a owl:Class ;
    rdfs:label "Customer Experience Roadmap" ;
    rdfs:comment "Output of 1.2.8.3/1.2.8.4 customer-experience support structure and roadmap." ;
    rdfs:subClassOf cco:ont00000965,
        cco:ont00000974 ;
    skos:definition "A Plan that prescribes the intended capabilities, behaviors, and timeline for delivering a defined customer experience." .

bpot:DealOptionAnalysis a owl:Class ;
    rdfs:label "Deal Option Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an appraisal of acquisition, merger, de-merger, or divestment options for an organization." .

bpot:MarketData a owl:Class ;
    rdfs:label "Market Data" ;
    rdfs:comment "Carried over from the 1.1.1 reference module (same IRI, same definition) so this self-contained module has every filler declared." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes features of a market." .

bpot:MissionStatement a owl:Class ;
    rdfs:label "Mission Statement" ;
    rdfs:comment "Directive: a mission prescribes intended direction rather than describing a state of affairs." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the overarching purpose and practicable targets an organization aims to pursue." .

bpot:OrganizationalDesign a owl:Class ;
    rdfs:label "Organizational Design" ;
    rdfs:comment "Output of 1.2.5 'Create organizational design'. Directive: a design prescribes (serves as a model for) the structure to be realized." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the intended structure and relationships among an organization's units and roles." .

bpot:OrganizationalObjective a owl:Class ;
    rdfs:label "Organizational Objective" ;
    rdfs:comment "Reuses CCO Objective (ont00000476). Output of 1.2.6 'Develop and set organizational objectives' and the priority statements of 1.3.1." ;
    rdfs:subClassOf cco:ont00000476,
        cco:ont00000965 ;
    skos:definition "An Objective that prescribes a projected state an organization intends to achieve in pursuit of its mission." .

bpot:PerformanceRecord a owl:Class ;
    rdfs:label "Performance Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes recorded performance levels of an organization's processes, functions, or units over a period." .

bpot:StrategicInitiativeSpecification a owl:Class ;
    rdfs:label "Strategic Initiative Specification" ;
    rdfs:comment "Output of 1.3.1 'Develop strategic initiatives'; consumed (as input) by 1.3.2/1.3.3 evaluation and selection." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a discretionary, time-bound strategic project lying beyond an organization's routine operations." .

bpot:StrategicVision a owl:Class ;
    rdfs:label "Strategic Vision" ;
    rdfs:comment "Directive output of 1.1.4 'Establish strategic vision' and 1.2.8 customer-experience vision." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an organization's intended long-term direction and aspirational future state." .

bpot:BusinessModel a owl:Class ;
    rdfs:label "Business Model" ;
    rdfs:comment "Output of group 1.4 'Develop and maintain business models'. Directive: an adopted business model serves as the guiding model for day-to-day operations." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes how an organization creates, delivers, and captures value, including its products, target market, and core economics." .

bpot:StrategicOption a owl:Class ;
    rdfs:label "Strategic Option" ;
    rdfs:comment "Directive (a candidate prescription) and distinct from bpo:StrategicOptionAnalysis, which describes the assessed impact of options." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes one candidate course of strategic action available to an organization." .

bpot:CustomerFeedback a owl:Class ;
    rdfs:label "Customer Feedback" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes responses, reactions, sentiments, and insights expressed by customers about products, services, or experiences." .

bpot:InternalCapabilityData a owl:Class ;
    rdfs:label "Internal Capability Data" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes an organization's in-house skills, resources, operations, and capacities." .

bpot:StrategicOptionAnalysis a owl:Class ;
    rdfs:label "Strategic Option Analysis" ;
    rdfs:comment "Covers the impact/option assessments produced across 1.2.2 (B2B, B2C, partner, IP, innovation, sustainability, support, shared-services, lean options)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the assessed impact and consequences of one or more candidate strategic options." .

bpot:BusinessStrategy a owl:Class ;
    rdfs:label "Business Strategy" ;
    rdfs:comment "Reuses CCO Plan (ont00000974) rather than minting under ont00000965, because the CCO Plan definition ('prescribes some set of intended Intentional Acts through which some Agent expects to achieve some Objective') fits a strategy exactly. Base genus for the strategy outputs of 1.2.3, 1.2.7, and 1.2.8." ;
    rdfs:subClassOf cco:ont00000965,
        cco:ont00000974 ;
    skos:definition "A Plan that prescribes the set of intended intentional acts through which an organization expects to achieve its long-term business objectives." .

