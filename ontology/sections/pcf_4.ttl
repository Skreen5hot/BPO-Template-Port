@prefix bpot: <https://fandaws.com/ontology/bpot#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bpot:DistributionCenter a owl:Class ;
    rdfs:label "Distribution Center" ;
    rdfs:subClassOf obo:BFO_0000040,
        cco:ont00000192 ;
    skos:definition "A Facility designed for receiving, storing, and dispatching products to downstream destinations in a distribution network." .

bpot:OutboundTransportationPlan a owl:Class ;
    rdfs:label "Outbound Transportation Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the dispatch, transportation, and delivery of outbound products to their destinations." .

