bpot:RegulatoryAuthorityRole rdfs:comment "Borne by the authority Organization, never by the permit or requirements ICE it issues." .

bpot:SafetyComplianceRecord a owl:Class ;
    rdfs:label "Safety Compliance Record" ;
    rdfs:comment "Shared across 10.2.4.4 (sites) and 10.3.2.5 (maintenance work safety)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records that safety, security, and access controls at a work site conform to applicable laws, regulations, and organizational guidelines." .

bpot:WasteMaterial a owl:Class ;
    rdfs:label "Waste Material" ;
    rdfs:comment "Reuses CCO Portion of Waste Material (ont00000980), verified: 'serves no further use ... such that the Agent wants to dispose of it.'" ;
    rdfs:subClassOf cco:ont00000980 ;
    skos:definition "A Portion of Waste Material that arises from asset end-of-life activities and is subject to disposition, disposal, or reprocessing under regulatory requirements." .

bpot:designatesProcessType rdfs:comment "Catalog->reality bridge. Links an APQC catalog node (bpo:PCF_<pcfID>) to the reality-layer class (process, capability) that it designates." .

<https://fandaws.com/ontology/bpot/sections/pcf_10> a owl:Ontology ;
    dcterms:creator "Aaron Damiano" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:source <https://fandaws.com/ontology/bpo/slice/10.0>,
        "APQC Process Classification Framework (Cross-Industry)" ;
    dcterms:title "Business Process Ontology -- PCF 10.0 Acquire, Construct, and Manage Assets" ;
    rdfs:comment "Reality layer for APQC PCF category 10.0: the process universals that pass the bounded-occurrent test, the organization capabilities, roles and information content entities they use." ;
    owl:versionIRI <https://fandaws.com/ontology/bpot/0.0.0/sections/pcf_10.ttl> ;
    owl:versionInfo "0.0.0" .

bpot:ActOfForecasting rdfs:comment "Local extension (D9). Genus cco:ont00000371 (Act of Prediction, a Planned Act). Used where a process's definitional output is a forecast/projection of an uncertain future state (a Predictive ICE, cco:ont00000626), as opposed to bpo:ActOfAnalysis whose output is a plain Descriptive ICE about an existing subject. cco:ont00000228 co-asserted locally so the class still anchors to an S2-allowlisted Planned Act. Recurs corpus-wide (slices 5.0/6.0/8.0/10.0)." ;
    skos:definition "An Act of Prediction in which an Agent examines present information about an entity and generates a Predictive Information Content Entity that describes an uncertain future event, value, or condition of that entity." .

bpot:AssetDesign a owl:Class ;
    rdfs:label "Asset Design" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity, about a productive asset, that prescribes the specifications of that asset and the construction codes it must satisfy." .

bpot:AssetDispositionCapability a owl:Class ;
    rdfs:label "Asset Disposition Capability" ;
    rdfs:comment "Models the 10.4.4 'Manage take-back centers' standing function (R5/R6): a never-ending capacity, not a bounded process. Catalog bridge bpo:PCF_12717 -> this capability." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of managing the end-of-life disposition of assets, including decommissioning, dismantling, recycling, and abandonment." .

bpot:AssetExitStrategy a owl:Class ;
    rdfs:label "Asset Exit Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes an organization's approach for managing the end-of-life exit of its assets." .

bpot:AssetHandoverDocumentation a owl:Class ;
    rdfs:label "Asset Handover Documentation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about an asset, that documents the asset's history and current state to enable an orderly handover to a new operator or landowner." .

bpot:AssetMaintenanceCapability a owl:Class ;
    rdfs:label "Asset Maintenance Capability" ;
    rdfs:comment "Models the 10.3 process-group standing function (R5/R6). Realized in 10.3.1/.2/.3 (see R6 axioms in the 10.3 process block); 10.3 mints no bpo:P19238 process." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19239 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19245 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P19253 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of planning, managing, and performing asset maintenance." .

bpot:Budget rdfs:comment "Has-input to budget-feasibility and capital-program work. Directive (cco:ont00000965): a budget prescribes intended fund allocation, constraining subsequent spending; harmonized to Directive corpus-wide (slices 9.0/12.0). The realized commitment of funds is captured by bpo:CapitalInvestmentPlan. (The definition/comment formerly read 'Descriptive', contradicting the harmonized 965 anchor; corrected here.)" ;
    skos:definition "A Directive Information Content Entity that prescribes the planned allocation of funds for a project or program." .

bpot:BudgetAnalysis a owl:Class ;
    rdfs:label "Budget Analysis" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of the feasibility of a budget prepared for construction or acquisition." .

bpot:BuildBuyLeaseDecision a owl:Class ;
    rdfs:label "Build/Buy/Lease Decision" ;
    rdfs:comment "Directive: a decision that authorizes/selects a future course of action (acquisition mode). Distinct from a mere decision record." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:RealProperty ],
        cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity, about a property, that prescribes whether the organization will build, buy, or lease that property." .

bpot:BusinessStrategy rdfs:comment "Shared has-input across 10.0 (e.g. confirm property requirements align with business strategy). Directive (cco:ont00000965): harmonized to Directive corpus-wide (cf. slice 2.0) so the shared class stays satisfiable across slices; the further prescriptive strategy artifacts produced within 10.0 are typed separately (e.g. bpo:PropertyStrategy, bpo:ConstructionStrategy). (The definition/comment formerly read 'Descriptive', contradicting the harmonized 965 anchor; corrected here.)" ;
    skos:definition "A Directive Information Content Entity that prescribes an organization's overall direction, goals, and competitive positioning, against which asset requirements are aligned." .

bpot:CapitalProgramReport a owl:Class ;
    rdfs:label "Capital Program Report" ;
    rdfs:comment "Output of monitoring acts (proposed bpo:ActOfMonitoring)." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the status, progress, and variances of a capital program against its plan." .

bpot:ComplianceAuditReport a owl:Class ;
    rdfs:label "Compliance Audit Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the findings of an audit of hazardous-material handling, disposal, and reporting practices against regulatory requirements." .

bpot:ConstructionContractor a owl:Class ;
    rdfs:label "Construction Contractor" ;
    rdfs:comment "Modeled as Agent (rather than Organization) so it covers both individual and organizational contractors; slice modules may narrow to Organization where the text requires." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:ConstructionContractorRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a construction contractor role." .

bpot:ConstructionContractorRole a owl:Class ;
    rdfs:label "Construction Contractor Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being engaged to perform or oversee construction work on an organization's assets." .

bpot:ConstructionFinancing a owl:Class ;
    rdfs:label "Construction Financing Arrangement" ;
    rdfs:comment "Output of an acquisition act (securing financing). Directive because a financing agreement prescribes obligations." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity, such as a loan agreement, that prescribes the terms under which funds are provided to construct necessary assets." .

bpot:ConstructionPermit a owl:Class ;
    rdfs:label "Construction Permit" ;
    rdfs:comment "Directive: a permit authorizes future action under stated conditions. Obtained via an acquisition act (bpo:ActOfAcquisition)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity, issued by a jurisdiction, that authorizes and prescribes conditions for performing construction work on an asset." .

bpot:ConstructionResourcePlan a owl:Class ;
    rdfs:label "Construction Resource Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which resources will be acquired for construction, and when, where, how, and for how long they will be used." .

bpot:ConstructionSchedule a owl:Class ;
    rdfs:label "Construction Schedule" ;
    rdfs:comment "Directive (a schedule prescribes when intended acts occur)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a timetable for executing the construction of an asset." .

bpot:ConstructionStrategy a owl:Class ;
    rdfs:label "Construction Strategy" ;
    rdfs:comment "Directive (a strategy prescribing intended course of action); output of Act of Formulation." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the approach for performing asset construction so that timelines, regulations, resources, and budget are met." .

bpot:CostBenefitAnalysis a owl:Class ;
    rdfs:label "Cost-Benefit Analysis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about an asset, that describes a comparison of the asset's total lifecycle cost against repair, refurbishment, replacement, and alternative-solution options to inform retention or end-of-life decisions." .

bpot:DispositionDecision rdfs:label "Asset Disposition Decision" ;
    rdfs:comment "Directive: a decision that selects and authorizes a future disposition. Shared across 10.4 (take-back centers, dismantling, waste disposition)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ] ;
    skos:definition "A Directive Information Content Entity, about an asset or part, that prescribes the disposition to be applied to it at end-of-life, such as retention, resale, reuse, recycling, or disposal." .

bpot:DispositionNeedRegister a owl:Class ;
    rdfs:label "Disposition Need Register" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records identified hazardous materials or waste recognized as requiring disposition, together with the rationale for that need." ;
    skos:example "A flagged list of expired solvents and contaminated rags awaiting a disposal determination." .

bpot:ExternalEnvironmentAppraisal a owl:Class ;
    rdfs:label "External Environment Appraisal" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a judgement of the external circumstances, objects, events, and aspects surrounding an organization that affect its asset decisions, including opportunities and risks." .

bpot:FacilityDesign a owl:Class ;
    rdfs:label "Facility Design" ;
    rdfs:comment "Directive (a blueprint/specification prescribing how the facility shall be realized), per CCO's Directive-ICE elucidation citing blueprints." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:Facility ],
        cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity, about a facility, that prescribes the configuration, layout, and specifications of that facility to be built or modified." .

bpot:FacilityManagementCapability a owl:Class ;
    rdfs:label "Facility Management Capability" ;
    rdfs:comment "Organization Capability (cco:ont00000568) because 'Manage facilities operations' (10.1.4) is a standing organizational function (R5). Realized in the operational location-change acts via obo:BFO_0000054 (see R6 axioms in the 10.1 process block)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10965 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:P10966 ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of planning, providing, operating, and maintaining facilities and workspaces." .

bpot:FacilityManagementPersonnel a owl:Class ;
    rdfs:label "Facility Management Personnel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:FacilityManagerRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a facility manager role." .

bpot:FacilityManagerRole a owl:Class ;
    rdfs:label "Facility Manager Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with planning, providing, and operating an organization's facilities and workspaces." .

bpot:FacilityTermsAgreement a owl:Class ;
    rdfs:label "Facility Terms Agreement" ;
    rdfs:comment "Directive: a contract/agreement prescribes the obligations of the parties." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the negotiated terms and conditions under which a facility is to be occupied or used." .

bpot:GovernmentReport a owl:Class ;
    rdfs:label "Government Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity prepared for and distributed to a government authority that describes regulated aspects of an organization's asset and material activities." .

bpot:MaintenancePerformanceReport a owl:Class ;
    rdfs:label "Maintenance Performance Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the organization's measured success in meeting maintenance performance targets and contractual obligations." .

bpot:MaintenancePolicy a owl:Class ;
    rdfs:label "Maintenance Policy" ;
    rdfs:comment "Directive (a policy prescribes required/permitted action)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the procedures and policies governing how asset maintenance is to be carried out." .

bpot:MaintenanceRequirementsForecast a owl:Class ;
    rdfs:label "Maintenance Requirements Forecast" ;
    rdfs:comment "Predictive (cco:ont00000626, a specialization of Descriptive cco:ont00000853): it describes an UNCERTAIN FUTURE state (projected requirements), not a record of an existing or past subject. Re-anchored from plain cco:ont00000853 to preserve the forecast/prediction semantics; cco:ont00000853 co-asserted locally because 626 is outside the S3/S4 ICE allowlist {958,853,965}. Output of bpo:P10967 (bpo:ActOfForecasting)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000626,
        cco:ont00000853 ;
    skos:definition "A Predictive Information Content Entity, about an asset, that describes a projection of that asset's uncertain future maintenance requirements based on its present working condition." .

bpot:MaintenanceResource a owl:Class ;
    rdfs:label "Maintenance Resource" ;
    rdfs:comment "Minted (Gate-F) for 10.3.2.2 (bpo:P19247) 'Gathering resources needed to complete all maintenance work'. Distinct from bpo:AssetPart, whose definition is a part resulting from DISMANTLING an end-of-life asset (a 10.4 disposition concept) -- semantically wrong for spare parts/materials gathered to PERFORM maintenance. Anchored at BFO material entity because maintenance resources span artifacts (spares, tools) and non-artifact materials (consumables)." ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity, such as a spare part, consumable, tool, or material, that is gathered and consumed or employed in performing asset-maintenance work." .

bpot:MaintenanceSafetyAssuranceAct a owl:Class ;
    rdfs:label "Maintenance Safety Assurance Act" ;
    rdfs:comment "Minted (Gate-F) as the bounded act in which the standing bpo:P19250 (Manage maintenance work safety) capability is realized (R6). The recurring assurance function is the capability; each individual observe-and-record occurrence is one of these acts, producing bpo:SafetyComplianceRecord. GOLDEN PRINCIPLE: monitoring -> Descriptive ICE (Safety Compliance Record). (Output recorded here rather than as a has-output restriction so this supporting act is not flagged as a PCF process requiring a pcfID; the PCF anchor for 10.3.2.5 is the capability bpo:P19250.)" ;
    rdfs:subClassOf bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that observes maintenance work practices against applicable safety laws and regulations and produces a safety compliance record." .

bpot:MaintenanceStrategy a owl:Class ;
    rdfs:label "Maintenance Strategy" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes goals and agendas for realizing an organization's asset-maintenance policies." .

bpot:MaintenanceTechnicianRole a owl:Class ;
    rdfs:label "Maintenance Technician Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with performing preventative, routine, corrective, and unplanned maintenance on assets." .

bpot:ManageBuildingRenovation a owl:Class ;
    rdfs:label "Manage building renovation" ;
    rdfs:comment "Minted (Gate-F, Phase-1 de-conflation) for the 'Manage renovations according to requirements and demands' half of PCF 10962, which fuses two act kinds (build NEW + renovate EXISTING). Anchored to cco:ont00000970 (Act of Artifact Modification) because renovating an existing building changes the qualities/functions of an existing Material Artifact, mirroring 10.2.3.4 (bpo:P19233), which rejects cco:ont00000051 (Act of Construction, builds NEW) for the same modify-existing sense. Attached as a process part of bpo:P10962 so the modification sense is not mis-genused under Construction nor silently dropped." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Facility ],
        cco:ont00000228,
        cco:ont00000970 ;
    skos:definition "An Act of Artifact Modification that renovates an existing building on site, changing its qualities or functions according to requirements and demands." .

bpot:MarketData rdfs:comment "Shared input for build/buy/lease and property-selection appraisals across 10.1 and 10.2." ;
    skos:definition "A Descriptive Information Content Entity that describes features of a market, such as property prices, construction costs, and supply conditions." .

bpot:MaterialSafetyDataSheet a owl:Class ;
    rdfs:label "Material Safety Data Sheet" ;
    rdfs:comment "Descriptive: an MSDS records material properties; the handling requirements it cites are described, not authored, by it.",
        "False-friend caution (Descriptive vs Directive): an MSDS is descriptive content (cco:ont00000853); any directive handling or disposal PROCEDURE it quotes is a separate Prescriptive ICE (cco:ont00000965) authored by the relevant authority, modeled as its own class if needed. Do not re-anchor the sheet to Directive on the strength of the rules it cites." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:HazardousMaterial ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about a hazardous material, that records the safety properties and required handling and disposal information for that material." .

bpot:P10937 a owl:Class ;
    rdfs:label "Plan and acquire assets" ;
    rdfs:comment "Models APQC process group 10.1 as a curatorial aggregate occurrent. Its dotted children that are reality-layer processes are process parts (cco:ont00001777), not subclasses. 10.1.4 'Manage facilities operations' is a standing function (Organization Capability), so it is not a process part; the underlying location-change acts are reachable as parts of the operational facet instead." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10941 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10943 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10944 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an Agent plans for, acquires, and configures the facilities, workspaces, and supporting assets required by an organization." ;
    skos:example "An organization's end-to-end cycle of strategizing, acquiring, and fitting out a new office building." ;
    bpot:apqcSourceText "Planning, acquiring, and managing facilities, workspaces, and supporting assets. Acquire, configure, and manage facilities and workspaces, to include supporting equipment and materials." ;
    bpot:hierarchyID "10.1" ;
    bpot:pcfID "10937" .

bpot:P19228 a owl:Class ;
    rdfs:label "Manage safety, security, and access to sites" ;
    rdfs:comment "R5/R6: standing function with no natural end ('Ensuring that ... is maintained') -> Organization Capability (cco:ont00000568), not a bounded process. Therefore NOT a has-process-part of parent bpo:P19224. Realized in ongoing acts that maintain site safety/security/access (producing safety compliance records)." ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to continuously maintain the safety, security, and access of construction and operational sites in conformance with safety and regulatory guidelines." ;
    skos:example "A firm's ongoing site-safety and access-control program covering all its construction sites." ;
    bpot:apqcSourceText "Ensuring that safety, security, and access is maintained. Provide a workplace that meets and exceeds all local, state, and federal guidelines. Provide security and access to the building site as set forth by safety and organizational guidelines." ;
    bpot:hierarchyID "10.2.4.4" ;
    bpot:pcfID "19228" .

bpot:P19250 a owl:Class ;
    rdfs:label "Manage maintenance work safety" ;
    rdfs:comment "Re-modeled (Gate-F, R5 reconciliation) from a bounded bpo:ActOfMonitoring process to a standing Organization Capability (cco:ont00000568), mirroring its parallel 10.2 sibling PCF 19228 (bpo:P19228), which was modeled as a standing function for the same kind of safety/security/access assurance. The source ('Assuring that all safety laws and regulations are being implemented and followed') describes an ongoing, never-ending assurance function with no natural end, so by R5 it is a capability, not a bounded process. Realized in the org's safety-assurance acts (which produce bpo:SafetyComplianceRecord). Therefore NOT a has-process-part of parent bpo:P19245; the parallel rows 10.2.4.4 and 10.3.2.5 are now anchored consistently." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom bpot:MaintenanceSafetyAssuranceAct ],
        cco:ont00000568 ;
    skos:definition "An Organization Capability that inheres in an Organization in virtue of its capacity to continuously assure that maintenance work practices implement and follow applicable safety laws and regulations and align with regulatory bureaus such as OSHA, EHS, and ISO." ;
    skos:example "A firm's ongoing maintenance-safety assurance program aligning practices with OSHA, EHS, and ISO." ;
    bpot:apqcSourceText "Assuring that all safety laws and regulations are being implemented and followed. Align practices with regulatory bureaus such as OSHA , EHS, and ISO." ;
    bpot:hierarchyID "10.3.2.5" ;
    bpot:pcfID "19250" .

bpot:P21575 a owl:Class ;
    rdfs:label "Design and construct assets" ;
    rdfs:comment "Models APQC process group 10.2 as a bounded undertaking (one asset build program), not a standing function. Anchored at cco:ont00000228 (Planned Act) because it is a composite program spanning planning and material work rather than a single act of one genus. Its APQC children are process parts, not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19209 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P20139 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19229 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19224 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an Organization designs, plans, finances, schedules, and physically constructs productive assets, decomposing into managing the capital program, designing and planning the construction, scheduling and performing the construction work, and managing the construction effort." ;
    skos:example "A manufacturer's program to design, finance, and build a new production plant, ending when the plant is commissioned." ;
    bpot:apqcSourceText "Designing and constructing assets such as machines, tools, factories, etc. Manage steps to acquire assets including managing capital, as well as planning, scheduling, and overseeing acquisition/construction." ;
    bpot:hierarchyID "10.2" ;
    bpot:pcfID "21575" .

bpot:P21576 a owl:Class ;
    rdfs:label "Manage asset end-of-life" ;
    rdfs:comment "Models APQC process group 10.4 as a bounded occurrent. Its APQC children are process parts (cco:ont00001777), not subclasses. The standing function of operating take-back centers (10.4.4) is modeled as a capability (bpo:AssetDispositionCapability), not a process part." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10952 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19258 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10953 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21579 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21580 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21581 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12721 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12722 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21582 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21583 ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that retires and disposes of an organization's assets once they reach end-of-life, comprising the development of an exit strategy and the decommissioning, sale, dismantling, recycling, abandonment, and waste management of those assets." ;
    skos:example "A utility's program to retire and dispose of an obsolete substation, from exit strategy through demolition, recycling, and regulatory reporting." ;
    bpot:apqcSourceText "Managing the disposition of assets at their end-of-life. End-of-life for an asset may be due to obsolescence, replacement, excess capacity, or disrepair among other potential factors. Steps may include decommissioning, disassembly, recycling, etc. Tracking and reporting may also be appropriate for some or all asset types due to law, regulation, or social/environmental responsibility." ;
    bpot:hierarchyID "10.4" ;
    bpot:pcfID "21576" .

bpot:PartTrackingRecord a owl:Class ;
    rdfs:label "Part Tracking Record" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:AssetPart ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about the parts of end-of-life assets, that records each part's source, rationale for disposition, and destination as an audit trail." .

bpot:PropertyAlignmentAssessment a owl:Class ;
    rdfs:label "Property Alignment Assessment" ;
    rdfs:comment "Minted because the section-10.0 shared vocabulary has no output ICE for the 'confirm alignment' appraisal (10.1.1.1). Descriptive (not Directive) because it represents a judgement of consistency rather than prescribing an action." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the degree to which an organization's property requirements are consistent with its business strategy." ;
    skos:example "A one-page sign-off noting that the requested space matches the firm's expansion plan." .

bpot:PropertySelectionDecision a owl:Class ;
    rdfs:label "Property Selection Decision" ;
    rdfs:comment "Minted because the section-10.0 shared vocabulary has no output ICE for the 'select property' decision (10.1.2.3). Directive (not Descriptive) because a selection prescribes the chosen option rather than describing it." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes which property, among the reviewed options, an organization will acquire or occupy." ;
    skos:example "A documented decision committing the firm to lease Building C." .

bpot:PropertyStrategy a owl:Class ;
    rdfs:label "Property Strategy" ;
    rdfs:comment "Directive; output of Act of Formulation (develop property strategy and long-term vision)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes a long-term vision and approach for managing an organization's purchased and retained properties." .

bpot:RecoveredMaterial a owl:Class ;
    rdfs:label "Recovered Material" ;
    rdfs:comment "Minted locally (10.4). Distinct from bpo:WasteMaterial: recovered material re-enters a value stream rather than being discarded." ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity recovered from end-of-life asset parts for reuse or recycling into new material stock." .

bpot:RegulatoryRequirementsBriefing a owl:Class ;
    rdfs:label "Regulatory Requirements Briefing" ;
    rdfs:comment "Minted (Gate-F) as the DESCRIPTIVE product of the communication act 10.4.11.2 (bpo:P12181), which relays externally-authored regulatory requirements. Descriptive (an account/statement given by a reporting act), matching the Act-of-Reporting genus per the GOLDEN PRINCIPLE; the Directive bpo:RegulatoryRequirementsStatement is the communicated content (has input), not a product of this act." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that gives an account, to the personnel responsible for compliance, of the hazardous-material regulatory requirements they must follow." ;
    skos:example "A briefing note summarizing updated transport rules for corrosives for the disposal team." .

bpot:RegulatoryRequirementsStatement a owl:Class ;
    rdfs:label "Regulatory Requirements Statement" ;
    rdfs:comment "Directive: it conveys externally-authored prescriptions that the organization must satisfy and communicate.",
        "False-friend caution (Directive vs Descriptive): this Regulatory Requirements STATEMENT is the prescriptive content -- the externally-authored requirements the organization must satisfy (cco:ont00000965). It is NOT bpo:RegulatoryRequirementsBriefing (cco:ont00000853), the descriptive account GIVEN ABOUT those requirements to compliance personnel; a reporting act (e.g. bpo:P12181) takes this Statement as has-input and produces the Briefing as has-output." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the regulatory requirements applicable to hazardous-material handling, disposal, and reporting." .

bpot:RelocatedPersonnel a owl:Class ;
    rdfs:label "Relocated Personnel" ;
    rdfs:comment "Minted (Gate-F) for 10.1.4.1 'Relocate people': the relocated population is the Object whose location is changed, which is distinct from bpo:FacilityManagementPersonnel (the facilities staff who PERFORM the move). CCO Act of Location Change (ont00000065) moves an Object, so the moved employees -- not the facility managers -- are the definitional participant standing in for that Object." ;
    rdfs:subClassOf cco:ont00001017 ;
    skos:definition "An Agent that is a staff member or employee of an organization moved from one location to another in the course of a relocation act." .

bpot:ReplacementNeedAssessment a owl:Class ;
    rdfs:label "Replacement Need Assessment" ;
    rdfs:comment "Minted (Gate-F) as the descriptive output of 10.2.3.5 (bpo:P19234) once its lead act is correctly read as a determination/appraisal ('Determining the need to replace existing assets'), not a build. Descriptive (a judgement), satisfying the GOLDEN PRINCIPLE for an Act of Appraisal." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about an asset, that describes a judgement of whether the asset needs to be renewed or replaced." ;
    skos:example "An engineer's finding that a worn machine has reached the point where replacement is warranted." .

bpot:ReprocessingRecord a owl:Class ;
    rdfs:label "Reprocessing and Disposal Activity Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that documents the disposition, disposal, and reprocessing activities performed on hazardous materials or waste." ;
    skos:example "A logged record of a batch of solvent sent for reprocessing, with quantities, handler, and destination." .

bpot:ResourcePlan skos:definition "A Directive Information Content Entity that prescribes the resources to be allocated to a body of work in light of analyzed workload needs." .

bpot:SiteStatusReport a owl:Class ;
    rdfs:label "Site Status Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the status of an abandoned or remediated site for the duration required by regulators." .

bpot:UsefulLifeAssessment a owl:Class ;
    rdfs:label "Useful Life Assessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about an asset, that describes the asset's status against its planned useful life using criteria such as age, maintenance history, and capacity." .

bpot:WorkTaskList a owl:Class ;
    rdfs:label "Work Task List" ;
    rdfs:comment "Directive: a prioritized task list prescribes the acts to be performed and their ordering." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the prioritized set of tasks required to complete asset-maintenance work." .

bpot:ConstructionResource a owl:Class ;
    rdfs:label "Construction Resource" ;
    rdfs:comment "Anchored at BFO material entity because resources range over materials and equipment (artifacts) as well as raw materials (non-artifacts)." ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity, such as materials, equipment, or labor input, that is acquired and consumed or employed in performing construction work." .

bpot:DispositionRecord a owl:Class ;
    rdfs:label "Disposition and Disposal Record" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that records the disposition, disposal, and reprocessing activities performed on hazardous materials and waste." .

bpot:MaintenancePerformanceTarget a owl:Class ;
    rdfs:label "Maintenance Performance Target" ;
    rdfs:comment "Directive: a target prescribes an intended state to be achieved (cf. CCO Objective)." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the predictive indicators and target levels to be achieved in performing maintenance." .

bpot:MaintenanceSchedule skos:definition "A Directive Information Content Entity that prescribes a timetable for executing the maintenance of an asset." .

bpot:P10941 a owl:Class ;
    rdfs:label "Develop property strategy and long term vision" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Act of Planning) per the GOLDEN PRINCIPLE: 'Develop ... strategy/vision' yields a Directive ICE (Property Strategy)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PropertyStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10955 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10956 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10957 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes a property strategy and long-term vision prescribing how an organization will manage its purchased or retained properties." ;
    skos:example "A real-estate committee drafts a ten-year property strategy for the firm's owned portfolio." ;
    bpot:apqcSourceText "Strategizing a long-term vision for managing properties. Prepare strategies and a long-term vision for managing purchased/retained properties." ;
    bpot:hierarchyID "10.1.1" ;
    bpot:pcfID "10941" .

bpot:P10943 a owl:Class ;
    rdfs:label "Plan facility" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Act of Planning): producing a project proposal/plan is a Directive ICE. Hosts its activities as process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10958 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10959 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10960 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10961 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10962 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that recognizes the needs of facility users and composes a facility project proposal that prescribes how those needs will be met." ;
    skos:example "A project team turns user requirements into a costed facility proposal for sign-off." ;
    bpot:apqcSourceText "Recognizing the needs of facility users in order to construct a project proposal that meets those needs." ;
    bpot:hierarchyID "10.1.2" ;
    bpot:pcfID "10943" .

bpot:P10944 a owl:Class ;
    rdfs:label "Provide workspace and facilities" ;
    rdfs:comment "R5: a bounded provisioning act, modeled as bpo:ActOfAcquisition (Planned Act) rather than a standing function, because it has an identifiable begin/end (the workspace is provisioned). Hosts its activities as process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10963 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10964 ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that obtains and arranges a workspace together with its supporting assets according to organizational requirements." ;
    skos:example "A facilities team stands up a new floor of desks, chairs, and computers ready for occupancy." ;
    bpot:apqcSourceText "Managing the provision of the workspace and its assets. Arrange an office space with all assets (tables, chairs, computers, admin staff, etc.) according to requirements." ;
    bpot:hierarchyID "10.1.3" ;
    bpot:pcfID "10944" .

bpot:P10947 a owl:Class ;
    rdfs:label "Perform preventative asset maintenance" ;
    rdfs:comment "Anchored at cco:ont00000950 (Act of Maintenance). Operations category: the serviced productive asset is a material entity, attached as a definitional has-input filler (D4)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000228,
        cco:ont00000950 ;
    skos:definition "An Act of Maintenance that acts upon a productive asset prophylactically to preserve its designed functions and avert future corrective or unplanned repairs." ;
    skos:example "A technician lubricates and calibrates a machine on its scheduled preventive interval." ;
    bpot:apqcSourceText "Performing prophylactic maintenance in an effort to avoid corrective or unplanned repairs." ;
    bpot:hierarchyID "10.3.3.1" ;
    bpot:pcfID "10947" .

bpot:P10952 a owl:Class ;
    rdfs:label "Develop exit strategy" ;
    rdfs:comment "Directive output (bpo:AssetExitStrategy) -> Act of Formulation (GOLDEN PRINCIPLE). Children are monitoring and analysis acts that feed the strategy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AssetExitStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P18592 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P21577 ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that examines the condition and economics of assets and produces an asset exit strategy prescribing how and when assets are to be exited." ;
    skos:example "An asset team drafts the multi-year retirement and replacement strategy for an ageing equipment fleet." ;
    bpot:apqcSourceText "Creating a strategy for managing asset exits." ;
    bpot:hierarchyID "10.4.1" ;
    bpot:pcfID "10952" .

bpot:P10953 a owl:Class ;
    rdfs:label "Perform sale or trade" ;
    rdfs:comment "Asset is a definitional material input; bpo:DispositionRecord captures the transaction. CCO 2.0 has no Act of Selling; disposition by ownership transfer anchors at bpo:ActOfDisposition." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DispositionRecord ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that transfers ownership of an end-of-life asset to a buyer through sale or trade and produces a disposition record of the transaction." ;
    skos:example "A fleet manager sells a retired delivery van to a dealer and records the sale." ;
    bpot:apqcSourceText "Performing the sale of assets. Achieve and complete the sale process. Deliver the end product to the customers." ;
    bpot:hierarchyID "10.4.3" ;
    bpot:pcfID "10953" .

bpot:P10955 a owl:Class ;
    rdfs:label "Confirm alignment of property requirements with business strategy" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): 'Confirm alignment' judges/evaluates consistency, yielding a Descriptive ICE (GOLDEN PRINCIPLE: appraisal -> descriptive)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PropertyRequirementsSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:BusinessStrategy ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PropertyAlignmentAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as input a property requirements specification and a business strategy and has as output a property alignment assessment judging their consistency." ;
    skos:example "A portfolio analyst confirms that the requested floor space aligns with the firm's growth strategy." ;
    bpot:apqcSourceText "Creating alignment between the requirement of properties and the overall business strategy. This process requires the organization to align the requirement of properties in accordance with its business strategies of the organization." ;
    bpot:hierarchyID "10.1.1.1" ;
    bpot:pcfID "10955" .

bpot:P10956 a owl:Class ;
    rdfs:label "Appraise the external environment" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal); output is a Descriptive ICE (bpo:ExternalEnvironmentAppraisal) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ExternalEnvironmentAppraisal ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that evaluates the forces, circumstances, and events surrounding an organization and has as output an external environment appraisal of its opportunities and risks." ;
    skos:example "A facilities team appraises regional economic and regulatory conditions before committing to a site." ;
    bpot:apqcSourceText "Evaluating the impact of the external environment. Evaluate the circumstances, objects, events, and aspects surrounding an organization that affects its actions and selections and that recognizes its opportunities and risks." ;
    bpot:hierarchyID "10.1.1.2" ;
    bpot:pcfID "10956" .

bpot:P10957 a owl:Class ;
    rdfs:label "Determine build, buy, or lease decision" ;
    rdfs:comment "Anchored to bpo:ActOfSelection (Act of Information Processing): a candidate set (build/buy/lease) is reduced to a chosen option, yielding a Directive ICE (GOLDEN PRINCIPLE: selection -> directive)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MarketData ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BuildBuyLeaseDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that has as input market data and chooses among building, buying, or leasing, producing a build/buy/lease decision." ;
    skos:example "After studying construction costs and lease rates, management decides to lease rather than build." ;
    bpot:apqcSourceText "Deciding whether to buy or build properties. Study the market forces about property prices and cost of construction in order to take decisions based on the market research." ;
    bpot:hierarchyID "10.1.1.3" ;
    bpot:pcfID "10957" .

bpot:P10958 a owl:Class ;
    rdfs:label "Design facility" ;
    rdfs:comment "Genus bpo:ActOfFormulation (Act of Planning); a facility design is a Directive ICE (a blueprint/specification) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FacilityDesign ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that prepares and evaluates candidate facility designs and has as output a finalized facility design." ;
    skos:example "Architects develop and down-select to a final layout for a new warehouse." ;
    bpot:apqcSourceText "Preparing and analyzing different designs for a facility in order to finalize which design will be the most suitable option." ;
    bpot:hierarchyID "10.1.2.1" ;
    bpot:pcfID "10958" .

bpot:P10959 a owl:Class ;
    rdfs:label "Analyze budget" ;
    rdfs:comment "Genus bpo:ActOfAnalysis (Act of Information Processing); output is a Descriptive ICE (bpo:BudgetAnalysis) per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:Budget ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:BudgetAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that has as input a budget and has as output a budget analysis evaluating the feasibility of the funds prepared for facility construction." ;
    skos:example "A finance analyst tests whether the proposed construction budget covers the design's costs." ;
    bpot:apqcSourceText "Evaluating the feasibility of budgets prepared for the construction of facilities." ;
    bpot:hierarchyID "10.1.2.2" ;
    bpot:pcfID "10959" .

bpot:P10960 a owl:Class ;
    rdfs:label "Select property" ;
    rdfs:comment "Genus bpo:ActOfSelection (Act of Information Processing): a candidate set of properties is reduced to a chosen one, yielding a Directive ICE per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:PropertyRequirementsSpecification ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PropertySelectionDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that has as input a property requirements specification, reviews available property options, and produces a directive selection of the most suitable property." ;
    skos:example "A site-selection team reviews three buildings against requirements and commits to one." ;
    bpot:apqcSourceText "Assessing and choosing the appropriate property. Analyze the property requirements. Review the available property options. Finalize the most suitable option." ;
    bpot:hierarchyID "10.1.2.3" ;
    bpot:pcfID "10960" .

bpot:P10961 a owl:Class ;
    rdfs:label "Negotiate terms for facility" ;
    rdfs:comment "Genus bpo:ActOfNegotiation (PROPOSE-EXT, Planned Act): an interactive deliberation between parties yielding a binding Directive ICE (bpo:FacilityTermsAgreement). Rejected cco:ont00000511 (Act of Planning) -- the act is an inter-agent bargaining rather than making a plan to achieve an objective." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:FacilityTermsAgreement ],
        bpot:ActOfNegotiation ;
    skos:definition "An Act of Negotiation that discusses the terms and conditions for occupying a facility and produces a facility terms agreement reconciling business requirements and budget." ;
    skos:example "Facilities and a landlord negotiate lease length, rent, and fit-out responsibilities into an agreement." ;
    bpot:apqcSourceText "Discussing the terms and conditions of facilities to be occupied according to the business requirements and availability of budgets." ;
    bpot:hierarchyID "10.1.2.4" ;
    bpot:pcfID "10961" .

bpot:P10962 a owl:Class ;
    rdfs:label "Manage construction or modification to building" ;
    rdfs:comment "R5: although the APQC name says 'Manage', the Element Description ('Constructing the buildings. Manage renovations') denotes bounded constructive/modifying acts, so it is a process, not a standing function. De-conflated (Gate-F, Phase 1): the 'construct buildings' sense keeps the primary class at cco:ont00000051 (Act of Construction); the 'manage renovations' sense is the modify-existing-artifact genus cco:ont00000970 (Act of Artifact Modification), modeled as the supporting process bpo:ManageBuildingRenovation and attached here as a process part rather than collapsed into Construction. Operations layer (10.0) permits the material output bpo:Facility. has-input bpo:FacilityDesign is typical, recorded here rather than as a definitional restriction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Facility ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ConstructionContractor ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:ManageBuildingRenovation ],
        cco:ont00000051,
        cco:ont00000228 ;
    skos:definition "An Act of Construction that builds a building on site as prescribed by a facility design or contract and has as output a facility, and that has the management of building renovations as a process part." ;
    skos:example "A general contractor erects the warehouse shell per the approved design and manages later renovations to it." ;
    bpot:apqcSourceText "Constructing the buildings. Manage renovations according to requirements and demands." ;
    bpot:hierarchyID "10.1.2.5" ;
    bpot:pcfID "10962" .

bpot:P10963 a owl:Class ;
    rdfs:label "Acquire workspace and facilities" ;
    rdfs:comment "Genus bpo:ActOfAcquisition (Planned Act). Operations layer permits the material output bpo:Workspace." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Workspace ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that obtains an office workspace together with its supporting assets according to organizational requirements." ;
    skos:example "Procurement secures a leased floor and furnishes it with the required equipment." ;
    bpot:apqcSourceText "Attaining the office space with all assets (tables, chairs, computers, admin staff, etc.) according to requirements." ;
    bpot:hierarchyID "10.1.3.1" ;
    bpot:pcfID "10963" .

bpot:P10964 a owl:Class ;
    rdfs:label "Change fit/form/function of workspace and facilities" ;
    rdfs:comment "Re-anchored (Gate-F) from the over-general cco:ont00000908 (Act of Material Artifact Processing) to its nearest correct child cco:ont00000970 (Act of Artifact Modification): the source ('Modifying the formation of the workspace and its assets ... Make necessary changes ... according to requirements') is precisely 'an existing Material Artifact is acted upon in a manner that changes ... its Qualities, Dispositions, or Functions' (ont00000970). This matches the sibling-pattern 10.2.3.4 'Augment existing assets' (bpo:P19233), which anchors the same modify-existing-artifact act at ont00000970. ont00000908 retained as the (over-general) parent reached transitively. Rejected cco:ont00000950 (Act of Maintenance), which only preserves/restores existing qualities rather than altering fit/form/function. Operations layer permits the material input/output bpo:Workspace." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Workspace ],
        cco:ont00000228,
        cco:ont00000970 ;
    skos:definition "An Act of Artifact Modification that modifies the fit, form, or function of a workspace and its assets according to changed organizational requirements." ;
    skos:example "A facilities crew reconfigures an open-plan floor into team pods with new partitions." ;
    bpot:apqcSourceText "Modifying the formation of the workspace and its assets. Make necessary changes in an office space with all assets (tables, chairs, computers, admin staff, interior designing, etc.) according to requirements." ;
    bpot:hierarchyID "10.1.3.2" ;
    bpot:pcfID "10964" .

bpot:P10965 a owl:Class ;
    rdfs:label "Relocate people" ;
    rdfs:comment "Anchored to cco:ont00000065 (Act of Location Change): the location of an Object is changed by an Agent. Realizes the standing bpo:FacilityManagementCapability (10.1.4). Corrected (Gate-F): the moved Object is the relocated population (bpo:RelocatedPersonnel), NOT bpo:FacilityManagementPersonnel. The earlier model wrongly asserted that the facility managers (who PERFORM the move) were the relocated party; bpo:FacilityManagementPersonnel is retained as a SEPARATE participant restriction representing the performers, not as the moved party." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RelocatedPersonnel ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:FacilityManagementPersonnel ],
        cco:ont00000065 ;
    skos:definition "An Act of Location Change that moves the relocated staff or employees of an organization from one location to another, performed by facility-management personnel, in response to changed business requirements." ;
    skos:example "An HR/facilities team moves a department to a different building floor." ;
    bpot:apqcSourceText "Shifting staff or employees from one place to another place according to changes in business requirements." ;
    bpot:hierarchyID "10.1.4.1" ;
    bpot:pcfID "10965" .

bpot:P10966 a owl:Class ;
    rdfs:label "Relocate material and tools" ;
    rdfs:comment "Anchored to cco:ont00000065 (Act of Location Change). Realizes the standing bpo:FacilityManagementCapability (10.1.4). Operations layer permits the material participant bpo:ProductiveAsset (machines/tools relocated)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000065 ;
    skos:definition "An Act of Location Change that moves an organization's materials, tools, and machines from one location to another in response to changed business requirements." ;
    skos:example "A logistics crew relocates machine tools and stock to a newly acquired warehouse." ;
    bpot:apqcSourceText "Relocating the tools and raw materials. Shift raw or finished material and machines of company from one place to another place according to changes in business requirements." ;
    bpot:hierarchyID "10.1.4.2" ;
    bpot:pcfID "10966" .

bpot:P10967 a owl:Class ;
    rdfs:label "Analyze assets and predict maintenance requirements" ;
    rdfs:comment "Anchored under bpo:ActOfForecasting (Act of Prediction, cco:ont00000371): the definitional output is a Predictive ICE (bpo:MaintenanceRequirementsForecast) describing an UNCERTAIN FUTURE state -- the source text 'project future requirements' / 'determine the future maintenance requirements' makes this a prediction, not a plain analysis of an existing subject. Re-anchored from bpo:ActOfAnalysis (Act of Information Processing): that genus fits acts whose output is a plain Descriptive ICE about an EXISTING subject; a forecast of an uncertain future is the Predictive specialization (cco:ont00000626 subClassOf cco:ont00000853), produced by an Act of Prediction." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaintenanceRequirementsForecast ],
        bpot:ActOfForecasting ;
    skos:definition "An Act of Forecasting that examines the present working condition of productive assets and has as output a maintenance requirements forecast projecting their uncertain future maintenance needs." ;
    skos:example "An asset analyst reviews equipment condition data and forecasts the parts and servicing needed next year." ;
    bpot:apqcSourceText "Evaluating assets in order to project future requirements for maintenance. Evaluate the present working condition of assets. Determine the future maintenance requirements of assets." ;
    bpot:hierarchyID "10.3.1.2" ;
    bpot:pcfID "10967" .

bpot:P10968 a owl:Class ;
    rdfs:label "Integrate preventive maintenance into operations schedule" ;
    rdfs:comment "Anchored under cco:ont00000511 (Act of Planning): its definitional output is a Directive ICE (Maintenance Schedule) coordinating maintenance with production." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaintenanceSchedule ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that assimilates planned preventive maintenance into the production operations timetable and has as output a maintenance schedule." ;
    skos:example "A planner slots preventive servicing into windows when the shared line is idle." ;
    bpot:apqcSourceText "Devising a methodology and procedure for assimilating the works of planned maintenance into the schedule scheme for the processing of finished products that utilizes the same machinery." ;
    bpot:hierarchyID "10.3.1.4" ;
    bpot:pcfID "10968" .

bpot:P11276 a owl:Class ;
    rdfs:label "Perform construction performance management" ;
    rdfs:comment "GOLDEN PRINCIPLE: monitoring/oversight -> Descriptive ICE (WorkPerformanceReport). Despite the 'Managing' wording it is bounded to one construction effort, so it is a process (bpo:ActOfMonitoring), not a standing capability." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkPerformanceReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as output a work performance report describing whether construction activities are on task, on budget, and performed with safety and quality." ;
    skos:example "A construction manager reviews daily progress against plan and reports performance to the program office." ;
    bpot:apqcSourceText "Managing the construction process to ensure that activates are on task, on budget, and are being performed with safety and quality in mind." ;
    bpot:hierarchyID "10.2.2.2" ;
    bpot:pcfID "11276" .

bpot:P12180 a owl:Class ;
    rdfs:label "Maintain material safety data sheets" ;
    rdfs:comment "Verb 'Maintain' denotes preparing/capturing records (a bounded act), not a standing function. Descriptive output (bpo:MaterialSafetyDataSheet)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaterialSafetyDataSheet ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that captures material safety information and produces a material safety data sheet used to apply handling and disposal requirements." ;
    skos:example "An EHS specialist compiles the safety data sheet for a newly stocked solvent." ;
    bpot:apqcSourceText "Preparing material safety sheets. Capture material safety records to properly apply handling and disposal requirements." ;
    bpot:hierarchyID "10.4.11.1" ;
    bpot:pcfID "12180" .

bpot:P12181 a owl:Class ;
    rdfs:label "Maintain awareness of and communicate regulatory requirements" ;
    rdfs:comment "Anchored to cco:ont00000151 (Act of Reporting, an Act of Representative Communication whose proper product is a DESCRIPTIVE account). Corrected (Gate-F, GOLDEN PRINCIPLE): the externally-authored Directive bpo:RegulatoryRequirementsStatement is the COMMUNICATED CONTENT (has input via cco:ont00001921), not a product of this act -- a reporting/communication act does not AUTHOR a directive, it RELAYS it. The produced output is the descriptive bpo:RegulatoryRequirementsBriefing (has output), so the descriptive genus now agrees with the descriptive output. (If on review this row is genuine authoring of the requirements, it would instead re-anchor to a directive-producing planning genus.)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:RegulatoryRequirementsStatement ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:RegulatoryRequirementsBriefing ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that conveys hazardous-material regulatory requirements to the personnel responsible for compliance and produces a regulatory requirements briefing accounting for them." ;
    skos:example "A compliance lead briefs the disposal team on updated transport rules for corrosives." ;
    bpot:apqcSourceText "Understanding and communicating hazardous material regulatory requirements." ;
    bpot:hierarchyID "10.4.11.2" ;
    bpot:pcfID "12181" .

bpot:P12182 a owl:Class ;
    rdfs:label "Maintain hazardous material handling and disposal" ;
    rdfs:comment "Verb 'Maintain' here denotes conducting handling/disposal, a bounded disposition performance. Hazardous material is the definitional material input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:HazardousMaterial ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that plans, oversees, and tracks the handling and disposal of hazardous material." ;
    skos:example "A waste coordinator schedules, supervises, and logs the neutralization and disposal of a spent-acid batch." ;
    bpot:apqcSourceText "Planning, overseeing, and tracking hazardous material handling and disposal." ;
    bpot:hierarchyID "10.4.11.3" ;
    bpot:pcfID "12182" .

bpot:P12183 a owl:Class ;
    rdfs:label "Manage compliance audits" ;
    rdfs:comment "Anchored to cco:ont00000636 (Act of Appraisal): an audit evaluates and judges compliance. Descriptive output (bpo:ComplianceAuditReport)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ComplianceAuditReport ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that examines hazardous-material handling against regulatory requirements and produces a compliance audit report." ;
    skos:example "An auditor reviews manifests and storage practices and issues a hazardous-waste compliance audit report." ;
    bpot:apqcSourceText "Planning, supporting, and documenting hazardous material audits." ;
    bpot:hierarchyID "10.4.11.4" ;
    bpot:pcfID "12183" .

bpot:P12184 a owl:Class ;
    rdfs:label "Recognize need to disposition hazardous materials/waste" ;
    rdfs:comment "Anchored to bpo:ActOfIdentification (discernment sense). The 'approaches to dispose' established here are typical follow-on detail, captured downstream at 10.4.11.6; the definitional output is the descriptive recognition (bpo:DispositionNeedRegister)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DispositionNeedRegister ],
        bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns hazardous materials or waste requiring disposition and registers the recognized disposition need." ;
    skos:example "An operator flags a quantity of expired reagent as requiring disposal." ;
    bpot:apqcSourceText "Identifying and establishing approaches to dispose of hazardous materials/waste." ;
    bpot:hierarchyID "10.4.11.5" ;
    bpot:pcfID "12184" .

bpot:P12185 a owl:Class ;
    rdfs:label "Determine disposition and associated processing" ;
    rdfs:comment "Anchored to bpo:ActOfSelection: a disposition approach is chosen from candidate options, yielding a Directive ICE (bpo:DispositionDecision) -> directive output (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:HazardousMaterial ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DispositionDecision ],
        bpot:ActOfSelection ;
    skos:definition "An Act of Selection that evaluates hazardous materials and waste against requirements and chooses an appropriate disposition, producing an asset disposition decision that initiates disposition activities." ;
    skos:example "A specialist determines that a contaminated batch must be incinerated rather than landfilled and issues the disposition decision." ;
    bpot:apqcSourceText "Evaluating hazardous materials and waste for appropriate disposition. Apply requirements and initiate disposition activities." ;
    bpot:hierarchyID "10.4.11.6" ;
    bpot:pcfID "12185" .

bpot:P12186 a owl:Class ;
    rdfs:label "Manage disposition, disposal, reprocessing activities" ;
    rdfs:comment "Verb 'Manage' here denotes performing the activities, a bounded disposition. Hazardous material is the definitional material input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:HazardousMaterial ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that performs the disposition, disposal, and reprocessing of hazardous materials and waste." ;
    skos:example "A licensed handler incinerates a hazardous batch and reprocesses recoverable solvent." ;
    bpot:apqcSourceText "Performing disposition, disposal, and reprocessing activities." ;
    bpot:hierarchyID "10.4.11.7" ;
    bpot:pcfID "12186" .

bpot:P12187 a owl:Class ;
    rdfs:label "Manage documentation and reporting" ;
    rdfs:comment "Anchored to cco:ont00000151 (Act of Reporting). Descriptive outputs (bpo:DispositionRecord, bpo:ReprocessingRecord)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:DispositionRecord ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ReprocessingRecord ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that documents and reports the disposition, disposal, and reprocessing activities performed on hazardous materials and waste, producing a disposition and disposal record." ;
    skos:example "A coordinator files the disposal manifests and reprocessing logs for the quarter's hazardous-waste shipments." ;
    bpot:apqcSourceText "Documenting and reporting disposition, disposal, and reprocessing activities." ;
    bpot:hierarchyID "10.4.11.8" ;
    bpot:pcfID "12187" .

bpot:P12721 a owl:Class ;
    rdfs:label "Ship hazardous material" ;
    rdfs:comment "Anchored to cco:ont00000595 (Act of Cargo Transportation): the payload (hazardous material) changes location. Hazardous material is a definitional material input/payload." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:HazardousMaterial ],
        cco:ont00000228,
        cco:ont00000595 ;
    skos:definition "An Act of Cargo Transportation that moves a portion of hazardous material from one location to another under controlled, tracked conditions." ;
    skos:example "A licensed carrier transports drums of spent solvent from a plant to a treatment facility with manifest tracking." ;
    bpot:apqcSourceText "Planning, conducting, and tracking shipment of hazardous materials." ;
    bpot:hierarchyID "10.4.8" ;
    bpot:pcfID "12721" .

bpot:P12722 a owl:Class ;
    rdfs:label "Provide government reporting" ;
    rdfs:comment "Anchored to cco:ont00000151 (Act of Reporting, an Act of Representative Communication). Descriptive output (bpo:GovernmentReport). Regulatory authority is the recipient participant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:GovernmentReport ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        cco:ont00000151,
        cco:ont00000228 ;
    skos:definition "An Act of Reporting that prepares and distributes a government report accounting for asset end-of-life and waste activities to a regulatory authority." ;
    skos:example "An environmental compliance officer files the annual hazardous-waste generation report with the regulator." ;
    bpot:apqcSourceText "Preparing and distributing government reports." ;
    bpot:hierarchyID "10.4.9" ;
    bpot:pcfID "12722" .

bpot:P13131 a owl:Class ;
    rdfs:label "Demolish and secure" ;
    rdfs:comment "Anchored to cco:ont00000970 (Act of Artifact Modification): the asset's physical structure is destructively altered. Asset is a definitional material input; debris/parts the material output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:Facility ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:AssetPart ],
        cco:ont00000228,
        cco:ont00000970 ;
    skos:definition "An Act of Artifact Modification that demolishes an asset and secures the resulting parts and debris." ;
    skos:example "A demolition crew razes a disused warehouse and fences off the rubble." ;
    bpot:apqcSourceText "Demolishing and securing asset and resulting parts/debris." ;
    bpot:hierarchyID "10.4.10.1" ;
    bpot:pcfID "13131" .

bpot:P13132 a owl:Class ;
    rdfs:label "Restore site" ;
    rdfs:comment "Re-anchored (Gate-F, false-friend) from cco:ont00000950 (Act of Maintenance) to bpo:ActOfDisposition. CCO Act of Maintenance is 'An Act of Artifact Modification in which a MATERIAL ARTIFACT is modified in order to preserve or restore one or more of its DESIGNED Qualities or Functions', but the only definitional participant here is bpo:RealProperty, which the slice anchors at obo:BFO_0000040 (a material entity, NOT a Material Artifact) precisely because raw/contaminated land is not a designed artifact and has no designed Qualities. Remediation restores ENVIRONMENTAL qualities of land, not designed artifact qualities, so the Maintenance genus (and its artifact-hood presupposition) is violated by its own input. Anchored under bpo:ActOfDisposition, consistent with its abandonment-parent bpo:P21582, whose endpoint is making the site safe/compliant. The bpo:RealProperty filler is kept as obo:BFO_0000057 (has participant), not the artifact-presupposing maintenance has-input frame." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RealProperty ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that performs remediation or restoration activities on a site to make it environmentally safe and compliant as part of an asset's end-of-life." ;
    skos:example "A remediation contractor removes contaminated soil and re-grades a former tank farm." ;
    bpot:apqcSourceText "Performing remediation or restoration activities." ;
    bpot:hierarchyID "10.4.10.2" ;
    bpot:pcfID "13132" .

bpot:P13133 a owl:Class ;
    rdfs:label "Prepare handover to new operator or landowner" ;
    rdfs:comment "Anchored to cco:ont00000366 (Act of Information Processing): existing records are compiled into a descriptive handover package. Descriptive output -> matches genus (GOLDEN PRINCIPLE)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AssetHandoverDocumentation ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that compiles asset history and current-state information into handover documentation enabling an orderly transition to a new operator or landowner." ;
    skos:example "A site team assembles as-built drawings, inspection history, and a condition report for the incoming landowner." ;
    bpot:apqcSourceText "Supporting handover to new operator or landowner. Include proper documentation on asset history and current state to enable orderly transition." ;
    bpot:hierarchyID "10.4.10.4" ;
    bpot:pcfID "13133" .

bpot:P18592 a owl:Class ;
    rdfs:label "Monitor useful life of assets" ;
    rdfs:comment "GOLDEN PRINCIPLE: monitoring -> Descriptive ICE (UsefulLifeAssessment). Uses bpo:ActOfMonitoring (PROPOSE-EXT)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:UsefulLifeAssessment ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that observes assets against their planned useful-life criteria and produces a useful-life assessment of their remaining usability." ;
    skos:example "A reliability engineer tracks a pump against its rated service hours and reports it is approaching end-of-life." ;
    bpot:apqcSourceText "Monitoring assets against their planned useful life. Each asset may have specific criteria that indicate their usability. This may include time-based, maintenance history, capacity planning, etc." ;
    bpot:hierarchyID "10.4.1.1" ;
    bpot:pcfID "18592" .

bpot:P19209 a owl:Class ;
    rdfs:label "Manage capital program for assets" ;
    rdfs:comment "Bounded program-management act (one capital program has a definite begin/end), not a standing capability; anchored at cco:ont00000228 (Planned Act) as a composite of formulation, monitoring, and acquisition acts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CapitalInvestmentPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19210 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19211 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19212 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an Organization produces and maintains the financial plan for acquiring or constructing productive assets, decomposing into defining the capital investment plan, monitoring the capital program, and securing construction financing." ;
    skos:example "A facilities team prepares the investment plan and arranges loans for a new warehouse build." ;
    bpot:apqcSourceText "Producing and maintaining a planning schedule and a financial plan to purchase or manufacture productive assets. Determine the investment plan, monitor capital, and secure the necessary financing in order to realize completion of the program." ;
    bpot:hierarchyID "10.2.1" ;
    bpot:pcfID "19209" .

bpot:P19210 a owl:Class ;
    rdfs:label "Define capital investment plan" ;
    rdfs:comment "GOLDEN PRINCIPLE: formulation/planning -> Directive ICE (CapitalInvestmentPlan). Uses shared genus bpo:ActOfFormulation (cco:ont00000511)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CapitalInvestmentPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a capital investment plan prescribing the funds to be invested in the construction of productive assets." ;
    skos:example "Finance defines a USD 40M capital plan for a new plant." ;
    bpot:apqcSourceText "Establishing what funds will be invested in the construction of productive assets for the advancement of established business objectives." ;
    bpot:hierarchyID "10.2.1.1" ;
    bpot:pcfID "19210" .

bpot:P19211 a owl:Class ;
    rdfs:label "Monitor capital program" ;
    rdfs:comment "GOLDEN PRINCIPLE: monitoring -> Descriptive ICE (CapitalProgramReport). Uses bpo:ActOfMonitoring (PROPOSE-EXT)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:CapitalInvestmentPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CapitalProgramReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as input a capital investment plan and has as output a capital program report describing the tracked status of the capital projects." ;
    skos:example "A program office tracks spend against the capital plan and issues a quarterly status report." ;
    bpot:apqcSourceText "Monitoring plans on capital projects. Capital projects can be purchasing buildings, lands, etc." ;
    bpot:hierarchyID "10.2.1.2" ;
    bpot:pcfID "19211" .

bpot:P19212 a owl:Class ;
    rdfs:label "Secure construction financing" ;
    rdfs:comment "Uses shared genus bpo:ActOfAcquisition (cco:ont00000228 Planned Act): the org obtains financing it did not previously hold. Output is a Directive ICE (the financing arrangement)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConstructionFinancing ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that has as output a construction financing arrangement obtained to fund the construction of assets." ;
    skos:example "Treasury secures a construction loan facility for the build program." ;
    bpot:apqcSourceText "Acquiring the loans needed to construct necessary assets." ;
    bpot:hierarchyID "10.2.1.3" ;
    bpot:pcfID "19212" .

bpot:P19220 a owl:Class ;
    rdfs:label "Develop construction strategy" ;
    rdfs:comment "GOLDEN PRINCIPLE: formulation -> Directive ICE (ConstructionStrategy). Uses bpo:ActOfFormulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConstructionStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a construction strategy prescribing how asset construction is to be performed within timeline, regulatory, and budget constraints." ;
    skos:example "A project lead drafts the construction strategy and delivery approach for a new facility." ;
    bpot:apqcSourceText "Developing a strategy to perform asset construction. Assure that timelines, regulations, and resources are on task and on budget." ;
    bpot:hierarchyID "10.2.2.1" ;
    bpot:pcfID "19220" .

bpot:P19221 a owl:Class ;
    rdfs:label "Obtain construction permissions" ;
    rdfs:comment "Uses bpo:ActOfAcquisition (cco:ont00000228): the org obtains a permit it did not previously hold from a Regulatory Authority. Output is a Directive ICE (ConstructionPermit). Inspections referenced in the text are typical, not definitional -> not restricted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConstructionPermit ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RegulatoryAuthority ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that has as output a construction permit obtained from the proper jurisdiction authorizing construction of the asset." ;
    skos:example "A developer obtains building permits from the municipal authority before construction begins." ;
    bpot:apqcSourceText "Gathering the required permits for construction from the proper jurisdiction. This may include inspections during and after construction to verify that the new asset meets all national, regional, and local codes." ;
    bpot:hierarchyID "10.2.2.3" ;
    bpot:pcfID "19221" .

bpot:P19222 a owl:Class ;
    rdfs:label "Design assets" ;
    rdfs:comment "GOLDEN PRINCIPLE: designing is formulation -> Directive ICE (AssetDesign). Uses bpo:ActOfFormulation. Regulatory requirements are a typical input -> noted, not restricted." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:AssetDesign ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output an asset design prescribing an asset that meets organizational needs and adheres to applicable construction codes." ;
    skos:example "Engineers produce the design and drawings for a new production machine." ;
    bpot:apqcSourceText "Designing assets to meet organizational needs as well as ensuring that the asset adheres to all national, regional, and local construction codes." ;
    bpot:hierarchyID "10.2.2.4" ;
    bpot:pcfID "19222" .

bpot:P19223 a owl:Class ;
    rdfs:label "Plan construction resources" ;
    rdfs:comment "GOLDEN PRINCIPLE: planning -> Directive ICE (ConstructionResourcePlan). Uses bpo:ActOfFormulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConstructionResourcePlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a construction resource plan prescribing what resources will be acquired and when, where, and how long they will be used for construction." ;
    skos:example "A planner schedules crews, equipment, and materials for the build." ;
    bpot:apqcSourceText "Determining what resources will need to be acquired in order to carry out construction. Plan when, where, and how resources will be used. Determine the length of time resources will be utilized." ;
    bpot:hierarchyID "10.2.2.5" ;
    bpot:pcfID "19223" .

bpot:P19224 a owl:Class ;
    rdfs:label "Manage asset construction" ;
    rdfs:comment "Re-anchored (Gate-F) from the narrow bpo:ActOfMonitoring to the composite cco:ont00000228 (Planned Act), matching its three sibling group-parents 10.2.1/10.2.2/10.2.3 (bpo:P19209, bpo:P20139, bpo:P19229), which are all anchored at Planned Act because they aggregate acts of mixed genera. This node's three modeled children span heterogeneous genera -- monitoring (bpo:P19225), Act of Appraisal/QC (bpo:P19226), and Act of Information Processing/record creation (bpo:P19227) -- so typing the whole aggregate as a single Act of Monitoring mis-types it (a monitoring act does not have a quality-control appraisal as a proper part). The oversight emphasis is kept in the definition; the monitoring/appraisal/record children carry their own genera as process parts. Its safety/security/access child (PCF 19228) is a standing function modeled as bpo:P19228 Organization Capability (R6) and is therefore NOT attached here as a has-process-part; it is realized in the org's safety acts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19225 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19226 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19227 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an Organization oversees the performance and quality of construction work and maintains records throughout the construction process, decomposing into monitoring work performance, undertaking quality control, and creating work and asset records." ;
    skos:example "A project office oversees a building project's quality and keeps its construction records." ;
    bpot:apqcSourceText "Overseeing the performance and quality of work. Assure that records are maintained throughout the construction process. Adhere to all safety, security, and access regulations set forth by the organization and all government standards." ;
    bpot:hierarchyID "10.2.4" ;
    bpot:pcfID "19224" .

bpot:P19225 a owl:Class ;
    rdfs:label "Monitor work performance" ;
    rdfs:comment "GOLDEN PRINCIPLE: monitoring -> Descriptive ICE (WorkPerformanceReport). Uses bpo:ActOfMonitoring (PROPOSE-EXT)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkPerformanceReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that has as output a work performance report describing regulatory adherence, timeliness, and quality assurance across the construction process." ;
    skos:example "An inspector tracks regulatory compliance and progress and logs a performance report." ;
    bpot:apqcSourceText "Monitoring construction to insure that all regulatory laws are being adhered to, that all work is being performed in a timely manner, and that quality assurance is met at all steps of the construction process." ;
    bpot:hierarchyID "10.2.4.1" ;
    bpot:pcfID "19225" .

bpot:P19226 a owl:Class ;
    rdfs:label "Undertake construction quality control" ;
    rdfs:comment "Anchored at cco:ont00000636 (Act of Appraisal): it evaluates/judges the correctness and quality of the construction. GOLDEN PRINCIPLE: appraisal -> Descriptive ICE (QualityControlReport)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityControlReport ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that has as output a quality control report judging whether the construction was performed correctly and identifying defects to be reworked." ;
    skos:example "A QA team inspects completed work and issues a quality control report flagging defects for rework." ;
    bpot:apqcSourceText "Implementing a checks and balances system to verify that the construction was performed correctly. Rework when errors are found." ;
    bpot:hierarchyID "10.2.4.2" ;
    bpot:pcfID "19226" .

bpot:P19227 a owl:Class ;
    rdfs:label "Create work and asset records" ;
    rdfs:comment "Anchored at cco:ont00000366 (Act of Information Processing): compiling/registering records is manipulating input information into an output record. GOLDEN PRINCIPLE: information-processing -> Descriptive ICE (WorkAndAssetRecord)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkAndAssetRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that has as output a work and asset record describing all construction work performed, including new or modified construction and any construction or regulatory issues." ;
    skos:example "A clerk compiles the as-built record documenting all work and issues on the project." ;
    bpot:apqcSourceText "Implementing records to include all construction work that has been performed. Include all new or modified construction, and any construction or regulatory issues that might have occurred." ;
    bpot:hierarchyID "10.2.4.3" ;
    bpot:pcfID "19227" .

bpot:P19229 a owl:Class ;
    rdfs:label "Schedule and perform construction work" ;
    rdfs:comment "Bounded schedule-and-build phase; anchored at cco:ont00000228 (Planned Act) as a composite of a scheduling act and material construction/modification acts. Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19230 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19231 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19232 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19233 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19234 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an Organization schedules and physically carries out construction work, decomposing into scheduling the work, obtaining resources, constructing new assets, augmenting existing assets, and renewing or replacing assets." ;
    skos:example "A contractor schedules and executes the erection of a new factory building." ;
    bpot:apqcSourceText "Arranging a timetable for which to perform construction work. Schedule resources to contract assets for new or replacement assets. Reschedule or redesign assets if needed." ;
    bpot:hierarchyID "10.2.3" ;
    bpot:pcfID "19229" .

bpot:P19230 a owl:Class ;
    rdfs:label "Schedule construction work" ;
    rdfs:comment "GOLDEN PRINCIPLE: scheduling is formulation -> Directive ICE (ConstructionSchedule). Uses bpo:ActOfFormulation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ConstructionSchedule ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that has as output a construction schedule prescribing the timetable for executing the construction of the asset." ;
    skos:example "A planner sets the construction milestone schedule for the project." ;
    bpot:apqcSourceText "Defining a timetable for which to execute the construction of the asset." ;
    bpot:hierarchyID "10.2.3.1" ;
    bpot:pcfID "19230" .

bpot:P19231 a owl:Class ;
    rdfs:label "Obtain resources" ;
    rdfs:comment "Operations category -> MATERIAL output is legal (bpo:ConstructionResource is a Material Entity). Uses bpo:ActOfAcquisition: the org obtains resources it did not previously hold." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ConstructionResource ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that has as output construction resources gathered to complete the construction work." ;
    skos:example "A site manager procures steel, formwork, and a crane for the build." ;
    bpot:apqcSourceText "Gathering resources needed to complete all construction work. Verify that all resources have the proper training and skills to perform the work." ;
    bpot:hierarchyID "10.2.3.2" ;
    bpot:pcfID "19231" .

bpot:P19232 a owl:Class ;
    rdfs:label "Construct new assets" ;
    rdfs:comment "Anchored at cco:ont00000051 (Act of Construction): 'Material Artifacts are built on site as prescribed by some contract' -- exactly building a new asset. Operations category -> MATERIAL input/output (ConstructionResource in, ProductiveAsset out). A construction permit is referenced but typical, not definitional." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ConstructionResource ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000051,
        cco:ont00000228 ;
    skos:definition "An Act of Construction that has as input construction resources and has as output a newly built productive asset required by the organization." ;
    skos:example "A crew erects a new assembly line building on site." ;
    bpot:apqcSourceText "Building new assets necessary for the organization. Be aware of any construction codes and permits that need to be addressed." ;
    bpot:hierarchyID "10.2.3.3" ;
    bpot:pcfID "19232" .

bpot:P19233 a owl:Class ;
    rdfs:label "Augment existing assets" ;
    rdfs:comment "Anchored at cco:ont00000970 (Act of Artifact Modification): an existing Material Artifact is acted upon to change its qualities/functions -- exactly augmenting an existing asset. Rejected cco:ont00000051 (Act of Construction), which builds a NEW artifact. Operations category -> MATERIAL input and output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000228,
        cco:ont00000970 ;
    skos:definition "An Act of Artifact Modification that has as input an existing productive asset and has as output that asset modified to align with the changing needs of the organization." ;
    skos:example "An engineering team retrofits an existing plant with new automation." ;
    bpot:apqcSourceText "Modifying existing assets to align with the changing needs of the organization. Be aware of any construction codes and permits that need to be addressed." ;
    bpot:hierarchyID "10.2.3.4" ;
    bpot:pcfID "19233" .

bpot:P19234 a owl:Class ;
    rdfs:label "Renew/Replace assets" ;
    rdfs:comment "Re-anchored (Gate-F) from cco:ont00000051 (Act of Construction) to cco:ont00000636 (Act of Appraisal). The lead gerund 'Determining the need to replace existing assets' is a determination/appraisal yielding a DESCRIPTIVE judgement (bpo:ReplacementNeedAssessment), not a build; this is the false-friend on the label 'Replace' -- the row classifies the DECISION to replace, not the act of constructing the replacement. Consistent with the determination siblings 10.1.1.3 (bpo:P10957) and 10.1.2.3 (bpo:P10960). Rejected cco:ont00000051 (Act of Construction): the Element Description never states a build, a replacement ProductiveAsset output, nor a UsefulLifeAssessment input (the latter is borrowed from the 10.4 vocabulary). DESIGN NOTE / CQ target: the unsupported has-output some bpo:ProductiveAsset and has-input some bpo:UsefulLifeAssessment were dropped (Phase-3 definitional-necessity test: neither is licensed by the Element Description). If the physical replacement build is later in scope, it should be a SEPARATE supporting Act-of-Construction class, not collapsed into this determination row." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ReplacementNeedAssessment ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that judges whether an existing asset needs to be renewed or replaced and has as output a replacement need assessment." ;
    skos:example "After reviewing a machine's condition, an engineer determines it needs replacing and records that finding." ;
    bpot:apqcSourceText "Determining the need to replace existing assets. Be aware of any construction codes and permits that need to be addressed." ;
    bpot:hierarchyID "10.2.3.5" ;
    bpot:pcfID "19234" .

bpot:P19239 a owl:Class ;
    rdfs:label "Plan asset maintenance" ;
    rdfs:comment "Models APQC 10.3.1 as a bounded occurrent. Its APQC activities are process parts (cco:ont00001777), not subclasses." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10967 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19241 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10968 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19242 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19243 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19244 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkPlan ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19240 ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that determines the maintenance strategies, policies, tasks, and resources required to preserve an organization's productive assets and produces the corresponding maintenance plans." ;
    skos:example "A facilities team's annual maintenance-planning cycle producing the year's strategy, policies, task list, and resource plan." ;
    bpot:apqcSourceText "Ensuring that necessary resources are available and tasks are prioritized accordingly through planning. Provide strategies and policies that identify tasks that need to be completed, and the resources necessary to fulfill those tasks." ;
    bpot:hierarchyID "10.3.1" ;
    bpot:pcfID "19239" .

bpot:P19240 a owl:Class ;
    rdfs:label "Develop maintenance strategies" ;
    rdfs:comment "Anchored under bpo:ActOfFormulation (Act of Planning): its definitional output is a Directive ICE (Maintenance Strategy), per the GOLDEN PRINCIPLE." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaintenanceStrategy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the goals and agendas guiding asset maintenance and has as output a maintenance strategy." ;
    skos:example "A maintenance manager drafts the multi-year strategy aligning upkeep goals with asset-criticality." ;
    bpot:apqcSourceText "Creating goals and agendas to better realize the success of the maintenance policies that have been put into place." ;
    bpot:hierarchyID "10.3.1.1" ;
    bpot:pcfID "19240" .

bpot:P19241 a owl:Class ;
    rdfs:label "Specify maintenance policies" ;
    rdfs:comment "Anchored under bpo:ActOfFormulation: its definitional output is a Directive ICE (Maintenance Policy). De-conflation note (Gate-F, false-friend caution): the source LEADS with 'Communicating policies in regards to asset maintenance' then 'Provide a clear set of procedures and policies'. Phase-1 reads 'Communicating' here as articulating/issuing the AUTHORED policy, not as policy dissemination; the definitional act is authoring the Directive ICE (bpo:MaintenancePolicy), so the genus is Formulation (Act of Planning) and the GOLDEN PRINCIPLE holds (directive output -> planning genus). Rejected the Act of Communication reading (cco:ont00001261 / the cco:ont00000402 Act of Communication family): were this row genuine dissemination of an ALREADY-AUTHORED policy it would duplicate the authoring at 10.3.1.1 (strategy) / 10.3.1.7 (work plans); on a dissemination re-reading it should re-anchor to an Act of Communication with bpo:MaintenancePolicy as has input, not has output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaintenancePolicy ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that articulates the procedures and rules governing asset maintenance and has as output a maintenance policy." ;
    skos:example "A facilities office issues the documented maintenance policy and procedure manual." ;
    bpot:apqcSourceText "Communicating policies in regards to asset maintenance. Provide a clear set of procedures and policies that outline what will be involved in the maintenance process." ;
    bpot:hierarchyID "10.3.1.3" ;
    bpot:pcfID "19241" .

bpot:P19242 a owl:Class ;
    rdfs:label "Identify work management tasks & priorities" ;
    rdfs:comment "Although phrased 'Identify ...', the definitional output is a prescriptive prioritized task list (Directive ICE), so by the GOLDEN PRINCIPLE the genus is Formulation (Act of Planning), not Identification." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkTaskList ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that enumerates and prioritizes the tasks required for asset maintenance and has as output a work task list." ;
    skos:example "A supervisor compiles and ranks the work-order tasks for the upcoming maintenance window." ;
    bpot:apqcSourceText "Identifying the steps needed for asset maintenance. List out the those tasks that are involved in completing this process. Prioritize the tasks that are created." ;
    bpot:hierarchyID "10.3.1.5" ;
    bpot:pcfID "19242" .

bpot:P19243 a owl:Class ;
    rdfs:label "Conduct resource planning" ;
    rdfs:comment "Anchored under cco:ont00000511 (Act of Planning): its definitional output is a Directive ICE (Resource Plan)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:ResourcePlan ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that determines the resources required to meet asset-maintenance workload and has as output a resource plan." ;
    skos:example "A planner allocates technicians, parts, and budget to the forecasted maintenance workload." ;
    bpot:apqcSourceText "Analyzing workload needs in relation to asset maintenance and plan resources around those needs." ;
    bpot:hierarchyID "10.3.1.6" ;
    bpot:pcfID "19243" .

bpot:P19244 a owl:Class ;
    rdfs:label "Create work plans" ;
    rdfs:comment "Anchored under bpo:ActOfFormulation: its definitional output is a Directive ICE (Work Plan)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkPlan ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that composes the procedures for maintaining productive assets and has as output a work plan." ;
    skos:example "A planner writes the step-by-step work plan for servicing a pump assembly." ;
    bpot:apqcSourceText "Creating procedures on how to maintain productive assets." ;
    bpot:hierarchyID "10.3.1.7" ;
    bpot:pcfID "19244" .

bpot:P19245 a owl:Class ;
    rdfs:label "Manage asset maintenance" ;
    rdfs:comment "Re-anchored (Gate-F, GOLDEN PRINCIPLE at the umbrella) from cco:ont00000511 (Act of Planning) to cco:ont00000228 (Planned Act), the honest umbrella genus for a heterogeneous coordination cycle. This node asserts NO has-output restriction, and several of its process parts are descriptive/appraisal acts (bpo:P19248 Appraisal, bpo:P19249 Info Processing, bpo:P19250 Monitoring, bpo:P19252 Monitoring) whose outputs are Descriptive ICEs, so typing the whole 'manage/coordinate execution' cycle as an Act of Planning ('making a Plan to achieve an Objective') over-commits the genus (the analysis-misfiled-under-Planning failure mode). Modeled as a bounded coordination occurrent (an execution-management cycle with begin/end), not a never-ending function: it hosts the 10.3.2 activities as process parts (cco:ont00001777), and the formulation/appraisal/monitoring children carry their own genera. The earlier has-output justification is withdrawn, since the class asserts no output. Consistent with the bounded-oversight umbrellas modeled elsewhere in 10.0." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19246 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19247 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19248 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19249 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19251 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19252 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act that coordinates the scheduling, resourcing, quality control, safety, and performance verification of asset-maintenance work to ensure it is completed successfully." ;
    skos:example "A maintenance coordinator runs the cycle of scheduling crews, controlling quality, and confirming targets are met for a quarter's work." ;
    bpot:apqcSourceText "Ensuring that asset maintenance is conducted in a timely manner and successfully. Schedule work with the required resources with an eye on quality control and safety. Verify that contracted maintenance meets performance targets." ;
    bpot:hierarchyID "10.3.2" ;
    bpot:pcfID "19245" .

bpot:P19246 a owl:Class ;
    rdfs:label "Schedule maintenance work" ;
    rdfs:comment "Anchored under cco:ont00000511 (Act of Planning): its definitional output is a Directive ICE (Maintenance Schedule)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaintenanceSchedule ],
        cco:ont00000511 ;
    skos:definition "An Act of Planning that defines the timetable for executing asset maintenance and has as output a maintenance schedule." ;
    skos:example "A coordinator sets dates and crews for each scheduled servicing in the work queue." ;
    bpot:apqcSourceText "Defining a timetable for which to execute the maintenance of the asset." ;
    bpot:hierarchyID "10.3.2.1" ;
    bpot:pcfID "19246" .

bpot:P19247 a owl:Class ;
    rdfs:label "Obtain required resources" ;
    rdfs:comment "Reuses bpo:ActOfAcquisition (Planned Act). Operations category: the obtained resources are material entities, attached as a material participant via obo:BFO_0000057 (has participant) -- the same pattern as the operations sibling 10.2.3.2 (bpo:P19231 'Obtain resources'). Corrected (Gate-F, critical): the previous axiom's filler bpo:AssetPart is defined as a part resulting from DISMANTLING an end-of-life asset (a 10.4 disposition concept), which is the wrong universal for resources gathered to PERFORM maintenance; replaced with the maintenance-resource material entity bpo:MaintenanceResource. (Material fillers are modeled as has-participant rather than has-output here because in this domain a has-output filler must be an Information Content Entity.)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:MaintenanceResource ],
        bpot:ActOfAcquisition ;
    skos:definition "An Act of Acquisition that obtains the spare parts, consumables, and material resources needed to complete maintenance work, which participate in the act as the gathered maintenance resources." ;
    skos:example "A storekeeper draws spare parts and consumables for the week's work orders." ;
    bpot:apqcSourceText "Gathering resources needed to complete all maintenance work. Verify that all resources have the proper training and skills to perform the work." ;
    bpot:hierarchyID "10.3.2.2" ;
    bpot:pcfID "19247" .

bpot:P19248 a owl:Class ;
    rdfs:label "Undertake quality control" ;
    rdfs:comment "Anchored under cco:ont00000636 (Act of Appraisal): it judges the quality/condition of completed work, yielding a Descriptive ICE (Quality Control Report)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:QualityControlReport ],
        cco:ont00000636 ;
    skos:definition "An Act of Appraisal that verifies whether maintenance work was performed correctly and has as output a quality control report." ;
    skos:example "An inspector checks a completed repair against spec and records pass/fail with required rework." ;
    bpot:apqcSourceText "Implementing a checks and balances system to verify that the maintenance was performed correctly. Rework when errors are found." ;
    bpot:hierarchyID "10.3.2.3" ;
    bpot:pcfID "19248" .

bpot:P19249 a owl:Class ;
    rdfs:label "Update work and asset records" ;
    rdfs:comment "Anchored directly under cco:ont00000366 (Act of Information Processing): existing record ICEs are received and modified into an updated Descriptive ICE (Work and Asset Record)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:WorkAndAssetRecord ],
        cco:ont00000366 ;
    skos:definition "An Act of Information Processing that revises maintenance records to register the work performed, the assets serviced, and any issues, and has as output an updated work and asset record." ;
    skos:example "A technician closes a work order and updates the asset's service history." ;
    bpot:apqcSourceText "Modifying existing maintenance records to include all new work that has been performed, what assets were serviced, and any issues that might have arisen." ;
    bpot:hierarchyID "10.3.2.4" ;
    bpot:pcfID "19249" .

bpot:P19251 a owl:Class ;
    rdfs:label "Define maintenance performance targets" ;
    rdfs:comment "Anchored under bpo:ActOfFormulation: its definitional output is a Directive ICE (Maintenance Performance Target)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaintenancePerformanceTarget ],
        bpot:ActOfFormulation ;
    skos:definition "An Act of Formulation that establishes the predictive performance indicators to be achieved in maintenance and has as output a maintenance performance target." ;
    skos:example "A manager sets the target mean-time-to-repair and acceptable unplanned-failure rate." ;
    bpot:apqcSourceText "Outlining what should be achieved through predictive indicators with regard to performing maintenance. This could include the length of time it takes to perform routine maintenance or how often unplanned maintenance feasibly occur." ;
    bpot:hierarchyID "10.3.2.6" ;
    bpot:pcfID "19251" .

bpot:P19252 a owl:Class ;
    rdfs:label "Monitor maintenance performance against targets/contracts" ;
    rdfs:comment "Anchored under bpo:ActOfMonitoring (PROPOSE-EXT): it receives the performance-target ICE and observed results, yielding a Descriptive ICE (Maintenance Performance Report). The target is a definitional input." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:MaintenancePerformanceTarget ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:MaintenancePerformanceReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that gauges maintenance performance against established targets and contracts and has as output a maintenance performance report." ;
    skos:example "A reliability engineer compares actual downtime against targets and reports variance to management." ;
    bpot:apqcSourceText "Following set performance targets, monitor and gage the success of the organization in meeting those targets." ;
    bpot:hierarchyID "10.3.2.7" ;
    bpot:pcfID "19252" .

bpot:P19253 a owl:Class ;
    rdfs:label "Perform asset maintenance" ;
    rdfs:comment "Anchored at cco:ont00000950 (Act of Maintenance), verified: 'An Act of Artifact Modification in which a Material Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions.' Its APQC activities are process parts (cco:ont00001777)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P10947 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19254 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19255 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19256 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19257 ],
        cco:ont00000228,
        cco:ont00000950 ;
    skos:definition "An Act of Maintenance in which an organization acts upon its productive assets to preserve or restore their designed functions, comprising preventive, routine, and corrective work." ;
    skos:example "A maintenance crew works through the preventive, routine, and corrective tasks on the plant's equipment." ;
    bpot:apqcSourceText "Engaging in all aspects of asset maintenance. Ensure that all assets are functioning properly and to all specified codes and regulations where applicable. Maintenance includes all preventative, routine, and corrective activates." ;
    bpot:hierarchyID "10.3.3" ;
    bpot:pcfID "19253" .

bpot:P19254 a owl:Class ;
    rdfs:label "Perform routine asset maintenance" ;
    rdfs:comment "Anchored at cco:ont00000950 (Act of Maintenance); the maintained productive asset is a definitional material has-input filler." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000228,
        cco:ont00000950 ;
    skos:definition "An Act of Maintenance that carries out the recurring upkeep required to keep a productive asset in working condition." ;
    skos:example "A crew performs the routine filter changes and inspections on the HVAC system." ;
    bpot:apqcSourceText "Carrying out required maintenance to continue upkeep of equipment or assets." ;
    bpot:hierarchyID "10.3.3.2" ;
    bpot:pcfID "19254" .

bpot:P19255 a owl:Class ;
    rdfs:label "Perform corrective asset maintenance and repairs" ;
    rdfs:comment "Anchored at cco:ont00000950 (Act of Maintenance), whose definition explicitly covers restoring designed functions; the faulted asset is a definitional material has-input filler." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000228,
        cco:ont00000950 ;
    skos:definition "An Act of Maintenance that repairs or corrects a fault in a productive asset to restore its designed functions." ;
    skos:example "A technician replaces a failed bearing to return a pump to service." ;
    bpot:apqcSourceText "Repairing or correcting faults that occur with an asset. This could be a break or other repairable damage." ;
    bpot:hierarchyID "10.3.3.3" ;
    bpot:pcfID "19255" .

bpot:P19256 a owl:Class ;
    rdfs:label "Identify unplanned maintenance requirements" ;
    rdfs:comment "Anchored under bpo:ActOfIdentification (discernment sense, an Act of Information Processing). The output requirement register is typical but not present for every instance (a scan may find no new problems), so it is recorded here rather than as an owl:someValuesFrom restriction (Phase-3 necessity)." ;
    rdfs:subClassOf bpot:ActOfIdentification ;
    skos:definition "An Act of Identification that discerns current or potential asset problems requiring unplanned maintenance and registers the resulting requirements." ;
    skos:example "An operator notices abnormal vibration and flags an unplanned-repair requirement." ;
    bpot:apqcSourceText "Realizing potential or current problems with assets that would require unplanned maintenance. Unplanned maintenance is a repair or change that needs to be made that is not preventative or routine." ;
    bpot:hierarchyID "10.3.3.4" ;
    bpot:pcfID "19256" .

bpot:P19257 a owl:Class ;
    rdfs:label "Perform unplanned maintenance and repairs" ;
    rdfs:comment "Anchored at cco:ont00000950 (Act of Maintenance); the repaired asset is a definitional material has-input filler." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000228,
        cco:ont00000950 ;
    skos:definition "An Act of Maintenance that performs repairs on a productive asset outside the routine or preventive maintenance schedule to restore its designed functions." ;
    skos:example "A crew is dispatched to fix an unexpected conveyor failure on the line." ;
    bpot:apqcSourceText "Performing repairs that occur outside of normal routine or preventative maintenance." ;
    bpot:hierarchyID "10.3.3.5" ;
    bpot:pcfID "19257" .

bpot:P19258 a owl:Class ;
    rdfs:label "Decommission productive assets" ;
    rdfs:comment "Operations category: the asset is a definitional material input (cco:ont00001921 some bpo:ProductiveAsset)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that retires a productive asset from active service because it is no longer in working order, is obsolete, or is uneconomic to maintain." ;
    skos:example "A plant decommissions a worn-out compressor, isolating and de-energizing it ahead of removal." ;
    bpot:apqcSourceText "Retiring assets that are no longer viable to the business. Decommission assets that are no longer in working order, are out of date, or whose maintenance exceeds the cost of replacement." ;
    bpot:hierarchyID "10.4.2" ;
    bpot:pcfID "19258" .

bpot:P19465 a owl:Class ;
    rdfs:label "Monitor site for duration of time required by regulators" ;
    rdfs:comment "GOLDEN PRINCIPLE: monitoring -> Descriptive ICE (SiteStatusReport). Uses bpo:ActOfMonitoring (PROPOSE-EXT)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:SiteStatusReport ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that observes an abandoned site for the duration required by regulators and produces a site status report documenting its condition." ;
    skos:example "For thirty years after closure, a landfill operator monitors groundwater and reports site status to the regulator." ;
    bpot:apqcSourceText "Managing and reporting site status. Align efforts to all legal, regulatory and social/environmental responsibilities." ;
    bpot:hierarchyID "10.4.10.3" ;
    bpot:pcfID "19465" .

bpot:P20139 a owl:Class ;
    rdfs:label "Design and plan asset construction" ;
    rdfs:comment "Bounded design-and-plan phase preceding physical construction; anchored at cco:ont00000228 (Planned Act) as a composite of formulation, acquisition, and monitoring acts. Children are process parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19220 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P11276 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19221 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19222 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19223 ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which an Organization formulates the strategy, designs, permits, and resource plans needed to construct assets, decomposing into developing the construction strategy, managing construction performance, obtaining permissions, designing the assets, and planning construction resources." ;
    skos:example "An engineering team produces the plant design, secures permits, and a resource plan before breaking ground." ;
    bpot:apqcSourceText "Outlining the steps and strategies needed to construct assets. Verify that all regulations are adhered to and that all permissions have been granted. Organize and plan for resources to complete construction." ;
    bpot:hierarchyID "10.2.2" ;
    bpot:pcfID "20139" .

bpot:P21577 a owl:Class ;
    rdfs:label "Perform cost vs. benefit analysis for replacement" ;
    rdfs:comment "GOLDEN PRINCIPLE: analysis -> Descriptive ICE (CostBenefitAnalysis). Uses bpo:ActOfAnalysis." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:CostBenefitAnalysis ],
        bpot:ActOfAnalysis ;
    skos:definition "An Act of Analysis that examines an asset's total lifecycle cost against repair, replacement, and alternative options and produces a cost-benefit analysis informing retention or end-of-life." ;
    skos:example "An analyst compares the cost of refurbishing a turbine against replacing it and documents the trade-off." ;
    bpot:apqcSourceText "Cost/benefit analysis of assets to determine retention or end-of-life. Evaluating asset total lifecycle cost against other factors such as repair/refurbishment, replacement, and alternate solutions." ;
    bpot:hierarchyID "10.4.1.2" ;
    bpot:pcfID "21577" .

bpot:P21579 a owl:Class ;
    rdfs:label "Dismantle assets" ;
    rdfs:comment "Anchored to cco:ont00000970 (Act of Artifact Modification): the asset's structure is physically altered by removing parts, without yet disposing of them. Asset is a definitional material input; parts are the material output." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:AssetPart ],
        cco:ont00000228,
        cco:ont00000970 ;
    skos:definition "An Act of Artifact Modification that disassembles an end-of-life asset into manageable parts that may follow different downstream dispositions." ;
    skos:example "A technician disassembles a decommissioned generator into its motor, frame, and copper windings." ;
    bpot:apqcSourceText "Dismantling an asset into manageable parts. The parts may follow different dispositions, such as resale, reuse, recycle, etc." ;
    bpot:hierarchyID "10.4.5" ;
    bpot:pcfID "21579" .

bpot:P21580 a owl:Class ;
    rdfs:label "Track parts" ;
    rdfs:comment "GOLDEN PRINCIPLE: monitoring/tracking -> Descriptive ICE (PartTrackingRecord). Uses bpo:ActOfMonitoring (PROPOSE-EXT)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001986 ;
            owl:someValuesFrom bpot:PartTrackingRecord ],
        bpot:ActOfMonitoring ;
    skos:definition "An Act of Monitoring that follows the disposition of parts from end-of-life assets and produces a part tracking record providing an audit trail of source, rationale, and destination." ;
    skos:example "A disposition coordinator logs each salvaged part's origin asset, chosen disposition, and final destination." ;
    bpot:apqcSourceText "Tracking the disposition of all parts from end-of-life assets. Tracking should provide an audit trail to include source, rational for disposition, and destination." ;
    bpot:hierarchyID "10.4.6" ;
    bpot:pcfID "21580" .

bpot:P21581 a owl:Class ;
    rdfs:label "Recycle parts" ;
    rdfs:comment "Parts are a definitional material input; recovered material is the output. Operations category permits material I/O." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:AssetPart ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom bpot:RecoveredMaterial ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that processes parts from end-of-life assets into recovered material in accordance with legal, regulatory, and social/environmental responsibilities." ;
    skos:example "Copper windings stripped from a dismantled motor are sent to a smelter and returned as recovered copper stock." ;
    bpot:apqcSourceText "Recycling parts in accordance with legal, regulatory, and social/environmental responsibilities." ;
    bpot:hierarchyID "10.4.7" ;
    bpot:pcfID "21581" .

bpot:P21582 a owl:Class ;
    rdfs:label "Perform abandonment" ;
    rdfs:comment "Parent of four sub-activities (process parts). Anchored at bpo:ActOfDisposition because abandonment removes an asset from service and ownership responsibility." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P13131 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P13132 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P19465 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P13133 ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that abandons a facility or equipment by demolishing and securing it, restoring its site, monitoring the site as required, and handing it over, ensuring the abandoned asset is safe, secure, and compliant." ;
    skos:example "An operator abandons a depleted well site: plugging, demolishing surface equipment, remediating soil, and handing the land back." ;
    bpot:apqcSourceText "Planning and performing abandonment activities. Whether facilities  or equipment, ensure assets to be abandoned are safe, secure, and meet all legal, regulatory, and social/environmental responsibilities." ;
    bpot:hierarchyID "10.4.10" ;
    bpot:pcfID "21582" .

bpot:P21583 a owl:Class ;
    rdfs:label "Perform waste and hazardous goods management" ;
    rdfs:comment "Parent of eight sub-activities (process parts). Anchored at bpo:ActOfDisposition because its endpoint is the compliant removal/disposal of hazardous materials and waste." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001921 ;
            owl:someValuesFrom bpot:HazardousMaterial ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12180 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12181 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12182 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12183 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12184 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12185 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12186 ],
        [ a owl:Restriction ;
            owl:onProperty cco:ont00001777 ;
            owl:someValuesFrom bpot:P12187 ],
        bpot:ActOfDisposition ;
    skos:definition "An Act of Disposition that plans, documents, and conducts the compliant handling, disposal, and reporting of waste and hazardous materials." ;
    skos:example "A facility's hazardous-waste program: characterizing, manifesting, shipping, and reporting each waste stream to disposal." ;
    bpot:apqcSourceText "Planning and performing waste and hazardous goods management. In compliance with all legal, regulatory, and social/environmental requirements, plan, document, and conduct hazardous material handling, disposal, and reporting." ;
    bpot:hierarchyID "10.4.11" ;
    bpot:pcfID "21583" .

bpot:PropertyRequirementsSpecification a owl:Class ;
    rdfs:label "Property Requirements Specification" ;
    rdfs:comment "Directive: it states required conditions that candidate properties/facilities must meet, not a description of a portion of reality." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the property, facility, and workspace requirements an organization must satisfy." .

bpot:QualityControlReport a owl:Class ;
    rdfs:label "Quality Control Report" ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the results of verifying that construction or maintenance work was performed correctly, including any errors found and rework required." .

bpot:RealProperty a owl:Class ;
    rdfs:label "Real Property" ;
    rdfs:comment "Anchored at BFO material entity rather than Material Artifact because raw land is not an artifact. Subject of property-selection and build/buy/lease decisions.",
        "Scope caution (material asset vs legal interest): this class denotes the MATERIAL real-property asset (land + buildings/fixtures, obo:BFO_0000040). It does NOT represent legal rights or interests in the property (title, freehold/leasehold, easements, liens); those are generically-dependent continuants, not material entities, and would be modeled separately (e.g. a Directive/role-bearing ICE) if the corpus later covers property law." ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity, comprising land together with any buildings or fixtures on it, that an organization may build, buy, lease, retain, or dispose of." .

bpot:RegulatoryAuthority skos:definition "An Organization that bears a regulatory authority role in relation to construction, maintenance, or hazardous-material activities." .

bpot:WorkAndAssetRecord a owl:Class ;
    rdfs:label "Work and Asset Record" ;
    rdfs:comment "Shared record across 10.2.4.3 (create) and 10.3.2.4 (update). Descriptive: a record of past events." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cco:ont00001808 ;
            owl:someValuesFrom bpot:ProductiveAsset ],
        cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity, about an asset, that records the construction or maintenance work performed on it, the assets serviced, and any issues that arose." .

bpot:WorkPerformanceReport a owl:Class ;
    rdfs:label "Work Performance Report" ;
    rdfs:comment "Shared monitoring output across 10.2 and 10.3." ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the observed timeliness, regulatory compliance, and quality of construction or maintenance work." .

bpot:WorkPlan a owl:Class ;
    rdfs:label "Work Plan" ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes the procedures by which productive assets are to be maintained." .

bpot:Workspace a owl:Class ;
    rdfs:label "Workspace" ;
    rdfs:comment "Subject of acquire/change-fit-form-function activities in 10.1.3." ;
    rdfs:subClassOf cco:ont00000192 ;
    skos:definition "A Facility, together with its supporting assets such as furniture and equipment, provided to occupants to perform work." .

bpot:CapitalInvestmentPlan a owl:Class ;
    rdfs:label "Capital Investment Plan" ;
    rdfs:comment "Directive (a plan that prescribes intended investment acts). Output of Act of Planning / Formulation." ;
    rdfs:subClassOf cco:ont00000965 ;
    skos:definition "A Directive Information Content Entity that prescribes what funds will be invested in the construction or acquisition of productive assets in pursuit of established business objectives." .

bpot:AssetPart a owl:Class ;
    rdfs:label "Asset Part" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity that results from dismantling an end-of-life asset and that may follow a disposition such as resale, reuse, recycling, or disposal." .

bpot:Facility a owl:Class ;
    rdfs:label "Facility (asset)" ;
    rdfs:comment "Specialization of CCO Facility (ont00000192, 'a building or campus dedicated to some specific purpose') scoped to the managed-asset role in section 10.0." ;
    rdfs:subClassOf cco:ont00000192 ;
    skos:definition "A Facility that an organization plans, designs, constructs, modifies, operates, maintains, or disposes of as part of managing its assets." .

bpot:ActOfAcquisition rdfs:comment "Local extension (D9). Rejected cco:ont00000950 'Act of Maintenance' (modifying Material Artifacts) and cco:ont00000402 'Act of Communication' (mere ICE transfer). Securing/obtaining a held entity anchors at the generic Planned Act. Expected to recur in procurement/asset-acquisition categories (4.0, 10.0). Also rejected cco:ont00001334 (Act of Purchasing) and cco:ont00000389 (Act of Buying): both require a Financial Instrument and descend from cco:ont00000836 (Act of Financial Instrument Use), too narrow for non-purchase acquisitions such as obtaining permits/licenses from an authority or securing financing; purchasing is a species of acquisition, not its genus." .

bpot:HazardousMaterial a owl:Class ;
    rdfs:label "Hazardous Material" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity that poses a health, safety, or environmental hazard and whose handling, shipment, and disposal are subject to legal and regulatory control." .

bpot:ActOfDisposition rdfs:comment "PROPOSE-EXT (D9). CCO 2.0 has no generic disposal/disposition Act. Anchored at the generic cco:ont00000228 (Planned Act) because disposition spans physical destruction/recycling AND ownership transfer (sale/trade) AND waste-stream removal -- not all of which physically process a material artifact. Rejected cco:ont00000908 (Act of Material Artifact Processing: too narrow -- excludes sale/abandonment), cco:ont00000950 (Act of Maintenance: preserves/restores Qualities, the opposite of retiring an asset), and cco:ont00000970 (Act of Artifact Modification: changes an artifact's qualities, not its service/ownership status). Recurs across asset end-of-life: decommission, sale/trade, recycle, abandonment, hazardous-material/waste disposition (10.0). Also rejected cco:ont00001336 (Act of Ownership) and its parent cco:ont00001232 (Act of Possession): these model an agent HOLDING / exercising control over property (a state of possession), not relinquishing or transferring it; CCO 2.0 has no Act of Selling / Act of Ownership Transfer." .

bpot:ProductiveAsset a owl:Class ;
    rdfs:label "Productive Asset" ;
    rdfs:comment "Central material subject of section 10.0. Anchored at CCO Material Artifact (designed to realize a Function)." ;
    rdfs:subClassOf cco:ont00000995 ;
    skos:definition "A Material Artifact, such as a machine, tool, or factory, that an organization constructs, acquires, operates, maintains, and ultimately disposes of in the course of production." .

