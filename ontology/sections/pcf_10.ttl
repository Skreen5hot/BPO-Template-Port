@prefix bpot: <https://fandaws.com/ontology/bpot#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bpot:AssetConstructionCapability a owl:Class ;
    rdfs:label "Asset Construction Capability" ;
    rdfs:subClassOf cco:ont00000568 ;
    skos:definition "An Organization Capability that is realized in acts of designing, planning, scheduling, and performing the construction of assets." .

bpot:AssetManagerRole a owl:Class ;
    rdfs:label "Asset Manager Role" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that is borne by an Agent in virtue of being tasked with overseeing the construction, maintenance, and end-of-life of an organization's productive assets." .

bpot:MaintenancePersonnel a owl:Class ;
    rdfs:label "Maintenance Personnel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000196 ;
            owl:someValuesFrom bpot:MaintenanceTechnicianRole ],
        cco:ont00001017 ;
    skos:definition "An Agent that bears a maintenance technician role." .

bpot:PCF_10937 bpot:designatesProcessType bpot:P10937 .

